{
  "name": "mediastorm",
  "repo": "godver3/mediastorm:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/godver3/mediastorm/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--add-host=host.docker.internal:host-gateway",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7777]/admin",
  "icon": "https://raw.githubusercontent.com/godver3/mediastorm/master/mediastorm-square.png",
  "project": "https://github.com/godver3/mediastorm",
  "description": "A streaming media server with native mobile and TV apps. Discord https://discord.gg/4qEMz4ay Required: Install mediastorm_postgres app/container from community apps store first.",
  "paths": [
    {
      "name": "Cache",
      "host": "/mnt/cache/appdata/mediastorm",
      "container": "/root/cache",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Webui",
      "host": "7777",
      "container": "7777",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgres://mediastorm:mediastorm@host.docker.internal:5432/mediastorm?sslmode=disable",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
