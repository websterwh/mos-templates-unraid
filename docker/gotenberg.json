{
  "name": "gotenberg",
  "repo": "gotenberg/gotenberg",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/gotenberg/gotenberg/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": "gotenberg --chromium-disable-javascript=true --chromium-allow-list=file:///tmp/.*",
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/sgraaf/Unraid-Docker-Templates/main/gotenberg/icon.png",
  "project": "https://gotenberg.dev/",
  "description": "Gotenberg provides a developer-friendly API to interact with powerful tools like Chromium and LibreOffice for converting numerous document formats (HTML, Markdown, Word, Excel, etc.) into PDF files, and more! This template has been pre-configured for use with Paperless-ngx.",
  "paths": [],
  "ports": [
    {
      "name": "Gotenberg API Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
