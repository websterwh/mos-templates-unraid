{
  "name": "Nonograph",
  "repo": "ghcr.io/du82/nonograph:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/du82/nonograph",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8009]",
  "icon": "https://raw.githubusercontent.com/du82/nonograph/refs/heads/main/icon.png",
  "project": "https://github.com/du82/nonograph",
  "description": "Nonograph is a simple anonymous publishing platform for anyone who wants their words to exist online without being tied to an identity. You write something, you get a shareable link, and you share your writing with whoever you'd like. No account creation, no profile, no analytics trail following readers around.",
  "paths": [
    {
      "name": "Content Directory",
      "host": "/mnt/cache/appdata/nonograph/content",
      "container": "/app/content",
      "mode": "rw",
      "description": "Directory to store published content",
      "required": true
    },
    {
      "name": "Tor Hidden Service",
      "host": "/mnt/cache/appdata/nonograph/onion",
      "container": "/var/lib/tor/hidden_service",
      "mode": "rw",
      "description": "Hidden service directory (contains private keys)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8009",
      "container": "8009",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
