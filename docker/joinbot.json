{
  "name": "join-bot",
  "repo": "ghcr.io/brockbreacher/join-bot",
  "category": [
    "System"
  ],
  "registry": "https://github.com/brockbreacher/Join-Bot/pkgs/container/join-bot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://brbr.xyz/wp-content/uploads/2021/03/BrockDoorIcon-1.png",
  "project": "https://github.com/brockbreacher/Join-Bot",
  "description": "Discord Join-Logs Made Simple. https://github.com/brockbreacher/Join-Bot",
  "paths": [
    {
      "name": "Guild Storage",
      "host": "/mnt/cache/appdata/joinbot/guilds",
      "container": "/usr/src/app/guilds",
      "mode": "rw",
      "description": "Storage for guild data",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TOKEN",
      "key": "TOKEN",
      "value": "",
      "description": "The Discord Bot Token",
      "required": true,
      "mask": true
    },
    {
      "name": "ACTIVITY",
      "key": "ACTIVITY",
      "value": "",
      "description": "Bot Activity Message (EX, You Sleep)",
      "required": true,
      "mask": false
    },
    {
      "name": "TYPE",
      "key": "TYPE",
      "value": "PLAYING",
      "description": "The activity type (LISTENING, WATCHING, PLAYING)",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
