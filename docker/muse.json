{
  "name": "muse",
  "repo": "codetheweb/muse",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/codetheweb/muse",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/codetheweb/muse/master/.github/logo.png",
  "project": "https://github.com/codetheweb/muse",
  "description": "\ud83c\udfa7 a self-hosted midwestern Discord music bot that doesn't suck",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/muse/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Discord Bot Token",
      "key": "DISCORD_TOKEN",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Spotify Client ID",
      "key": "SPOTIFY_CLIENT_ID",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Spotify Client Secret",
      "key": "SPOTIFY_CLIENT_SECRET",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "YouTube API Key",
      "key": "YOUTUBE_API_KEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Bot Status",
      "key": "BOT_STATUS",
      "value": "online|idle|dnd",
      "description": "Set bot status. Can be online, idle, or dnd (do not disturb)",
      "required": false,
      "mask": false
    },
    {
      "name": "Bot Activity Type",
      "key": "BOT_ACTIVITY_TYPE",
      "value": "|PLAYING|LISTENING|WATCHING|STREAMING",
      "description": "Set bot activity type. Add your stream URL below if you use STREAMING",
      "required": false,
      "mask": false
    },
    {
      "name": "Bot Activity",
      "key": "BOT_ACTIVITY",
      "value": "",
      "description": "the text that follows the activity type",
      "required": false,
      "mask": false
    },
    {
      "name": "Bot Activity URL (REQUIRED FOR STREAMING)",
      "key": "BOT_ACTIVITY_URL",
      "value": "",
      "description": "If you set Bot Activity Type to STREAMING, you MUST use this variable. Accepts YouTube or Twitch stream URL",
      "required": false,
      "mask": false
    },
    {
      "name": "Cache Size Limit",
      "key": "CACHE_LIMIT",
      "value": "2GB",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
