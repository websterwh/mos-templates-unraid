{
  "name": "ha-dockermon",
  "repo": "philhawthorne/ha-dockermon",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/philhawthorne/ha-dockermon/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8126]",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/ha-dockermon_icon.png",
  "project": null,
  "description": "A NodeJS RESTful API which can be used with Home Assistant to report the state of Docker Containers Custom Component to automatically add all your docker switches to home assistant. https://gitlab.com/custom_components/hadockermon Additional info including the API can be found here: https://github.com/philhawthorne/ha-dockermon",
  "paths": [
    {
      "name": "dockersock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Container Path: /var/run/docker.sock",
      "required": true
    },
    {
      "name": "configpath",
      "host": "/mnt/cache/appdata/ha-dockermon/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API port",
      "host": "8126",
      "container": "8126",
      "protocol": "tcp",
      "description": "Container Port: 8126",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
