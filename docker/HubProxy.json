{
  "name": "HubProxy",
  "repo": "ghcr.io/sky22333/hubproxy:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/sky22333/hubproxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/hubproxy-icon.png",
  "project": "https://github.com/sky22333/hubproxy",
  "description": "An proxy for accessing GitHub releases and Docker images.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/hubproxy/config.toml",
      "container": "/app/config.toml",
      "mode": "ro",
      "description": "Config file",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
