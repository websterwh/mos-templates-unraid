{
  "name": "Radicale",
  "repo": "ghcr.io/kozea/radicale:stable",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/kozea/radicale",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5232]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/radicale-icon.png",
  "project": "https://radicale.org",
  "description": "Radicale is a small but powerful CalDAV (calendars, to-do lists) and CardDAV (contacts) server",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/radicale/config",
      "container": "/etc/radicale",
      "mode": "rw",
      "description": "Path to the config data",
      "required": true
    },
    {
      "name": "Data Storage",
      "host": "/mnt/cache/appdata/radicale/data",
      "container": "/var/lib/radicale",
      "mode": "rw",
      "description": "Path to the data storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5232",
      "container": "5232",
      "protocol": "tcp",
      "description": "Container Port: 5232",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
