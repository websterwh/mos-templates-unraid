{
  "name": "OctoPrint-Spants",
  "repo": "octoprint/octoprint:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/octoprint/octoprint",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://octoprint.org/assets/img/logo.png",
  "project": "https://octoprint.org/",
  "description": "OctoPrint provides a snappy web interface for controlling consumer 3D printers. This image **contains** mjpg-streamer. Please see support thread on how to make this work. (You will need to install Video plugin for Unraid etc) An invite to the Discord server can be found at discord.octoprint.org.",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/octoprint",
      "container": "/octoprint",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5002",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "webcam",
      "host": "5003",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "snapshot",
      "host": "5004",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ENABLE_MJPG_STREAMER",
      "key": "ENABLE_MJPG_STREAMER",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "CAMERA_DEV",
      "key": "CAMERA_DEV",
      "value": "/dev/video0",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MJPG_STREAMER_INPUT",
      "key": "MJPG_STREAMER_INPUT",
      "value": "-y -n -r 640x480",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "Printer USB Port",
      "host": "/dev/serial/by-id/usb-Prusa_Research__prusa3d.com__Original_Prusa_MINI_CZPX1620X017XC06142-if00",
      "container": "",
      "description": null,
      "required": true
    },
    {
      "name": "webcam device",
      "host": "/dev/video0",
      "container": "",
      "description": "Webcam is using this device",
      "required": false
    }
  ],
  "labels": []
}
