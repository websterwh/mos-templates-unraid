{
  "name": "EV-Tracker",
  "repo": "19121412/ev-tracker:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/19121412/ev-tracker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/fdreckmann/ev-tracker-unraid-app/main/icon.svg",
  "project": "https://github.com/fdreckmann/ev-tracker",
  "description": "EV Tracker zur Erfassung von Ladevorg\u00e4ngen, Fahrzeugdaten, Z\u00e4hlerst\u00e4nden, Wallboxen, Kosten und Exporten.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/ev-tracker",
      "container": "/data",
      "mode": "rw",
      "description": "Persistenter Datenordner f\u00fcr Config, SQLite-Datenbank, Exporte, Uploads und Fahrzeugbilder.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port der EV Tracker Weboberfl\u00e4che.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Zeitzone des Containers.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
