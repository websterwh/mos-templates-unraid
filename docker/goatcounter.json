{
  "name": "goatcounter",
  "repo": "arp242/goatcounter:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/arp242/goatcounter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": "serve -email-from GoatCounter none@example.com",
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/misterjtc/docker-templates/master/icons/goatcounter.png",
  "project": "https://github.com/arp242/goatcounter",
  "description": "Goatcounter(https://github.com/arp242/goatcounter) - Easy web analytics. No tracking of personal data.; Location Data : By default, goatcounter only ships with the \"counties\" location database. If you want region data you need to download the \"GeoLite City\" database from https://maxmind.com and place in Appdata",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/goatcounter",
      "container": "/home/goatcounter/goatcounter-data",
      "mode": "rw",
      "description": "Database and Location data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "The port for the Goatcounter Web UI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
