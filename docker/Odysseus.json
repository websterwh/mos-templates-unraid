{
  "name": "Odysseus",
  "repo": "realitymolder/odysseus:stable",
  "category": [
    "Misc"
  ],
  "registry": "https://registry.hub.docker.com",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7000]",
  "icon": "https://raw.githubusercontent.com/realitymolder/odysseus-ca-templates/main/templates/img/odysseus.svg",
  "project": "https://github.com/pewdiepie-archdaemon/odysseus",
  "description": "Self-hosted AI workspace with chat, agents, deep research, documents, email, calendar, and model Cookbook.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/odysseus/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Persistent data storage (database, uploads, memory)",
      "required": true
    },
    {
      "name": "App Logs",
      "host": "/mnt/cache/appdata/odysseus/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Application logs",
      "required": false
    },
    {
      "name": "HF Cache",
      "host": "/mnt/cache/appdata/odysseus/huggingface",
      "container": "/app/.cache/huggingface",
      "mode": "rw",
      "description": "HuggingFace model cache",
      "required": false
    },
    {
      "name": "Local Cache",
      "host": "/mnt/cache/appdata/odysseus/local",
      "container": "/app/.local",
      "mode": "rw",
      "description": "Cookbook-installed engines (vLLM, llama.cpp)",
      "required": false
    },
    {
      "name": "SSH Keys",
      "host": "/mnt/cache/appdata/odysseus/ssh",
      "container": "/app/.ssh",
      "mode": "rw",
      "description": "Cookbook remote-server SSH keys",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "App Port",
      "host": "7000",
      "container": "7000",
      "protocol": "tcp",
      "description": "Web UI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file permissions (default 99 = nobody)",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file permissions (default 100 = users)",
      "required": false,
      "mask": false
    },
    {
      "name": "Auth Enabled",
      "key": "AUTH_ENABLED",
      "value": "true",
      "description": "Enable authentication",
      "required": false,
      "mask": false
    },
    {
      "name": "Admin User",
      "key": "ODYSSEUS_ADMIN_USER",
      "value": "admin",
      "description": "First admin account username",
      "required": false,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "ODYSSEUS_ADMIN_PASSWORD",
      "value": "",
      "description": "Pre-seed admin password (leave blank for auto-generated)",
      "required": false,
      "mask": true
    },
    {
      "name": "App Port",
      "key": "APP_PORT",
      "value": "7000",
      "description": "Internal app port (leave as 7000)",
      "required": false,
      "mask": false
    },
    {
      "name": "LLM Host",
      "key": "LLM_HOST",
      "value": "localhost",
      "description": "Primary LLM server hostname",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenAI API Key",
      "key": "OPENAI_API_KEY",
      "value": "",
      "description": "Optional OpenAI API key",
      "required": false,
      "mask": true
    },
    {
      "name": "SearXNG Instance",
      "key": "SEARXNG_INSTANCE",
      "value": "http://odysseus-searxng:8080",
      "description": "SearXNG URL (compose: searxng:8080, branded template: odysseus-searxng:8080)",
      "required": false,
      "mask": false
    },
    {
      "name": "ChromaDB Host",
      "key": "CHROMADB_HOST",
      "value": "odysseus-chromadb",
      "description": "ChromaDB host (internal Docker hostname)",
      "required": false,
      "mask": false
    },
    {
      "name": "ChromaDB Port",
      "key": "CHROMADB_PORT",
      "value": "8000",
      "description": "ChromaDB port",
      "required": false,
      "mask": false
    },
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "sqlite:///./data/app.db",
      "description": "Database connection string",
      "required": false,
      "mask": false
    },
    {
      "name": "Extra Hosts",
      "key": "EXTRA_HOSTS",
      "value": "host.docker.internal:host-gateway",
      "description": "Extra hosts mapping (for reaching host services like Ollama)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
