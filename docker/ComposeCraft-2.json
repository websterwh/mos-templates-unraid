{
  "name": "Compose-Craft",
  "repo": "composecraft/composecraft:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/composecraft/composecraft",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/compose-craft-icon.jpg",
  "project": "https://composecraft.com/",
  "description": "A tool to help you manage, edit and share docker compose files in a GUI way.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "App URL",
      "key": "URL",
      "value": "http://IP_ADDRESS:3000",
      "description": "URL of the app",
      "required": true,
      "mask": false
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Secret key",
      "required": true,
      "mask": true
    },
    {
      "name": "MongoDB URL",
      "key": "MONGO_URL",
      "value": "mongodb://USERNAME:PASSWORD@IP_ADDRESS:27017",
      "description": "URL of the MongoDB instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Core Only",
      "key": "CORE_ONLY",
      "value": "true|false",
      "description": "Only show core services",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
