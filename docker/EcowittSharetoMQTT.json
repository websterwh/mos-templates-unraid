{
  "name": "Ecowitt-Share-to-MQTT",
  "repo": "ghcr.io/kevlacross/ecowitt-share-to-mqtt:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/kevlacross/ecowitt-share-to-mqtt-ca/main/icon.svg",
  "project": "https://github.com/kevlacross/ecowitt-share-to-mqtt",
  "description": "Bridge Ecowitt shared-station data to MQTT with Home Assistant MQTT Discovery.",
  "paths": [
    {
      "name": "Configuration",
      "host": "/mnt/cache/appdata/Ecowitt-share_to_MQTT",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent configuration and SQLite database",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Local administration interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": "Timezone used for local display and logs",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
