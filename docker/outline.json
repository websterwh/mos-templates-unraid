{
  "name": "outline",
  "repo": "outlinewiki/outline:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/outlinewiki/outline/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/outline.png",
  "project": "https://www.getoutline.com/",
  "description": "The fastest wiki and knowledge base for growing teams. More information https://docs.getoutline.com/s/hosting/doc/docker-7pfeLP5a8t Authentication used in the docker template is OpenID https://medium.com/@Lola_Dam/guide-for-installing-outline-with-authelia-as-an-openid-provider-129a141f6090",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/outline",
      "container": "/var/lib/outline/data",
      "mode": "rw",
      "description": "Data Path For it to work pchown 1001 /mnt/user/appdata/outline//p",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port HTTP",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "generate_a_new_key",
      "description": "Generate a hex-encoded 32-byte random key. You could use `openssl rand -hex 32`",
      "required": true,
      "mask": false
    },
    {
      "name": "UTILS_SECRET",
      "key": "UTILS_SECRET",
      "value": "generate_a_new_key",
      "description": "Generate a hex-encoded 32-byte random key. You could use `openssl rand -hex 32`",
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgres://user:pass@localhost:5432/outline",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "REDIS_URL",
      "key": "REDIS_URL",
      "value": "redis://:password@localhost:6379",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "URL",
