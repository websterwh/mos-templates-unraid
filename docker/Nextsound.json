{
  "name": "Nextsound",
  "repo": "novakeith/nextsound:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/novakeith/nextsound/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/novakeith/NextSound/refs/heads/main/assets/favicon.ico",
  "project": "https://github.com/novakeith/NextSound",
  "description": "Nextsound is an audio sharing and feedback tool. You can use it to upload, organize, and share sounds and solicit feedback. If you have ever used Soundcloud, you'll be familiar with the intended use cases.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/nextsound/data",
      "container": "/var/www/html/data",
      "mode": "rw",
      "description": "Storage location for the SQLite database.",
      "required": true
    },
    {
      "name": "Uploads",
      "host": "/mnt/cache/appdata/nextsound/uploads",
      "container": "/var/www/html/uploads",
      "mode": "rw",
      "description": "Storage location for all user uploads.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8027",
      "container": "80",
      "protocol": "tcp",
      "description": "Access web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin password",
      "key": "ADMIN_PASSWORD",
      "value": "MyPasswordHere",
      "description": "Set a secure admin password",
      "required": true,
      "mask": true
    },
    {
      "name": "Site Title",
      "key": "SITE_TITLE",
      "value": "NextSound-Unraid",
      "description": "Default site title. Can be changed later in settings panel.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
