{
  "name": "Unifi-Network-List-Sync",
  "repo": "ghcr.io/mstrhakr/go-unifi-network-list-sync:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/mstrhakr/packages/container/package/go-unifi-network-list-sync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/mstrhakr/go-unifi-network-list-sync/main/docs/logo.png",
  "project": null,
  "description": "Keep UniFi firewall/address groups in sync with DNS hostnames and static CIDRs using a web UI, scheduled jobs, multi-resolver lookups, and run-history diffs.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/go-unifi-network-list-sync",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "HTTP port for the WebUI.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID to run the container as.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID to run the container as.",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "File creation mask for the container.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
