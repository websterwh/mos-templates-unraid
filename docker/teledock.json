{
  "name": "teledock",
  "repo": "mrmarble/teledock",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/mrmarble/teledock",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://github.com/0neTX/UnRAID_Template/blob/41b530b533ad93f249b9c08ffe87ec66e74162d3/teledock/teledcock.png?raw=1",
  "project": "https://github.com/MrMarble/teledock",
  "description": "Teledock: A simple telegram bot that allows a telegram's user to control a docker service.",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker Socket",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TELEDOCK_TOKEN",
      "key": "TELEDOCK_TOKEN",
      "value": "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11",
      "description": "Telegram Bot Token",
      "required": true,
      "mask": true
    },
    {
      "name": "TELEDOCK_SUPERADMINS",
      "key": "TELEDOCK_SUPERADMINS",
      "value": "tg_userid",
      "description": "Comma separated list of Telegram user ids, only users listed here will have access to the bot.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
