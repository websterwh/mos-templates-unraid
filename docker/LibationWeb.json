{
  "name": "LibationWeb",
  "repo": "jtechguru1993/libation-web:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://docker.com",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://githubusercontent.com",
  "project": "https://github.com",
  "description": "A web UI wrapper for Libation \u2014 the Audible audiobook manager. Connects to your Audible account, scans your library, and downloads audiobooks via LibationCli. Single Docker container with a FastAPI backend and React frontend. Supports multiple users, 2FA, session management, per-user download caps, per-account auto-download, and PUID/PGID for proper Unraid permissions.",
  "paths": [
    {
      "name": "Appdata Data",
      "host": "/mnt/cache/appdata/libation/data",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    },
    {
      "name": "Appdata Config",
      "host": "/mnt/cache/appdata/libation/config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    },
    {
      "name": "Audiobooks Storage",
      "host": "/mnt/cache/audiobooks",
      "container": "/audiobooks",
      "mode": "rw",
      "description": "Container Path: /audiobooks",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin Username",
      "key": "ADMIN_USERNAME",
      "value": "admin",
      "description": "Container Variable: ADMIN_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": "admin",
      "description": "Container Variable: ADMIN_PASSWORD",
      "required": false,
      "mask": true
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": "change-me-use-a-long-random-string",
      "description": "Used to sign authentication tokens. Use a random string of at least 32 characters \u2014 longer is better. Avoid $ and &quot; characters.",
      "required": true,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "Access Token Expire Minutes",
      "key": "ACCESS_TOKEN_EXPIRE_MINUTES",
      "value": "15",
      "description": "Container Variable: ACCESS_TOKEN_EXPIRE_MINUTES",
      "required": false,
      "mask": false
    },
    {
      "name": "Refresh Token Expire Days",
      "key": "REFRESH_TOKEN_EXPIRE_DAYS",
      "value": "60",
      "description": "Container Variable: REFRESH_TOKEN_EXPIRE_DAYS",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
