{
  "name": "starbase",
  "repo": "jordanroher/starbase-80",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/jordanroher/starbase-80",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4173]",
  "icon": "https://i.imgur.com/dMTz5iU.png",
  "project": "https://github.com/notclickable-jordan/starbase-80",
  "description": "A nice looking homepage for Docker containers or any services and links. Create a config.json file in the app data location, then copy and paste the following from https://github.com/notclickable-jordan/starbase-80/blob/main/config.json.sample Modify per your requirements",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/starbase/config.json",
      "container": "/app/src/config.json",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Favicon",
      "host": "/mnt/cache/appdata/starbase/fav.ico",
      "container": "/app/public/favicon.ico",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Logo",
      "host": "/mnt/cache/appdata/starbase/logo.png",
      "container": "/app/public/logo.png",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Icons",
      "host": "/mnt/cache/appdata/starbase/icons",
      "container": "/app/public/icons",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4173",
      "container": "4173",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TITLE",
      "key": "TITLE",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
