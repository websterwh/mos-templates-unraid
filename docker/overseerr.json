{
  "name": "overseerr",
  "repo": "lscr.io/linuxserver/overseerr",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/overseerr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5055]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/overseerr-logo.png",
  "project": "https://overseerr.dev/",
  "description": "Overseerr(https://overseerr.dev/) is a request management and media discovery tool built to work with your existing Plex ecosystem.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5055",
      "container": "5055",
      "protocol": "tcp",
      "description": "Port for Overseerr's web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
