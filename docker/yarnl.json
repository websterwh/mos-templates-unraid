{
  "name": "yarnl",
  "repo": "titandrive/yarnl",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/titandrive/yarnl/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/titandrive/yarnl-unraid/main/icon.png",
  "project": "https://yarnl.com",
  "description": "Your self-hosted crochet companion. Manage crochet patterns, track project progress, and organize your pattern library. Supports multi-user, OIDC/SSO, scheduled backups, and more.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/yarnl/users",
      "container": "/app/users",
      "mode": "rw",
      "description": "Location where Yarnl stores all user data including patterns, thumbnails, notes, and backups",
      "required": true
    },
    {
      "name": "Backup Path",
      "host": "",
      "container": "/backups",
      "mode": "rw",
      "description": "Optional: mount an external path to store backups. Set 'Use External Backup Path' to true if using this.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Use External Backup Path",
      "key": "BACKUP_PATH",
      "value": "",
      "description": "Set to true to store backups at the mounted Backup Path volume. Leave blank to store backups in App Data.",
      "required": false,
      "mask": false
    },
    {
      "name": "Admin Username",
      "key": "ADMIN_USERNAME",
      "value": "admin",
      "description": "Initial admin account username",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": "",
      "description": "Initial admin password (leave empty for passwordless login)",
      "required": false,
      "mask": true
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "UTC",
      "description": "Timezone for scheduled backups (e.g. America/New_York)",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Host",
      "key": "POSTGRES_HOST",
      "value": "yarnl-db",
      "description": "Hostname of the PostgreSQL container",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "POSTGRES_PORT",
      "value": "5432",
      "description": "Port for the PostgreSQL database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "POSTGRES_DB",
      "value": "yarnl",
      "description": "Name of the PostgreSQL database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Username",
      "key": "POSTGRES_USER",
      "value": "yarnl",
      "description": "PostgreSQL database username",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "POSTGRES_PASSWORD",
      "value": "yarnl",
      "description": "PostgreSQL database password",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
