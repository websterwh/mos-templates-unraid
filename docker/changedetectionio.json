{
  "name": "changedetection.io",
  "repo": "lscr.io/linuxserver/changedetection.io",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/changedetection.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "https://github.com/dgtlmoon/changedetection.io",
  "description": "Changedetection.io(https://github.com/dgtlmoon/changedetection.io) provides free, open-source web page monitoring, notification and change detection.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "BASE_URL",
      "key": "BASE_URL",
      "value": "",
      "description": "Specify the full URL (including protocol) when running behind a reverse proxy",
      "required": false,
      "mask": false
    },
    {
      "name": "PLAYWRIGHT_DRIVER_URL",
      "key": "PLAYWRIGHT_DRIVER_URL",
      "value": "",
      "description": "Specify the full URL to your chrome driver instance. See the wiki(https://github.com/dgtlmoon/changedetection.io/wiki/Playwright-content-fetcher) for details.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
