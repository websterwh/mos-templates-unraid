{
  "name": "stable-diffusion",
  "repo": "nicklucche/stable-diffusion",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/nicklucche/stable-diffusion",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7860]/",
  "icon": "https://stablediffusion.fr/sd.png",
  "project": null,
  "description": "GPU-ready Dockerfile to run the Stability.AI stable-diffusion model with a simple web interface",
  "paths": [
    {
      "name": "Models",
      "host": "/mnt/cache/appdata/stablediffusion",
      "container": "/root/.cache/huggingface/diffusers",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "7860",
      "container": "7860",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
