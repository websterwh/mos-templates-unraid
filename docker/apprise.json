{
  "name": "apprise",
  "repo": "caronc/apprise:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/caronc/apprise/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/apprise.png",
  "project": "https://github.com/caronc/apprise",
  "description": "Apprise API - Push Notifications that work with just about every platform!",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/apprise/",
      "container": "/config",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APPRISE_WORKER_COUNT",
      "key": "APPRISE_WORKER_COUNT",
      "value": "8",
      "description": "Limit the number of workers (by default: 1 + 2 * number of CPUs) to reduce the amount of memory used by the tool",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
