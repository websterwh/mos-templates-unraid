{
  "name": "WebDAV",
  "repo": "ck98/webdav-nginx",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/ck98/webdav-nginx",
  "network": "Bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://camo.githubusercontent.com/ea0e36ac93ea7197dc50aa83adbd3269f7434e6f9a2aed50594cb5c7dc7aaaf3/687474703a2f2f73616272652e696f2f696d672f6c6f676f2e706e67",
  "project": "https://sabre.io/",
  "description": "Very simple WebDAV server based on SabreDav and NGINX as the webserver. This should work with Windows Explorer as the client.",
  "paths": [
    {
      "name": "FILES_LOCATION",
      "host": "/mnt/cache/location/of/files/",
      "container": "/var/webdav/public",
      "mode": "rw",
      "description": "Container Path: /var/webdav/public",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP_PORT",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "WEBDAV_USERNAME",
      "key": "WEBDAV_USERNAME",
      "value": "USERNAME",
      "description": "Container Variable: WEBDAV_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "WEBDAV_PASSWORD",
      "key": "WEBDAV_PASSWORD",
      "value": "PASSWORD",
      "description": "Container Variable: WEBDAV_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "User ID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "Group ID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "umask",
      "key": "UMASK",
      "value": "0000",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
