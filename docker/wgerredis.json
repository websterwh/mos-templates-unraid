{
  "name": "wger-redis",
  "repo": "redis",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/_/redis/",
  "network": "wger_network",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--health-cmd=redis-cli ping --health-interval=10s --health-retries=5 --health-start-period=30s --health-timeout=5s",
  "post_parameters": "redis-server /usr/local/etc/redis/redis.conf",
  "web_ui_url": "http://[IP]:[PORT:6379]",
  "icon": "https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/wger-logo.png",
  "project": "https://redis.io/",
  "description": "Redis is used as cache and Celery message broker for the wger application.",
  "paths": [
    {
      "name": "REDIS_DATA",
      "host": "/mnt/cache/appdata/wger/redis/",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent Redis data directory",
      "required": true
    },
    {
      "name": "REDIS_CONF",
      "host": "/mnt/cache/appdata/wger/redis/",
      "container": "/usr/local/etc/redis/",
      "mode": "rw",
      "description": "Redis configuration directory",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "PORT",
      "host": "6379",
      "container": "6379",
      "protocol": "tcp",
      "description": "Redis port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "File creation mask",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
