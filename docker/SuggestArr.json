{
  "name": "SuggestArr",
  "repo": "ciuse99/suggestarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/ciuse99/suggestarr",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/master/logos/suggestarr.png",
  "project": "https://github.com/giuseppe99barchetta/suggestarr",
  "description": "Automatically request suggested movies and TV shows to Jellyseerr based on recently watched.",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/suggestarr",
      "container": "/app/config/config_files",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5155",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
