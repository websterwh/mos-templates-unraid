{
  "name": "Retrom",
  "repo": "ghcr.io/jmberesford/retrom-service:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jmberesford/retrom-service",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/retrom-icon.png",
  "project": "https://github.com/JMBeresford/retrom",
  "description": "Retrom is a centralized game library management service that allows you to host your games on a single device, and connect clients on any amount of other devices to (un)install/download and subsequently launch said games locally.",
  "paths": [
    {
      "name": "Library",
      "host": "",
      "container": "/library",
      "mode": "rw",
      "description": "Library of games",
      "required": true
    },
    {
      "name": "Config data",
      "host": "/mnt/cache/appdata/retrom/config",
      "container": "/config",
      "mode": "rw",
      "description": "Config data for application",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Access web interface",
      "required": true,
      "mask": false
    },
    {
      "name": "Service Port",
      "host": "5101",
      "container": "5101",
      "protocol": "tcp",
      "description": "Allow external clients to connect to server",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
