{
  "name": "zabbix-agent2",
  "repo": "zabbix/zabbix-agent2:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/zabbix/zabbix-agent",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/vrx-666/unraid-xml/master/img/zabbix.jpg",
  "project": null,
  "description": "This container is just official Zabbix Agent image. Any Zabbix Server configuration/setup will need to be completed by yourself. To set this container up just edit the following: * \"ZABBIX_SERVER_HOSTNAME\" to your Unraid server hostname * \"ZABBIX_SERVER_IP\" to the IP address of your Zabbix Server or Proxy If you would like Zabbix to monitor disks as well as system resources you will need to add each one as a path manually. Please view the guide available on the forums.",
  "paths": [
    {
      "name": "cache disks",
      "host": "/mnt/cache",
      "container": "/mnt/cache",
      "mode": "ro",
      "description": "Container Path: /mnt/cache",
      "required": false
    },
    {
      "name": "array disk",
      "host": "/mnt/user",
      "container": "/mnt/array",
      "mode": "ro",
      "description": "Container Path: /mnt/array",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "ZBX_HOSTNAME",
      "key": "ZBX_HOSTNAME",
      "value": "ZABBIX_SERVER_HOSTNAME",
      "description": "Container Variable: ZBX_HOSTNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "ZBX_SERVER_HOST",
      "key": "ZBX_SERVER_HOST",
      "value": "ZABBIX_SERVER_IP",
      "description": "Container Variable: ZBX_SERVER_HOST",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
