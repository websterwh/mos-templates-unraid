{
  "name": "Shadowsocks",
  "repo": "shadowsocks/shadowsocks-libev",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/shadowsocks/shadowsocks-libev",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8388]",
  "icon": "https://github.com/Flight777/unraid_justworks_templates/blob/main/images/shadowsocks/1200px-Shadowsocks-Logo.svg.png?raw=true",
  "project": "https://github.com/shadowsocks/shadowsocks-libev/blob/master/docker/alpine/README.md",
  "description": "A secure SOCKS5 proxy. Shadowsocks is a free and open-source encryption protocol project, widely used in China to circumvent Internet censorship. It was created in 2012 by a Chinese programmer named \"clowwindy\", and multiple implementations of the protocol have been made available since. Can be used with any SOCKS or Shadowsocks client. Can be seen as a alternative, hard to detect, VPN as well. Unraid template that JUST WORKS, brought to you by Flight777! Container does not have a WEBUI, as it's very lightweight and all settings are set by the variables. Check the logs to verify it is running correctly!",
  "paths": [],
  "ports": [
    {
      "name": "Port TCP",
      "host": "8388",
      "container": "8388",
      "protocol": "tcp",
      "description": "Container Port: 8388",
      "required": true,
      "mask": false
    },
    {
      "name": "Port UDP",
      "host": "8388",
      "container": "8388",
      "protocol": "udp",
      "description": "Container Port: 8388",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Shadowsocks Password (for connecting later)",
      "key": "PASSWORD",
      "value": "",
      "description": "Container Variable: PASSWORD",
      "required": true,
      "mask": true
    },
    {
      "name": "Encryption Method",
      "key": "METHOD",
      "value": "chacha20-ietf-poly1305",
      "description": "Container Variable: METHOD",
      "required": true,
      "mask": false
    },
    {
      "name": "DNS Addresses (comma seperated, default: google)",
      "key": "DNS_ADDRS",
      "value": "8.8.8.8,8.8.4.4",
      "description": "Container Variable: DNS_ADDRS",
      "required": true,
      "mask": false
    },
    {
      "name": "Connection Timeout (seconds)",
      "key": "TIMEOUT",
      "value": "300",
      "description": "Container Variable: TIMEOUT",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
