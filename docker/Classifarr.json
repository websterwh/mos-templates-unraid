{
  "name": "Classifarr",
  "repo": "ghcr.io/cloudbyday90/classifarr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/cloudbyday90/classifarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:21324]/",
  "icon": "https://raw.githubusercontent.com/cloudbyday90/Classifarr/refs/heads/main/logo/icon.png",
  "project": "https://github.com/cloudbyday90/Classifarr",
  "description": "Classifarr is an intelligent media classification platform that automatically routes incoming requests from Overseerr/Jellyseerr to the correct Radarr/Sonarr library using AI and machine learning.",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/classifarr/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to persistent config data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "21324",
      "container": "21324",
      "protocol": "tcp",
      "description": "Container Port: 21324",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": "The environment the app is running in",
      "required": true,
      "mask": false
    },
    {
      "name": "Node Options",
      "key": "NODE_OPTIONS",
      "value": "--max-old-space-size=1536",
      "description": "Options for Node environment",
      "required": true,
      "mask": false
    },
    {
      "name": "Task Queue Retention",
      "key": "TASK_QUEUE_RETENTION_DAYS",
      "value": "7",
      "description": "How long completed tasks are retained before auto-cleanup",
      "required": true,
      "mask": false
    },
    {
      "name": "pgvector Runtime Staging",
      "key": "PGVECTOR_RUNTIME_STAGING",
      "value": "auto",
      "description": "Runtime pgvector staging is opportunistic: use AVX/AVX2 when the PostgreSQL runtime mount permits it, otherwise fall back to generic.",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
