{
  "name": "ThinkDashboard",
  "repo": "ghcr.io/matiasdesuu/thinkdashboard:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/matiasdesuu/thinkdashboard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/MatiasDesuu/ThinkDashboard/main/static/favicon.ico",
  "project": "https://github.com/MatiasDesuu/ThinkDashboard",
  "description": "A lightweight, self-hosted bookmark dashboard built with Go and vanilla JavaScript. This Unraid template is maintained by the community, not the original developer. All credit goes to the original author, MatiasDesuu.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/thinkdashboard",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
