{
  "name": "Malla---Capture",
  "repo": "ghcr.io/zenitram/malla:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/zenitram/malla",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "/app/.venv/bin/malla-capture",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/malla-icon.png",
  "project": "https://github.com/zenitraM/malla",
  "description": "Malla is a web analyzer for Meshtastic networks based on MQTT data. This is the capture component.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/malla/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to store Malla data.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "MQTT - Address",
      "key": "MALLA_MQTT_BROKER_ADDRESS",
      "value": "",
      "description": "MQTT broker address (IP or hostname) where Meshtastic devices publish data.",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - Port",
      "key": "MALLA_MQTT_PORT",
      "value": "1883",
      "description": "MQTT broker port.",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - Username",
      "key": "MALLA_MQTT_USERNAME",
      "value": "",
      "description": "MQTT broker username (if required).",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT - Password",
      "key": "MALLA_MQTT_PASSWORD",
      "value": "",
      "description": "MQTT broker password (if required).",
      "required": false,
      "mask": true
    },
    {
      "name": "MQTT - Topic Prefix",
      "key": "MALLA_MQTT_TOPIC_PREFIX",
      "value": "msh",
      "description": "MQTT topic prefix used by Meshtastic devices.",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT - Topic Suffix",
      "key": "MALLA_MQTT_TOPIC_SUFFIX",
      "value": "/+/+/+/#",
      "description": "MQTT topic suffix used by Meshtastic devices.",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT - Default Channel Key",
      "key": "MALLA_DEFAULT_CHANNEL_KEY",
      "value": "",
      "description": "Default channel key for decrypting Meshtastic messages (if used).",
      "required": false,
      "mask": true
    },
    {
      "name": "Internal Database Path",
      "key": "MALLA_DATABASE_FILE",
      "value": "/app/data/meshtastic_history.db",
      "description": "Path to the internal database file inside the container. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
