{
  "name": "convos",
  "repo": "ghcr.io/convos-chat/convos:stable",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/convos-chat/convos/pkgs/container/convos",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/convos.png",
  "project": "https://convos.chat/",
  "description": "Convos is the simplest way to use IRC and it is always online",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/convos/",
      "container": "/data",
      "mode": "rw",
      "description": "Data Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3520",
      "container": "3000",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
