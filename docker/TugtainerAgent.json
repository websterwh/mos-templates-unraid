{
  "name": "Tugtainer-Agent",
  "repo": "quenary/tugtainer-agent:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/quenary/tugtainer-agent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--tmpfs /run",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8001]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tugtainer-icon.png",
  "project": "https://github.com/Quenary/tugtainer",
  "description": "Automate updates of your Docker containers. This is the companion agent for Tugtainer.",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9413",
      "container": "8001",
      "protocol": "tcp",
      "description": "Container Port: 8001",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Agent Secret",
      "key": "AGENT_SECRET",
      "value": "",
      "description": "Secret key for agent authentication (must match Tugtainer server)",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
