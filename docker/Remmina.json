{
  "name": "Remmina",
  "repo": "ghcr.io/ich777/remmina",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ich777/remmina/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/vnc.html?autoconnect=true",
  "icon": "https://raw.githubusercontent.com/ich777/docker-templates/master/ich777/images/remmina.png",
  "project": "https://remmina.org/",
  "description": "Remmina is a remote desktop client for POSIX-based computer operating systems. It supports the Remote Desktop Protocol, VNC, NX, XDMCP, SPICE and SSH protocols. With this container you can connect through VNC to your RDP session, SSH,... In the Docker Hub description for the container is a example how to reverse proxy noVNC with nginx and secure it via http basic authentification.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/remmina",
      "container": "/remmina",
      "mode": "rw",
      "description": "Container Path: /remmina",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "TCP - noVNC Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "TCP Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Custom Resolution Width",
      "key": "CUSTOM_RES_W",
      "value": "1280",
      "description": "Custom Resolution Width",
      "required": true,
      "mask": false
    },
    {
      "name": "Custom Resolution Height",
      "key": "CUSTOM_RES_H",
      "value": "1024",
      "description": "Custom Resolution Height",
      "required": true,
      "mask": false
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": "Container Variable: UID",
      "required": true,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": "Container Variable: GID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": "Container Variable: UMASK",
      "required": true,
      "mask": false
    },
    {
      "name": "DATA_PERM",
      "key": "DATA_PERM",
      "value": "770",
      "description": "Container Variable: DATA_PERM",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
