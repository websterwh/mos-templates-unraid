{
  "name": "macreplayv2",
  "repo": "ghcr.io/t4s3rf4c3/macreplay_v2:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/t4s3rf4c3/macreplay_v2",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8001]",
  "icon": "https://raw.githubusercontent.com/T4s3rF4c3/macreplay_v2/main/static/favicon.ico",
  "project": "https://github.com/T4s3rF4c3/macreplay_v2",
  "description": "MacReplayV2 is an improved IPTV portal proxy that allows you to manage and stream IPTV channels with advanced features like enhanced channel editing, EPG support, MAC address rotation, smart fallback systems, and portal management. Perfect for integrating with Plex or M3U-based media software.",
  "paths": [
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/macreplayv2/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Application data directory",
      "required": true
    },
    {
      "name": "Logs Directory",
      "host": "/mnt/cache/appdata/macreplayv2/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Application logs directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID (99 = nobody)",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID (100 = users)",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Timezone",
      "required": true,
      "mask": false
    },
    {
      "name": "Python Unbuffered",
      "key": "PYTHONUNBUFFERED",
      "value": "1",
      "description": "Python unbuffered output",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
