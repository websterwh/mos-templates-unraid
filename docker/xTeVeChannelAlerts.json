{
  "name": "xTeVe-Channel-Alerts",
  "repo": "celsian/xteve-channel-alerts:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/celsian/xteve-channel-alerts",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://i.imgur.com/sxHKgvi.png",
  "project": "https://github.com/celsian/xteve-channel-alerts",
  "description": "Occasionally you may find that a channel you want to watch has disappeared from your xTeVe playlist. With xTeVe-Channel-Alerts, you can stay informed about these changes. When configured to run after your automatic xTeVe update, it compares the current channel list with the previous. If xTeVe-Channel-Alerts detects a missing channel, it sends a detailed rich-embed message to your Discord webhook, keeping you in the loop.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/xteve-channel-alerts/",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "xTeVe URL",
      "key": "XTEVE_URL",
      "value": "",
      "description": "http://localhost:34400/m3u/xteve.m3u",
      "required": false,
      "mask": false
    },
    {
      "name": "Discord Webhook URL",
      "key": "DISCORD_WEBHOOK_URL",
      "value": "",
      "description": "https://discord.com/api/webhooks/webhook_id/token",
      "required": false,
      "mask": false
    },
    {
      "name": "Cron Schedule",
      "key": "CRON_SCHEDULE",
      "value": "0 4 * * *",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
