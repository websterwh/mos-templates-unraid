{
  "name": "Reticulum-MeshChat",
  "repo": "ghcr.io/liamcottle/reticulum-meshchat:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/liamcottle/reticulum-meshchat",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/liamcottle/reticulum-meshchat/master/logo/logo-chat-bubble.png",
  "project": "https://meshchat.app/",
  "description": "A simple mesh network communications app powered by the Reticulum Network Stack.",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/reticulum_meshchat/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
