{
  "name": "rdt-client",
  "repo": "rogerfar/rdtclient:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/rogerfar/rdtclient/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6500]",
  "icon": "https://raw.githubusercontent.com/fizzyfrys/unraid-templates/main/icons/premrealldebrid.png",
  "project": "https://github.com/rogerfar/rdt-client",
  "description": "This is a web interface to manage your torrents on Real-Debrid, AllDebrid or Premiumize. It supports the following features: - Add new torrents through magnets or files - Download all files from Real-Debrid, AllDebrid or Premiumize to your local machine automatically - Unpack all files when finished downloading - Implements a fake qBittorrent API so you can hook up other applications like Sonarr, Radarr or Couchpotato.",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/rdt-client/db",
      "container": "/data/db",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Downloads",
      "host": "/mnt/user",
      "container": "/data/downloads",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port",
      "host": "6500",
      "container": "6500",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
