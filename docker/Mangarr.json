{
  "name": "Mangarr",
  "repo": "kirantheram/mangarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/kirantheram/mangarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6996]/",
  "icon": "https://raw.githubusercontent.com/KiranTheRam/mangarr/main/frontend/public/mangarr-icon.png",
  "project": "https://github.com/KiranTheRam/mangarr",
  "description": "Monitor manga series, download missing chapters, and organize CBZ files for Komga or Kavita.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/mangarr",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent database, API key, and settings.",
      "required": true
    },
    {
      "name": "Media",
      "host": "/mnt/cache/media",
      "container": "/media",
      "mode": "rw",
      "description": "Shared media folder. Use /media/manga as a root folder and /media/torrents as the downloads folder.",
      "required": true
    },
    {
      "name": "Manga Library",
      "host": "/mnt/cache/media/manga",
      "container": "/manga",
      "mode": "rw",
      "description": "Bind the image-declared /manga volume to the same manga library folder.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "6996",
      "container": "6996",
      "protocol": "tcp",
      "description": "Mangarr web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
