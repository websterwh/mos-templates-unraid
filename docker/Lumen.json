{
  "name": "Lumen",
  "repo": "ghcr.io/checksumdev/lumen:nightly",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/checksumdev/lumen",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/lumen-icon.png",
  "project": "https://lumen.checksum.space",
  "description": "Lumen is an astronomically fast ShareX uploader written in Rust using the Actix Web framework See documentation: https://github.com/ChecksumDev/lumen#usage-",
  "paths": [
    {
      "name": "App Data Path",
      "host": "/mnt/cache/appdata/lumen/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to app data files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Public URL",
      "key": "PUBLIC_URL",
      "value": "https://mydomain.com",
      "description": "Public URL for the app",
      "required": true,
      "mask": false
    },
    {
      "name": "Bind",
      "key": "BIND",
      "value": "localhost:8080",
      "description": "Internal web server bind address",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
