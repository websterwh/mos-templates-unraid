{
  "name": "Sia",
  "repo": "mtlynch/sia",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/mtlynch/sia/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://i.imgur.com/XiSQgV4.png",
  "project": "https://sia.tech/",
  "description": "Sia is a decentralized storage platform secured by blockchain technology. The Sia Storage Platform leverages underutilized hard drive capacity around the world to create a data storage marketplace that is more reliable and lower cost than traditional cloud storage providers.",
  "paths": [
    {
      "name": "Container path on host",
      "host": "/mnt/cache/Sia",
      "container": "/sia-data",
      "mode": "rw",
      "description": "Container Path: /sia-data",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Sia modules",
      "key": "SIA_MODULES",
      "value": "gctwh",
      "description": "Container Variable: SIA_MODULES",
      "required": false,
      "mask": false
    },
    {
      "name": "Sia wallet password",
      "key": "SIA_WALLET_PASSWORD",
      "value": "",
      "description": "Container Variable: SIA_WALLET_PASSWORD",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
