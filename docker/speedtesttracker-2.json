{
  "name": "speedtest-tracker",
  "repo": "lscr.io/linuxserver/speedtest-tracker",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/speedtest-tracker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/speedtest-tracker-logo.png",
  "project": "https://github.com/alexjustesen/speedtest-tracker",
  "description": "Speedtest-tracker(https://github.com/alexjustesen/speedtest-tracker) is a self-hosted internet performance tracking application that runs speedtest checks against Ookla's Speedtest service.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Contains speedtest-tracker config and database, if using sqlite.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Web UI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_KEY",
      "key": "APP_KEY",
      "value": "",
      "description": "App key used for encrypting stored data. You can generate a key as per https://speedtest-tracker.dev(https://docs.speedtest-tracker.dev/getting-started/installation/using-docker-compose#install-with-docker-compose)",
      "required": true,
      "mask": true
    },
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "",
      "description": "The IP:port or URL your application will be accessed on (ie. `http://192.168.1.1:6875` or `https://bookstack.mydomain.com`",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_CONNECTION",
      "key": "DB_CONNECTION",
      "value": "sqlite",
      "description": "Set the database type to use. `sqlite`, `pgsql`, or `mysql`",
      "required": true,
      "mask": false
    },
    {
      "name": "SPEEDTEST_SCHEDULE",
      "key": "SPEEDTEST_SCHEDULE",
      "value": "",
      "description": "Set the test schedule in cron format. e.g. `0 */6 * * *`",
      "required": true,
      "mask": false
    },
    {
      "name": "SPEEDTEST_SERVERS",
      "key": "SPEEDTEST_SERVERS",
      "value": "",
      "description": "A comma-separated list of server IDs to test against. Run `docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/speedtest-tracker:latest list-servers` to get a list of nearby servers.",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "Database hostname (postgres/mysql).",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "",
      "description": "Database port (postgres/mysql).",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_DATABASE",
      "key": "DB_DATABASE",
      "value": "",
      "description": "Database name (postgres/mysql).",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": "",
      "description": "Database username (postgres/mysql).",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "Database password (postgres/mysql).",
      "required": false,
      "mask": true
    },
    {
      "name": "DISPLAY_TIMEZONE",
      "key": "DISPLAY_TIMEZONE",
      "value": "Etc/UTC",
      "description": "Timezone for the UI.",
      "required": false,
      "mask": false
    },
    {
      "name": "PRUNE_RESULTS_OLDER_THAN",
      "key": "PRUNE_RESULTS_OLDER_THAN",
      "value": "0",
      "description": "Days to keep test results.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
