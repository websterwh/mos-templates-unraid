{
  "name": "emqx",
  "repo": "emqx/emqx",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/emqx/emqx",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:18083]/",
  "icon": "https://avatars.githubusercontent.com/u/25221711?v=4/25221711.png",
  "project": "https://hub.docker.com/r/emqx/emqx",
  "description": "EMQX is the world's most scalable open-source MQTT broker with a high performance that connects 100M+ IoT devices in 1 cluster, while maintaining 1M message per second throughput and sub-millisecond latency. Configuration All EMQX Configuration in etc/emqx.conf can be configured via environment variables. By default, the environment variables with EMQX_ prefix are mapped to key-value pairs in configuration files. You can change the prefix by overriding HOCON_ENV_OVERRIDE_PREFIX. default login: admin:public",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/emqx",
      "container": "/opt/emqx/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "logs",
      "host": "/mnt/cache/appdata/emqx/log/",
      "container": "/opt/emqx/log",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
