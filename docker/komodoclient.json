{
  "name": "komodo-client",
  "repo": "ghcr.io/moghtech/komodo-periphery:latest",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/moghtech/komodo-periphery",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8120]",
  "icon": "https://raw.githubusercontent.com/waazaa-fr/unraid-templates/refs/heads/main/komodo-512x512.png",
  "project": "https://komo.do/docs/setup/connect-servers",
  "description": "Connecting Unraid to Komodo.",
  "paths": [
    {
      "name": "/var/run/docker.sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "/mnt/user",
      "host": "/mnt/user",
      "container": "/mnt/user",
      "mode": "ro",
      "description": null,
      "required": false
    },
    {
      "name": "/proc",
      "host": "/proc",
      "container": "/proc",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "/etc/komodo",
      "host": "/etc/komodo",
      "container": "/etc/komodo",
      "mode": "ro",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "PORT",
      "host": "8120",
      "container": "8120",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PERIPHERY_PASSKEYS",
      "key": "PERIPHERY_PASSKEYS",
      "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "description": "Pass the same passkey as used by the Komodo Core connecting to this Periphery agent.",
      "required": false,
      "mask": false
    },
    {
      "name": "PERIPHERY_INCLUDE_DISK_MOUNTS",
      "key": "PERIPHERY_INCLUDE_DISK_MOUNTS",
      "value": "/mnt/user",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PERIPHERY_ROOT_DIRECTORY",
      "key": "PERIPHERY_ROOT_DIRECTORY",
      "value": "/etc/komodo",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PERIPHERY_SSL_ENABLED",
      "key": "PERIPHERY_SSL_ENABLED",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PERIPHERY_DISABLE_TERMINALS",
      "key": "PERIPHERY_DISABLE_TERMINALS",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PERIPHERY_INCLUDE_DISK_MOUNTS",
      "key": "PERIPHERY_INCLUDE_DISK_MOUNTS",
      "value": "/etc/hostname",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
