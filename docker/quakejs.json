{
  "name": "quakejs",
  "repo": "treyyoder/quakejs:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/treyyoder/quakejs/",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/quakejs.png",
  "project": "https://github.com/treyyoder/quakejs-docker",
  "description": "QuakeJS is a port of ioquake3 to JavaScript with the help of Emscripten. IMPORTANT Use Custom:br0 https://youtu.be/2VnQxxn00jU?t=121 put Fixed IP address, then copy the ip and access it using you broswer DON'T USE BRIDGE I'M NOT RESPONSABLE FOR Unraid CONFLICTING WITH PORT 80 FOR THIS DOCKER",
  "paths": [],
  "ports": [
    {
      "name": "Game Port",
      "host": "27960",
      "container": "27960",
      "protocol": "tcp",
      "description": "Game Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "HTTP",
      "key": "80",
      "value": "80",
      "description": "HTTP",
      "required": true,
      "mask": false
    },
    {
      "name": "SERVER",
      "key": "SERVER",
      "value": "192.168.0.266",
      "description": "Put your Fixed IP address Here",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP_PORT",
      "key": "HTTP_PORT",
      "value": "80",
      "description": "HTTP_PORT",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
