{
  "name": "ShelfBridge",
  "repo": "ghcr.io/rohit-purandare/shelfbridge:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/rohit-purandare/ShelfBridge/pkgs/container/shelfbridge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=no",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/rohit-purandare/ShelfBridge-unraid-templates/master/icon.png",
  "project": "https://github.com/rohit-purandare/ShelfBridge",
  "description": "Sync your audiobook reading progress from Audiobookshelf to Hardcover automatically.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/shelfbridge/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Container config directory",
      "required": true
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/shelfbridge/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Container data directory",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/shelfbridge/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Container logs directory",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "User ID",
      "key": "SHELFBRIDGE_USER_0_ID",
      "value": "",
      "description": "Your username/identifier (any name you choose)",
      "required": true,
      "mask": false
    },
    {
      "name": "Audiobookshelf URL",
      "key": "SHELFBRIDGE_USER_0_ABS_URL",
      "value": "",
      "description": "URL of your Audiobookshelf server (include https://)",
      "required": true,
      "mask": false
    },
    {
      "name": "Audiobookshelf Token",
      "key": "SHELFBRIDGE_USER_0_ABS_TOKEN",
      "value": "",
      "description": "API token from your Audiobookshelf server",
      "required": true,
      "mask": true
    },
    {
      "name": "Hardcover Token",
      "key": "SHELFBRIDGE_USER_0_HARDCOVER_TOKEN",
      "value": "",
      "description": "API token from Hardcover (hardcover.app/account/api)",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
