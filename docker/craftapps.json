{
  "name": "craft-apps",
  "repo": "lscr.io/linuxserver/craft-apps",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/craft-apps",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:3001]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "https://getartcraft.com/",
  "description": "ArtCraft(https://getartcraft.com/) is a suite of open source creative applications written in Rust. This image bundles PhotoCraft (image editor), VectorCraft (vector illustration), FilmCraft (video editor), LightCraft (photo library and raw developer), PdfCraft (PDF workbench), EffectCraft (motion graphics and VFX compositor), DesignCraft (page layout and publishing) and FigCraft (interface design and prototyping) in a single desktop.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Users home directory in the container, stores local files and settings",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "HTTP Craft Apps desktop gui, must be proxied.",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 3001",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "HTTPS Craft Apps desktop gui.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
