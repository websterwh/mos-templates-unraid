{
  "name": "Drone",
  "repo": "drone/drone",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/drone/drone/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/drone.png",
  "project": "https://github.com/harness/drone",
  "description": "Drone is a Continuous Integration platform built on Docker",
  "paths": [
    {
      "name": "Data directory",
      "host": "/mnt/cache/appdata/drone",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "GitHub Client ID",
      "key": "DRONE_GITHUB_CLIENT_ID",
      "value": "",
      "description": "Container Variable: DRONE_GITHUB_CLIENT_ID",
      "required": true,
      "mask": false
    },
    {
      "name": "GitHub Client Secret",
      "key": "DRONE_GITHUB_CLIENT_SECRET",
      "value": "",
      "description": "Container Variable: DRONE_GITHUB_CLIENT_SECRET",
      "required": true,
      "mask": true
    },
    {
      "name": "Shared Secret",
      "key": "DRONE_RPC_SECRET",
      "value": "",
      "description": "Container Variable: DRONE_RPC_SECRET",
      "required": true,
      "mask": true
    },
    {
      "name": "Host",
      "key": "DRONE_SERVER_HOST",
      "value": "drone.example.com",
      "description": "Container Variable: DRONE_SERVER_HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "Protocol",
      "key": "DRONE_SERVER_PROTO",
      "value": "https",
      "description": "Container Variable: DRONE_SERVER_PROTO",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
