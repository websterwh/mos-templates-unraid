  "project": null,
  "description": "Discord.js bot container. Set DISCORD_TOKEN to start. Optional Web UI on port 3000.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Host port for the Web UI (container port 3000)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Discord Bot Token",
      "key": "DISCORD_TOKEN",
      "value": "",
      "description": "Discord bot token (required)",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
