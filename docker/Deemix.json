{
  "name": "Deemix",
  "repo": "ghcr.io/bambanah/deemix:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/bambanah/deemix",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6595]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/deemix-icon.png",
  "project": "https://github.com/bambanah/deemix",
  "description": "Download content from Deezer.",
  "paths": [
    {
      "name": "Downloads Path",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Path to the downloads folder",
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/deemix/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "6595",
      "container": "6595",
      "protocol": "tcp",
      "description": "Container Port: 6595",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Single User",
      "key": "DEEMIX_SINGLE_USER",
      "value": "true|false",
      "description": "Enable single user mode",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Server Port",
      "key": "DEEMIX_SERVER_PORT",
      "value": "6595",
      "description": "Internal port for server. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Config Path",
      "key": "DEEMIX_DATA_DIR",
      "value": "/config",
      "description": "Internal path to config files. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Downloads Path",
      "key": "DEEMIX_MUSIC_DIR",
      "value": "/downloads",
      "description": "Internal path to downloads folder. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Host",
      "key": "DEEMIX_HOST",
      "value": "0.0.0.0",
      "description": "Internal host address. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK_SET",
      "value": "022",
      "description": "Set the umask for file permissions. Default is 022.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
