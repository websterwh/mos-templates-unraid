{
  "name": "ownfoil",
  "repo": "a1ex4/ownfoil",
  "category": [
    "Backup"
  ],
  "registry": "https://registry.hub.docker.com/r/a1ex4/ownfoil",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8465]",
  "icon": "https://raw.githubusercontent.com/type0dev/Unraid-Template/main/ownfoil/icon.png",
  "project": "https://github.com/a1ex4/ownfoil",
  "description": "Ownfoil is a Nintendo Switch library manager, that will also turn your library into a fully customizable and self-hosted Tinfoil Shop. The goal of this project is to manage your library, identify any missing content (DLCs or updates) and provide a user friendly way to browse your content. The project is still in development, expect things to break or change without notice.",
  "paths": [
    {
      "name": "Games Path",
      "host": "/mnt/cache/storage/games/switch",
      "container": "/games",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/ownfoil/config",
      "container": "/app/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8465",
      "container": "8465",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
