{
  "name": "baikal",
  "repo": "ghcr.io/aalmenar/baikal:latest",
  "category": [
    "Network"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/Joshndroid/joshndroid-unraid-docker-templates/main/icons/baikal.png",
  "project": "https://github.com/aalmenar/baikal-docker/pkgs/container/baikal",
  "description": "Ba\u00efkal is a lightweight CalDAV+CardDAV server",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/baikal/config",
      "container": "/var/www/baikal/config",
      "mode": "rw",
      "description": "Container Path: /var/www/baikal/config",
      "required": false
    },
    {
      "name": "Specific",
      "host": "/mnt/cache/appdata/baikal/specific",
      "container": "/var/www/baikal/Specific",
      "mode": "rw",
      "description": "Container Path: /var/www/baikal/Specific",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Container Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
