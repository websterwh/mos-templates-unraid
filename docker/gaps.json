{
  "name": "gaps",
  "repo": "housewrecker/gaps",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/housewrecker/gaps/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8484]",
  "icon": "https://raw.githubusercontent.com/JasonHHouse/Gaps/master/images/gaps.png",
  "project": "https://github.com/JasonHHouse/Gaps/",
  "description": "Search your movies and find missing movies from MovieDB collections.",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/gaps/",
      "container": "/usr/data",
      "mode": "rw",
      "description": "File path for gaps config and data storage.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "UI",
      "host": "8484",
      "container": "8484",
      "protocol": "tcp",
      "description": "Container Port: 8484",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Enable https for WebUI",
      "key": "ENABLE_SSL",
      "value": "false",
      "description": "true/false to enable WebUI https",
      "required": true,
      "mask": false
    },
    {
      "name": "Require login for WebUI",
      "key": "ENABLE_LOGIN",
      "value": "false",
      "description": "true/false to require login",
      "required": true,
      "mask": false
    },
    {
      "name": "Set Gaps Base URL for WebUI",
      "key": "BASE_URL",
      "value": "/",
      "description": "The base URL for Gaps WebUI",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
