{
  "name": "MySpeed",
  "repo": "germannewsmaker/myspeed",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/germannewsmaker/myspeed",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5216]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/myspeed_logo.png",
  "project": "https://myspeed.dev/",
  "description": "MySpeed is a Software that helps you keeping track of your network speed. It automatically creates speedtests based on your schedule and displays them in a list.",
  "paths": [
    {
      "name": "Data Dir",
      "host": "/mnt/cache/appdata/myspeed",
      "container": "/myspeed/data",
      "mode": "rw",
      "description": "Data Directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5216",
      "container": "5216",
      "protocol": "tcp",
      "description": "Web UI port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
