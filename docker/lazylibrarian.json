{
  "name": "lazylibrarian",
  "repo": "lscr.io/linuxserver/lazylibrarian",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/lazylibrarian",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5299]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/lazylibrarian-logo.png",
  "project": "https://lazylibrarian.gitlab.io/",
  "description": "Lazylibrarian(https://lazylibrarian.gitlab.io/) is a program to follow authors and grab metadata for all your digital reading needs. It uses a combination of Goodreads Librarything and optionally GoogleBooks as sources for author info and book info. This container is based on the DobyTang fork.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "LazyLibrarian config",
      "required": true
    },
    {
      "name": "Path: /downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Download location",
      "required": true
    },
    {
      "name": "Path: /books",
      "host": "",
      "container": "/books",
      "mode": "rw",
      "description": "Books location",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5299",
      "container": "5299",
      "protocol": "tcp",
      "description": "The port for the LazyLibrarian webinterface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DOCKER_MODS",
      "key": "DOCKER_MODS",
      "value": "linuxserver/mods:universal-calibre|linuxserver/mods:lazylibrarian-ffmpeg",
      "description": "Allows additional functionality to be added, e.g. the Calibredb import program (optional, more info below)",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
