{
  "name": "Subvert",
  "repo": "aschmelyun/subvert",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/aschmelyun/subvert",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/C4ArtZ/Unraid-Templates/master/templates/icons/subvert.png",
  "project": "https://github.com/aschmelyun/subvert/",
  "description": "Generate subtitles, chapters, and summaries of videos in seconds with the help of OpenAI. Keep in mind, that the OpenAI API is not free!",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Subvert will be available on this port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OPENAI_API_KEY",
      "key": "OPENAI_API_KEY",
      "value": "",
      "description": "https://platform.openai.com/account/api-keys",
      "required": true,
      "mask": true
    },
    {
      "name": "Max uploadable filesize",
      "key": "UPLOAD_MAX_FILESIZE",
      "value": "1G",
      "description": "Changes PHP's UPLOAD_MAX_FILESIZE setting. Default is 256M",
      "required": false,
      "mask": false
    },
    {
      "name": "Memory Limit",
      "key": "MEMORY_LIMIT",
      "value": "2G",
      "description": "Changes PHP's MEMORY_LIMIT setting. Default is 512M",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
