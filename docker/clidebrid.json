{
  "name": "cli_debrid",
  "repo": "godver3/cli_debrid:dev",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/godver3/cli_debrid/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--interactive --tty",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/godver3/cli_debrid/dev/static/color-favicon-512x512.png",
  "project": "https://github.com/godver3/cli_debrid",
  "description": "cli_debrid is a successor to, and pays homage to plex_debrid. cli_debrid is designed to automatically manage and upgrade your media collection, leveraging various sources and services to ensure you always have the best quality content available. Discord https://discord.gg/4qEMz4ay",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/cli_debrid/config",
      "container": "/user/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "DB",
      "host": "/mnt/cache/appdata/cli_debrid/db_content",
      "container": "/user/db_content",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/cli_debrid/logs",
      "container": "/user/logs",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Phalanx",
      "host": "/mnt/cache/appdata/cli_debrid/phalanx_db_hyperswarm/autobase_storage_v4",
      "container": "/app/phalanx_db_hyperswarm/autobase_storage_v4",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Mount",
      "host": "",
      "container": "/media/mount",
      "mode": "rw",
      "description": "optional - used for rclone mount",
      "required": false
    },
    {
      "name": "Symlink",
      "host": "",
      "container": "/mnt/symlinked",
      "mode": "rw",
      "description": "optional - used for symlink mount",
      "required": false
    },
    {
      "name": "Plex Data",
      "host": "",
      "container": "/plex_data",
      "mode": "rw",
      "description": "optional - used for overlay",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Webui",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
