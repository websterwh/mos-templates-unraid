{
  "name": "LyrionMusicServer",
  "repo": "ghcr.io/lms-community/lyrionmusicserver:rc",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/lms-community/lyrionmusicserver",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--log-opt max-size=50m --log-opt max-file=1",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9000]/",
  "icon": "https://raw.githubusercontent.com/devdems/unraid/master/docker-repo/images/lyrionmusicserver.png",
  "project": "https://lyrion.org/",
  "description": "Lyrion Music Server (formerly SlimServer, SqueezeCenter, Squeezebox Server, and Logitech Media Server) is a streaming audio server, developed in particular to support the Squeezebox range of digital audio receivers. Configuration: **/config** - this path is used to store the configuration and the database files of Lyrion Music Server. **/music** - set this path to where you store your music files.",
  "paths": [
    {
      "name": "Music Path",
      "host": "",
      "container": "/music",
      "mode": "rw",
      "description": "Set the music path to your server.",
      "required": true
    },
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/LyrionMusicServer",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Control Port - TCP",
      "host": "3483",
      "container": "3483",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Control Port - UDP",
      "host": "3483",
      "container": "3483",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "CLI Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
