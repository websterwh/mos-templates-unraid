{
  "name": "cura-novnc",
  "repo": "mikeah/cura-novnc",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/mikeah/cura-novnc",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/Ultimaker/Cura/main/resources/images/cura-icon.png",
  "project": "https://ultimaker.com/software/ultimaker-cura",
  "description": "Enjoy Cura directly in your browser with this easy to use Docker container. This template has the minimum variables defined, but you can find additional details on the template at the URLs listed below. https://github.com/helfrichmichael/cura-novnc https://hub.docker.com/r/mikeah/cura-novnc",
  "paths": [
    {
      "name": "Home folder",
      "host": "/mnt/cache/appdata/cura",
      "container": "/home/cura/",
      "mode": "rw",
      "description": "Container Path: /home/cura/",
      "required": true
    },
    {
      "name": "Prints",
      "host": "/mnt/cache/3D Printing/",
      "container": "/prints/",
      "mode": "rw",
      "description": "3D Printing Folder",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "VNC Interface",
      "host": "6080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
