{
  "name": "BELABOX-Receiver",
  "repo": "kezzkezz/belabox",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/kezzkezz/belabox",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://github.com/715209/nginx-obs-automatic-low-bitrate-switching/raw/v2/noalbsicopre2.ico",
  "project": "https://github.com/kezzkezzkezz/belabox-receiver",
  "description": "Belabox receiver-side (srtla, srt-live-transmit, srt-live-server and noalbs) in a single container.",
  "paths": [
    {
      "name": "Location of Config.json",
      "host": "",
      "container": "/app/config.json",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Location of sls.conf",
      "host": "",
      "container": "/etc/sls/sls.conf",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "location of .env",
      "host": "",
      "container": "/app/.env",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "SRTLA Port",
      "host": "5000",
      "container": "5000",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SRT Live Port",
      "host": "8181",
      "container": "8181",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SRT Transmit Port",
      "host": "8282",
      "container": "8282",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
