{
  "name": "datoso",
  "repo": "laromicas/datoso",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/laromicas/datoso/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/laromicas/datoso/master/bearlogo.png",
  "project": "https://github.com/laromicas/datoso/",
  "description": "Datoso is a WIP Python command line tool to download and organize your Dat Roms. As today the tool supports dat-omatic, redump, and translated-english dats. It merges all the dats in a tree folder structure thought to use with Emulators rather than dats. The dat file format must be compatible with ROMVault. For a complete documentation of this container, see https://github.com/laromicas/datoso/blob/master/README.md For documentation about using ROMVault see https://www.romvault.com/",
  "paths": [
    {
      "name": "Datoso Directory",
      "host": "/mnt/cache/appdata/datoso/datoso",
      "container": "/datoso",
      "mode": "rw,slave",
      "description": "This is the where datoso database will be placed. Container path: /datoso",
      "required": true
    },
    {
      "name": "DatRoot Directory",
      "host": "/mnt/cache/appdata/ROMVault/DatRoot",
      "container": "/DatRoot",
      "mode": "rw,slave",
      "description": "This is where dats will be placed. Container path: /DatRoot",
      "required": true
    },
    {
      "name": "Downloaded Dats Directory",
      "host": "/mnt/cache/appdata/datoso/download",
      "container": "/download",
      "mode": "rw,slave",
      "description": "This is where unknown roms will be placed. Container path: /download",
      "required": true
    }
  ],
  "ports": [],
