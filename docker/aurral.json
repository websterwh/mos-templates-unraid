{
  "name": "aurral",
  "repo": "ghcr.io/lklynet/aurral:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/lklynet/aurral/pkgs/container/aurral",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3001]/",
  "icon": "https://raw.githubusercontent.com/lklynet/aurral/main/frontend/public/arralogo.svg",
  "project": "https://github.com/lklynet/aurral",
  "description": "Self-hosted music discovery and request management for Lidarr with library-aware recommendations, granular monitoring controls, and optional Weekly Flow playlists powered by Soulseek + Navidrome.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/aurral",
      "container": "/app/backend/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Weekly Flow Downloads",
      "host": "",
      "container": "/app/downloads",
      "mode": "rw",
      "description": "Where weekly flow will download. Delete if not needed.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DOWNLOAD_FOLDER",
      "key": "DOWNLOAD_FOLDER",
      "value": "",
      "description": "Must match host path from Weekly Flow Downloads directory above. Delete if not needed.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
