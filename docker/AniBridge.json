{
  "name": "AniBridge",
  "repo": "ghcr.io/anibridge/anibridge:v2",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/anibridge/anibridge/pkgs/container/anibridge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4848]/",
  "icon": "https://raw.githubusercontent.com/anibridge/anibridge-unraid-templates/main/images/anibridge.png",
  "project": "https://github.com/anibridge/anibridge",
  "description": "The smart way to keep your anime lists perfectly synchronized.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/anibridge",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config and data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4848",
      "container": "4848",
      "protocol": "tcp",
      "description": "Web UI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Default umask",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
