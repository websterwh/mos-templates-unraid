{
  "name": "CloudCommander",
  "repo": "coderaiser/cloudcmd",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/coderaiser/cloudcmd/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "-u 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/cheesemarathon/docker-templates/master/images/cloudcmdLogo.png",
  "project": null,
  "description": "CloudCommander is a simple web file browser with a built in text editor and archive compress/extract abilities. Instructions: Set Port to the port you want to be able to access from. Defaults to 8765 Set Mount Point to the directory you want to be able to access in the browser. Defaults to /mnt/user, all shares",
  "paths": [
    {
      "name": "Mount Path",
      "host": "/mnt/user",
      "container": "/UNRAID",
      "mode": "rw",
      "description": "Container Path: /UNRAID",
      "required": true
    },
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/cloudcmd",
      "container": "/root",
      "mode": "rw",
      "description": "Container Path: /root",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8765",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "HOME - Dont Change!",
      "key": "HOME",
      "value": "/root",
      "description": "Container Variable: HOME",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
