{
  "name": "wakapi",
  "repo": "ghcr.io/muety/wakapi:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/muety/wakapi/pkgs/container/wakapi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/manuel-rw/unraid-templates/master/templates/wakapi/logo.png",
  "project": "https://github.com/muety/wakapi",
  "description": "A minimalist, self-hosted WakaTime-compatible backend for coding statistics. Free and open source. Build by developers for developers. Partially compatible with WakaTime.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/wakapi/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Web UI",
      "host": "5000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Password Salt",
      "key": "WAKAPI_PASSWORD_SALT",
      "value": "",
      "description": "Use the following command to generate the salt: cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w ${1:-32} | head -n 1",
      "required": true,
      "mask": true
    },
    {
      "name": "Http Web UI Port",
      "key": "PORT",
      "value": "5000",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Environment",
      "key": "ENVIRONMENT",
      "value": "prod",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Allow Signup",
      "key": "WAKAPI_ALLOW_SIGNUP",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Disable Frontpage",
      "key": "WAKAPI_DISABLE_FRONTPAGE",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Enable Prometheus Metrics",
      "key": "WAKAPI_EXPOSE_METRICS",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Mail Enabled",
      "key": "WAKAPI_MAIL_ENABLED",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Mail Sender",
      "key": "WAKAPI_MAIL_SENDER",
      "value": "Wakapi &lt;noreply@wakapi.dev&gt;",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Mail Provider",
      "key": "WAKAPI_MAIL_PROVIDER",
      "value": "smtp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Mail SMTP Host",
      "key": "WAKAPI_MAIL_SMTP_HOST",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Mail SMTP Port",
      "key": "WAKAPI_MAIL_SMTP_PORT",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Mail SMTP User",
      "key": "WAKAPI_MAIL_SMTP_USER",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Mail SMTP Pasword",
      "key": "WAKAPI_MAIL_SMTP_PASS",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Mail SMTP TLS",
      "key": "WAKAPI_MAIL_SMTP_TLS",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
