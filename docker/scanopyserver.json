{
  "name": "scanopy-server",
  "repo": "ghcr.io/scanopy/scanopy/server:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/scanopy/scanopy/pkgs/container/scanopy%2Fserver",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:60072]",
  "icon": "https://raw.githubusercontent.com/scanopy/scanopy/refs/heads/main/media/logo.png",
  "project": "https://github.com/scanopy/scanopy",
  "description": "Automatically discover and visually document network topology. Requirements: The server requires a postgres database. The SCANOPY_DATABASE_URL needs to match your postgres Example: postgresql://username:password@hostname:port/database postgresql://scanopy:password123@db:5432/scanopy",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/scanopy/server",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "60072",
      "container": "60072",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Public URL",
      "key": "SCANOPY_PUBLIC_URL",
      "value": "http://10.100.20.250:60072",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Server Port",
      "key": "SCANOPY_SERVER_PORT",
      "value": "60072",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Database URL",
      "key": "SCANOPY_DATABASE_URL",
      "value": "",
      "description": "The full postgres URL to your database: postgresql://username:password@hostname:port/database",
      "required": true,
      "mask": true
    },
    {
      "name": "Log Level",
      "key": "SCANOPY_LOG_LEVEL",
      "value": "info",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Integrated Daemon URL",
      "key": "SCANOPY_INTEGRATED_DAEMON_URL",
      "value": "",
      "description": "Full URL of your Daemon instance (e.g. http://192.168.0.100:60073)",
      "required": false,
      "mask": false
    },
    {
      "name": "Web External Path",
      "key": "SCANOPY_WEB_EXTERNAL_PATH",
      "value": "/app/static",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
