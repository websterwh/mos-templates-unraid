{
  "name": "py-stocks-api",
  "repo": "patrickstigler/py-stocks-api:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/patrickstigler/py-stocks-api",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT]",
  "icon": null,
  "project": "https://github.com/patrickstigler/py-stocks",
  "description": "A minimal stocks API wrapper of Yfinance. Example command: curl localhost:8000/download/AAPL/2021-08-01/2021-08-03 | jq curl localhost:8000/info/AAPL | jq",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8787",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
