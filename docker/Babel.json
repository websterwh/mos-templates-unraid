{
  "name": "Babel",
  "repo": "therealshadoh/babel",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/therealshadoh/babel",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8686]",
  "icon": "https://raw.githubusercontent.com/TheRealShadoh/babel/master/icon.png",
  "project": "https://github.com/TheRealShadoh/babel",
  "description": "Babel - Media Dub Detection and Upgrade Tool. Monitors your media library via Sonarr and Plex, detects sub-only episodes, and automatically searches for English dubbed versions. Features include automatic Sonarr searching, upgrade tracking, dub availability lookup via MyAnimeList, Plex collection management, Discord notifications, and a polished web dashboard.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/babel",
      "container": "/app/data",
      "mode": "rw",
      "description": "Application data (database)",
      "required": true
    },
    {
      "name": "Media",
      "host": "/mnt/cache/media",
      "container": "/media",
      "mode": "ro",
      "description": "Media files (optional, for ffprobe fallback)",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8686",
      "container": "8686",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Sonarr URL",
      "key": "SONARR_URL",
      "value": "http://localhost:8989",
      "description": "Sonarr server URL",
      "required": false,
      "mask": false
    },
    {
      "name": "Sonarr API Key",
      "key": "SONARR_API_KEY",
      "value": "",
      "description": "Sonarr API key (Settings &gt; General)",
      "required": false,
      "mask": true
    },
    {
      "name": "Plex URL",
      "key": "PLEX_URL",
      "value": "http://localhost:32400",
      "description": "Plex server URL",
      "required": false,
      "mask": false
    },
    {
      "name": "Plex Token",
      "key": "PLEX_TOKEN",
      "value": "",
      "description": "Plex authentication token",
      "required": false,
      "mask": true
    },
    {
      "name": "Scan Interval",
      "key": "SCAN_INTERVAL_HOURS",
      "value": "6",
      "description": "Hours between scans",
      "required": false,
      "mask": false
    },
    {
      "name": "Target Language",
      "key": "TARGET_LANGUAGE",
      "value": "eng",
      "description": "ISO 639-2 language code to search for",
      "required": false,
      "mask": false
    },
    {
      "name": "Discord Webhook",
      "key": "DISCORD_WEBHOOK_URL",
      "value": "",
      "description": "Discord webhook URL for notifications (optional)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
