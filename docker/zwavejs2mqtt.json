{
  "name": "zwavejs2mqtt",
  "repo": "zwavejs/zwavejs2mqtt",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/zwavejs/zwavejs2mqtt",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8091]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/zwavejs2mqtt.png",
  "project": "https://github.com/zwave-js/zwavejs2mqtt",
  "description": "Fully configurable Zwave to MQTT Gateway and Control Panel",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/usr/src/app/store",
      "mode": "rw",
      "description": "Container Path: /usr/src/app/store",
      "required": false
    },
    {
      "name": "Zwavejs Log",
      "host": "",
      "container": "/usr/src/app/bin",
      "mode": "rw",
      "description": "Container Path: /usr/src/app/bin",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8091",
      "container": "8091",
      "protocol": "tcp",
      "description": "Container Port: 8091",
      "required": false,
      "mask": false
    },
    {
      "name": "Websocket Server",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [
    {
      "name": "Serial device",
      "host": "/dev/ttyACM0",
      "container": "",
      "description": "Container Device: /dev/ttyACM0",
      "required": false
    }
  ],
  "labels": []
}
