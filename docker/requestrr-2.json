      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
