  "project": "https://github.com/darkalfx/requestrr",
  "description": "Requestrr(https://github.com/darkalfx/requestrr) is a chatbot used to simplify using services like Sonarr/Radarr/Ombi via the use of chat.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
