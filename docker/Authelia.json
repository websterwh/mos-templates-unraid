{
  "name": "Authelia",
  "repo": "authelia/authelia",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/authelia/authelia/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9091]/",
  "icon": "https://raw.githubusercontent.com/ibracorp/app-logos/main/authelia/authelia.png",
  "project": "https://github.com/authelia/authelia",
  "description": "Authelia is an open-source authentication and authorization server providing 2-factor authentication and single sign-on (SSO) for your applications via a web portal. It acts as a companion of reverse proxies like nginx, Traefik or HAProxy to let them know whether queries should pass through. Our docs can be found at https://docs.ibracorp.io",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/authelia",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Authelia Web UI",
      "host": "9091",
      "container": "9091",
      "protocol": "tcp",
      "description": "This is the Web UI Port, and is used to access the server gui.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
