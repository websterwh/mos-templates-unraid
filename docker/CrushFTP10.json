{
  "name": "CrushFTP10",
  "repo": "markusmcnugen/crushftp:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/markusmcnugen/crushftp/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/MarkusMcNugen/docker-templates/master/crushftp10/crushftp.png",
  "project": "https://www.crushftp.com/index.html",
  "description": "Share your files securely with FTP, Implicit FTPS, SFTP, HTTP, or HTTPS using CrushFTP 10. Built on Alpine 3.12. Size 234.8 MB. See dockerhub registry page for more details.",
  "paths": [
    {
      "name": "FTP Folder 1",
      "host": "/mnt/cache/",
      "container": "/mnt/FTP/Shared",
      "mode": "rw",
      "description": "Container Path: /mnt/FTP/Shared",
      "required": false
    },
    {
      "name": "Config Volume",
      "host": "/mnt/cache/appdata/crushftp",
      "container": "/var/opt/CrushFTP10",
      "mode": "rw",
      "description": "Container Path: /var/opt/CrushFTP10",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "FTP Port",
      "host": "21",
      "container": "21",
      "protocol": "tcp",
      "description": "Container Port: 2121",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false
    },
    {
      "name": "FTP Passive Ports",
      "host": "2000-2100",
      "container": "2000-2100",
      "protocol": "tcp",
      "description": "Container Port: 2000-2100",
      "required": true,
      "mask": false
    },
    {
      "name": "SFTP Port",
      "host": "2222",
      "container": "2222",
      "protocol": "tcp",
      "description": "Container Port: 2222",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Container Port: 9090",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "CrushFTP Admin User",
      "key": "CRUSH_ADMIN_USER",
      "value": "crushadmin",
      "description": "Default admin user for CrushFTP administration",
      "required": true,
      "mask": false
    },
    {
      "name": "CrushFTP Admin Password",
      "key": "CRUSH_ADMIN_PASSWORD",
      "value": "crushadmin",
      "description": "Default admin password for CrushFTP administration",
      "required": true,
      "mask": false
    },
    {
      "name": "Healthcheck Protocol",
      "key": "CRUSH_ADMIN_PROTOCOL",
      "value": "http",
      "description": "Protocol for health cecks",
      "required": true,
      "mask": false
    },
    {
      "name": "Healthceck Port",
      "key": "CRUSH_ADMIN_PORT",
      "value": "8080",
      "description": "Port for health cecks",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
