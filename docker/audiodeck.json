{
  "name": "audiodeck",
  "repo": "casantosmu/audiodeck:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/casantosmu/audiodeck",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4747]",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/icons/refs/heads/main/lms.webp",
  "project": "https://github.com/casantosmu/audiodeck",
  "description": "A modern, self-hostable web spectrogram analyzer for your music library",
  "paths": [
    {
      "name": "Media",
      "host": "/path/to/your/music",
      "container": "/media",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4747",
      "container": "4747",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
