{
  "name": "Grafana-Unraid-Stack",
  "repo": "testdasi/grafana-unraid-stack:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/testdasi/grafana-unraid-stack/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3006]/",
  "icon": "https://raw.githubusercontent.com/testdasi/grafana-unraid-stack-base/master/grafana-unraid-stack.png",
  "project": "https://github.com/testdasi/grafana-unraid-stack",
  "description": "Meet Gus! He has everything you need to start monitoring Unraid in style (Grafana - Influxdb - Telegraf - Loki - Promtail). NOTE: Grafana always requires some customisation to suit each exact system. Includes both GUS demo Dashboard and Ultimate Unraid Dashboard v1.3 (UUD - https://forums.Unraid.net/topic/96895-ultimate-Unraid-dashboard-uud/). High-level instructions: (1) Decide whether you want hddtemp or S.M.A.R.T (smartmontools) and set USE_HDDTEMP variable accordingly. Hint: GUS and UUD both use S.M.A.R.T (2) Install docker with host network. (3) Go to ip:3006 to access grafana, login with admin/admin and customize away. For more detailed instructions, refer to the support thread (https://forums.Unraid.net/topic/96233-support-testdasi-repo/) or project page (https://github.com/testdasi/grafana-Unraid-stack).",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/Grafana-Unraid-Stack/config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    },
    {
      "name": "Data (db)",
      "host": "/mnt/cache/appdata/Grafana-Unraid-Stack/data",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    },
    {
      "name": "Telegraf 1",
      "host": "/",
      "container": "/rootfs",
      "mode": "ro",
      "description": "Container Path: /rootfs",
      "required": false
    },
    {
      "name": "Telegraf 2",
      "host": "/etc",
      "container": "/rootfs/etc",
      "mode": "ro",
      "description": "Container Path: /rootfs/etc",
      "required": false
    },
    {
      "name": "Telegraf 3",
      "host": "/proc",
      "container": "/rootfs/proc",
      "mode": "ro",
      "description": "Container Path: /rootfs/proc",
      "required": false
    },
    {
      "name": "Telegraf 4",
      "host": "/sys",
      "container": "/rootfs/sys",
      "mode": "ro",
      "description": "Container Path: /rootfs/sys",
      "required": false
    },
    {
      "name": "Telegraf 5",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Container Path: /var/run/docker.sock",
      "required": false
    },
    {
      "name": "Telegraf 6",
      "host": "/var/run/utmp",
      "container": "/var/run/utmp",
      "mode": "ro",
      "description": "Container Path: /var/run/utmp",
      "required": false
    },
    {
      "name": "Telegraf 7",
      "host": "/run/udev",
      "container": "/run/udev",
      "mode": "ro",
      "description": "Container Path: /run/udev",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "USE_HDDTEMP",
      "key": "USE_HDDTEMP",
      "value": "no",
      "description": "Container Variable: USE_HDDTEMP",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_HTTP_PORT",
      "key": "INFLUXDB_HTTP_PORT",
      "value": "8086",
      "description": "Container Variable: INFLUXDB_HTTP_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "LOKI_PORT",
      "key": "LOKI_PORT",
      "value": "3100",
      "description": "Container Variable: LOKI_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "PROMTAIL_PORT",
      "key": "PROMTAIL_PORT",
      "value": "9086",
      "description": "Container Variable: PROMTAIL_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "GRAFANA_PORT",
      "key": "GRAFANA_PORT",
      "value": "3006",
      "description": "Container Variable: GRAFANA_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_ETC",
      "key": "HOST_ETC",
      "value": "/rootfs/etc",
      "description": "Container Variable: HOST_ETC",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_PROC",
      "key": "HOST_PROC",
      "value": "/rootfs/proc",
      "description": "Container Variable: HOST_PROC",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_SYS",
      "key": "HOST_SYS",
      "value": "/rootfs/sys",
      "description": "Container Variable: HOST_SYS",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_MOUNT_PREFIX",
      "key": "HOST_MOUNT_PREFIX",
      "value": "/rootfs",
      "description": "Container Variable: HOST_MOUNT_PREFIX",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
