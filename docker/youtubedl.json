{
  "name": "youtube-dl",
  "repo": "jeeaaasustest/youtube-dl",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/jeeaaasustest/youtube-dl/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/alex3305/unraid-docker-templates/master/images/youtube-dl.png",
  "project": "https://github.com/Jeeaaasus/youtube-dl",
  "description": "Automated yt-dlp Docker image for downloading YouTube subscriptions",
  "paths": [
    {
      "name": "Config directory",
      "host": "/mnt/cache/appdata/youtube-dl/config",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Dowonload directory",
      "host": "/mnt/cache/appdata/youtube-dl/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Scrape interval",
      "key": "youtubedl_interval",
      "value": "3h",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "WebUI Enabled",
      "key": "youtubedl_webui",
      "value": "true",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
