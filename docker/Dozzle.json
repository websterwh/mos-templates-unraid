{
  "name": "Dozzle",
  "repo": "amir20/dozzle",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/amir20/dozzle/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/dozzle.png",
  "project": "https://github.com/amir20/dozzle",
  "description": "Dozzle is a real-time log viewer for docker containers. As of v6.x, a new Authentication mechanism is in place that requires you to create a /data/users.yml file as described in https://github.com/amir20/dozzle/issues/2630",
  "paths": [
    {
      "name": "Docker Logs",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Container Path: /var/run/docker.sock",
      "required": true
    },
    {
      "name": "/data",
      "host": "/mnt/cache/appdata/dozzle/",
      "container": "/data",
      "mode": "rw",
      "description": "/data directory for /data/users.yml",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Base URL",
      "key": "DOZZLE_BASE",
      "value": "/",
      "description": "Container Variable: DOZZLE_BASE",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "DOZZLE_LEVEL",
      "value": "info",
      "description": "Container Variable: DOZZLE_LEVEL",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Tailsize",
      "key": "DOZZLE_TAILSIZE",
      "value": "300",
      "description": "Container Variable: DOZZLE_TAILSIZE",
      "required": false,
      "mask": false
    },
    {
      "name": "Authentication",
      "key": "DOZZLE_AUTH_PROVIDER",
      "value": "simple",
      "description": "Container Variable: DOZZLE_AUTH_PROVIDER",
      "required": false,
      "mask": false
    },
    {
      "name": "Secret Key",
      "key": "DOZZLE_KEY",
      "value": "9Q9SJ69MZhZ0WrjbF",
      "description": "Container Variable: DOZZLE_KEY . Dozzle uses this to make session tokens. If you expose dozzle on the internet, you need to change this, since the default secret is well known",
      "required": false,
      "mask": false
    },
    {
      "name": "Disable Analytics",
      "key": "DOZZLE_NO_ANALYTICS",
      "value": "true",
      "description": "Container Variable: DOZZLE_NO_ANALYTICS . Dozzle collects anonymous user configurations using Google Analytics.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
