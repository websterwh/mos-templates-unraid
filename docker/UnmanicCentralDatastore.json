{
  "name": "Unmanic-Central-Datastore",
  "repo": "ghcr.io/unmanic/unmanic-central-datastore:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/unmanic/unmanic-central-datastore",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user=99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8889]/unmanic",
  "icon": "https://raw.githubusercontent.com/Unmanic/unmanic-central-datastore/refs/heads/master/icon.png",
  "project": "https://github.com/Unmanic/",
  "description": "Unmanic Central Datastore is the backend component for collecting, storing, and serving logs and metrics from Unmanic installations.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/unmanic-central-datastore",
      "container": "/config",
      "mode": "rw",
      "description": "Location where all container configuration is stored.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8889",
      "container": "8889",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Datastore Password",
      "key": "UNMANIC_CENTRAL_DATASTORE_PASSWORD",
      "value": "",
      "description": "Basic auth password (username is 'unmanic').",
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres Username",
      "key": "UNMANIC_CENTRAL_POSTGRES_USERNAME",
      "value": "postgres",
      "description": "Postgres username. PostgreSQL 17 is required.",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Password",
      "key": "UNMANIC_CENTRAL_POSTGRES_PASSWORD",
      "value": "",
      "description": "Postgres password. PostgreSQL 17 is required.",
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres Host",
      "key": "UNMANIC_CENTRAL_POSTGRES_HOST",
      "value": "postgres / 192.168.1.2",
      "description": "Postgres host or container name.",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Database",
      "key": "UNMANIC_CENTRAL_POSTGRES_DB",
      "value": "unmanic",
      "description": "Postgres database name.",
      "required": true,
      "mask": false
    },
    {
      "name": "Datastore Name",
      "key": "UNMANIC_CENTRAL_NAME",
      "value": "Unmanic Central DB",
      "description": "Friendly name for this datastore.",
      "required": false,
      "mask": false
    },
    {
      "name": "Path Prefix",
      "key": "UNMANIC_CENTRAL_PATH_PREFIX",
      "value": "/unmanic",
      "description": "Path prefix for accessing the datastore URL.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
