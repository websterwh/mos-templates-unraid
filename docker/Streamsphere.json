{
  "name": "Streamsphere",
  "repo": "streamsphere/streamsphere:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/streamsphere/streamsphere",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/rs-anantmishra/streamsphere/refs/heads/master/ui/public/assets/favicon.png",
  "project": "https://github.com/rs-anantmishra/streamsphere",
  "description": "It is a media library. It supports channels, playlists and videos. The primary goal of this application is to provide complete functionality of a media library, while being as lightweight as possible.",
  "paths": [
    {
      "name": "Content Path",
      "host": "",
      "container": "/app/content",
      "mode": "rw",
      "description": "Path to content files. Must match Streamsphere Content content path.",
      "required": true
    },
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/streamsphere/db",
      "container": "/app/database/db",
      "mode": "rw",
      "description": "Path to database files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Host IP Address",
      "key": "HOST_IP",
      "value": "",
      "description": "The IP or hostname of the machine on the network you want to host it on.",
      "required": true,
      "mask": false
    },
    {
      "name": "External Port",
      "key": "APPLICATION_PORT",
      "value": "3000",
      "description": "Use save value as Web UI Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Content Port",
      "key": "CONTENT_PORT",
      "value": "3500",
      "description": "Port of Streamsphere Content instance",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
