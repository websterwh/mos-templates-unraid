{
  "name": "trackly",
  "repo": "7eventy7/trackly",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/7eventy7/trackly",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:11888]",
  "icon": "https://raw.githubusercontent.com/7eventy7/trackly/master/frontend/public/icons/trackly.png",
  "project": "https://github.com/7eventy7/trackly",
  "description": "A modern web application designed to enhance your Jellyfin music library experience. Browse your collection with a beautiful interface and optionally receive Discord notifications for new releases from your favorite artists.",
  "paths": [
    {
      "name": "DATA",
      "host": "/mnt/cache/appdata/trackly/",
      "container": "/data",
      "mode": "rw",
      "description": "persistent storage for release scan management",
      "required": true
    },
    {
      "name": "MUSIC",
      "host": "/path/to/your/music/library",
      "container": "/music",
      "mode": "ro",
      "description": "music library containing directories per artist",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEBUI",
      "host": "11888",
      "container": "11888",
      "protocol": "tcp",
      "description": "webui port for trackly",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "UPDATE_INTERVAL",
      "key": "UPDATE_INTERVAL",
      "value": "0 0 * * *",
      "description": "cron schedule to scan for new releases",
      "required": true,
      "mask": false
    },
    {
      "name": "DISCORD_NOTIFY",
      "key": "DISCORD_NOTIFY",
      "value": "true",
      "description": "receive notifications on discord",
      "required": true,
      "mask": false
    },
    {
      "name": "NOTIFY_ON_SCAN",
      "key": "NOTIFY_ON_SCAN",
      "value": "false",
      "description": "receive notifications when scans complete",
      "required": true,
      "mask": false
    },
    {
      "name": "DISCORD_WEBHOOK",
      "key": "DISCORD_WEBHOOK",
      "value": "YOUR_DISCORD_WEBHOOK_URL",
      "description": "discord webhook url for embeds",
      "required": true,
      "mask": false
    },
    {
      "name": "DISCORD_ROLE",
      "key": "DISCORD_ROLE",
      "value": "YOUR_DISCORD_ROLE_ID",
      "description": "role id to receive discord pings",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
