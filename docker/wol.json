{
  "name": "wol",
  "repo": "ghcr.io/trugamr/wol:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/trugamr/wol",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "serve",
  "web_ui_url": "http://[IP]:[PORT:7777]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/wol-icon.png",
  "project": "https://github.com/Trugamr/wol",
  "description": "A CLI tool to send Wake-On-LAN (WOL) magic packets to wake up devices on your network. Features both CLI commands and a web interface. Requires a config file at the Config File path BEFORE application is started: https://github.com/Trugamr/wol?tab=readme-ov-file#configuration",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/wol/config.yaml",
      "container": "/etc/wol/config.yaml",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7777",
      "container": "7777",
      "protocol": "tcp",
      "description": "Container Port: 7777",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
