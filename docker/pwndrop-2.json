{
  "name": "pwndrop",
  "repo": "harshavardhanj/pwndrop:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/harshavardhanj/pwndrop/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/pwndrop",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/pwndrop.png",
  "project": "https://github.com/kgretzky/pwndrop",
  "description": "Self-hosted file hosting service allowing easy uploads and sharing of payloads over HTTP and WebDAV.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/pwndrop/",
      "container": "/pwndrop/data",
      "mode": "rw",
      "description": "Data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
