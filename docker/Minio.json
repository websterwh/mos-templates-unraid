{
  "name": "Minio",
  "repo": "minio/minio",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/minio/minio/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "server /data --console-address :9001",
  "web_ui_url": "http://[IP]:[PORT:9001]/",
  "icon": "https://raw.githubusercontent.com/cheesemarathon/docker-templates/master/images/minio.png",
  "project": null,
  "description": "Minio is a high performance distributed object storage server, designed for large-scale private cloud infrastructure. Minio is widely deployed across the world with over 157M+ docker pulls",
  "paths": [
    {
      "name": "Data",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/minio",
      "container": "/root/.minio",
      "mode": "rw",
      "description": "Container Path: /root/.minio",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "9768",
      "container": "9000",
      "protocol": "tcp",
      "description": "Container Port: 9000",
      "required": true,
      "mask": false
    },
    {
      "name": "Console UI",
      "host": "9769",
      "container": "9001",
      "protocol": "tcp",
      "description": "Container Port: 9001",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MINIO_ROOT_USER",
      "key": "MINIO_ROOT_USER",
      "value": "",
      "description": "Container Variable: MINIO_ROOT_USER",
      "required": true,
      "mask": false
    },
    {
      "name": "MINIO_ROOT_PASSWORD",
      "key": "MINIO_ROOT_PASSWORD",
      "value": "",
      "description": "Container Variable: MINIO_ROOT_PASSWORD",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
