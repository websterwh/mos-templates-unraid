{
  "name": "rdesktop",
  "repo": "lscr.io/linuxserver/rdesktop",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/rdesktop",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3389]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/rdesktop-logo.png",
  "project": "http://xrdp.org/",
  "description": "Rdesktop(http://xrdp.org/) - Containers containing full desktop environments in many popular flavors for Ubuntu accessible via RDP.",
  "paths": [
    {
      "name": "Path: /var/run/docker.sock",
      "host": "",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker Socket on the system, if you want to use Docker in the container",
      "required": false
    },
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "abc users home directory",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3389",
      "container": "3389",
      "protocol": "tcp",
      "description": "RDP access port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "/dev/dri",
      "host": "/dev/dri",
      "container": "",
      "description": "Add this for GL support (Linux hosts only)",
      "required": false
    }
  ],
  "labels": []
}
