{
  "name": "Nginx-Proxy-Manager-Official",
  "repo": "jc21/nginx-proxy-manager",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/jc21/nginx-proxy-manager",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--memory=1G --no-healthcheck",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:81]",
  "icon": "https://nginxproxymanager.com/icon.png",
  "project": "https://nginxproxymanager.com/",
  "description": "Nginx Proxy Manager (NPM) allows adding proxy hosts through a password-protected multi-user WebUI. Add free Let's Encrypt SSL certificates to secure your web services. They are renewed by NPM automatically. Default login: admin@example.com Password: changeme",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/Nginx-Proxy-Manager-Official/data",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    },
    {
      "name": "Certificates",
      "host": "/mnt/cache/appdata/Nginx-Proxy-Manager-Official/letsencrypt",
      "container": "/etc/letsencrypt",
      "mode": "rw",
      "description": "Container Path: /etc/letsencrypt",
      "required": false
    },
    {
      "name": "Error Logs",
      "host": "/tmp/Nginx-Proxy-Manager-Official/var/log",
      "container": "/var/log",
      "mode": "rw",
      "description": "Container Path: /var/log",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "81",
      "container": "81",
      "protocol": "tcp",
      "description": "Container Port: 81",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTP Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": false,
      "mask": false
    },
    {
      "name": "API Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database",
      "key": "DB_SQLITE_FILE",
      "value": "/data/database.sqlite",
      "description": "Container Variable: DB_SQLITE_FILE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
