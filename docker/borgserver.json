{
  "name": "borgserver",
  "repo": "nold360/borgserver:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/nold360/borgserver",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2222]",
  "icon": "https://raw.githubusercontent.com/Balya/unraid-templates/main/borgserver/icon-200.png",
  "project": "https://www.borgbackup.org",
  "description": "Debian based container image, running openssh-daemon only accessable by user named \"borg\" using SSH-Publickey Auth & \"borgbackup\" as client.",
  "paths": [
    {
      "name": "sshkeys",
      "host": "/mnt/cache/borg/sshkeys/",
      "container": "/sshkeys",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "backup",
      "host": "/mnt/cache/borg/backup/",
      "container": "/backup",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "SSH",
      "host": "2222",
      "container": "22",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
