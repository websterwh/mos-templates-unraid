{
  "name": "chitubox-novnc",
  "repo": "mikeah/chitubox-novnc",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/mikeah/chitubox-novnc",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://media.imgcdn.org/repo/2023/03/chitubox-pro/chitubox-pro-logo.png",
  "project": "https://ultimaker.com/software/ultimaker-chitubox",
  "description": "Enjoy CHITUBOX directly in your browser with this easy to use Docker container. This template has the minimum variables defined, but you can find additional details on the template at the URLs listed below. https://github.com/helfrichmichael/chitubox-novnc https://hub.docker.com/r/mikeah/chitubox-novnc",
  "paths": [
    {
      "name": "Home folder",
      "host": "/mnt/cache/appdata/chitubox",
      "container": "/home/chitubox/",
      "mode": "rw",
      "description": "Container Path: /home/chitubox/",
      "required": true
    },
    {
      "name": "Prints",
      "host": "/mnt/cache/3D Printing/",
      "container": "/prints/",
      "mode": "rw",
      "description": "3D Printing Folder",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "VNC Interface",
      "host": "6080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SSL_CERT_FILE",
      "key": "SSL_CERT_FILE",
      "value": "/etc/ssl/certs/ca-certificates.crt",
      "description": "Needed to allow Prusaslicer to open without any prompts upon startup.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
