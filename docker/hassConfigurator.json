{
  "name": "hassConfigurator",
  "repo": "causticlab/hass-configurator-docker:x86_64",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/causticlab/hass-configurator-docker//Dockerfile/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3218]",
  "icon": "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6e/Home_Assistant_Logo.svg/2000px-Home_Assistant_Logo.svg.png",
  "project": "https://github.com/danielperna84/hass-configurator",
  "description": "Home Assistant online configurator container from https://github.com/danielperna84/hass-configurator",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/home-assistant-configurator/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    },
    {
      "name": "hass-config",
      "host": "/mnt/cache/appdata/home-assistant/",
      "container": "/hass-config",
      "mode": "rw",
      "description": "Your home assistant configuration folder",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "3218",
      "host": "3218",
      "container": "3218",
      "protocol": "tcp",
      "description": "Container Port: 3218",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
