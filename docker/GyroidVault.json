{
  "name": "GyroidVault",
  "repo": "ghcr.io/teecodedev/gyroidvault:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/teecodedev/gyroidvault",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/TeeCodeDev/GyroidVault/main/public/icon.png",
  "project": "https://github.com/TeeCodeDev/GyroidVault",
  "description": "GyroidVault is a modern, self-hosted 3D model library and print management platform. Organize your STL, 3MF, and Gcode files, track your print history, and manage your projects in a beautiful dashboard.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/gyroidvault",
      "container": "/app/data",
      "mode": "rw",
      "description": "Storage for database and settings.",
      "required": true
    },
    {
      "name": "3D Models Library",
      "host": "/mnt/cache/3Dprints",
      "container": "/library",
      "mode": "rw",
      "description": "Path to your 3D models and prints library.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3457",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port for the GyroidVault web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID (PUID).",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID (PGID).",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Umask value.",
      "required": false,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Amsterdam",
      "description": "Container Timezone",
      "required": false,
      "mask": false
    },
    {
      "name": "Library Path (Internal)",
      "key": "LIBRARY_PATH",
      "value": "/library",
      "description": "Internal container path for the library. Must match the 3D Models Library Target path.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
