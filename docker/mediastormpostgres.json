{
  "name": "mediastorm_postgres",
  "repo": "postgres:16-alpine",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/_/postgres/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://raw.githubusercontent.com/mash2k3/unraid-templates/main/icons/mediastorm-postgres.png",
  "project": "https://www.postgresql.org/",
  "description": "PostgreSQL 16 is a powerful, open source object-relational database system with over 35 years of active development that has earned it a strong reputation for reliability, feature robustness, and performance. This template uses the official PostgreSQL Docker image @ https://hub.docker.com/_/postgres/.",
  "paths": [
    {
      "name": "Path: /var/lib/postgresql/data",
      "host": "/mnt/cache/appdata/mediastorm/postgres_data",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "PostgreSQL data storage location.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port: PostgreSQL access port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "PostgreSQL TCP connection port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Variable: POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "mediastorm",
      "description": "Initial superuser password (required).",
      "required": true,
      "mask": false
    },
    {
      "name": "Variable: POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "mediastorm",
      "description": "Initial superuser name (default: postgres).",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "mediastorm",
      "description": "Initial database name (default: postgres).",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
