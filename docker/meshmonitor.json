{
  "name": "meshmonitor",
  "repo": "ghcr.io/yeraze/meshmonitor",
  "category": [
    "Network"
  ],
  "registry": "https://ghcr.io/yeraze/meshmonitor",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3001]/",
  "icon": "https://raw.githubusercontent.com/Yeraze/meshmonitor/refs/heads/main/public/logo.png",
  "project": "https://github.com/Yeraze/meshmonitor",
  "description": "Web tool for monitoring a Meshtastic Node Deployment over TCP/HTTP",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/meshmonitor",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Meshtastic TCP Port",
      "host": "4403",
      "container": "4403",
      "protocol": "tcp",
      "description": "TCP port for Meshtastic node connection",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Meshtastic Node IP",
      "key": "MESHTASTIC_NODE_IP",
      "value": "192.168.2.199",
      "description": "IP address of your Meshtastic node",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "COOKIE_SECURE",
      "key": "COOKIE_SECURE",
      "value": "false",
      "description": "Require HTTPS for session cookies. Set to false if accessing over HTTP in production (not recommended)",
      "required": false,
      "mask": false
    },
    {
      "name": "Environment Mode",
      "key": "NODE_ENV",
      "value": "development",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "",
      "description": "Runtime base URL path for subfolder deployment (e.g., /meshmonitor)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
