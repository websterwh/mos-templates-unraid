{
  "name": "bunkerweb-aio",
  "repo": "bunkerity/bunkerweb-all-in-one:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/bunkerity/bunkerweb-all-in-one",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7000]/",
  "icon": "https://raw.githubusercontent.com/davidjkling/unraid-templates/refs/heads/main/static/bunkerweb-aio.png",
  "project": "https://github.com/bunkerity/bunkerweb",
  "description": "BunkerWeb is a next-generation, open-source Web Application Firewall (WAF). Configuration: https://docs.bunkerweb.io/latest/integrations/#all-in-one-aio-image Complete the Setup: https://docs.bunkerweb.io/latest/quickstart-guide/#complete-the-setup-wizard https://your_IP_or_FQDN:8443/setup Login: https://your_IP_or_FQDN:8443/login or http://your_IP_or_FQDN:7000/login",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/bunkerweb-aio",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port for HTTP.",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "Port for HTTPS.",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP/3 (QUIC)",
      "host": "8443",
      "container": "8443",
      "protocol": "udp",
      "description": "Port for QUIC.",
      "required": true,
      "mask": false
    },
    {
      "name": "WebUI Port without BunkerWeb in front",
      "host": "7000",
      "container": "7000",
      "protocol": "tcp",
      "description": "Port to access WebUI without going through BunkerWeb.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SERVICE_UI",
      "key": "SERVICE_UI",
      "value": "yes|no",
      "description": "Enables the web UI service.",
      "required": false,
      "mask": false
    },
    {
      "name": "SERVICE_SCHEDULER",
      "key": "SERVICE_SCHEDULER",
      "value": "yes|no",
      "description": "Enables the Scheduler service.",
      "required": false,
      "mask": false
    },
    {
      "name": "SERVICE_API",
      "key": "SERVICE_API",
      "value": "no|yes",
      "description": "Enables the API service (FastAPI control plane).",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTOCONF_MODE",
      "key": "AUTOCONF_MODE",
      "value": "no|yes",
      "description": "Enables the autoconf service.",
      "required": false,
      "mask": false
    },
    {
      "name": "USE_CROWDSEC",
      "key": "USE_CROWDSEC",
      "value": "no|yes",
      "description": "CrowdSec integration is disabled by default.",
      "required": false,
      "mask": false
    },
    {
      "name": "USE_REDIS",
      "key": "USE_REDIS",
      "value": "yes|no",
      "description": "Enables the built-in Redis instance.",
      "required": false,
      "mask": false
    },
    {
      "name": "REDIS_HOST",
      "key": "REDIS_HOST",
      "value": "127.0.0.1",
      "description": "Override REDIS_HOST only when you have an external Redis/Valkey endpoint to connect to.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
