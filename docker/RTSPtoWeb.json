{
  "name": "RTSPtoWeb",
  "repo": "ghcr.io/deepch/rtsptoweb:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/deepch/rtsptoweb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8083]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/rtsp-to-web-icon.png",
  "project": "https://github.com/deepch/RTSPtoWeb",
  "description": "RTSPtoWeb converts your RTSP streams to formats consumable in a web browser like MSE (Media Source Extensions), WebRTC, or HLS.",
  "paths": [
    {
      "name": "Config data",
      "host": "/mnt/cache/appdata/rtsp_to_web/config.json",
      "container": "/config/config.json",
      "mode": "rw",
      "description": "Config data for application",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8083",
      "container": "8083",
      "protocol": "tcp",
      "description": "Container Port: 8083",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
