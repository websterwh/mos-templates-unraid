{
  "name": "kin-crm",
  "repo": "ghcr.io/jpdvm2014/kin-crm-docker",
  "category": [
    "Productivity"
  ],
  "registry": "https://ghcr.io/jpdvm2014/kin-crm-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/kin-crm-docker/refs/heads/main/kin-crm-icon.png",
  "project": "https://github.com/ock666/Kin-CRM",
  "description": "Kin is a self-hosted relationship manager built by and for neurodivergent brains \u2014 designed to help with AuDHD (Autism + ADHD), Rejection Sensitive Dysphoria (RSD), social anxiety, and overwhelm. It handles the remembering, the nudging, and the structure of staying in touch \u2014 so you can focus on the people, not the pressure. Note: I am not the creator of kin-CRM, I just built an image to be able to easily install on Unraid and thought I would share it.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/kin-crm",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DATA_DIR",
      "key": "DATA_DIR",
      "value": "/data",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DISABLE_SCHEDULER",
      "key": "DISABLE_SCHEDULER",
      "value": "0",
      "description": "Set to 1 for testing",
      "required": true,
      "mask": false
    },
    {
      "name": "ALLOWED_HOSTS",
      "key": "ALLOWED_HOSTS",
      "value": "*",
      "description": "Comma-separated hostnames this server accepts. Set to * or your domain in production.",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS_ONLY",
      "key": "HTTPS_ONLY",
      "value": "0",
      "description": "Set to 1 to restrict session cookies to HTTPS only (requires a TLS-terminating reverse proxy).",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
