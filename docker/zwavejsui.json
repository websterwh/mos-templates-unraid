{
  "name": "zwave-js-ui",
  "repo": "zwavejs/zwave-js-ui",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/zwavejs/zwave-js-ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8091]/",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/zwave-js-ui.png",
  "project": "https://zwave-js.github.io/zwave-js-ui",
  "description": "Fully configurable Zwave Control Panel and MQTT gateway using NodeJS and Vue Recommended to pass in the USB adapter via the serial/by-id/ - find yours by a terminal command of: ls -l /dev/serial/by-id Example: /dev/serial/by-id/usb-Silicon_Labs_Zooz_ZST10_700_Z-Wave_Stick_a2b44f42d260ec11a6583d7625bfaa52-if00-port0:/dev/zwave",
  "paths": [
    {
      "name": "Config folder",
      "host": "/mnt/cache/appdata/zwave-js-ui",
      "container": "/usr/src/app/store",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8091",
      "container": "8091",
      "protocol": "tcp",
      "description": "Container WebUI",
      "required": true,
      "mask": false
    },
    {
      "name": "Websocket Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [
    {
      "name": "USB Zwave device",
      "host": "/dev/ttyACM0:/dev/zwave",
      "container": "",
      "description": null,
      "required": false
    }
  ],
  "labels": []
}
