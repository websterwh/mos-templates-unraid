{
  "name": "Broadcaster",
  "repo": "tedcharles/broadcaster:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:12121]/",
  "icon": "https://raw.githubusercontent.com/theodorecharles/Broadcaster/refs/heads/master/broadcaster_icon.png",
  "project": "https://github.com/theodorecharles/Broadcaster",
  "description": "Create your own 24/7 TV channels from your media library with a retro CRT-style web interface. Broadcaster generates and hosts HTTP Live Streams from local content using FFMpeg with NVIDIA GPU hardware acceleration.",
  "paths": [
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/broadcaster",
      "container": "/data",
      "mode": "rw",
      "description": "Storage for HLS streams, config files (channels.json, config.txt), and logs",
      "required": true
    },
    {
      "name": "Media Directory",
      "host": "/mnt/cache/media",
      "container": "/media",
      "mode": "ro",
      "description": "Your media files (movies, TV shows, etc.)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "12121",
      "container": "12121",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA GPU ID",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "0",
      "description": "GPU ID to use (0 for first GPU, or 'all' for all GPUs). Run 'nvidia-smi' to see available GPUs.",
      "required": true,
      "mask": false
    },
    {
      "name": "NVIDIA Driver Capabilities",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": "NVIDIA driver capabilities (leave as 'all')",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
