{
  "name": "pictshare",
  "repo": "hascheksolutions/pictshare",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/hascheksolutions/pictshare/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/kilrah/unraid-docker-templates/raw/main/icons/pictshare.png",
  "project": "https://github.com/HaschekSolutions/pictshare",
  "description": "Host your own images / gifs / mp4s / text / bins and stay in control. Self-hosted imgur/pastebin-like. See https://github.com/HaschekSolutions/pictshare/blob/master/rtfm/DOCKER.md for extra variables that can be added if required.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/pictshare",
      "container": "/var/www/data",
      "mode": "rw",
      "description": "Storage for uploaded files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Web UI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MAX_UPLOAD_SIZE",
      "key": "MAX_UPLOAD_SIZE",
      "value": "50",
      "description": "Size in MB that will be used for nginx",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
