{
  "name": "Sync-in",
  "repo": "syncin/server:1",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/syncin/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/sync-in-icon.png",
  "project": "https://sync-in.com",
  "description": "An open-source platform to store, share, collaborate, and sync your files.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/sync_in/environment.yaml",
      "container": "/app/environment/environment.yaml",
      "mode": "rw",
      "description": "Path to the environment file",
      "required": true
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/sync_in/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to data folder",
      "required": true
    },
    {
      "name": "Desktop Releases Path",
      "host": "/mnt/cache/appdata/sync_in/releases",
      "container": "/app/static/releases",
      "mode": "ro",
      "description": "Path to desktop releases",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Initialize Admin",
      "key": "INIT_ADMIN",
      "value": "true|false",
      "description": "Initialize the admin user on first run",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
