{
  "name": "Ampcast",
  "repo": "ghcr.io/rekkyrosso/ampcast:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/rekkyrosso/ampcast",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ampcast-icon.png",
  "project": "https://ampcast.app/",
  "description": "A music player inspired by Winamp.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Single Streaming Service",
      "key": "SINGLE_STREAMING_SERVICE",
      "value": "false|true",
      "description": "Only allow one streaming service to be selected",
      "required": true,
      "mask": false
    },
    {
      "name": "Apple Music - Dev Token",
      "key": "AM_DEV_TOKEN",
      "value": "",
      "description": "Apple Music Developer Token",
      "required": false,
      "mask": true
    },
    {
      "name": "Last.fm - API Key",
      "key": "LF_API_KEY",
      "value": "",
      "description": "Last.fm API Key",
      "required": false,
      "mask": true
    },
    {
      "name": "Last.fm - API Secret",
      "key": "LF_API_SECRET",
      "value": "",
      "description": "Last.fm API Secret",
      "required": false,
      "mask": true
    },
    {
      "name": "Spotify - Disabled",
      "key": "SPOTIFY_DISABLED",
      "value": "false|true",
      "description": "Disable Spotify as a selectable service",
      "required": true,
      "mask": false
    },
    {
      "name": "Spotify - Client ID",
      "key": "SP_CLIENT_ID",
      "value": "",
      "description": "Spotify Client ID",
      "required": false,
      "mask": true
    },
    {
      "name": "Tidal - Disabled",
      "key": "TIDAL_DISABLED",
      "value": "false|true",
      "description": "Disable Tidal as a selectable service",
      "required": true,
      "mask": false
    },
    {
      "name": "Tidal - Client ID",
      "key": "TD_CLIENT_ID",
      "value": "",
      "description": "Tidal Client ID",
      "required": false,
      "mask": true
    },
    {
      "name": "YouTube - Disabled",
      "key": "YOUTUBE_DISABLED",
      "value": "false|true",
      "description": "Disable YouTube as a selectable service",
      "required": true,
      "mask": false
    },
    {
      "name": "YouTube - API Key",
      "key": "YT_CLIENT_ID",
      "value": "",
      "description": "YouTube Client ID",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
