{
  "name": "TeamSpeak3-Server",
  "repo": "gitea.fithwum.tech/fithwum/teamspeak-server:basic",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/fithwum/teamspeak-server/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9987]",
  "icon": "https://gitea.fithwum.tech/fithwum/files-for-dockers/raw/branch/master/icons/ts-server-icon.png",
  "project": "https://www.teamspeak.com/",
  "description": "TeamSpeak is proprietary voice-over-Internet Protocol (VoIP) software that allows computer users to speak on a chat channel with fellow computer users, much like a telephone conference call. A TeamSpeak user will often wear a headset with an integrated microphone. Users use the TeamSpeak client software to connect to a TeamSpeak server of their choice, from there they can join chat channels and discuss things. Configuration /ts3-\"whatever tag you picked\" This is where teamspeak will store it's configuration files/logs and database(If you picked the basic tag). Notes Connect to the server using the TeamSpeak client with the host IP address and port 9987. To authenticate use the privilege key shown in the supervisord.log file in the /ts3-\"whatever tag you picked\" folder.",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/teamspeak-server",
      "container": "/ts3server",
      "mode": "rw",
      "description": "Container Path: /ts3server",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "9987",
      "container": "9987",
      "protocol": "udp",
      "description": "Container Port: 9987",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "10011",
      "container": "10011",
      "protocol": "tcp",
      "description": "Container Port: 10011",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 3",
      "host": "30033",
      "container": "30033",
      "protocol": "tcp",
      "description": "Container Port: 30033",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Auto Update",
      "key": "AUTO_UPDATE",
      "value": "true",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "TeamSpeak Version",
      "key": "TS_VERSION",
      "value": "3.13.7",
      "description": "Pick your TeamSpeak version.",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 3",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
