{
  "name": "tasktrove",
  "repo": "ghcr.io/dohsimpson/tasktrove",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/dohsimpson/TaskTrove/pkgs/container/tasktrove",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/dohsimpson/TaskTrove/refs/heads/main/apps/web/app/icon1.png",
  "project": "https://tasktrove.io/",
  "description": "TaskTrove is a powerful, self-hosted task management application designed for individuals and teams who want advanced productivity features without compromising on data ownership.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/tasktrove",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "AUTH_SECRET",
      "key": "AUTH_SECRET",
      "value": "Your secret key - change me!",
      "description": "Remove this variable if you don't need authentication.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
