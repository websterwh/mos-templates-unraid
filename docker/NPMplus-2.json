{
  "name": "NPMplus",
  "repo": "ghcr.io/zoeyvid/npmplus:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/ZoeyVid/NPMplus/pkgs/container/npmplus",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--security-opt=no-new-privileges:true",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:81]",
  "icon": "https://raw.githubusercontent.com/Railline/unraid-community-apps/main/assets/npmplus.png",
  "project": "https://github.com/ZoeyVid/NPMplus",
  "description": "NPMplus is an improved fork of Nginx Proxy Manager. This Unraid template provides a ready-to-use bridge-mode setup with grouped variables for ports, ACME, nginx/TLS, GoAccess, PHP, OIDC/auth-request and optional external MariaDB/MySQL compatibility. External MariaDB/MySQL is unsupported by NPMplus upstream and SQLite is recommended for new installs. Review the port mappings before first start, especially if the Unraid WebUI already uses ports 80 or 443.",
  "paths": [
    {
      "name": "Paths - Data",
      "host": "/mnt/cache/appdata/npmplus",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent NPMplus data, certificates, nginx configuration and database files when SQLite is used.",
      "required": true
    },
    {
      "name": "Paths - Web root",
      "host": "/mnt/cache/appdata/npmplus/www",
      "container": "/var/www",
      "mode": "rw",
      "description": "Optional web root if you want NPMplus to serve static HTML/PHP content directly.",
      "required": false
    },
    {
      "name": "Paths - GoAccess GeoIP DB",
      "host": "/mnt/cache/appdata/npmplus/goaccess/geoip",
      "container": "/opt/npmplus/goaccess/geoip",
      "mode": "rw",
      "description": "Optional GeoIP database directory for GoAccess. Put MaxMind GeoLite2 files here if GOA is enabled.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Ports - NPM UI host port",
      "host": "81",
      "container": "81",
      "protocol": "tcp",
      "description": "Host port for the NPMplus web interface.",
      "required": true,
      "mask": false
    },
    {
      "name": "Ports - GoAccess host port",
      "host": "91",
      "container": "91",
      "protocol": "tcp",
      "description": "Host port for GoAccess. Keep equal to GOA_PORT unless you know why you need a different mapping.",
      "required": false,
      "mask": false
    },
    {
      "name": "Ports - HTTP host port",
      "host": "80",
      "container": "8080",
      "protocol": "tcp",
      "description": "Host port for HTTP traffic. Change this if Unraid already uses port 80.",
      "required": true,
      "mask": false
    },
    {
      "name": "Ports - HTTPS host port TCP",
      "host": "443",
      "container": "8443",
      "protocol": "tcp",
      "description": "Host port for HTTPS traffic. Change this if Unraid already uses port 443.",
      "required": true,
      "mask": false
    },
    {
      "name": "Ports - HTTPS host port UDP",
      "host": "443",
      "container": "8443",
      "protocol": "udp",
      "description": "This is just the port binding for HTTPS_PORT if u are in bridge mode, this need to be = to HTTPS_PORT Port Config",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
