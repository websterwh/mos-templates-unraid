{
  "name": "Jelu",
  "repo": "wabayang/jelu",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/wabayang/jelu",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:11111]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/jelu.png",
  "project": "https://github.com/bayang/jelu",
  "description": "Track what you have read, what you are reading and what you want to read. It acts as a self hosted \"personal Goodreads\" alternative.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/jelu/config",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/jelu/database",
      "container": "/database",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Images Path",
      "host": "/mnt/cache/appdata/jelu/files/images",
      "container": "/files/images",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Imports Path",
      "host": "/mnt/cache/appdata/jelu/files/imports",
      "container": "/files/imports",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "11111",
      "container": "11111",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
