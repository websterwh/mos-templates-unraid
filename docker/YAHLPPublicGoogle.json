{
  "name": "YAHLP-Public-Google",
  "repo": "ghcr.io/auskento/yahlp",
  "category": [
    "Network"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://yourdomain.com",
  "icon": "https://raw.githubusercontent.com/auskento/YAHLP/main/html/icons/yahlp.png",
  "project": "https://github.com/auskento/YAHLP",
  "description": "YAHLP - Yet Another HomeLab Portal - Public Mode with Google OAuth Configured for public internet deployment with: - HTTPS with automatic Let's Encrypt certificates - Google OAuth 2.0 authentication - Requires domain name and email address - Requires Google OAuth credentials from Google Cloud Console - Ports 80 and 443 must be port-forwarded Setup Requirements: 1. Create OAuth 2.0 credentials in Google Cloud Console 2. Set Redirect URI to: https://your-domain.com/auth/oauth2/callback 3. Add DNS A record pointing your domain to your server IP 4. Ensure ports 80 and 443 are port-forwarded from router 5. Set TEST_MODE=false once ready for production to avoid Let's Encrypt rate limiting",
  "paths": [
    {
      "name": "Configuration",
      "host": "/mnt/cache/appdata/yahlp",
      "container": "/etc/yahlp",
      "mode": "rw",
      "description": "Configuration folder - store the yahlp and sites JSON5 files here - ENV Variables override config settings, remove the variable settings from the form. Custom templates in the templates folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Let's Encrypt Test Mode",
      "key": "DASHBOARD_TEST",
      "value": "true|false",
      "description": "Let's Encrypt --dry-run mode (test without rate limits). WARNING: Certificates will NOT be issued. Set to false when ready for production.",
      "required": false,
      "mask": false
    },
    {
      "name": "Access Mode",
      "key": "ACCESS_MODE",
      "value": "public|private",
      "description": "Choose: public (HTTPS with Let's Encrypt) or private (HTTP on internal network)",
      "required": true,
      "mask": false
    },
    {
      "name": "Domain (Public)",
      "key": "DOMAIN",
      "value": "",
      "description": "Your domain for public mode (e.g., yahlp.yourdomain.com)",
      "required": false,
      "mask": false
    },
    {
      "name": "Email (Public)",
      "key": "EMAIL",
      "value": "",
      "description": "Email for Let's Encrypt notifications (public mode only)",
      "required": false,
      "mask": false
