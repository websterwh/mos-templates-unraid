{
  "name": "miniflux",
  "repo": "miniflux/miniflux:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/miniflux/miniflux/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/miniflux.png",
  "project": "https://hub.docker.com/r/miniflux/miniflux/",
  "description": "Miniflux is a minimalist and opinionated feed reader.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "5600",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PostgresDB",
      "key": "DATABASE_URL",
      "value": "postgres://miniflux:secret@Hostname/miniflux2?sslmode=disable",
      "description": "PostgresDB Change this with correct database configuration you have.",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Username",
      "key": "ADMIN_USERNAME",
      "value": "admin",
      "description": "Admin Username",
      "required": false,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": "password",
      "description": "Admin Password",
      "required": false,
      "mask": false
    },
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "http://192.168.1.100:5600",
      "description": "Base URL to generate HTML links and base path for cookies for example http://192.168.1.100:5600 or https://rss.example.com",
      "required": true,
      "mask": false
    },
    {
      "name": "Feed Refresh Interval",
      "key": "POLLING_FREQUENCY",
      "value": "60",
      "description": "Refresh interval in minutes for feeds by minutes",
      "required": false,
      "mask": false
    },
    {
      "name": "Cleanup Job Frequency",
      "key": "CLEANUP_FREQUENCY_HOURS",
      "value": "24",
      "description": "Cleanup job frequency, remove old sessions and archive read entries by hours",
      "required": false,
      "mask": false
    },
    {
      "name": "Cleanup Read Items",
      "key": "CLEANUP_ARCHIVE_READ_DAYS",
      "value": "60",
      "description": "Number of days after which marking read items as removed",
      "required": false,
      "mask": false
    },
    {
      "name": "Cleanup Old Sessions",
      "key": "CLEANUP_REMOVE_SESSIONS_DAYS",
      "value": "30",
      "description": "Number of days after removing old sessions from the database",
      "required": false,
      "mask": false
    },
    {
      "name": "Create Admin",
      "key": "CREATE_ADMIN",
      "value": "1",
      "description": "CREATE_ADMIN",
      "required": true,
      "mask": false
    },
    {
      "name": "Migrate",
      "key": "RUN_MIGRATIONS",
      "value": "1",
      "description": "Migrate",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Time",
      "key": "LOG_DATE_TIME",
      "value": "0",
      "description": "Set the value to 1 to show date/time in log messages",
      "required": false,
      "mask": false
    },
    {
      "name": "DEBUG",
      "key": "DEBUG",
      "value": "0",
      "description": "DEBUG",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
