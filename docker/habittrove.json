{
  "name": "habittrove",
  "repo": "dohsimpson/habittrove:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dohsimpson/habittrove",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/Collectathon/unraid-templates/refs/heads/main/icons/habittrove.png",
  "project": "https://github.com/dohsimpson/HabitTrove",
  "description": "HabitTrove is a gamified habit tracking application that helps you build and maintain positive habits by rewarding you with coins, which you can use to exchange for rewards. Setup: mkdir /mnt/user/appdata/habittrove chown -R 1001:1001 /mnt/user/appdata/habittrove",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/habittrove",
      "container": "/app/data",
      "mode": "rw",
      "description": "AppData Location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Auth Secret",
      "key": "AUTH_SECRET",
      "value": "",
      "description": "Generate with openssl rand -base64 36",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
