{
  "name": "finscope",
  "repo": "ghcr.io/netz-sg/finscope:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/netz-sg/finscope/pkgs/container/finscope",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/Joly0/unraid-templates/blob/main/icons/finscope_icon.png?raw=true",
  "project": "https://github.com/netz-sg/finscope",
  "description": "A monitoring and analytics dashboard for Jellyfin. Keep an eye on active streams, user activity, library stats, and server health -- all in one place, with a glass-morphism UI inspired by Apple's Spatial Design.",
  "paths": [
    {
      "name": "Data path",
      "host": "/mnt/cache/appdata/finscope",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4687",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database path variable",
      "key": "DB_PATH",
      "value": "/data/finscope.db",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
