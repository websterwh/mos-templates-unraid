{
  "name": "stasharr",
  "repo": "ghcr.io/bdlnaredi/stasharr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/bdlnaredi/stasharr/pkgs/container/stasharr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2704]/",
  "icon": "https://raw.githubusercontent.com/bdlnaredi/stasharr/main/ui/v2.5/public/favicon.png",
  "project": "https://github.com/bdlnaredi/stasharr",
  "description": "Before you install: EARLY-STAGE SOFTWARE: This app is new and may be broken. Updates are frequent and may include breaking changes. Back up your data before installing or updating. Provided \"as is\" with no warranty; the author accepts no liability for data loss or damage. Use at your own risk. Stasharr is a fork of Stash with multi-user logins (roles and tiers with library access), per-user history and ratings, automatic scan and identify of new files (ThePornDB, StashDB and other stash-boxes), and automatic 15 second vertical reels.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/stasharr/config",
      "container": "/root/.stash",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Library",
      "host": "/mnt/cache/media/stash",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Metadata",
      "host": "/mnt/cache/appdata/stasharr/metadata",
      "container": "/metadata",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Cache",
      "host": "/mnt/cache/appdata/stasharr/cache",
      "container": "/cache",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Blobs",
      "host": "/mnt/cache/appdata/stasharr/blobs",
      "container": "/blobs",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Generated",
      "host": "/mnt/cache/appdata/stasharr/generated",
      "container": "/generated",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "2704",
      "container": "2704",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "STASH_STASH",
      "key": "STASH_STASH",
      "value": "/data/",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "STASH_GENERATED",
      "key": "STASH_GENERATED",
      "value": "/generated/",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "STASH_METADATA",
      "key": "STASH_METADATA",
      "value": "/metadata/",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "STASH_CACHE",
      "key": "STASH_CACHE",
      "value": "/cache/",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "STASH_PORT",
      "key": "STASH_PORT",
      "value": "2704",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Asia/Kolkata",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
