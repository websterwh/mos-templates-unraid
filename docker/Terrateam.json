{
  "name": "Terrateam",
  "repo": "ghcr.io/terrateamio/terrat-oss:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/terrateamio/terrat-oss",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/terrateam-icon.png",
  "project": "https://terrateam.io/",
  "description": "Terrateam is an open-source GitOps CI/CD platform for automating infrastructure workflows. It integrates with GitHub to orchestrate Terraform, OpenTofu, CDKTF, Terragrunt, and Pulumi operations via pull requests.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Ngrok Endpoint",
      "key": "NGROK_ENDPOINT",
      "value": "http://IP_ADDRESS:4040",
      "description": "Ngrok endpoint for Terrateam",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Host",
      "key": "DB_HOST",
      "value": "IP_ADDRESS",
      "description": "PosgreSQL database host",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Port",
      "key": "DB_PORT",
      "value": "5432",
      "description": "PosgreSQL database port",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Name",
      "key": "DB_NAME",
      "value": "terrateam",
      "description": "PosgreSQL database name",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - User",
      "key": "DB_USER",
      "value": "terrateam",
      "description": "PosgreSQL database user",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Password",
      "key": "DB_PASS",
      "value": "",
      "description": "PosgreSQL database password",
      "required": true,
      "mask": true
    },
    {
      "name": "GitHub - Webhook Secret",
      "key": "GITHUB_WEBHOOK_SECRET",
      "value": "",
      "description": "GitHub webhook secret",
      "required": true,
      "mask": true
    },
    {
      "name": "GitHub - App Client ID",
      "key": "GITHUB_APP_CLIENT_ID",
      "value": "",
      "description": "GitHub app client ID",
      "required": true,
      "mask": true
    },
    {
      "name": "GitHub - App Client Secret",
      "key": "GITHUB_APP_CLIENT_SECRET",
      "value": "",
      "description": "GitHub app client secret",
      "required": true,
      "mask": true
    },
    {
      "name": "GitHub - App ID",
      "key": "GITHUB_APP_ID",
      "value": "",
      "description": "GitHub app ID",
      "required": true,
      "mask": true
    },
    {
      "name": "GitHub - App PEM Key",
      "key": "GITHUB_APP_PEM",
      "value": "",
      "description": "GitHub app PEM key",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
