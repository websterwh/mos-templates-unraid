{
  "name": "sortify",
  "repo": "ghcr.io/lklynet/sortify:latest",
  "category": [
    "System"
  ],
  "registry": "https://ghcr.io/lklynet/sortify",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3001]/",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/icons/refs/heads/main/sortify_logo.png",
  "project": "https://github.com/lklynet/sortify",
  "description": "Sortify is a self-hosted playlist assistant for Navidrome. It scans your library, stores metadata locally, and generates recommended playlists from the web UI. It does NOT touch your files metadata and instead stores it in a local SQLite database, keeping your files safe and untouched.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/sortify",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
