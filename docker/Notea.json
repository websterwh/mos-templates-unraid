{
  "name": "Notea",
  "repo": "diamkil/notea",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/diamkil/notea/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/diamkil/docker-templates/master/diamkil/images/notea.png",
  "project": "https://github.com/diamkil/docker-notea",
  "description": "Self hosted note taking, alternative to Notions. Look at Github for config",
  "paths": [],
  "ports": [
    {
      "name": "Notea Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Port for Notea WebUI",
      "required": true,
      "mask": false
    },
    {
      "name": "MinIO Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Port for MinIO WebUI",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "WebUI Password",
      "key": "PASSWORD",
      "value": "",
      "description": "Set the password to use on Notea's Website",
      "required": true,
      "mask": false
    },
    {
      "name": "MinIO User",
      "key": "STORE_USER",
      "value": "",
      "description": "User for MinIO Backend",
      "required": true,
      "mask": false
    },
    {
      "name": "MinIO Password",
      "key": "STORE_PASSWORD",
      "value": "",
      "description": "Password for MinIO Backend",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
