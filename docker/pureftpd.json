{
  "name": "pure-ftpd",
  "repo": "crazymax/pure-ftpd:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/crazymax/pure-ftpd/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2100]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/pure-ftpd.png",
  "project": "https://www.pureftpd.org/project/pure-ftpd/",
  "description": "Pure-FTPd is a free (BSD), secure, production-quality and standard-conformant FTP server. Creating user by using console \"pure-pw useradd admin -u 99 -g 100 -d /home/admin -m\"",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/pure-ftpd/",
      "container": "/data",
      "mode": "rw",
      "description": "Contains config files and PureDB file",
      "required": false
    },
    {
      "name": "FTP Folder",
      "host": "/mnt/cache/pure-ftpd/",
      "container": "/home",
      "mode": "rw",
      "description": "Contains FTP Files",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "FTP port",
      "host": "2100",
      "container": "2100",
      "protocol": "tcp",
      "description": "FTP port",
      "required": false,
      "mask": false
    },
    {
      "name": "PASV port range",
      "host": "30000-30009",
      "container": "30000-30009",
      "protocol": "tcp",
      "description": "PASV port range",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "AUTH_METHOD",
      "key": "AUTH_METHOD",
      "value": "puredb",
      "description": "Authentication method to use. Can be puredb, mysql, pgsql or ldap",
      "required": false,
      "mask": false
    },
    {
      "name": "SECURE_MODE",
      "key": "SECURE_MODE",
      "value": "true",
      "description": "Enable secure mode - https://github.com/crazy-max/docker-pure-ftpd#secure-mode",
      "required": false,
      "mask": false
    },
    {
      "name": "PASSIVE_PORT_RANGE",
      "key": "PASSIVE_PORT_RANGE",
      "value": "30000:30009",
      "description": "Port range for passive connections",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
