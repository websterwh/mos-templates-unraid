{
  "name": "postfix-relay",
  "repo": "mwader/postfix-relay:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/mwader/postfix-relay",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:25]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/postfix-relay-icon.png",
  "project": "https://www.postfix.org/",
  "description": "A relay for sending email without using an external SMTP server. See all available configuration options: https://github.com/wader/postfix-relay#postfix-variables",
  "paths": [
    {
      "name": "OpenDKIM Key Storage Path",
      "host": "/mnt/cache/appdata/postfix_relay/opendkim_keys",
      "container": "/etc/opendkim/keys",
      "mode": "rw",
      "description": "Path to store OpenDKIM keys",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "SMTP Port",
      "host": "25",
      "container": "25",
      "protocol": "tcp",
      "description": "Container Port: 25",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Hostname",
      "key": "POSTFIX_myhostname",
      "value": "",
      "description": "Hostname for this SMTP server",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
