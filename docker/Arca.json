{
  "name": "Arca",
  "repo": "damianeickhoff/arca:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/damianeickhoff/arca",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/damianeickhoff/arca/master/public/icon.png",
  "project": "https://github.com/damianeickhoff/arca",
  "description": "Arca is a self-hosted personal finance dashboard for tracking income, expenses, budgets, subscriptions, and financial goals.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/arca",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent storage for Arca database",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Arca web interface port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
