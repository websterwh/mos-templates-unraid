{
  "name": "Workout-Tracker",
  "repo": "ghcr.io/jovandeginste/workout-tracker:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jovandeginste/workout-tracker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/workout-tracker-icon.png",
  "project": "https://github.com/jovandeginste/workout-tracker",
  "description": "A workout tracking web application for personal use (or family, friends), geared towards running and other GPX-based activities.",
  "paths": [
    {
      "name": "Data path",
      "host": "/mnt/cache/appdata/workout_tracker/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to data files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
