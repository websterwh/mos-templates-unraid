{
  "name": "Music-Manager-for-Plex",
  "repo": "zcaddick/music-manager-for-plex",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/zcaddick/music-manager-for-plex",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8501]",
  "icon": "https://raw.githubusercontent.com/caddickzac/Music-Manager-for-Plex/main/icon/icon.png",
  "project": "https://github.com/caddickzac/Music-Manager-for-Plex",
  "description": "Organize, automate, and curate your Plex Music library. Features include Sonic Playlist Creator (BPM/Energy), Metadata Export, Bulk Editing, and advanced Library analysis.",
  "paths": [
    {
      "name": "Exports Path",
      "host": "/mnt/cache/appdata/music-manager-for-plex/exports",
      "container": "/app/Exports",
      "mode": "rw",
      "description": "Map this to a folder on your Unraid array to save CSV exports.",
      "required": true
    },
    {
      "name": "Playlist Presets Path",
      "host": "/mnt/cache/appdata/music-manager-for-plex/presets",
      "container": "/app/Playlist_Presets",
      "mode": "rw",
      "description": "Map this to save your Playlist Creator presets.",
      "required": true
    },
    {
      "name": "Extras Path",
      "host": "/mnt/cache/appdata/music-manager-for-plex/extras",
      "container": "/app/Extras",
      "mode": "rw",
      "description": "Map this to access the App Documentation and User Scripts (e.g. for User Scripts plugin).",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8501",
      "container": "8501",
      "protocol": "tcp",
      "description": "Port for the Streamlit Web Interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Plex URL",
      "key": "PLEX_URL",
      "value": "",
      "description": "Your Plex Server URL (e.g., http://192.168.1.5:32400)",
      "required": false,
      "mask": false
    },
    {
      "name": "Plex Token",
      "key": "PLEX_TOKEN",
      "value": "",
      "description": "Your Plex Authentication Token",
      "required": false,
      "mask": true
    },
    {
      "name": "App Password",
      "key": "APP_PASSWORD",
      "value": "",
      "description": "Optional: Set a password to protect the WebUI.",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
