{
  "name": "melodarr",
  "repo": "slimjimserver/melodarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/slimjimserver/melodarr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5056]",
  "icon": "https://raw.githubusercontent.com/slimjimserver/melodarr/main/frontend/icons/melodarr-512.png",
  "project": "https://github.com/slimjimserver/melodarr",
  "description": "Melodarr is a self-hosted music discovery and request app for Lidarr. It gives users a simple interface for finding artists and albums",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/melodarr",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5056",
      "container": "5056",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MELODARR_DATABASE",
      "key": "MELODARR_DATABASE",
      "value": "/app/data/melodarr.db",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MELODARR_CACHE_DATABASE",
      "key": "MELODARR_CACHE_DATABASE",
      "value": "/app/data/cache/metadata.db",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
