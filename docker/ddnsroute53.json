{
  "name": "ddns-route53",
  "repo": "crazymax/ddns-route53:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/crazymax/ddns-route53/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/ddns-route53.png",
  "project": "https://github.com/crazy-max/ddns-route53",
  "description": "Dynamic DNS for Amazon Route 53\u200e on a time-based schedule",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "SCHEDULE",
      "key": "SCHEDULE",
      "value": "*/30 * * * *",
      "description": "CRON expression to schedule ddns-route53 - http://www.cronmaker.com",
      "required": false,
      "mask": false
    },
    {
      "name": "MAX_RETRIES",
      "key": "MAX_RETRIES",
      "value": "3",
      "description": "Number of retries in case of WAN IP retrieval failure",
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_LEVEL",
      "key": "LOG_LEVEL",
      "value": "info",
      "description": "Log level output",
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_JSON",
      "key": "LOG_JSON",
      "value": "false",
      "description": "Enable JSON logging output",
      "required": false,
      "mask": false
    },
    {
      "name": "DDNSR53_CREDENTIALS_ACCESSKEYID",
      "key": "DDNSR53_CREDENTIALS_ACCESSKEYID",
      "value": "ABCDEFGHIJKLMNO123456",
      "description": "Access Key ID",
      "required": false,
      "mask": false
    },
    {
      "name": "DDNSR53_CREDENTIALS_SECRETACCESSKEY",
      "key": "DDNSR53_CREDENTIALS_SECRETACCESSKEY",
      "value": "abcdefgh123456IJKLMN+OPQRS7890+ABCDEFGH",
      "description": "Secret Access Key",
      "required": false,
      "mask": false
    },
    {
      "name": "DDNSR53_ROUTE53_HOSTEDZONEID",
      "key": "DDNSR53_ROUTE53_HOSTEDZONEID",
      "value": "ABCEEFG123456789",
      "description": "Host Zone ID",
      "required": false,
      "mask": false
    },
    {
      "name": "DDNSR53_ROUTE53_RECORDSSET_0_NAME",
      "key": "DDNSR53_ROUTE53_RECORDSSET_0_NAME",
      "value": "ddns.example.com.",
      "description": "Record Set 0",
      "required": false,
      "mask": false
    },
    {
      "name": "DDNSR53_ROUTE53_RECORDSSET_0_TYPE",
      "key": "DDNSR53_ROUTE53_RECORDSSET_0_TYPE",
      "value": "A",
      "description": "Record Set 0 Type",
      "required": false,
      "mask": false
    },
    {
      "name": "DDNSR53_ROUTE53_RECORDSSET_0_TTL",
      "key": "DDNSR53_ROUTE53_RECORDSSET_0_TTL",
      "value": "300",
      "description": "Record Set 0 TTL",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
