{
  "name": "ontime",
  "repo": "getontime/ontime",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/getontime/ontime",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4001]/",
  "icon": "https://raw.githubusercontent.com/cpvalente/ontime/master/apps/client/src/assets/images/ontime-logo.svg",
  "project": "https://github.com/cpvalente/ontime",
  "description": "Ontime is a browser-based application that manages event rundowns, scheduling, and cueing. With Ontime, you can plan, track your schedule, manage automation and cross-department show information all in one place.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/ontime",
      "container": "/data/",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4001",
      "container": "4001",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OSC input",
      "host": "8888",
      "container": "8888",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OSC output",
      "host": "9999",
      "container": "9999",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
