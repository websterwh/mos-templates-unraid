{
  "name": "MacOS",
  "repo": "dockurr/macos:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dockurr/macos",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--cap-add=NET_ADMIN",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8006]/",
  "icon": "https://raw.githubusercontent.com/dockur/macos/master/.github/logo.png",
  "project": "https://github.com/dockur/macos",
  "description": "MacOS inside a Docker container.",
  "paths": [
    {
      "name": "Storage",
      "host": "",
      "container": "/storage",
      "mode": "rw",
      "description": "Path to storage directory. This may be large.",
      "required": true
    },
    {
      "name": "KVM Device",
      "host": "/dev/kvm",
      "container": "/dev/kvm",
      "mode": "rw",
      "description": "Path to KVM device.",
      "required": true
    },
    {
      "name": "Network Tunnel Device",
      "host": "/dev/net/tun",
      "container": "/dev/net/tun",
      "mode": "rw",
      "description": "Path to network tunnel device.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8006",
      "container": "8006",
      "protocol": "tcp",
      "description": "Container Port: 8006",
      "required": true,
      "mask": false
    },
    {
      "name": "Server Port - TCP",
      "host": "5900",
      "container": "5900",
      "protocol": "tcp",
      "description": "Container Port: 5900",
      "required": true,
      "mask": false
    },
    {
      "name": "Server Port - UDP",
      "host": "5900",
      "container": "5900",
      "protocol": "udp",
      "description": "Container Port: 5900",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MacOS Version",
      "key": "VERSION",
      "value": "15|14|13|12|11",
      "description": "MacOS version to run. Note that not all versions may work on all hardware.",
      "required": true,
      "mask": false
    },
    {
      "name": "Disk Size",
      "key": "DISK_SIZE",
      "value": "64G",
      "description": "Size of the virtual disk.",
      "required": true,
      "mask": false
    },
    {
      "name": "RAM Size",
      "key": "RAM_SIZE",
      "value": "4G",
      "description": "Amount of RAM to allocate to the VM.",
      "required": true,
      "mask": false
    },
    {
      "name": "CPU Cores",
      "key": "CPU_CORES",
      "value": "1",
      "description": "Number of CPU cores to allocate to the VM.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
