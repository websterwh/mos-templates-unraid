{
  "name": "HaVeWa",
  "repo": "ghcr.io/fgilde/hausverwaltung:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/fgilde/hausverwaltung/pkgs/container/hausverwaltung",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/fgilde/hausverwaltung/main/public/icon.png",
  "project": "https://github.com/fgilde/hausverwaltung",
  "description": "Vollst\u00e4ndige Hausverwaltung (Miet + WEG), mehrsprachig, mit REST-API und MCP f\u00fcr KI-Agenten. Ben\u00f6tigt eine PostgreSQL-Datenbank.",
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/havewa/storage",
      "container": "/app/storage",
      "mode": "rw",
      "description": "Dokumente/Logo (persistent)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Port der Weboberfl\u00e4che",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgresql://havewa:CHANGE_ME@192.168.1.10:5432/havewa?schema=public",
      "description": "Postgres-Verbindung (Host = IP/Name deines Postgres-Containers)",
      "required": true,
      "mask": false
    },
    {
      "name": "AUTH_SECRET",
      "key": "AUTH_SECRET",
      "value": "",
      "description": "Session-Secret. Erzeugen: openssl rand -base64 32",
      "required": true,
      "mask": true
    },
    {
      "name": "AUTH_TRUST_HOST",
      "key": "AUTH_TRUST_HOST",
      "value": "true",
      "description": "Hinter Reverse-Proxy/lokal auf true lassen",
      "required": true,
      "mask": false
    },
    {
      "name": "SEED_DEMO",
      "key": "SEED_DEMO",
      "value": "",
      "description": "true = Demo-Datensatz beim ersten Start (Admin admin@havewa.app/admin). Sonst leer lassen.",
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_EMAIL",
      "key": "ADMIN_EMAIL",
      "value": "",
      "description": "Optional: Admin direkt anlegen (statt Wizard).",
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_PASSWORD",
      "key": "ADMIN_PASSWORD",
      "value": "",
      "description": "Optional: Passwort des Admins.",
      "required": false,
      "mask": true
    },
    {
      "name": "TENANT_NAME",
      "key": "TENANT_NAME",
      "value": "",
      "description": "Optional: Name der Hausverwaltung.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
