{
  "name": "Nevu",
  "repo": "ipmake/nevu:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/ipmake/nevu",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/Ipmake/Nevu/refs/heads/main/frontend/public/icon.png",
  "project": "https://github.com/Ipmake/Nevu",
  "description": "Nevu is a complete redesign of Plex's UI using the plex media server API.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/nevu/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Plex Server URL",
      "key": "PLEX_SERVER",
      "value": "http://localhost:32400",
      "description": "URL of the Plex server to connect to.",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable TLS Verify",
      "key": "DISABLE_TLS_VERIFY",
      "value": "false|true",
      "description": "If true, proxy will ignore SSL certificate errors.",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable Nevu Sync",
      "key": "DISABLE_NEVU_SYNC",
      "value": "false|true",
      "description": "If true, Nevu Sync (Watch Together) will be disabled.",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable Request Logging",
      "key": "DISABLE_REQUEST_LOGGING",
      "value": "false|true",
      "description": "If true, request logging will be disabled.",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable Global Reviews",
      "key": "DISABLE_GLOBAL_REVIEWS",
      "value": "false|true",
      "description": "If true, Nevu global reviews will be disabled.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
