{
  "name": "prusaslicer-novnc",
  "repo": "mikeah/prusaslicer-novnc",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/mikeah/prusaslicer-novnc",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://cdn.help.prusa3d.com/wp-content/uploads/PSlogo-1-300x300.jpg",
  "project": "https://www.prusa3d.com/prusaslicer/",
  "description": "Enjoy Prusaslicer directly in your browser with this easy to use Docker container. This template has the minimum variables defined, but you can find additional details on the template at the URLs listed below. https://github.com/helfrichmichael/prusaslicer-novnc https://hub.docker.com/r/mikeah/prusaslicer-novnc",
  "paths": [
    {
      "name": "Configs folder",
      "host": "/mnt/cache/appdata/prusaslicer",
      "container": "/configs/",
      "mode": "rw",
      "description": "Container Path: /configs/",
      "required": true
    },
    {
      "name": "Prints",
      "host": "/mnt/cache/3D Printing/",
      "container": "/prints/",
      "mode": "rw",
      "description": "3D Printing Folder",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "VNC Interface",
      "host": "6080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SSL_CERT_FILE",
      "key": "SSL_CERT_FILE",
      "value": "/etc/ssl/certs/ca-certificates.crt",
      "description": "Needed to allow Prusaslicer to open without any prompts upon startup.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
