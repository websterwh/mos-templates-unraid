{
  "name": "lido-csm-dashboard",
  "repo": "0xdespot/lido-csm-dashboard:latest",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/0xdespot/lido-csm-dashboard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/lido-csm-dashboard.png",
  "project": "https://github.com/0xdespot/lido-csm-dashboard",
  "description": "Lido CSM Operator Dashboard - Track your Community Staking Module validator earnings, bond status, APY metrics, strikes, and health status. Features both a web UI and CLI interface.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/lido-csm-dashboard",
      "container": "/app/data",
      "mode": "rw",
      "description": "Application data and cache directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ETH RPC URL",
      "key": "ETH_RPC_URL",
      "value": "https://eth.llamarpc.com",
      "description": "Ethereum RPC endpoint (default: llamarpc.com)",
      "required": false,
      "mask": false
    },
    {
      "name": "Beacon API URL",
      "key": "BEACON_API_URL",
      "value": "https://beaconcha.in/api/v1",
      "description": "Beacon chain API endpoint (default: beaconcha.in)",
      "required": false,
      "mask": false
    },
    {
      "name": "Beacon API Key",
      "key": "BEACON_API_KEY",
      "value": "",
      "description": "Optional - beaconcha.in API key for higher rate limits",
      "required": false,
      "mask": true
    },
    {
      "name": "Etherscan API Key",
      "key": "ETHERSCAN_API_KEY",
      "value": "",
      "description": "Optional - enables withdrawal history tracking",
      "required": false,
      "mask": true
    },
    {
      "name": "TheGraph API Key",
      "key": "THEGRAPH_API_KEY",
      "value": "",
      "description": "Optional - enables historical stETH APR data",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
