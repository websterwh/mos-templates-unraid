{
  "name": "automatic-ripping-machine",
  "repo": "1337server/automatic-ripping-machine:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://github.com/automatic-ripping-machine/automatic-ripping-machine",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--runtime=nvidia --gpus all --device /dev/sr0 --device /dev/sg1",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/automatic-ripping-machine/automatic-ripping-machine/main/favicon.ico",
  "project": "https://github.com/automatic-ripping-machine/automatic-ripping-machine",
  "description": "Insert an optical disc (Blu-ray, DVD, CD) and checks to see if it's audio, video (Movie or TV), or data, then rips it. See: https://b3n.org/automatic-ripping-machine use lsscsi -g on root of Unraid to get info for --device for cd/dvd/bluray drive for handbrake presets https://handbrake.fr/docs/en/latest/technical/official-presets.html https://github.com/automatic-ripping-machine/automatic-ripping-machine/wiki/Building-ARM-docker-image-from-source https://github.com/automatic-ripping-machine/automatic-ripping-machine/wiki/Docker-Troubleshooting",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/ARM/",
      "container": "/home/arm",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/ARM/Music",
      "container": "/home/arm/Music",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Host Path 3",
      "host": "/mnt/cache/appdata/ARM/config",
      "container": "/etc/arm/config",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Host Path 4",
      "host": "/mnt/cache/appdata/ARM/logs",
      "container": "/home/arm/logs",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Host Path 5",
      "host": "/mnt/cache/appdata/ARM/media",
      "container": "/home/arm/media",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Webserver port",
      "host": "8088",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "GPU-9152780a-a0e6-3877-b6fd-01ec4b6c22be",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "ARM_UID",
      "value": "1001",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "ARM_GID",
      "value": "1001",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
