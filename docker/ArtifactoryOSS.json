{
  "name": "Artifactory-OSS",
  "repo": "docker.bintray.io/jfrog/artifactory-oss:6.23.7",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/docker.bintray.io/jfrog/artifactory-oss",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--ulimit nofile=32000:40000 --ulimit nproc=65535",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://i.imgur.com/aYdPHTy.png",
  "project": "https://jfrog.com/",
  "description": "JFrog\u2019s Artifactory open source project was created to speed up development cycles using binary repositories. It\u2019s the world\u2019s most advanced repository manager, creating a single place for teams to manage all their binary artifacts efficiently.",
  "paths": [
    {
      "name": "/var/opt/jfrog/artifactory",
      "host": "/mnt/cache/appdata/artifactory-oss",
      "container": "/var/opt/jfrog/artifactory",
      "mode": "rw",
      "description": "/var/opt/jfrog/artifactory",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 8081",
      "host": "8181",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "EXTRA_JAVA_OPTIONS",
      "key": "EXTRA_JAVA_OPTIONS",
      "value": "-Xms512m -Xmx4g",
      "description": "Container Variable: EXTRA_JAVA_OPTIONS",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
