{
  "name": "nginx-mailer",
  "repo": "drumsergio/nginx-mailer:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/drumsergio/nginx-mailer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/GeiserX/docker-templates/master/drumsergio/images/nginx-mailer.png",
  "project": "https://github.com/GeiserX/nginx-mailer",
  "description": "Lightweight nginx-based container (~35MB) for serving static websites with an integrated contact form that sends emails via SMTP. Single container runs both nginx and a Go API backend via supervisord. Includes optional Cloudflare Turnstile CAPTCHA integration. Multi-arch (amd64/arm64). Perfect for personal or portfolio sites that need a simple contact form without a full backend. More info: https://github.com/GeiserX/nginx-mailer",
  "paths": [
    {
      "name": "Website Files",
      "host": "/mnt/cache/appdata/nginx-mailer/html",
      "container": "/usr/share/nginx/html",
      "mode": "ro",
      "description": "Static website files (read-only)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP port for the website",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SMTP Host",
      "key": "SMTP_HOST",
      "value": "",
      "description": "SMTP server hostname",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP Port",
      "key": "SMTP_PORT",
      "value": "465",
      "description": "SMTP port (465 for SSL, 587 for STARTTLS)",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP User",
      "key": "SMTP_USER",
      "value": "",
      "description": "SMTP username",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP Password",
      "key": "SMTP_PASSWORD",
      "value": "",
      "description": "SMTP password",
      "required": true,
      "mask": true
    },
    {
      "name": "From Email",
      "key": "SMTP_FROM",
      "value": "",
      "description": "Sender email address",
      "required": true,
      "mask": false
    },
    {
      "name": "Contact Email",
      "key": "CONTACT_EMAIL",
      "value": "",
      "description": "Recipient email for contact form submissions",
      "required": true,
      "mask": false
    },
    {
      "name": "Turnstile Secret",
      "key": "CLOUDFLARE_TURNSTILE_SECRET_KEY",
      "value": "",
      "description": "Cloudflare Turnstile CAPTCHA secret key (optional)",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
