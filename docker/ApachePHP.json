  "project": "https://github.com/evilalmus/docker-apahe-php/",
  "description": "Apache based web server with basic PHP web server capabilities with the addition of php5-gd, php5-sqlite, php5-intl Directions: /config : this path is used to store the configuration and the SSL certs files of the reverse proxy. /web : this path is the web directory /web/adminer : adminer path inside the web directory /logs : this path is the logs directory I have added custom Crontab functionality.To enable Cron jobs, edit the file crons.conf in folder /config. Add as many tasks as you need, save the file, and restart the container.",
  "paths": [
    {
      "name": "Host Path 2",
      "host": "/mnt/disks/SSD/www/",
      "container": "/web",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Host Path 3",
      "host": "/mnt/disks/SSD/appdata/apache-php/logs/",
      "container": "/logs",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Host Path 4",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/Apache-PHP",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8005",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "8444",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
