{
  "name": "AppFlowy-Search",
  "repo": "appflowyinc/appflowy_search:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/appflowyinc/appflowy_search",
  "network": "custom:appflowy",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://avatars.githubusercontent.com/u/81710027?s=200&v=4",
  "project": "https://github.com/vmalinics0/unraid-appflowy",
  "description": "Step 6/7: AppFlowy Search \u2014 full-text and semantic (AI-powered) search service for AppFlowy Cloud documents. Part of the AppFlowy Cloud stack.",
  "paths": [
    {
      "name": "Keyword Index Directory",
      "host": "/mnt/cache/appdata/AppFlowy-Search/keyword_index",
      "container": "/var/lib/appflowy/keyword_index",
      "mode": "rw",
      "description": "Persistent directory for the full-text (keyword) search index. Must have sufficient free space.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Database URL",
      "key": "APPFLOWY_SEARCH_DATABASE_URL",
      "value": "postgres://postgres:changeme_strong_password@AppFlowy-Postgres:5432/postgres",
      "description": "PostgreSQL connection string. Must match AppFlowy-Cloud.",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis URL",
      "key": "APPFLOWY_SEARCH_REDIS_URL",
      "value": "redis://AppFlowy-Redis:6379",
      "description": "Redis connection URL.",
      "required": true,
      "mask": false
    },
    {
      "name": "JWT Secret",
      "key": "APPFLOWY_GOTRUE_JWT_SECRET",
      "value": "changeme_jwt_secret_min32chars!!",
      "description": "Shared JWT secret. Must be identical to GoTrue and AppFlowy-Cloud.",
      "required": true,
      "mask": true
    },
    {
      "name": "Use MinIO",
      "key": "APPFLOWY_S3_USE_MINIO",
      "value": "true",
      "description": "Set true to use MinIO.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Access Key",
      "key": "APPFLOWY_S3_ACCESS_KEY",
      "value": "minioadmin",
      "description": "S3/MinIO access key.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Secret Key",
      "key": "APPFLOWY_S3_SECRET_KEY",
      "value": "changeme_minio_secret",
      "description": "S3/MinIO secret key.",
      "required": true,
      "mask": true
    },
    {
      "name": "S3 Bucket",
      "key": "APPFLOWY_S3_BUCKET",
      "value": "appflowy",
      "description": "S3/MinIO bucket name.",
      "required": true,
      "mask": false
    },
    {
      "name": "MinIO URL (internal)",
      "key": "APPFLOWY_S3_MINIO_URL",
      "value": "http://AppFlowy-MinIO:9000",
      "description": "Internal MinIO API URL.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Region",
      "key": "APPFLOWY_S3_REGION",
      "value": "",
      "description": "AWS S3 region (leave empty for MinIO).",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenAI API Key",
      "key": "AI_OPENAI_API_KEY",
      "value": "",
      "description": "OpenAI API key for semantic/vector search and document embeddings. Leave empty to use keyword-only search.",
      "required": false,
      "mask": true
    },
    {
      "name": "Azure OpenAI API Key",
      "key": "AZURE_OPENAI_API_KEY",
      "value": "",
      "description": "Azure-hosted OpenAI API key (alternative to OpenAI). Leave empty if using standard OpenAI.",
      "required": false,
      "mask": true
    },
    {
      "name": "Azure OpenAI Endpoint",
      "key": "AZURE_OPENAI_ENDPOINT",
      "value": "",
      "description": "Azure OpenAI resource endpoint URL.",
      "required": false,
      "mask": false
    },
    {
      "name": "Azure OpenAI API Version",
      "key": "AZURE_OPENAI_API_VERSION",
      "value": "",
      "description": "Azure OpenAI API version string.",
      "required": false,
      "mask": false
    },
    {
      "name": "Keyword Search Enabled",
      "key": "APPFLOWY_KEYWORD_SEARCH_ENABLED",
      "value": "true",
      "description": "Enable full-text keyword search. Recommended: true.",
      "required": false,
      "mask": false
    },
    {
      "name": "Background Indexer Enabled",
      "key": "APPFLOWY_BACKGROUND_INDEXER_ENABLED",
      "value": "true",
      "description": "Continuously index new/updated documents in the background.",
      "required": false,
      "mask": false
    },
    {
      "name": "Keyword Worker Enabled",
      "key": "APPFLOWY_KEYWORD_WORKER_ENABLED",
      "value": "true",
      "description": "Enable the keyword indexing worker.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Indexer Enabled",
      "key": "APPFLOWY_INDEXER_DATABASE_ENABLED",
      "value": "false",
      "description": "Enable database-level indexing (experimental).",
      "required": false,
      "mask": false
    },
    {
      "name": "Keyword Index Map Size (bytes)",
      "key": "APPFLOWY_KEYWORD_INDEX_MAP_SIZE_BYTES",
      "value": "2147483648",
      "description": "Memory-mapped file size for keyword index in bytes. Default: 2 GiB. Reduce if RAM is limited.",
      "required": false,
      "mask": false
    },
    {
      "name": "Listen Host",
      "key": "APPFLOWY_SEARCH_HOST",
      "value": "::",
      "description": "IP address the search service listens on. :: = all interfaces.",
      "required": false,
      "mask": false
    },
    {
      "name": "Listen Port",
      "key": "APPFLOWY_SEARCH_PORT",
      "value": "4002",
      "description": "Port the search service listens on (internal).",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "RUST_LOG",
      "value": "info",
      "description": "Rust log level.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
