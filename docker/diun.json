{
  "name": "diun",
  "repo": "crazymax/diun:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/crazymax/diun/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://crazymax.dev/diun/assets/logo.png",
  "project": "https://crazymax.dev/diun/",
  "description": "Docker Image Update Notifier is a CLI application written in Go and delivered as a Docker image to receive notifications when a Docker image is updated on a Docker registry.",
  "paths": [
    {
      "name": "DIUN_DB_PATH",
      "host": "/mnt/cache/appdata/diun/data",
      "container": "/data",
      "mode": "rw",
      "description": "Contains bbolt database which retains Docker images manifests",
      "required": false
    },
    {
      "name": "DIUN_DOCKER_SOCKET",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Note: Remove if you are using a proxy",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/Edmonton",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DIUN_PROVIDERS_DOCKER_WATCHBYDEFAULT",
      "key": "DIUN_PROVIDERS_DOCKER_WATCHBYDEFAULT",
      "value": "false",
      "description": "Optional: Set to true to watch all containers",
      "required": false,
      "mask": false
    },
    {
      "name": "DIUN_PROVIDERS_DOCKER_WATCHSTOPPED",
      "key": "DIUN_PROVIDERS_DOCKER_WATCHSTOPPED",
      "value": "false",
      "description": "Optional: Set to true to watch stopped containers",
      "required": false,
      "mask": false
    },
    {
      "name": "DIUN_PROVIDERS_DOCKER_ENDPOINT",
      "key": "DIUN_PROVIDERS_DOCKER_ENDPOINT",
      "value": "",
      "description": "Note: Set to `tcp://dockersocket:2375` if you are using a proxy",
      "required": false,
      "mask": false
    },
    {
      "name": "DIUN_WATCH_WORKERS",
      "key": "DIUN_WATCH_WORKERS",
      "value": "20",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DIUN_WATCH_SCHEDULE",
      "key": "DIUN_WATCH_SCHEDULE",
      "value": "0 */6 * * *",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DIUN_WATCH_JITTER",
      "key": "DIUN_WATCH_JITTER",
      "value": "30s",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DIUN_PROVIDERS_DOCKER",
      "key": "DIUN_PROVIDERS_DOCKER",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_LEVEL",
      "key": "LOG_LEVEL",
      "value": "info",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_JSON",
      "key": "LOG_JSON",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
