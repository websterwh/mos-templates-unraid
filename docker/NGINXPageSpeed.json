{
  "name": "NGINXPageSpeed",
  "repo": "ghcr.io/siwatinc/nginx-pagespeed",
  "category": [
    "Network"
  ],
  "registry": "https://ghcr.io/siwatinc/nginx-pagespeed",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/SiwatINC/unraid-ca-repository/master/icons/pagespeed_32dp.png",
  "project": null,
  "description": "NGINX OpenSource Build with PageSpeed, The PageSpeed modules are open-source server modules that optimize your site automatically.",
  "paths": [
    {
      "name": "Configuration Folder",
      "host": "/mnt/cache/appdata/nginx-pagespeed",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "81",
      "container": "80",
      "protocol": "tcp",
      "description": "Port for the HTTP Protocol",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "444",
      "container": "443",
      "protocol": "tcp",
      "description": "Port for the HTTPS Protocol (Not enabled by default)",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
