{
  "name": "Valheim-Kartograph",
  "repo": "ghcr.io/auchotter/valheim-kartograph:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/auchotter/valheim-kartograph/pkgs/container/valheim-kartograph",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/auchotter/valheim-kartograph/main/client/src/assets/ui/compass-rose.png",
  "project": "https://github.com/auchotter/valheim-kartograph",
  "description": "Valheim Kartograph is a self-hosted collaborative mapping tool for Valheim. Draw biomes, paths, markers and notes on a shared no-map world, with realtime updates across multiple devices.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/valheim-kartograph",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent SQLite database and application data.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "2998",
      "container": "3000",
      "protocol": "tcp",
      "description": "HTTP port for the Valheim Kartograph web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
