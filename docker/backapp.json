{
  "name": "backapp",
  "repo": "ghcr.io/dennis960/backapp:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://github.com/dennis960/backapp",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/tajniak81/unraid-docker-templates/refs/heads/main/backapp/icon/backapp.png",
  "project": "https://github.com/Dennis960/BackApp",
  "description": "BackApp is a Go + React application that lets automatically schedule and inspect backups of remote servers via SSH. It is a very lightweight server that runs locally (or on a dedicated machine) and provides a web interface to manage backup profiles. https://github.com/Dennis960/BackApp",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/backapp/app-data",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent application data",
      "required": true
    },
    {
      "name": "Backups (App)",
      "host": "/mnt/cache/appdata/backapp/backups/app",
      "container": "/var/backups/app",
      "mode": "rw",
      "description": "App backups",
      "required": true
    },
    {
      "name": "Backups (Archive)",
      "host": "/mnt/cache/appdata/backapp/backups/archive",
      "container": "/var/backups/archive",
      "mode": "rw",
      "description": "Archive backups",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "BackApp WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
