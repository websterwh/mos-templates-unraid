{
  "name": "Scraparr",
  "repo": "ghcr.io/thecfu/scraparr:latest",
  "category": [
    "System"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7100]/metrics",
  "icon": "https://raw.githubusercontent.com/jordan-dalby/unraidtemplates/refs/heads/main/images/scraparr.png",
  "project": "https://github.com/thecfu/scraparr",
  "description": "Scraparr is a Prometheus exporter for the *arr suite (Sonarr, Radarr, Lidarr, etc.), providing metrics that can be scraped by Prometheus to monitor and visualize the health and performance of your *arr applications.",
  "paths": [
    {
      "name": "CONFIG_PATH",
      "host": "/mnt/cache/appdata/scraparr/config/",
      "container": "/scraparr/config/",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEB_UI",
      "host": "7100",
      "container": "7100",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
