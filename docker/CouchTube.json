{
  "name": "CouchTube",
  "repo": "ghcr.io/ozencb/couchtube:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/ozencb/couchtube",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8363]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/couchtube-icon.png",
  "project": "https://couchtube.fly.dev/",
  "description": "A self-hosted, YouTube based application that recreates the feel of a TV channel. CouchTube schedules YouTube video playback dynamically from user-defined channel lists. Customize, share, and submit JSON-based playlists to make CouchTube your own!",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8363",
      "container": "8363",
      "protocol": "tcp",
      "description": "Container Port: 8363",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Read-only Mode",
      "key": "READONLY_MODE",
      "value": "false|true",
      "description": "Enable read-only mode (prevent playlist changes)",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Web UI Port",
      "key": "PORT",
      "value": "8363",
      "description": "Internal Web UI Port",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
