{
  "name": "SeekAndWatch",
  "repo": "ghcr.io/softerfish/seekandwatch:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/softerfish/seekandwatch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/softerfish/seekandwatch/main/icon.png",
  "project": "https://github.com/softerfish/seekandwatch",
  "description": "The ultimate self-hosted Plex companion. Now featuring SeekAndWatch Cloud: allow your users to request content easily without VPNs or reverse proxies. Includes Smart Discovery (recommendations based on history & taste), direct Radarr/Sonarr integration, a no-code Kometa config builder, automated Plex collections, and Tautulli trending. One dashboard: less scrolling, more watching.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/seekandwatch",
      "container": "/config",
      "mode": "rw",
      "description": "Stores the database and settings",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "The Web UI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "UTC",
      "description": "Container Timezone (e.g. America/New_York)",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Group ID",
      "required": false,
      "mask": false
    },
    {
      "name": "Unraid App Store",
      "key": "SEEKANDWATCH_UNRAID",
      "value": "1",
      "description": "Set to 1 so the app shows Update via App Store and disables the in-app one-click updater. Leave as 1 when installed from Community Applications.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
