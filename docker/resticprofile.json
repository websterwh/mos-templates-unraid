{
  "name": "resticprofile",
  "repo": "alexycodes/resticprofile",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/alexycodes/resticprofile",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://creativeprojects.github.io/resticprofile/images/logo.png",
  "project": "https://github.com/creativeprojects/resticprofile",
  "description": "A configuration profiles manager for restic backup, resticprofile is the missing link between a configuration file and restic backup. This image is built for long-lived containers with database and backup utilities. It overrides the official image's entrypoint and command to execute crond on start, so containers run indefinitely and can be used to schedule tasks.",
  "paths": [
    {
      "name": "Data to backup",
      "host": "/mnt/user",
      "container": "/mnt/user",
      "mode": "ro",
      "description": null,
      "required": false
    },
    {
      "name": "Profiles",
      "host": "/mnt/cache/appdata/resticprofile/profiles",
      "container": "/resticprofile",
      "mode": "ro",
      "description": "Configuration files for resticprofile.",
      "required": false
    },
    {
      "name": "Pass files",
      "host": "/mnt/cache/appdata/resticprofile/pass",
      "container": "/pass",
      "mode": "ro",
      "description": "Pass files for restic.",
      "required": false
    },
    {
      "name": "Crontab",
      "host": "/mnt/cache/appdata/resticprofile/crontab",
      "container": "/crontab",
      "mode": "ro",
      "description": "An optional file that can be used to set up scheduled tasks on start.",
      "required": false
    },
    {
      "name": "Cache",
      "host": "",
      "container": "/root/.cache",
      "mode": "rw",
      "description": "Where to persist restic's cache outside of the container.",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
