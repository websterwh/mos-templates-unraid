{
  "name": "nvidia-smi-exporter",
  "repo": "ccmpbll/nvidia-smi-exporter",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/ccmpbll/nvidia-smi-exporter/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9202]/metrics",
  "icon": "https://raw.githubusercontent.com/ccmpbll/unraid-docker-templates/main/images/prom-nvidia.png",
  "project": "https://github.com/ccmpbll/nvidia-smi-exporter",
  "description": "Prometheus exporter for NVIDIA GPU metrics via nvidia-smi. Compatible with all architectures on driver 595+. Metrics will be available here: \"http://Unraid_IP_HERE:9202/metrics\". Requires Nvidia-Driver plugin to be installed.",
  "paths": [],
  "ports": [
    {
      "name": "EXPORTER_PORT",
      "host": "9202",
      "container": "9202",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
