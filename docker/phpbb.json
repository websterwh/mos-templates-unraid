{
  "name": "phpbb",
  "repo": "bitnami/phpbb:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/bitnami/phpbb/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/phpbb.png",
  "project": "https://www.phpbb.com/",
  "description": "phpBB is a bulletin board solution that allows you to create forums and subforums.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/phpbb/",
      "container": "/bitnami/phpbb",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ALLOW_EMPTY_PASSWORD",
      "key": "ALLOW_EMPTY_PASSWORD",
      "value": "no",
      "description": "ALLOW_EMPTY_PASSWORD",
      "required": true,
      "mask": false
    },
    {
      "name": "PHPBB_DATABASE_HOST",
      "key": "PHPBB_DATABASE_HOST",
      "value": "mariadb",
      "description": "Hostname or IP for MariaDB server.",
      "required": false,
      "mask": false
    },
    {
      "name": "PHPBB_DATABASE_PORT_NUMBER",
      "key": "PHPBB_DATABASE_PORT_NUMBER",
      "value": "3306",
      "description": "Port used by MariaDB server.",
      "required": false,
      "mask": false
    },
    {
      "name": "PHPBB_DATABASE_USER",
      "key": "PHPBB_DATABASE_USER",
      "value": "bn_phpbb",
      "description": "Database user that phpBB will use to connect with the database.",
      "required": true,
      "mask": false
    },
    {
      "name": "PHPBB_DATABASE_PASSWORD",
      "key": "PHPBB_DATABASE_PASSWORD",
      "value": "password",
      "description": "Database password that Phpbb will use to connect with the database",
      "required": true,
      "mask": false
    },
    {
      "name": "PHPBB_DATABASE_NAME",
      "key": "PHPBB_DATABASE_NAME",
      "value": "bitnami_phpbb",
      "description": "Database name that phpBB will use to connect with the database",
      "required": true,
      "mask": false
    },
    {
      "name": "PHPBB_USERNAME",
      "key": "PHPBB_USERNAME",
      "value": "user",
      "description": "phpBB application username.",
      "required": false,
      "mask": false
    },
    {
      "name": "PHPBB_PASSWORD",
      "key": "PHPBB_PASSWORD",
      "value": "bitnami",
      "description": "phpBB application password.",
      "required": false,
      "mask": false
    },
    {
      "name": "PHPBB_EMAIL",
      "key": "PHPBB_EMAIL",
      "value": "user@example.com",
      "description": "phpBB application email.",
      "required": false,
      "mask": false
    },
    {
      "name": "PHPBB_FORUM_NAME",
      "key": "PHPBB_FORUM_NAME",
      "value": "Phpbb",
      "description": "Forum Name",
      "required": false,
      "mask": false
    },
    {
      "name": "PHPBB_FORUM_DESCRIPTION",
      "key": "PHPBB_FORUM_DESCRIPTION",
      "value": "A little text to describe your forum",
      "description": "Forum Description",
      "required": false,
      "mask": false
    },
    {
      "name": "PHP_MEMORY_LIMIT",
      "key": "PHP_MEMORY_LIMIT",
      "value": "256M",
      "description": "Memory limit for PHP.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
