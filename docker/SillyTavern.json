{
  "name": "SillyTavern",
  "repo": "ghcr.io/sillytavern/sillytavern:staging",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/sillytavern/sillytavern",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://avatars.githubusercontent.com/u/134869877?s=200&v=4",
  "project": "https://github.com/SillyTavern",
  "description": "Anything but localhost is blocked by default To allow more than one connection other than locahost: 1. rightclick on SillyTavern and open console (not Unraid console) 2. type vi ./config/config.yaml to edit the config file 3. press insert and add your IP to the whitelist 4. press esc then type :wq 5. restart the container",
  "paths": [
    {
      "name": "Config:",
      "host": "/mnt/cache/appdata/STConfig/Config",
      "container": "/home/node/app/config",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Plugins:",
      "host": "/mnt/cache/appdata/STConfig/Plugins",
      "container": "/plugins",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Data:",
      "host": "/mnt/cache/appdata/STConfig/Data",
      "container": "/home/node/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "port",
      "host": "7598",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
