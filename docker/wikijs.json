{
  "name": "wikijs",
  "repo": "lscr.io/linuxserver/wikijs",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/wikijs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/wikijs-logo.png",
  "project": "https://github.com/Requarks/wiki",
  "description": "Wikijs(https://github.com/Requarks/wiki) A modern, lightweight and powerful wiki app built on NodeJS.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    },
    {
      "name": "Path: /data",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Where Wiki.js data is stored.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Port for Wiki.js's web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_TYPE",
      "key": "DB_TYPE",
      "value": "sqlite",
      "description": "Set to sqlite (default) or postgres depending on the database engine you wish to use",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "DB hostname (postgres only)",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "",
      "description": "DB port (postgres only)",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "",
      "description": "DB name (postgres only)",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "",
      "description": "DB username (postgres only)",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PASS",
      "key": "DB_PASS",
      "value": "",
      "description": "DB password (postgres only)",
      "required": false,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
