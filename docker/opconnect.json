{
  "name": "op-connect",
  "repo": "1password/connect-api:latest",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/1password/connect-api",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8099]",
  "icon": "https://github.com/undead-reaper/unraid-templates/blob/master/op-connect/op-connect.png?raw=true",
  "project": "https://github.com/1Password/connect",
  "description": "The 1Password Connect server serves the Connect server REST API.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/connect/data",
      "container": "/home/opuser/.op/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Credentials",
      "host": "/mnt/cache/connect/config/1password-credentials.json",
      "container": "/home/opuser/.op/1password-credentials.json",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8099",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
