{
  "name": "prysm-beacon-ethereum",
  "repo": "prysmaticlabs/prysm-beacon-chain",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/prysmaticlabs/prysm-beacon-chain",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--datadir=/data  --rpc-host=0.0.0.0 --grpc-gateway-host=0.0.0.0 --monitoring-host=0.0.0.0 --execution-endpoint=http://geth-ethereum:8551 --jwt-secret=/data/jwt.hex --accept-terms-of-use",
  "web_ui_url": "http://[IP]:[PORT:3500]",
  "icon": "https://prysmaticlabs.com/assets/Prysm.svg",
  "project": "https://docs.prylabs.network/docs/how-prysm-works/beacon-node",
  "description": "Ethereum 2.0 Beacon Chain implementation by Prysmatic Labs.",
  "paths": [
    {
      "name": "data-path",
      "host": "/mnt/cache/blockchain/prysm/",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent data directory for blockchain files, keys",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "JSON-RPC HTTP",
      "host": "3500",
      "container": "3500",
      "protocol": "tcp",
      "description": "JSON-RP beacon node's Query API.",
      "required": true,
      "mask": false
    },
    {
      "name": "Web-Sockets server",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": "Validator uses this port to connect to your beacon node via gRPC.",
      "required": true,
      "mask": false
    },
    {
      "name": "listener",
      "host": "13000",
      "container": "13000",
      "protocol": "tcp",
      "description": "listener (TCP) port",
      "required": true,
      "mask": false
    },
    {
      "name": "discovery",
      "host": "12000",
      "container": "12000",
      "protocol": "udp",
      "description": "discovery (UDP) port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
