{
  "name": "nut-influxdb-exporter",
  "repo": "maihai/nut-influxdb-exporter",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/maihai/nut-influxdb-exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/kiwimato/nut-influxdb-exporter/master/assets/nut.png",
  "project": "https://github.com/kiwimato/nut-influxdb-exporter",
  "description": "WARNING: Deprecated in favor of Telegraf which now supports NUT or https://github.com/jwillmer/nut-influxdbv2 Docker wrapper for a Python script to query NUT - Network UPS Tools via a Python script and then send the results to InfluxDB for storage.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "HOSTNAME",
      "key": "HOSTNAME",
      "value": "unraid-ups",
      "description": "host you want the measurements to show up as in InfluxDB",
      "required": true,
      "mask": false
    },
    {
      "name": "WATTS",
      "key": "WATTS",
      "value": "1500",
      "description": "If your UPS doesn't have the nominal power metric then specify the rated watts so that the load percentage can be used to calculate the current watts",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_HOST",
      "key": "INFLUXDB_HOST",
      "value": "127.0.0.1",
      "description": "IP address of influxdb",
      "required": true,
      "mask": false
    },
    {
      "name": "INFLUXDB_PORT",
      "key": "INFLUXDB_PORT",
      "value": "8086",
      "description": "Container Variable: INFLUXDB_PORT",
      "required": true,
      "mask": false
    },
    {
      "name": "INFLUXDB_DATABASE",
      "key": "INFLUXDB_DATABASE",
      "value": "nut",
      "description": "InfluxDB database name to store the values",
      "required": true,
      "mask": false
    },
    {
      "name": "INFLUXDB_USER",
      "key": "INFLUXDB_USER",
      "value": "",
      "description": "User name for Influxdb",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_PASSWORD",
      "key": "INFLUXDB_PASSWORD",
      "value": "",
      "description": "Password for Influxdb",
      "required": false,
      "mask": false
    },
    {
      "name": "NUT_HOST",
      "key": "NUT_HOST",
      "value": "127.0.0.1",
      "description": "NUT hostname",
      "required": true,
      "mask": false
    },
    {
      "name": "NUT_PORT",
      "key": "NUT_PORT",
      "value": "",
      "description": "NUT Port",
      "required": false,
      "mask": false
    },
    {
      "name": "UPS_NAME",
      "key": "UPS_NAME",
      "value": "ups",
      "description": "NUT UPS name",
      "required": false,
      "mask": false
    },
    {
      "name": "NUT_USERNAME",
      "key": "NUT_USERNAME",
      "value": "",
      "description": "Username for NUT",
      "required": false,
      "mask": false
    },
    {
      "name": "NUT_PASSWORD",
      "key": "NUT_PASSWORD",
      "value": "",
      "description": "Password for NUT",
      "required": false,
      "mask": false
    },
    {
      "name": "Debugging Output",
      "key": "VERBOSE",
      "value": "false",
      "description": "Set this variable to true to see the output in the docker log.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
