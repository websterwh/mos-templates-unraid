{
  "name": "daps-ui",
  "repo": "monster117/daps-ui:develop",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/monster117/daps-ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/Drazzilb08/daps/refs/heads/master/daps_logo.png",
  "project": "https://github.com/zarskie/daps-ui",
  "description": "A UI for DAPS (Drazzilb's Arr PMM Scripts)",
  "paths": [
    {
      "name": "Posters Path",
      "host": "",
      "container": "/posters",
      "mode": "rw",
      "description": "Path to posters",
      "required": false
    },
    {
      "name": "Kometa Assets Path",
      "host": "",
      "container": "/assets",
      "mode": "rw",
      "description": "Path to Kometa assets",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/daps-ui/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "App Mode",
      "key": "APP_MODE",
      "value": "web",
      "description": "App mode. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
