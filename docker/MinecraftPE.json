{
  "name": "MinecraftPE",
  "repo": "ixilon/nukkit",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/ixilon/nukkit/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "-ti",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:19132]",
  "icon": "https://i.imgur.com/zn0eOhH.png",
  "project": null,
  "description": "Nukkit is a Nuclear-Powered Server Software For Minecraft Pocket Edition VERY IMPORTANT: First run use Screen on Uraid docker exec -ti MinecraftPE /bin/bash Run command : java -jar /nukkit-1.0-SNAPSHOT.jar select language after the first run everything should work fine To Interact with Server / adminstration, use \"docker attach MinecraftPE\" at command promt Press ctrl-p-ctrl-q to exit without shutting down the server",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/minecraftpe",
      "container": "/srv/nukkit/",
      "mode": "rw",
      "description": "Container Path: /srv/nukkit/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "19132",
      "container": "19132",
      "protocol": "udp",
      "description": "Container Port: 19132",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Language",
      "key": "LANGUAGE",
      "value": "en_US.UTF-8",
      "description": "Container Variable: LANGUAGE",
      "required": true,
      "mask": false
    },
    {
      "name": "LC_ALL",
      "key": "LC_ALL",
      "value": "en_US.UTF-8",
      "description": "Container Variable: LC_ALL",
      "required": true,
      "mask": false
    },
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "America/Denver",
      "description": "Container Variable: TZ",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
