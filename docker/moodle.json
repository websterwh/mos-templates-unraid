{
  "name": "moodle",
  "repo": "bitnami/moodle:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/bitnami/moodle/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/moodle.png",
  "project": "https://moodle.org",
  "description": "Moodle is a very popular open source learning management solution (LMS) for the delivery of elearning courses and programs.",
  "paths": [
    {
      "name": "MoodlePath",
      "host": "/mnt/cache/appdata/moodle/",
      "container": "/bitnami/moodle",
      "mode": "rw",
      "description": "MoodlePath",
      "required": true
    },
    {
      "name": "Moodledata",
      "host": "/mnt/cache/appdata/moodle/data/",
      "container": "/bitnami/moodledata",
      "mode": "rw",
      "description": "Moodledata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "HTTP",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPs",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "HTTPs (Not needed if you use reverse proxy)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MariaDB Hostname or IP",
      "key": "MOODLE_DATABASE_HOST",
      "value": "mariadb",
      "description": "MariaDB Hostname or IP",
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB Database Port",
      "key": "MOODLE_DATABASE_PORT_NUMBER",
      "value": "3306",
      "description": "MariaDB Database Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "MOODLE_DATABASE_NAME",
      "value": "bitnami_moodle",
      "description": "Database Name",
      "required": true,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "MOODLE_DATABASE_USER",
      "value": "bn_moodle",
      "description": "Database User",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "MOODLE_DATABASE_PASSWORD",
      "value": "",
      "description": "Database Password",
      "required": true,
      "mask": false
    },
    {
      "name": "Moodle Username",
      "key": "MOODLE_USERNAME",
      "value": "user",
      "description": "Default Moodle Username",
      "required": false,
      "mask": false
    },
    {
      "name": "Moodle Password",
      "key": "MOODLE_PASSWORD",
      "value": "bitnami",
      "description": "Default Moodle Password",
      "required": false,
      "mask": false
    },
    {
      "name": "PHP_MEMORY_LIMIT",
      "key": "PHP_MEMORY_LIMIT",
      "value": "256M",
      "description": "PHP_MEMORY_LIMIT",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP_HOST",
      "key": "SMTP_HOST",
      "value": "",
      "description": "SMTP host",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP_PORT",
      "key": "SMTP_PORT",
      "value": "",
      "description": "SMTP port",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP_USER",
      "key": "SMTP_USER",
      "value": "",
      "description": "SMTP account user",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP_PASSWORD",
      "key": "SMTP_PASSWORD",
      "value": "",
      "description": "SMTP account password",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP_PROTOCOL",
      "key": "SMTP_PROTOCOL",
      "value": "",
      "description": "SMTP protocol",
      "required": false,
      "mask": false
    },
    {
      "name": "ALLOW_EMPTY_PASSWORD",
      "key": "ALLOW_EMPTY_PASSWORD",
      "value": "no",
      "description": "It can be used to allow blank passwords.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
