{
  "name": "Sportarr",
  "repo": "sportarr/sportarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/sportarr/sportarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1867]",
