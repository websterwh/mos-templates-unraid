{
  "name": "Portainer-Agent",
  "repo": "portainer/agent:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/portainer/agent/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9001]",
  "icon": "https://raw.githubusercontent.com/EMP83/unraid-templates/main/PortainerCE/Portainer.png",
  "project": "https://portainer.io",
  "description": "Portainer consists of two elements, the Portainer Server, and the Portainer Agent. Both elements run as lightweight Docker containers on a Docker engine. Portainer uses the Portainer Agent container to communicate with the Portainer Server instance and provide access to the node's resources.",
  "paths": [
    {
      "name": "Portainer Storage Path",
      "host": "/mnt/cache/appdata/portainer",
      "container": "/var/lib/docker/volumes",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "This is needed for Portainer to connect to Docker.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Agent Port",
      "host": "9001",
      "container": "9001",
      "protocol": "tcp",
      "description": "Portainer Agent Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
