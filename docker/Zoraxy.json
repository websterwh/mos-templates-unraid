{
  "name": "Zoraxy",
  "repo": "zoraxydocker/zoraxy",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/zoraxydocker/zoraxy/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/PlazzmiK/unraid_templates/main/images/zoraxy.png",
  "project": "https://zoraxy.aroz.org/",
  "description": "Beyond Reverse Proxy: Your Ultimate Homelab Network Tool - Reverse Proxy - Redirection - Geo-IP & Blacklist - Global Area Network - Web SSH - Real Time Statistics - Scanner & Utilities - Open Source General purpose (reverse) proxy and forwarding tool for networking noobs. Website: https://zoraxy.aroz.org/ Source: https://github.com/tobychui/zoraxy Docker: https://hub.docker.com/r/zoraxydocker/zoraxy/",
  "paths": [
    {
      "name": "Container Path 1",
      "host": "/mnt/cache/appdata/zoraxy",
      "container": "/opt/zoraxy/config",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Docker SOCKET",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Docker SOCKET for 'Pick from container' feature",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP (tcp)",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP (udp)",
      "host": "80",
      "container": "80",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS (tcp)",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS (udp)",
      "host": "443",
      "container": "443",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Web UI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
