{
  "name": "FGC-Remaster",
  "repo": "ghcr.io/p-adamiec/free-games-claimer-remaster:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/P-Adamiec/Free-Games-Claimer-Remaster/pkgs/container/free-games-claimer-remaster",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1g --memory=2048m",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7080]/",
  "icon": "https://raw.githubusercontent.com/P-Adamiec/Free-Games-Claimer-Remaster/main/logo.png",
  "project": "https://github.com/P-Adamiec/Free-Games-Claimer-Remaster",
  "description": "Remaster Python de free-games-claimer. Claim automatique des jeux gratuits (Epic, Prime Gaming, GOG, Steam, Ubisoft, AliExpress). Scheduler int\u00e9gr\u00e9, login initial via noVNC (port 7080), notifications Discord/Apprise.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/fgc-remaster",
      "container": "/fgc/data",
      "mode": "rw",
      "description": "DB SQLite, profils Chrome par store, screenshots",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "noVNC Web UI",
      "host": "7080",
      "container": "7080",
      "protocol": "tcp",
      "description": "Port noVNC pour le login initial via navigateur",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Zurich",
      "description": "Timezone du conteneur",
      "required": false,
      "mask": false
    },
    {
      "name": "STORES",
      "key": "STORES",
      "value": "",
      "description": "Stores \u00e0 activer, s\u00e9par\u00e9s par virgules (vide = tous)",
      "required": false,
      "mask": false
    },
    {
      "name": "VNC_IP",
      "key": "VNC_IP",
      "value": "localhost",
      "description": "H\u00f4te utilis\u00e9 dans les liens de notification (IP Unraid ou IP Tailscale)",
      "required": false,
      "mask": false
    },
    {
      "name": "VNC_PASSWORD",
      "key": "VNC_PASSWORD",
      "value": "",
      "description": "Mot de passe VNC",
      "required": false,
      "mask": true
    },
    {
      "name": "SHOW",
      "key": "SHOW",
      "value": "1",
      "description": "Affiche le navigateur via VNC (1/0)",
      "required": false,
      "mask": false
    },
    {
      "name": "SCHEDULER_HOURS",
      "key": "SCHEDULER_HOURS",
      "value": "12",
      "description": "Intervalle en heures entre deux runs",
      "required": false,
      "mask": false
