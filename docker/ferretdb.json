{
  "name": "ferretdb",
  "repo": "ghcr.io/ferretdb/ferretdb:2",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/FerretDB/FerretDB",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:27017]",
  "icon": "https://raw.githubusercontent.com/llalon/unraid-templates/main/llalon/images/ferretdb.png",
  "project": "https://github.com/FerretDB/FerretDB",
  "description": "FerretDB is an open-source alternative to MongoDB. It is a proxy that converts MongoDB 5.0+ wire protocol queries to SQL and uses PostgreSQL with DocumentDB extension as a database engine.",
  "paths": [],
  "ports": [
    {
      "name": "FerretDB Port",
      "host": "27017",
      "container": "27017",
      "protocol": "tcp",
      "description": "Port for FerretDB",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Postgresql Database URL",
      "key": "FERRETDB_POSTGRESQL_URL",
      "value": "postgres://ferretdb:password@127.0.0.1:5432/ferretdb",
      "description": "Full URL for the postgresql database",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
