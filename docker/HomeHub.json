{
  "name": "HomeHub",
  "repo": "ghcr.io/surajverma/homehub:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/surajverma/homehub/pkgs/container/homehub",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/Skylinar/unraid_templates/refs/heads/main/images/homehub.png?raw=true",
  "project": "https://github.com/surajverma/homehub",
  "description": "Ever wanted a simple, private spot on your home network for your family's daily stuff? That's HomeHub. It's a lightweight, self-hosted web app that turns any computer (even a Raspberry Pi!) into a central hub for shared notes, shopping lists, chores, a media downloader, and even a family expense tracker. It\u2019s designed to be easy to use for everyone in the family, with a clean interface that works great on any device. Before Installing: 1. create the appdata folder 'mkdir /mnt/user/appdata/homehub' 2. grab the example configuration yml 'curl https://raw.githubusercontent.com/surajverma/homehub/main/config-example.yml -o /mnt/user/appdata/homehub/config.yml' 3. adjust the config as needed",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/homehub/config.yml",
      "container": "/app/config.yml",
      "mode": "ro",
      "description": "Grab the example configuration yml 'curl https://raw.githubusercontent.com/surajverma/homehub/main/config-example.yml -o /mnt/user/appdata/homehub/config.yml'",
      "required": true
    },
    {
      "name": "Uploads",
      "host": "/mnt/cache/appdata/homehub/uploads",
      "container": "/app/uploads",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Media",
      "host": "/mnt/cache/appdata/homehub/media",
      "container": "/app/media",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "PDF's",
      "host": "/mnt/cache/appdata/homehub/pdfs",
      "container": "/app/pdfs",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/homehub/data",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Secret key. Run `openssl rand -hex 64` to generate a secret",
      "required": true,
      "mask": true
    },
    {
      "name": "FLASK_ENV",
      "key": "FLASK_ENV",
      "value": "production",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
