{
  "name": "Channels-DVR",
  "repo": "fancybits/channels-dvr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/fancybits/channels-dvr",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8089]",
  "icon": "https://getchannels.com/assets/img/avatar-120.png",
  "project": "https://getchannels.com/dvr",
  "description": "The Channels DVR server",
  "paths": [
    {
      "name": "DVR Storage",
      "host": "",
      "container": "/shares/DVR",
      "mode": "rw",
      "description": "Path to DVR recordings storage",
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/channels-dvr",
      "container": "/channels-dvr",
      "mode": "rw",
      "description": "Path to config storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8089",
      "container": "8089",
      "protocol": "tcp",
      "description": "Container Port: 8089",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
