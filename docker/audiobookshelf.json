{
  "name": "audiobookshelf",
  "repo": "ghcr.io/advplyr/audiobookshelf",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/advplyr/audiobookshelf/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/advplyr/audiobookshelf/raw/master/client/static/Logo.png",
  "project": "https://github.com/advplyr/audiobookshelf",
  "description": "Self-hosted audiobook and podcast server and web app. Supports multi-user w/ permissions and keeps progress in sync across devices. Free & open source mobile apps. Consider contributing by posting feedback, suggestions, feature requests on github or the forums.",
  "paths": [
    {
      "name": "Audiobooks",
      "host": "",
      "container": "/audiobooks",
      "mode": "rw",
      "description": "Container Path: /audiobooks",
      "required": true
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/audiobookshelf/config/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    },
    {
      "name": "Metadata",
      "host": "/mnt/cache/appdata/audiobookshelf/metadata/",
      "container": "/metadata",
      "mode": "rw",
      "description": "Container Path: /metadata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "13378",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
