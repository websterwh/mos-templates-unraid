{
  "name": "DumbAssets",
  "repo": "dumbwareio/dumbassets:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dumbwareio/dumbassets",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/dumbassets-logo.png",
  "project": "https://github.com/DumbWareio/DumbAssets",
  "description": "A stupid simple asset tracker for keeping track of your physical assets, their components, and applicable warranties and routine maintenance.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dumbassets",
      "container": "/app/data",
      "mode": "rw",
      "description": "Data Dir",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port on which the application will run.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PIN",
      "key": "DUMBASSETS_PIN",
      "value": "12345",
      "description": "PIN protection",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
