{
  "name": "syncthing-notification",
  "repo": "waazaafr/syncthing-inactivity-notification:latest",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/waazaafr/syncthing-inactivity-notification",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/waazaa-fr/unraid-templates/refs/heads/main/syncthing-inactivity-monitor.png",
  "project": "https://hub.docker.com/r/waazaafr/syncthing-inactivity-notification",
  "description": "The application polls the Syncthing REST API at regular intervals (default: every 15 minutes) to detect the last modification time of each monitored folder. If a folder has not been modified for longer than a configurable threshold, a notification is sent at the scheduled time. Supported notification channels: - Email (SMTP with STARTTLS or SSL) - Gotify (self-hosted push notifications) - Discord (webhook",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/syncthing-inactivity-notification/",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent folder",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "PORT",
      "host": "8182",
      "container": "8080",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "df53a8dbf180df47ca9fdd4bd9a42bb9",
      "description": "A random SECRET_KEY. You can generate one using: openssl rand -hex 16",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
