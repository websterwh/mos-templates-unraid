{
  "name": "Rocket.Chat",
  "repo": "library/rocket.chat",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/library/rocket.chat/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/fanningert/unraid-docker-templates/master/fanningert/icons/rocketchat.png",
  "project": null,
  "description": "Rocket.Chat is a Web Chat Server, developed in JavaScript, using the Meteor fullstack framework. It is a great solution for communities and companies wanting to privately host their own chat service or for developers looking forward to build and evolve their own chat platforms.",
  "paths": [
    {
      "name": "Upload Directory Path",
      "host": "/mnt/cache/appdata/rocketchat",
      "container": "/app/uploads",
      "mode": "rw",
      "description": "Container Path: /app/uploads",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Frontend",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Mono DB",
      "key": "MONGO_URL",
      "value": "mongodb://mongo:27017/rocketchat",
      "description": "Container Variable: MONGO_URL",
      "required": true,
      "mask": false
    },
    {
      "name": "Rocket.Chat URL",
      "key": "ROOT_URL",
      "value": "http://localhost:3000",
      "description": "Container Variable: ROOT_URL",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
