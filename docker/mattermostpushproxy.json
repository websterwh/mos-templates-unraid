{
  "name": "mattermost-push-proxy",
  "repo": "mattermost/mattermost-push-proxy:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/mattermost/mattermost-push-proxy/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8066]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/mattermost-push-proxy.png",
  "project": "https://github.com/mattermost/mattermost-push-proxy",
  "description": "Mattermost Push Notification Service. after starting mkdir /mnt/user/appdata/mattermost-push-proxy/config cd /mnt/user/appdata/mattermost-push-proxy/config wget https://raw.githubusercontent.com/mattermost/mattermost-push-proxy/master/config/mattermost-push-proxy.json https://developers.mattermost.com/contribute/mobile/push-notifications/service/",
  "paths": [
    {
      "name": "Mattermost Push Proxy Path",
      "host": "/mnt/cache/appdata/mattermost-push-proxy/",
      "container": "/mattermost-push-proxy",
      "mode": "rw",
      "description": "Mattermost Push Proxy Path",
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/mattermost-push-proxy/config/",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": true
    },
    {
      "name": "Certs Path",
      "host": "/mnt/cache/appdata/mattermost-push-proxy/certs/",
      "container": "/certs",
      "mode": "rw",
      "description": "Certs Path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8066",
      "container": "8066",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
