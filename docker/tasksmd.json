{
  "name": "tasks.md",
  "repo": "baldissaramatheus/tasks.md",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/baldissaramatheus/tasks.md",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/tasks_md_logo.png",
  "project": "https://github.com/BaldissaraMatheus/Tasks.md",
  "description": "A self-hosted, Markdown file based task management board.",
  "paths": [
    {
      "name": "Config Dir",
      "host": "/mnt/cache/appdata/tasks-md/config",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Tasks Directory",
      "host": "/mnt/cache/appdata/tasks-md/tasks",
      "container": "/tasks",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
