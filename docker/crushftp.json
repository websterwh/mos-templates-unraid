{
  "name": "crushftp",
  "repo": "stuckless/crushftp",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/stuckless/crushftp/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9090]/",
  "icon": null,
  "project": null,
  "description": "CrushFTP is an extremely powerful, easy to use FTP solution.",
  "paths": [
    {
      "name": "CrushFTP Home",
      "host": "/mnt/cache/appdata/crushftp/",
      "container": "/var/opt/CrushFTP8_PC",
      "mode": "rw",
      "description": "CrushFTP Home/Installation Directory",
      "required": true
    },
    {
      "name": "FTP Files",
      "host": "/mnt/cache/ftpfiles/",
      "container": "/files",
      "mode": "rw",
      "description": "FTP Files",
      "required": true
    },
    {
      "name": "unRAID Share Path",
      "host": "/mnt/user",
      "container": "/unraid",
      "mode": "rw",
      "description": "Container Path: /unraid",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Crush HTTP Port",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "9443",
      "container": "9443",
      "protocol": "tcp",
      "description": "Crush HTTPS Port",
      "required": true,
      "mask": false
    },
    {
      "name": "FTP Port",
      "host": "9021",
      "container": "9021",
      "protocol": "tcp",
      "description": "Crush FTP Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Crush Admin Password",
      "key": "CRUSHPASSWORD",
      "value": "crush8password$",
      "description": "Default CrushFTP Admin Password",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
