{
  "name": "AndroidStudio",
  "repo": "jassycliq/android-studio-projector",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/repository/docker/jassycliq/android-studio-projector",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "bash -c ./run.sh",
  "web_ui_url": "http://[IP]:[PORT:8887]/?notSecureWarning=false",
  "icon": "https://raw.githubusercontent.com/JetBrains/projector-docker/master/static/projector-user/DemoProject/src/pj.png",
  "project": null,
  "description": "JetBrain's Projector running Android Studio without any windowing system",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/android-studio",
      "container": "/home/projector-user",
      "mode": "rw",
      "description": "Container Path: /home/projector-user",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8887",
      "container": "8887",
      "protocol": "tcp",
      "description": "Container Port: 8887",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Host Key 1",
      "key": "UMASK",
      "value": "000",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    },
    {
      "name": "Host Key 2",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "Host Key 3",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
