{
  "name": "hamal",
  "repo": "ghcr.io/i1k3r/hamal:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/i1k3r/HAMAL/pkgs/container/hamal",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--read-only --tmpfs /tmp --security-opt no-new-privileges:true",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7700]",
  "icon": "https://raw.githubusercontent.com/i1k3r/HAMAL/main/assets/hamal-icon.png",
  "project": "https://github.com/i1k3r/HAMAL",
  "description": "HAMAL \u2014 Point-to-point local file transfer. Fast, lightweight, private courier file sharing across local networks with QR code pairing, streaming multi-gigabyte transfers, optional PIN protection, background cleanup, and temporary Global Share links.",
  "paths": [
    {
      "name": "Appdata Storage",
      "host": "/mnt/cache/appdata/hamal",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent storage directory for SQLite database, uploaded files, and server secrets (must be owned/writable by UID:GID 10001:10001).",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "7700",
      "container": "7700",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Istanbul",
      "description": "Container timezone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
