{
  "name": "rustatio",
  "repo": "ghcr.io/takitsu21/rustatio",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/takitsu21/rustatio",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/takitsu21/rustatio/main/rustatio-desktop/icons/icon.png",
  "project": "https://github.com/takitsu21/rustatio",
  "description": "A modern BitTorrent ratio management tool built with Rust. Accurately simulate seeding by emulating uTorrent, qBittorrent, Transmission, or Deluge.",
  "paths": [
    {
      "name": "AppData / Data",
      "host": "/mnt/cache/appdata/rustatio",
      "container": "/data",
      "mode": "rw",
      "description": "Storage for data and configuration files.",
      "required": true
    },
    {
      "name": "Watch Folder Path",
      "host": "",
      "container": "/torrents",
      "mode": "rw",
      "description": "Optional folder for automatic torrent detection.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port for the web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Auth Token",
      "key": "AUTH_TOKEN",
      "value": "",
      "description": "Optional authentication token to secure access.",
      "required": false,
      "mask": true
    },
    {
      "name": "Auto Start Watch",
      "key": "WATCH_AUTO_START",
      "value": "false",
      "description": "Automatically start faking for new torrents detected in the watch folder.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Unraid User ID (default 99).",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Unraid Group ID (default 100).",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "RUST_LOG",
      "value": "info",
      "description": "Logging level (info, debug, error).",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
