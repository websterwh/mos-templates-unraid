{
  "name": "golang-kanban",
  "repo": "ghcr.io/nicolashaas/golang-kanban:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/NicolasHaas/golang-kanban",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:17808]",
  "icon": "https://github.com/NicolasHaas/unraid-xml-templates/blob/main/golang-kanban.jpg?raw=1",
  "project": "https://github.com/NicolasHaas/golang-kanban",
  "description": "No fancy features, it just works. Just a simple Kanban board made with Golang and HTMX, no nasty Node or Next.js",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "17808",
      "container": "17808",
      "protocol": "tcp",
      "description": "Container Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "kanban",
      "description": "Your database user",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PASS",
      "key": "DB_PASS",
      "value": "your_password_here",
      "description": "Password for your database user",
      "required": true,
      "mask": true
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "192.168.1.50",
      "description": "Your database host",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "5432",
      "description": "Your database port",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "kanban_db",
      "description": "Your database name",
      "required": true,
      "mask": false
    },
    {
      "name": "SERVER_PORT",
      "key": "SERVER_PORT",
      "value": "17808",
      "description": "Which port the app should listen on inside the container",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
