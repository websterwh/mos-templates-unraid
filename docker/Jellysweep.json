{
  "name": "Jellysweep",
  "repo": "ghcr.io/jon4hz/jellysweep:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/jon4hz/jellysweep/pkgs/container/jellysweep",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3002]",
  "icon": "https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/master/logos/jellysweep.png",
  "project": "https://github.com/jon4hz/jellysweep",
  "description": "Jellysweep is a smart cleanup tool for your Jellyfin media server.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/jellysweep",
      "container": "/app/data",
      "mode": "rw",
      "description": "Specify the path to the data directory.",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/jellysweep/config.yml",
      "container": "/app/config.yml",
      "mode": "ro",
      "description": "Specify the path to the config file.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3002",
      "container": "3002",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Dry Run",
      "key": "JELLYSWEEP_DRY_RUN",
      "value": "false",
      "description": "Enable dry run mode.",
      "required": false,
      "mask": false
    },
    {
      "name": "Listen Address",
      "key": "JELLYSWEEP_LISTEN",
      "value": "0.0.0.0:3002",
      "description": "Specify the address and port to listen on.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
