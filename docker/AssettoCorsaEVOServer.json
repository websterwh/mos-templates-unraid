{
  "name": "Assetto-Corsa-EVO-Server",
  "repo": "vaandal/acevo",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/vaandal/acevo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9700]",
  "icon": null,
  "project": null,
  "description": "Run Assetto Corsa EVO Dedicated Server in Docker using Wine. IMPORTANT: You must download server files via Steam (Tools \u2192 Assetto Corsa EVO Dedicated Server) and copy them into /config/server. Then paste your server config (Copy Command from launcher) into: /config/server_args.txt",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/assettocorsaevo",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "TCP Port",
      "host": "9700",
      "container": "9700",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UDP Port",
      "host": "9700",
      "container": "9700",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Args (optional)",
      "key": "SERVER_ARGS",
      "value": "",
      "description": "Optional if using server_args.txt file",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
