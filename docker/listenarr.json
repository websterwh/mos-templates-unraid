{
  "name": "listenarr",
  "repo": "ghcr.io/listenarrs/listenarr:canary",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/Listenarrs/Listenarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4545]",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/listenarr.png",
  "project": "https://github.com/Listenarrs/Listenarr",
  "description": "Listenarr is a fast, feature-rich, cross-platform audiobook management server. Built with a focus on being a complete solution for all your audiobook downloading needs. Set up your own server and get ready to streamline your audiobook listening!",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/listenarr",
      "container": "/app/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Audiobooks",
      "host": "",
      "container": "/audiobooks",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4545",
      "container": "4545",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
