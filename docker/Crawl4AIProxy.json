{
  "name": "Crawl4AIProxy",
  "repo": "zkkzkk32312/crawl4ai-proxy",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/zkkzkk32312/crawl4ai-proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8087]/",
  "icon": "https://raw.githubusercontent.com/zkkzkk32312/crawl4ai-proxy/main/icon.svg",
  "project": "https://github.com/zkkzkk32312/crawl4ai-proxy",
  "description": "Proxy bridging Open WebUI external web loader to Crawl4AI",
  "paths": [],
  "ports": [
    {
      "name": "Proxy Port",
      "host": "8087",
      "container": "8087",
      "protocol": "tcp",
      "description": "Host port for the proxy",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Crawl4AI URL",
      "key": "CRAWL4AI_URL",
      "value": "http://192.168.1.10:11235/md",
      "description": "Crawl4AI /md endpoint URL",
      "required": true,
      "mask": false
    },
    {
      "name": "Proxy API Key",
      "key": "PROXY_API_KEY",
      "value": "",
      "description": "API key for Open WebUI (leave empty to disable)",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
