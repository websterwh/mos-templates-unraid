{
  "name": "dbgate",
  "repo": "dbgate/dbgate",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/dbgate/dbgate",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/tquizzle/Docker-xml/master/img/dbgate.png",
  "project": "https://dbgate.org/",
  "description": "DbGate The Smartest SQL+noSQL Database Client Cross-database MySQL, PostgreSQL, MS SQL, Oracle, MongoDB, SQLite and others",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dbgate",
      "container": "/root/.dbgate",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Login",
      "key": "LOGIN",
      "value": "USERNAME",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": "PASSWORD",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
