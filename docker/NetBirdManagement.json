{
  "name": "NetBird-Management",
  "repo": "netbirdio/management",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/netbirdio/management/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--port 443 --log-file console --disable-anonymous-metrics=false --single-account-mode-domain=netbird.mydomain.net --dns-domain=netbird.selfhosted",
  "web_ui_url": "http://[IP]:[PORT:33073]",
  "icon": "https://raw.githubusercontent.com/dannymate/unraid-templates/master/icons/netbird-management-icon-256px.png",
  "project": "https://netbird.io",
  "description": "NetBird is an open-source VPN management platform built on top of WireGuard\u00ae making it easy to create secure private networks for your organization or home. The Management service is the central coordination component for NetBird. It keeps the network state, public Wireguard keys of the peers, authenticates and distributes network changes to peers. Look at the \"Additional Requirements\" for the other two parts of the server stack.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/netbird-server/management/management.json",
      "container": "/etc/netbird/management.json",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/netbird-server/management/data",
      "container": "/var/lib/netbird",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTPS",
      "host": "33073",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
