{
  "name": "Pterodactyl-Deamons",
  "repo": "ghcr.io/pterodactyl/wings:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://ghcr.io/pterodactyl/wings",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://avatars.githubusercontent.com/u/16179146?s=200&v=4",
  "project": "https://github.com/pterodactyl",
  "description": "Pterodactyl\u00ae is a free, open-source game server management panel built with PHP, React, and Go. Designed with security in mind, Pterodactyl runs all game servers in isolated Docker containers while exposing a beautiful and intuitive UI to end users. Stop settling for less. Make game servers a first class citizen on your platform. All the setups requiried is on the support area (Discord or Forum)",
  "paths": [
    {
      "name": "DeamonsLib",
      "host": "/mnt/cache/appdata/pterodactyldeamons/lib/",
      "container": "/mnt/user/appdata/pterodactyldeamons/lib/",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "DeamonsLogs",
      "host": "/mnt/cache/appdata/pterodactyldeamons/logs",
      "container": "/var/log/pterodactyl/",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "DeamonsEtc",
      "host": "/mnt/cache/appdata/pterodactyldeamons/etc",
      "container": "/etc/pterodactyl/",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "DeamonsLetsenscrypt",
      "host": "",
      "container": "/etc/letsencrypt/live/",
      "mode": "rw",
      "description": "Mount your SSL key. If nginx mount your config. if reverseproxy, mount the key.",
      "required": false
    },
    {
      "name": "DeamonsTmp",
      "host": "/tmp/pterodactyl",
      "container": "/tmp/pterodactyl/",
      "mode": "rw",
      "description": "The TMP directory for pterodactyl. DO NOT CHANGE THAT",
      "required": true
    },
    {
      "name": "DeamonsDockerLink",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "DO NOT CHANGE THAT !!!!",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "DeamonsPort",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "The port of the deamons.",
      "required": true,
      "mask": false
    },
    {
      "name": "DeamonsSFTPPort",
      "host": "2022",
      "container": "2022",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "WingsUID",
      "key": "WINGS_UID",
      "value": "988",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "WingsGID",
      "key": "WINGS_GID",
      "value": "988",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "WingsUsername",
      "key": "WINGS_USERNAME",
      "value": "pterodactyl",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
