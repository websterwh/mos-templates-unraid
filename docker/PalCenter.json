{
  "name": "PalCenter",
  "repo": "ghcr.io/shanebionic/palcenter:latest",
  "category": [
    "System"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/shanebionic/palcenter-unraid/main/palcenter.ico",
  "project": "https://github.com/shanebionic/palcenter",
  "description": "PalCenter is a self-hosted Palworld Server Command Center for monitoring and managing dedicated servers.",
  "paths": [
    {
      "name": "PalCenter Data",
      "host": "/mnt/cache/appdata/palcenter",
      "container": "/app/data",
      "mode": "rw",
      "description": "Persistent PalCenter application data.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Interface Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "PalCenter web interface.",
      "required": true,
      "mask": false
    },
    {
      "name": "API Port",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "PalCenter API port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Container UID",
      "key": "PALCENTER_UID",
      "value": "99",
      "description": "Container user ID. Default matches Unraid nobody user.",
      "required": false,
      "mask": false
    },
    {
      "name": "Container GID",
      "key": "PALCENTER_GID",
      "value": "100",
      "description": "Container group ID. Default matches Unraid users group.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
