{
  "name": "downtify",
  "repo": "henriquesebastiao/downtify:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/henriquesebastiao/downtify",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/henriquesebastiao/downtify/main/assets/android-chrome-512x512.png",
  "project": "https://github.com/henriquesebastiao/downtify",
  "description": "Downtify is an open-source music downloader backend powered by FastAPI, yt-dlp, and ffmpeg. It provides an automated download engine and queue management for companion clients like Hera.",
  "paths": [
    {
      "name": "Downloads Directory",
      "host": "/mnt/cache/data/media/music",
      "container": "/downloads",
      "mode": "rw",
      "description": "Download directory where files will be stored (must match Hera's music download directory)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "HTTP port for Downtify API",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
