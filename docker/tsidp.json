{
  "name": "tsidp",
  "repo": "ghcr.io/tailscale/tsidp:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/tailscale/tsidp/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/tailscale-light.png",
  "project": "https://github.com/tailscale/tsidp",
  "description": "tsidp is an OIDC / OAuth Identity Provider (IdP) server that integrates with your Tailscale network. It allows you to use Tailscale identities for authentication into applications that support OpenID Connect as well as authenticated MCP client / server connections.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/tsidp",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TAILSCALE_USE_WIP_CODE",
      "key": "TAILSCALE_USE_WIP_CODE",
      "value": "1",
      "description": "tsidp is experimental - needed while version",
      "required": false,
      "mask": false
    },
    {
      "name": "TS_STATE_DIR",
      "key": "TS_STATE_DIR",
      "value": "/data",
      "description": "Store persistent tsnet and tsidp state",
      "required": false,
      "mask": false
    },
    {
      "name": "TS_HOSTNAME",
      "key": "TS_HOSTNAME",
      "value": "idp",
      "description": "Hostname on tailnet (becomes idp.your-tailnet.ts.net)",
      "required": false,
      "mask": false
    },
    {
      "name": "TSIDP_ENABLE_STS",
      "key": "TSIDP_ENABLE_STS",
      "value": "1",
      "description": "Enable OAuth token exchange",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
