{
  "name": "Nacho-Rclone-Native-GUI",
  "repo": "rclone/rclone",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/rclone/rclone/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "rcd --rc-web-gui --rc-web-gui-update --rc-web-gui-force-update --rc-web-gui-no-open-browser --rc-addr :5572 --rc-user rclone --rc-pass rclone",
  "web_ui_url": "http://[IP]:[PORT:5572]/",
  "icon": "https://raw.githubusercontent.com/rclone/rclone/master/graphics/logo/logo_symbol/logo_symbol_color_256px.png",
  "project": null,
  "description": "This Unraid application is a Docker container running rclone's built-in GUI (https://rclone.org/gui/). The default username and password is rclone/rclone. To change it, modify the `--rc-user` and `--rc-pass` values for `Post Arguments` in Unraid's container configuration.",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/rclone",
      "container": "/config/rclone",
      "mode": "rw",
      "description": "Container Path: /config/rclone",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5572",
      "container": "5572",
      "protocol": "tcp",
      "description": "Container Port: 5572",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PHP_TZ",
      "key": "America/New_York",
      "value": "America/New_York",
      "description": "Container Variable: PHP_TZ",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
