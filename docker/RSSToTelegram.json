{
  "name": "RSS-To-Telegram",
  "repo": "bokker/rss.to.telegram:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/bokker/rss.to.telegram",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/BoKKeR/RSS-to-Telegram-Bot/master/rsstt.png",
  "project": "https://github.com/BoKKeR/RSS-to-Telegram-Bot",
  "description": "A self-hosted telegram JS/TS bot that dumps posts from RSS feeds to a telegram chat. This script was created because all the third party services were unreliable, slow.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/rsstt",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TOKEN",
      "key": "TOKEN",
      "value": "",
      "description": "Telegram bot token https://botsfortelegram.com/project/the-bot-father/",
      "required": true,
      "mask": false
    },
    {
      "name": "DEBUG",
      "key": "DEBUG",
      "value": "false",
      "description": "Enable debug mode for more logs",
      "required": false,
      "mask": false
    },
    {
      "name": "REDIS_HOST",
      "key": "REDIS_HOST",
      "value": "127.0.0.1",
      "description": "Redis host ip",
      "required": true,
      "mask": false
    },
    {
      "name": "REDIS_PORT",
      "key": "REDIS_PORT",
      "value": "6379",
      "description": "Redis host port",
      "required": true,
      "mask": false
    },
    {
      "name": "REDIS_USER",
      "key": "REDIS_USER",
      "value": "default",
      "description": "Redis user",
      "required": true,
      "mask": false
    },
    {
      "name": "REDIS_PASSWORD",
      "key": "REDIS_PASSWORD",
      "value": "secret",
      "description": "Redis password",
      "required": true,
      "mask": true
    },
    {
      "name": "REDIS_MUTEX",
      "key": "REDIS_MUTEX",
      "value": "randomvalue",
      "description": "Redis mutex, used in case of running multiple instances",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
