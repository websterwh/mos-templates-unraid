{
  "name": "ytdl-sub-gui",
  "repo": "ghcr.io/jmbannon/ytdl-sub-gui:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jmbannon/ytdl-sub-gui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8443]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/ytdl-sub.png",
  "project": "https://github.com/jmbannon/ytdl-sub",
  "description": "Automate downloads and metadata generation with YoutubeDL. The GUI image runs code-server with ytdl-sub preinstalled and can be accessed at https://localhost:8443",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/ytdl-sub-gui",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "TV Shows",
      "host": "/mnt/cache/tv_shows",
      "container": "/tv_shows",
      "mode": "rw",
      "description": "Path to store TV shows",
      "required": false
    },
    {
      "name": "Music",
      "host": "/mnt/cache/music",
      "container": "/music",
      "mode": "rw",
      "description": "Path to store music",
      "required": false
    },
    {
      "name": "Music Videos",
      "host": "/mnt/cache/music_videos",
      "container": "/music_videos",
      "mode": "rw",
      "description": "Path to store music videos",
      "required": false
    },
    {
      "name": "Movies",
      "host": "/mnt/cache/movies",
      "container": "/movies",
      "mode": "rw",
      "description": "Path to store movies",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "Container Port: 8443",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
