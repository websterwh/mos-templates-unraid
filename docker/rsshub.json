{
  "name": "rsshub",
  "repo": "diygod/rsshub:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/diygod/rsshub/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1200]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/rsshub.png",
  "project": "https://rsshub.app",
  "description": "RSSHub is an open source, easy to use, and extensible RSS feed generator. It is capable of generating RSS feeds from pretty much everything. Everything is RSSible. Supports 700+ websites and services out of the box including Reddit, Twitter/X, GitHub, YouTube, Bilibili, and many more.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "1200",
      "container": "1200",
      "protocol": "tcp",
      "description": "RSSHub web and API port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "CACHE_EXPIRE",
      "key": "CACHE_EXPIRE",
      "value": "300",
      "description": "Cache expiry in seconds (default 300)",
      "required": true,
      "mask": false
    },
    {
      "name": "CACHE_TYPE",
      "key": "CACHE_TYPE",
      "value": "memory|redis",
      "description": "Cache type: memory or redis",
      "required": true,
      "mask": false
    },
    {
      "name": "NODE_ENV",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Node environment",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
