{
  "name": "OctoFarm",
  "repo": "octofarm/octofarm",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/octofarm/octofarm/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4000]",
  "icon": "https://github.com/OctoFarm/OctoFarm/raw/master/server/assets/images/android-chrome-512x512.png",
  "project": "https://octofarm.net/",
  "description": "OctoFarm is a web server and client combination for unifying multiple instances of Octoprint. You can manage and monitor as many instances as you want from a single interface giving you full control over your 3D printer farm.",
  "paths": [
    {
      "name": "logs",
      "host": "/mnt/cache/appdata/octofarm/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Container Path: /app/logs",
      "required": false
    },
    {
      "name": "scripts",
      "host": "/mnt/cache/appdata/octofarm/scripts",
      "container": "/scripts",
      "mode": "rw",
      "description": "Container Path: /scripts",
      "required": false
    },
    {
      "name": "images",
      "host": "/mnt/cache/appdata/octofarm/images",
      "container": "/app/images",
      "mode": "rw",
      "description": "Thumbnail store for history",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": "Container Port: 4000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MongoDB details",
      "key": "MONGO",
      "value": "mongodb://mongo/octofarm",
      "description": "mongodb://username:password@host:port/db",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
