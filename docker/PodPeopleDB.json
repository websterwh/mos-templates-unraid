{
  "name": "PodPeopleDB",
  "repo": "madeofpendletonwool/podpeople_db:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/madeofpendletonwool/podpeople_db",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8085]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/pod-people-db-icon.png",
  "project": "https://people.pinepods.online",
  "description": "PodPeopleDB is an open-source database for podcast hosts and guests, serving as the IMDB of podcasting. It automatically indexes podcast host information from podcast feeds and allows manual submissions of host/guest information.",
  "paths": [
    {
      "name": "Data path",
      "host": "/mnt/cache/appdata/pod_people_db/data",
      "container": "/app/podpeople-data",
      "mode": "rw",
      "description": "Path to data files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8085",
      "container": "8085",
      "protocol": "tcp",
      "description": "Container Port: 8085",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin - Username",
      "key": "ADMIN_USERNAME",
      "value": "admin",
      "description": "Username for the admin account",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin - Password",
      "key": "ADMIN_PASSWORD",
      "value": "password",
      "description": "Password for the admin account",
      "required": true,
      "mask": true
    },
    {
      "name": "ntfy - URL",
      "key": "NTFY_URL",
      "value": "https://ntfy.sh",
      "description": "URL of the ntfy server to send notifications to",
      "required": true,
      "mask": false
    },
    {
      "name": "ntfy - Topic",
      "key": "NTFY_TOPIC",
      "value": "",
      "description": "Topic to send notifications to",
      "required": true,
      "mask": false
    },
    {
      "name": "Search API",
      "key": "SEARCH_API_URL",
      "value": "https://search.pinepods.online",
      "description": "URL of the search API to use",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
