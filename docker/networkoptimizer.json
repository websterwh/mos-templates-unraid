{
  "name": "network-optimizer",
  "repo": "ghcr.io/ozark-connect/network-optimizer:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/ozark-connect/network-optimizer/pkgs/container/network-optimizer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8042]",
  "icon": "https://raw.githubusercontent.com/Ozark-Connect/NetworkOptimizer/refs/heads/main/src/OpenSpeedTest/assets/images/icons/android-chrome-192x192.png",
  "project": "https://github.com/ozark-connect/network-optimizer",
  "description": "Network Optimizer - Automated network performance monitoring and optimization platform. Features: - Network performance monitoring and analysis - Client speed test integration - Path analysis and optimization - Agent deployment and management Requirements: - HOST_IP or HOST_NAME must be set for proper operation - Companion speedtest container recommended for full functionality",
  "paths": [
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/network-optimizer/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "SQLite database, configs, and license files",
      "required": true
    },
    {
      "name": "SSH Keys Directory",
      "host": "/mnt/cache/appdata/network-optimizer/ssh-keys",
      "container": "/app/ssh-keys",
      "mode": "ro",
      "description": "Optional: SSH keys for agent deployment",
      "required": false
    },
    {
      "name": "Logs Directory",
      "host": "/mnt/cache/appdata/network-optimizer/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Application logs",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8042",
      "container": "8042",
      "protocol": "tcp",
      "description": "Port for accessing the Network Optimizer web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Chicago",
      "description": "Timezone setting",
      "required": false,
      "mask": false
    },
    {
      "name": "Bind Localhost Only",
      "key": "BIND_LOCALHOST_ONLY",
      "value": "false",
      "description": "Set to true to bind to localhost only (for reverse proxy)",
      "required": false,
      "mask": false
    },
    {
      "name": "App Password",
      "key": "APP_PASSWORD",
      "value": "",
      "description": "Optional: Application password for authentication",
      "required": false,
      "mask": true
    },
    {
      "name": "Host IP",
      "key": "HOST_IP",
      "value": "",
      "description": "Host IP address for path analysis and CORS (required for client speed tests)",
      "required": false,
      "mask": false
    },
    {
      "name": "Host Name",
      "key": "HOST_NAME",
      "value": "",
      "description": "Host name for path analysis and CORS (required for client speed tests)",
      "required": false,
      "mask": false
    },
    {
      "name": "Reverse Proxied Host Name",
      "key": "REVERSE_PROXIED_HOST_NAME",
      "value": "",
      "description": "Reverse proxy hostname (e.g., optimizer.example.com) - overrides HOST_NAME for API URLs",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenSpeedTest Port",
      "key": "OPENSPEEDTEST_PORT",
      "value": "3005",
      "description": "Port where OpenSpeedTest is running",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenSpeedTest Host",
      "key": "OPENSPEEDTEST_HOST",
      "value": "",
      "description": "OpenSpeedTest host for CORS configuration",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenSpeedTest HTTPS",
      "key": "OPENSPEEDTEST_HTTPS",
      "value": "false",
      "description": "Set to true if OpenSpeedTest uses HTTPS",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenSpeedTest HTTPS Port",
      "key": "OPENSPEEDTEST_HTTPS_PORT",
      "value": "443",
      "description": "HTTPS port for OpenSpeedTest",
      "required": false,
      "mask": false
    },
    {
      "name": "iperf3 Server Enabled",
      "key": "Iperf3Server__Enabled",
      "value": "false",
      "description": "Enable to accept client-initiated speed tests on port 5201",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "Information",
      "description": "Logging level: Trace, Debug, Information, Warning, Error, Critical",
      "required": false,
      "mask": false
    },
    {
      "name": "App Log Level",
      "key": "APP_LOG_LEVEL",
      "value": "Information",
      "description": "Network Optimizer specific log level",
      "required": false,
      "mask": false
    },
    {
      "name": "Demo Mode Mappings",
      "key": "DEMO_MODE_MAPPINGS",
      "value": "",
      "description": "Optional: Demo mode configuration",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB URL",
      "key": "INFLUXDB_URL",
      "value": "",
      "description": "Optional: InfluxDB URL for metrics storage (e.g., http://localhost:8086)",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Token",
      "key": "INFLUXDB_TOKEN",
      "value": "",
      "description": "Optional: InfluxDB authentication token",
      "required": false,
      "mask": true
    },
    {
      "name": "InfluxDB Organization",
      "key": "INFLUXDB_ORG",
      "value": "network-optimizer",
      "description": "Optional: InfluxDB organization name",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Bucket",
      "key": "INFLUXDB_BUCKET",
      "value": "network_optimizer",
      "description": "Optional: InfluxDB bucket name for storing metrics",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
