{
  "name": "Mesh-Bot",
  "repo": "ghcr.io/spudgunman/meshing-around:main",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/spudgunman/meshing-around",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8420]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/mesh-bot-icon.png",
  "project": "https://github.com/SpudGunMan/meshing-around",
  "description": "Mesh Bot is a feature-rich bot designed to enhance your Meshtastic network experience. It provides powerful tools for network testing, messaging, games, and more\u2014all via text-based message delivery. Whether you want to test your mesh, send messages, or play games, Mesh Bot has you covered.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/meshing_around/data",
      "container": "/app",
      "mode": "rw",
      "description": "Path to app data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8420",
      "container": "8420",
      "protocol": "tcp",
      "description": "Container Port: 8420",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Ollama API URL",
      "key": "OLLAMA_API_URL",
      "value": "http://IP_ADDRESS:11434",
      "description": "Ollama API URL",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
