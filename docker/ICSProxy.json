{
  "name": "ICS-Proxy",
  "repo": "ghcr.io/13hannes11/ics-proxy:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/13hannes11/ics-proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ics-proxy-icon.png",
  "project": "https://ics-proxy.de/",
  "description": "A calendar proxy application that allows keeping the calendar URL stable while changing the target URL.",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/ics_proxy/db",
      "container": "/app/db",
      "mode": "rw",
      "description": "Path to the db directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Protocol",
      "key": "PROTOCOL",
      "value": "http|https",
      "description": "Protocol to use for the ICS Proxy",
      "required": true,
      "mask": false
    },
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "IP_ADDRESS:8080",
      "description": "Base URL for the ICS Proxy",
      "required": true,
      "mask": false
    },
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "sqlite://db/db.db",
      "description": "Database URL for the ICS Proxy",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
