{
  "name": "RSS-proxy",
  "repo": "damoeb/rss-proxy:2",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/damoeb/rss-proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://rssproxy.migor.org/assets/rss_icon.png",
  "project": "https://rssproxy.migor.org/",
  "description": "RSS-proxy allows you to do create an ATOM or JSON feed of any static website or feeds (web to feed), just by analyzing just the HTML structure.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Public URL",
      "key": "APP_API_GATEWAY_URL",
      "value": "https://mydomain.com",
      "description": "Public URL of the app",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "info|error|warn|debug",
      "description": "Log level for the application",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
