{
  "name": "obs-ndi",
  "repo": "patrickstigler/obs-ndi",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/repository/docker/patrickstigler/obs-ndi",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6901]/",
  "icon": "https://obsproject.com/assets/images/new_icon_small-r.png",
  "project": "https://github.com/patrickstigler/docker-obs-ndi",
  "description": "The OBS with NDI is incorporated into the container and can be used to stream your desktop. With the latetest OBS version the is support for obs-websocket. The VNC password is 'headless'. You can connect with your own VNC client at 5901 or use the webclient at 6901",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/obs",
      "container": "/config/obs-studio",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port for obs-websocket",
      "host": "4455",
      "container": "4455",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "novnc",
      "host": "6901",
      "container": "6901",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Vnc",
      "host": "5901",
      "container": "5901",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "",
      "description": "Required for Nvidia GPU support. In case you use something else - delete this entry.",
      "required": true,
      "mask": false
    },
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "VNC Password",
      "key": "VNC_PW",
      "value": "headless",
      "description": "Set your VNC password",
      "required": false,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
