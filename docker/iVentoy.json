{
  "name": "iVentoy",
  "repo": "ziggyds/iventoy",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ziggyds/iventoy/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:26000]",
  "icon": "https://raw.githubusercontent.com/Core-i99/unraid-docker-templates/main/templates/icons/iventoy.png",
  "project": "https://iventoy.com",
  "description": "Dockerized version of iVentoy for use on Unraid. iVentoy is an enhanced version of the PXE server. With iVentoy you can boot and install OS on multiple machines at the same time through the network. iVentoy is extremely easy to use, without complicated configuration, just put the ISO file in the specified location and select PXE boot in the client machine. iVentoy supports x86 Legacy BIOS, IA32 UEFI, x86_64 UEFI and ARM64 UEFI mode at the same time. iVentoy support 110+ common types of OS (Windows/WinPE/Linux/VMware)",
  "paths": [
    {
      "name": "ISO Directory",
      "host": "",
      "container": "/app/iso",
      "mode": "rw",
      "description": "iVentoy ISO directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "26000",
      "container": "26000",
      "protocol": "tcp",
      "description": "iVentoy GUI HTTP Server Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 16000",
      "host": "16000",
      "container": "16000",
      "protocol": "tcp",
      "description": "iVentoy PXE Service HTTP Server Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 10809",
      "host": "10809",
      "container": "10809",
      "protocol": "tcp",
      "description": "NBD Server Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 67",
      "host": "67",
      "container": "67",
      "protocol": "udp",
      "description": "DHCP Server Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 68",
      "host": "68",
      "container": "68",
      "protocol": "udp",
      "description": "DHCP Server Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 69",
      "host": "69",
      "container": "69",
      "protocol": "udp",
      "description": "TFTP Server Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "AUTO_START_PXE",
      "key": "AUTO_START_PXE",
      "value": "1",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
