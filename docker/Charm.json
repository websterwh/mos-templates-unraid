{
  "name": "Charm",
  "repo": "charmcli/charm:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/charmcli/charm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:35353]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/charm-icon.png",
  "project": "https://github.com/charmbracelet/charm",
  "description": "The Charm Tool and Library",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/charm",
      "container": "/data",
      "mode": "rw",
      "description": "Storage for databases and file storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "SSH Port",
      "host": "35353",
      "container": "35353",
      "protocol": "tcp",
      "description": "Container Port: 35353",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP Port",
      "host": "35354",
      "container": "35354",
      "protocol": "tcp",
      "description": "Container Port: 35354",
      "required": true,
      "mask": false
    },
    {
      "name": "Stats Port",
      "host": "35355",
      "container": "35355",
      "protocol": "tcp",
      "description": "Container Port: 35355",
      "required": true,
      "mask": false
    },
    {
      "name": "Health Port",
      "host": "35356",
      "container": "35356",
      "protocol": "tcp",
      "description": "Container Port: 35356",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Max storage per user",
      "key": "CHARM_SERVER_USER_MAX_STORAGE",
      "value": "0",
      "description": "Maximum storage per user. 0 for no limit",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
