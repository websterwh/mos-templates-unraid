{
  "name": "dokemon-agent",
  "repo": "productiveops/dokemon-agent:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/productiveops/dokemon-agent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Joly0/docker-templates/main/icons/dokemon-agent-icon.png",
  "project": "https://dokemon.dev/",
  "description": "Dok\u00e9mon-Agent to connect to a Dok\u00e9mon-Server to manage multiple docker servers from a single webui",
  "paths": [
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "SERVER URL",
      "key": "SERVER_URL",
      "value": "https://YOUR_IP:9090",
      "description": "This is the Server URL that needs to be configured first in your main dokemon instance",
      "required": false,
      "mask": false
    },
    {
      "name": "TOKEN",
      "key": "TOKEN",
      "value": "as56d4fa8sd54A54ASDF5648sdf456asd==",
      "description": "Dokemon token that shows, when you register a new node",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
