{
  "name": "Whisper",
  "repo": "viyh/whisper:0.1.0-alpha",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/viyh/whisper",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/whisper-icon.png",
  "project": "https://github.com/viyh/whisper",
  "description": "Whisper provides a simple way to share secret information with someone else, such as passwords, credentials, keys, or other sensitive data.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/whisper/config.yaml",
      "container": "/usr/src/app/config.yaml",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true
    },
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/whisper/storage",
      "container": "/tmp/whisper",
      "mode": "rw",
      "description": "Path to the storage directory. Remove to use in-memory storage (lost when container restarts)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
