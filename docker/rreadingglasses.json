{
  "name": "rreading-glasses",
  "repo": "blampe/rreading-glasses:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/blampe/rreading-glasses",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--entrypoint /main",
  "post_parameters": "serve",
  "web_ui_url": "http://[IP]:[PORT:8788]",
  "icon": "https://raw.githubusercontent.com/ds-sebastian/unraid-templates/refs/heads/main/icons/rReadingGlasses.png",
  "project": "https://github.com/blampe/rreading-glasses",
  "description": "rreading-glasses is a drop-in replacement for the official metadata provider that delivers lightning-fast, high-coverage book and author data to your Arr-based library clients (e.g. Readarr, Calibre). - Speeds up searches and imports by caching metadata in memory and Postgres - Supports very large authors and upcoming releases not found in the official service - Provides full Goodreads compatibility or can proxy the open-source Hardcover API",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8788",
      "container": "8788",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PostgreSQL Host",
      "key": "POSTGRES_HOST",
      "value": "",
      "description": "The hostname or IP address of your Postgres server.",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL User",
      "key": "POSTGRES_USER",
      "value": "",
      "description": "The username to connect to Postgres.",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL Password",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "The password for the Postgres user.",
      "required": true,
      "mask": true
    },
    {
      "name": "PostgreSQL Database",
      "key": "POSTGRES_DATABASE",
      "value": "rreading-glasses",
      "description": "The database name to use.",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL Port",
      "key": "POSTGRES_PORT",
      "value": "5432",
      "description": "Postgres port.",
      "required": true,
      "mask": false
    },
    {
      "name": "Cookie",
      "key": "COOKIE",
      "value": "",
      "description": "Cookie used for upstream HTTP requests.",
      "required": false,
      "mask": false
    },
    {
      "name": "Upstream",
      "key": "UPSTREAM",
      "value": "www.goodreads.com",
      "description": "The upstream host (e.g. www.example.com).",
      "required": true,
      "mask": false
    },
    {
      "name": "HardcoverAuth",
      "key": "HARDCOVER_AUTH",
      "value": "",
      "description": "Hardcover Authorization header, e.g. 'Bearer ...'",
      "required": false,
      "mask": false
    },
    {
      "name": "Port",
      "key": "PORT",
      "value": "8788",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "RPM",
      "key": "RPM",
      "value": "60",
      "description": "Maximum upstream requests per minute.",
      "required": false,
      "mask": false
    },
    {
      "name": "Proxy",
      "key": "PROXY",
      "value": "",
      "description": "HTTP proxy URL for upstream requests. (Leave empty if not used)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
