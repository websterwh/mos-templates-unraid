{
  "name": "Firefly-Pico",
  "repo": "cioraneanu/firefly-pico:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/cioraneanu/firefly-pico",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/firefly-pico-icon.png",
  "project": "https://github.com/cioraneanu/firefly-pico",
  "description": "A delightful Firefly III companion web app for effortless transaction tracking.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "6976",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Firefly III URL",
      "key": "FIREFLY_URL",
      "value": "https://firefly.domain.com",
      "description": "URL of the Firefly III instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Host",
      "key": "DB_HOST",
      "value": "localhost",
      "description": "Hostname of the Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Port",
      "key": "DB_PORT",
      "value": "5432",
      "description": "Port of the Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Name",
      "key": "DB_DATABASE",
      "value": "firefly-pico",
      "description": "Name of the Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - User",
      "key": "DB_USERNAME",
      "value": "firefly-pico",
      "description": "Username of the Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Password",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "Password of the Postgres database",
      "required": true,
      "mask": true
    },
    {
      "name": "Database - Type",
      "key": "DB_CONNECTION",
      "value": "pgsql",
      "description": "Type of the database. Not recommended to change",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
