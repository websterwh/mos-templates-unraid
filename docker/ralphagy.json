{
  "name": "ralph-agy",
  "repo": "ghcr.io/zeyso/ralph-agy:main",
  "category": [
    "System"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://antigravity.google/favicon.ico",
  "project": "https://github.com/Zeyso/ralph-agy",
  "description": "Ralph autonomous AI agent loop running with Google Antigravity CLI (agy). Ralph repeatedly calls agy to implement user stories from a prd.json until all tasks are complete. Use \"docker exec -it ralph-agy bash\" to attach and run ralph.sh manually.",
  "paths": [
    {
      "name": "Project Path",
      "host": "/mnt/cache/appdata/ralph-agy/project",
      "container": "/workspace/project",
      "mode": "rw",
      "description": "Path to your project/git repo (must contain prd.json)",
      "required": true
    },
    {
      "name": "agy Config Path",
      "host": "/mnt/cache/appdata/ralph-agy/agy-config",
      "container": "/root/.config/agy",
      "mode": "rw",
      "description": "agy configuration directory (settings.json, auth tokens)",
      "required": true
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/ralph-agy/logs",
      "container": "/workspace/logs",
      "mode": "rw",
      "description": "Persistent log storage",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Google API Key",
      "key": "GOOGLE_API_KEY",
      "value": "",
      "description": "Your Google / Antigravity API Key for agy CLI authentication",
      "required": true,
      "mask": true
    },
    {
      "name": "Antigravity API Key",
      "key": "ANTIGRAVITY_API_KEY",
      "value": "",
      "description": "Antigravity API Key (leave empty if using GOOGLE_API_KEY)",
      "required": false,
      "mask": true
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Container timezone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
