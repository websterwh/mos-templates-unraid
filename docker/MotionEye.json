{
  "name": "MotionEye",
  "repo": "malvarez00/docker-motioneye",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/malvarez00/docker-motioneye",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8765]",
  "icon": "https://raw.githubusercontent.com/malvarez00/unRAID-Docker-Templates/master/malvarez00/icons/motioneye_96x96.png",
  "project": null,
  "description": "MotionEye Dockerbr / A surveillance solution base on: MotionEye, Motion and Docker.br / br / It's easy and ready to use. Just configure a camera and run this docker, then videos and images will be saved once a motion is detected while a notification e-mail including the recorded video and a preview image will be sent. On top of that, the webcam can be accessed anytime via HTTP live streaming.br / br / Default Username: adminbr / Default Password: BLANKbr / br/ Root Directory \"/var/lib/motioneye/",
  "paths": [
    {
      "name": "Configuration Path",
      "host": "/mnt/cache/appdata/MotionEye/config",
      "container": "/etc/motioneye",
      "mode": "rw",
      "description": "Container Path: /etc/motioneye",
      "required": true
    },
    {
      "name": "Media Files Path",
      "host": "/mnt/cache/data/MotionEye",
      "container": "/var/lib/motioneye",
      "mode": "rw",
      "description": "Container Path: /var/lib/motioneye",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEB UI",
      "host": "8765",
      "container": "8765",
      "protocol": "tcp",
      "description": "Container Port: 8765",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Key 1",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
