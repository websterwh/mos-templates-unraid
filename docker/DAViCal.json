{
  "name": "DAViCal",
  "repo": "fintechstudios/davical:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/fintechstudios/davical",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://davical.org/images/logo.gif",
  "project": "https://davical.org",
  "description": "DAViCal is a server for calendar sharing. It is an implementation of the CalDAV protocol which is designed for storing calendaring resources (in iCalendar format) on a remote shared server.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Postgres - Host",
      "key": "PGHOST",
      "value": "localhost",
      "description": "Postgres host",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres - Port",
      "key": "PGPORT",
      "value": "5432",
      "description": "Postgres port",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres - User",
      "key": "PGUSER",
      "value": "davical_app",
      "description": "Postgres user",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres - Password",
      "key": "PGPASSWORD",
      "value": "",
      "description": "Postgres password",
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres - Database",
      "key": "PGDATABASE",
      "value": "davical",
      "description": "Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Apache ServerName",
      "key": "HOST_NAME",
      "value": "localhost",
      "description": "Used as Apache ServerName.",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Email",
      "key": "ADMIN_EMAIL",
      "value": "admin@davical.example.com",
      "description": "Displayed on login page and in 'From' for password reset emails.",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Migrations - Run Migrations on Startup",
      "key": "RUN_MIGRATIONS_AT_STARTUP",
      "value": "false|true",
      "description": "Run database migrations on startup.",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Migrations - Root User",
      "key": "ROOT_PGUSER",
      "value": "davical",
      "description": "Postgres user with permissions to create users and databases. Remove if not used.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Migrations - Root Password",
      "key": "ROOT_PGPASSWORD",
      "value": "",
      "description": "Postgres password for the root user. Remove if not used.",
      "required": false,
      "mask": true
    },
    {
      "name": "Database Migrations - Admin Password",
      "key": "DAVICAL_ADMIN_PASS",
      "value": "",
      "description": "Password you would like to use for DAViCal admin user. Remove if not used.",
      "required": false,
      "mask": true
    },
    {
      "name": "Database Migrations - DAViCal Superuser Username",
      "key": "DBA_PGUSER",
      "value": "davical_dba",
      "description": "The Postgres (super)user used by DAViCal for database operations.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Migrations - DAViCal Superuser Password",
      "key": "DBA_PGPASSWORD",
      "value": "",
      "description": "Password for the DAViCal superuser.",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
