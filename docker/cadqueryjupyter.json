{
  "name": "cadquery_jupyter",
  "repo": "bwalter42/jupyter_cadquery:3.1.0rc4",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/cadquery/cadquery-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8888]/",
  "icon": "https://res.cloudinary.com/canonical/image/fetch/f_auto,q_auto,fl_sanitize,w_120,h_120/https:/dashboard.snapcraft.io/site_media/appmedia/2020/05/logo.png",
  "project": "https://github.com/bernhard-42/jupyter-cadquery",
  "description": "CadQuery is an intuitive, easy-to-use Python module for building parametric 3D CAD models. Using CadQuery, you can write short, simple scripts that produce high quality CAD models. It is easy to make many different objects using a single script that can be customized. With CadQuery Jupyter you can design / code your models in the browser. View, and export them.",
  "paths": [
    {
      "name": "Workdir",
      "host": "/mnt/cache/appdata/cadquery_jupyter/",
      "container": "/home/cq",
      "mode": "rw",
      "description": "Container Path: /home/cp",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "Container Port: 8888",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
