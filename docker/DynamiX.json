{
  "name": "DynamiX",
  "repo": "clharrel/dynamix:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/clharrel/dynamix",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1166]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dynamix-icon.png",
  "project": "https://github.com/TheImaginear/dynamiX",
  "description": "An automation tool for dynamically managing Plex collections. It pins and unpins library collections based on configurable time blocks, ensuring fresh and relevant content is featured.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/dynamix/config.json",
      "container": "/app/config.json",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true
    },
    {
      "name": "User Exemptions File",
      "host": "/mnt/cache/appdata/dynamix/used_collections.json",
      "container": "/app/used_collections.json",
      "mode": "rw",
      "description": "Path to the user exemptions file",
      "required": true
    },
    {
      "name": "Used Collections File",
      "host": "/mnt/cache/appdata/dynamix/used_collections.json",
      "container": "/app/used_collections.json",
      "mode": "rw",
      "description": "Path to the used collections file",
      "required": true
    },
    {
      "name": "Run State File",
      "host": "/mnt/cache/appdata/dynamix/run_state.json",
      "container": "/app/run_state.json",
      "mode": "rw",
      "description": "Path to the run state file",
      "required": true
    },
    {
      "name": "Log Folder",
      "host": "/mnt/cache/appdata/dynamix/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Path to the log folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "1166",
      "container": "1166",
      "protocol": "tcp",
      "description": "Container Port: 1166",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
