{
  "name": "noisedash",
  "repo": "noisedash/noisedash:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/noisedash/noisedash",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1432]",
  "icon": "https://raw.githubusercontent.com/xavier-hernandez/unraid-templates/master/resources/noise.png",
  "project": "https://github.com/kaythomas0/noisedash",
  "description": "Self-hostable web tool for generating ambient noises. README: Run this container first then stop it, it'll error for missing config. Copy this file https://raw.githubusercontent.com/kaythomas0/noisedash/main/config/default.json into your NoiseConfig path. Then restart the container.",
  "paths": [
    {
      "name": "NoiseDB",
      "host": "/mnt/cache/appdata/noise",
      "container": "/var/noisedash/db",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "NoiseSamples",
      "host": "",
      "container": "/var/noisedash/samples",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "NoiseConfig",
      "host": "",
      "container": "/var/noisedash/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port",
      "host": "1432",
      "container": "1432",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
