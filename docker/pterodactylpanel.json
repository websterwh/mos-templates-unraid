{
  "name": "pterodactyl-panel",
  "repo": "ccarney16/pterodactyl-panel:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/ccarney16/pterodactyl-panel/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/ibracorp/unraid-templates/master/pterodactyl-panel/pterodactyl-panel.png",
  "project": "https://pterodactyl.io/",
  "description": "Pterodactyl is an open-source game server management panel built with PHP 7, React, and Go. Designed with security in mind, Pterodactyl runs all game servers in isolated Docker containers while exposing a beautiful and intuitive UI to end users. Find a guide on how to get this up and running at https://docs.ibracorp.io",
  "paths": [
    {
      "name": "Shared data",
      "host": "/mnt/cache/pterodactyl-node/data",
      "container": "/mnt/user/pterodactyl-node/data",
      "mode": "rw",
      "description": "Container Path: /mnt/user/pterodactyl-node/data",
      "required": true
    },
    {
      "name": "Game Data",
      "host": "/mnt/cache/pterodactyl-node/",
      "container": "/etc/pterodactyl",
      "mode": "rw",
      "description": "Container Path: /etc/pterodactyl",
      "required": false
    },
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/pterodactyl/",
      "container": "/data",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8001",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "APP_TIMEZONE",
      "value": "Europe/London",
      "description": "Timezone",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Hostname or IP",
      "key": "DB_HOST",
      "value": "mariadb",
      "description": "Database Hostname or IP.",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "DB_PORT",
      "value": "3306",
      "description": "Database Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "DB_DATABASE",
      "value": "pterodactyl",
      "description": "Database Name",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Username",
      "key": "DB_USERNAME",
      "value": "pterodactyl",
      "description": "Database Username",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "DB_PASSWORD",
      "value": "pterodactyl",
      "description": "Database Password",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis Hostname or IP",
      "key": "REDIS_HOST",
      "value": "Redis",
      "description": "Redis Hostname or IP.",
      "required": true,
      "mask": false
    },
    {
      "name": "DEBUG",
      "key": "APP_DEBUG",
      "value": "false",
      "description": "APP_DEBUG",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
