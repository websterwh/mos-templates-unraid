{
  "name": "pocketbase",
  "repo": "spectado/pocketbase:0.19.2",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/spectado/pocketbase/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/pocketbase.png",
  "project": "https://pocketbase.io/",
  "description": "PocketBase - Open Source backend for your next SaaS and Mobile app in 1 file",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/pocketbase/pb_data/",
      "container": "/pb_data",
      "mode": "rw",
      "description": "application config and data and should be mapped to your local file system to persist them",
      "required": false
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/pocketbase/pb_migrations/",
      "container": "/pb_migrations/",
      "mode": "rw",
      "description": "directory allows you to version your DB structure",
      "required": false
    },
    {
      "name": "Host Path 3",
      "host": "/mnt/cache/appdata/pocketbase/pb_public/",
      "container": "/pb_public",
      "mode": "rw",
      "description": "optional, and is only used for serving static files",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "5170",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ROOT_ADMIN_EMAIL",
      "key": "ROOT_ADMIN_EMAIL",
      "value": "admin@grimoire.localhost",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ROOT_ADMIN_PASSWORD",
      "key": "ROOT_ADMIN_PASSWORD",
      "value": "changeme",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
