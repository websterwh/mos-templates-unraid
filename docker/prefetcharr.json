{
  "name": "prefetcharr",
  "repo": "phueber/prefetcharr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/phueber/prefetcharr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/prefetcharr-icon.png",
  "project": "https://github.com/p-hueber/prefetcharr",
  "description": "Let Sonarr fetch episodes on demand for a show you are watching on Jellyfin/Emby/Plex.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/prefetcharr/config.toml",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true
    },
    {
      "name": "Log Path",
      "host": "/mnt/cache/appdata/prefetcharr/log",
      "container": "/log",
      "mode": "rw",
      "description": "Path to the log folder",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Config Element",
      "key": "PREFETCHARR_CONFIG",
      "value": "Could not read from config file.",
      "description": "Environmental variable storing TOML data for config. Do NOT populate, use config file instead. If the config file cannot be read, this will be used as a fallback and forcibly error the application.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
