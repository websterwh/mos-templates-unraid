{
  "name": "Authelia-Admin-Control-Panel",
  "repo": "ghcr.io/asalimonov/authelia-admin:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/asalimonov/authelia-admin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9093]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/authelia-admin-icon.png",
  "project": "https://github.com/asalimonov/authelia-admin",
  "description": "A web-based administration interface for managing Authelia authentication server with LLDAP.",
  "paths": [
    {
      "name": "Authelia Config File",
      "host": "",
      "container": "/opt/authelia-admin/config.yml",
      "mode": "ro",
      "description": "Path to the Authelia config.yaml file",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/authelia_admin/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true
    },
    {
      "name": "App Data Path",
      "host": "/mnt/cache/appdata/authelia_admin/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the app data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9093",
      "container": "9093",
      "protocol": "tcp",
      "description": "Container Port: 9093",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Trusted Origins",
      "key": "TRUSTED_ORIGINS",
      "value": "https://auth.yourdomain.com",
      "description": "Set the trusted origins for Authelia",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "AAD_LOGLEVEL",
      "value": "DEBUG|INFO|WARNING|ERROR|CRITICAL",
      "description": "Set the log level",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
