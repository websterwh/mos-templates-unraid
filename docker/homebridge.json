{
  "name": "homebridge",
  "repo": "homebridge/homebridge:ubuntu",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/homebridge/homebridge/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8581]/",
  "icon": "https://raw.githubusercontent.com/homebridge/branding/master/logos/homebridge-color-round-stylized.png",
  "project": "https://homebridge.io",
  "description": "Homebridge allows you to integrate with smart home devices that do not natively support HomeKit. There are over 2,000 Homebridge plugins supporting thousands of different smart accessories.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/homebridge",
      "container": "/homebridge",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Key 1",
      "key": "HOMEBRIDGE_CONFIG_UI",
      "value": "1",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "HOMEBRIDGE_CONFIG_UI_PORT",
      "value": "8581",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Key 3",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Key 4",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Host Key 5",
      "key": "UMASK",
      "value": "0000",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
