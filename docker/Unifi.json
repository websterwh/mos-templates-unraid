{
  "name": "Unifi",
  "repo": "brettm357/unifi",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/brettm357/unifi",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:8443]",
  "icon": "https://dl.ubnt.com/press/Company_Logos/U_Logo/WEB/U_Logo_RGB.png",
  "project": "https://www.ui.com",
  "description": "Use the UniFi Controller software to quickly configure and administer an enterprise Wi\u2010Fi network. RF map and performance features, real-time status, automatic UAP device detection, and advanced security options are all seamlessly integrated.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/unifi",
      "container": "/usr/lib/unifi/data",
      "mode": "rw",
      "description": "Container Path: /usr/lib/unifi/data",
      "required": true
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/unifi/logs",
      "container": "/usr/lib/unifi/logs",
      "mode": "rw",
      "description": "Container Path: /usr/lib/unifi/logs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "3478",
      "container": "3478",
      "protocol": "udp",
      "description": "Container Port: 3478",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "6789",
      "container": "6789",
      "protocol": "tcp",
      "description": "Container Port: 6789",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 3",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 4",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 5",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "Container Port: 8443",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 6",
      "host": "8843",
      "container": "8843",
      "protocol": "tcp",
      "description": "Container Port: 8843",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 7",
      "host": "8880",
      "container": "8880",
      "protocol": "tcp",
      "description": "Container Port: 8880",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Key 1",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
