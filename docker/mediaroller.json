{
  "name": "media-roller",
  "repo": "ghcr.io/rroller/media-roller:master",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/rroller/media-roller/pkgs/container/media-roller",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://i.imgur.com/I7iwfnF.png",
  "project": "https://github.com/rroller/media-roller",
  "description": "Mobile friendly tool for downloading videos from social media. For direct downloads: http:// :[PORT:3000]/api?url=SOME_URL Written in Golang using youtube-dl and ffmpeg for conversion.",
  "paths": [
    {
      "name": "Download",
      "host": "/mnt/cache/media/video-downloads",
      "container": "/download",
      "mode": "rw",
      "description": "Container Path: /download",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
