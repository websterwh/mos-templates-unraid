      "key": "PORT",
      "value": "5030",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SLSKD_UPLOAD_SLOTS",
      "key": "SLSKD_UPLOAD_SLOTS",
      "value": "10",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SLSKD_UPLOAD_SPEED_LIMIT",
      "key": "SLSKD_UPLOAD_SPEED_LIMIT",
      "value": "1000",
      "description": null,
      "required": false,
      "mask": false
