  "description": "A modern client-server application for the Soulseek file-sharing network. It is accessible from a web browser and supports reverse proxies.",
  "paths": [
    {
      "name": "Application data",
      "host": "/mnt/cache/appdata/slskd/",
      "container": "/app",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
