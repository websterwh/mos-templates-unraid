      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS WEB UI",
      "host": "5031",
      "container": "5031",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SOULSEEK CLIENT",
      "host": "50300",
      "container": "50300",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
