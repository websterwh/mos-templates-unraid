{
  "name": "slskd",
  "repo": "slskd/slskd:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/slskd/slskd/pkgs/container/slskd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5030]/",
