{
  "name": "Grained",
  "repo": "ghcr.io/revise0592/grained:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/revise0592/grained",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/Revise0592/grained/refs/heads/main/public/icons/icon-512.png",
  "project": "https://github.com/Revise0592/grained",
  "description": "Self-hosted archive for film photography. Import lab scan zips, log metadata, browse in a lightbox, annotate frames.",
  "paths": [
    {
      "name": "Library",
      "host": "/mnt/cache/appdata/grained/",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "AUTH_DISABLED",
      "key": "AUTH_DISABLED",
      "value": "false|true",
      "description": "Protect with an admin password.",
      "required": true,
      "mask": false
    },
    {
      "name": "UPLOAD_DIR",
      "key": "UPLOAD_DIR",
      "value": "/data/uploads",
      "description": "You don't need to change this.",
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "file:/data/grained.db",
      "description": "You don't need to change this.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
