{
  "name": "VeracryptGUI",
  "repo": "dcflachs/veracrypt-gui",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/dcflachs/veracrypt-gui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5800]",
  "icon": "https://veracrypt.fr/en/VeraCrypt128x128.png",
  "project": "https://github.com/dcflachs/docker-containers",
  "description": "Use Veracrypt Containers in Docker",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/veracrypt-gui/config/",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Containers",
      "host": "/mnt/cache/data/veracrypt-containers",
      "container": "/mnt/containers",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Images",
      "host": "/mnt/cache/data/veracrypt-images",
      "container": "/mnt/disks",
      "mode": "rw,shared",
      "description": null,
      "required": false
    },
    {
      "name": "Mounted Containers",
      "host": "/mnt/cache/data/veracrypt-mounts",
      "container": "/media",
      "mode": "rw,shared",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5800",
      "container": "5800",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DISPLAY_WIDTH",
      "key": "DISPLAY_WIDTH",
      "value": "1280",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DISPLAY_HEIGHT",
      "key": "DISPLAY_HEIGHT",
      "value": "720",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "GROUP_ID",
      "key": "GROUP_ID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "USER_ID",
      "key": "USER_ID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
