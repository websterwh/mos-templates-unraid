{
  "name": "ampache",
  "repo": "ampache/ampache",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/ampache/ampache/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/ampache.png",
  "project": "https://ampache.org/",
  "description": "Ampache ...for the love of music You will need to follow the configuration steps here once the container is running: https://github.com/ampache/ampache/wiki/Basic",
  "paths": [
    {
      "name": "Config Location",
      "host": "/mnt/cache/appdata/ampache/config",
      "container": "/var/www/html",
      "mode": "rw",
      "description": "Location for app configuration",
      "required": true
    },
    {
      "name": "Log Location",
      "host": "/mnt/cache/appdata/ampache/logs",
      "container": "/var/log/ampache",
      "mode": "rw",
      "description": "Location for Logs",
      "required": true
    },
    {
      "name": "Music Location",
      "host": "/mnt/cache/appdata/ampache/media",
      "container": "/media",
      "mode": "ro",
      "description": "Location for media files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8084",
      "container": "80",
      "protocol": "tcp",
      "description": "Web UI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
