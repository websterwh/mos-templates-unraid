{
  "name": "2fauth",
  "repo": "2fauth/2fauth:latest",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/2fauth/2fauth/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/2fauth.png",
  "project": "https://github.com/Bubka/2FAuth/tree/master",
  "description": "A web app to manage your Two-Factor Authentication (2FA) accounts and generate their security codes Before running container Unraid CLI mkdir /mnt/user/appdata/2fauth chown 1000:1000 /mnt/user/appdata/2fauth Register first username for admin user More info in https://github.com/Bubka/2FAuth/blob/master/docker/docker-compose.yml and advanced",
  "paths": [
    {
      "name": "Appdata Path",
      "host": "/mnt/cache/appdata/2fauth/",
      "container": "/2fauth",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8805",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_NAME",
      "key": "APP_NAME",
      "value": "2FAuth",
      "description": "You can change the name of the app",
      "required": false,
      "mask": false
    },
    {
      "name": "SITE_OWNER",
      "key": "SITE_OWNER",
      "value": "mail@example.com",
      "description": "This should be your email address",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_KEY",
      "key": "APP_KEY",
      "value": "SomeRandomStringOf32CharsExactly",
      "description": "The encryption key for our database and sessions. Keep this very secure.",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "http://Unraid_IP:8805",
      "description": "This variable must match your installation's external address.",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_ENV",
