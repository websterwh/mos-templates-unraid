{
  "name": "DumbPad",
  "repo": "dumbwareio/dumbpad:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dumbwareio/dumbpad",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/dumbpad-logo.png",
  "project": "https://github.com/DumbWareio/DumbPad",
  "description": "A stupid simple, no auth (unless you want it!), modern notepad application with auto-save functionality and dark mode support..",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dumbpad",
      "container": "/app/data",
      "mode": "rw",
      "description": "Data Dir",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port on which the application will run.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PIN",
      "key": "DUMBPAD_PIN",
      "value": "1234",
      "description": "PIN protection",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
