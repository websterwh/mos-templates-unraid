{
  "name": "CamViewerPlus",
  "repo": "fanman03/camviewerplus:0.0.6",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/fanman03/camviewerplus/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6980]/",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/camviewerplus.png",
  "project": "https://github.com/Fanman03/CamViewerPlus",
  "description": "A customizable browser-based RTSP viewer with multiple grid views Edit the JSON config in the config folder after the container is started once. https://github.com/Fanman03/CamViewerPlus",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/camviewerplus",
      "container": "/usr/src/camviewerplus/conf",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Client6900",
      "host": "6900",
      "container": "6900",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Client6900udp",
      "host": "6900",
      "container": "6900",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "WebUI",
      "host": "6980",
      "container": "6980",
      "protocol": "tcp",
      "description": "Container WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
