{
  "name": "Docker-Github-Actions-Runner",
  "repo": "myoung34/github-runner:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/myoung34/github-runner",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/github-runner-icon.png",
  "project": "https://github.com/myoung34/docker-github-actions-runner",
  "description": "A self-hosted GitHub Actions runner.",
  "paths": [
    {
      "name": "Runner Temp Data Path",
      "host": "/tmp/runner",
      "container": "/tmp/runner",
      "mode": "rw",
      "description": "Path to temporary data. This MUST be the same on both the host and inside the container!",
      "required": true
    },
    {
      "name": "Persistent Files",
      "host": "/mnt/cache/appdata/github_runner/persistent_files",
      "container": "/runner/persistent_files",
      "mode": "rw",
      "description": "Path to persistent files",
      "required": true
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Path to the Docker socket",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Repository URL",
      "key": "REPO_URL",
      "value": "https://github.com/example/repo",
      "description": "URL of the GitHub repository",
      "required": true,
      "mask": false
    },
    {
      "name": "Runner Name",
      "key": "RUNNER_NAME",
      "value": "",
      "description": "Name of the runner",
      "required": true,
      "mask": false
    },
    {
      "name": "Runner Token",
      "key": "RUNNER_TOKEN",
      "value": "",
      "description": "Token for the runner",
      "required": true,
      "mask": true
    },
    {
      "name": "Runner Group",
      "key": "RUNNER_GROUP",
      "value": "",
      "description": "Group for the runner (GitHub Enterprise Only)",
      "required": false,
      "mask": false
    },
    {
      "name": "Runner Scope",
      "key": "RUNNER_SCOPE",
      "value": "repo",
      "description": "Scope for the runner",
      "required": true,
      "mask": false
    },
    {
      "name": "Labels",
      "key": "LABELS",
      "value": "",
      "description": "Comma-separated list of labels for the runner",
      "required": false,
      "mask": false
    },
    {
      "name": "Runner Working Directory",
      "key": "RUNNER_WORKDIR",
      "value": "/",
      "description": "Working directory for the runner",
      "required": true,
      "mask": false
    },
    {
      "name": "Runner Labels",
      "key": "RUNNER_LABELS",
      "value": "",
      "description": "Labels for the runner",
      "required": true,
      "mask": false
    },
    {
      "name": "Persistent Files Internal Path",
      "key": "CONFIGURED_ACTIONS_RUNNER_FILES_DIR",
      "value": "/runner/persistent_files",
      "description": "Internal path to the persistent files directory",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
