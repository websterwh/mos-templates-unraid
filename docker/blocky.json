{
  "name": "blocky",
  "repo": "spx01/blocky",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/spx01/blocky",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN --restart=unless-stopped --hostname blocky",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:53]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/blocky-logo.png",
  "project": "https://github.com/0xERR0R/blocky",
  "description": "Blocky is a DNS proxy and ad-blocker for the local network written in Go Create new config.yaml with your configuration ( see https://0xerr0r.github.io/blocky/configuration/ for more details and all configuration options).",
  "paths": [
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "Optional to synchronize the log timestamp with host",
      "required": false
    },
    {
      "name": "Config Dir",
      "host": "/mnt/cache/appdata/blocky/config",
      "container": "/app/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Logs Dir",
      "host": "/mnt/cache/appdata/blocky/logs",
      "container": "/logs",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "DNS Port TCP",
      "host": "53",
      "container": "53",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DNS Port UDP",
      "host": "53",
      "container": "53",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "America/Toronto",
      "description": "Time Zone",
      "required": false,
      "mask": false
    },
    {
      "name": "Config File location",
      "key": "BLOCKY_CONFIG_FILE",
      "value": "/app/config/config.yml",
      "description": "Location of the config file in the container",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
