{
  "name": "languagetool",
  "repo": "erikvl87/languagetool",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/erikvl87/languagetool/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8010]",
  "icon": "https://raw.githubusercontent.com/ArieDed/unraid-template/master/img/languagetool_icon.png",
  "project": "https://github.com/languagetool-org/languagetool",
  "description": "LanguageTool is an Open Source proofreading software for English, French, German, Polish, Russian, and more than 20 other languages. It finds many errors that a simple spell checker cannot detect. LanguageTool can make use of large n-gram data sets to detect errors with words that are often confused. To add the ngram data to the docker, download the languages you want from here: https://languagetool.org/download/ngram-data/, move it to your server and link the location in the container path /ngrams. By default, this is set to the appdata folder. More information on ngram data can be found here: https://dev.languagetool.org/finding-errors-using-n-gram-data",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/languagetool",
      "container": "/ngrams",
      "mode": "rw",
      "description": "Container Path: /ngrams",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8010",
      "container": "8010",
      "protocol": "tcp",
      "description": "Container Port: 8010",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "langtool ngrams",
      "key": "langtool_languageModel",
      "value": "/ngrams",
      "description": "Container Variable: langtool_languageModel",
      "required": false,
      "mask": false
    },
    {
      "name": "Java heap size Min",
      "key": "Java_Xms",
      "value": "256m",
      "description": "Container Variable: Java_Xms",
      "required": false,
      "mask": false
    },
    {
      "name": "Java heap size Max",
      "key": "Java_Xmx",
      "value": "512m",
      "description": "Container Variable: Java_Xmx",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
