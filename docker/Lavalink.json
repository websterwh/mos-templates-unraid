{
  "name": "Lavalink",
  "repo": "fredboat/lavalink:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/fredboat/lavalink",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2333]",
  "icon": "https://serux.pro/9e83af1581.png",
  "project": "https://github.com/freyacodes/Lavalink",
  "description": "Source: https://github.com/freyacodes/Lavalink Before you Deploy please create folder Names \"Lavalink\" /mnt/user/appdata/Lavalink/application.yml and upload application.yml to folder",
  "paths": [
    {
      "name": "Appication.yml",
      "host": "",
      "container": "/opt/Lavalink/application.yml",
      "mode": "rw",
      "description": "Example:https://github.com/freyacodes/Lavalink/blob/master/LavalinkServer/application.yml.example",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "2333",
      "container": "2333",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "JAVA_HOME",
      "key": "JAVA_HOME",
      "value": "/opt/java/openjdk",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LANG",
      "key": "LANG",
      "value": "en_US.UTF-8",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LANGUAGE",
      "key": "LANGUAGE",
      "value": "en_US:en",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LC_ALL",
      "key": "LC_ALL",
      "value": "en_US.UTF-8",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "JAVA_VERSION",
      "key": "JAVA_VERSION",
      "value": "jdk-18.0.2.1+1",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
