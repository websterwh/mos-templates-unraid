{
  "name": "Listmonk",
  "repo": "listmonk/listmonk:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/listmonk/listmonk",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "sh -c ./listmonk --install --idempotent --yes --config  && ./listmonk --upgrade --yes --config  && ./listmonk --config ",
  "web_ui_url": "http://[IP]:[PORT:9000]",
  "icon": "https://github.com/andaks/unraid-templates/blob/master/listmonk/listmonk-logo.png?raw=true",
  "project": "https://listmonk.app/",
  "description": "Self-hosted newsletter and mailing list manager Performance and features packed into a single binary. Free and open source.",
  "paths": [
    {
      "name": "Upload Folder",
      "host": "/mnt/cache/appdata/listmonk/uploads",
      "container": "/listmonk/uploads",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Application Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "App Address",
      "key": "LISTMONK_app__address",
      "value": "0.0.0.0:9000",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DB Host",
      "key": "LISTMONK_db__host",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DB Port",
      "key": "LISTMONK_db__port",
      "value": "5432",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DB Name",
      "key": "LISTMONK_db__database",
      "value": "listmonkdb",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DB User",
      "key": "LISTMONK_db__user",
      "value": "listmonkuser",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DB Password",
      "key": "LISTMONK_db__password",
      "value": "listmonkpass",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "DB SSL Mode",
      "key": "LISTMONK_db__ssl_mode",
      "value": "disable",
      "description": "disable or require",
      "required": false,
      "mask": false
    },
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "Asia/Kuala_Lumpur",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
