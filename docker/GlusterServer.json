{
  "name": "Gluster-Server",
  "repo": "testdasi/gluster-server:latest",
  "category": [
    "Driver"
  ],
  "registry": "https://registry.hub.docker.com/r/testdasi/gluster-server/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://github.com/testdasi/gluster-server/raw/main/gluster.png",
  "project": "https://github.com/testdasi/gluster-server",
  "description": "A docker running gluster server. This allows me to use a folder in the Unraid cache pool as persistent storage for Kubernetes / Docker Swarm through glusterfs. It works way better than NFS, especially for high-availability applications. For more detail readme, please refer to https://github.com/testdasi/gluster-server",
  "paths": [
    {
      "name": "Metadata",
      "host": "/mnt/cache/appdata/gluster-server/metadata",
      "container": "/var/lib/glusterd",
      "mode": "rw",
      "description": "Container Path: /var/lib/glusterd",
      "required": false
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/gluster-server/config",
      "container": "/etc/glusterfs",
      "mode": "rw",
      "description": "Container Path: /etc/glusterfs",
      "required": false
    },
    {
      "name": "Log",
      "host": "/mnt/cache/appdata/gluster-server/log",
      "container": "/var/log/glusterfs",
      "mode": "rw",
      "description": "Container Path: /var/log/glusterfs",
      "required": false
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/gluster-server/data",
      "container": "/gluster",
      "mode": "rw",
      "description": "Container Path: /gluster",
      "required": false
    },
    {
      "name": "Host file (remove if not required)",
      "host": "/mnt/cache/appdata/gluster-server/hosts",
      "container": "/etc/hosts",
      "mode": "rw",
      "description": "Container Path: /etc/hosts",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "BRICK_PORT_RANGE",
      "key": "BRICK_PORT_RANGE",
      "value": "49152-49162",
      "description": "Container Variable: BRICK_PORT_RANGE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
