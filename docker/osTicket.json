{
  "name": "osTicket",
  "repo": "osticket/osticket",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/osticket/osticket",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/loony2392/unraid-templates/master/icons/osticket.png",
  "project": "https://github.com/pi0/osticket-docker",
  "description": "osTicket is a widely-used open source support ticket system. It seamlessly integrates inquiries created via email, phone and web-based forms into a simple easy-to-use multi-user web interface. Manage, organize and archive all your support requests and responses in one place while providing your customers with accountability and responsiveness they deserve.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/osticket",
      "container": "/var/www/src/",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEB Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MYSQL_HOST",
      "key": "MYSQL_HOST",
      "value": "mariadb",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_USER",
      "key": "MYSQL_USER",
      "value": "osticket",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_DATABASE",
      "key": "MYSQL_DATABASE",
      "value": "osticket",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_PASSWORD",
      "key": "MYSQL_PASSWORD",
      "value": "secret",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "INSTALL_NAME",
      "key": "INSTALL_NAME",
      "value": "My Helpdesk",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_FIRSTNAME",
      "key": "ADMIN_FIRSTNAME",
      "value": "Admin",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_LASTNAME",
      "key": "ADMIN_LASTNAME",
      "value": "User",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_EMAIL",
      "key": "ADMIN_EMAIL",
      "value": "admin@example.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_USERNAME",
      "key": "ADMIN_USERNAME",
      "value": "Admin1",
