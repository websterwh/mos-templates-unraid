{
  "name": "Lemmy-Postgres",
  "repo": "pgautoupgrade/pgautoupgrade:16-alpine",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/pgautoupgrade/pgautoupgrade/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "-c session_preload_libraries=auto_explain -c auto_explain.log_min_duration=5ms -c auto_explain.log_analyze=true -c auto_explain.log_triggers=true -c track_activity_query_size=1048576",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5433]",
  "icon": "https://www.postgresql.org/media/img/about/press/elephant.png",
  "project": "https://www.postgresql.org/",
  "description": "PostgreSQL database for Lemmy with auto-upgrade support.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/lemmy/postgres",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "Database storage location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "PostgreSQL Port",
      "host": "5433",
      "container": "5432",
      "protocol": "tcp",
      "description": "Database port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "lemmy",
      "description": "Database username",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "password",
      "description": "Database password",
      "required": true,
      "mask": true
    },
    {
      "name": "POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "lemmy",
      "description": "Database name",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
