{
  "name": "backuppc",
  "repo": "tiredofit/backuppc:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/tiredofit/backuppc/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/backuppc.png",
  "project": "https://backuppc.github.io/backuppc/index.html",
  "description": "BackupPC is a high-performance, enterprise-grade system for backing up Linux, Windows and macOS PCs and laptops to a server's disk.",
  "paths": [
    {
      "name": "Backup Location",
      "host": "/mnt/cache/backuppc/",
      "container": "/var/lib/backuppc",
      "mode": "rw",
      "description": "Backup Location",
      "required": true
    },
    {
      "name": "Configuration Files",
      "host": "/mnt/cache/appdata/backuppc/config/",
      "container": "/etc/backuppc",
      "mode": "rw",
      "description": "Configuration Files",
      "required": true
    },
    {
      "name": "Home Directory",
      "host": "/mnt/cache/appdata/backuppc/ssh/",
      "container": "/home/backuppc",
      "mode": "rw",
      "description": "Home Directory for Backuppc (SSH Keys)",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/backuppc/logs/",
      "container": "/www/logs",
      "mode": "rw",
      "description": "Logs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "UID",
      "key": "USER_BACKUPPC",
      "value": "99",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GROUP_BACKUPPC",
      "value": "100",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
