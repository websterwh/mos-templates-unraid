{
  "name": "tt-rss",
  "repo": "lunik1/tt-rss:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/lunik1/tt-rss/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/tt-rss.png",
  "project": "https://github.com/lunik1/docker-tt-rss",
  "description": "A fork of the deprecated linuxserver.io tt-rss container. The default username and password after initial configuration is admin/password",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/tt-rss",
      "container": "/config",
      "mode": "rw",
      "description": "AppData",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TTRSS_DB_TYPE",
      "key": "TTRSS_DB_TYPE",
      "value": "mysql",
      "description": "TTRSS_DB_TYPE",
      "required": false,
      "mask": false
    },
    {
      "name": "TTRSS_DB_HOST",
      "key": "TTRSS_DB_HOST",
      "value": "192.168.0.100",
      "description": "Database IP (Change it)",
      "required": false,
      "mask": false
    },
    {
      "name": "TTRSS_DB_USER",
      "key": "TTRSS_DB_USER",
      "value": "root",
      "description": "TTRSS_DB_USER",
      "required": false,
      "mask": false
    },
    {
      "name": "TTRSS_DB_NAME",
      "key": "TTRSS_DB_NAME",
      "value": "tt-rss",
      "description": "TTRSS_DB_NAME",
      "required": false,
      "mask": false
    },
    {
      "name": "TTRSS_DB_PASS",
      "key": "TTRSS_DB_PASS",
      "value": "dbpassword",
      "description": "TTRSS_DB_PASS",
      "required": false,
      "mask": false
    },
    {
      "name": "TTRSS_DB_PORT",
      "key": "TTRSS_DB_PORT",
      "value": "3306",
      "description": "TTRSS_DB_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "TTRSS_SELF_URL_PATH",
      "key": "TTRSS_SELF_URL_PATH",
      "value": "http://192.168.0.100:8000/",
      "description": "TTRSS_SELF_URL_PATH",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
