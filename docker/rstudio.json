{
  "name": "rstudio",
  "repo": "rocker/rstudio",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/rocker/rstudio/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8787]",
  "icon": "https://avatars0.githubusercontent.com/u/9100160?v=3&s=200",
  "project": "https://github.com/rocker-org/rocker-versioned",
  "description": "***NOTE*** First run is slow. RStudio Server with an emphasis on reproducibility. Builds on debian stable (debian:jessie for versions < 3.4.0, debian:stretch after, etc) release. This stack installs a fixed version of R itself from source and it installs all R packages from a fixed snapshot of CRAN at a given date. Users should include the version tag, e.g. rocker/rstudio:3.3.1 when reproduciblity is paramount.",
  "paths": [
    {
      "name": "User Data Directory",
      "host": "/mnt/user",
      "container": "/home/rstudio/Documents",
      "mode": "rw",
      "description": "Shared folder for saving your files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8787",
      "container": "8787",
      "protocol": "tcp",
      "description": "Container Port: 8787",
      "required": false,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "3838",
      "container": "3838",
      "protocol": "tcp",
      "description": "Required for shiny server",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": "yourpasswordhere",
      "description": "Container Variable: PASSWORD",
      "required": true,
      "mask": false
    },
    {
      "name": "Root",
      "key": "ROOT",
      "value": "FALSE",
      "description": "Give the user root permissions",
      "required": false,
      "mask": false
    },
    {
      "name": "Add Shiny Server",
      "key": "ADD",
      "value": "shiny",
      "description": "Input 'shiny' without quotes to add shiny server",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
