{
  "name": "goaccess",
  "repo": "allinurl/goaccess",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/allinurl/goaccess/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "/var/log/access.log --log-format=COMBINED -o /var/www/goaccess/index.html --real-time-html --port=7890",
  "web_ui_url": "http://[IP]:[PORT:7890]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/goaccess.png",
  "project": "https://goaccess.io/",
  "description": "GoAccess is a real-time web log analyzer and interactive viewer that runs in a terminal in *nix systems or through your browser.",
  "paths": [
    {
      "name": "Log Location",
      "host": "",
      "container": "/var/log",
      "mode": "rw",
      "description": "Location for an access.log file",
      "required": true
    },
    {
      "name": "Report Location",
      "host": "/mnt/cache/appdata/goaccess/reports",
      "container": "/var/www/goaccess",
      "mode": "rw",
      "description": "Report Output Location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "7890",
      "container": "7890",
      "protocol": "tcp",
      "description": "Container Port: 7890",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
