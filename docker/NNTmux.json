{
  "name": "NNTmux",
  "repo": "rapidmark/nntmux:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/rapidmark/nntmux",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--stop-timeout 120",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/RapidMark/unraid-templates/main/icon.png",
  "project": "https://github.com/NNTmux/newznab-tmux",
  "description": "NNTmux Usenet indexer in a single container. Bundles MariaDB, Redis and Manticore plus the web UI, queue workers, scheduler and the tmux indexing engine. First run creates the database and admin user from the variables below, so fill in the NNTP and Admin settings before starting. Config, database and search data live in /config. NZBs and covers live in /data.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/nntmux",
      "container": "/config",
      "mode": "rw",
      "description": "Settings, database, Redis and Manticore data",
      "required": true
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/nntmux/data",
      "container": "/data",
      "mode": "rw",
      "description": "NZB files and cover images. Grows large, put it on the array if you like.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8085",
      "container": "80",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User id the services run as",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group id the services run as",
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": "Timezone, for example America/Chicago",
      "required": true,
      "mask": false
    },
    {
      "name": "Site URL",
      "key": "APP_URL",
      "value": "http://localhost:8085",
      "description": "URL you will use to reach the site, including port",
      "required": true,
      "mask": false
    },
    {
      "name": "NNTP Server",
      "key": "NNTP_SERVER",
      "value": "",
      "description": "Usenet provider hostname",
      "required": true,
      "mask": false
    },
    {
      "name": "NNTP Port",
      "key": "NNTP_PORT",
      "value": "563",
      "description": "563 for SSL, 119 for plain",
      "required": true,
      "mask": false
    },
    {
      "name": "NNTP SSL",
      "key": "NNTP_SSLENABLED",
      "value": "true",
      "description": "true or false",
      "required": true,
      "mask": false
    },
    {
      "name": "NNTP Username",
      "key": "NNTP_USERNAME",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "NNTP Password",
      "key": "NNTP_PASSWORD",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "NNTP Connections",
      "key": "NNTP_CONNECTIONS",
      "value": "10",
      "description": "Connections your provider allows",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Username",
      "key": "ADMIN_USER",
      "value": "admin",
      "description": "Created on first run",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "ADMIN_PASS",
      "value": "",
      "description": "At least 12 characters. Used on first run only.",
      "required": true,
      "mask": true
    },
    {
      "name": "Admin Email",
      "key": "ADMIN_EMAIL",
      "value": "",
      "description": "Created on first run",
      "required": true,
      "mask": false
    },
    {
      "name": "Start indexer",
      "key": "START_INDEXER",
      "value": "true",
      "description": "Set false to run only the web UI without the tmux indexing engine",
      "required": false,
      "mask": false
    },
    {
      "name": "MariaDB buffer pool",
      "key": "DB_INNODB_BUFFER_POOL_SIZE",
      "value": "1G",
      "description": "InnoDB buffer pool size, raise on a box with spare RAM",
      "required": false,
      "mask": false
    },
    {
      "name": "TMDB API key",
      "key": "TMDB_APIKEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "TVDB API key",
      "key": "TVDB_APIKEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "OMDB API key",
      "key": "OMDB_APIKEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "Fanart.tv API key",
      "key": "FANARTTV_APIKEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "Trakt API key",
      "key": "TRAKTTV_APIKEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
