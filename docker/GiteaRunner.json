{
  "name": "Gitea-Runner",
  "repo": "gitea/act_runner",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/gitea/act_runner",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://avatars.githubusercontent.com/u/54465427?v=4",
  "project": "https://gitea.com/gitea/act_runner",
  "description": "A runner for Gitea based on act.",
  "paths": [
    {
      "name": "Data Storage Path",
      "host": "/mnt/cache/appdata/gitea-runner",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Docker Sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "GITEA_INSTANCE_URL",
      "key": "GITEA_INSTANCE_URL",
      "value": "GITEA_URL",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "GITEA_RUNNER_REGISTRATION_TOKEN",
      "key": "GITEA_RUNNER_REGISTRATION_TOKEN",
      "value": "GITEA_TOKEN",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
