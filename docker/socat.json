{
  "name": "socat",
  "repo": "tynor88/socat",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/tynor88/socat/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--expose 443",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:443]",
  "icon": "https://raw.githubusercontent.com/tynor88/docker-templates/master/images/socat_small.png",
  "project": "http://www.dest-unreach.org/socat/",
  "description": "Socat is a command line based utility that establishes two bidirectional byte streams and transfers data between them.",
  "paths": [],
  "ports": [
    {
      "name": "Listening port",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "The port to listen for TCP4 connections",
      "required": true,
      "mask": false
    },
    {
      "name": "Forwarding port",
      "host": "100",
      "container": "PGID",
      "protocol": "tcp",
      "description": "The port to redirect / forward TCP4 connections to",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
