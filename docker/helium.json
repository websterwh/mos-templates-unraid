{
  "name": "helium",
  "repo": "lscr.io/linuxserver/helium",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/helium",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:3001]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/helium-logo.png",
  "project": "https://helium.computer/",
  "description": "Helium(https://helium.computer/) is a Chromium-based web browser made for people, with love. Privacy-first with unbiased ad-blocking.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Users home directory in the container, stores local files and settings",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "HTTP Helium desktop gui, must be proxied.",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 3001",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "HTTPS Helium desktop gui.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "HELIUM_CLI",
      "key": "HELIUM_CLI",
      "value": "https://www.linuxserver.io/",
      "description": "Specify one or multiple Chromium CLI flags, this string will be passed to the application in full.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
