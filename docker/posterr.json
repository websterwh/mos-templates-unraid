{
  "name": "posterr",
  "repo": "petersem/posterr",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/petersem/posterr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://github.com/petersem/posterr/blob/master/public/favicons/android-chrome-512x512.png?raw=true",
  "project": "https://github.com/petersem/posterr",
  "description": "Media poster display software for Plex, Sonarr, Radarr, and Readarr. (Just like the display screens in movie theatre foyers)",
  "paths": [
    {
      "name": "Config folder",
      "host": "/mnt/cache/appdata/posterr",
      "container": "/usr/src/app/config",
      "mode": "rw",
      "description": "Path for Posterr config files",
      "required": true
    },
    {
      "name": "Custom picture folder",
      "host": "/mnt/cache/appdata/posterr/custom",
      "container": "/usr/src/app/public/custom",
      "mode": "rw",
      "description": "Path for custom pictures",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "9876",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "",
      "description": "Your local TZ timezone (List of tz database time zones - https://en.wikipedia.org/wiki/List_of_tz_database_time_zones). Example: Australia/Brisbane",
      "required": true,
      "mask": false
    },
    {
      "name": "Base path",
      "key": "BASEPATH",
      "value": "",
      "description": "[Optional] Only needed if using a reverse proxy with a sub path for posterr. eg https:/myapps.xyz/poster",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
