{
  "name": "deluge-exporter",
  "repo": "ngosang/deluge-exporter",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/ngosang/deluge-exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8011]",
  "icon": "https://raw.githubusercontent.com/wupasscat/unraid-images/main/deluge-exporter.png",
  "project": "https://github.com/ngosang/deluge-exporter",
  "description": "Prometheus exporter for the Deluge Bittorrent client. It is designed to use the Deluge Web API and to be lightweight.",
  "paths": [],
  "ports": [
    {
      "name": "Listen Port",
      "host": "8011",
      "container": "8011",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Deluge Web UI",
      "key": "DELUGE_URL",
      "value": "",
      "description": "example: http://192.168.1.191:8112",
      "required": true,
      "mask": false
    },
    {
      "name": "Deluge Web UI Password",
      "key": "DELUGE_PASSWORD",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
