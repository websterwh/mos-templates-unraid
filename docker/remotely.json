{
  "name": "remotely",
  "repo": "immybot/remotely",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/immybot/remotely",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/marzel1/docker-templates/main/marzel/img/remotely.png",
  "project": "https://github.com/immense/Remotely",
  "description": "A remote control and remote scripting solution, built with .NET 6, Blazor, and SignalR Core.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/remotely",
      "container": "/app/AppData",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "9280",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ASPNETCORE_HTTP_PORTS",
      "key": "ASPNETCORE_HTTP_PORTS",
      "value": "5000",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Remotely_ApplicationOptions__DbProvider",
      "key": "Remotely_ApplicationOptions__DbProvider",
      "value": "SQLite",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Remotely_ConnectionStrings__SQLite",
      "key": "Remotely_ConnectionStrings__SQLite",
      "value": "Data Source=/app/AppData/Remotely.db",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": [
    {
      "name": "ASPNETCORE_ENVIRONMENT",
      "value": "Production",
      "description": null
    }
  ]
}
