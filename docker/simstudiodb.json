{
  "name": "simstudio-db",
  "repo": "pgvector/pgvector:pg17",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/pgvector/pgvector",
  "network": "simstudio_internal",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--health-cmd=pg_isready -U postgres --health-interval=10s --health-retries=5 --health-start-period=30s --health-timeout=5s",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://raw.githubusercontent.com/simstudioai/sim/main/apps/sim/public/logo/primary/rounded.png",
  "project": "https://pgvector.org",
  "description": "PostgreSQL 17 with pgvector extension for Sim Studio vector embeddings and semantic search. This is the required database backend for Sim Studio. pgvector enables fast similarity search on embeddings and is essential for AI-powered features like semantic search and vector similarity matching in Sim Studio.",
  "paths": [
    {
      "name": "Path: Database Data",
      "host": "/mnt/cache/appdata/simstudio-db/",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "PostgreSQL data directory. Must be on local SSD/NVMe for performance.",
      "required": true
    },
    {
      "name": "Path: Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "Timezone sync from host (read-only)",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port: PostgreSQL",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "PostgreSQL database port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "--- Database ---",
      "key": "--- Database ---",
      "value": "",
      "description": "PostgreSQL settings for Sim Studio.",
      "required": false,
      "mask": false
    },
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "postgres",
      "description": "Database superuser username",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "postgres",
      "description": "Database password. Use strong password. Only A-Za-z0-9 recommended for compatibility.",
      "required": true,
      "mask": true
    },
    {
      "name": "POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "simstudio",
      "description": "Initial database name",
      "required": true,
      "mask": false
    },
    {
      "name": "--- System ---",
      "key": "--- System ---",
      "value": "",
      "description": "Timezone configuration.",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: TZ",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Timezone. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
