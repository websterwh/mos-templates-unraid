{
  "name": "koboldcpp",
  "repo": "koboldai/koboldcpp",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/koboldai/koboldcpp/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5001]/",
  "icon": "https://raw.githubusercontent.com/LostRuins/koboldcpp/refs/heads/concedo/niko.ico",
  "project": "https://github.com/oromis995/UnraidKoboldCpp/tree/main",
  "description": "KoboldCpp is a lightweight but powerful AI backend, bundled with KoboldAI Lite frontend. https://hub.docker.com/r/koboldai/koboldcpp/",
  "paths": [
    {
      "name": "Workspace",
      "host": "",
      "container": "/workspace",
      "mode": "rw",
      "description": "This is where your docker data will be stored. Models and binaries will be saved here.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "5002",
      "container": "5001",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Don't Remote Tunnel",
      "key": "KCPP_DONT_TUNNEL",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KCPP_ARGS",
      "key": "KCPP_ARGS",
      "value": "--model https://huggingface.co/concedo/KobbleTinyV2-1.1B-GGUF/resolve/main/KobbleTiny-Q4_K.gguf",
      "description": "This is where we add run variables. '--model' accepts URL's and filenames.",
      "required": false,
      "mask": false
    },
    {
      "name": "Don't Update Kobold on Launch",
      "key": "KCPP_DONT_UPDATE",
      "value": "false",
      "description": "The Docker container update is a separate update. This just updates the binary.",
      "required": false,
      "mask": false
    },
    {
      "name": "Retain Models on Restart",
      "key": "KCPP_DONT_REMOVE_MODELS",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
