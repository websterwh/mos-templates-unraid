{
  "name": "RoonServer",
  "repo": "ghcr.io/roonlabs/roonserver:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/roonlabs/roon-docker/pkgs/container/roonserver",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--restart unless-stopped --log-opt max-size=50m --log-opt max-file=3",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:34885]",
  "icon": "https://raw.githubusercontent.com/xthursdayx/docker-templates/master/xthursdayx/images/roon-icon.png",
  "project": "https://github.com/RoonLabs/roon-docker",
  "description": "Docker image for running Roon Server. Roon Server is a software package that provides a \u201cheadless\u201d version of Roon. It will be the brain of your music system, managing your music files, streaming services, and your audio devices. Roon Server is used in conjunction with Roon or Roon Remote, both of which provide control functionality.",
  "paths": [
    {
      "name": "Music",
      "host": "/mnt/cache/data/media/music/",
      "container": "/music",
      "mode": "rw",
      "description": "Default music folder",
      "required": true
    },
    {
      "name": "Backup",
      "host": "/mnt/cache/data/backup/roon_backup/",
      "container": "/backup",
      "mode": "rw",
      "description": "Roon backup destination (optional). Configure in Settings &gt; Backups.",
      "required": false
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/roonserver/",
      "container": "/Roon",
      "mode": "rw",
      "description": "RoonServer state \u2014 database, settings, identity, and application binaries. Must be writable and persistent.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Roon ARC",
      "host": "34885",
      "container": "34885",
      "protocol": "tcp",
      "description": "Remote Listening Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ROON_INSTALL_BRANCH",
      "key": "ROON_INSTALL_BRANCH",
      "value": "production",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/Toronto",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
