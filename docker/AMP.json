{
  "name": "AMP",
  "repo": "mitchtalmadge/amp-dockerized",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/mitchtalmadge/amp-dockerized/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/amp.png",
  "project": "https://github.com/MitchTalmadge/AMP-dockerized",
  "description": "CubeCoders AMP in a Docker Image! Manage servers like Minecraft, Valheim, TF2, and more. Requires paid license from CubeCoders.com",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/amp",
      "container": "/home/amp/",
      "mode": "rw",
      "description": "Container Path: /home/amp/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web Interface Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Username",
      "key": "USERNAME",
      "value": "admin",
      "description": "The username of the admin user created on first boot.",
      "required": true,
      "mask": false
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": "password",
      "description": "The password of the admin user. This value is only used when creating the new user. If you use the default value, please change it after first sign-in.",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Detroit",
      "description": "Container Variable: TZ",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
