{
  "name": "OttrBox",
  "repo": "ghcr.io/aottr/ottrbox:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/aottr/ottrbox",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/aottr/ottrbox/main/docs/static/img/pingvinshare.svg",
  "project": "https://github.com/aottr/ottrbox",
  "description": "OttrBox is a self-hosted file sharing platform and an alternative for WeTransfer.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/ottrbox/data",
      "container": "/opt/app/backend/data",
      "mode": "rw",
      "description": "Path to store uploaded files",
      "required": true
    },
    {
      "name": "Images Path",
      "host": "/mnt/cache/appdata/ottrbox/images",
      "container": "/opt/app/frontend/public/img",
      "mode": "rw",
      "description": "Path to store image files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Behind Reverse Proxy",
      "key": "TRUST_PROXY",
      "value": "false|true",
      "description": "Set to true if running behind a reverse proxy",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
