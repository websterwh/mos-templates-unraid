{
  "name": "FMD2-wine",
  "repo": "banhcanh/docker-fmd2:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/banhcanh/docker-fmd2/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6080]/",
  "icon": "https://github.com/GlassedSilver/unRAID-CAs/raw/master/FMD2-wine/fmd2_logo.png",
  "project": "https://github.com/Banh-Canh/docker-FMD2",
  "description": "**FMD2:** This is an active fork of the Free Manga Downloader which is a free open source application written in Object Pascal for managing and downloading manga from various websites. (App Author's Description) **About this container:** Dockerized FMD2 (Windows with Wine) using VNC, noVNC and webSocketify to display GUI on a webpage. > (\u2139) *Make sure to configure it using the 'web' ui.* ### Features: - Does not require any display, works headless - Keeps all of FMD2 features - Since it's docker, it works on Linux - Make use of Linuxserver alpine base image",
  "paths": [
    {
      "name": "Download Directory",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Container Path: /downloads",
      "required": true
    },
    {
      "name": "App LUA Modules Path",
      "host": "/mnt/cache/appdata/fmd2-wine/lua",
      "container": "/app/FMD2/lua",
      "mode": "rw",
      "description": "Container Path: /app/FMD2/lua",
      "required": true
    },
    {
      "name": "App FMD2 Internal DB",
      "host": "/mnt/cache/appdata/fmd2-wine/data",
      "container": "/app/FMD2/data",
      "mode": "rw",
      "description": "Container Path: /app/FMD2/data",
      "required": true
    },
    {
      "name": "App Wine Config",
      "host": "/mnt/cache/appdata/fmd2-wine/wine",
      "container": "/config/.wine",
      "mode": "rw",
      "description": "Container Path: /config/.wine",
      "required": true
    },
    {
      "name": "App userdata",
      "host": "/mnt/cache/appdata/fmd2-wine/userdata",
      "container": "/app/FMD2/userdata",
      "mode": "rw",
      "description": "Container Path: /app/FMD2/userdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6080",
      "container": "6080",
      "protocol": "tcp",
      "description": "Container Port: 6080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "Container Variable: UMASK",
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "",
      "description": "Set your Time Zone here (e.g. Europe/Berlin)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
