{
  "name": "Thrifty---UI",
  "repo": "tiehfood/thrifty-ui:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/tiehfood/thrifty-ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/thrifty-icon.png",
  "project": "https://github.com/tiehfood/thrifty",
  "description": "A simple web application that helps you manage your income and expenses. It's focused on simplicity and is not aimed to track every single penny you spend. The idea is to get a rough overview of your monthly cash flow and what's left to spend. This is the frontend component of the Thrifty stack. It is designed to be used in conjunction with the Thrifty API.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API Port",
      "key": "LOCAL_API_PORT",
      "value": "8081",
      "description": "Port of the API container",
      "required": true,
      "mask": false
    },
    {
      "name": "Currency",
      "key": "CURRENCY_ISO",
      "value": "USD",
      "description": "Currency ISO code (e.g. USD, EUR)",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
