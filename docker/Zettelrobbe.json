{
  "name": "Zettelrobbe",
  "repo": "admonstrator/zettelrobbe:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/admonstrator/zettelrobbe",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/admonstrator/zettelrobbe/refs/heads/main/public/logo.png",
  "project": "https://zettelrob.be/",
  "description": "An automated document analyzer for Paperless-ngx using OpenAI API and Ollama (Mistral, llama, phi 3, gemma 2) to automatically analyze and tag your documents.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/paperless-ai",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to app data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
