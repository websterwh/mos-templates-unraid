{
  "name": "AppDaemon",
  "repo": "acockburn/appdaemon",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/acockburn/appdaemon",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5050]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/appdaemon.png",
  "project": "http://appdaemon.readthedocs.io/",
  "description": "HADashboard and Python apps for Home Assistant. Note that you MUST manually edit your auto-generated appdaemon.yaml file to add a few required settings. See support threat here for an example: https://lime-technology.com/forums/topic/72041-support-appdaemon-hadashboard-corneliousjd-repo/",
  "paths": [
    {
      "name": "Configuration Path",
      "host": "/mnt/cache/appdata/appdaemon",
      "container": "/conf",
      "mode": "rw",
      "description": "Container Path: /conf",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5050",
      "container": "5050",
      "protocol": "tcp",
      "description": "Container Port: 5050",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Home Assistant URL",
      "key": "HA_URL",
      "value": "http://X.X.X.X:8123",
      "description": "Your local Home Assistant URL. (NO trailing / at the end!)",
      "required": true,
      "mask": false
    },
    {
      "name": "Token",
      "key": "TOKEN",
      "value": "",
      "description": "Home Assistant Long Lived Access Tokens",
      "required": false,
      "mask": true
    },
    {
      "name": "Dashboard URL",
      "key": "DASH_URL",
      "value": "http://$HOSTNAME:5050",
      "description": "This should be left as-is.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
