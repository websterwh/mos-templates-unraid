{
  "name": "PostgREST",
  "repo": "postgrest/postgrest:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/postgrest/postgrest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/postgrest-icon.png",
  "project": "https://postgrest.org",
  "description": "PostgREST serves a fully RESTful API from any existing PostgreSQL database. It provides a cleaner, more standards-compliant, faster API than you are likely to write from scratch. There are a number of additional configurable options via environmental variables. See documentation: https://docs.postgrest.org/en/latest/references/configuration.html#config-full-list",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database Connection URI",
      "key": "PGRST_DB_URI",
      "value": "postgres://USERNAME:PASSWORD@IP_ADDRESS:5432/database",
      "description": "Database connection URI for Postgres",
      "required": true,
      "mask": false
    },
    {
      "name": "API Proxy",
      "key": "PGRST_OPENAPI_SERVER_PROXY_URI",
      "value": "http://127.0.0.1:3000",
      "description": "Internal API proxy URL. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
