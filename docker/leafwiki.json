{
  "name": "leafwiki",
  "repo": "ghcr.io/perber/leafwiki:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/perber/leafwiki/blob/main/readme.md",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/icons/refs/heads/main/leafwiki.png",
  "project": "https://github.com/perber/leafwiki",
  "description": "LeafWiki \u2013 A fast wiki for people who think in folders, not feeds Single Go binary. Markdown on disk. No external database service. LeafWiki is a lightweight, self-hosted wiki for runbooks, internal docs, and technical notes \u2014 built for fast writing and explicit structure. It keeps your content as plain Markdown on disk and gives you fast navigation, search, and editing \u2014 without running additional services.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/leafwiki",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "LEAFWIKI_ADMIN_PASSWORD",
      "key": "LEAFWIKI_ADMIN_PASSWORD",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "LEAFWIKI_JWT_SECRET",
      "key": "LEAFWIKI_JWT_SECRET",
      "value": "",
      "description": "Long random string",
      "required": true,
      "mask": true
    },
    {
      "name": "LEAFWIKI_PUBLIC_ACCESS",
      "key": "LEAFWIKI_PUBLIC_ACCESS",
      "value": "false",
      "description": "Allow public read-only access",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_ALLOW_INSECURE",
      "key": "LEAFWIKI_ALLOW_INSECURE",
      "value": "false",
      "description": "Disables Secure &amp; HttpOnly cookies (required for HTTP)",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_ENABLE_REVISION",
      "key": "LEAFWIKI_ENABLE_REVISION",
      "value": "false",
      "description": "Enable revision history",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_MAX_REVISION_HISTORY",
      "key": "LEAFWIKI_MAX_REVISION_HISTORY",
      "value": "100",
      "description": "Max revisions per page; 0 = unlimited",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_ENABLE_LINK_REFACTOR",
      "key": "LEAFWIKI_ENABLE_LINK_REFACTOR",
      "value": "false",
      "description": "Link rewriting on rename/move",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_HIDE_LINK_METADATA_SECTION",
      "key": "LEAFWIKI_HIDE_LINK_METADATA_SECTION",
      "value": "false",
      "description": "Hide backlinks and link status panel",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_DISABLE_AUTH",
      "key": "LEAFWIKI_DISABLE_AUTH",
      "value": "false",
      "description": "Disable authentication",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_ACCESS_TOKEN_TIMEOUT",
      "key": "LEAFWIKI_ACCESS_TOKEN_TIMEOUT",
      "value": "15m",
      "description": "Access token duration",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_REFRESH_TOKEN_TIMEOUT",
      "key": "LEAFWIKI_REFRESH_TOKEN_TIMEOUT",
      "value": "168h",
      "description": "Refresh token duration",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAFWIKI_PORT",
      "key": "LEAFWIKI_PORT",
      "value": "8080",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
