{
  "name": "DiscordGSM",
  "repo": "discordgsm/discord-game-server-monitor:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/discordgsm/discord-game-server-monitor",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "python3 -u main.py",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/DiscordGSM/DiscordGSM/master/images/discordgsm.png",
  "project": "https://discordgsm.com/",
  "description": "A discord bot that monitors your game server and tracks the live data of your game servers.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/discordgsm/",
      "container": "/usr/src/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Discord Bot Token",
      "key": "APP_TOKEN",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Discord Guild ID",
      "key": "WHITELIST_GUILDS",
      "value": "",
      "description": "if more than one, separate with",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
