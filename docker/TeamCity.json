{
  "name": "TeamCity",
  "repo": "jetbrains/teamcity-server",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/jetbrains/teamcity-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8111]/",
  "icon": "https://seeklogo.com/images/T/team-city-logo-8FEEB62EC1-seeklogo.com.png",
  "project": "https://hub.docker.com/r/jetbrains/teamcity-server/",
  "description": "TeamCity Server - Powerful Continuous Integration and Continuous Delivery out of the box This is an official JetBrains TeamCity server image. The image is suitable for production use and evaluation purposes.",
  "paths": [
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/teamcity/logs",
      "container": "/opt/teamcity/logs",
      "mode": "rw",
      "description": "Container Path: /opt/teamcity/logs",
      "required": false
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/teamcity/datadir",
      "container": "/data/teamcity_server/datadir",
      "mode": "rw",
      "description": "Container Path: /data/teamcity_server/datadir",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8111",
      "container": "8111",
      "protocol": "tcp",
      "description": "Container Port: 8111",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
