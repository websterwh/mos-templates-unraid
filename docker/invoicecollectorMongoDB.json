{
  "name": "invoice-collector-MongoDB",
  "repo": "mongo:8.0.3",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/_/mongo/",
  "network": "invoice-collector_internal",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--hostname=mongodb",
  "post_parameters": "--logpath /dev/null",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/mongodb-logo.png",
  "project": "https://www.mongodb.com/",
  "description": "MongoDB is a cross-platform document-oriented NoSQL database. This container provides the MongoDB backend required by invoice-collector. It stores application data and is intended to run on the same Docker network (invoice-collector_internal) as the invoice-collector container.",
  "paths": [
    {
      "name": "MongoDB Data",
      "host": "/mnt/cache/appdata/invoice-collector-mongodb",
      "container": "/data/db",
      "mode": "rw",
      "description": "Directory used to store MongoDB database files.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "--- System ---",
      "key": "--- System ---",
      "value": "",
      "description": "System configuration.",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: TZ",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Timezone. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
