{
  "name": "shlink-web-client",
  "repo": "shlinkio/shlink-web-client:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/shlinkio/shlink-web-client/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/shlink-web-client.png",
  "project": "https://www.github.com/shlinkio/shlink-web-client",
  "description": "A ReactJS-based progressive web application for shlink. 1. Install shlink 2. CLI to it and enter \"shlink api-key:generate\" 3. Copy the api and add and edit to servers.json",
  "paths": [
    {
      "name": "Server Config File",
      "host": "/mnt/cache/appdata/shlink-web/servers.json",
      "container": "/usr/share/nginx/html/servers.json",
      "mode": "rw",
      "description": "Server Config File (Must be created first before applying the docker template) https://hub.docker.com/r/shlinkio/shlink-web-client/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
