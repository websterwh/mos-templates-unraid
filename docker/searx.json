{
  "name": "searx",
  "repo": "searx/searx:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/searx/searx/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/searx.png",
  "project": "https://github.com/asciimoo/searx",
  "description": "Searx is a free internet metasearch engine which aggregates results from more than 70 search services. Users are neither tracked nor profiled. Additionally, searx can be used over Tor for online anonymity.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/searx/",
      "container": "/etc/searx",
      "mode": "rw",
      "description": "Contain config files",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
