{
  "name": "Tambaqui",
  "repo": "ghcr.io/koalitos/tambaqui:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/koalitos/tambaqui/pkgs/container/tambaqui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/koalitos/tambaqui/main/docs/icon.png",
  "project": "https://github.com/koalitos/tambaqui",
  "description": "Tambaqui - IA brasileira de c\u00f3digo com API OpenAI-compat\u00edvel. Baixa modelos HuggingFace (Qwen, DeepSeek, CodeLlama), chat com busca web, streaming, admin web. Funciona com Open WebUI, Continue.dev, LibreChat e qualquer client OpenAI.",
  "paths": [
    {
      "name": "Modelos",
      "host": "/mnt/cache/appdata/tambaqui/modelos",
      "container": "/app/modelos",
      "mode": "rw",
      "description": "Pasta dos modelos HuggingFace",
      "required": true
    },
    {
      "name": "Dados",
      "host": "/mnt/cache/appdata/tambaqui/dados",
      "container": "/app/dados",
      "mode": "rw",
      "description": "Dados: users, sess\u00f5es, conversas",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Porta da interface web e API",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin User",
      "key": "TAMBAQUI_ADMIN_USER",
      "value": "admin",
      "description": "Usu\u00e1rio admin padr\u00e3o",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "TAMBAQUI_ADMIN_PASS",
      "value": "tambaqui",
      "description": "Senha do admin (troque!)",
      "required": true,
      "mask": true
    },
    {
      "name": "NVIDIA Visible Devices",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": "GPU NVIDIA vis\u00edvel (use a imagem :cuda)",
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA Capabilities",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "compute,utility",
      "description": "Capacidades do driver NVIDIA",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
