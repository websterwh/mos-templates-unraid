{
  "name": "timelite",
  "repo": "pyguy/timelite",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/pyguy/timelite/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/overshard/timelite/master/public/static/logo.png",
  "project": "https://github.com/overshard/timelite",
  "description": "Timelite is a Node.js application designed to help individuals and teams track their time spent on different tasks and projects. It provides a simple and intuitive interface for users to create projects, add tasks, and start and stop timers to track their work.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/timelite",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8008",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Node Version",
      "key": "NODE_VERSION",
      "value": "14.4.0",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Yarn Version",
      "key": "YARN_VERSION",
      "value": "1.22.4",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
