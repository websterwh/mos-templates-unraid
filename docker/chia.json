{
  "name": "chia",
  "repo": "ghcr.io/chia-network/chia",
  "category": [
    "Crypto"
  ],
  "registry": "https://github.com/orgs/chia-network/packages/container/package/chia",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8444]",
  "icon": "https://raw.githubusercontent.com/PartitionPixel/unraid-templates/main/PartitionPixel/chia-icon.png",
  "project": "https://www.chia.net/",
  "description": "This template uses the official Chia-Docker. Chia-Docker is a containerised version of the Chia Blockchain (no GUI) for HDD Farming. Helps turn your Unraid server into a XCH / cryptocurrency farming rig.",
  "paths": [
    {
      "name": "plots",
      "host": "",
      "container": "/plots",
      "mode": "rw",
      "description": "Container Path: /plots",
      "required": true
    },
    {
      "name": "plotting",
      "host": "",
      "container": "/plotting",
      "mode": "rw",
      "description": "Container Path: /plotting",
      "required": false
    },
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/chia/",
      "container": "/root/.chia",
      "mode": "rw",
      "description": "Container Path: /root/.chia",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "chia_protocol",
      "host": "8444",
      "container": "8444",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": true,
      "mask": false
    },
    {
      "name": "chia_rpc",
      "host": "8555",
      "container": "8555",
      "protocol": "tcp",
      "description": "Container Port: 8555",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "mnemonic",
      "key": "keys",
      "value": "/root/.chia/mnemonic.txt",
      "description": "Container Variable: keys",
      "required": false,
      "mask": false
    },
    {
      "name": "full_node_port",
      "key": "full_node_port",
      "value": "",
      "description": "Container Variable: full_node_port",
      "required": false,
      "mask": false
    },
    {
      "name": "farmer_address",
      "key": "farmer_address",
      "value": "",
      "description": "Container Variable: farmer_address",
      "required": false,
      "mask": false
    },
    {
      "name": "farmer_port",
      "key": "farmer_port",
      "value": "",
      "description": "Container Variable: farmer_port",
      "required": false,
      "mask": false
    },
    {
      "name": "testnet",
      "key": "testnet",
      "value": "false",
      "description": "Container Variable: testnet",
      "required": false,
      "mask": false
    },
    {
      "name": "farmer_only",
      "key": "farmer",
      "value": "false",
      "description": "Container Variable: farmer",
      "required": false,
      "mask": false
    },
    {
      "name": "harvester_only",
      "key": "harvester",
      "value": "false",
      "description": "Container Variable: harvester",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
