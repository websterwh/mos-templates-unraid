{
  "name": "silabs-multipan-thread",
  "repo": "b2un0/silabs-multipan-docker",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/b2un0/silabs-multipan-docker/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/silabs_logo.png",
  "project": "https://github.com/b2un0/silabs-multipan-docker",
  "description": "Standalone version of the Silicon Labs multiprotocol addon for Home Assistant. The cool kids that run it all in docker containers! An EFR based chipset Thread stick is required for this container to start. It needs to be passed in as the same value you provide such as the default of /dev/thread using a line such as /dev/serial/by-id/usb-Nabu_Casa_SkyConnect_v1.0_76f624b636edec1191324740ad51a8b2-if00-port0:/dev/thread",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/silabs-multipan",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Device Path",
      "key": "DEVICE",
      "value": "/dev/thread",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Device Baud",
      "key": "BAUDRATE",
      "value": "460800",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Backbone Ethernet",
      "key": "BACKBONE_IF",
      "value": "eth0",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "OTBR Listen Port",
      "key": "OTBR_REST_LISTEN_PORT",
      "value": "8081",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "OTBR Web Port",
      "key": "OTBR_WEB_PORT",
      "value": "8087",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "EZSP Listen",
      "key": "EZSP_LISTEN_PORT",
      "value": "20108",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "Dongle Passthrough",
      "host": "/dev/serial/by-id/usb-Nabu_Casa_SkyConnect_v1.0_76f624b636edec1191324740ad51a8b2-if00-port0:/dev/thread",
      "container": "",
      "description": null,
      "required": true
    }
  ],
  "labels": []
}
