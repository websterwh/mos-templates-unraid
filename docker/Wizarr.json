{
  "name": "Wizarr",
  "repo": "ghcr.io/wizarrrr/wizarr",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/wizarrrr/wizarr/pkgs/container/wizarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5690]/",
  "icon": "https://github.com/wizarrrr/wizarr/raw/main/app/static/wizarr-logo.png",
  "project": "https://github.com/wizarrrr/wizarr",
  "description": "The official Wizarr Container. Wizarr is a automatic user invitation system for Plex. Create a unique link and share it to a user and they will automatically be invited to your Plex Server!",
  "paths": [
    {
      "name": "Database Folder",
      "host": "/mnt/cache/appdata/wizarr/database",
      "container": "/data/database",
      "mode": "rw",
      "description": "Database Folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5690",
      "container": "5690",
      "protocol": "tcp",
      "description": "Web Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "User to run application as",
      "key": "PUID",
      "value": "500",
      "description": "Leave as default if you are unsure.",
      "required": true,
      "mask": false
    },
    {
      "name": "Group to run application as",
      "key": "PGID",
      "value": "500",
      "description": "Leave as default if you are unsure",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable In-Built Auth",
      "key": "DISABLE_BUILTIN_AUTH",
      "value": "false",
      "description": "Only set to true if you are using another Authentication method, see docs",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
