      "value": "kgnxVTupNpPO1F9j8sPcwiM0eQnSWkxOmgGXlUFoqaU",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "ENV VAR DATABASE_URL",
      "key": "DATABASE_URL",
