{
  "name": "TextBee---API",
  "repo": "ghcr.io/vernu/textbee/api:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/vernu/textbee/api",
  "network": "bridge",
  "custom_ip": null,
