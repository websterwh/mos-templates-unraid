{
  "name": "bookbounty",
  "repo": "thewicklowwolf/bookbounty:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/thewicklowwolf/bookbounty",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/icons/f140eab75e20d8d91766ab49cac3a7c59b443aa5/bookbounty.png",
  "project": "https://github.com/TheWicklowWolf/BookBounty",
  "description": "Web GUI for finding missing Readarr books.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/bookbounty",
      "container": "/bookbounty/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/bookbounty/",
      "container": "/bookbounty/downloads",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Readarr URL",
      "key": "readarr_address",
      "value": "http://192.168.1.2:8787",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Readarr API Key",
      "key": "readarr_api_key",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Timeout",
      "key": "request_timeout",
      "value": "120",
      "description": "Timeout for requests in seconds.",
      "required": false,
      "mask": false
    },
    {
      "name": "Language",
      "key": "selected_language",
      "value": "English",
      "description": "Filter for download by language",
      "required": false,
      "mask": false
    },
    {
      "name": "Preferred Extension Fiction",
      "key": "preferred_extensions_fiction",
      "value": ".epub, .mobi, .azw3, .djvu",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Library Scan on Completion",
      "key": "library_scan_on_completion",
      "value": "True",
      "description": "Whether to scan Readarr Library on completion (True or False)",
      "required": false,
      "mask": false
    },
    {
      "name": "Search Type",
      "key": "search_type",
      "value": "fiction",
      "description": "Search type (fiction or non-fiction)",
      "required": false,
      "mask": false
    },
    {
      "name": "Minimum Match Ratio",
      "key": "minimum_match_ratio",
      "value": "90",
      "description": "Minimum percentage for a match.",
      "required": false,
      "mask": false
    },
    {
      "name": "Sync Schedule",
      "key": "sync_schedule",
      "value": "",
      "description": "Scheduled times to run in comma separated values. (24hr)",
      "required": false,
      "mask": false
    },
    {
      "name": "Sleep Interval",
      "key": "sleep_interval",
      "value": "0",
      "description": "Interval to sleep between downloads in seconds",
      "required": false,
      "mask": false
    },
    {
      "name": "Libgen URL",
      "key": "libgen_address",
      "value": "https://libgen.is",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Selected Path Type",
      "key": "selected_path_type",
      "value": "file",
      "description": "Select download structure (file or folder)",
      "required": false,
      "mask": false
    },
    {
      "name": "Preferred Extension Non-Fiction",
      "key": "preferred_extensions_non_fiction",
      "value": ".pdf, .epub, .mobi, .azw3, .djvu",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
