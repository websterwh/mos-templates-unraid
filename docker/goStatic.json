{
  "name": "goStatic",
  "repo": "pierrezemb/gostatic",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/pierrezemb/gostatic",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8043]/",
  "icon": "https://raw.githubusercontent.com/redvex2460/docker-templates/master/redvex2460/images/docker.png",
  "project": "https://hub.docker.com/r/pierrezemb/gostatic",
  "description": "A really small static web server for Docker The goal My goal is to create to smallest docker container for my web static files. The advantage of Go is that you can generate a fully static binary, so that you don't need anything else.",
  "paths": [
    {
      "name": "WWW-Folder",
      "host": "/mnt/cache/Appdata/goStatic",
      "container": "/srv/http",
      "mode": "rw",
      "description": "Place here your folder where the WWW-Folder should be placed",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebPort",
      "host": "8043",
      "container": "8043",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
