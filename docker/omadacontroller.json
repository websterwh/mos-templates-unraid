{
  "name": "omada-controller",
  "repo": "mbentley/omada-controller",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/mbentley/omada-controller/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--ulimit nofile=4096:8192",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:18043]/login",
  "icon": "https://raw.githubusercontent.com/benhedrington/hedrington-unraid-docker-templates/main/hedrington-unraid-docker-templates/omada-controller.png",
  "project": "https://hub.docker.com/r/mbentley/omada-controller",
  "description": "Docker image to run TP-Link Omada SDN Controller to control TP-Link Omada EAP Series Wireless Access Points -- tplink, omada, sdn",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/omada-controller/data/",
      "container": "/opt/tplink/EAPController/data",
      "mode": "rw,slave",
      "description": "Container Path: /opt/tplink/EAPController/data",
      "required": false
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/omada-controller/work/",
      "container": "/opt/tplink/EAPController/work",
      "mode": "rw,slave",
      "description": "Container Path: /opt/tplink/EAPController/work",
      "required": false
    },
    {
      "name": "Host Path 3",
      "host": "/mnt/cache/appdata/omada-controller/logs/",
      "container": "/opt/tplink/EAPController/logs",
      "mode": "rw,slave",
      "description": "Container Path: /opt/tplink/EAPController/logs",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "MANAGE_HTTPS_PORT",
      "key": "MANAGE_HTTPS_PORT",
      "value": "18043",
      "description": "Default: 8043",
      "required": false,
      "mask": false
    },
    {
      "name": "MANAGE_HTTP_PORT",
      "key": "MANAGE_HTTP_PORT",
      "value": "18088",
      "description": "Default: 8088",
      "required": false,
      "mask": false
    },
    {
      "name": "PORTAL_HTTPS_PORT",
      "key": "PORTAL_HTTPS_PORT",
      "value": "18843",
      "description": "Default: 8843",
      "required": false,
      "mask": false
    },
    {
      "name": "PORTAL_HTTP_PORT",
      "key": "PORTAL_HTTP_PORT",
      "value": "18088",
      "description": "Default: 8088",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
