{
  "name": "omada-controller",
  "repo": "mbentley/omada-controller:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/mbentley/omada-controller/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--stop-timeout 60 --ulimit nofile=4096:8192 --cpus 2 --memory 4g --memory-swap 5g",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:8043",
  "icon": "https://static.tp-link.com/2019/201907/20190710/Icon_Omada.jpg",
  "project": "https://www.tp-link.com/us/business-networking/omada-sdn-controller/",
  "description": "TP-Link Omada SDN Software Controller \u2014 centrally manages Omada EAPs, switches, and gateways. Community Docker image maintained by mbentley. Bundles its own MongoDB so no separate DB container needed. Defaults to host networking for reliable device discovery and adoption.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/omada-controller/data",
      "container": "/opt/tplink/EAPController/data",
      "mode": "rw",
      "description": "Persistent storage for controller database and config.",
      "required": true
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/omada-controller/logs",
      "container": "/opt/tplink/EAPController/logs",
      "mode": "rw",
      "description": "Controller log files.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTPS Management Port",
      "host": "8043",
      "container": "8043",
      "protocol": "tcp",
      "description": "HTTPS port for controller web UI.",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTP Management Port",
      "host": "8088",
      "container": "8088",
      "protocol": "tcp",
      "description": "HTTP port for controller web UI and portal.",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS Portal Port",
      "host": "8843",
      "container": "8843",
      "protocol": "tcp",
      "description": "HTTPS captive portal port.",
      "required": false,
      "mask": false
    },
    {
      "name": "EAP Discovery Legacy UDP",
      "host": "19810",
      "container": "19810",
      "protocol": "udp",
      "description": "Legacy EAP discovery. Required for older Omada devices.",
      "required": false,
      "mask": false
    },
    {
      "name": "App Discovery UDP",
      "host": "27001",
      "container": "27001",
      "protocol": "udp",
      "description": "Omada app discovery port.",
      "required": false,
      "mask": false
    },
    {
      "name": "Device Discovery UDP",
      "host": "29810",
      "container": "29810",
      "protocol": "udp",
      "description": "Primary EAP device discovery. Do not change.",
      "required": false,
      "mask": false
    },
    {
      "name": "Manager V1 TCP",
      "host": "29811",
      "container": "29811",
      "protocol": "tcp",
      "description": "EAP management port v1.",
      "required": false,
      "mask": false
    },
    {
      "name": "Manager V2 TCP",
      "host": "29812",
      "container": "29812",
      "protocol": "tcp",
      "description": "EAP adoption port.",
      "required": false,
      "mask": false
    },
    {
      "name": "Manager V3 TCP",
      "host": "29813",
      "container": "29813",
      "protocol": "tcp",
      "description": "EAP management port v3.",
      "required": false,
      "mask": false
    },
    {
      "name": "Manager V4 TCP",
      "host": "29814",
      "container": "29814",
      "protocol": "tcp",
      "description": "EAP management port v4.",
      "required": false,
      "mask": false
    },
    {
      "name": "Device Monitor TCP",
      "host": "29815",
      "container": "29815",
      "protocol": "tcp",
      "description": "Device monitor port.",
      "required": false,
      "mask": false
    },
    {
      "name": "Remote Control TCP",
      "host": "29816",
      "container": "29816",
      "protocol": "tcp",
      "description": "Remote control port.",
      "required": false,
      "mask": false
    },
    {
      "name": "Data Transfer TCP",
      "host": "29817",
      "container": "29817",
      "protocol": "tcp",
      "description": "Data transfer port.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Denver",
      "description": "Your timezone.",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID. 99 = nobody on Unraid.",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID. 100 = users on Unraid.",
      "required": false,
      "mask": false
    },
    {
      "name": "Override Web Config on Restart",
      "key": "WEB_CONFIG_OVERRIDE",
      "value": "false",
      "description": "Set to true to re-apply env var port changes on every restart instead of just first boot.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
