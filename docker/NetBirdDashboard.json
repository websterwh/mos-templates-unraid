{
  "name": "NetBird-Dashboard",
  "repo": "netbirdio/dashboard:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/netbirdio/dashboard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/realitymolder/unraid-templates/main/templates/img/netbird-dashboard.svg",
  "project": "https://github.com/netbirdio/netbird",
  "description": "NetBird web dashboard for managing peers, networks, access policies, and users in your self-hosted mesh VPN. Requires the NetBird-Server container and a reverse proxy for TLS.",
  "paths": [],
  "ports": [
    {
      "name": "Web Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Dashboard web UI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API Endpoint",
      "key": "NETBIRD_MGMT_API_ENDPOINT",
      "value": "https://netbird.yourdomain.com",
      "description": "Public HTTPS URL of the management REST API",
      "required": true,
      "mask": false
    },
    {
      "name": "gRPC Endpoint",
      "key": "NETBIRD_MGMT_GRPC_API_ENDPOINT",
      "value": "https://netbird.yourdomain.com",
      "description": "Public HTTPS URL of the management gRPC API (same as API endpoint)",
      "required": true,
      "mask": false
    },
    {
      "name": "Auth Authority",
      "key": "AUTH_AUTHORITY",
      "value": "https://netbird.yourdomain.com/oauth2",
      "description": "OIDC issuer URL (embedded IdP lives at /oauth2)",
      "required": true,
      "mask": false
    },
    {
      "name": "Client ID",
      "key": "AUTH_CLIENT_ID",
      "value": "netbird-dashboard",
      "description": "OAuth2 client ID registered with the IdP",
      "required": false,
      "mask": false
    },
    {
      "name": "Audience",
      "key": "AUTH_AUDIENCE",
      "value": "netbird-dashboard",
      "description": "OAuth2 audience claim",
      "required": false,
      "mask": false
    },
    {
      "name": "Scopes",
      "key": "AUTH_SUPPORTED_SCOPES",
      "value": "openid profile email groups",
      "description": "OAuth2 scopes to request",
      "required": false,
      "mask": false
    },
    {
      "name": "Let's Encrypt Domain",
      "key": "LETSENCRYPT_DOMAIN",
      "value": "none",
      "description": "Set to 'none' when behind a reverse proxy (most setups), or your domain for standalone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
