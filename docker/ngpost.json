{
  "name": "ngpost",
  "repo": "ghcr.io/xompage/ngpost",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/xompage/ngpost/pkgs/container/ngpost",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7070]",
  "icon": "https://raw.githubusercontent.com/xompage/unraid-templates/master/xompage/icons/ngpost.png",
  "project": "https://github.com/mbruel/ngPost",
  "description": "ngPost(https://github.com/mbruel/ngPost) is a command-line and a minimalist GUI usenet poster for binaries developped in C++/QT designed to be as fast as possible and offer all the main features to post data easily and safely. Includes patches to fix the yenc header filename obfuscation when using article obfuscation (credits to anon for the original fix).",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Host Path for /output",
      "host": "",
      "container": "/output",
      "mode": "rw",
      "description": "Location for the logs and nzbs",
      "required": true
    },
    {
      "name": "Host Path for /storage",
      "host": "",
      "container": "/storage",
      "mode": "rw",
      "description": "Location of the data to post",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port for 7070",
      "host": "7070",
      "container": "7070",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
