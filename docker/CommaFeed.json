{
  "name": "CommaFeed",
  "repo": "athou/commafeed:latest-h2",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/athou/commafeed",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8082]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/commafeed-icon.png",
  "project": "https://www.commafeed.com",
  "description": "Google Reader inspired self-hosted RSS reader, based on Quarkus and React/TypeScript.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/commafeed/data",
      "container": "/commafeed/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8082",
      "container": "8082",
      "protocol": "tcp",
      "description": "Container Port: 8082",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
