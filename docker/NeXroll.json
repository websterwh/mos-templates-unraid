{
  "name": "NeXroll",
  "repo": "jbrns/nexroll:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jbrns/nexroll",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9393]",
  "icon": "https://raw.githubusercontent.com/JFLXCLOUD/NeXroll/main/NeXroll/icon_1758297097_256x256.png",
  "project": "https://github.com/JFLXCLOUD/NeXroll",
  "description": "NeXroll is a modern preroll manager for Plex and Jellyfin featuring automatic scheduling, category organization, visual sequence builder, and community preroll integration. Upload videos, create schedules, and manage your cinema experience with an intuitive web interface.",
  "paths": [
    {
      "name": "Application Data",
      "host": "/mnt/cache/appdata/nexroll",
      "container": "/data",
      "mode": "rw",
      "description": "Database, logs, and application data storage",
      "required": true
    },
    {
      "name": "Preroll Storage",
      "host": "/mnt/cache/media/prerolls",
      "container": "/data/prerolls",
      "mode": "rw",
      "description": "Directory where preroll videos are stored. Must be accessible by your media server.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "9393",
      "container": "9393",
      "protocol": "tcp",
      "description": "Web interface port for NeXroll",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Timezone for scheduling (e.g., America/New_York, Europe/London)",
      "required": false,
      "mask": false
    },
    {
      "name": "Application Port",
      "key": "NEXROLL_PORT",
      "value": "9393",
      "description": "Internal application port (usually leave as 9393)",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Directory",
      "key": "NEXROLL_DB_DIR",
      "value": "/data",
      "description": "Database storage location inside container",
      "required": false,
      "mask": false
    },
    {
      "name": "Preroll Path (Internal)",
      "key": "NEXROLL_PREROLL_PATH",
      "value": "/data/prerolls",
      "description": "Preroll directory path inside container",
      "required": false,
      "mask": false
    },
    {
      "name": "Secrets Directory",
      "key": "NEXROLL_SECRETS_DIR",
      "value": "/data",
      "description": "Secure storage for tokens inside container",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file permissions",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file permissions",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
