{
  "name": "Forgejo",
  "repo": "codeberg.org/forgejo/forgejo:11",
  "category": [
    "Backup"
  ],
  "registry": "https://codeberg.org/forgejo/-/packages/container/forgejo/versions",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/forgejo.png",
  "project": "https://forgejo.org/",
  "description": "Forgejo is a self-hosted lightweight software forge. Easy to install and low maintenance, it just does the job. Brought to you by an inclusive community under the umbrella of Codeberg e.V., a democratic non-profit organization, Forgejo can be trusted to be exclusively Free Software. It is a \"soft\" fork of Gitea with a focus on scaling, federation and privacy.",
  "paths": [
    {
      "name": "Data Storage Path",
      "host": "/mnt/cache/appdata/forgejo",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Git over SSH",
      "host": "22",
      "container": "22",
      "protocol": "tcp",
      "description": "Container Port: 22",
      "required": true,
      "mask": false
    },
    {
      "name": "WebUI and Git over HTTP",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
