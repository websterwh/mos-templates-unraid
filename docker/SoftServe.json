{
  "name": "Soft-Serve",
  "repo": "charmcli/soft-serve:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/charmcli/soft-serve",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:23231]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/softserve-icon.png",
  "project": "https://github.com/charmbracelet/soft-serve",
  "description": "The mighty, self-hostable Git server for the command line",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/softserve",
      "container": "/soft-serve",
      "mode": "rw",
      "description": "Storage for config file, databases and repos",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "SSH Port",
      "host": "23231",
      "container": "23231",
      "protocol": "tcp",
      "description": "Container Port: 23231",
      "required": true,
      "mask": false
    },
    {
      "name": "23232",
      "host": "23232",
      "container": "23232",
      "protocol": "tcp",
      "description": "Container Port: 23232",
      "required": true,
      "mask": false
    },
    {
      "name": "23233",
      "host": "23233",
      "container": "23233",
      "protocol": "tcp",
      "description": "Container Port: 23233",
      "required": true,
      "mask": false
    },
    {
      "name": "9418",
      "host": "9418",
      "container": "9418",
      "protocol": "tcp",
      "description": "Container Port: 9418",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
