{
  "name": "kodbox",
  "repo": "kodcloud/kodbox:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/kodcloud/kodbox",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/kalcaddle/kodbox/master/static/images/icon/icon_512.png",
  "project": "https://github.com/kalcaddle/kodbox/",
  "description": "KodBox can be used to access and share your files, and kodbox support hundreds of file formats for online preview, editing, and playback.",
  "paths": [
    {
      "name": "HTML/PHP Files",
      "host": "/mnt/cache/appdata/kodbox/html",
      "container": "/var/www/html",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebGUI Port",
      "host": "8668",
      "container": "80",
      "protocol": "tcp",
      "description": "Only use for bridge network",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
