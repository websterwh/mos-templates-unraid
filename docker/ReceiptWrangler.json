{
  "name": "Receipt-Wrangler",
  "repo": "noah231515/receipt-wrangler:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/repository/docker/noah231515/receipt-wrangler/general",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://avatars.githubusercontent.com/u/141039354?s=400&u=614387191a483eef308dbb696ce76fc74f6878dc&v=4",
  "project": "https://github.com/Receipt-Wrangler",
  "description": "Receipt Wrangler is your easy-to-use, self-hosted receipt management solution. Simplify your expenses and take control of your financial data with these powerful features: * Effortless Receipt Creation: Quickly create receipts with the help of OCR/AI image scanning. * Smart Categorization: Organize receipts for easy filtering. * Collaborative Tracking: Share receipts and track expenses among multiple users. * Email Integration: Seamlessly upload receipts directly from your email, web app, and mobile app (coming soon). Follow the installation guide at https://receiptwrangler.io/docs/category/getting-started to get started.",
  "paths": [
    {
      "name": "Sqlite path",
      "host": "",
      "container": "/app/receipt-wrangler-api/sqlite",
      "mode": "rw,shared",
      "description": "Directory to store sqlite database",
      "required": false
    },
    {
      "name": "Logs path",
      "host": "",
      "container": "/app/receipt-wrangler-api/logs",
      "mode": "rw",
      "description": "Directory to store application logs",
      "required": false
    },
    {
      "name": "Data path",
      "host": "",
      "container": "/app/receipt-wrangler-api/data",
      "mode": "rw",
      "description": "Directory to store application images",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "9080",
      "container": "80",
      "protocol": "tcp",
      "description": "Port for web ui",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ENCRYPTION_KEY",
      "key": "ENCRYPTION_KEY",
      "value": "",
      "description": "Encryption key for encrypting sensitive data",
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Secret key used for validating jwts",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "Database host",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "0",
      "description": "Database port",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "",
      "description": "Database user",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "Database password",
      "required": false,
      "mask": true
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "",
      "description": "Name of database",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_ENGINE",
      "key": "DB_ENGINE",
      "value": "sqlite",
      "description": "Sets which database to use",
      "required": true,
      "mask": false
