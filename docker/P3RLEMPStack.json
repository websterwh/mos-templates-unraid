{
  "name": "P3R-LEMP-Stack",
  "repo": "p3rco/lemp:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/p3rco/lemp",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/P3R-CO/unraid/master/LEMP-P3R-256px.png",
  "project": "https://github.com/P3R-CO/lemp-container",
  "description": "P3R LEMP Stack is an All-In-One container built on Debian with NGINX, MariaDB, and PHP7.3 all pre-loaded.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/P3R-LEMP-Stack/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
