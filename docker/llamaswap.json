{
  "name": "llama-swap",
  "repo": "ghcr.io/mostlygeek/llama-swap:unified-cuda",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/mostlygeek/llama-swap",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia --gpus all",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/llama-swap-icon.png",
  "project": "https://github.com/mostlygeek/llama-swap",
  "description": "Run multiple generative AI models on your machine and hot-swap between them on demand. llama-swap works with any OpenAI and Anthropic API compatible server and is used by thousands of people to power their local AI workflows.",
  "paths": [
    {
      "name": "Models Storage",
      "host": "/mnt/cache/appdata/llama_swap/models",
      "container": "/models",
      "mode": "rw",
      "description": "Path to models",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9292",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Config File",
      "key": "/etc/llama-swap/config/config.yaml",
      "value": "/mnt/user/appdata/llama_swap/config.yaml",
      "description": "Path to the config file",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
