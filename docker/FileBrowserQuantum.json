{
  "name": "FileBrowserQuantum",
  "repo": "gtstef/filebrowser:stable",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/gtstef/filebrowser",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 1000:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/files",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/filebrowser-quantum.png",
  "project": "https://github.com/gtsteffaniak/filebrowser",
  "description": "FileBrowser Quantum provides an easy way to access and manage your files from the web. It has a modern responsive interface that has many advanced features to manage users, access, sharing, and file preview and editing. This version is called \"Quantum\" because it packs tons of advanced features into a tiny easy to run file. Unlike the majority of alternative options, FileBrowser Quantum is simple to install and easy to configure. https://github.com/gtsteffaniak/filebrowser Config https://github.com/gtsteffaniak/filebrowser/blob/main/frontend/public/config.generated.yaml Read https://filebrowserquantum.com/en/docs/getting-started/",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/FileBrowser Files/",
      "container": "/srv",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "App Path",
      "host": "/mnt/cache/appdata/filebrowserQuantum",
      "container": "/home/filebrowser/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Cache Path",
      "host": "/mnt/cache/appdata/filebrowserQuantum/tmp",
      "container": "/home/filebrowser/data/tmp",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8890",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "FILEBROWSER_CONFIG",
      "key": "FILEBROWSER_CONFIG",
      "value": "data/config.yaml",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
