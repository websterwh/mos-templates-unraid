{
  "name": "healthchecks",
  "repo": "galexrt/healthchecks:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/galexrt/healthchecks/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/healthchecks.png",
  "project": "https://healthchecks.io/",
  "description": "Simple and Effective Cron Job Monitoring",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/healthchecks/",
      "container": "/data",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "/data/hc.sqlite",
      "description": "DB_NAME",
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "ChangeMe",
      "description": "SECRET_KEY",
      "required": true,
      "mask": false
    },
    {
      "name": "PING_EMAIL_DOMAIN",
      "key": "PING_EMAIL_DOMAIN",
      "value": "example.com",
      "description": "PING_EMAIL_DOMAIN",
      "required": true,
      "mask": false
    },
    {
      "name": "SITE_ROOT",
      "key": "SITE_ROOT",
      "value": "http://example.com",
      "description": "SITE_ROOT",
      "required": true,
      "mask": false
    },
    {
      "name": "EMAIL_HOST",
      "key": "EMAIL_HOST",
      "value": "smtp.example.com",
      "description": "EMAIL_HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "EMAIL_PORT",
      "key": "EMAIL_PORT",
      "value": "25",
      "description": "EMAIL_PORT",
      "required": true,
      "mask": false
    },
    {
      "name": "EMAIL_USE_TLS",
      "key": "EMAIL_USE_TLS",
      "value": "True",
      "description": "EMAIL_USE_TLS",
      "required": true,
      "mask": false
    },
    {
      "name": "EMAIL_HOST_USER",
      "key": "EMAIL_HOST_USER",
      "value": "user@example.com",
      "description": "EMAIL_HOST_USER",
      "required": true,
      "mask": false
    },
    {
      "name": "EMAIL_HOST_PASSWORD",
      "key": "EMAIL_HOST_PASSWORD",
      "value": "YOUR_PASSWORD",
      "description": "EMAIL_HOST_PASSWORD",
      "required": true,
      "mask": false
    },
    {
      "name": "ALLOWED_HOSTS",
      "key": "ALLOWED_HOSTS",
      "value": "*",
      "description": "ALLOWED_HOSTS",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
