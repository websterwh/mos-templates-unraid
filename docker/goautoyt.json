{
  "name": "go-auto-yt",
  "repo": "xiovv/go-auto-yt:stable",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/xiovv/go-auto-yt",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/AMJidovu/unraid-repository/master/img/go-auto-yt-dl.png",
  "project": "https://github.com/XiovV/go-auto-yt",
  "description": "GoAutoYT makes it easy for you to automatically download videos from as many YouTube channels as you'd like. Clean, very simple design - The dashboard only contains an input form where you can add a channel and configure checking intervals and what to download, and a little list of all your channels where you can delete them or tell the server to check for new uploads immediately. Everything is on a single page - You can view and control everything from just one page. Makes downloading videos/audio automatically very easy - Just paste a link of a channel you want to download, set a checking interval and that's it, the server will keep checking for new uploads and download if necessary.",
  "paths": [
    {
      "name": "Mounted Downloads Folder",
      "host": "/mnt/cache/appdata/go-auto-yt/downloads",
      "container": "/app/downloads",
      "mode": "rw",
      "description": "Container Path: /app/downloads",
      "required": false
    },
    {
      "name": "Mounted Configuration Folder",
      "host": "/mnt/cache/appdata/go-auto-yt/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Container Path: /app/config",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "9000",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "User Identifier ( PUID )",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "Group ID ( PGID )",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "User File Creation MASK ( UMASK )",
      "key": "UMASK_SET",
      "value": "0022",
      "description": "Container Variable: UMASK_SET",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
