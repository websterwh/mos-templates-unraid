{
  "name": "lynxprompt",
  "repo": "drumsergio/lynxprompt:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/drumsergio/lynxprompt",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/GeiserX/docker-templates/master/drumsergio/images/lynxprompt.png",
  "project": "https://github.com/GeiserX/LynxPrompt",
  "description": "Self-hostable AI configuration management platform for teams and individuals. Supports 30+ AI coding assistants (Cursor, Claude Code, GitHub Copilot, Windsurf, etc.) with a blueprint marketplace, interactive config wizard, and multi-provider authentication. Requires PostgreSQL. The docker-compose includes PostgreSQL, but you can point to an external instance via DATABASE_URL. More info: https://github.com/GeiserX/LynxPrompt",
  "paths": [
    {
      "name": "Uploads",
      "host": "/mnt/cache/appdata/lynxprompt/uploads",
      "container": "/data/uploads",
      "mode": "rw",
      "description": "User-uploaded blueprints and configuration files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "LynxPrompt web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "postgresql://lynxprompt:password@postgres:5432/lynxprompt",
      "description": "PostgreSQL connection string",
      "required": true,
      "mask": false
    },
    {
      "name": "NextAuth Secret",
      "key": "NEXTAUTH_SECRET",
      "value": "",
      "description": "Session encryption key (generate a random string)",
      "required": true,
      "mask": true
    },
    {
      "name": "App URL",
      "key": "APP_URL",
      "value": "http://localhost:3000",
      "description": "Base URL of this instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable AI",
      "key": "ENABLE_AI",
      "value": "false",
      "description": "Enable AI-powered features (requires ANTHROPIC_API_KEY)",
      "required": false,
      "mask": false
    },
    {
      "name": "Anthropic API Key",
      "key": "ANTHROPIC_API_KEY",
      "value": "",
      "description": "Anthropic API key (required when ENABLE_AI=true)",
      "required": false,
      "mask": true
    },
    {
      "name": "Enable Registration",
      "key": "ENABLE_USER_REGISTRATION",
      "value": "true",
      "description": "Allow public user registration",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
