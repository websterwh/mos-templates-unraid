{
  "name": "LANraragi",
  "repo": "difegue/lanraragi",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/difegue/lanraragi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://github.com/Difegue/LANraragi/raw/dev/public/favicon.ico",
  "project": "https://github.com/Difegue/LANraragi",
  "description": "Web application for archival and reading of manga/doujinshi. Lightweight and Docker-ready for NAS/servers. * If you encounter an error while uploading files, please make sure the content folder has write permissions *",
  "paths": [
    {
      "name": "Database",
      "host": "/mnt/cache/appdata/lanraragi/database/",
      "container": "/home/koyomi/lanraragi/database",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Content",
      "host": "/mnt/cache/Manga/",
      "container": "/home/koyomi/lanraragi/content",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
