{
  "name": "pinry",
  "repo": "getpinry/pinry",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/getpinry/pinry/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://github.com/FoxxMD/unraid-docker-templates/raw/master/icons/pinry.png",
  "project": "https://docs.getpinry.com/",
  "description": "A tiling image board system for people who want to save, tag, and share images, videos and webpages in an easy to skim through format. Basically self-hosted Pinterest. Project includes a chrome/firefox extension bookmarklet.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/pinry",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "8438",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
