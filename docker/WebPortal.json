{
  "name": "Web-Portal",
  "repo": "ghcr.io/enchant97/web-portal:2",
  "category": [
    "System"
  ],
  "registry": "https://ghcr.io/enchant97/web-portal",
  "network": "Bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/enchant97/web-portal/main/web_portal/static/favicon.ico",
  "project": "https://enchantedcode.co.uk/web-portal/index.html",
  "description": "Web-Portal is a web app written in Python using Quart, that aims to provide an easy and fast way to manage the links to all of your web services. This project is Copyright (c) 2022 Leo Spratt. License AGPL-3",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/web-portal/",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Plugins",
      "host": "/mnt/cache/appdata/web-portal/plugins",
      "container": "/data/plugins",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_URI",
      "key": "DB_URI",
      "value": "mysql://webportal:PASSWORD@DB/webportal",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ALLOW_ICON_UPLOADS",
      "key": "ALLOW_ICON_UPLOADS",
      "value": "True",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
