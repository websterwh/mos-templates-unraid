{
  "name": "Feishin",
  "repo": "ghcr.io/jeffvli/feishin:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jeffvli/feishin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9180]/",
  "icon": "https://raw.githubusercontent.com/jeffvli/feishin/development/assets/icons/icon.png",
  "project": "https://feishin.vercel.app/",
  "description": "A modern self-hosted music player.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9180",
      "container": "9180",
      "protocol": "tcp",
      "description": "Container Port: 9180",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Name",
      "key": "SERVER_NAME",
      "value": "",
      "description": "Name of your music server",
      "required": false,
      "mask": false
    },
    {
      "name": "Server Type",
      "key": "SERVER_TYPE",
      "value": "jellyfin|navidrome",
      "description": "Type of music server",
      "required": true,
      "mask": false
    },
    {
      "name": "Server URL",
      "key": "SERVER_URL",
      "value": "",
      "description": "URL of your music server (e.g., http://localhost:8096)",
      "required": true,
      "mask": false
    },
    {
      "name": "Lock Settings",
      "key": "SERVER_LOCK",
      "value": "true|false",
      "description": "When enabled, prevents changes to server settings via the web UI",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable Analytics",
      "key": "ANALYTICS_DISABLED",
      "value": "true|false",
      "description": "When enabled, disables anonymous usage analytics",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
