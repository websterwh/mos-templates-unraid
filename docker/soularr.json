{
  "name": "soularr",
  "repo": "mrusse08/soularr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/mrusse08/soularr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8265]/",
  "icon": "https://raw.githubusercontent.com/mrusse/soularr/refs/heads/main/resources/logo.png",
  "project": "https://soularr.net",
  "description": "A Python script that connects Lidarr with Soulseek! Soularr reads all of your \"wanted\" albums/artists from Lidarr and downloads them using Slskd. It uses the libraries: pyarr and slskd-api to make this happen. NOTE: Read through https://github.com/JPDVM2014/soularr before installing template!",
  "paths": [
    {
      "name": "SLSKD Download Dir",
      "host": "/mnt/cache/slskd/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "Set to directory where Slskd downloads are stored.",
      "required": false
    },
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/soularr",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8265",
      "container": "8265",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Run Interval",
      "key": "SCRIPT_INTERVAL",
      "value": "300",
      "description": "Run interval in seconds",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
