{
  "name": "sickchill",
  "repo": "lscr.io/linuxserver/sickchill",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/sickchill",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8081]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/sickchill-logo.png",
  "project": "https://github.com/SickChill/SickChill",
  "description": "Sickchill(https://github.com/SickChill/SickChill) is an Automatic Video Library Manager for TV Shows. It watches for new episodes of your favorite shows, and when they are posted it does its magic.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    },
    {
      "name": "Path: /downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "this will store any downloaded data on the docker host",
      "required": false
    },
    {
      "name": "Path: /tv",
      "host": "",
      "container": "/tv",
      "mode": "rw",
      "description": "this will allow sickchill to view what you already have",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "will map the container's port 8081 to port 8081 on the host",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
