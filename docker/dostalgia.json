{
  "name": "dostalgia",
  "repo": "droideparanoico/dostalgia",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/droideparanoico/dostalgia/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:8765]/",
  "icon": "https://raw.githubusercontent.com/droideparanoico/dostalgia/main/images/icon-512.png",
  "project": "https://github.com/droideparanoico/dostalgia",
  "description": "A nostalgic DOS game hub. Upload your old DOS games, auto-scrape artwork and metadata from IGDB, and play them directly in your browser via js-dos (DOSBox compiled to WebAssembly).",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dostalgia",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8765",
      "container": "8765",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Data directory",
      "key": "DOSTALGIA_DATA_DIR",
      "value": "/data",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Twitch id",
      "key": "TWITCH_CLIENT_ID",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Twitch secret",
      "key": "TWITCH_CLIENT_SECRET",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
