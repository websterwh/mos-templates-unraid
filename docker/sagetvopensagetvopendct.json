{
  "name": "sagetvopen-sagetv-opendct",
  "repo": "sagetvopen/sagetv-opendct",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/sagetvopen/sagetv-opendct/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9091]/",
  "icon": "https://raw.githubusercontent.com/OpenSageTV/sagetv-dockers/master/resources/SageTVOS_icon.png",
  "project": "https://github.com/enternoescape/opendct",
  "description": "An open source digital cable tuner network encoder for SageTV ###Container version: 2.0.7",
  "paths": [
    {
      "name": "OpenDCT Configuration",
      "host": "/mnt/cache/appdata/opendct/etc",
      "container": "/etc/opendct",
      "mode": "rw",
      "description": "Configuration",
      "required": true
    },
    {
      "name": "OpenDCT Log",
      "host": "/mnt/cache/appdata/opendct/log",
      "container": "/var/log/opendct",
      "mode": "rw",
      "description": "Log",
      "required": true
    },
    {
      "name": "OpenDCT Home",
      "host": "/mnt/cache/appdata/opendct/opt",
      "container": "/opt/opendct",
      "mode": "rw",
      "description": "OpenDCT Home",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "OpenDCT WebUI",
      "host": "9091",
      "container": "9091",
      "protocol": "tcp",
      "description": "OpenDCT WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OpenDCT Version",
      "key": "VERSION",
      "value": "latest",
      "description": "OpenDCT Version",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
