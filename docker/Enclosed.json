{
  "name": "Enclosed",
  "repo": "corentinth/enclosed:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/corentinth/enclosed",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8787]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/enclosed-icon.png",
  "project": "https://enclosed.cc",
  "description": "A minimalistic web application designed for sending private and secure notes with end-to-end encryption.",
  "paths": [
    {
      "name": "Config data",
      "host": "/mnt/cache/appdata/enclosed/data",
      "container": "/app/.data",
      "mode": "rw",
      "description": "Config data for application",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8787",
      "container": "8787",
      "protocol": "tcp",
      "description": "Container Port: 8787",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
