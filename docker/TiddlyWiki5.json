{
  "name": "TiddlyWiki5",
  "repo": "mazzolino/tiddlywiki",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/mazzolino/tiddlywiki",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/tquizzle/Docker-xml/master/img/tiddlywiki.png",
  "project": "https://tiddlywiki.com/",
  "description": "Welcome to TiddlyWiki, a non-linear personal web notebook that anyone can use and keep forever, independently of any corporation. TiddlyWiki is a complete interactive wiki in JavaScript. It can be used as a single HTML file in the browser or as a powerful Node.js application. It is highly customisable: the entire user interface is itself implemented in hackable WikiText. Learn more and see it in action at https://tiddlywiki.com/ Developer documentation is in progress at https://tiddlywiki.com/dev/",
  "paths": [
    {
      "name": "Wiki Data",
      "host": "/mnt/cache/appdata/tiddlywiki",
      "container": "/var/lib/tiddlywiki",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Username",
      "key": "USERNAME",
      "value": "user",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": "wiki",
      "description": null,
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
