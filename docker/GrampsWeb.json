{
  "name": "Gramps-Web",
  "repo": "ghcr.io/gramps-project/grampsweb",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/gramps-project/gramps-web/pkgs/container/grampsweb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/gramps-web-icon.png",
  "project": "https://www.grampsweb.org",
  "description": "A modern web app that allows to browse and collaboratively edit a genealogical database, based on and interoperable with the Gramps desktop application.",
  "paths": [
    {
      "name": "Users database path",
      "host": "/mnt/cache/appdata/gramps/users",
      "container": "/app/users",
      "mode": "rw",
      "description": "Users database path",
      "required": true
    },
    {
      "name": "Search index path",
      "host": "/mnt/cache/appdata/gramps/indexdir",
      "container": "/app/indexdir",
      "mode": "rw",
      "description": "Search index path",
      "required": true
    },
    {
      "name": "Thumbnail storage path",
      "host": "/mnt/cache/appdata/gramps/thumbnail_cache",
      "container": "/app/thumbnail_cache",
      "mode": "rw",
      "description": "Thumbnail storage path",
      "required": true
    },
    {
      "name": "Export and report storage path",
      "host": "/mnt/cache/appdata/gramps/cache",
      "container": "/app/cache",
      "mode": "rw",
      "description": "Export and report storage path",
      "required": true
    },
    {
      "name": "Secrets storage path",
      "host": "/mnt/cache/appdata/gramps/secret",
      "container": "/app/secret",
      "mode": "rw",
      "description": "Secrets storage path",
      "required": true
    },
    {
      "name": "Database path",
      "host": "/mnt/cache/appdata/gramps/database",
      "container": "/root/.gramps/grampsdb",
      "mode": "rw",
      "description": "Database path",
      "required": true
    },
    {
      "name": "Media storage path",
      "host": "/mnt/cache/appdata/gramps/media",
      "container": "/app/media",
      "mode": "rw",
      "description": "Media storage path",
      "required": true
    },
    {
      "name": "Temporary storage path",
      "host": "/mnt/cache/appdata/gramps/tmp",
      "container": "/tmp",
      "mode": "rw",
      "description": "Temporary storage path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Tree name",
      "key": "GRAMPSWEB_TREE",
      "value": "Gramps Web",
      "description": "Name of the Gramps tree",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
