{
  "name": "Doku",
  "repo": "amerkurev/doku",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/amerkurev/doku",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9090]",
  "icon": "https://raw.githubusercontent.com/amerkurev/doku/master/web/doku/public/favicon.ico",
  "project": "https://github.com/amerkurev/doku",
  "description": "Doku is a simple, lightweight web-based application that allows you to monitor Docker disk usage in a user-friendly manner. The Doku displays the amount of disk space used by the Docker daemon, splits by images, containers, volumes, and builder cache. If you're lucky, you'll also see the sizes of log files :)",
  "paths": [
    {
      "name": "Docker",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Files for space checking",
      "host": "/mnt/user",
      "container": "/hostroot/mnt/user",
      "mode": "ro",
      "description": null,
      "required": false
    },
    {
      "name": "Docker path for space checking",
      "host": "/var/lib/docker/",
      "container": "/hostroot/var/lib/docker/",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
