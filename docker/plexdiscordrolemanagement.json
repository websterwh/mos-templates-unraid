  "project": "https://github.com/CyaOnDaNet/plex_discord_role_management",
  "description": "A discord bot that synchronizes with Tautulli and Sonarr to deliver tailored notifications. Visit https://discordapp.com/developers/applications/me for Bot Token.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/app/config",
      "mode": "rw",
      "description": "Container Path: /app/config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Webhook Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
