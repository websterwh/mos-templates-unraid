{
  "name": "plex_discord_role_management",
  "repo": "cyaondanet/plex_discord_role_management:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/cyaondanet/plex_discord_role_management",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
