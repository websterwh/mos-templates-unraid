{
  "name": "VGC-shelf",
  "repo": "ghcr.io/mstrlargo/vgc-shelf:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/mstrlargo/vgc-shelf/pkgs/container/vgc-shelf",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/mstrlargo/vgc-shelf/main/icon.png",
  "project": "https://github.com/mstrlargo/vgc-shelf",
  "description": "VGC Shelf (Video Game Collection Shelf) is a self-hosted, open-source video game collection manager designed by collectors, for collectors. Track physical and digital games, systems, peripherals, and collectibles from a central location that you control. No subscriptions, no vendor lock-in, and no dependence on a third-party service to access your collection.",
  "paths": [
    {
      "name": "Uploads",
      "host": "/mnt/cache/appdata/vgc-shelf/uploads/",
      "container": "/app/uploads",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/vgc-shelf/data",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Postgres Database",
      "key": "DATABASE_URL",
      "value": "postgresql://USERNAME:PASSWORD@SERVER:5432/DATABASE?schema=public",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
