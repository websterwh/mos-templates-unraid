{
  "name": "SimpleX-XFTP",
  "repo": "simplexchat/xftp-server",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/simplexchat/xftp-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4443]",
  "icon": "https://avatars.githubusercontent.com/u/59927747?s=200&v=4.png",
  "project": "https://simplex.chat/",
  "description": "Provides the offical XFTP server for SimpleX Chat.",
  "paths": [
    {
      "name": "Path XFTP Config",
      "host": "/mnt/cache/appdata/simplex/xftp/config",
      "container": "/etc/opt/simplex-xftp",
      "mode": "rw,shared",
      "description": "This is where the SimpleX XFTP Config is stored",
      "required": true
    },
    {
      "name": "Path XFTP Logs",
      "host": "/mnt/cache/appdata/simplex/xftp/logs",
      "container": "/var/opt/simplex-xftp",
      "mode": "rw,shared",
      "description": "This is where the SimpleX XFTP Logs are stored",
      "required": true
    },
    {
      "name": "Path XFTP Files",
      "host": "/mnt/cache/appdata/simplex/xftp/files",
      "container": "/srv/xftp",
      "mode": "rw,shared",
      "description": "This is where the SimpleX XFTP Files are stored",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "SimpleX XFTP Port",
      "host": "4443",
      "container": "443",
      "protocol": "tcp",
      "description": "SimpleX XFTP Service Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "IP / Domain",
      "key": "ADDR",
      "value": "localhost",
      "description": "Enter the IP or Domain your Simplex XFTP should run on.",
      "required": true,
      "mask": false
    },
    {
      "name": "Quota",
      "key": "QUOTA",
      "value": "1gb",
      "description": "Set maximum storage to be used by SimpleX XFTP",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
