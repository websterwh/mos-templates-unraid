{
  "name": "myst",
  "repo": "mysteriumnetwork/myst",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/mysteriumnetwork/myst/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--device=/dev/net/tun --cap-add NET_ADMIN",
  "post_parameters": "service --agreed-terms-and-conditions",
  "web_ui_url": "http://[IP]:[PORT:4449]",
  "icon": "https://raw.githubusercontent.com/locus313/unraid-docker-templates/main/templates/img/myst.png",
  "project": "https://github.com/mysteriumnetwork/node",
  "description": "Mysterium Node - decentralized VPN built on blockchain Cross-platform software to run a node in Mysterium Network. It contains Mysterium server (node), client API (tequila API) and client-cli (console client) for Mysterium Network.",
  "paths": [
    {
      "name": "Myst Config",
      "host": "/mnt/cache/appdata/myst/",
      "container": "/var/lib/mysterium-node",
      "mode": "rw",
      "description": "Container Path: /var/lib/mysterium-node",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "4449",
      "container": "4449",
      "protocol": "tcp",
      "description": "Container Port: 4449",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
