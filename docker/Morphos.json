{
  "name": "Morphos",
  "repo": "ghcr.io/danvergara/morphos-server:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/danvergara/morphos-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/danvergara/morphos/main/screenshots/morphos.jpg",
  "project": "https://github.com/danvergara/morphos",
  "description": "Self-hosted file converter server",
  "paths": [
    {
      "name": "Temporary data",
      "host": "/tmp",
      "container": "/tmp",
      "mode": "rw",
      "description": "Path to temporary data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
