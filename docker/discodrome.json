{
  "name": "discodrome",
  "repo": "7eventy7/discodrome",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/7eventy7/discodrome",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/7eventy7/discodrome/master/resources/discodrome.png",
  "project": "https://github.com/7eventy7/discodrome",
  "description": "Discord bot that streams music from your personal subsonic server.",
  "paths": [
    {
      "name": "DATA",
      "host": "/mnt/cache/appdata/discodrome/",
      "container": "/data",
      "mode": "rw",
      "description": "persistent storage for discodrome",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "SUBSONIC_SERVER",
      "key": "SUBSONIC_SERVER",
      "value": "YOUR_SUBSONIC_SERVER_URL",
      "description": "URL of your Subsonic server",
      "required": true,
      "mask": false
    },
    {
      "name": "SUBSONIC_USER",
      "key": "SUBSONIC_USER",
      "value": "YOUR_SUBSONIC_USERNAME",
      "description": "Subsonic username",
      "required": true,
      "mask": false
    },
    {
      "name": "SUBSONIC_PASSWORD",
      "key": "SUBSONIC_PASSWORD",
      "value": "YOUR_SUBSONIC_PASSWORD",
      "description": "Subsonic password",
      "required": true,
      "mask": true
    },
    {
      "name": "DISCORD_BOT_TOKEN",
      "key": "DISCORD_BOT_TOKEN",
      "value": "YOUR_DISCORD_BOT_TOKEN",
      "description": "Your Discord bot token",
      "required": true,
      "mask": true
    },
    {
      "name": "DISCORD_TEST_GUILD",
      "key": "DISCORD_TEST_GUILD",
      "value": "YOUR_DISCORD_TEST_GUILD_ID",
      "description": "Discord test guild ID",
      "required": true,
      "mask": false
    },
    {
      "name": "DISCORD_OWNER_ID",
      "key": "DISCORD_OWNER_ID",
      "value": "YOUR_DISCORD_OWNER_ID",
      "description": "Discord owner ID",
      "required": true,
      "mask": false
    },
    {
      "name": "BOT_STATUS",
      "key": "BOT_STATUS",
      "value": "",
      "description": "Bot status message",
      "required": false,
      "mask": false
    },
    {
      "name": "BOT_PREFIX",
      "key": "BOT_PREFIX",
      "value": "",
      "description": "Bot command prefix",
      "required": false,
      "mask": false
    },
    {
      "name": "BOT_SEARCH_SUGGESTION_COUNT",
      "key": "BOT_SEARCH_SUGGESTION_COUNT",
      "value": "5",
      "description": "Autocomplete suggestion count",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
