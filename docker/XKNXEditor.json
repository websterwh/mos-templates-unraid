{
  "name": "XKNX-Editor",
  "repo": "ghcr.io/xknx/xknx-editor-web:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/orgs/XKNX/packages",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/Bjoern3003/xknx-editor-unraid/main/xknx-logo.png",
  "project": "https://github.com/XKNX/xknx-editor",
  "description": "Web-based KNX project editor",
  "paths": [
    {
      "name": "Data & Settings",
      "host": "/mnt/cache/appdata/xknx-editor/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "KNX-Projects",
      "host": "/mnt/cache/appdata/xknx-editor/projects",
      "container": "/projects",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Web-Password",
      "key": "XKNX_WEB_PASSWORD",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
