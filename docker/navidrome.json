{
  "name": "navidrome",
  "repo": "deluan/navidrome",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/deluan/navidrome/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4533]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/navidrome.png",
  "project": "https://github.com/navidrome/navidrome",
  "description": "Modern Music Server and Streamer compatible with Subsonic/Airsonic",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/navidrome",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    },
    {
      "name": "Music",
      "host": "",
      "container": "/music",
      "mode": "rw",
      "description": "Container Path: /music",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4533",
      "container": "4533",
      "protocol": "tcp",
      "description": "Container Port: 4533",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Scan Schedule",
      "key": "ND_SCANSCHEDULE",
      "value": "1m",
      "description": "Container Variable: ND_SCANSCHEDULE",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "ND_LOGLEVEL",
      "value": "info",
      "description": "Container Variable: ND_LOGLEVEL",
      "required": false,
      "mask": false
    },
    {
      "name": "Timeout",
      "key": "ND_SESSIONTIMEOUT",
      "value": "24h",
      "description": "Container Variable: ND_SESSIONTIMEOUT",
      "required": false,
      "mask": false
    },
    {
      "name": "BaseURL",
      "key": "ND_BASEURL",
      "value": "",
      "description": "Container Variable: ND_BASEURL",
      "required": false,
      "mask": false
    },
    {
      "name": "Image Caching",
      "key": "ND_IMAGECACHESIZE",
      "value": "200MB",
      "description": "Container Variable: ND_IMAGECACHESIZE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
