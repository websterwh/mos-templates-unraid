{
  "name": "RackPeek",
  "repo": "aptacode/rackpeek:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/aptacode/rackpeek",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/Timmoth/RackPeek/main/assets/rackpeek_logo_128x128.png",
  "project": "https://github.com/Timmoth/RackPeek",
  "description": "RackPeek is a lightweight, opinionated CLI tool + Web UI for documenting and managing homelab and small-scale IT infrastructure.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/rackpeek",
      "container": "/app/config",
      "mode": "rw",
      "description": "Persistent RackPeek config/state (YAML) stored under /app/config.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "RackPeek Web UI port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
