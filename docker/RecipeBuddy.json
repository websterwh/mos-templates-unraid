{
  "name": "Recipe-Buddy",
  "repo": "ghcr.io/georgegebbett/recipe-buddy:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/georgegebbett/recipe-buddy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/recipe-buddy-icon.png",
  "project": "https://github.com/georgegebbett/recipe-buddy",
  "description": "Recipe Buddy is a tool that enables the easy adding of recipes to Grocy through web scraping.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/recipe-buddy/data",
      "container": "/home/node/app/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Grocy - Base URL",
      "key": "GROCY_BASE_URL",
      "value": "",
      "description": "Base URL for Grocy (e.g., http://grocy.local:9283)",
      "required": true,
      "mask": false
    },
    {
      "name": "Grocy - API Key",
      "key": "GROCY_API_KEY",
      "value": "",
      "description": "API key for Grocy",
      "required": true,
      "mask": true
    },
    {
      "name": "Auth - Secret",
      "key": "NEXTAUTH_SECRET",
      "value": "",
      "description": "Generate with 'openssl rand -base64 32'",
      "required": true,
      "mask": true
    },
    {
      "name": "Auth - URL",
      "key": "NEXTAUTH_URL",
      "value": "http://localhost:3000",
      "description": "URL for Recipe Buddy. Replace with IP address and port",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
