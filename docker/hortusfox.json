{
  "name": "hortusfox",
  "repo": "ghcr.io/danielbrendel/hortusfox-web:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/danielbrendel/hortusfox-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/danielbrendel/hortusfox-web/raw/main/public/logo.png",
  "project": "https://hortusfox.github.io/",
  "description": "Self-hosted collaborative plant management system for your local environment",
  "paths": [
    {
      "name": "App Images",
      "host": "/mnt/cache/appdata/hortusfox/app_images",
      "container": "/var/www/html/public/img",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "App Logs",
      "host": "/mnt/cache/appdata/hortusfox/app_logs",
      "container": "/var/www/html/app/logs",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "App Themes",
      "host": "/mnt/cache/appdata/hortusfox/app_themes",
      "container": "/var/www/html/public/themes",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "App Backup",
      "host": "/mnt/cache/appdata/hortusfox/app_backup",
      "container": "/var/www/html/public/backup",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Migrations",
      "host": "/mnt/cache/appdata/hortusfox/app_migrations",
      "container": "/var/www/html/app/migrations",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin Email",
      "key": "APP_ADMIN_EMAIL",
      "value": ".com",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "APP_ADMIN_PASSWORD",
      "value": "password",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "MariaDB Host",
      "key": "DB_HOST",
      "value": "mariadb",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB Port",
      "key": "DB_PORT",
      "value": "3306",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB Database",
      "key": "DB_DATABASE",
      "value": "hortusfox",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB Username",
      "key": "DB_USERNAME",
      "value": "root",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB Password",
      "key": "DB_PASSWORD",
      "value": "Deceit3-Unbitten-Giggle",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "APP_TIMEZONE",
      "value": "UTC",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Language",
      "key": "APP_LANG",
      "value": "en",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB Charset",
      "key": "DB_CHARSET",
      "value": "utf8mb4",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
