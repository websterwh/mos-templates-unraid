{
  "name": "CheckBag",
  "repo": "ghcr.io/benjaminroberts01375/checkbag:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/benjaminRoberts01375/CheckBag/pkgs/container/checkbag",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://github.com/benjaminRoberts01375/CheckBag/blob/main/art%20projects/CheckBag%20Icon.png?raw=true",
  "project": "https://github.com/benjaminRoberts01375/CheckBag",
  "description": "CheckBag is designed to sit between a reverse proxy and self-hosted services to provide graphs and analytics about who's trying to do what on your homelab.",
  "paths": [
    {
      "name": "CheckBag Data",
      "host": "/mnt/cache/appdata/CheckBag",
      "container": "/CheckBag",
      "mode": "rw",
      "description": "Settings and user data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI and Proxy Port",
      "host": "8769",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Valkey IP",
      "key": "CACHE_ADDRESS",
      "value": "",
      "description": "Does not include port or protocol",
      "required": true,
      "mask": false
    },
    {
      "name": "Valkey Port",
      "key": "CACHE_PORT",
      "value": "6379",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Valkey Password",
      "key": "CACHE_PASSWORD",
      "value": "",
      "description": "If Valkey was setup with --requirepass",
      "required": false,
      "mask": false
    },
    {
      "name": "Cache ID Length",
      "key": "CACHE_ID_LENGTH",
      "value": "15",
      "description": "When an identifier is created (ex. JWT), how long the ID should be.",
      "required": true,
      "mask": false
    },
    {
      "name": "Service ID Length",
      "key": "SERVICE_ID_LENGTH",
      "value": "15",
      "description": "When a service is created, it's created with a random ID. This sets how long the ID is.",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Color",
      "key": "COLOR",
      "value": "blue",
      "description": "Color used for outputting logs",
      "required": true,
      "mask": false
    },
    {
      "name": "Role",
      "key": "ROLE",
      "value": "Backend",
      "description": "Text used to describe backend service",
      "required": true,
      "mask": false
    },
    {
      "name": "Backend Internal Port",
      "key": "PORT",
      "value": "8080",
      "description": "Port to launch backend service from",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
