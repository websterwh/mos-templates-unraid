{
  "name": "ConvertX",
  "repo": "c4illin/convertx:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/c4illin/convertx",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/C4illin/ConvertX/refs/heads/main/public/favicon.svg",
  "project": "https://github.com/C4illin/ConvertX",
  "description": "A self-hosted online file converter. Supports over a thousand different formats.",
  "paths": [
    {
      "name": "Config data",
      "host": "/mnt/cache/appdata/convertx/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Config data for application",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Allow Guest Account Registration",
      "key": "ACCOUNT_REGISTRATION",
      "value": "false|true",
      "description": "Allow guest account registration",
      "required": true,
      "mask": false
    },
    {
      "name": "JWT Secret",
      "key": "JWT_SECRET",
      "value": "",
      "description": "Run `openssl rand -base64 32` to generate a secret",
      "required": true,
      "mask": true
    },
    {
      "name": "Allow HTTP",
      "key": "HTTP_ALLOWED",
      "value": "false|true",
      "description": "Allow HTTP connections. Only set to true for local connections",
      "required": true,
      "mask": false
    },
    {
      "name": "Allow Unauthenticated Use",
      "key": "ALLOW_UNAUTHENTICATED",
      "value": "false|true",
      "description": "Allow use of the application without requiring login",
      "required": true,
      "mask": false
    },
    {
      "name": "Auto-Delete File Timeout",
      "key": "AUTO_DELETE_EVERY_N_HOURS",
      "value": "24",
      "description": "Automatically delete files after X hours. Set to 0 to disable.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
