{
  "name": "OpenVPNAccessServer",
  "repo": "openvpn/openvpn-as",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/openvpn/openvpn-as",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:943]/admin",
  "icon": "https://avatars.githubusercontent.com/u/1569141?s=48&v=4",
  "project": "https://as-portal.openvpn.com/",
  "description": "The username is openvpn You can find the auto-generated password in the docker logs with this command: docker logs -f OpenVPNAccessServer",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/openvpn-as",
      "container": "/openvpn",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI HTTPS",
      "host": "943",
      "container": "943",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Tunnel SSL",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "OpenVPN UDP",
      "host": "1194",
      "container": "1194",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
