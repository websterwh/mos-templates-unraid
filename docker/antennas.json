{
  "name": "antennas",
  "repo": "thejf/antennas",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/thejf/antennas/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5004]",
  "icon": "https://raw.githubusercontent.com/yayitazale/unraid-templates/main/antennas.png",
  "project": "https://github.com/TheJF/antennas",
  "description": "HDHomeRun emulator for Plex/Jellyfin/Emby DVR to connect to Tvheadend. To run this container, first create a config.yml on the config folder with the following lines (changing to the IPs, ports and tuner count of your system) tvheadend_url: http://user:pas@X.X.X.X:9981 antennas_url: http://X.X.X.X:5004 tuner_count: 4",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/antennas",
      "container": "/antennas/config",
      "mode": "rw",
      "description": "Container Path: /antennas/config",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5004",
      "container": "5004",
      "protocol": "tcp",
      "description": "Container Port: 5004",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
