{
  "name": "paperless-ngx",
  "repo": "lscr.io/linuxserver/paperless-ngx",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/paperless-ngx",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/paperless-ngx-logo.png",
  "project": "https://github.com/paperless-ngx/paperless-ngx",
  "description": "Paperless-ngx(https://github.com/paperless-ngx/paperless-ngx) is an application by Daniel Quinn and contributors that indexes your scanned documents and allows you to easily search for documents and store metadata alongside your documents.\"",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Contains all relevant configuration files.",
      "required": true
    },
    {
      "name": "Path: /data",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Storage location for all paperless-ngx data files.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "http gui",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "REDIS_URL",
      "key": "REDIS_URL",
      "value": "",
      "description": "Specify an external redis instance to use. Can optionally include a port (`redis:6379`) and/or db (`redis/foo`). If left blank or not included, will use a built-in redis instance. If changed after initial setup will also require manual modification of /config/settings.py",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
