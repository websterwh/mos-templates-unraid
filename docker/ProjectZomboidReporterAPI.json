{
  "name": "ProjectZomboidReporter-API",
  "repo": "chrisashtear/zomboid-reporter-backend",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/chrisashtear/zomboid-reporter-backend/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3001]/",
  "icon": "https://github.com/natcoso9955/unRAID-docker/raw/master/icons/projectzomboid-api.png",
  "project": "https://github.com/ChrisAshtear/Zomboid-Server-Stats-Reporter/",
  "description": "This api is used to access your project zomboid data stored in sql to pass to the main reporter. NOTE: if your sql database is not running on the default port, you will need to provide a value for it below",
  "paths": [],
  "ports": [
    {
      "name": "API port",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "Container Port: 3001",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SQL_HOST",
      "key": "SQL_HOST",
      "value": "192.168.1.129",
      "description": "Container Variable: SQL_HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "SQL_DATABASE",
      "key": "SQL_DATABASE",
      "value": "Zombo",
      "description": "Container Variable: SQL_DATABASE",
      "required": true,
      "mask": false
    },
    {
      "name": "SQL_USER",
      "key": "SQL_USER",
      "value": "SQL_USER",
      "description": "Container Variable: SQL_USER",
      "required": true,
      "mask": false
    },
    {
      "name": "SQL_PASS",
      "key": "SQL_PASS",
      "value": "SQL_PASS",
      "description": "Container Variable: SQL_PASSWORD",
      "required": true,
      "mask": true
    },
    {
      "name": "SQL_PORT",
      "key": "SQL_PORT",
      "value": "3307",
      "description": "Container Variable: SQL_PORT",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
