{
  "name": "gpodder2go",
  "repo": "ghcr.io/oxtyped/gpodder2go:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/oxtyped/gpodder2go",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3005]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/gpodder2go-icon.png",
  "project": "https://github.com/oxtyped/gpodder2go",
  "description": "gpodder2go is a simple self-hosted, golang, drop-in replacement for gpodder/mygpo server to handle podcast subscriptions management for gpodder clients. Enter the console of the container to run commands like `/gpodder2go --help` to see available commands.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/gpodder2go/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Server Port",
      "host": "3005",
      "container": "3005",
      "protocol": "tcp",
      "description": "Container Port: 3005",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Skip Authentication",
      "key": "NO_AUTH",
      "value": "false|true",
      "description": "Skip authentication",
      "required": true,
      "mask": false
    },
    {
      "name": "Verifier Secret Key",
      "key": "VERIFIER_SECRET_KEY",
      "value": "",
      "description": "Secret key for verifying requests",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
