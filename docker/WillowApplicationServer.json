{
  "name": "Willow-Application-Server",
  "repo": "ghcr.io/heywillow/willow-application-server:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/heywillow/willow-application-server",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8502]/",
  "icon": "https://heywillow.io/images/favicon.svg",
  "project": "https://heywillow.io/",
  "description": "Manage configuration across all Willow devices. Part of the Willow suite.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/willow_application_server/app",
      "container": "/app",
      "mode": "rw",
      "description": "Path to store application data",
      "required": true
    },
    {
      "name": "Storage Path",
      "host": "/mnt/cache/appdata/willow_application_server/storage",
      "container": "/app/storage",
      "mode": "rw",
      "description": "Path to store application storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8502",
      "container": "8502",
      "protocol": "tcp",
      "description": "Container Port: 8502",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Docker Log Level",
      "key": "LOG_LEVEL",
      "value": "info|debug|warning|error|critical",
      "description": "Set the log level for the Docker container",
      "required": true,
      "mask": false
    },
    {
      "name": "WAS Log Level",
      "key": "WAS_LOG_LEVEL",
      "value": "info|debug|warning|error|critical",
      "description": "Set the log level for the application server",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
