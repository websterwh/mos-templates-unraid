{
  "name": "ParkPow-People-Tracker",
  "repo": "platerecognizer/people-tracker:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/platerecognizer/people-tracker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://app.parkpow.com/static/images/Icon_ParkPow_100x100.jpg",
  "project": "https://platerecognizer.com/",
  "description": "PeopleTracker is a detection software that processes live camera or pre-recorded video feeds rapidly and effectively. Upon detection of a person, the software triggers a webhook in real-time, thus ensuring swift and efficient people counting metrics.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/people_tracker/stream",
      "container": "/people-data",
      "mode": "rw",
      "description": "Path to app data",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "API Token",
      "key": "TOKEN",
      "value": "",
      "description": "API Token for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true
    },
    {
      "name": "License",
      "key": "LICENSE_KEY",
      "value": "",
      "description": "License Key for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
