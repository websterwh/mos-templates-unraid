{
  "name": "Aonsoku",
  "repo": "ghcr.io/victoralvesf/aonsoku:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/victoralvesf/aonsoku",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/victoralvesf/aonsoku/main/src-tauri/icons/128x128.png",
  "project": "https://aonsoku.vercel.app",
  "description": "A modern client for Navidrome/Subsonic servers built with React and Rust.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server URL",
      "key": "SERVER_URL",
      "value": "",
      "description": "Pre-define a Subsonic URL (e.g., http://your-subsonic-server:port)",
      "required": false,
      "mask": false
    },
    {
      "name": "Hide Server Field",
      "key": "HIDE_SERVER",
      "value": "false|true",
      "description": "Hide the server URL field in the login screen",
      "required": false,
      "mask": false
    },
    {
      "name": "Auto-Login - User",
      "key": "APP_USER",
      "value": "",
      "description": "Pre-define a username for auto-login",
      "required": false,
      "mask": false
    },
    {
      "name": "Auto-Login - Password",
      "key": "APP_PASSWORD",
      "value": "",
      "description": "Pre-define a password for auto-login",
      "required": false,
      "mask": true
    },
    {
      "name": "Auth Type",
      "key": "APP_AUTH_TYPE",
      "value": "token|password",
      "description": "Authentication type to use",
      "required": true,
      "mask": false
    },
    {
      "name": "Server Type",
      "key": "SERVER_TYPE",
      "value": "subsonic|navidrome|lms",
      "description": "Type of server to connect to",
      "required": true,
      "mask": false
    },
    {
      "name": "Hide Radio Section",
      "key": "HIDE_RADIOS_SECTION",
      "value": "false|true",
      "description": "Hide the radio section in the app",
      "required": false,
      "mask": false
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "8080",
      "description": "Internal port for server",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
