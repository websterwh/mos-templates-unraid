{
  "name": "gossa",
  "repo": "pldubouilh/gossa:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/pldubouilh/gossa/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8001]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/gossa.png",
  "project": "https://github.com/pldubouilh/gossa",
  "description": "\ud83c\udfb6 a fast and simple multimedia fileserver",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/gossa/",
      "container": "/shared",
      "mode": "rw",
      "description": "Data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "READONLY",
      "key": "READONLY",
      "value": "false",
      "description": "READONLY",
      "required": true,
      "mask": false
    },
    {
      "name": "FOLLOW_SYMLINKS",
      "key": "FOLLOW_SYMLINKS",
      "value": "false",
      "description": "FOLLOW_SYMLINKS",
      "required": false,
      "mask": false
    },
    {
      "name": "PREFIX",
      "key": "PREFIX",
      "value": "/",
      "description": "PREFIX",
      "required": false,
      "mask": false
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": "UID",
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": "GID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
