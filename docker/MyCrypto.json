{
  "name": "MyCrypto",
  "repo": "ghcr.io/ich777/mycrypto",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/ich777/mycrypto",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/vnc.html?autoconnect=true",
  "icon": "https://raw.githubusercontent.com/ich777/docker-templates/master/ich777/images/mycrypto.png",
  "project": "https://mycrypto.com/",
  "description": "MyCrypto is an open-source tool that allows you to manage your Ethereum accounts privately and securely. Developed by and for the community since 2015! **ATTENTION:** Please don't store your keyfile in the .../bin folder since this folder get's deleted if a update from MyCrypto is released, use the Home directory instead! I strongly recommend you to backup your keyfile on a regular basis!",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/mycrypto",
      "container": "/mycrypto",
      "mode": "rw",
      "description": "Please keep in mind that your wallet is stored there and I strongly recommend you to backup that path (ATTENTION: Please don't store your keyfile in the .../bin folder since this folder get's deleted if a update from MyCrypto is released, use the Home directory instead!)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebGUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "TCP noVNC WebGUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Custom Screen Width",
      "key": "CUSTOM_RES_W",
      "value": "1280",
      "description": "Minimum screen width 1280 pixels",
      "required": true,
      "mask": false
    },
    {
      "name": "Custom Screen Height",
      "key": "CUSTOM_RES_H",
      "value": "1024",
      "description": "Minimum screen hight 1024 pixels",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DATA_PERM",
      "key": "DATA_PERM",
      "value": "770",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
