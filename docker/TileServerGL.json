{
  "name": "TileServer-GL",
  "repo": "maptiler/tileserver-gl",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/maptiler/tileserver-gl",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--verbose",
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/ItJustFox/unraidtemplate/main/tileserver-gl/tileserver-gl-logo.png",
  "project": "https://github.com/maptiler/tileserver-gl",
  "description": "Vector and raster maps with GL styles. Server-side rendering by MapLibre GL Native. Map tile server for MapLibre GL JS, Android, iOS, Leaflet, OpenLayers, GIS via WMTS, etc. Download vector tiles from OpenMapTiles.",
  "paths": [
    {
      "name": "Configuration &amp; Tiles",
      "host": "/mnt/cache/appdata/TileServer-GL/",
      "container": "/data/",
      "mode": "rw",
      "description": "Config file for TileServer",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUi",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port used for the WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
