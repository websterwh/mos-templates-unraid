{
  "name": "bazarr",
  "repo": "lscr.io/linuxserver/bazarr",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/bazarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6767]/system/status",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/bazarr-logo.png",
  "project": "https://www.bazarr.media/",
  "description": "Bazarr(https://www.bazarr.media/) is a companion application to Sonarr and Radarr. It can manage and download subtitles based on your requirements. You define your preferences by TV show or movie and Bazarr takes care of everything for you.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    },
    {
      "name": "Path: /movies",
      "host": "",
      "container": "/movies",
      "mode": "rw",
      "description": "Location of your movies",
      "required": false
    },
    {
      "name": "Path: /tv",
      "host": "",
      "container": "/tv",
      "mode": "rw",
      "description": "Location of your TV Shows",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6767",
      "container": "6767",
      "protocol": "tcp",
      "description": "Allows HTTP access to the internal webserver.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
