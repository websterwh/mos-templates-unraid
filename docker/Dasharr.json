{
  "name": "Dasharr",
  "repo": "ghcr.io/frenchgithubuser/dasharr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/frenchgithubuser/dasharr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dasharr-icon.png",
  "project": "https://github.com/FrenchGithubUser/Dasharr",
  "description": "Dashboard of your indexers' usage",
  "paths": [
    {
      "name": "Prowlarr Database Path",
      "host": "",
      "container": "/backend/prowlarr/prowlarr.db",
      "mode": "ro",
      "description": "Path to the Prowlarr database file",
      "required": true
    },
    {
      "name": "Config Files",
      "host": "/mnt/cache/appdata/dasharr/config",
      "container": "/backend/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API Key",
      "key": "API_KEY",
      "value": "",
      "description": "API Key for accessing the Dasharr API",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
