{
  "name": "game-library-manager",
  "repo": "ghcr.io/dodert/game-library-manager:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/dodert/game-library-manager/pkgs/container/game-library-manager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/dodert/unraid-templates/main/icon.png",
  "project": "https://github.com/dodert/game-library-manager",
  "description": "Self-hosted video game collection manager (physical and digital, every console and PC) with cover art and metadata from IGDB, SteamGridDB, Steam and ScreenScraper. SQLite by default, PostgreSQL optional.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/game-library-manager",
      "container": "/data",
      "mode": "rw",
      "description": "Database and covers",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User id the app runs as",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group id the app runs as",
      "required": false,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Madrid",
      "description": "Time zone",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "",
      "description": "Optional. Empty = SQLite in /data. PostgreSQL: postgresql+psycopg://user:pass@host:5432/games",
      "required": false,
      "mask": true
    },
    {
      "name": "IGDB client id",
      "key": "IGDB_CLIENT_ID",
      "value": "",
      "description": "From https://dev.twitch.tv/console",
      "required": false,
      "mask": false
    },
    {
      "name": "IGDB client secret",
      "key": "IGDB_CLIENT_SECRET",
      "value": "",
      "description": "From https://dev.twitch.tv/console",
      "required": false,
      "mask": true
    },
    {
      "name": "SteamGridDB API key",
      "key": "STEAMGRIDDB_API_KEY",
      "value": "",
      "description": "From https://www.steamgriddb.com/profile/preferences/api",
      "required": false,
      "mask": true
    },
    {
      "name": "Steam API key",
      "key": "STEAM_API_KEY",
      "value": "",
      "description": "From https://steamcommunity.com/dev/apikey (library import)",
      "required": false,
      "mask": true
    },
    {
      "name": "Steam ID",
      "key": "STEAM_ID",
      "value": "",
      "description": "Your SteamID64 (library import)",
      "required": false,
      "mask": false
    },
    {
      "name": "ScreenScraper dev id",
      "key": "SCREENSCRAPER_DEV_ID",
      "value": "",
      "description": "ScreenScraper developer credentials",
      "required": false,
      "mask": false
    },
    {
      "name": "ScreenScraper dev password",
      "key": "SCREENSCRAPER_DEV_PASSWORD",
      "value": "",
      "description": "ScreenScraper developer credentials",
      "required": false,
      "mask": true
    },
    {
      "name": "ScreenScraper user",
      "key": "SCREENSCRAPER_USER",
      "value": "",
      "description": "Your screenscraper.fr account",
      "required": false,
      "mask": false
    },
    {
      "name": "ScreenScraper password",
      "key": "SCREENSCRAPER_PASSWORD",
      "value": "",
      "description": "Your screenscraper.fr account",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
