{
  "name": "minimal-ics-hoster",
  "repo": "patrickstigler/minimal-ics-hoster",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/patrickstigler/minimal-ics-hoster",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://github.com/patrickstigler/minimal-ics-host/raw/master/calendaricon.png",
  "project": "https://github.com/patrickstigler/minimal-ics-host/tree/master",
  "description": "minimal ics / iCal / Calendar hoster, is basically just a minimalistic webserver which will just publish the \"file.ics\" in the data directory. I use it to provide the Ical to Home Assistant for the garbage collection.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/minimal-ics-hoster/",
      "container": "/app/data/",
      "mode": "rw",
      "description": "Container Path: /data/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5004",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
