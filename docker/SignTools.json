{
  "name": "SignTools",
  "repo": "signtools/signtools",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/signtools/signtools",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/SignTools/SignTools/master/img/logo.png",
  "project": "https://github.com/SignTools/SignTools",
  "description": "A self-hosted, cross-platform service to sign and install iOS apps, all without a computer. You must have a reverse proxy to access the webUI. Configuration of the yml can be found on the github.",
  "paths": [
    {
      "name": "/signer-cfg.yml",
      "host": "/mnt/cache/appdata/ios/config/signer-cfg.yml",
      "container": "/signer-cfg.yml",
      "mode": "rw",
      "description": "Container Path: /signer-cfg.yml",
      "required": false
    },
    {
      "name": "/data",
      "host": "/mnt/cache/appdata/ios/",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    },
    {
      "name": "/data/profiles/",
      "host": "/mnt/cache/appdata/ios/profiles/",
      "container": "/data/profiles/",
      "mode": "rw",
      "description": "Container Path: /data/profiles/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Container Port",
      "host": "3344",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "-log-level",
      "key": "-log-level",
      "value": "2",
      "description": "Container Variable: -log-level",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
