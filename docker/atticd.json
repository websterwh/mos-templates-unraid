{
  "name": "atticd",
  "repo": "ghcr.io/zhaofengli/attic:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://avatars.githubusercontent.com/u/2189609",
  "project": "https://github.com/TheToddLuci0/Unraid-Apps",
  "description": "Attic binary cache for Nix",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/attic/config",
      "container": "/root/.config/attic",
      "mode": "rw",
      "description": "Persistent config files.",
      "required": true
    },
    {
      "name": "Cache Storage",
      "host": "/mnt/cache/appdata/attic/store",
      "container": "/root/.local/share/attic",
      "mode": "rw",
      "description": "Path to store the cache files. Required if you're using local storage in your config.toml",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "HTTP port for the API.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
