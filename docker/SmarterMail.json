{
  "name": "SmarterMail",
  "repo": "smartertools/smartermail:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/smartertools/smartermail",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/smartermail-icon.png",
  "project": "https://www.smartertools.com/",
  "description": "SmarterMail is the Microsoft Exchange alternative, offering the only other email, groupware, and collaboration server on the market with native MAPI support, the same protocol that powers Exchange and Outlook.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/smartermail/data",
      "container": "/app/Data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true
    },
    {
      "name": "System Data",
      "host": "/mnt/cache/appdata/smartermail/systemdata",
      "container": "/app/SystemData",
      "mode": "rw",
      "description": "Path to the system data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Web UI Port",
      "host": "1080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Web UI Port",
      "host": "1443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS UDP Port",
      "host": "1443",
      "container": "443",
      "protocol": "udp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP Port",
      "host": "1025",
      "container": "25",
      "protocol": "tcp",
      "description": "Container Port: 25",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP SSL Port",
      "host": "1465",
      "container": "465",
      "protocol": "tcp",
      "description": "Container Port: 465",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP TLS Port",
      "host": "1587",
      "container": "587",
      "protocol": "tcp",
      "description": "Container Port: 587",
      "required": true,
      "mask": false
    },
    {
      "name": "IMAP Port",
      "host": "1143",
      "container": "143",
      "protocol": "tcp",
      "description": "Container Port: 143",
      "required": true,
      "mask": false
    },
    {
      "name": "IMAP SSL Port",
      "host": "1993",
      "container": "993",
      "protocol": "tcp",
      "description": "Container Port: 993",
      "required": true,
      "mask": false
    },
    {
      "name": "POP3 Port",
      "host": "1110",
      "container": "110",
      "protocol": "tcp",
      "description": "Container Port: 110",
      "required": true,
      "mask": false
    },
    {
      "name": "POP3 SSL Port",
      "host": "1995",
      "container": "995",
      "protocol": "tcp",
      "description": "Container Port: 995",
      "required": true,
      "mask": false
    },
    {
      "name": "XMPP Port",
      "host": "15222",
      "container": "5222",
      "protocol": "tcp",
      "description": "Container Port: 5222",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
