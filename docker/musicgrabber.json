{
  "name": "music-grabber",
  "repo": "g33kphr33k/musicgrabber:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/g33kphr33k/musicgrabber",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--shm-size=2gb",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://gitlab.com/g33kphr33k/musicgrabber/-/raw/main/static/MusicGrabberIcon.webp",
  "project": "https://gitlab.com/g33kphr33k/musicgrabber",
  "description": "A self-hosted music acquisition service. Search YouTube, SoundCloud, MP3Phoenix, zvu4no, Monochrome/Qobuz, and optional Soulseek, tap a result and it downloads the best quality audio straight into your music library. You'll have a choice to convert to a common format, or store as is. Lidarr's great for albums, but grabbing a single track you heard on the radio shouldn't require navigating menus or pulling an artist's entire discography. This is for the \"I want one song, not a commitment\" use case.",
  "paths": [
    {
      "name": "Music Library",
      "host": "",
      "container": "/music",
      "mode": "rw",
      "description": "Where music is downloaded.",
      "required": true
    },
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/music-grabber",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MUSIC_DIR",
      "key": "MUSIC_DIR",
      "value": "/music",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PATH",
      "key": "DB_PATH",
      "value": "/data/music_grabber.db",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
