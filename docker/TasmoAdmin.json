{
  "name": "TasmoAdmin",
  "repo": "ghcr.io/tasmoadmin/tasmoadmin:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/TasmoAdmin/TasmoAdmin/pkgs/container/tasmoadmin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/tasmoadmin_icon.png",
  "project": null,
  "description": "TasmoAdmin is an administrative Website for Home Automation Devices flashed with Tasmota (PLEASE Stop this container while not in use and during Tasmota upgrades) (https://github.com/arendst/Tasmota). Video Tutorial: https://www.youtube.com/watch?v=vJUhRyi3-BQ",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/tasmoadmin/",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "9541",
      "host": "9541",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
