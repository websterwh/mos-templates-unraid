{
  "name": "romm",
  "repo": "rommapp/romm:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/rommapp/romm",
  "network": "romm_net",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/rommapp/romm/master/.github/resources/isotipo.png",
  "project": "https://github.com/rommapp/romm",
  "description": "A beautiful, powerful, self-hosted rom manager RomM (ROM Manager) allows you to scan, enrich, and browse your game collection with a clean and resonsive interface. With support for multiple platforms, various naming schemes, and custom tags, RomM is a must-have for anyone who plays on emulators. Features: \u2022 Scans your existing games library and enhances it with metadata from IGDB and MobyGames \u2022 Supports a large number of platforms \u2022 Play games directly from the browser using EmulatorJS \u2022 Share your library with friends while limiting access and permissions \u2022 View, upload, update, and delete games from any modern web browser Before starting, generate your IGDB and Mobygames API keys: https://docs.romm.app/latest/Getting-Started/Generate-API-Keys/ Instructions for setting up RomM can be found at https://docs.romm.app/latest/System-Setup/Unraid-Setup-Guide/",
  "paths": [
    {
      "name": "Library",
      "host": "/mnt/cache/appdata/romm/library",
      "container": "/romm/library/",
      "mode": "rw",
      "description": "Game files",
      "required": true
    },
    {
      "name": "Resources",
      "host": "/mnt/cache/appdata/romm/resources",
      "container": "/romm/resources/",
      "mode": "rw",
      "description": "Metadata storage (covers, screenshots, etc.)",
      "required": true
    },
    {
      "name": "Assets",
      "host": "/mnt/cache/appdata/romm/assets",
      "container": "/romm/assets/",
      "mode": "rw",
      "description": "Uploaded saves, states, etc.",
      "required": true
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/romm/config",
      "container": "/romm/config/",
      "mode": "rw",
      "description": "Folder for config.yml",
      "required": false
    },
    {
      "name": "Redis",
      "host": "/mnt/cache/appdata/romm/redis-data",
      "container": "/redis-data",
      "mode": "rw",
      "description": "Stores in-memory data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
