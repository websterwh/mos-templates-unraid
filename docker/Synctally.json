{
  "name": "Synctally",
  "repo": "registry.synctally.eu/synctally/unraid@sha256:746c890e9af0c648ddc7d61cbe7f9b0332512f5cdbf40a25021a61d4671c6835",
  "category": [
    "Media"
  ],
  "registry": "https://registry.synctally.eu/synctally/unraid",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--init --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 256 --stop-timeout 30 --user 99:100 --log-opt max-size=10m --log-opt max-file=3",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8095]/",
  "icon": "https://synctally.eu/favicon-512.png",
  "project": "https://synctally.eu",
  "description": "Local media outcomes intelligence for Plex, Jellyfin and mapped Seerr connections.",
  "paths": [
    {
      "name": "App data",
      "host": "/mnt/cache/appdata/synctally/data",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent Synctally data on a direct cache or pool path. Keep this path across updates.",
      "required": true
    },
    {
      "name": "Plex database (read-only)",
      "host": "",
      "container": "/plexdb",
      "mode": "ro",
      "description": "Optional for Plex. Select the real source directory and keep it read-only. Remove this entry for Jellyfin-only.",
      "required": false
    },
    {
      "name": "Plex logs (read-only)",
      "host": "",
      "container": "/plexlogs",
      "mode": "ro",
      "description": "Optional for Plex. Select the real source directory and keep it read-only. Remove this entry for Jellyfin-only.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "8095",
      "container": "8095",
      "protocol": "tcp",
      "description": "Synctally web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "UTC",
      "description": "IANA timezone used for local dates and times. Change this to your local timezone.",
      "required": true,
      "mask": false
    },
    {
      "name": "Require login",
      "key": "APP_AUTH_ENABLED",
      "value": "1",
      "description": "Keep sign-in enabled.",
      "required": true,
      "mask": false
    },
    {
      "name": "Plex database path",
      "key": "PLEX_DB_PATH",
      "value": "/plexdb/com.plexapp.plugins.library.db",
      "description": "Container path to the read-only Plex database.",
      "required": false,
      "mask": false
    },
    {
      "name": "Plex log path",
      "key": "PLEX_LOG_DIR",
      "value": "/plexlogs",
      "description": "Container path to the read-only Plex logs.",
      "required": false,
      "mask": false
    },
    {
      "name": "Installation platform",
      "key": "SYNCTALLY_INSTALL_PLATFORM",
      "value": "unraid",
      "description": "Public installation platform.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
