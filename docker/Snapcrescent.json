{
  "name": "Snapcrescent",
  "repo": "snapcrescent/snapcrescent",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/repository/docker/snapcrescent/snapcrescent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/snapcrescent/templates/main/Unraid/Snapcrescent/Snapcrescent-Logo.png",
  "project": "https://github.com/snapcrescent/snapcrescent",
  "description": "Snapcrescent - Self-hosted photo and video backup solution",
  "paths": [
    {
      "name": "Storage Path",
      "host": "",
      "container": "/media",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "App Data Path",
      "host": "",
      "container": "/db",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Import-Directory",
      "host": "",
      "container": "/mnt",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "PORT",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database Type",
      "key": "SQL_DB_TYPE",
      "value": "MYSQL",
      "description": "By default Snap Crescent will run using self hosted SQLITE mode. But you can use 'MYSQL' for better performance. Only if you are using mysql, then following variables are required SQL_URL SQL_USER SQL_PASSWORD",
      "required": true,
      "mask": false
    },
    {
      "name": "MySql URL",
      "key": "SQL_URL",
      "value": "",
      "description": "(jdbc:mysql://IP_ADDRESS:3306/snap-crescent)",
      "required": false,
      "mask": false
    },
    {
      "name": "Mysql User",
      "key": "SQL_USER",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SQL Password",
      "key": "SQL_PASSWORD",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Host Key 5",
      "key": "ADMIN_PASSWORD",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
