{
  "name": "SparkyFitness---Frontend",
  "repo": "codewithcj/sparkyfitness:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/codewithcj/sparkyfitness",
  "network": "sparkyfitness",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/sparky-fitness-icon.png",
  "project": "https://github.com/CodeWithCJ/SparkyFitness",
  "description": "SparkyFitness is a comprehensive fitness tracking and management application designed to help users monitor their nutrition, exercise, and body measurements. It provides tools for daily progress tracking, goal setting, and insightful reports to support a healthy lifestyle. This is the frontend container.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3004",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Frontend URL",
      "key": "SPARKY_FITNESS_FRONTEND_URL",
      "value": "http://IP_ADDRESS:3004",
      "description": "URL where the frontend is accessible (e.g., http://IP_ADDRESS:3004)",
      "required": true,
      "mask": false
    },
    {
      "name": "Backend Host",
      "key": "SPARKY_FITNESS_SERVER_HOST",
      "value": "",
      "description": "Host of backend.",
      "required": true,
      "mask": false
    },
    {
      "name": "Backend Port",
      "key": "SPARKY_FITNESS_SERVER_PORT",
      "value": "3004",
      "description": "3004",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
