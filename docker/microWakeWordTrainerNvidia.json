{
  "name": "microWakeWord_Trainer-Nvidia",
  "repo": "ghcr.io/tatertotterson/microwakeword:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/TaterTotterson/microWakeWord-Trainer-Nvidia-Docker/pkgs/container/microwakeword",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8888]/",
  "icon": "https://raw.githubusercontent.com/tatertotterson/MicroWakeWord-Trainer-Docker/refs/heads/main/mmw.png",
  "project": "https://github.com/TaterTotterson/microWakeWord-Trainer-Nvidia-Docker",
  "description": "Train microWakeWord detection models using a simple web-based recorder + trainer UI, packaged in a Docker container.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/mww/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the app data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "Container Port: 8888",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
