{
  "name": "premiumizearr",
  "repo": "datpat/premiumizearr",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/datpat/premiumizearr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8182]",
  "icon": "https://i.imgur.com/y1D2enH.png",
  "project": "https://github.com/DatPat/Premiumizearr",
  "description": "Bridge your *Arr clients (Sonarr, Radarr) to your premiumize.me (upload/download manager) Monitor blackhole directory to push .magnet and .nzb to Premiumize.me. Monitor and download Premiumize.me transfers (web ui on default port 8182). Mark transfers as failed in Radarr and Sonarr https://hub.docker.com/r/datpat/premiumizearr/",
  "paths": [
    {
      "name": "/data",
      "host": "/mnt/cache/appdata/premiumizearr",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "/blackhole",
      "host": "/mnt/cache/media/temp/blackhole/",
      "container": "/blackhole",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "/unzip",
      "host": "/mnt/cache/media/temp/unzip",
      "container": "/unzip",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "/downloads",
      "host": "/mnt/cache/media/temp/complete/",
      "container": "/downloads",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "/transfers",
      "host": "/mnt/cache/media/temp/work/",
      "container": "/transfers",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Container Port 1",
      "host": "8182",
      "container": "8182",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Container Variable 1",
      "key": "GOLANG_VERSION",
      "value": "1.16.15",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Container Variable 2",
      "key": "GOPATH",
      "value": "/go",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Container Variable 3",
      "key": "PREMIUMIZEARR_CONFIG_DIR_PATH",
      "value": "/data",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Container Variable 4",
      "key": "PREMIUMIZEARR_LOGGING_DIR_PATH",
      "value": "/data",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "777",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
