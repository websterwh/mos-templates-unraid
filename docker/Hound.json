{
  "name": "Hound",
  "repo": "ghcr.io/hound-search/hound:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/hound-search/hound",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6080]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/hound-icon.png",
  "project": "https://github.com/hound-search/hound",
  "description": "An extremely fast source code search engine.",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/hound/data",
      "container": "/data",
      "mode": "rw",
      "description": "Config data for application",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "6080",
      "container": "6080",
      "protocol": "tcp",
      "description": "Container Port: 6080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
