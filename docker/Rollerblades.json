{
  "name": "Rollerblades",
  "repo": "ghcr.io/jcostom/rollerblades:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jcostom/rollerblades",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 099:100",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/rollerblades-icon.png",
  "project": "https://github.com/jcostom/rollerblades",
  "description": "A tool to automate Plex prerolls based on schedules.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/rollerblades/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to app data",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Plex - Host",
      "key": "HOST",
      "value": "",
      "description": "Plex server host",
      "required": true,
      "mask": false
    },
    {
      "name": "Plex - Token",
      "key": "TOKEN",
      "value": "",
      "description": "Plex server token",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
