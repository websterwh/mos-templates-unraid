{
  "name": "OnlyOffice-Community-Server",
  "repo": "onlyoffice/communityserver",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/onlyoffice/communityserver/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/SiwatINC/unraid-ca-repository/master/icons/onlyoffice.png",
  "project": "https://www.onlyoffice.com/",
  "description": "ONLYOFFICE Community Server is a free open source collaborative system developed to manage documents, projects, customer relationship and email correspondence, all in one place. HTTPS Support can be enable creating a \"certs\" folder in the data directory and placing onlyoffice.crt and onlyoffice.key in it",
  "paths": [
    {
      "name": "Log Directory",
      "host": "/mnt/cache/appdata/onlyofficecs/logs",
      "container": "/var/log/onlyoffice",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/onlyofficecs/Data",
      "container": "/var/www/onlyoffice/Data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Database Directory",
      "host": "/mnt/cache/appdata/onlyofficecs/database",
      "container": "/var/lib/mysql",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8081",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "4431",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
