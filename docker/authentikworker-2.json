{
  "name": "authentik-worker",
  "repo": "ghcr.io/goauthentik/server:2025.8.1",
  "category": [
    "Security"
  ],
  "registry": "https://github.com/goauthentik/authentik/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped -u root",
  "post_parameters": "worker",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/ibracorp/app-logos/main/authentik-worker/authentik_worker.png",
  "project": "https://github.com/goauthentik/authentik",
  "description": "authentik is an open-source Identity Provider focused on flexibility and versatility. You can use authentik in an existing environment to add support for new protocols, implement sign-up/recovery/etc. in your application so you don't have to deal with it, and many other things. This is the worker. You will need the Authentik app which is the server.",
  "paths": [
    {
      "name": "Backups",
      "host": "",
      "container": "/backups",
      "mode": "rw",
      "description": "Container Path: /backups",
      "required": false
    },
    {
      "name": "Media",
      "host": "",
      "container": "/media",
      "mode": "rw",
      "description": "Container Path: /media",
      "required": false
    },
    {
      "name": "Certs",
      "host": "",
      "container": "/certs",
      "mode": "rw",
      "description": "Container Path: /certs",
      "required": false
    },
    {
      "name": "Docker Socket",
      "host": "",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Container Path: /var/run/docker.sock",
      "required": false
    },
    {
      "name": "Custom Templates",
      "host": "",
      "container": "/templates",
      "mode": "rw",
      "description": "Container Path: /templates",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Redis Host",
      "key": "AUTHENTIK_REDIS__HOST",
      "value": "",
      "description": "Redis Host:",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL Host",
      "key": "AUTHENTIK_POSTGRESQL__HOST",
      "value": "",
      "description": "PostgreSQL Host:",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL DB User",
      "key": "AUTHENTIK_POSTGRESQL__USER",
      "value": "",
      "description": "PostgreSQL DB User: authentik",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL DB Name",
      "key": "AUTHENTIK_POSTGRESQL__NAME",
      "value": "",
      "description": "PostgreSQL DB Name: authentik",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL DB Password",
      "key": "AUTHENTIK_POSTGRESQL__PASSWORD",
      "value": "",
      "description": "PostgreSQL DB Password:",
      "required": true,
      "mask": true
    },
    {
      "name": "Error Reporting",
      "key": "AUTHENTIK_ERROR_REPORTING__ENABLED",
      "value": "true",
      "description": "Error Reporting: True or False",
      "required": false,
      "mask": false
    },
    {
      "name": "Secret Key",
      "key": "AUTHENTIK_SECRET_KEY",
      "value": "",
      "description": "https://passwordsgenerator.net/ - SAME AS THE AUTHENTIK SERVER",
      "required": true,
      "mask": true
    },
    {
      "name": "Redis Password",
      "key": "AUTHENTIK_REDIS__PASSWORD",
      "value": "",
      "description": "Container Variable: AUTHENTIK_REDIS__PASSWORD",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
