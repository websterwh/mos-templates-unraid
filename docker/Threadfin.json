{
  "name": "Threadfin",
  "repo": "fyb3roptik/threadfin",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/fyb3roptik/threadfin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:34400]/web/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/threadfin-icon.png",
  "project": "https://github.com/Threadfin/Threadfin",
  "description": "An M3U proxy for Kernel/Plex/Jellyfin/Emby based on xTeVe",
  "paths": [
    {
      "name": "Configuration data",
      "host": "/mnt/cache/appdata/threadfin/config",
      "container": "/home/threadfin/conf",
      "mode": "rw",
      "description": "Path to configuration data",
      "required": true
    },
    {
      "name": "Temporary data",
      "host": "/mnt/cache/appdata/threadfin/temp",
      "container": "/tmp/threadfin",
      "mode": "rw",
      "description": "Path to temporary data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "34400",
      "container": "34400",
      "protocol": "tcp",
      "description": "Container Port: 34400",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
