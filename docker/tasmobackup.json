{
  "name": "tasmobackup",
  "repo": "danmed/tasmobackupv1",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/danmed/tasmobackupv1/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/danmed/TasmoBackupV1/master/TasmoBackup.png",
  "project": null,
  "description": "Tasmota backup - TasmoBackup - Backup all your tasmota devices in one place. Add/scan for your Tasmota devices. Use the backupall.php page to schedule automated backups of all devices!",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/tasmobackupv1",
      "container": "/var/www/html/data",
      "mode": "rw",
      "description": "Container Path: /var/www/html/data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8259",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DBTYPE",
      "key": "DBTYPE",
      "value": "sqlite",
      "description": "Container Variable: DBTYPE",
      "required": false,
      "mask": false
    },
    {
      "name": "DBNAME",
      "key": "DBNAME",
      "value": "data/tasmobackup",
      "description": "Container Variable: DBNAME",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
