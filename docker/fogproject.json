{
  "name": "fogproject",
  "repo": "mudislander/fogproject",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/mudislander/fogproject//Dockerfile/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/Mudislander/docker-templates/master/img/fogproject_icon.png",
  "project": "https://fogproject.org/",
  "description": "FOG Project can capture, deploy, and manage Windows, Mac OSX, and various Linux distributions.",
  "paths": [
    {
      "name": "MySQL",
      "host": "/mnt/cache/FOGServer/MySQL",
      "container": "/var/lib/mysql",
      "mode": "rw",
      "description": "Container Path: /var/lib/mysql",
      "required": false
    },
    {
      "name": "Images",
      "host": "/mnt/cache/FOGServer/images",
      "container": "/images",
      "mode": "rw",
      "description": "Container Path: /images",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 80",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": false,
      "mask": false
    },
    {
      "name": "Port 69 TCP",
      "host": "69",
      "container": "69",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": false,
      "mask": false
    },
    {
      "name": "Port 69 UDP",
      "host": "69",
      "container": "69",
      "protocol": "udp",
      "description": "Container Port:",
      "required": false,
      "mask": false
    },
    {
      "name": "Port 21",
      "host": "21",
      "container": "21",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": false,
      "mask": false
    },
    {
      "name": "Port 9000",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "IP Server",
      "key": "IP",
      "value": "192.168.0.200",
      "description": "Container Variable: IP",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
