{
  "name": "BarcodeBuddy",
  "repo": "f0rc3/barcodebuddy:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/f0rc3/barcodebuddy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/Flight777/unraid_justworks_templates/blob/main/images/barcodebuddy/barcodebuddy_unraid.png?raw=true",
  "project": "https://github.com/Forceu/barcodebuddy",
  "description": "bBarcode Buddy is a Grocy companion app/plugin, which allows you to install the Barcode Buddy app and scan products directly to your Grocy library./b /br /br Unraid template that JUST WORKS, brought to you by Flight777! /br /br ADDED PERFORMANCE For added performance you can install a Redis container and link it to the app in the Barcode Buddy webui.",
  "paths": [
    {
      "name": "Configuration Files:",
      "host": "/mnt/cache/appdata/barcodebuddy",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8450",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
