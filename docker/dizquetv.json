{
  "name": "dizquetv",
  "repo": "vexorian/dizquetv",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/vexorian/dizquetv",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/vexorian/dizquetv/main/resources/dizquetv.png",
  "project": "https://github.com/vexorian/dizquetv",
  "description": "dizqueTV is a Plex DVR plugin. It allows you to host your own fake live tv service by dynamically streaming media from your Plex servers(s). Your channels and settings are all managed through the dizqueTV Web UI. dizqueTV will show up as a HDHomeRun device within Plex. When configuring your Plex Tuner, simply use the generatered ./.dizquetv/xmltv.xml file for EPG data. dizqueTV will automatically refresh your Plex server's EPG data and channel mappings (if specified to do so in settings) when configuring channels via the Web UI. Ensure your FFMPEG path is set correctly via the Web UI, and enjoy!",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/dizquetv/",
      "container": "/home/node/app/.dizquetv",
      "mode": "rw",
      "description": "Container Path: /home/node/app/.dizquetv",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Webui &amp; HDHR",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": "Container Variable: NVIDIA_VISIBLE_DEVICES",
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": "Container Variable: NVIDIA_DRIVER_CAPABILITIES",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
