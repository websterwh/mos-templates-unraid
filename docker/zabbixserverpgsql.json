{
  "name": "zabbix-server-pgsql",
  "repo": "zabbix/zabbix-server-pgsql",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/zabbix/zabbix-server-pgsql",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:10051]",
  "icon": "https://raw.githubusercontent.com/andaks/unraid-templates/master/zabbix/Zabbix_logo.jpg",
  "project": "https://www.zabbix.com/",
  "description": "Zabbix server with PostgreSQL database support Zabbix server is the central process of Zabbix software. The server performs the polling and trapping of data, it calculates triggers, sends notifications to users. It is the central component to which Zabbix agents and proxies report data on availability and integrity of systems. The server can itself remotely check networked services (such as web servers and mail servers) using simple service checks.",
  "paths": [
    {
      "name": "Alert Script Path",
      "host": "/mnt/cache/appdata/zabbix-server-pgsql/alertscripts",
      "container": "/usr/lib/zabbix/alertscripts",
      "mode": "rw",
      "description": "Folder for alert script",
      "required": false
    },
    {
      "name": "External Script Path",
      "host": "/mnt/cache/appdata/zabbix-server-pgsql/externalscripts",
      "container": "/usr/lib/zabbix/externalscripts",
      "mode": "rw",
      "description": "Folder for external script",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Listen Port",
      "host": "10051",
      "container": "10051",
      "protocol": "tcp",
      "description": "Used for communication with zabbix server",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database Server",
      "key": "DB_SERVER_HOST",
      "value": "SERVER_HOST",
      "description": "Postgresql Database Server FQDN / IP",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "DB_SERVER_PORT",
      "value": "5432",
      "description": "Port of PostgreSQL server. By default, value is '5432'.",
      "required": true,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "POSTGRES_USER",
      "value": "DB_USER",
      "description": "Database User",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "POSTGRES_PASSWORD",
      "value": "DB_PASS",
      "description": "Database Password",
      "required": true,
      "mask": true
    },
    {
      "name": "Database Name",
      "key": "POSTGRES_DB",
      "value": "zabbix",
      "description": "Zabbix database name. By default, value is zabbix",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
