{
  "name": "addarr",
  "repo": "waterboy1602/addarr",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/waterboy1602/addarr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": null,
  "project": "https://github.com/Waterboy1602/Addarr",
  "description": "TelegramBot for Sonarr and Radarr This is a Telegram Bot made to add series to Sonarr or movies to Radarr with a couple of commands. You can also communicate with your Transmission/Sabnzbd service to change its download speed. You will need to create a config.yaml file and place in the addarr appdata folder. To create this file, you will need to follow the guide on the Addarr wiki to get authenticated to Telegram.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/addarr/config.yaml",
      "container": "/app/config.yaml",
      "mode": "ro",
      "description": null,
      "required": false
    },
    {
      "name": "Chat ID",
      "host": "/mnt/cache/appdata/addarr/chatid.txt",
      "container": "/app/chatid.txt",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Admin ID",
      "host": "/mnt/cache/appdata/addarr/admin.txt",
      "container": "/app/admin.txt",
      "mode": "ro",
      "description": null,
      "required": false
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/addarr/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
