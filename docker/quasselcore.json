{
  "name": "quassel-core",
  "repo": "lscr.io/linuxserver/quassel-core",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/quassel-core",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4242]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/quassel-core-logo.png",
  "project": "http://quassel-irc.org/",
  "description": "Quassel-core(http://quassel-irc.org/) is a modern, cross-platform, distributed IRC client, meaning that one (or multiple) client(s) can attach to and detach from a central core. This container handles the IRC connection (quasselcore) and requires a desktop client (quasselclient) to be used and configured. It is designed to be always on and will keep your identity present in IRC even when your clients cannot be online. Backlog (history) is downloaded by your client upon reconnection allowing infinite scrollback through time.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Database and quassel-core configuration storage.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4242",
      "container": "4242",
      "protocol": "tcp",
      "description": "The port quassel-core listens for connections on.",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 10113",
      "host": "113",
      "container": "10113",
      "protocol": "tcp",
      "description": "Optional Ident Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "RUN_OPTS",
      "key": "RUN_OPTS",
      "value": "--config-from-environment",
      "description": "Custom CLI options for Quassel",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
