{
  "name": "docker-mcp",
  "repo": "louij2/docker-mcp:latest",
  "category": [
    "System"
  ],
  "registry": "https://pypi.org/project/mcp-server-docker/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--memory=512m --cpus=0.5",
  "post_parameters": "supergateway --stdio mcp-server-docker --port 8095",
  "web_ui_url": "http://[IP]:[PORT:8095]",
  "icon": "https://cdn.simpleicons.org/docker/2496ED",
  "project": "https://github.com/louij2/docker-mcp",
  "description": "Docker MCP server, bridged over HTTP with supergateway (baked into the image) so any MCP client that speaks HTTP/SSE can use it. Mounts docker.sock, which is root-equivalent on the host - only run this where you trust every client that can reach it.",
  "paths": [
    {
      "name": "docker.sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Read-write bind mount - required.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 8095",
      "host": "8095",
      "container": "8095",
      "protocol": "tcp",
      "description": "HTTP port supergateway serves the bridged MCP endpoint on.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
