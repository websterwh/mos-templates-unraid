{
  "name": "prometheus",
  "repo": "prom/prometheus",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/prom/prometheus/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9090]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/prometheus.png",
  "project": "https://github.com/prometheus/prometheus",
  "description": "Prometheus is a systems and service monitoring system. It collects metrics from configured targets at given intervals, evaluates rule expressions, displays the results, and can trigger alerts if some condition is observed to be true.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/prometheus/data",
      "container": "/prometheus",
      "mode": "rw",
      "description": "Appdata directory",
      "required": true
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/prometheus/etc",
      "container": "/etc/prometheus/",
      "mode": "rw",
      "description": "Config directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Container Port: 9090",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
