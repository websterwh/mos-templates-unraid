{
  "name": "cncjs",
  "repo": "cncjs/cncjs:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/cncjs/cncjs/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://cnc.js.org/logo.png",
  "project": "https://github.com/cncjs/cncjs",
  "description": "A full-featured web interface for CNC controllers running Grbl, Marlin, Smoothieware, or TinyG.",
  "paths": [
    {
      "name": "/config",
      "host": "/mnt/cache/appdata/cncjs",
      "container": "/cncjs/",
      "mode": "rw",
      "description": "Container Path: /opt/cncjs",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [
    {
      "name": "Webcam",
      "host": "/dev/",
      "container": "",
      "description": "Container Device:",
      "required": false
    },
    {
      "name": "CNC",
      "host": "/dev/",
      "container": "",
      "description": "Container Device:",
      "required": false
    }
  ],
  "labels": []
}
