{
  "name": "Bots",
  "repo": "ghcr.io/dotumzane/bots:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/DotumZane/Bots/pkgs/container/bots",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3847]",
  "icon": "https://raw.githubusercontent.com/DotumZane/Bots/main/public/bots-icon.png",
  "project": "https://github.com/DotumZane/Bots",
  "description": "Bots is a private, self-hosted monitoring dashboard for Unraid. Watch product prices and stock, HTTP websites, and TCP servers with history, confirmation rules, outage and recovery alerts, DNS and TLS monitoring, and configurable notification channels. All durable data stays in /data. Bots has no built-in authentication and should not be exposed directly to the internet.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/bots",
      "container": "/data",
      "mode": "rw",
      "description": "Database, configuration, cache, and encryption key",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3847",
      "container": "3847",
      "protocol": "tcp",
      "description": "Bots web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Time zone",
      "key": "TZ",
      "value": "America/Los_Angeles",
      "description": "IANA time zone",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Optional user ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Optional group ID",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Optional file creation mask",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
