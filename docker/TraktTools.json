{
  "name": "Trakt-Tools",
  "repo": "xbgmsharp/docker-trakt-tools:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/xbgmsharp/docker-trakt-tools",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/trakt-tools-icon.png",
  "project": "https://github.com/xbgmsharp/trakt",
  "description": "A CLI tool to import and export Trakt.tv, Kodi and CouchPotato data to/from CSV files.",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/trakt_tools/config",
      "container": "/trakt/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    },
    {
      "name": "Export path",
      "host": "/mnt/cache/appdata/trakt_tools/export",
      "container": "/trakt/export",
      "mode": "rw",
      "description": "Path to export files",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
