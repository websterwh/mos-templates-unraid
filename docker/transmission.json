{
  "name": "transmission",
  "repo": "lscr.io/linuxserver/transmission",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/transmission",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9091]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/transmission-logo.png",
  "project": "https://www.transmissionbt.com/",
  "description": "Transmission(https://www.transmissionbt.com/) is designed for easy, powerful use. Transmission has the features you want from a BitTorrent client: encryption, a web interface, peer exchange, magnet links, DHT, \u00b5TP, UPnP and NAT-PMP port forwarding, webseed support, watch directories, tracker editing, global and per-torrent speed limits, and more.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Where transmission should store config files and logs.",
      "required": true
    },
    {
      "name": "Path: /downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Local path for downloads.",
      "required": false
    },
    {
      "name": "Path: /watch",
      "host": "",
      "container": "/watch",
      "mode": "rw",
      "description": "Watch folder for torrent files.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9091",
      "container": "9091",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 51413",
      "host": "51413",
      "container": "51413",
      "protocol": "tcp",
      "description": "Torrent Port TCP",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 51413",
      "host": "51413",
      "container": "51413",
      "protocol": "udp",
      "description": "Torrent Port UDP",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TRANSMISSION_WEB_HOME",
      "key": "TRANSMISSION_WEB_HOME",
      "value": "",
      "description": "Specify the path to an alternative UI folder.",
      "required": false,
      "mask": false
    },
    {
      "name": "USER",
      "key": "USER",
      "value": "",
      "description": "Specify an optional username for the interface",
      "required": false,
      "mask": false
    },
    {
      "name": "PASS",
      "key": "PASS",
      "value": "",
      "description": "Specify an optional password for the interface",
      "required": false,
      "mask": true
    },
    {
      "name": "WHITELIST",
      "key": "WHITELIST",
      "value": "",
      "description": "Specify an optional list of comma separated ip whitelist. Fills rpc-whitelist setting.",
      "required": false,
      "mask": false
    },
    {
      "name": "PEERPORT",
      "key": "PEERPORT",
      "value": "",
      "description": "Specify an optional port for torrent TCP/UDP connections. Fills peer-port setting.",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_WHITELIST",
      "key": "HOST_WHITELIST",
      "value": "",
      "description": "Specify an optional list of comma separated dns name whitelist. Fills rpc-host-whitelist setting.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
