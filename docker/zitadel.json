{
  "name": "zitadel",
  "repo": "ghcr.io/zitadel/zitadel:latest",
  "category": [
    "Security"
  ],
  "registry": "https://github.com/zitadel/zitadel/pkgs/container/zitadel",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": "start-from-init --masterkey MasterkeyNeedsToHave32Characters --tlsMode disabled",
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/jcesclapez/unraid-templates/refs/heads/main/zitadel/zitadel-logo-darkdesign.png",
  "project": "https://github.com/zitadel/",
  "description": "ZITADEL as identity experience platform provides all the features for identity management, secure authentication, and access management for your customers, employees, devices or services. Our platform makes it easy to deploy a hosted, multi-factor secured login, offer single sign-on, allow users to bring existing identities, integrate with our APIs, and keep informed with our event-based audit trail. Working with Postgres 16 and 17. Please replace --masterkey \u201cMasterkeyNeedsToHave32Characters\u201d in Post Arguments with a safe one. Default username: zitadel-admin@zitadel.localhost Default password: Password1! In the above username, replace localhost with your configured external domain, if any. e.g. with zitadel-admin@zitadel.sso.my.domain.tld",
  "paths": [],
  "ports": [
    {
      "name": "WEB UI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DATABASE POSTGRES HOST",
      "key": "ZITADEL_DATABASE_POSTGRES_HOST",
      "value": "db",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE POSTGRES PORT",
      "key": "ZITADEL_DATABASE_POSTGRES_PORT",
      "value": "5432",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE POSTGRES",
      "key": "ZITADEL_DATABASE_POSTGRES_DATABASE",
      "value": "zitadel",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE POSTGRES USER USERNAME",
      "key": "ZITADEL_DATABASE_POSTGRES_USER_USERNAME",
      "value": "zitadel",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE POSTGRES USER PASSWORD",
      "key": "ZITADEL_DATABASE_POSTGRES_USER_PASSWORD",
      "value": "zitadel",
