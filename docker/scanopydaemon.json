{
  "name": "scanopy-daemon",
  "repo": "ghcr.io/scanopy/scanopy/daemon:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/scanopy/scanopy/pkgs/container/scanopy%2Fdaemon",
  "network": "host",
  "custom_ip": null,
  "default_shell": [
    "bash",
    "bash"
  ],
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/scanopy/scanopy/refs/heads/main/media/logo.png",
  "project": "https://github.com/scanopy/scanopy",
  "description": "Automatically discover and visually document network topology.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/scanopy/daemon",
      "container": "/root/.config/daemon",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Docker access",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Server URL",
      "key": "SCANOPY_SERVER_URL",
      "value": "http://YOUR_SCANOPY_SERVER_IP:60072",
      "description": "Or use a domain name if behind reverse proxy",
      "required": false,
      "mask": false
    },
    {
      "name": "Mode",
      "key": "SCANOPY_MODE",
      "value": "Push",
      "description": "Pull: daemon polls server. Push: server initiates scans (daemon must be reachable)",
      "required": false,
      "mask": false
    },
    {
      "name": "API Key",
      "key": "SCANOPY_DAEMON_API_KEY",
      "value": "",
      "description": "Get from scanopy-server > Daemons > Create Daemon > Generate > SCANOPY_DAEMON_API_KEY",
      "required": true,
      "mask": true
    },
    {
      "name": "Network ID",
      "key": "SCANOPY_NETWORK_ID",
      "value": "1881e7fa-b4b4-4227-be49-265c98f87b88",
      "description": "UUID of the network to scan. Get from scanopy-server > Daemons > Create Daemon > Generate > SCANOPY_NETWORK_ID",
      "required": true,
      "mask": false
    },
    {
      "name": "Daemon URL",
      "key": "SCANOPY_DAEMON_URL",
      "value": "http://10.100.20.250:60073",
      "description": "Public URL where server can reach daemon (Push mode only)",
      "required": false,
      "mask": false
    },
    {
      "name": "Daemon Port",
      "key": "SCANOPY_DAEMON_PORT",
      "value": "60073",
      "description": "Port for daemon to listen on",
      "required": false,
      "mask": false
    },
    {
      "name": "Bind Address",
      "key": "SCANOPY_BIND_ADDRESS",
      "value": "0.0.0.0",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Daemon Name",
      "key": "SCANOPY_NAME",
      "value": "UNRAID",
      "description": "Name displayed under scanopy-server > Daemons",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "SCANOPY_LOG_LEVEL",
      "value": "info",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Concurrent Scans",
      "key": "SCANOPY_CONCURRENT_SCANS",
      "value": "15",
      "description": "Maximum parallel host scans",
      "required": false,
      "mask": false
    },
    {
      "name": "Heartbeat Interval",
      "key": "SCANOPY_HEARTBEAT_INTERVAL",
      "value": "30",
      "description": "Seconds between heartbeats/work requests",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
