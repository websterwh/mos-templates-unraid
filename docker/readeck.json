{
  "name": "readeck",
  "repo": "codeberg.org/readeck/readeck:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/codeberg.org/readeck/readeck",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://codeberg.org/repo-avatars/05b1262f738e1417e82c889d8dcb6ba7167a2d266b28d620590f521e58e34a07",
  "project": "https://readeck.org/",
  "description": "Readeck is a simple web application that lets you save the precious readable content of web pages you like and want to keep forever. See it as a bookmark manager and a read later tool.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/readeck",
      "container": "/readeck",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Log Level",
      "key": "READECK_LOG_LEVEL",
      "value": "info",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Host",
      "key": "READECK_SERVER_HOST",
      "value": "0.0.0.0",
      "description": "Leave as 0.0.0.0 or set to container name (ex. readeck)",
      "required": false,
      "mask": false
    },
    {
      "name": "Server Prefix",
      "key": "READECK_SERVER_PREFIX",
      "value": "/",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Internal Port",
      "key": "READECK_SERVER_PORT",
      "value": "8000",
      "description": "Must match container port from above",
      "required": false,
      "mask": false
    },
    {
      "name": "Allowed Hosts",
      "key": "READECK_ALLOWED_HOSTS",
      "value": "readeck.example.com",
      "description": "Required for reverse proxy configuration. Remove if only using locally.",
      "required": false,
      "mask": false
    },
    {
      "name": "Use X Forwarded",
      "key": "READECK_USE_X_FORWARDED",
      "value": "true",
      "description": "Required for reverse proxy configuation. Remove if only using locally.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
