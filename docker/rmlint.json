{
  "name": "rmlint",
  "repo": "bobbintb/docker-rmlint-unraid",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/bobbintb/docker-rmlint-unraid",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:8322]",
  "icon": "https://raw.githubusercontent.com/bobbintb/docker-rmlint-unraid/master/rmlint-icon.png",
  "project": "https://github.com/sahib/rmlint",
  "description": "rmlint finds space waste and other broken things on your filesystem and offers to remove it.",
  "paths": [
    {
      "name": "Search location",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Search location /data",
      "required": true
    },
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "GUI Port",
      "host": "8322",
      "container": "8322",
      "protocol": "tcp",
      "description": "GUI Port - Default 8322",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
