{
  "name": "twitch-drops-miner",
  "repo": "dungfu/twitch-drops-miner",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/dungfu/twitch-drops-miner/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5800]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/twitch-drops-miner.png",
  "project": "https://github.com/DevilXD/TwitchDropsMiner",
  "description": "AFK mine timed Twitch drops, with automatic drop claiming and channel switching.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/twitch-drops-miner/config",
      "container": "/TwitchDropsMiner/config",
      "mode": "rw",
      "description": "Path to configuration data.",
      "required": true
    },
    {
      "name": "Cache Path",
      "host": "/mnt/cache/appdata/twitch-drops-miner/cache",
      "container": "/TwitchDropsMiner/cache",
      "mode": "rw",
      "description": "Path to cache data.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5800",
      "container": "5800",
      "protocol": "tcp",
      "description": "Port used to access the application's GUI via the web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Display Width",
      "key": "DISPLAY_WIDTH",
      "value": "1920",
      "description": "Width (in pixels) of the application's window.",
      "required": false,
      "mask": false
    },
    {
      "name": "Display Height",
      "key": "DISPLAY_HEIGHT",
      "value": "1080",
      "description": "Height (in pixels) of the application's window.",
      "required": false,
      "mask": false
    },
    {
      "name": "Dark mode",
      "key": "DARK_MODE",
      "value": "1|0",
      "description": "1 to enable, 0 to disable.",
      "required": false,
      "mask": false
    },
    {
      "name": "User ID",
      "key": "USER_ID",
      "value": "500",
      "description": "ID of the user the application runs as.",
      "required": true,
      "mask": false
    },
    {
      "name": "Group ID",
      "key": "GROUP_ID",
      "value": "500",
      "description": "ID of the group the application runs as.",
      "required": true,
      "mask": false
    },
    {
      "name": "Umask",
      "key": "UMASK",
      "value": "000",
      "description": "Mask that controls how file permissions are set for newly created files. The value of the mask is in octal notation.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
