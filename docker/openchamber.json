{
  "name": "openchamber",
  "repo": "arranhs/openchamber",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/arranhs/openchamber",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://github.com/Cyberschorsch/unraid-templates/blob/2301afeee9e0355edaeca0ae2c9893b38f72748e/assets/openchamber-logo.jpg?raw=true",
  "project": "https://github.com/openchamber/openchamber",
  "description": "OpenChamber is an open-source workspace for running and reviewing AI coding work.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/openchamber/config",
      "container": "/home/openchamber/.config/opencode",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/openchamber/data",
      "container": "/home/openchamber/.config/openchamber",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Workspaces",
      "host": "/mnt/cache/appdata/openchamber/workspaces",
      "container": "/home/openchamber/workspaces",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Webui",
      "host": "3500",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OPENCHAMBER_UI_PASSWORD",
      "key": "OPENCHAMBER_UI_PASSWORD",
      "value": "default",
      "description": "Default password is 'default'",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
