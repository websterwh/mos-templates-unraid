{
  "name": "UniFiProtect",
  "repo": "markdegroot/unifi-protect-x86",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/markdegroot/unifi-protect-x86/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--tmpfs /srv/unifi-protect/temp -m 2048m",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7080]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/unifiprotect.png",
  "project": "https://github.com/markdegrootnl/unifi-protect-x86",
  "description": "Run UniFi Protect in Docker on x86 hardware. UniFi stopped supporting x86 at 1.13.3, so there will be no more updates. Must use Protect mobile app 1.3.8 to connect to this via UniFi Cloud on your phone. Run either as host networking mode, or custom br0 if you have other conflicting ports in use already via host mode - bridge mode does not work.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/unifiprotect/data",
      "container": "/srv/unifi-protect",
      "mode": "rw",
      "description": "Container Path: /srv/unifi-protect",
      "required": false
    },
    {
      "name": "Database",
      "host": "/mnt/cache/appdata/unifiprotect/database",
      "container": "/var/lib/postgresql/10/main",
      "mode": "rw",
      "description": "Container Path: /var/lib/postgresql/10/main",
      "required": false
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
