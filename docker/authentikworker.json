{
  "name": "authentik-worker",
  "repo": "ghcr.io/goauthentik/server:2025.8.1",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/goauthentik/authentik",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user root",
  "post_parameters": "worker",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Zuerrex/icons/main/authentik.png",
  "project": "https://goauthentik.io",
  "description": "The Authentik worker container processes background jobs, scheduled tasks, and asynchronous operations for the server. It handles actions such as sending emails, running LDAP/SCIM syncs, processing login events, and managing provisioning.",
  "paths": [
    {
      "name": "Docker Socket Volume",
      "host": "",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Mounts Docker socket for container management.",
      "required": false
    },
    {
      "name": "Media Volume",
      "host": "/mnt/cache/appdata/authentik/media",
      "container": "/media",
      "mode": "rw",
      "description": "Stores uploaded media and assets.",
      "required": true
    },
    {
      "name": "Certificates Volume",
      "host": "/mnt/cache/appdata/authentik/certs",
      "container": "/certs",
      "mode": "rw",
      "description": "Stores SSL/TLS certificates.",
      "required": true
    },
    {
      "name": "Custom Templates Volume",
      "host": "/mnt/cache/appdata/authentik/templates",
      "container": "/templates",
      "mode": "rw",
      "description": "Stores custom Authentik templates.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Secret Key",
      "key": "AUTHENTIK_SECRET_KEY",
      "value": "",
      "description": "Cryptographic key for Authentik.",
      "required": true,
      "mask": true
    },
    {
      "name": "Redis Host",
      "key": "AUTHENTIK_REDIS__HOST",
      "value": "redis",
      "description": "Host/IP of the Redis server.",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis Password",
      "key": "AUTHENTIK_REDIS__PASSWORD",
      "value": "",
      "description": "Password of Redis server.",
      "required": false,
      "mask": true
    },
    {
      "name": "PostgreSQL Host",
      "key": "AUTHENTIK_POSTGRESQL__HOST",
      "value": "postgresql",
      "description": "Host/IP of the PostgreSQL database.",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL User",
      "key": "AUTHENTIK_POSTGRESQL__USER",
      "value": "postgres",
      "description": "Username for PostgreSQL access.",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL Database Name",
      "key": "AUTHENTIK_POSTGRESQL__NAME",
      "value": "authentik",
      "description": "Name of the PostgreSQL database.",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL Password",
      "key": "AUTHENTIK_POSTGRESQL__PASSWORD",
      "value": "",
      "description": "Password for the PostgreSQL user.",
      "required": true,
      "mask": true
    },
    {
      "name": "Enable Error Reporting",
      "key": "AUTHENTIK_ERROR_REPORTING__ENABLED",
      "value": "true",
      "description": "Enable/disable sending error reports (true/false).",
      "required": false,
      "mask": false
    },
    {
      "name": "Email Host",
      "key": "AUTHENTIK_EMAIL__HOST",
      "value": "smtp.gmail.com",
      "description": "SMTP server hostname.",
      "required": false,
      "mask": false
    },
    {
      "name": "Email Port",
      "key": "AUTHENTIK_EMAIL__PORT",
      "value": "587",
      "description": "SMTP server port.",
      "required": false,
      "mask": false
    },
    {
      "name": "Email Username",
      "key": "AUTHENTIK_EMAIL__USERNAME",
      "value": "example@localhost",
      "description": "SMTP account username.",
      "required": false,
      "mask": false
    },
    {
      "name": "Email Password",
      "key": "AUTHENTIK_EMAIL__PASSWORD",
      "value": "",
      "description": "For Gmail, visit https://myaccount.google.com/apppasswords",
      "required": false,
      "mask": true
    },
    {
      "name": "Email Use TLS",
      "key": "AUTHENTIK_EMAIL__USE_TLS",
      "value": "true",
      "description": "Enable TLS for SMTP (true/false).",
      "required": false,
      "mask": false
    },
    {
      "name": "Email Use SSL",
      "key": "AUTHENTIK_EMAIL__USE_SSL",
      "value": "false",
      "description": "Enable SSL for SMTP (true/false).",
      "required": false,
      "mask": false
    },
    {
      "name": "Email Timeout",
      "key": "AUTHENTIK_EMAIL__TIMEOUT",
      "value": "10",
      "description": "SMTP timeout in seconds.",
      "required": false,
      "mask": false
    },
    {
      "name": "Email From Address",
      "key": "AUTHENTIK_EMAIL__FROM",
      "value": "authintik@localhost",
      "description": "Default \u201cFrom\u201d email address.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
