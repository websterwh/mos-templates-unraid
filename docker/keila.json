{
  "name": "keila",
  "repo": "pentacent/keila",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/pentacent/keila/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:4000]",
  "icon": "https://raw.githubusercontent.com/bpivk/unraid-templates/refs/heads/main/images/ca_keila.ico",
  "project": "https://github.com/pentacent/keila",
  "description": "Manage and grow your contact lists, design and send personalized newsletter campaigns easier than ever before. Keila is a 100% Open Source newsletter tool, made in Germany. Keila is an Open Source alternative to newsletter tools like Mailchimp or Sendinblue. With Keila you can easily send out newsletter campaigns and create sign-up forms. For smaller newsletters, you can use your own email inbox to send out campaigns. For larger newsletter projects, AWS SES, Sendgrid, Mailgun, and Postmark are supported in addition to SMTP. Note: The password will be displayed in the docker log on first run. You can change it after you log in.",
  "paths": [
    {
      "name": "Path",
      "host": "/mnt/cache/appdata/keila",
      "container": "/app/uploads",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PostgreSQL database used by Keila",
      "key": "DB_URL",
      "value": "postgres://user:pass@ip/database",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Domain of your Keila instance",
      "key": "URL_HOST",
      "value": "mailer.something.com",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Strong secret with at least 64 characters.",
      "key": "SECRET_KEY_BASE",
      "value": "D008QrmTsSQnZxBX0Z8wgMLSGVPSEQXgo27kynbz7QyHAZD3f0fOWxOr1LMF0qoE",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Salt for creating Hashids",
      "key": "HASHID_SALT",
      "value": "sha256",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "User uploads",
      "key": "USER_CONTENT_DIR",
      "value": "./uploads",
      "description": "Path to a directory where user uploads will be stored. When deploying using containers, this should point to the path of a volume to make sure uploads are persisted.",
      "required": true,
      "mask": false
    },
    {
      "name": "Hostname of the SMTP server",
      "key": "MAILER_SMTP_HOST",
      "value": "smtp.gmail.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Port of the SMTP server",
      "key": "MAILER_SMTP_PORT",
      "value": "587",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Username for the SMTP server",
      "key": "MAILER_SMTP_USER",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Password for the SMTP server",
      "key": "MAILER_SMTP_PASSWORD",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Enable SSL/TLS",
      "key": "MAILER_ENABLE_SSL",
      "value": "false",
      "description": "Enable SSL/TLS by setting to true",
      "required": false,
      "mask": false
    },
    {
      "name": "Enable STARTTLS",
      "key": "MAILER_ENABLE_STARTTLS",
      "value": "true",
      "description": "Enable STARTTLS by setting to true",
      "required": false,
      "mask": false
    },
    {
      "name": "Email address for the root user",
      "key": "KEILA_USER",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Disable user registration",
      "key": "DISABLE_REGISTRATION",
      "value": "true",
      "description": "Disable user registration by setting this variable to true",
      "required": true,
      "mask": false
    },
    {
      "name": "URL scheme of your Keila instance",
      "key": "URL_SCHEMA",
      "value": "https",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "FROM email address",
      "key": "MAILER_SMTP_FROM_EMAIL",
      "value": "MAILER_SMTP_USER",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
