{
  "name": "workout-tracker",
  "repo": "ghcr.io/jovandeginste/workout-tracker:master",
  "category": [
    "System"
  ],
  "registry": "https://ghcr.io/jovandeginste/workout-tracker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/workout-tracker/main/running-negative.png",
  "project": "https://github.com/jovandeginste/workout-tracker",
  "description": "A workout tracking web application for personal use (or family, friends), geared towards running and other GPX-based activities Default username: admin Default password: admin <- Change this!!",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/workout-tracker",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Encryption Key",
      "key": "WT_JWT_ENCRYPTION_KEY",
      "value": "my-secret-key",
      "description": "CHANGE THIS VALUE!",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
