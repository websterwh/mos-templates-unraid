{
  "name": "lftp-sync-manager",
  "repo": "cj0r/lftp-sync-manager:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/cj0r/lftp-sync-manager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9342]",
  "icon": "https://raw.githubusercontent.com/cj0r/lftp-sync-manager/production/public/icon.png",
  "project": "https://github.com/cj0r/lftp-sync-manager",
  "description": "Dockerized LFTP Transfer Manager with a sleek Web GUI featuring real-time file watching, cron schedules, bandwidth throttling, and automated SSH key handshakes.",
  "paths": [
    {
      "name": "App Configuration",
      "host": "/mnt/cache/appdata/lftp-sync-manager",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent configuration, history, and logs storage directory.",
      "required": true
    },
    {
      "name": "Local Upload Directory",
      "host": "/mnt/cache/appdata/lftp-sync-manager/upload",
      "container": "/local-push",
      "mode": "rw",
      "description": "Local directory scanned for automatic file uploads (Push).",
      "required": true
    },
    {
      "name": "Local Download Directory",
      "host": "/mnt/cache/appdata/lftp-sync-manager/download",
      "container": "/local-pull",
      "mode": "rw",
      "description": "Directory where files will be pulled from remote hosts (Pull).",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9342",
      "container": "9342",
      "protocol": "tcp",
      "description": "Web interface access port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
