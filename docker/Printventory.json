{
  "name": "Printventory",
  "repo": "printventory/printventory:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/printventory/printventory",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/printventory.png",
  "project": "https://printventory.com/index.html",
  "description": "Printventory is an open-source 3D printing model library and physical inventory manager. It allows you to organize your 3D models (STL, 3MF, STEP), manage print files, track filament consumption, and keep an overview of your physical stock in a clean WebUI.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/printventory",
      "container": "/root/.config/printventory",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "3D model library",
      "host": "/mnt/cache/models/",
      "container": "/mnt/models",
      "mode": "rw",
      "description": "your 3D model library",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8095",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SERVER_MODE",
      "key": "SERVER_MODE",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
