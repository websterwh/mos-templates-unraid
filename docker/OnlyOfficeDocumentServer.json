{
  "name": "OnlyOfficeDocumentServer",
  "repo": "onlyoffice/documentserver",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/onlyoffice/documentserver/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/SiwatINC/unraid-ca-repository/master/icons/onlyoffice.png",
  "project": "https://www.onlyoffice.com/",
  "description": "ONLYOFFICE Document Server is an online office suite comprising viewers and editors for texts, spreadsheets and presentations, fully compatible with Office Open XML formats: .docx, .xlsx, .pptx and enabling collaborative editing in real time. HTTPS Support can be enable creating a \"certs\" folder in the data directory and placing onlyoffice.crt and onlyoffice.key in it. Add fonts by placing [fontname].ttf in the font folder and force updating the container.",
  "paths": [
    {
      "name": "Log Directory",
      "host": "/mnt/cache/appdata/onlyofficeds/logs",
      "container": "/var/log/onlyoffice",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/onlyofficeds/Data",
      "container": "/var/www/onlyoffice/Data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Font Directory",
      "host": "/mnt/cache/appdata/onlyofficeds/fonts",
      "container": "/usr/share/fonts",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "4430",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "JWT_SECRET",
      "value": "secret123",
      "description": "API Secret Key",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
