{
  "name": "DumbBudget",
  "repo": "dumbwareio/dumbbudget:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dumbwareio/dumbbudget",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/dumbbudget-logo.png",
  "project": "https://github.com/DumbWareio/DumbBudget",
  "description": "A simple, secure personal budgeting app with PIN protection. Track your income and expenses with a clean, modern interface.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dumbbudget",
      "container": "/app/data",
      "mode": "rw",
      "description": "Data Dir",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port on which the application will run.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PIN",
      "key": "DUMBBUDGET_PIN",
      "value": "12345",
      "description": "PIN protection",
      "required": true,
      "mask": false
    },
    {
      "name": "CURRENCY",
      "key": "CURRENCY",
      "value": "USD",
      "description": "Currency code for transactions",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
