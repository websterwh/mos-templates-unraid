{
  "name": "Shimmie2",
  "repo": "shish2k/shimmie2:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/shish2k/shimmie2",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/shish/shimmie2/refs/heads/main/ext/static_files/static/favicon_64.png",
  "project": "https://github.com/shish/shimmie2",
  "description": "Shimmie2 is a lightweight, tag-based image gallery engine. It features a robust extension system, advanced metadata tagging, and a community-focused \"Booru\" style interface for organizing large image collections. This template uses an integrated SQLite database for easy setup",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/shimmie2",
      "container": "/app/data",
      "mode": "rw",
      "description": "Core application data and SQLite database.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
