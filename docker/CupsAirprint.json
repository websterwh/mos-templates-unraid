{
  "name": "Cups-Airprint",
  "repo": "chuckcharlie/cups-avahi-airprint:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/chuckcharlie/cups-avahi-airprint",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:631]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/cups-logo.png",
  "project": "https://github.com/chuckcharlie/cups-avahi-airprint",
  "description": "CUPS instance that is meant as an AirPrint relay for printers that are already on the network but not AirPrint capable. CUPS supports printing to: AirPrint\u2122 and IPP Everywhere\u2122 printers, Network and local (USB) printers with Printer Applications, and Network and local (USB) printers with (legacy) PPD-based printer drivers. To add printers: visit the WebUI => Administration => Printers => Add Printer The default admin credential : admin/admin (please Change when setting up your container)",
  "paths": [
    {
      "name": "Avahi service Configs",
      "host": "",
      "container": "/services",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Printer Configs",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Logs",
      "host": "",
      "container": "/var/log/cups",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "CUPS Admin Username",
      "key": "CUPSADMIN",
      "value": "admin",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "CUPS Admin Password",
      "key": "CUPSPASSWORD",
      "value": "admin",
      "description": null,
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
