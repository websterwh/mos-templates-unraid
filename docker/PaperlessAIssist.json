{
  "name": "Paperless-AIssist",
  "repo": "nyxtronlab/paperless-aissist:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/nyxtronlab/paperless-aissist",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/nyxtron/paperless-aissist/main/icon.png",
  "project": "https://github.com/nyxtron/paperless-aissist",
  "description": "AI-powered document processing assistant for Paperless-NGX. Features: AI classification, OCR post-processing, document chat, auto-processing scheduler, and more. Runs as non-root with configurable PUID/PGID.",
  "paths": [
    {
      "name": "Path: Data",
      "host": "/mnt/cache/appdata/paperless-aissist",
      "container": "/app/data",
      "mode": "rw",
      "description": "Database and app data storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port: Web UI",
      "host": "8099",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web UI port (container listens on 8080)",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Variable: PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID used to run the app process (Unraid default: 99)",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID used to run the app process (Unraid default: 100)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
