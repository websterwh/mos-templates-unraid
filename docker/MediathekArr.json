{
  "name": "MediathekArr",
  "repo": "pcjones/mediathekarr",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/pcjones/mediathekarr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5007]",
  "icon": "https://raw.githubusercontent.com/tschoerk/unraid-templates/main/mediathekarr/mediathekarr.png",
  "project": "https://github.com/PCJones/MediathekArr",
  "description": "Integrate ARD and ZDF Mediathek in Prowlarr, Sonarr and Radarr. Details are found in the documentation.",
  "paths": [
    {
      "name": "Host Path for /app/downloads",
      "host": "",
      "container": "/app/downloads",
      "mode": "rw",
      "description": "Host path for completed downloads (e.g. /mnt/user/data/usenet/complete/)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port for 5007",
      "host": "5007",
      "container": "5007",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Container Path for completed downloads",
      "key": "DOWNLOAD_FOLDER_PATH_MAPPING",
      "value": "",
      "description": "Container path for completed downloads set in the download client (e.g. /data/usenet/complete/)",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
