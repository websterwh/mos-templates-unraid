{
  "name": "mailpile",
  "repo": "rroemhild/mailpile:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/rroemhild/mailpile/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:33411]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/mailpile.png",
  "project": "https://www.mailpile.is/",
  "description": "Mailpile is software, an e-mail client. It runs on your desktop or laptop computer and you interact with it by using your web browser. The goal of Mailpile is to allow people to send e-mail in a more secure and private manner than before.",
  "paths": [
    {
      "name": "Path 1",
      "host": "/mnt/cache/appdata/Mailpile/",
      "container": "/root/.local/share/Mailpile",
      "mode": "rw",
      "description": "Container Path: /root/.local/share/Mailpile",
      "required": true
    },
    {
      "name": "Path 2",
      "host": "/mnt/cache/appdata/Mailpile/gnupg/",
      "container": "/root/.gnupg",
      "mode": "rw",
      "description": "Container Path: /root/.gnupg",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "33411",
      "container": "33411",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
