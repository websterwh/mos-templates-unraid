{
  "name": "Standalone-emoncms",
  "repo": "mattheworres/emoncms",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/mattheworres/emoncms/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://docs.openenergymonitor.org/_images/myelectric_webapp.png",
  "project": null,
  "description": "Web-based energy monitor. Slightly modified version of the official EmonCMS docker, for use on Unraid.",
  "paths": [
    {
      "name": "PHPFina Dir",
      "host": "/mnt/cache/appdata/emoncms/phpfina",
      "container": "/var/opt/emoncms/phpfina/",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "PHPTimeSeries Dir",
      "host": "/mnt/cache/appdata/emoncms/phptimeseries",
      "container": "/var/opt/emoncms/phptimeseries/",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8998",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PHPFina Dir",
      "key": "PHPFINA_DIR",
      "value": "/var/opt/emoncms/phpfina/",
      "description": "Path to PHPFina",
      "required": true,
      "mask": false
    },
    {
      "name": "PHPTimeSeries Dir",
      "key": "PHPTIMESERIES_DIR",
      "value": "/var/opt/emoncms/phptimeseries/",
      "description": "Path to PHPTimeSeries",
      "required": true,
      "mask": false
    },
    {
      "name": "MySQL Host",
      "key": "MYSQL_HOST",
      "value": "127.0.0.1",
      "description": "Host of the (not included in this container) MySQL/MariaDB host",
      "required": true,
      "mask": false
    },
    {
      "name": "MySQL User",
      "key": "MYSQL_USER",
      "value": "emoncms",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MySQL Password",
      "key": "MYSQL_PASSWORD",
      "value": "my_very_secure_password",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "MySQL Port",
      "key": "MYSQL_PORT",
      "value": "3306",
      "description": "Port MySQL host operates on. Default: 3306",
      "required": true,
      "mask": false
    },
    {
      "name": "MySQL Database",
      "key": "MYSQL_DATABASE",
      "value": "emoncms",
      "description": "Name of MySQL Database. Default: emoncms.",
      "required": true,
      "mask": false
    },
    {
      "name": "MySQL Random Root Password",
      "key": "MYSQL_RANDOM_ROOT_PASSWORD",
      "value": "yes",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Redis Enabled",
      "key": "REDIS_ENABLED",
      "value": "yes",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Redis Host",
      "key": "REDIS_HOST",
      "value": "127.0.0.1",
      "description": "Host of the (not included in this container) Redis",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis Port",
      "key": "REDIS_PORT",
      "value": "6379",
      "description": "Port Redis host operates on. Default: 6379",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis Prefix",
      "key": "REDIS_PREFIX",
      "value": "'emoncms'",
      "description": "Prefix for Redis. Default: 'emoncms'.",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT Enabled",
      "key": "MQTT_ENABLED",
      "value": "yes",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT Host",
      "key": "MQTT_HOST",
      "value": "127.0.0.1",
      "description": "Host of the (not included in this container) MQTT",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT User",
      "key": "MQTT_USER",
      "value": "emoncms",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT Password",
      "key": "MQTT_PASSWORD",
      "value": "my_very_secure_password",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "MQTT Port",
      "key": "MQTT_PORT",
      "value": "1883",
      "description": "Port MQTT host operates on. Default: 1883",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT Basetopic",
      "key": "MQTT_BASETOPIC",
      "value": "emon",
      "description": "Prefix for MQTT. Default: 'emoncms'.",
      "required": true,
      "mask": false
    },
    {
      "name": "Domain",
      "key": "EMONCMS_DOMAIN",
      "value": "false",
      "description": "Domain of this installation, eg emoncms.local",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
