{
  "name": "CamillaDSP-EQ",
  "repo": "ghcr.io/ssouza00/backyard-eq:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/ssouza00/backyard-eq/pkgs/container/backyard-eq",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5005]/gui/index.html",
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/music-assistant.png",
  "project": "https://github.com/ssouza00/backyard-eq",
  "description": "Professional browser-based audio tuning for Unraid using CamillaDSP and CamillaGUI, with presets, equalization, volume controls, and Spotify pipe support.",
  "paths": [
    {
      "name": "CamillaDSP Config",
      "host": "/mnt/cache/appdata/camilladsp",
      "container": "/config",
      "mode": "rw",
      "description": "DSP profiles and state",
      "required": true
    },
    {
      "name": "Shared Spotify Audio",
      "host": "/mnt/cache/appdata/spotify-dsp/audio",
      "container": "/audio",
      "mode": "rw",
      "description": "Shared Spotify audio pipe",
      "required": true
    },
    {
      "name": "CamillaGUI Internal Config",
      "host": "/mnt/cache/appdata/camillagui-internal",
      "container": "/opt/camillagui_backend/config",
      "mode": "rw",
      "description": "GUI backend configuration",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web GUI Port",
      "host": "5005",
      "container": "5005",
      "protocol": "tcp",
      "description": "CamillaGUI web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [
    {
      "name": "Audio Device",
      "host": "/dev/snd",
      "container": "/dev/snd",
      "description": "Unraid ALSA sound devices",
      "required": true
    }
  ],
  "labels": []
}
