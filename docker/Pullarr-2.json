{
  "name": "Pullarr",
  "repo": "kirantheram/pullarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/kirantheram/pullarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6997]/",
  "icon": "https://raw.githubusercontent.com/KiranTheRam/Pullarr/main/frontend/public/pullarr-icon.png",
  "project": "https://github.com/KiranTheRam/Pullarr",
  "description": "Monitor western comic series, download missing issues, and organize CBZ/CBR files for Komga or Kavita.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/pullarr",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent database, API key, and settings.",
      "required": true
    },
    {
      "name": "Comics",
      "host": "/mnt/cache/media/comics",
      "container": "/comics",
      "mode": "rw",
      "description": "Comic library folder. Add /comics as a root folder in Pullarr after installation.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "6997",
      "container": "6997",
      "protocol": "tcp",
      "description": "Pullarr web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
