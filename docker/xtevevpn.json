{
  "name": "xteve_vpn",
  "repo": "alturismo/xteve_vpn",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/alturismo/xteve_vpn",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:34400]/web/",
  "icon": "https://avatars0.githubusercontent.com/u/53275662?s=460&v=4",
  "project": "https://github.com/alturismo/xteve_vpn",
  "description": "xteve, in docker with ovpn ### docker runs in bridge mode ### IMPORTANT, if ipv6 is active in your network, set in extra parameters ...disable_ipv6=1 put your ovpn file in /config edit your ovpn credentials in /config set your LOCAL_NET to fir your netmask access xteve webui ip:34400/web/",
  "paths": [
    {
      "name": "/xteve",
      "host": "/mnt/cache/appdata/xteve_vpn/",
      "container": "/root/.xteve",
      "mode": "rw",
      "description": "Container Path: /root/.xteve",
      "required": true
    },
    {
      "name": "/config",
      "host": "/mnt/cache/appdata/xteve_vpn/config/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    },
    {
      "name": "/tmp",
      "host": "",
      "container": "/tmp/xteve",
      "mode": "rw",
      "description": "/tmp/xteve in case u want to move /tmp to RAM on host buffer, ...",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "34400",
      "container": "34400",
      "protocol": "tcp",
      "description": "Container Port: 34400",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "LOCAL_NET",
      "key": "LOCAL_NET",
      "value": "192.168.1.0/24",
      "description": "Container Variable: LOCAL_NET",
      "required": true,
      "mask": false
    },
    {
      "name": "OPENVPN_FILE",
      "key": "OPENVPN_FILE",
      "value": "Frankfurt.ovpn",
      "description": "Container Variable: OPENVPN_FILE",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
