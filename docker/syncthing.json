{
  "name": "syncthing",
  "repo": "lscr.io/linuxserver/syncthing",
  "category": [
    "Backup"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/syncthing",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8384]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/syncthing-logo.png",
  "project": "https://syncthing.net",
  "description": "Syncthing(https://syncthing.net) replaces proprietary sync and cloud services with something open, trustworthy and decentralized. Your data is your data alone and you deserve to choose where it is stored, if it is shared with some third party and how it's transmitted over the Internet.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration files.",
      "required": true
    },
    {
      "name": "Path: /data1",
      "host": "",
      "container": "/data1",
      "mode": "rw",
      "description": "Data1",
      "required": true
    },
    {
      "name": "Path: /data2",
      "host": "",
      "container": "/data2",
      "mode": "rw",
      "description": "Data2",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8384",
      "container": "8384",
      "protocol": "tcp",
      "description": "Application WebUI",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 22000",
      "host": "22000",
      "container": "22000",
      "protocol": "tcp",
      "description": "Listening port (TCP)",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 22000",
      "host": "22000",
      "container": "22000",
      "protocol": "udp",
      "description": "Listening port (UDP)",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 21027",
      "host": "21027",
      "container": "21027",
      "protocol": "udp",
      "description": "Protocol discovery",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
