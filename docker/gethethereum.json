{
  "name": "geth-ethereum",
  "repo": "ethereum/client-go",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/ethereum/client-go/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--http --http.corsdomain localhost --ws --ws.origins localhost --http.api eth,net,engine,admin --authrpc.jwtsecret /root/.ethereum/jwt.hex --authrpc.vhosts=* --authrpc.addr=geth-ethereum",
  "web_ui_url": "http://[IP]:[PORT:8551]",
  "icon": "https://geth.ethereum.org/static/images/favicon.png",
  "project": "https://github.com/ethereum/go-ethereum",
  "description": "Official golang implementation of the Ethereum protocol.",
  "paths": [
    {
      "name": "data-path",
      "host": "/mnt/cache/blockchain/ethereum/",
      "container": "/root/.ethereum",
      "mode": "rw",
      "description": "Persistent data directory for blockchain files, keys",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "consensus Web-Socket",
      "host": "8551",
      "container": "8551",
      "protocol": "tcp",
      "description": "Communication with consensus layer (beacon)",
      "required": false,
      "mask": false
    },
    {
      "name": "JSON-RPC HTTP",
      "host": "8545",
      "container": "8545",
      "protocol": "tcp",
      "description": "JSON-RPC HTTP server supports a number of APIs.",
      "required": true,
      "mask": false
    },
    {
      "name": "JSON-RPC Web-Socket",
      "host": "8546",
      "container": "8546",
      "protocol": "tcp",
      "description": "Web-Sockets server supports a number of APIs.",
      "required": true,
      "mask": false
    },
    {
      "name": "listener",
      "host": "30303",
      "container": "30303",
      "protocol": "tcp",
      "description": "listener (TCP) port",
      "required": true,
      "mask": false
    },
    {
      "name": "discovery",
      "host": "30303",
      "container": "30303",
      "protocol": "udp",
      "description": "discovery (UDP) port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
