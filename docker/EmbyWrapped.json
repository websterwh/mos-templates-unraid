{
  "name": "EmbyWrapped",
  "repo": "ghcr.io/ctznsniiips/emby-wrapped:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/CtznSniiips/emby-wrapped",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3003]/",
  "icon": "https://github.com/CtznSniiips/emby-wrapped/blob/main/src/lib/assets/embywrapped-logo.png?raw=true",
  "project": null,
  "description": "A beautiful, Spotify Wrapped-style year-in-review experience for your Emby media server. This fork includes enhanced music statistics, improved image handling, and more detailed viewing patterns.",
  "paths": [
    {
      "name": "Music",
      "host": "/mnt/cache/appdata/embywrapped/music",
      "container": "/app/static/music",
      "mode": "ro",
      "description": "Optional: custom background music",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3003",
      "container": "3003",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "EMBY_URL",
      "key": "EMBY_URL",
      "value": "",
      "description": "Required",
      "required": true,
      "mask": false
    },
    {
      "name": "EMBY_API_KEY",
      "key": "EMBY_API_KEY",
      "value": "",
      "description": "Required",
      "required": true,
      "mask": false
    },
    {
      "name": "TMDB_API_KEY",
      "key": "TMDB_API_KEY",
      "value": "",
      "description": "Optional: for enhanced poster images",
      "required": false,
      "mask": false
    },
    {
      "name": "PUBLIC_URL",
      "key": "PUBLIC_URL",
      "value": "",
      "description": "Optional: for share links",
      "required": false,
      "mask": false
    },
    {
      "name": "SEERR_URL",
      "key": "SEERR_URL",
      "value": "",
      "description": "Optional: Jellyseerr/Seerr URL for request stats",
      "required": false,
      "mask": false
    },
    {
      "name": "SEERR_API_KEY",
      "key": "SEERR_API_KEY",
      "value": "",
      "description": "Optional: Jellyseerr/Seerr API key",
      "required": false,
      "mask": false
    },
    {
      "name": "TRACEARR_URL",
      "key": "TRACEARR_URL",
      "value": "",
      "description": "Optional: Tracearr URL (uses Tracearr history instead of Playback Reporting)",
      "required": false,
      "mask": false
    },
    {
      "name": "TRACEARR_API_KEY",
      "key": "TRACEARR_API_KEY",
      "value": "",
      "description": "Optional: Tracearr public API key (format: trr_pub_*)",
      "required": false,
      "mask": false
    },
    {
      "name": "TRACEARR_USERNAME_ALIASES",
      "key": "TRACEARR_USERNAME_ALIASES",
      "value": "",
      "description": "Optional case-insensitive username mapping for Tracearr-to-Emby matching after renames. Format: oldname1:newname1,oldname2:newname2",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
