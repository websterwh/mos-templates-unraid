{
  "name": "element-web",
  "repo": "vectorim/element-web:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/vectorim/element-web/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/element-web.png",
  "project": "https://element.io/",
  "description": "Open, secure and interoperable communication for work and home. Used to call Riot-web. before the running the docker run mkdir -p /mnt/user/appdata/element-web/config wget -O /mnt/user/appdata/element-web/config/config.json https://raw.githubusercontent.com/vector-im/element-web/develop/element.io/app/config.json",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/element-web/config/config.json",
      "container": "/app/config.json",
      "mode": "rw",
      "description": "Container Path: /app/config.json",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8075",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
