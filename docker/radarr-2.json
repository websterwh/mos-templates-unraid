{
  "name": "radarr",
  "repo": "lscr.io/linuxserver/radarr",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/radarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7878]/system/status",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/radarr-logo.png",
  "project": "https://github.com/Radarr/Radarr",
  "description": "Radarr(https://github.com/Radarr/Radarr) - A fork of Sonarr to work with movies \u00e0 la Couchpotato.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Database and Radarr configs",
      "required": true
    },
    {
      "name": "Path: /movies",
      "host": "",
      "container": "/movies",
      "mode": "rw",
      "description": "Location of Movie library on disk (See note in Application setup)",
      "required": false
    },
    {
      "name": "Path: /downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Location of download managers output directory (See note in Application setup)",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "7878",
      "container": "7878",
      "protocol": "tcp",
      "description": "The port for the Radarr Web UI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
