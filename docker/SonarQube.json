{
  "name": "SonarQube",
  "repo": "sonarqube",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/_/sonarqube/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9000]",
  "icon": "https://github.com/SonarSource/sonarqube/raw/master/server/sonar-docs/src/images/sonarqube-icon.png",
  "project": "https://github.com/SonarSource/sonarqube",
  "description": "SonarQube is an open source platform for continuous inspection of code quality. By default, the image will use an embedded H2 database that is not suited for production. You can set up a database by following the \"Installing the Database\" section of https://docs.sonarqube.org/latest/setup/install-server/ (Requires seperate DB to be installed and linked)",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/sonarqube/data",
      "container": "/opt/sonarqube/data",
      "mode": "rw",
      "description": "Container Path: /opt/sonarqube/data",
      "required": false
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/sonarqube/logs",
      "container": "/opt/sonarqube/logs",
      "mode": "rw",
      "description": "Container Path: /opt/sonarqube/logs",
      "required": false
    },
    {
      "name": "Extensions",
      "host": "/mnt/cache/appdata/sonarqube/extesions",
      "container": "/opt/sonarqube/extensions",
      "mode": "rw",
      "description": "Container Path: /opt/sonarqube/extensions",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Container Port: 9000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "bootstrapChecks",
      "key": "SONAR_ES_BOOTSTRAP_CHECKS_DISABLE",
      "value": "true",
      "description": "Container Variable: SONAR_ES_BOOTSTRAP_CHECKS_DISABLE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
