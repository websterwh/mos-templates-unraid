{
  "name": "Unifi-to-Discord-webhook",
  "repo": "redzguilt/unifi-webhook-to-discord:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/redzguilt/unifi-webhook-to-discord",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7019]",
  "icon": "https://pbs.twimg.com/profile_images/1610157462321254402/tMCv8T-y_400x400.png",
  "project": "https://github.com/JZomDev/UnifiWebhookToDiscord",
  "description": "This is a tiny webhook listener that listens for Unifi's webhooks sent to the docker container's IP:PORT and formats the message to a Discord webhook. You can add devices by using a device's mac address as a variable and the device name as the variable name, visit the project's repo for a read me.",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/UnifiWebhookToDiscord",
      "container": "/var/",
      "mode": "rw",
      "description": "Logs stored here",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "port",
      "host": "7019",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port Unifi sends messages to",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "webhook",
      "key": "webhook",
      "value": "https://discord.com/api/webhooks/1234567890/abcdefghijklmno",
      "description": "Webhook URL for the discord channel alerts go to",
      "required": false,
      "mask": false
    },
    {
      "name": "Alerter 1",
      "key": "MA:CA:DD:RR:EE:S1",
      "value": "Camera on Shed",
      "description": "MAC_ADDRESS - NAME OF DEVICE MAPPING",
      "required": false,
      "mask": false
    },
    {
      "name": "Alerter 2",
      "key": "MA:CA:DD:RR:EE:S2",
      "value": "Name for device",
      "description": "MAC_ADDRESS - NAME OF DEVICE MAPPING",
      "required": false,
      "mask": false
    },
    {
      "name": "UUID_1",
      "key": "UUID_1",
      "value": "",
      "description": "Console UUID for remote viewing",
      "required": false,
      "mask": false
    },
    {
      "name": "UUID_2",
      "key": "UUID_2",
      "value": "",
      "description": "Console UUID (other value) for remote viewing",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
