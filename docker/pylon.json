{
  "name": "pylon",
  "repo": "lscr.io/linuxserver/pylon",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/pylon",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3131]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "https://github.com/pylonide/pylon",
  "description": "Pylon(https://github.com/pylonide/pylon) is a web based integrated development environment built with Node.js as a backend and with a supercharged JavaScript/HTML5 frontend, licensed under GPL version 3. This project originates from Cloud9 v2 project.",
  "paths": [
    {
      "name": "Path: /code",
      "host": "",
      "container": "/code",
      "mode": "rw",
      "description": "Optionally if you want the bind mount your own code and have changes survive container upgrades.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3131",
      "container": "3131",
      "protocol": "tcp",
      "description": "The port for the Pylon web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "GITURL",
      "key": "GITURL",
      "value": "https://github.com/linuxserver/docker-pylon.git",
      "description": "Specify a git repo to checkout on first startup",
      "required": false,
      "mask": false
    },
    {
      "name": "PYUSER",
      "key": "PYUSER",
      "value": "myuser",
      "description": "Specify a basic auth user.",
      "required": false,
      "mask": false
    },
    {
      "name": "PYPASS",
      "key": "PYPASS",
      "value": "mypass",
      "description": "Specify a basic auth password.",
      "required": false,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
