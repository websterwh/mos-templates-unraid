{
  "name": "spotizerr-phoenix",
  "repo": "spotizerrphoenix/spotizerr",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/spotizerrphoenix/spotizerr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 1000:1000",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7171]/",
  "icon": "https://lavaforge.org/avatars/54ed1adfaf177b28f725ef89a3c556eb87c90bee587362b2f1374f9444dd5d7c?size=512",
  "project": "https://lavaforge.org/spotizerrphoenix/spotizerr-phoenix",
  "description": "NOTE: Must have premium Spotify account! A self-hosted music download manager with a lossless twist. Download everything from Spotify, and if it happens to also be on Deezer, download from there so you get those tasty FLACs. Setup Instructions (READ THE FULL DOCS BEFORE USING): https://spotizerr-phoenix.readthedocs.io/",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/spotizerr-phoenix",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Download Directory",
      "host": "",
      "container": "/app/downloads",
      "mode": "rw",
      "description": "Set to Mucic Library or other directory",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/spotizerr-phoenix/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Cache File",
      "host": "/mnt/cache/appdata/spotizerr-phoenix/.cache",
      "container": "/app/.cache",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "7171",
      "container": "7171",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "REDIS_HOST",
      "key": "REDIS_HOST",
      "value": "redis",
      "description": "Change to match your redis container name or IP address.",
      "required": true,
      "mask": false
    },
    {
      "name": "REDIS_PORT",
      "key": "REDIS_PORT",
      "value": "6379",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "REDIS_DB",
      "key": "REDIS_DB",
      "value": "0",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "EXPLICIT_FILTER",
      "key": "EXPLICIT_FILTER",
      "value": "false",
      "description": "Set to true to filter out explicit content",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
