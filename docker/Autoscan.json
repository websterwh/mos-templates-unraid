{
  "name": "Autoscan",
  "repo": "cloudb0x/autoscan:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/cloudb0x/autoscan",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3030]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/autoscan-icon.png",
  "project": "https://github.com/Cloudbox/autoscan",
  "description": "Autoscan replaces the default Plex and Emby behaviour for picking up file changes on the file system. Autoscan integrates with Sonarr, Radarr, Readarr, Lidarr and Google Drive to fetch changes in near real-time without relying on the file system.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/autoscan/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Webhooks Port",
      "host": "3030",
      "container": "3030",
      "protocol": "tcp",
      "description": "Container Port: 3030",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Verbosity",
      "key": "AUTOSCAN_VERBOSITY",
      "value": "0|1|2",
      "description": "0=Info, 1=Debug, 2=Trace",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
