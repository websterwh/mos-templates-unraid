{
  "name": "Telegram-Files",
  "repo": "ghcr.io/jarvis2f/telegram-files:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/jarvis2f/telegram-files/pkgs/container/telegram-files",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/jarvis2f/telegram-files/refs/heads/main/web/public/favicon-96x96.png",
  "project": "https://github.com/jarvis2f/telegram-files",
  "description": "A simple telegram file downloader. https://github.com/jarvis2f/telegram-files It supports downloading files from Telegram channels and groups, multiple Telegram accounts for downloading, and the ability to pause and resume downloads.",
  "paths": [
    {
      "name": "ROOT Directory",
      "host": "",
      "container": "/app/data",
      "mode": "rw",
      "description": "The root directory for the application. If you change this, you will need to update the APP_ROOT variable.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEBUI Port",
      "host": "6543",
      "container": "80",
      "protocol": "tcp",
      "description": "The port for the web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP ROOT",
      "key": "APP_ROOT",
      "value": "/app/data",
      "description": "The root directory for the application.",
      "required": true,
      "mask": false
    },
    {
      "name": "TELEGRAM API ID",
      "key": "TELEGRAM_API_ID",
      "value": "",
      "description": "The API ID from https://my.telegram.org/apps",
      "required": true,
      "mask": false
    },
    {
      "name": "TELEGRAM API HASH",
      "key": "TELEGRAM_API_HASH",
      "value": "",
      "description": "The API Hash from https://my.telegram.org/apps",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
