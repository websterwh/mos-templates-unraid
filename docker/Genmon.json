{
  "name": "Genmon",
  "repo": "m0ngr31/genmon",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/m0ngr31/genmon",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://i.imgur.com/LqrD3CY.png",
  "project": "https://github.com/jgyates/genmon",
  "description": "Genmon The Genmon project will monitor a backup generator that utilizes the Generac Controllers. This container is specifically made for compatibility with ESP32 devices.",
  "paths": [
    {
      "name": "App Config",
      "host": "/mnt/cache/appdata/genmon",
      "container": "/etc/genmon",
      "mode": "rw",
      "description": "Container Path: /etc/genmon",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Server Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port that server listens on",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
