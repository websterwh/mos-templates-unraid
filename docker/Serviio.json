{
  "name": "Serviio",
  "repo": "riftbit/serviio",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/riftbit/serviio",
  "network": "ibraproxy",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:23423]/console",
  "icon": "https://i.imgur.com/Pcals31.png",
  "project": "https://serviio.org/",
  "description": "Serviio is a freeware media server designed to let users stream music, video, or image files to DLNA compliant televisions, Blu-ray players, game consoles, and Android or Windows Mobile devices on a home network. Make sure to give it some time then restart the container at least once. If you want to use a custom config you need to map the path: /opt/serviio/config to your AppData install directory.",
  "paths": [
    {
      "name": "Host Path 5",
      "host": "/mnt/cache/TV/",
      "container": "/media/serviio",
      "mode": "rw",
      "description": "Path (root) to media content. ADD the container path (/media/serviio) into Library &gt; Shared Folder in Serviio GUI",
      "required": true
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/serviio/library",
      "container": "/opt/serviio/library",
      "mode": "rw",
      "description": "Container Path: /opt/serviio/library",
      "required": true
    },
    {
      "name": "Host Path 3",
      "host": "/mnt/cache/appdata/serviio/plugins",
      "container": "/opt/serviio/plugins",
      "mode": "rw",
      "description": "Container Path: /opt/serviio/plugins",
      "required": true
    },
    {
      "name": "Host Path 4",
      "host": "/mnt/cache/appdata/serviio/log",
      "container": "/opt/serviio/log",
      "mode": "rw",
      "description": "Container Path: /opt/serviio/log",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEBUI",
      "host": "23423",
      "container": "23423",
      "protocol": "tcp",
      "description": "WEBUI PORT Access by going to http://IP:23423/console",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "1900",
      "container": "1900",
      "protocol": "tcp",
      "description": "Container Port: 1900",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 3",
      "host": "23523",
      "container": "23523",
      "protocol": "tcp",
      "description": "Container Port: 23523",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 5",
      "host": "23424",
      "container": "23424",
      "protocol": "tcp",
      "description": "Container Port: 23424",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 6",
      "host": "23524",
      "container": "23524",
      "protocol": "tcp",
      "description": "Container Port: 23524",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "8895",
      "container": "8895",
      "protocol": "tcp",
      "description": "Container Port: 8895",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
