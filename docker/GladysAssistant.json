{
  "name": "Gladys-Assistant",
  "repo": "gladysassistant/gladys:v4",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/gladysassistant/gladys/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--restart=unless-stopped --log-opt max-size=10m --cgroupns=host",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8006]",
  "icon": "https://gladysassistant.com/en/img/external/github-gladys-logo.png",
  "project": "https://gladysassistant.com/",
  "description": "Gladys Assistant (https://gladysassistant.com) is a privacy-first, open-source home assistant. Gladys helps you centralize your connected devices, visualize data on your dashboards and build automations to make your daily life easier. You can support the project here : https://www.buymeacoffee.com/gladysassistant",
  "paths": [
    {
      "name": "Gladys lib folder",
      "host": "/mnt/cache/appdata/Gladys",
      "container": "/var/lib/gladysassistant",
      "mode": "rw",
      "description": "Container Path: /var/lib/gladysassistant",
      "required": true
    },
    {
      "name": "Gladys Dev Folder",
      "host": "/dev",
      "container": "/dev",
      "mode": "rw",
      "description": "Container Path: /dev",
      "required": true
    },
    {
      "name": "Gladys uDev Folder",
      "host": "/run/udev",
      "container": "/run/udev",
      "mode": "ro",
      "description": "Container Path: /run/udev",
      "required": true
    },
    {
      "name": "Gladys Docker Folder",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Container Path: /var/run/docker.sock",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "Europe/Paris",
      "description": "Visit https://en.wikipedia.org/wiki/List_of_tz_database_time_zones to get the right one",
      "required": true,
      "mask": false
    },
    {
      "name": "server-port",
      "key": "SERVER_PORT",
      "value": "8006",
      "description": "Container Variable: SERVER_PORT",
      "required": true,
      "mask": false
    },
    {
      "name": "DB File path",
      "key": "SQLITE_FILE_PATH",
      "value": "/var/lib/gladysassistant/gladys-production.db",
      "description": "Container Variable: SQLITE_FILE_PATH",
      "required": true,
      "mask": false
    },
    {
      "name": "Environement",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Container Variable: NODE_ENV",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
