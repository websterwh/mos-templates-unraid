{
  "name": "SiliconNotes",
  "repo": "bityard/silicon",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/bityard/silicon",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/siliconnotes.png",
  "project": "https://github.com/cu/silicon",
  "description": "A somewhat lightweight, low-friction personal knowledge base with few frills. Note that you will need to chmod 777 your /mnt/user/appdata/siliconnotes folder to get this to run.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/siliconnotes",
      "container": "/home/silicon/instance",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
