{
  "name": "Firefly-III",
  "repo": "fireflyiii/core:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/fireflyiii/core/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/MattFaz/unraid_templates/main/images/fireflyiii-logo.png",
  "project": "https://docs.firefly-iii.org/",
  "description": "\"Firefly III\" is a (self-hosted) manager for your personal finances. It can help you keep track of your expenses and income, so you can spend less and save more. Firefly III supports the use of budgets, categories and tags. Using a bunch of external tools, you can import data. It also has many neat financial reports available.",
  "paths": [
    {
      "name": "Upload Path",
      "host": "/mnt/cache/appdata/firefly-iii",
      "container": "/var/www/html/storage/upload",
      "mode": "rw",
      "description": "appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Firefly-iii WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_KEY",
      "key": "APP_KEY",
      "value": "",
      "description": "32 character key",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "Database Host",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "",
      "description": "Database Port",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_CONNECTION",
      "key": "DB_CONNECTION",
      "value": "",
      "description": "Database Connection (mysql or pgsql)",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_DATABASE",
      "key": "DB_DATABASE",
      "value": "",
      "description": "Database Name",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": "",
      "description": "Database Username",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "Database Password",
      "required": true,
      "mask": true
    },
    {
      "name": "TRUSTED_PROXIES",
      "key": "TRUSTED_PROXIES",
      "value": "**",
      "description": "Set to ** when using Doceker and/or a reverse proxy",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
