{
  "name": "VS-Code-Server",
  "repo": "ahmadnassri/vscode-server",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/ahmadnassri/vscode-server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=IPC_LOCK --hostname vscode",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://code.visualstudio.com/apple-touch-icon.png",
  "project": "https://github.com/ahmadnassri/docker-vscode-server",
  "description": "The **official** Visual Studio Code Server, dockerized! Visual Studio Code Server can be installed everywhere and easily used through a browser. No desktop application required. All extensions supported.",
  "paths": [
    {
      "name": "Workspace",
      "host": "/mnt/cache/workspace",
      "container": "/root/workspace",
      "mode": "rw",
      "description": "path for your projects",
      "required": false
    },
    {
      "name": "CLI Data",
      "host": "/mnt/cache/appdata/vscode-server/cli-data",
      "container": "/root/.vscode/cli-data",
      "mode": "rw",
      "description": "CLI metadata storage",
      "required": true
    },
    {
      "name": "Server Data",
      "host": "/mnt/cache/appdata/vscode-server/server-data",
      "container": "/root/.vscode/server-data",
      "mode": "rw",
      "description": "server data storage",
      "required": true
    },
    {
      "name": "User Data",
      "host": "/mnt/cache/appdata/vscode-server/user-data",
      "container": "/root/.vscode/user-data",
      "mode": "rw",
      "description": "user data storage",
      "required": true
    },
    {
      "name": "Extensions",
      "host": "/mnt/cache/appdata/vscode-server/extensions",
      "container": "/root/.vscode/extensions",
      "mode": "rw",
      "description": "extensions storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "The port for the server to listen on",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
