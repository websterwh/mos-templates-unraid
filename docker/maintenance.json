{
  "name": "maintenance",
  "repo": "ghcr.io/imagegenius/maintenance",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/imagegenius/packages/container/package/maintenance",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/imagegenius/templates/main/unraid/img/maintenance.png",
  "project": "https://imagegenius/docker-maintenance/",
  "description": "Maintenance is a minimal nginx docker image with a soul purpose to be a maintenance page for when your main webserver is down",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Contains configuration files",
      "required": true
    },
    {
      "name": "Path: /swag",
      "host": "",
      "container": "/swag",
      "mode": "rw",
      "description": "Location of swag appdata on the host",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 443",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "UID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "GID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "UMASK for newly created files. Do not change unless you know what you're doing.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
