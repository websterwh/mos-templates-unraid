{
  "name": "Seanime",
  "repo": "ethxn/seanime:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/ethxn/seanime",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:43211]",
  "icon": "https://raw.githubusercontent.com/hawwwwwk/seanime-docker/main/icons/seanime.png",
  "project": "https://github.com/5rahim/seanime",
  "description": "Seanime is an open-source media server and anime management application. This container provides the Seanime server and web interface with FFmpeg support. Application data is stored in /config and the anime library is mounted at /anime.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/seanime",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent Seanime configuration, database, cache, and application data.",
      "required": true
    },
    {
      "name": "Anime Library",
      "host": "/mnt/cache/media/Seanime",
      "container": "/anime",
      "mode": "rw",
      "description": "Path to your anime library.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "43211",
      "container": "43211",
      "protocol": "tcp",
      "description": "Seanime web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Host",
      "key": "SEANIME_SERVER_HOST",
      "value": "0.0.0.0",
      "description": "Seanime server bind address. Leave this as 0.0.0.0 when running in Docker.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
