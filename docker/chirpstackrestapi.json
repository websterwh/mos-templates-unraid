{
  "name": "chirpstack-rest-api",
  "repo": "chirpstack/chirpstack-rest-api",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/chirpstack/chirpstack-rest-api",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--server chirpstack:8080 --bind 0.0.0.0:8090 --insecure",
  "web_ui_url": "http://[IP]:[PORT:8090]",
  "icon": "https://raw.githubusercontent.com/andaks/unraid-templates/master/chirpstack/chirpstack_logo.png",
  "project": "https://www.chirpstack.io/",
  "description": "A proxy component that exposes the ChirpStack (v4) gRPC API as a REST API. Required: chirpstack",
  "paths": [],
  "ports": [
    {
      "name": "Application Port",
      "host": "8090",
      "container": "8090",
      "protocol": "tcp",
      "description": "Port to access chirpstack api",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
