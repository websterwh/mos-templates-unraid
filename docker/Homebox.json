{
  "name": "Homebox",
  "repo": "ghcr.io/sysadminsmedia/homebox:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/sysadminsmedia/homebox",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7745]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/homebox_logo.png",
  "project": "https://github.com/sysadminsmedia/homebox",
  "description": "Homebox is the inventory and organization system built for the Home User! With a focus on simplicity and ease of use, Homebox is the perfect solution for your home inventory, organization, and management needs",
  "paths": [
    {
      "name": "Data Dir",
      "host": "/mnt/cache/appdata/homebox",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "3100",
      "container": "7745",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Log Level",
      "key": "HBOX_LOG_LEVEL",
      "value": "info",
      "description": "log level to use, can be one of: trace, debug, info, warn, error, critical",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Format",
      "key": "HBOX_LOG_FORMAT",
      "value": "text",
      "description": "log format to use, can be one of: text, json",
      "required": false,
      "mask": false
    },
    {
      "name": "Maximum fil upload size",
      "key": "HBOX_WEB_MAX_UPLOAD_SIZE",
      "value": "10",
      "description": "maximum file upload size supported in MB",
      "required": false,
      "mask": false
    },
    {
      "name": "Allow Registration",
      "key": "HBOX_OPTIONS_ALLOW_REGISTRATION",
      "value": "true",
      "description": "allow users to register themselves",
      "required": true,
      "mask": false
    },
    {
      "name": "Check For Github Releases",
      "key": "HBOX_OPTIONS_CHECK_GITHUB_RELEASE",
      "value": "true",
      "description": "check for new github releases",
      "required": false,
      "mask": false
    },
    {
      "name": "Auth API Key Pepper",
      "key": "HBOX_AUTH_API_KEY_PEPPER",
      "value": "",
      "description": "pepper for hashing API keys",
      "required": true,
      "mask": true
    },
    {
      "name": "Mode",
      "key": "HBOX_MODE",
      "value": "production",
      "description": "application mode used for runtime behavior can be one of: development, production",
      "required": false,
      "mask": false
    },
    {
      "name": "Auto Increment Asset IDs",
      "key": "HBOX_OPTIONS_AUTO_INCREMENT_ASSET_ID",
      "value": "true",
      "description": "auto increments the asset_id field for new items",
      "required": false,
      "mask": false
    },
    {
      "name": "Web Read Timeout",
      "key": "HBOX_WEB_READ_TIMEOUT",
      "value": "10s",
      "description": "Read timeout of HTTP sever",
      "required": false,
      "mask": false
    },
    {
      "name": "Web Write Timeout",
      "key": "HBOX_WEB_WRITE_TIMEOUT",
      "value": "10s",
      "description": "Write timeout of HTTP server",
      "required": false,
      "mask": false
    },
    {
      "name": "Web Idle Timeout",
      "key": "HBOX_WEB_IDLE_TIMEOUT",
      "value": "30s",
      "description": "Idle timeout of HTTP server",
      "required": false,
      "mask": false
    },
    {
      "name": "Mail Host",
      "key": "HBOX_MAILER_HOST",
      "value": "",
      "description": "email host to use, if not set no email provider will be used",
      "required": false,
      "mask": false
    },
    {
      "name": "Mailer Port",
      "key": "HBOX_MAILER_PORT",
      "value": "587",
      "description": "email port to use",
      "required": false,
      "mask": false
    },
    {
      "name": "Mailer Username",
      "key": "HBOX_MAILER_USERNAME",
      "value": "",
      "description": "email user to use",
      "required": false,
      "mask": false
    },
    {
      "name": "Mailer Password",
      "key": "HBOX_MAILER_PASSWORD",
      "value": "",
      "description": "email password to use",
      "required": false,
      "mask": false
    },
    {
      "name": "Mailer Sender Address",
      "key": "HBOX_MAILER_FROM",
      "value": "",
      "description": "email from address to use",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
