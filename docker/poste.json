{
  "name": "poste",
  "repo": "analogic/poste.io",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/analogic/poste.io/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://icons.iconarchive.com/icons/paomedia/small-n-flat/96/envelope-icon.png",
  "project": "https://poste.io/",
  "description": "FREE version of Poste.io, full mail server solution. POP3, SMTP, IMAP, Spamassassin, WebMail, WebAdmin. INITIAL SETUP: ------------------------ 0. Requires registered FQDN to send/receive external email. 1. Following ports are used by container for mail: 25, 110, 143, 443, 465, 587, 993, 995 2. Following ports are used by container for webui: 443, 8280 (These may conflict, check your ports) 3. Make a user share for mail data, default is /mnt/user/poste 4. Some or all mail ports may need to be opened, forwarded, or dmz for mail send/receive to work. Optional arguments -e \"HTTPS=OFF\" To disable all redirects to encrypted HTTP, its useful when you are using some kind of reverse proxy (place this argument before image name!) ------------------------- NOTE: Marked as BETA, simply because author is not an expert in email exchange servers -- software itself looks pretty good.",
  "paths": [
    {
      "name": "Data Folder",
      "host": "/mnt/cache/poste",
      "container": "/data",
      "mode": "rw",
      "description": "poste data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port25",
      "host": "25",
      "container": "25",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": true,
      "mask": false
    },
    {
      "name": "Webui",
      "host": "8280",
      "container": "80",
      "protocol": "tcp",
      "description": "web interface port",
      "required": true,
      "mask": false
    },
    {
      "name": "POP3 Port",
      "host": "110",
      "container": "110",
      "protocol": "tcp",
      "description": "POP3",
      "required": true,
      "mask": false
    },
    {
      "name": "IMAP",
      "host": "143",
      "container": "143",
      "protocol": "tcp",
      "description": "IMAP",
      "required": true,
      "mask": false
    },
    {
      "name": "Container HTTPS",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS",
      "required": true,
      "mask": false
    },
    {
      "name": "Container SMTPS",
      "host": "465",
      "container": "465",
      "protocol": "tcp",
      "description": "SMTPS",
      "required": true,
      "mask": false
    },
    {
      "name": "Container MSA",
      "host": "587",
      "container": "587",
      "protocol": "tcp",
      "description": "MSA",
      "required": true,
      "mask": false
    },
    {
      "name": "Container IMAPS",
      "host": "993",
      "container": "993",
      "protocol": "tcp",
      "description": "IMAPS",
      "required": true,
      "mask": false
    },
    {
      "name": "Container POP3S",
      "host": "995",
      "container": "995",
      "protocol": "tcp",
      "description": "POP3S",
      "required": true,
      "mask": false
    },
    {
      "name": "external Sieve filter manager",
      "host": "4190",
      "container": "4190",
      "protocol": "tcp",
      "description": "When you are going to use clients with ability to manage Sieve filters externally, you need also publish port 4190",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
