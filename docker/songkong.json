{
  "name": "songkong",
  "repo": "songkong/songkong",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/songkong/songkong/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4567]/",
  "icon": "https://www.jthink.net/songkong/images/songkong_icon256.png",
  "project": "http://www.jthink.net/songkong",
  "description": "Official SongKong Docker repository, Identify your songs and add metadata and artwork automatically",
  "paths": [
    {
      "name": "Music",
      "host": "/mnt/cache/music",
      "container": "/music",
      "mode": "rw",
      "description": "Container Path: /music",
      "required": false
    },
    {
      "name": "SongKong Config",
      "host": "/mnt/cache/appdata/songkong",
      "container": "/songkong",
      "mode": "rw",
      "description": "Container Path: /songkong",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "4567",
      "container": "4567",
      "protocol": "tcp",
      "description": "Container Port: 4567",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
