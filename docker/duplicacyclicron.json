{
  "name": "duplicacy-cli-cron",
  "repo": "drumsergio/duplicacy-cli-cron:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/drumsergio/duplicacy-cli-cron",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/GeiserX/docker-templates/master/drumsergio/images/duplicacy-cli-cron.png",
  "project": "https://github.com/GeiserX/duplicacy-cli-cron",
  "description": "Duplicacy CLI with automated cron-scheduled backups to two independent S3-compatible storage endpoints for cross-site redundancy. Supports daily, weekly, and monthly backup schedules with parallel threading, Shoutrrr notifications, and configurable retention policies. Alpine-based, multi-arch (amd64/arm64/armv7). Designed to back up Unraid shares to S3 storage (Garage, MinIO, Backblaze, etc.). More info: https://github.com/GeiserX/duplicacy-cli-cron",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/duplicacy-cli-cron/config",
      "container": "/config",
      "mode": "rw",
      "description": "Duplicacy configuration and scripts",
      "required": true
    },
    {
      "name": "Cron Jobs",
      "host": "/mnt/cache/appdata/duplicacy-cli-cron/periodic",
      "container": "/etc/periodic",
      "mode": "rw",
      "description": "Cron job scripts (daily, weekly, monthly)",
      "required": true
    },
    {
      "name": "Data to Back Up",
      "host": "/mnt/user",
      "container": "/local_shares",
      "mode": "ro",
      "description": "Source data directories to back up (read-only)",
      "required": true
    },
    {
      "name": "Boot USB",
      "host": "/boot",
      "container": "/boot_usb",
      "mode": "ro",
      "description": "Unraid boot USB for backup (read-only, optional)",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Primary S3 Endpoint",
      "key": "ENDPOINT_1",
      "value": "",
      "description": "Primary S3 endpoint URL",
      "required": true,
      "mask": false
    },
    {
      "name": "Secondary S3 Endpoint",
      "key": "ENDPOINT_2",
      "value": "",
      "description": "Secondary S3 endpoint URL for redundancy",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Bucket",
      "key": "BUCKET",
      "value": "",
      "description": "S3 bucket name",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Region",
      "key": "REGION",
      "value": "garage",
      "description": "S3 region identifier",
      "required": true,
      "mask": false
    },
    {
      "name": "Daily Schedule",
      "key": "CRON_DAILY",
      "value": "0 2 * * *",
      "description": "Cron expression for daily backups",
      "required": false,
      "mask": false
    },
    {
      "name": "Threads",
      "key": "DUPLICACY_THREADS",
      "value": "4",
      "description": "Number of parallel upload threads",
      "required": false,
      "mask": false
    },
    {
      "name": "Notification URL",
      "key": "SHOUTRRR_URL",
      "value": "",
      "description": "Shoutrrr notification URL for backup alerts",
      "required": false,
      "mask": true
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Timezone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
