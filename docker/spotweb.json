{
  "name": "spotweb",
  "repo": "jgeusebroek/spotweb",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/jgeusebroek/spotweb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/riffsphereha/Unraid-Templates/main/spotweb/Spotweb.webp",
  "project": "https://github.com/spotweb/spotweb",
  "description": "Spotweb is a decentralized usenet community based on the Spotnet protocol. Spotweb requires an operational webserver with PHP7.2 installed, it uses either an MySQL or an PostgreSQL database to store it's contents in.",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/spotweb",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "7171",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database server",
      "key": "SPOTWEB_DB_HOST",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Database server port",
      "key": "SPOTWEB_DB_PORT",
      "value": "3306",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "SPOTWEB_DB_NAME",
      "value": "spotweb",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "SPOTWEB_DB_USER",
      "value": "spotweb",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "SPOTWEB_DB_PASS",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Database Type",
      "key": "SPOTWEB_DB_TYPE",
      "value": "pdo_mysql",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Retrieve Cron Setting",
      "key": "SPOTWEB_CRON_RETRIEVE",
      "value": "*/15 * * * *",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
