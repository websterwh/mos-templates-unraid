{
  "name": "FeedCrawler",
  "repo": "rix1337/docker-feedcrawler",
  "category": [
    "Downloader"
  ],
  "registry": "https://registry.hub.docker.com/r/rix1337/docker-feedcrawler",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--log-opt max-size=50m",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9090]/",
  "icon": "https://i.imgur.com/5trnN5j.png",
  "project": "https://github.com/rix1337/FeedCrawler",
  "description": "This python-based script automates downloads for JDownloader crawling web feeds. After the first launch you need to provide correct hostnames in FeedCrawler.ini at /config. Only useful for German users. Very advanced and user friendly features.",
  "paths": [
    {
      "name": "Config-Path",
      "host": "/mnt/cache/appdata/feedcrawler/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Webserver",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Container Port: 9090",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Delay first feed search after launch in Seconds",
      "key": "DELAY",
      "value": "",
      "description": "Container Variable: DELAY",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "LOGLEVEL",
      "value": "",
      "description": "Container Variable: LOGLEVEL",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
