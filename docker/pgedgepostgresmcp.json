  "project": "https://docs.pgedge.com/",
  "description": "The pgEdge Postgres Model Context Protocol (MCP) server enables SQL queries against PostgreSQL databases through MCP-compatible clients. The Natural Language Agent provides supporting functionality that allows you to use natural language to form SQL queries. Supported Versions: PostgreSQL 14 and higher. If you on windows, you can generate random api token using powershell with command: $bytes = New-Object byte 32 ::Fill($bytes) ::ToHexString($bytes).ToLower() Then place it at \"INIT_TOKENS\". You will use the same value as the MCP bearer token in ChatGPT, Copilot and others. Verify after starting: http://Unraid_IP:8080/health",
  "paths": [
    {
      "name": "MCP Data",
      "host": "/mnt/cache/appdata/pgedge-postgres-mcp",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
