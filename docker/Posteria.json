{
  "name": "Posteria",
  "repo": "bozodev/posteria:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/bozodev/posteria",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/ctrlaltd1337ed/unraid-templates/refs/heads/main/templates/logos/posteria.png",
  "project": "https://posteria.app/",
  "description": "Posteria is a web-based media poster management system that allows you to organize and store custom posters for your movies, TV shows, seasons, and collections. It provides an elegant interface for uploading, importing, managing, and accessing your media artwork.",
  "paths": [
    {
      "name": "Posters Path",
      "host": "",
      "container": "/config/posters",
      "mode": "rw",
      "description": "Where your posters will live on your server",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/posteria/logs",
      "container": "/config/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port",
      "host": "1818",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SITE_TITLE",
      "key": "SITE_TITLE",
      "value": "Posteria",
      "description": "Website title",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTH_USERNAME",
      "key": "AUTH_USERNAME",
      "value": "admin",
      "description": "Change this!",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTH_PASSWORD",
      "key": "AUTH_PASSWORD",
      "value": "changeme",
      "description": "Change this!",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTH_BYPASS",
      "key": "AUTH_BYPASS",
      "value": "false",
      "description": "DO NOT USE if you expose Posteria outside your local network",
      "required": false,
      "mask": false
    },
    {
      "name": "PLEX_SERVER_URL",
      "key": "PLEX_SERVER_URL",
      "value": "PLEXURL",
      "description": "URL for your Plex Server",
      "required": false,
      "mask": false
    },
    {
      "name": "PLEX_TOKEN",
      "key": "PLEX_TOKEN",
      "value": "PLEXTOKEN",
      "description": "Plex Server Token https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/",
      "required": false,
      "mask": false
    },
    {
      "name": "PLEX_REMOVE_OVERLAY_LABEL",
      "key": "PLEX_REMOVE_OVERLAY_LABEL",
      "value": "false",
      "description": "Set to true for Kometa compatibility",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTO_IMPORT_ENABLED",
      "key": "AUTO_IMPORT_ENABLED",
      "value": "false",
      "description": "Set to true to auto-import new posters",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTO_IMPORT_SCHEDULE",
      "key": "AUTO_IMPORT_SCHEDULE",
      "value": "24h",
      "description": "Schedule 24h, 12h, 6h, 3h, 1h",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTO_IMPORT_MOVIES",
      "key": "AUTO_IMPORT_MOVIES",
      "value": "false",
      "description": "Set to true to auto-import new movie posters",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTO_IMPORT_SHOWS",
      "key": "AUTO_IMPORT_SHOWS",
      "value": "false",
      "description": "Set to true to auto-import new TV show posters",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTO_IMPORT_SEASONS",
      "key": "AUTO_IMPORT_SEASONS",
      "value": "false",
      "description": "Set to true to auto-import new TV show season posters",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTO_IMPORT_COLLECTIONS",
      "key": "AUTO_IMPORT_COLLECTIONS",
      "value": "false",
      "description": "Set to true to auto-import new collection posters",
      "required": false,
      "mask": false
    },
    {
      "name": "SORT_BY_DATE_ADDED",
      "key": "SORT_BY_DATE_ADDED",
      "value": "true",
      "description": "Set to true to sort by Recently Added date in Plex instead of Alphabetically",
      "required": false,
      "mask": false
    },
    {
      "name": "EXCLUDED_LIBRARIES",
      "key": "EXCLUDED_LIBRARIES",
      "value": "false",
      "description": "Comma-separated list of library names to exclude",
      "required": false,
      "mask": false
    },
    {
      "name": "IGNORE_ARTICLES_IN_SORT",
      "key": "IGNORE_ARTICLES_IN_SORT",
      "value": "false",
      "description": "Set to false to sort with articles (A, An, The) included",
      "required": false,
      "mask": false
    },
    {
      "name": "SESSION_DURATION",
      "key": "SESSION_DURATION",
      "value": "3600",
      "description": "Login session duration in seconds",
      "required": false,
      "mask": false
    },
    {
      "name": "IMAGES_PER_PAGE",
      "key": "IMAGES_PER_PAGE",
      "value": "24",
      "description": "Number of posters displayed per page",
      "required": false,
      "mask": false
    },
    {
      "name": "MAX_FILE_SIZE",
      "key": "MAX_FILE_SIZE",
      "value": "15728640",
      "description": "Maximum upload file size in bytes (default is 15MB)",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
