{
  "name": "trailarr",
  "repo": "nandyalu/trailarr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/nandyalu/trailarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7889]/",
  "icon": "https://raw.githubusercontent.com/nandyalu/trailarr/main/assets/images/trailarr-256.png",
  "project": "https://github.com/nandyalu/trailarr",
  "description": "Trailarr is a Docker application to download and manage trailers for your media library. It integrates with your existing services, such as Plex, Radarr, and Sonarr!",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/trailarr",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Radarr Root",
      "host": "LOCAL_MEDIA_FOLDER",
      "container": "RADARR_ROOT_FOLDER",
      "mode": "rw",
      "description": "Change host path to the folder where your media is stored. Change container path to Radarr's root folder.",
      "required": true
    },
    {
      "name": "Sonarr Root",
      "host": "LOCAL_MEDIA_FOLDER",
      "container": "SONARR_ROOT_FOLDER",
      "mode": "rw",
      "description": "Change host path to the folder where your media is stored. Change container path to Sonarr's root folder.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "7889",
      "container": "7889",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
