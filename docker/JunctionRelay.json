{
  "name": "JunctionRelay",
  "repo": "catapultcase/junctionrelay:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/catapultcase/junctionrelay",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7180]/",
  "icon": "https://catapultcase.com/wp-content/uploads/2025/07/JunctionRelay-1.png",
  "project": "https://github.com/catapultcase/JunctionRelay",
  "description": "Unified data orchestration and IoT device management. Create Junctions to collect data from sources like Unraid, Home Assistant, and APIs, then stream it to local display panels and devices. NOTE: To send data to USB devices on the host machine, you may need to enable privileged mode.",
  "paths": [
    {
      "name": "Access Local Devices",
      "host": "/dev",
      "container": "/dev",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "DB Location",
      "host": "/mnt/cache/appdata/junctionrelay",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Mapping",
      "host": "7180",
      "container": "7180",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
