{
  "name": "calibre-web-automated",
  "repo": "crocodilestick/calibre-web-automated:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/crocodilestick/calibre-web-automated",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8083]",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/icons/35eb799864f41502e741075abfc6457ba0edefd6/calibre-web-logo.png",
  "project": "https://github.com/crocodilestick/Calibre-Web-Automator",
  "description": "A simple tool to give Calibre-Web the Auto-Import and Auto-Conversion Functionality. Fully automate and simplify your eBook set up.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/calibre-web-automated",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Import Folder",
      "host": "",
      "container": "/cwa-book-ingest",
      "mode": "rw",
      "description": "ATTENTION \u26a0\ufe0f - All files within this folder will be DELETED after being processed. This folder should only be used to dump new books into for import and automatic conversion",
      "required": true
    },
    {
      "name": "Calibre Library",
      "host": "",
      "container": "/calibre-library",
      "mode": "rw",
      "description": "This should be bound to the folder that your metadata.db file resides within.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8083",
      "container": "8083",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
