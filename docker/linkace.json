{
  "name": "linkace",
  "repo": "linkace/linkace:simple",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/linkace/linkace/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/linkace.png",
  "project": "https://www.linkace.org/",
  "description": "pLinkAce is a self-hosted archive to collect links of your favorite websites. /p p-span style=\"color: rgb(184, 49, 47);\"Before you start CLI Unraid/span emmkdir /mnt/user/appdata/linkace//em emwget -O /mnt/user/appdata/linkace/.env https://raw.githubusercontent.com/Kovah/LinkAce/main/.env.docker.production/em -Edit .env with your configuration -start the linkace then CLI linkace emphp artisan key:generate/em/p",
  "paths": [
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/linkace/logs/",
      "container": "/app/storage/logs",
      "mode": "rw",
      "description": "Logs Path",
      "required": false
    },
    {
      "name": ".env File",
      "host": "/mnt/cache/appdata/linkace/.env",
      "container": "/app/.env",
      "mode": "rw",
      "description": ".env File",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "4256",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
