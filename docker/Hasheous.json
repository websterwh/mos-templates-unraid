{
  "name": "Hasheous",
  "repo": "ghcr.io/gaseous-project/hasheous:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/gaseous-project/hasheous",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/gaseous-project/gaseous-server/refs/heads/main/logo.png",
  "project": "https://hasheous.org/",
  "description": "Public server to proxy and cache IGDB queries and provide hash matching and lookups for the Gaseous server and other projects.",
  "paths": [
    {
      "name": "Data Storage",
      "host": "/mnt/cache/appdata/hasheous/data",
      "container": "/root/.hasheous-server",
      "mode": "rw",
      "description": "Path to data storage location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7157",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database - Host",
      "key": "dbhost",
      "value": "",
      "description": "Database host",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Username",
      "key": "dbuser",
      "value": "",
      "description": "Database username",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Password",
      "key": "dbpass",
      "value": "",
      "description": "Database password",
      "required": true,
      "mask": true
    },
    {
      "name": "IGDB - Client ID",
      "key": "igdbclientid",
      "value": "",
      "description": "IGDB client ID",
      "required": true,
      "mask": false
    },
    {
      "name": "IGDB - Client Secret",
      "key": "igdbclientsecret",
      "value": "",
      "description": "IGDB client secret",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
