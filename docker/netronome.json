{
  "name": "netronome",
  "repo": "ghcr.io/autobrr/netronome:latest",
  "category": [
    "Network"
  ],
  "registry": "https://ghcr.io/autobrr/netronome",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_RAW --cap-add=NET_ADMIN",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7575]/",
  "icon": "https://raw.githubusercontent.com/Soitora/Unraid-Templates/refs/heads/main/netronome/logo.png",
  "project": "https://github.com/autobrr/netronome",
  "description": "Netronome is a modern network speed testing and monitoring tool built with Go and React. If you run into permission issues, run \"chmod 777\" for the netronome parent folder. You can also check to make sure that the folders are set to 101:102 rather than Unraid default of 99:100.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/netronome",
      "container": "/data",
      "mode": "rw,shared",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "7575",
      "container": "7575",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Session secret",
      "key": "NETRONOME__SESSION_SECRET",
      "value": "",
      "description": "Auto-generated if empty.",
      "required": false,
      "mask": true
    },
    {
      "name": "Listen address",
      "key": "NETRONOME__HOST",
      "value": "0.0.0.0",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Database type",
      "key": "NETRONOME__DB_TYPE",
      "value": "sqlite",
      "description": "Choose between sqlite and postgres.",
      "required": true,
      "mask": false
    },
    {
      "name": "SQLite Database path",
      "key": "NETRONOME__DB_PATH",
      "value": "/data/netronome/netronome.db",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PostgreSQL Database host",
      "key": "NETRONOME__DB_HOST",
      "value": "localhost",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PostgreSQL Database port",
      "key": "NETRONOME__DB_PORT",
      "value": "5432",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PostgreSQL Database user",
      "key": "NETRONOME__DB_USER",
      "value": "postgres",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PostgreSQL Database password",
      "key": "NETRONOME__DB_PASSWORD",
      "value": "secret",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "PostgreSQL Database name",
      "key": "NETRONOME__DB_NAME",
      "value": "netronome",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PostgreSQL Database SSL mode",
      "key": "NETRONOME__DB_SSLMODE",
      "value": "disable",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
