{
  "name": "Memtly.Community",
  "repo": "memtly/memtly:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/memtly/memtly",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/Memtly/Memtly.Assets/master/Logos/Community/Memtly.png",
  "project": "https://github.com/Memtly/Memtly.Community",
  "description": "Memtly is a very basic site with only one goal. It provides you and your guests a way to share memories of and leading up to an event.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/Memtly/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to configuration related data",
      "required": true
    },
    {
      "name": "Uploads Path",
      "host": "/mnt/cache/appdata/Memtly/uploads",
      "container": "/app/uploads",
      "mode": "rw",
      "description": "Path to gallery images",
      "required": true
    },
    {
      "name": "Thumbnails Path",
      "host": "/mnt/cache/appdata/Memtly/thumbnails",
      "container": "/app/thumbnails",
      "mode": "rw",
      "description": "Path to image thumbnails",
      "required": true
    },
    {
      "name": "Custom Resources Path",
      "host": "/mnt/cache/appdata/Memtly/custom_resources",
      "container": "/app/custom_resources",
      "mode": "rw",
      "description": "Path to custom uploaded resource files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Port used to connect to the web UI",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Title",
      "key": "TITLE",
      "value": "Memtly",
      "description": "Application title to appear in headers",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Type",
      "key": "DATABASE_TYPE",
      "value": "sqlite",
      "description": "The type of database backend to use",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Connection String",
      "key": "DATABASE_CONNECTION_STRING",
      "value": "Data Source=./config/memtly.db",
      "description": "The connection string for the database backend",
      "required": false,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "ACCOUNT_ADMIN_PASSWORD",
      "value": "ChangeMe",
      "description": "The password of the primary admin account",
      "required": false,
      "mask": true
    },
    {
      "name": "Encryption Key",
      "key": "SECURITY_ENCRYPTION_KEY",
      "value": "ChangeMe",
      "description": "The key used to encrypt data",
      "required": false,
      "mask": true
    },
    {
      "name": "Encryption Salt",
      "key": "SECURITY_ENCRYPTION_SALT",
      "value": "ChangeMe",
      "description": "The salt used to randomize the encryption",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
