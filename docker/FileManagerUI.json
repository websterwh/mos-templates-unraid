{
  "name": "FileManagerUI",
  "repo": "jandrop/file-manager-ui:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/jandrop/file-manager-ui",
  "network": "file-manager-network",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8764]",
  "icon": "https://raw.githubusercontent.com/jandrop/file_core_api_unraid/main/docs/icon.png",
  "project": "https://github.com/jandrop/file_core_api_unraid",
  "description": "File Manager UI - Modern web interface for managing files on Unraid shares. Requires FileManagerAPI to be installed and running FIRST. IMPORTANT: Both containers must use the same Docker network (file-manager-network). Create the network first: docker network create file-manager-network",
  "paths": [],
  "ports": [
    {
      "name": "UI Port",
      "host": "8764",
      "container": "8764",
      "protocol": "tcp",
      "description": "Port for web interface access (default: 8764)",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
