{
  "name": "CodeX-Docs",
  "repo": "ghcr.io/codex-team/codex.docs",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/codex-team/codex.docs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/b42n1/unraid-templates/main/logos/logo-codex-docs.png",
  "project": "https://docs.codex.so/",
  "description": "CodeX Docs is a simple free application for your internal, public or personal docs. It's based on Editor.js which is allowing to work with content with a nice and clean UI. Demo: https://docs-demo.codex.so/about-this-demo **Notice:** You have to create a docs-config.local.yaml before you install the container! Leave empty to get the deafult config. Example config: https://github.com/codex-team/codex.docs/blob/main/docs-config.yaml",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/codex.docs/docs-config.local.yaml",
      "container": "/usr/src/app/docs-config.yaml",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "uploads",
      "host": "/mnt/cache/appdata/codex.docs/uploads",
      "container": "/usr/src/app/uploads",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "db",
      "host": "/mnt/cache/appdata/codex.docs/db",
      "container": "/usr/src/app/db",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_CONFIG_auth_password",
      "key": "APP_CONFIG_auth_password",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
