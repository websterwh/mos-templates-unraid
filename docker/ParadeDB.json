{
  "name": "ParadeDB",
  "repo": "paradedb/paradedb:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/paradedb/paradedb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/paradedb-icon.png",
  "project": "https://paradedb.com",
  "description": "ParadeDB is an Elasticsearch alternative built on Postgres. We\u2019re modernizing the features of Elasticsearch, starting with real-time search and analytics.",
  "paths": [
    {
      "name": "Data path",
      "host": "/mnt/cache/appdata/paradedb/data",
      "container": "/var/lib/postgresql",
      "mode": "rw",
      "description": "Path to store the database data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Database Port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "Container Port: 5432",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Postgres User",
      "key": "POSTGRES_USER",
      "value": "",
      "description": "Postgres user",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Password",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "Postgres password",
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres Database",
      "key": "POSTGRES_DB",
      "value": "",
      "description": "Postgres database",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
