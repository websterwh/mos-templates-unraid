{
  "name": "AQtion-Server---3-Team",
  "repo": "aqtiongame/server:v51-bot27",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/aqtiongame/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:27940]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/aqtion-server-icon.png",
  "project": "https://github.com/actionquake/distrib",
  "description": "A server for the Action Quake 2 mod for Quake 2. This server is configured for 3 teams.",
  "paths": [
    {
      "name": "Message of the Day File",
      "host": "",
      "container": "/aq2server/action/motd.txt",
      "mode": "ro",
      "description": "A Message of the Day text file",
      "required": true
    },
    {
      "name": "Maps Path",
      "host": "/mnt/cache/appdata/aqtion_server_3team1/maps",
      "container": "/aq2server/action/maps",
      "mode": "rw",
      "description": "Path to maps",
      "required": true
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/aqtion_server_3team1/logs",
      "container": "/aq2server/action/logs",
      "mode": "rw",
      "description": "Path to log files",
      "required": true
    },
    {
      "name": "Demos Path",
      "host": "/mnt/cache/appdata/aqtion_server_3team1/demos",
      "container": "/aq2server/action/demos",
      "mode": "rw",
      "description": "Path to demos",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Server Port - TCP",
      "host": "27940",
      "container": "27940",
      "protocol": "tcp",
      "description": "Container Port: 27940",
      "required": true,
      "mask": false
    },
    {
      "name": "Server Port - UDP",
      "host": "27940",
      "container": "27940",
      "protocol": "udp",
      "description": "Container Port: 27940",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Port",
      "key": "PORT",
      "value": "27940",
      "description": "Internal server port. Must match port above.",
      "required": true,
      "mask": false
    },
    {
      "name": "Server Name",
      "key": "HOSTNAME",
      "value": "AQtion 3Team Server",
      "description": "Hostname of server in server browser",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "RCON_PASSWORD",
      "value": "",
      "description": "Password for remote console access",
      "required": true,
      "mask": true
    },
    {
      "name": "Team 1 - Name",
      "key": "TEAM_1_NAME",
      "value": "Red",
      "description": "Name of team 1",
      "required": true,
      "mask": false
    },
    {
      "name": "Team 1 - Skin",
      "key": "TEAM_1_SKIN",
      "value": "male/ctf_r",
      "description": "Skin of team 1",
      "required": true,
      "mask": false
    },
    {
      "name": "Team 2 - Name",
      "key": "TEAM_2_NAME",
      "value": "Blue",
      "description": "Name of team 2",
      "required": true,
      "mask": false
    },
    {
      "name": "Team 2 - Skin",
      "key": "TEAM_2_SKIN",
      "value": "male/ctf_b",
      "description": "Skin of team 2",
      "required": true,
      "mask": false
    },
    {
      "name": "Team 3 - Name",
      "key": "TEAM_3_NAME",
      "value": "Green",
      "description": "Name of team 3",
      "required": true,
      "mask": false
    },
    {
      "name": "Team 3 - Skin",
      "key": "TEAM_3_SKIN",
      "value": "male/ctf_g",
      "description": "Skin of team 3",
      "required": true,
      "mask": false
    },
    {
      "name": "Map Rotation",
      "key": "ROTATION",
      "value": "deepcanyon,cliff2,urban2,bwcity2p,tjt,murder,tokyo,passin,urban3remix,lumber,beer,actcity3,riot,urban",
      "description": "Comma-separated list of maps. Last map loads first.",
      "required": true,
      "mask": false
    },
    {
      "name": "Max Clients",
      "key": "MAXCLIENTS",
      "value": "18",
      "description": "Maximum number of clients allowed to connect to server, plus 2 for reserved slots",
      "required": true,
      "mask": false
    },
    {
      "name": "Log file name",
      "key": "LOGFILE_NAME",
      "value": "3team1",
      "description": "Name of the log file",
      "required": true,
      "mask": false
    },
    {
      "name": "Announcement Message",
      "key": "ADDSTUFFCMD_BEGIN",
      "value": "say vers: $version gdrv: $gl_driver=",
      "description": "Announcement message to display when players join",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable 3 Teams",
      "key": "USE_3TEAMS",
      "value": "1|0",
      "description": "1 = Enable 3 Teams",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
