{
  "name": "trex-miner",
  "repo": "ptrfrll/nv-docker-trex",
  "category": [
    "Crypto"
  ],
  "registry": "https://registry.hub.docker.com/r/ptrfrll/nv-docker-trex",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4067]",
  "icon": "https://raw.githubusercontent.com/PTRFRLL/unraid-templates/master/trex-miner/trex.png",
  "project": "https://github.com/trexminer/T-Rex",
  "description": "T-Rex is a versatile cryptocurrency mining software. It supports a variety of algorithms and we, as developers, are trying to do our best to make it as fast and as convenient to use as possible. Requires nvidia-driver plugin (6.9+)",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/trex",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4067",
      "container": "4067",
      "protocol": "tcp",
      "description": "Container Port: 4067",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Wallet address",
      "key": "WALLET",
      "value": "",
      "description": "Username/Wallet address",
      "required": true,
      "mask": false
    },
    {
      "name": "Server",
      "key": "SERVER",
      "value": "",
      "description": "URL of the mining pool",
      "required": true,
      "mask": false
    },
    {
      "name": "Worker Name",
      "key": "WORKER",
      "value": "",
      "description": "Worker name",
      "required": false,
      "mask": false
    },
    {
      "name": "algorithm",
      "key": "ALGO",
      "value": "ethash",
      "description": "Specify the hash algorithm",
      "required": true,
      "mask": false
    },
    {
      "name": "webUI Password",
      "key": "API_PASSWORD",
      "value": "",
      "description": "Must be 8-64 characters long, without spaces, and must contain at least one digit, lowercase, and uppercase letters.",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
