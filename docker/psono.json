{
  "name": "psono",
  "repo": "psono/psono-server",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/psono/psono-server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--hostname=changeme.example.org",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://doc.psono.com/images/hero.png",
  "project": "https://doc.psono.com/admin/installation/install-psono-ce.html",
  "description": "Secure self-hosted solution for businesses Need settings.yaml in appdata directory (Read First)",
  "paths": [
    {
      "name": "psono config dir",
      "host": "/mnt/cache/appdata/psono",
      "container": "/var/lib/psono",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP port for Web UI",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
