{
  "name": "heimdall",
  "repo": "lscr.io/linuxserver/heimdall",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/heimdall",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/heimdall-logo.png",
  "project": "https://heimdall.site",
  "description": "Heimdall(https://heimdall.site) is a way to organise all those links to your most used web sites and web applications in a simple way. Simplicity is the key to Heimdall. Why not use it as your browser start page? It even has the ability to include a search bar using either Google, Bing or DuckDuckGo.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "http gui",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 443",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "https gui",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ALLOW_INTERNAL_REQUESTS",
      "key": "ALLOW_INTERNAL_REQUESTS",
      "value": "false",
      "description": "By default, Heimdall blocks lookup requests to private or reserved IP addresses, if your instance is not exposed to the internet, or is behind some level of authentication, you can set this to `true` to allow requests to private IP addresses.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
