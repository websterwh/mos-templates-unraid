{
  "name": "diyHue",
  "repo": "diyhue/core:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/diyhue/core/",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/cheesemarathon/docker-templates/master/images/diyhue.png",
  "project": "https://diyhue.org/",
  "description": "diyHue emulates a Phillips Hue bridge allowing you to controll other smart lights and bulbs with the Hue ecosystem. Find more info at the diyHue GitHub wiki: https://github.com/mariusmotea/diyHue/wiki To setup just set an IP address in the network settings, along with setting the MAC and IP variabales with the values for the br0 network",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/diyHue",
      "container": "/opt/hue-emulator/config/",
      "mode": "rw",
      "description": "Container Path: /opt/hue-emulator/config/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "80",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    },
    {
      "name": "443",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false
    },
    {
      "name": "1900",
      "host": "1900",
      "container": "1900",
      "protocol": "udp",
      "description": "Container Port: 1900",
      "required": true,
      "mask": false
    },
    {
      "name": "2100",
      "host": "2100",
      "container": "2100",
      "protocol": "udp",
      "description": "Container Port: 2100",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MAC",
      "key": "MAC",
      "value": "bc:5f:f4:cd:c6:19",
      "description": "Container Variable: MAC",
      "required": true,
      "mask": false
    },
    {
      "name": "IP",
      "key": "IP",
      "value": "192.168.1.4",
      "description": "Container Variable: IP",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
