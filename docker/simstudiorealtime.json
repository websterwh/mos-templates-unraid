{
  "name": "simstudio-realtime",
  "repo": "ghcr.io/simstudioai/realtime:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/simstudioai/sim/pkgs/container/realtime",
  "network": "simstudio_internal",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--health-cmd=curl -fsS http://127.0.0.1:3002/health --health-interval=90s --health-retries=3 --health-start-period=10s --health-timeout=5s",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3002]/health",
  "icon": "https://raw.githubusercontent.com/simstudioai/sim/main/apps/sim/public/logo/primary/rounded.png",
  "project": "https://simstudio.ai",
  "description": "Sim Studio Realtime WebSocket Server for live collaboration and real-time updates. This service handles WebSocket connections for collaborative features, live notifications, and real-time data synchronization between clients and the main Sim Studio application. Requires: simstudio-db (PostgreSQL), simstudio-valkey (Valkey for session persistence).",
  "paths": [],
  "ports": [
    {
      "name": "Port: WebSocket Server",
      "host": "3002",
      "container": "3002",
      "protocol": "tcp",
      "description": "Realtime WebSocket server port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "--- Database ---",
      "key": "--- Database ---",
      "value": "",
      "description": "PostgreSQL connection settings. Must match simstudio-db configuration.",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgresql://postgres:postgres@simstudio-db:5432/simstudio",
      "description": "PostgreSQL connection URL (format: postgresql://user:password@host:port/database)",
      "required": true,
      "mask": false
    },
    {
      "name": "--- Authentication &amp; Security ---",
      "key": "--- Authentication &amp; Security ---",
      "value": "",
      "description": "Auth and security configuration for realtime service.",
      "required": false,
      "mask": false
    },
    {
      "name": "BETTER_AUTH_SECRET",
      "key": "BETTER_AUTH_SECRET",
      "value": "",
      "description": "Authentication secret key (shared with simstudio-app). Must be 32+ characters. Generate: openssl rand -base64 32",
      "required": true,
      "mask": true
    },
    {
      "name": "BETTER_AUTH_URL",
      "key": "BETTER_AUTH_URL",
      "value": "http://localhost:3000",
      "description": "Base URL for authentication (e.g. http://your-server:3000)",
      "required": true,
      "mask": false
    },
    {
      "name": "INTERNAL_API_SECRET",
      "key": "INTERNAL_API_SECRET",
      "value": "",
      "description": "Secret for internal service-to-service communication (shared with simstudio-app). Generate: openssl rand -base64 32",
      "required": true,
      "mask": true
    },
    {
      "name": "--- Application URLs ---",
      "key": "--- Application URLs ---",
      "value": "",
      "description": "Public URLs for the application.",
      "required": false,
      "mask": false
    },
    {
      "name": "NEXT_PUBLIC_APP_URL",
      "key": "NEXT_PUBLIC_APP_URL",
      "value": "http://localhost:3000",
      "description": "Public URL of the application (used by browser clients)",
      "required": true,
      "mask": false
    },
    {
      "name": "--- Valkey Session Storage ---",
      "key": "--- Valkey Session Storage ---",
      "value": "",
      "description": "Valkey connection for session persistence and scaling.",
      "required": false,
      "mask": false
    },
    {
      "name": "REDIS_URL",
      "key": "REDIS_URL",
      "value": "redis://simstudio-valkey:6379/0",
      "description": "Valkey connection URL (format: redis://host:port/db)",
      "required": true,
      "mask": false
    },
    {
      "name": "--- System ---",
      "key": "--- System ---",
      "value": "",
      "description": "Node.js and timezone configuration.",
      "required": false,
      "mask": false
    },
    {
      "name": "NODE_ENV",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Node.js environment (production/development)",
      "required": true,
      "mask": false
    },
    {
      "name": "Variable: TZ",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Timezone. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List",
      "required": false,
      "mask": false
    },
    {
      "name": "--- Advanced ---",
      "key": "--- Advanced ---",
      "value": "",
      "description": "Advanced performance and debugging settings.",
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_LEVEL",
      "key": "LOG_LEVEL",
      "value": "info",
      "description": "Log verbosity: error, warn, info, debug",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
