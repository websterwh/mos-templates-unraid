{
  "name": "apcupsd-influxdb-exporter",
  "repo": "atribe/apcupsd-influxdb-exporter",
  "category": [
    "System"
  ],
  "registry": "https://cloud.docker.com/repository/docker/atribe/apcupsd-influxdb-exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": null,
  "project": "https://github.com/atribe/apcupsd-influxdb-exporter",
  "description": "Docker wrapper for a python script to query apcupsd via a python version of apcaccess, it then sends the data to influxdb.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "HOSTNAME",
      "key": "HOSTNAME",
      "value": "panthro",
      "description": "host you want the measurements to show up as in influxdb",
      "required": true,
      "mask": false
    },
    {
      "name": "WATTS",
      "key": "WATTS",
      "value": "1500",
      "description": "If your UPS doesn't have the NOMPOWER metric then specify the rated watts so that the load percentage can be used to calculate the current watts",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_HOST",
      "key": "INFLUXDB_HOST",
      "value": "10.13.13.15",
      "description": "ip address of influxdb",
      "required": true,
      "mask": false
    },
    {
      "name": "APCUPSD_HOST",
      "key": "APCUPSD_HOST",
      "value": "10.13.13.15",
      "description": "address of host running apcupsd",
      "required": true,
      "mask": false
    },
    {
      "name": "INFLUXDB_PORT",
      "key": "INFLUXDB_PORT",
      "value": "8086",
      "description": "Container Variable: INFLUXDB_PORT",
      "required": true,
      "mask": false
    },
    {
      "name": "INFLUXDB_DATABASE",
      "key": "INFLUXDB_DATABASE",
      "value": "apcupsd",
      "description": "influxdb database name to store values",
      "required": true,
      "mask": false
    },
    {
      "name": "INFLUXDB_USER",
      "key": "INFLUXDB_USER",
      "value": "",
      "description": "User name for Influxdb",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_PASSWORD",
      "key": "INFLUXDB_PASSWORD",
      "value": "",
      "description": "Password for Influxdb",
      "required": false,
      "mask": false
    },
    {
      "name": "Debugging Output",
      "key": "VERBOSE",
      "value": "false",
      "description": "Set this variable to true to see the output in the docker log.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
