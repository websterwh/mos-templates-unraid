{
  "name": "OpenBudgeteer",
  "repo": "axelander/openbudgeteer",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/axelander/openbudgeteer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/TheAxelander/OpenBudgeteer/master/assets/icon.png",
  "project": "https://github.com/TheAxelander/OpenBudgeteer",
  "description": "OpenBudgeteer is a budgeting app based on the Bucket Budgeting Principle",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "6100",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database Provider",
      "key": "CONNECTION_PROVIDER",
      "value": "mariadb",
      "description": "mysql, mariadb or postgresql",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Server",
      "key": "CONNECTION_SERVER",
      "value": "localhost",
      "description": "IP address of database server",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "CONNECTION_PORT",
      "value": "3306",
      "description": "Port of database server",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "CONNECTION_DATABASE",
      "value": "openbudgeteer",
      "description": "Name of the database",
      "required": false,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "CONNECTION_USER",
      "value": "openbudgeteer",
      "description": "Database user",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "CONNECTION_PASSWORD",
      "value": "",
      "description": "Password of database user",
      "required": false,
      "mask": true
    },
    {
      "name": "Database Root Password",
      "key": "CONNECTION_ROOT_PASSWORD",
      "value": "",
      "description": "Password of database root user to automatically create database and user (mysql, mariadb only)",
      "required": false,
      "mask": true
    },
    {
      "name": "Redis Server",
      "key": "CONNECTION_REDIS_SERVER",
      "value": "localhost",
      "description": "IP address of Redis server",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis Port",
      "key": "CONNECTION_REDIS_PORT",
      "value": "6379",
      "description": "Port of Redis server",
      "required": false,
      "mask": false
    },
    {
      "name": "Redis User",
      "key": "CONNECTION_REDIS_USER",
      "value": "",
      "description": "Redis User (if ACL is used)",
      "required": false,
      "mask": false
    },
    {
      "name": "Redis Password",
      "key": "CONNECTION_REDIS_PASSWORD",
      "value": "",
      "description": "Redis Password (if ACL is used)",
      "required": false,
      "mask": true
    },
    {
      "name": "Redis Keys Prefix",
      "key": "CONNECTION_REDIS_PREFIX",
      "value": "",
      "description": "Redis Keys Prefix (if ACL is used)",
      "required": false,
      "mask": false
    },
    {
      "name": "Authentication Active",
      "key": "APPSETTINGS_AUTH_ENABLED",
      "value": "true",
      "description": "Enables a login screen",
      "required": true,
      "mask": false
    },
    {
      "name": "Authentication User",
      "key": "APPSETTINGS_AUTH_USERNAME",
      "value": "admin",
      "description": "Login User name",
      "required": false,
      "mask": false
    },
    {
      "name": "Authentication Password",
      "key": "APPSETTINGS_AUTH_PASSWORD",
      "value": "hammerlock",
      "description": "Login User password",
      "required": false,
      "mask": true
    },
    {
      "name": "Authentication Session Days",
      "key": "APPSETTINGS_AUTH_SESSION_DAYS",
      "value": "7",
      "description": "Number of days for how long the session token in Redis will be kept",
      "required": false,
      "mask": false
    },
    {
      "name": "Localization",
      "key": "APPSETTINGS_CULTURE",
      "value": "en-US",
      "description": "Sets localization like currency and number format (Must be a BCP 47 language tag)",
      "required": false,
      "mask": false
    },
    {
      "name": "Generate Demo Data",
      "key": "APPSETTINGS_DEMO_DATA",
      "value": "false",
      "description": "Generate a set of initial data for demo purposes",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
