{
  "name": "Virt-Manager",
  "repo": "fanningert/docker-virtmanager",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/fanningert/docker-virtmanager/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/vnc.html?autoconnect=true",
  "icon": "https://raw.githubusercontent.com/fanningert/unraid-docker-templates/master/fanningert/icons/virtmanager.png",
  "project": null,
  "description": "The virt-manager application is a desktop user interface for managing virtual machines through libvirt. It primarily targets KVM VMs, but also manages Xen and LXC (linux containers). It presents a summary view of running domains, their live performance & resource utilization statistics. Wizards enable the creation of new domains, and configuration & adjustment of a domain\u2019s resource allocation & virtual hardware. An embedded VNC and SPICE client viewer presents a full graphical console to the guest domain.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/dev/urandom",
      "container": "/dev/urandom",
      "mode": "rw",
      "description": "Container Path: /dev/urandom",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "noVNC HTTP",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Display Width",
      "key": "DISPLAY_WIDTH",
      "value": "1024",
      "description": "Container Variable: DISPLAY_WIDTH",
      "required": true,
      "mask": false
    },
    {
      "name": "Display Height",
      "key": "DISPLAY_HEIGHT",
      "value": "768",
      "description": "Container Variable: DISPLAY_HEIGHT",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Chicago",
      "description": "Container Variable: TZ",
      "required": true,
      "mask": false
    },
    {
      "name": "Language 1",
      "key": "LANG",
      "value": "en_US.UTF-8",
      "description": "Container Variable: LANG",
      "required": true,
      "mask": false
    },
    {
      "name": "Language 2",
      "key": "LANGUAGE",
      "value": "en_US.UTF-8",
      "description": "Container Variable: LANGUAGE",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
