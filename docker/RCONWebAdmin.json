{
  "name": "RCON-WebAdmin",
  "repo": "itzg/rcon",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/itzg/rcon/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4326]/",
  "icon": "https://github.com/natcoso9955/unRAID-docker/raw/master/icons/rcon-webadmin.png",
  "project": "https://github.com/rcon-web-admin/rcon-web-admin",
  "description": "Out of the box, RCON Web Admin can check users for high ping, VAC status, or filter the chat for you around the clock. This image lets you run the rcon-web-admin administration tool as a Docker container. A great benefit of running rcon-web-admin in Docker, especially in a Docker Composition is that the RCON port of your game server can remain securely isolated within the Docker network. Additional Variables available at: https://github.com/rcon-web-admin/rcon-web-admin#environment-variables",
  "paths": [
    {
      "name": "db",
      "host": "/mnt/cache/appdata/rcon-web-admin/db/",
      "container": "/opt/rcon-web-admin/db",
      "mode": "rw",
      "description": "Container Path: /opt/rcon-web-admin/db",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "webUI",
      "host": "4326",
      "container": "4326",
      "protocol": "tcp",
      "description": "Container Port: 4326",
      "required": false,
      "mask": false
    },
    {
      "name": "websocket access from UI",
      "host": "4327",
      "container": "4327",
      "protocol": "tcp",
      "description": "Container Port: 4327",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "RWA_ADMIN",
      "key": "RWA_ADMIN",
      "value": "TRUE",
      "description": "Container Variable: RWA_ADMIN",
      "required": false,
      "mask": false
    },
    {
      "name": "RWA_USERNAME",
      "key": "RWA_USERNAME",
      "value": "admin",
      "description": "Container Variable: RWA_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "RWA_PASSWORD",
      "key": "RWA_PASSWORD",
      "value": "admin",
      "description": "Container Variable: RWA_PASSWORD",
      "required": false,
      "mask": true
    },
    {
      "name": "RWA_ENV",
      "key": "RWA_ENV",
      "value": "False",
      "description": "Container Variable: RWA_ENV",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
