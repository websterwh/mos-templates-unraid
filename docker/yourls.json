{
  "name": "yourls",
  "repo": "yourls",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/_/yourls/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/admin",
  "icon": "https://github.com/YOURLS/YOURLS/raw/master/images/yourls-logo.png",
  "project": null,
  "description": "YOURLS is a set of PHP scripts that will allow you to run Your Own URL Shortener.",
  "paths": [],
  "ports": [
    {
      "name": "Container Port",
      "host": "8092",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MariaDB Host and Port",
      "key": "YOURLS_DB_HOST",
      "value": "mariadbhost:3306",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB User",
      "key": "YOURLS_DB_USER",
      "value": "yourls",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MariaDB Password",
      "key": "YOURLS_DB_PASS",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "url",
      "key": "YOURLS_SITE",
      "value": "http://yourdomain.com",
      "description": "Use a reverse proxy to point to the container host",
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB Database Name",
      "key": "YOURLS_DB_NAME",
      "value": "yourls",
      "description": "yourls database name. default is 'yourls'",
      "required": true,
      "mask": false
    },
    {
      "name": "YOURLS_HOURS_OFFSET",
      "key": "YOURLS_HOURS_OFFSET",
      "value": "0",
      "description": "set your timezone ( GMT )",
      "required": true,
      "mask": false
    },
    {
      "name": "YOURLS_PRIVATE",
      "key": "YOURLS_PRIVATE",
      "value": "true",
      "description": "false will set yourls to public. Reccomended value is true ( to be private )",
      "required": true,
      "mask": false
    },
    {
      "name": "YOURLS_USER",
      "key": "YOURLS_USER",
      "value": "admin",
      "description": "Yourls admin interface username",
      "required": true,
      "mask": false
    },
    {
      "name": "YOURLS_PASS",
      "key": "YOURLS_PASS",
      "value": "strongpass",
      "description": "Yourls admin interface password",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
