{
  "name": "simstudio-migrations",
  "repo": "ghcr.io/simstudioai/migrations:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/simstudioai/sim/pkgs/container/migrations",
  "network": "simstudio_internal",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=no -w /app/packages/db",
  "post_parameters": "bun run db:migrate",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/simstudioai/sim/main/apps/sim/public/logo/primary/rounded.png",
  "project": "https://simstudio.ai",
  "description": "Sim Studio Database Migration Runner. This container runs database migrations to initialize and update the PostgreSQL schema for Sim Studio. This is a one-time setup container. It runs migrations and exits. Must complete successfully before starting simstudio-app and simstudio-realtime.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "--- Database ---",
      "key": "--- Database ---",
      "value": "",
      "description": "PostgreSQL connection settings. Must match simstudio-db configuration.",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgresql://postgres:postgres@simstudio-db:5432/simstudio",
      "description": "PostgreSQL connection URL (format: postgresql://user:password@host:port/database). Must match simstudio-db.",
      "required": true,
      "mask": false
    },
    {
      "name": "--- System ---",
      "key": "--- System ---",
      "value": "",
      "description": "Timezone configuration.",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: TZ",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Timezone. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List",
      "required": false,
      "mask": false
    },
    {
      "name": "--- Advanced ---",
      "key": "--- Advanced ---",
      "value": "",
      "description": "Advanced settings for troubleshooting.",
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_LEVEL",
      "key": "LOG_LEVEL",
      "value": "info",
      "description": "Log verbosity: error, warn, info, debug",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
