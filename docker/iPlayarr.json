{
  "name": "iPlayarr",
  "repo": "nikorag/iplayarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://registry.hub.docker.com/r/nikorag/iplayarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4404]",
  "icon": "https://raw.githubusercontent.com/Nikorag/iplayarr/refs/heads/main/frontend/public/iplayarr.png",
  "project": "https://github.com/Nikorag/iplayarr",
  "description": "iPlayarr is a companion tool for Sonarr and Radarr, making it easy to integrate get_iplayer for searching and downloading iPlayer content directly. It acts as both an indexer and a download client, allowing seamless automation of TV and movie downloads.",
  "paths": [
    {
      "name": "Incoming",
      "host": "/mnt/download/iPlayarr/incoming/",
      "container": "/iplayarr/incoming",
      "mode": "rw,slave",
      "description": "Incoming TMP Location",
      "required": false
    },
    {
      "name": "Completed",
      "host": "/mnt/download/iPlayarr/completed/",
      "container": "/iplayarr/completed",
      "mode": "rw,slave",
      "description": "Completed Downloads",
      "required": false
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/iplayarr/config",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/iplayarr/logs",
      "container": "/logs",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/iplayarr/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4404",
      "container": "4404",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APIKey",
      "key": "API_KEY",
      "value": "makeupakey",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Completed Downloads",
      "key": "COMPLETE_DIR",
      "value": "/iplayarr/completed",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Download DIR",
      "key": "DOWNLOAD_DIR",
      "value": "/iplayarr/incoming",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
