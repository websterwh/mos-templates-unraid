{
  "name": "open-alpr-http-wrapper",
  "repo": "sclaflin/open-alpr-http-wrapper",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/sclaflin/open-alpr-http-wrapper/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/open-alpr-http-wrapper.png",
  "project": "https://github.com/sclaflin/Plate-Minder",
  "description": "A very thin HTTP wrapper around the OpenALPR cli binary - Used for the plate-minder docker container",
  "paths": [],
  "ports": [
    {
      "name": "httpPort",
      "host": "3001",
      "container": "3000",
      "protocol": "tcp",
      "description": "Plate-Minder usage and manualy test GUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
