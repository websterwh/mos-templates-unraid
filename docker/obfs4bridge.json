{
  "name": "obfs4-bridge",
  "repo": "thetorproject/obfs4-bridge",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/thetorproject/obfs4-bridge/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9393]",
  "icon": "https://raw.githubusercontent.com/sgraaf/Unraid-Docker-Templates/main/obfs4-bridge/icon.png",
  "project": "https://community.torproject.org/relay/setup/bridge/docker/",
  "description": "obfs4-bridge is a container that allows you to run a Tor Bridge relay to help censored users connect to the Tor network. Configuration: - OR_PORT: Your bridge's onion routing (Tor) port. - PT_PORT: Your bridge's obfs4 port. - EMAIL: Your email address. Note: - Make sure that both ports are forwarded in your firewall. - Make sure that you create the DATA_DIR and change its owner before running the container: `mkdir /mnt/user/appdata/tor && chown 101:101 /mnt/user/appdata/tor`.",
  "paths": [
    {
      "name": "DATA_DIR",
      "host": "/mnt/cache/appdata/tor",
      "container": "/var/lib/tor",
      "mode": "rw",
      "description": "Container Path: /var/lib/tor",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "OR_PORT",
      "host": "9393",
      "container": "9393",
      "protocol": "tcp",
      "description": "Container Port: 9393",
      "required": true,
      "mask": false
    },
    {
      "name": "PT_PORT",
      "host": "9292",
      "container": "9292",
      "protocol": "tcp",
      "description": "Container Port: 9292",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OR_PORT",
      "key": "OR_PORT",
      "value": "9393",
      "description": "Container Variable: OR_PORT",
      "required": true,
      "mask": false
    },
    {
      "name": "PT_PORT",
      "key": "PT_PORT",
      "value": "9292",
      "description": "Container Variable: PT_PORT",
      "required": true,
      "mask": false
    },
    {
      "name": "EMAIL",
      "key": "EMAIL",
      "value": "",
      "description": "Container Variable: EMAIL",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable additional variables",
      "key": "OBFS4_ENABLE_ADDITIONAL_VARIABLES",
      "value": "0",
      "description": "Container Variable: OBFS4_ENABLE_ADDITIONAL_VARIABLES",
      "required": false,
      "mask": false
    },
    {
      "name": "Disable IPv6",
      "key": "OBFS4V_AddressDisableIPv6",
      "value": "0",
      "description": "Container Variable: OBFS4V_AddressDisableIPv6",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
