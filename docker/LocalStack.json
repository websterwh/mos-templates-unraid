{
  "name": "LocalStack",
  "repo": "localstack/localstack:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/localstack/localstack",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4566]/",
  "icon": "https://cdn.prod.website-files.com/6539036f80ddc9e9a467134e/681e4d77a183f92570e14555_localstack-logo.svg",
  "project": "https://www.localstack.cloud/",
  "description": "LocalStack is a local cloud emulator that lets you build and test cloud applications entirely on your machine. Spin up fully functional local environments that mirror real cloud behavior \u2014 including AWS services and Snowflake \u2014 without provisioning real cloud infrastructure. Whether you're validating IaC templates, running integration tests, or iterating on data pipelines, LocalStack integrates seamlessly with your tools and CI/CD pipelines to help you ship faster and safer.",
  "paths": [
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/localstack/data",
      "container": "/var/lib/localstack",
      "mode": "rw",
      "description": "Path to the data directory",
      "required": true
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4566",
      "container": "4566",
      "protocol": "tcp",
      "description": "Container Port: 4566",
      "required": true,
      "mask": false
    },
    {
      "name": "External Service Ports",
      "host": "4510-4559",
      "container": "4510-4559",
      "protocol": "tcp",
      "description": "Range for external service ports",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "0|1",
      "description": "Enable debug mode. Set to 1 to enable.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
