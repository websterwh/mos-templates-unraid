{
  "name": "Newznabarr",
  "repo": "riffsphereha/newznabarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/riffsphereha/newznabarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:10000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/newnzabarr-icon.png",
  "project": "https://github.com/iffsphereha/newznabarr",
  "description": "A Usenet plugin framework for the *arr ecosystem designed to fill that gap. Can be added to Sonarr, Radarr, Lidarr and Readarr to download media using search plugins under the hood.",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/newznabarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true
    },
    {
      "name": "Download Path",
      "host": "/mnt/cache/appdata/newznabarr/downloads",
      "container": "/data/downloads/downloadarr",
      "mode": "rw",
      "description": "Path to the download folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Communication Port",
      "host": "10000",
      "container": "10000",
      "protocol": "tcp",
      "description": "Port to use for Usenet communication",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Port",
      "key": "FLASK_RUN_PORT",
      "value": "10000",
      "description": "Internal port of the app. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Config Path",
      "key": "CONFIG",
      "value": "/config",
      "description": "Internal path to the config folder. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
