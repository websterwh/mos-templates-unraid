{
  "name": "Cloudreve",
  "repo": "xavierniu/cloudreve",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/xavierniu/cloudreve",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5212]",
  "icon": "https://raw.githubusercontent.com/cloudreve/frontend/master/public/static/img/logo192.png",
  "project": "https://github.com/cloudreve/Cloudreve",
  "description": "Self-hosted file management and sharing system, supports multiple storage providers ==========IMPORTANT========== The default user and pass in the console log.",
  "paths": [
    {
      "name": "Upload Path",
      "host": "",
      "container": "/cloudreve/uploads",
      "mode": "rw",
      "description": "Container Path: /cloudreve/uploads",
      "required": true
    },
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/cloudreve/db",
      "container": "/cloudreve/db",
      "mode": "rw",
      "description": "Container Path: /cloudreve/db",
      "required": false
    },
    {
      "name": "Avatar Path",
      "host": "/mnt/cache/appdata/cloudreve/avatar",
      "container": "/cloudreve/avatar",
      "mode": "rw",
      "description": "Container Path: /cloudreve/avatar",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/cloudreve/config",
      "container": "/cloudreve/config",
      "mode": "rw",
      "description": "Container Path: /cloudreve/config",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5212",
      "container": "5212",
      "protocol": "tcp",
      "description": "Web UI",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Asia/Shanghai",
      "description": "\u5bb9\u5668 Variable: TZ",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
