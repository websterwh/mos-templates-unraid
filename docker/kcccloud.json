{
  "name": "kcc-cloud",
  "repo": "nilsleo/kcc-cloud:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/nilsleo/kcc-cloud",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/bewcloud.png",
  "project": "https://github.com/NilsLeo/kcc-cloud",
  "description": "KCC Cloud transforms your manga, comics, and documents into e-reader optimized formats (EPUB, MOBI, PDF, KFX, CBZ) with a modern, responsive web interface. Built for self-hosting with Docker, it provides multi-device access, real-time job monitoring, and parallel processing capabilities.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/kcc-cloud",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Outputs",
      "host": "",
      "container": "/data/outputs",
      "mode": "rw",
      "description": "If you want outputs saved somewhere other than appdata. Delete if not needed.",
      "required": false
    },
    {
      "name": "Uploads",
      "host": "",
      "container": "/data/uploads",
      "mode": "rw",
      "description": "If you want uploads saved somewhere other than appdata. Delete if not needed.",
      "required": false
    },
    {
      "name": "Temp",
      "host": "",
      "container": "/data/tmp",
      "mode": "rw",
      "description": "If you want temp directory somewhere other than appdata. Delete if not needed.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8654",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "UTC",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "USER_ID",
      "key": "USER_ID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "GROUP_ID",
      "key": "GROUP_ID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "NEXT_PUBLIC_MAX_FILES",
      "key": "NEXT_PUBLIC_MAX_FILES",
      "value": "10",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "CELERY_WORKERS",
      "key": "CELERY_WORKERS",
      "value": "4",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
