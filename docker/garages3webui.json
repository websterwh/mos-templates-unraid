{
  "name": "garage-s3-webui",
  "repo": "khairul169/garage-webui:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://registry.hub.docker.com/r/khairul169/garage-webui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3909]",
