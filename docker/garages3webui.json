  "project": "https://github.com/khairul169/garage-webui",
  "description": "Garage S3 WebUI",
  "paths": [],
  "ports": [
    {
      "name": "PORT",
      "host": "3909",
      "container": "3909",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API_BASE_URL",
      "key": "API_BASE_URL",
      "value": "http://192.168.1.40:3903",
      "description": "Set this to your url on garage.toml",
      "required": false,
      "mask": false
    },
    {
      "name": "S3_ENDPOINT_URL",
      "key": "S3_ENDPOINT_URL",
      "value": "http://192.168.1.40:9000",
      "description": "You garage S3 API url",
      "required": false,
      "mask": false
    },
    {
      "name": "API_ADMIN_KEY",
      "key": "API_ADMIN_KEY",
      "value": "change_this_to_an_hard_one",
      "description": "The corresponding admin_token in garage.toml",
      "required": false,
      "mask": false
    },
    {
      "name": "S3_REGION",
      "key": "S3_REGION",
      "value": "garage",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
