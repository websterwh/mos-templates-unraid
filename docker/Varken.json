{
  "name": "Varken",
  "repo": "boerderij/varken",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/boerderij/varken/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/benderstwin/docker-templates/master/images/varken.png",
  "project": "https://github.com/Boerderij/Varken",
  "description": "Varken requires influxdb and grafana. Deploy those containers first. Dutch for PIG. PIG is an Acronym for Plex/InfluxDB/Grafana Varken is a standalone command-line utility to aggregate data from the Plex ecosystem into InfluxDB. Examples use Grafana for a frontend You must edit the varken.ini file in /mnt/user/appdata/varken.",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/varken",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Denver",
      "description": "Container Variable: TZ",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
