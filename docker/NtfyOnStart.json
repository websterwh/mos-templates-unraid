{
  "name": "Ntfy-On-Start",
  "repo": "nwithan8/ntfy-on-start:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/nwithan8/ntfy-on-start",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/ich777/docker-templates/master/ich777/images/donegear.png",
  "project": "https://github.com/nwithan8/docker-ntfy-on-start",
  "description": "This is a simple container that sends a message when the container is started (needed this for a headless machine to know when I can connect or better speaking start up the VM's with WOL).",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "ntfy URL",
      "key": "NTFY_URL",
      "value": "https://ntfy.sh",
      "description": "URL of the ntfy server",
      "required": true,
      "mask": false
    },
    {
      "name": "ntfy Access Token",
      "key": "NTFY_ACCESS_TOKEN",
      "value": "",
      "description": "Access token for the ntfy server",
      "required": true,
      "mask": true
    },
    {
      "name": "ntfy Topic",
      "key": "NTFY_TOPIC",
      "value": "server",
      "description": "Topic of the ntfy message",
      "required": true,
      "mask": false
    },
    {
      "name": "ntfy Title",
      "key": "NTFY_TITLE",
      "value": "Startup Complete",
      "description": "Title of the ntfy message",
      "required": true,
      "mask": false
    },
    {
      "name": "ntfy Message",
      "key": "NTFY_MESSAGE",
      "value": "Server is now Online!",
      "description": "Body of the ntfy message",
      "required": true,
      "mask": false
    },
    {
      "name": "ntfy Priority",
      "key": "NTFY_PRIORITY",
      "value": "default|low|high|min|max",
      "description": "Priority of the ntfy message",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
