{
  "name": "GiftManager",
  "repo": "icbest/giftmanager",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/icbest/giftmanager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/MiranoVerhoef/Unraid-Mirano/refs/heads/main/GiftManager/GiftManager.png",
  "project": "https://github.com/icbestCA/giftmanager",
  "description": "A Gift Ideas Management app that lets users add, edit, and organize gift ideas with descriptions, links, and prices. It supports sorting, marking gifts as bought, and tracking past gifts \u2014 all while keeping surprises secret.",
  "paths": [
    {
      "name": "Data Storage",
      "host": "",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Expose Docker sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Use this volume to be able to restart the container from the flask app, making it easier to modify settings.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Port to expose the WEBUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
