{
  "name": "NginxProxyManager-CrowdSec",
  "repo": "lepresidente/nginx-proxy-manager:dev",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/lepresidente/nginx-proxy-manager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--memory=1G --no-healthcheck",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8181]",
  "icon": "https://raw.githubusercontent.com/ItJustFox/unraidtemplate/main/Nginx-Proxy-Manager-CrowdSec/NginxCrowdsec.png",
  "project": "https://nginxproxymanager.com/",
  "description": "This is a drop in replacement for jlesage/nginx-proxy-manager This fork includes the OpenResty Crowdsec Bouncer Please see the crowdsec_support branch for the changes as Nginx Proxy Manager (NPM) allows adding proxy hosts through a password-protected multi-user WebUI. Add free Let's Encrypt SSL certificates to secure your web services. They are renewed by NPM automatically. Default login: admin@example.com Password: changeme",
  "paths": [
    {
      "name": "AppData ConfigFiles",
      "host": "/mnt/cache/appdata/NginxProxyManager-CrowdSec/",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Certifications",
      "host": "/mnt/cache/appdata/NginxProxyManager-CrowdSec/UnraidData/certifications",
      "container": "/etc/letsencrypt",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/NginxProxyManager-CrowdSec/UnraidData/logs",
      "container": "/var/log",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8181",
      "container": "8181",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "HTTP Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "4443",
      "container": "4443",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "API Port",
      "host": "3005",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "IPV6 Support",
      "key": "DISABLE_IPV",
      "value": "false",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "AutoRestart",
      "key": "KEEP_APP_RUNNING",
      "value": "0",
      "description": "0 = No reboot if crash 1 = Reboot if crash",
      "required": true,
      "mask": false
    },
    {
      "name": "UserID",
      "key": "USER_ID",
      "value": "500",
      "description": "Do not touch that.",
      "required": true,
      "mask": false
    },
    {
      "name": "GroupID",
      "key": "GROUP_ID",
      "value": "500",
      "description": "Do not touch that.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
