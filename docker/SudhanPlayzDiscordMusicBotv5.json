{
  "name": "SudhanPlayz-Discord-MusicBot-v5",
  "repo": "chongzhijie/sudhanplayz-discord-musicbot-v5:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/chongzhijie/sudhanplayz-discord-musicbot-v5",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4200]/",
  "icon": "https://github.com/SudhanPlayz/Discord-MusicBot/raw/v5/assets/logo.gif",
  "project": "https://github.com/SudhanPlayz/Discord-MusicBot/tree/v5",
  "description": "This is Discord Music from GITHUB Open sourse https://github.com/SudhanPlayz/Discord-MusicBot/tree/v5 Before you Deploy please create folder Names \"SudhanPlayz-Discord-MusicBot-v5\" at /mnt/user/appdata/SudhanPlayz-Discord-MusicBot-v5/config.js and upload config.js in to folder",
  "paths": [
    {
      "name": "ConfigFiles",
      "host": "/mnt/cache/appdata/SudhanPlayz-Discord-MusicBot-v5/config.js",
      "container": "/usr/src/app/config.js",
      "mode": "rw",
      "description": "Example:https://github.com/SudhanPlayz/Discord-MusicBot/blob/v5/config.js",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4200",
      "container": "4200",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Lavalink-IP",
      "key": "ip",
      "value": "lavalink.oops.wtf",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Lavalink-Port",
      "key": "port",
      "value": "2000",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
