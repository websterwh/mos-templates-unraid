{
  "name": "OpenVPN-AIO-Client-Torless",
  "repo": "testdasi/openvpn-client-aio:latest-torless",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/testdasi/openvpn-client-aio/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8153]",
  "icon": "https://raw.githubusercontent.com/testdasi/openvpn-client-aio-base/master/openvpn-simple.png",
  "project": "https://github.com/testdasi/openvpn-client-aio",
  "description": "An \"all-in-one\" docker for all your private browsing needs (including OpenVPN client with nftables kill switch ; Socks5 + HTTP proxy to the VPN ; DNS server to DoT (DNS-over-TLS) services). It's the same as OpenVPN AIO Client docker but without TOR. NOTE: you must place your own OpenVPN configuration to the host path that is mapped to /etc/openvpn (The ovpn file must be named openvpn.ovpn. Credentials + certs can be in the same file or split out into multiple files - the flexibility is yours.) Set DNS_SERVERS to 127.2.2.2 to use DNS-over-TLS (use google and cloudflare services by default). Your DNS query out of the VPN exit will also be encrypted for even more security. Set it to other services IP's will use normal unencrypted services. Set HOST_NETWORK to your Unraid server network in CIDR format e.g. 192.168.1.0/24. For more detailed instructions, refer to the support thread (https://forums.Unraid.net/topic/96233-support-testdasi-repo/) or project page (https://github.com/testdasi/openvpn-client-aio).",
  "paths": [
    {
      "name": "OpenVPN Config",
      "host": "/mnt/cache/appdata/openvpn-aio-client",
      "container": "/etc/openvpn",
      "mode": "rw",
      "description": "Container Path: /etc/openvpn",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "DNS Server TCP",
      "host": "8153",
      "container": "53",
      "protocol": "tcp",
      "description": "Container Port: 53",
      "required": false,
      "mask": false
    },
    {
      "name": "DNS Server UDP",
      "host": "8153",
      "container": "53",
      "protocol": "udp",
      "description": "Container Port: 53",
      "required": false,
      "mask": false
    },
    {
      "name": "Socks5 proxy to VPN",
      "host": "9118",
      "container": "9118",
      "protocol": "tcp",
      "description": "Container Port: 9118",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTP Proxy to VPN",
      "host": "8118",
      "container": "8118",
      "protocol": "tcp",
      "description": "Container Port: 8118",
      "required": false,
      "mask": false
    },
    {
      "name": "Socks5 proxy to TOR",
      "host": "9119",
      "container": "9119",
      "protocol": "tcp",
      "description": "Container Port: 9119",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTP Proxy to TOR",
      "host": "8119",
      "container": "8119",
      "protocol": "tcp",
      "description": "Container Port: 8119",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DNS_SERVERS",
      "key": "DNS_SERVERS",
      "value": "127.2.2.2",
      "description": "Container Variable: DNS_SERVERS",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_NETWORK",
      "key": "HOST_NETWORK",
      "value": "192.168.1.0/24",
      "description": "Container Variable: HOST_NETWORK",
      "required": false,
      "mask": false
    },
    {
      "name": "DNS_SERVER_PORT",
      "key": "DNS_SERVER_PORT",
      "value": "53",
      "description": "Container Variable: DNS_SERVER_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "SOCKS_PROXY_PORT",
      "key": "SOCKS_PROXY_PORT",
      "value": "9118",
      "description": "Container Variable: SOCKS_PROXY_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTP_PROXY_PORT",
      "key": "HTTP_PROXY_PORT",
      "value": "8118",
      "description": "Container Variable: HTTP_PROXY_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "TOR_SOCKS_PORT",
      "key": "TOR_SOCKS_PORT",
      "value": "9119",
      "description": "Container Variable: TOR_SOCKS_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "TOR_HTTP_PORT",
      "key": "TOR_HTTP_PORT",
      "value": "8119",
      "description": "Container Variable: TOR_HTTP_PORT",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
