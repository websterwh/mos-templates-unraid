{
  "name": "Kokoro-FastAPI---GPU",
  "repo": "ghcr.io/remsky/kokoro-fastapi-gpu:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/remsky/kokoro-fastapi-gpu",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8880]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/kokoro-fastapi-icon.png",
  "project": "https://github.com/remsky/Kokoro-FastAPI",
  "description": "Dockerized FastAPI wrapper for Kokoro-82M text-to-speech model w/CPU ONNX and NVIDIA GPU PyTorch support, handling, and auto-stitching. This is a version meant for Nvidia GPUs.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/kokoro-fastapi/data",
      "container": "/app/api",
      "mode": "rw",
      "description": "Path to the app data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8880",
      "container": "8880",
      "protocol": "tcp",
      "description": "Container Port: 8880",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Download Model",
      "key": "DOWNLOAD_MODEL",
      "value": "true|false",
      "description": "Download model on start",
      "required": true,
      "mask": false
    },
    {
      "name": "Python Path",
      "key": "PYTHONPATH",
      "value": "/app:/app/api",
      "description": "Python path environment variable",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "API_LOG_LEVEL",
      "value": "DEBUG",
      "description": "Logging level for the API",
      "required": true,
      "mask": false
    },
    {
      "name": "Use GPU",
      "key": "USE_GPU",
      "value": "true",
      "description": "Enable GPU usage for PyTorch model inference",
      "required": true,
      "mask": false
    },
    {
      "name": "Python Unbuffered",
      "key": "PYTHONUNBUFFERED",
      "value": "1",
      "description": "Set Python output to be unbuffered",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
