{
  "name": "patbrid",
  "repo": "mgoodings/patbrid",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/mgoodings/patbrid/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://i.imgur.com/9Wnjq7l.png",
  "project": "https://github.com/mgoodings/patbrid",
  "description": "A real-debrid blackhole downloader using aria2 RPC This is the original patbrid. It downloads files off of real-debrid.com using the aria2 downloader https://hub.docker.com/r/mgoodings/patbrid/",
  "paths": [
    {
      "name": "WATCH_DIR",
      "host": "/mnt/cache/media/temp/blackhole/",
      "container": "/watch",
      "mode": "rw",
      "description": "Directory to watch.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "REAL_DEBRID_API_KEY",
      "key": "REAL_DEBRID_API_KEY",
      "value": "&lt;your real debrid apikey&gt;",
      "description": "You can obtain this from https://real-debrid.com/apitoken",
      "required": true,
      "mask": false
    },
    {
      "name": "WATCH_RATE",
      "key": "WATCH_RATE",
      "value": "5000",
      "description": "describes the polling rate for changes",
      "required": false,
      "mask": false
    },
    {
      "name": "ARIA2_URL",
      "key": "ARIA2_URL",
      "value": "http://127.0.0.1:6800/jsonrpc",
      "description": "Aria2 JSON-RPC URL",
      "required": false,
      "mask": false
    },
    {
      "name": "ARIA2_SECRET",
      "key": "ARIA2_SECRET",
      "value": "yoursecret",
      "description": "set this on your aria2 downloader",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
