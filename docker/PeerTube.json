{
  "name": "PeerTube",
  "repo": "chocobozzz/peertube:production-bookworm",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/chocobozzz/peertube",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/peertube-icon.png",
  "project": "https://joinpeertube.org/",
  "description": "A free, decentralized and federated video platform developed as an alternative to other platforms such as YouTube, Dailymotion or Vimeo.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/peertube/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/peertube/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Live Feature Port",
      "host": "1935",
      "container": "1935",
      "protocol": "tcp",
      "description": "Container Port: 1935",
      "required": false,
      "mask": false
    },
    {
      "name": "Web UI Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Container Port: 9000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Hostname",
      "key": "PEERTUBE_WEBSERVER_HOSTNAME",
      "value": "",
      "description": "Hostname for this PeerTube server",
      "required": true,
      "mask": false
    },
    {
      "name": "Secret",
      "key": "PEERTUBE_SECRET",
      "value": "",
      "description": "Secret for this PeerTube server. Generate with `openssl rand -hex 32`",
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres - Host",
      "key": "PEERTUBE_DB_HOSTNAME",
      "value": "",
      "description": "IP address or hostname of Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres - Port",
      "key": "PEERTUBE_DB_PORT",
      "value": "5432",
      "description": "Port of Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres - Database",
      "key": "PEERTUBE_DB_NAME",
      "value": "peertube",
      "description": "Name of Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres - User",
      "key": "PEERTUBE_DB_USERNAME",
      "value": "peertube",
      "description": "Username for Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres - Password",
      "key": "PEERTUBE_DB_PASSWORD",
      "value": "",
      "description": "Password for Postgres database",
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres - Enable SSL",
      "key": "PEERTUBE_DB_SSL",
      "value": "false|true",
      "description": "Enable SSL for Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis - Host",
      "key": "PEERTUBE_REDIS_HOSTNAME",
      "value": "",
      "description": "IP address or hostname of Redis database",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis - Port",
      "key": "PEERTUBE_REDIS_PORT",
      "value": "6379",
      "description": "Port of Redis database",
      "required": true,
      "mask": false
    },
    {
      "name": "Postfix-Relay - Host",
      "key": "PEERTUBE_SMTP_HOSTNAME",
      "value": "",
      "description": "IP address or hostname of Postfix-Relay server",
      "required": true,
      "mask": false
    },
    {
      "name": "Postfix-Relay - Port",
      "key": "PEERTUBE_SMTP_PORT",
      "value": "25",
      "description": "Port of Postfix-Relay server",
      "required": true,
      "mask": false
    },
    {
      "name": "Postfix-Relay - From Address",
      "key": "PEERTUBE_SMTP_FROM",
      "value": "",
      "description": "Email address to send from",
      "required": true,
      "mask": false
    },
    {
      "name": "Postfix-Relay - TLS",
      "key": "PEERTUBE_SMTP_TLS",
      "value": "false|true",
      "description": "Enable TLS for Postfix-Relay server",
      "required": true,
      "mask": false
    },
    {
      "name": "Postfix-Relay - Disable STARTTLS",
      "key": "PEERTUBE_SMTP_DISABLE_STARTTLS",
      "value": "false|true",
      "description": "Disable STARTTLS for Postfix-Relay server",
      "required": true,
      "mask": false
    },
    {
      "name": "Postfix-Relay - Admin Email",
      "key": "PEERTUBE_ADMIN_EMAIL",
      "value": "",
      "description": "Email address for admin",
      "required": true,
      "mask": false
    },
    {
      "name": "Webserver - Port",
      "key": "PEERTUBE_WEBSERVER_PORT",
      "value": "9000",
      "description": "Webserver Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Webserver - Enable HTTPS",
      "key": "PEERTUBE_WEBSERVER_HTTPS",
      "value": "false|true",
      "description": "Enable HTTPS for webserver",
      "required": true,
      "mask": false
    },
    {
      "name": "Webserver - Trust Proxy",
      "key": "PEERTUBE_TRUST_PROXY",
      "value": "['127.0.0.1', 'loopback']",
      "description": "Trust proxy for webserver",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
