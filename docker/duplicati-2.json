{
  "name": "duplicati",
  "repo": "ghcr.io/imagegenius/duplicati",
  "category": [
    "Backup"
  ],
  "registry": "https://github.com/orgs/imagegenius/packages/container/package/duplicati",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8200]",
  "icon": "https://raw.githubusercontent.com/imagegenius/templates/main/unraid/img/duplicati.png",
  "project": "https://www.duplicati.com/",
  "description": "Duplicati is a backup client that securely stores encrypted, incremental, compressed remote backups of local files on cloud storage services and remote file servers.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Appdata Path",
      "required": true
    },
    {
      "name": "Path: /backups",
      "host": "",
      "container": "/backups",
      "mode": "rw",
      "description": "Backup Destination Path",
      "required": true
    },
    {
      "name": "Path: /source",
      "host": "",
      "container": "/source",
      "mode": "rw",
      "description": "Backup Source Path",
      "required": true
    },
    {
      "name": "Path: /tmp",
      "host": "",
      "container": "/tmp",
      "mode": "rw",
      "description": "Temporary Uploads Path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8200",
      "container": "8200",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "CLI_ARGS",
      "key": "CLI_ARGS",
      "value": "",
      "description": "Optionally specify any CLI variables(https://duplicati.readthedocs.io/en/latest/07-other-command-line-utilities/) you want to launch the app with",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "UID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "GID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "UMASK for newly created files. Do not change unless you know what you're doing.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
