{
  "name": "Obsidian-Live-Sync-Cli",
  "repo": "ghcr.io/vrtmrz/livesync-cli:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://github.com/vrtmrz/obsidian-livesync/pkgs/container/livesync-cli",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--entrypoint=/bin/sh",
  "post_parameters": "-c printf %s  | base64 -d > /tmp/obsidian-livesync-bootstrap.sh; exec /bin/sh /tmp/obsidian-livesync-bootstrap.sh",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Lowess/docker-templates-unraid/main/Lowess/images/obsidian-livesync-cli.png",
  "project": "https://github.com/vrtmrz/obsidian-livesync",
  "description": "Headless Self-hosted LiveSync client that continuously synchronizes a local Obsidian vault with CouchDB without running Obsidian.",
  "paths": [
    {
      "name": "Database / Config",
      "host": "/mnt/cache/appdata/obsidian-livesync-cli",
      "container": "/data",
      "mode": "rw",
      "description": "Dedicated persistent directory for the CLI's local database and .livesync/settings.json. Do not map this to the vault.",
      "required": true
    },
    {
      "name": "Obsidian Vault",
      "host": "/mnt/cache/obsidian",
      "container": "/vault",
      "mode": "rw",
      "description": "Host directory containing the Markdown vault to synchronize. PUID and PGID must have read/write access.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Setup URI (first boot only)",
      "key": "SETUP_URI",
      "value": "",
      "description": "Paste the Setup URI generated by a working Self-hosted LiveSync device. Leave empty on an existing configured installation, and clear it after successful bootstrap.",
      "required": false,
      "mask": true
    },
    {
      "name": "Setup URI Passphrase (first boot only)",
      "key": "SETUP_PASSPHRASE",
      "value": "",
      "description": "Passphrase created with the Setup URI. Leave empty on an existing configured installation, and clear it after successful bootstrap.",
      "required": false,
      "mask": true
    },
    {
      "name": "Process User ID",
      "key": "PUID",
      "value": "500",
      "description": "User ID used for LiveSync database and vault file access. Unraid's standard nobody user is 99.",
      "required": true,
      "mask": false
    },
    {
      "name": "Process Group ID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID used for LiveSync database and vault file access. Unraid's standard users group is 100.",
      "required": true,
      "mask": false
    },
    {
      "name": "File Creation Mask",
      "key": "UMASK",
      "value": "002",
      "description": "Unix umask applied to files created by the CLI. 002 keeps files writable by the configured group.",
      "required": true,
      "mask": false
    },
    {
      "name": "Local Database Suffix",
      "key": "LOCAL_DATABASE_SUFFIX",
      "value": "unraid-cli",
      "description": "Safe device-local name for the CLI database. This replaces Android or desktop vault paths imported through a Setup URI.",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable Live Synchronization",
      "key": "ENABLE_LIVE_SYNC",
      "value": "true",
      "description": "Force continuous replication, startup replication, and replication after a local save for this CLI client.",
      "required": true,
      "mask": false
    },
    {
      "name": "Automatic Initial Sync",
      "key": "AUTO_INITIAL_SYNC",
      "value": "true",
      "description": "After this template imports new settings, require an empty vault, authorise this CLI node, and pull CouchDB before starting the daemon. Keep enabled for click-and-go setup.",
      "required": true,
      "mask": false
    },
    {
      "name": "Sync Interval",
      "key": "SYNC_INTERVAL",
      "value": "",
      "description": "Optional polling interval in seconds. Leave empty for the near-real-time CouchDB changes feed.",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Mode",
      "key": "LOG_MODE",
      "value": "normal",
      "description": "Logging detail: normal, verbose, or debug. Debug output can contain sensitive server details.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
