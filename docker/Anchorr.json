{
  "name": "Anchorr",
  "repo": "nairdah/anchorr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/nairdah/anchorr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8282]/",
  "icon": "https://raw.githubusercontent.com/openVESSL/Anchorr/main/assets/logo.png",
  "project": "https://github.com/openVESSL/Anchorr",
  "description": "A helpful Discord bot for requesting media via Seerr and receiving Jellyfin notifications for new content in your library.",
  "paths": [
    {
      "name": "Persistent configuration storage",
      "host": "/mnt/cache/appdata/anchorr",
      "container": "/usr/src/app/config",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8282",
      "container": "8282",
      "protocol": "tcp",
      "description": "The port that the WebUI will be on.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Webhook port",
      "key": "WEBHOOK_PORT",
      "value": "8282",
      "description": "Web dashboard port internally. You probably do not need to change this.",
      "required": false,
      "mask": false
    },
    {
      "name": "Production mode",
      "key": "NODE_ENV",
      "value": "production",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Bind Host",
      "key": "BIND_HOST",
      "value": "0.0.0.0",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
