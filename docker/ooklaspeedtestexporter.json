{
  "name": "ookla-speedtest-exporter",
  "repo": "ccmpbll/ookla-speedtest-exporter",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ccmpbll/ookla-speedtest-exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9142]",
  "icon": "https://raw.githubusercontent.com/ccmpbll/ookla-speedtest-exporter/main/ookla-speedtest-exporter.png",
  "project": "https://github.com/ccmpbll/ookla-speedtest-exporter",
  "description": "Prometheus metrics exporter for Ookla Speedtest CLI. Runs a live speedtest on each scrape and exposes bandwidth, ping, latency, and packet loss metrics.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "9142",
      "container": "9142",
      "protocol": "tcp",
      "description": "Prometheus Exporter Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Speedtest Server ID",
      "key": "SERVER_ID",
      "value": "",
      "description": "Specify an Ookla speedtest server (Optional)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
