{
  "name": "swatch",
  "repo": "crzynik/swatch:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/repository/docker/crzynik/swatch/general",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4500]",
  "icon": "https://user-images.githubusercontent.com/14866235/160284977-a9da849a-f80a-4d2b-90c9-e9c3e86a0bb2.png",
  "project": "https://github.com/NickM-27/swatch",
  "description": "Swatch: Color detection in images to capture presence of known objects. There is great object and face detection software out there, but sometimes AI detection is overkill or not suitable different types of objects. Swatch was created to create an easy to use API to detect the presence of objects of known color in expected places. Note: A config.yml file must exist in the config directory. See example here. See the documentation for more details.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/swatch/",
      "container": "/config",
      "mode": "rw",
      "description": "/mnt/user/appdata/swatch",
      "required": true
    },
    {
      "name": "Media Path",
      "host": "/mnt/cache/media/swatch/",
      "container": "/media/",
      "mode": "rw",
      "description": "/mnt/user/media/swatch/",
      "required": true
    },
    {
      "name": "Database path",
      "host": "/mnt/cache/database/swatch/",
      "container": "/database/",
      "mode": "rw",
      "description": "Path to swatch db",
      "required": true
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "/etc/localtime",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API",
      "host": "4500",
      "container": "4500",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
