{
  "name": "ParkPow-Plate-Recognizer---Snapshot",
  "repo": "platerecognizer/alpr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/platerecognizer/alpr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://app.parkpow.com/static/images/Icon_ParkPow_100x100.jpg",
  "project": "https://platerecognizer.com/",
  "description": "Read a license plate from a vehicle picture, powered by ParkPow.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/plate_recognizer/snapshot",
      "container": "/license",
      "mode": "rw",
      "description": "Path to app data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API Token",
      "key": "TOKEN",
      "value": "",
      "description": "API Token for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true
    },
    {
      "name": "License",
      "key": "LICENSE_KEY",
      "value": "",
      "description": "License Key for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
