{
  "name": "decypharr",
  "repo": "cy01/blackhole:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/cy01/blackhole/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--device /dev/fuse:/dev/fuse:rwm  --cap-add SYS_ADMIN  --security-opt apparmor:unconfined",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8282]/",
  "icon": "https://raw.githubusercontent.com/mash2k3/unraid-templates/main/icons/decypharr.png",
  "project": "https://sirrobot01.github.io/decypharr/",
  "description": "Decypharr is a self-hosted, open-source download client that integrates with multiple Debrid services. It provides a user-friendly interface for managing files and supports popular media management applications like Sonarr and Radarr.",
  "paths": [
    {
      "name": "mount",
      "host": "/mnt/cache/rclone",
      "container": "/mnt",
      "mode": "rw,shared",
      "description": null,
      "required": true
    },
    {
      "name": "config",
      "host": "/mnt/cache/appdata/decypharr",
      "container": "/app",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "cache",
      "host": "/mnt/cache/decypharr",
      "container": "/cache",
      "mode": "rw",
      "description": "optional",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "port",
      "host": "8282",
      "container": "8282",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
