{
  "name": "meilisearch",
  "repo": "getmeili/meilisearch:v1.12",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/getmeili/meilisearch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7700]",
  "icon": "https://raw.githubusercontent.com/Collectathon/unraid-templates/main/icons/meilisearch.png",
  "project": "https://github.com/meilisearch/meilisearch",
  "description": "An open-source, fast, and hyper-relevant search engine that fits effortlessly into your projects.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/meilisearch",
      "container": "/meili_data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "7700",
      "container": "7700",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Master Key",
      "key": "MEILI_MASTER_KEY",
      "value": "masterykeymasterkeymasterkeymasterkey",
      "description": "Password required to query meilisearch",
      "required": false,
      "mask": true
    },
    {
      "name": "Disable Analytics",
      "key": "MEILI_NO_ANALYTICS",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Environment",
      "key": "MEILI_ENV",
      "value": "production",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
