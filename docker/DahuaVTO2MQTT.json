{
  "name": "DahuaVTO2MQTT",
  "repo": "ronnieroller/dahuavto2mqtt:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/ronnieroller/dahuavto2mqtt",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://i.imgur.com/OAg2gT1.png",
  "project": "https://github.com/elad-bar/DahuaVTO2MQTT",
  "description": "Listens to events from Dahua VTO unit and publishes them via MQTT Message For integration with Home Assistant see https://community.home-assistant.io/t/dahua-vto-to-mqtt-broker/169781 Source: https://github.com/elad-bar/DahuaVTO2MQTT",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "DAHUA_VTO_HOST",
      "key": "DAHUA_VTO_HOST",
      "value": "192.168.1.210",
      "description": "The IP address of your VTO host",
      "required": false,
      "mask": false
    },
    {
      "name": "DAHUA_VTO_USERNAME",
      "key": "DAHUA_VTO_USERNAME",
      "value": "admin",
      "description": "VTO web username",
      "required": true,
      "mask": false
    },
    {
      "name": "DAHUA_VTO_PASSWORD",
      "key": "DAHUA_VTO_PASSWORD",
      "value": "",
      "description": "VTO web password",
      "required": true,
      "mask": true
    },
    {
      "name": "MQTT_BROKER_HOST",
      "key": "MQTT_BROKER_HOST",
      "value": "192.168.1.2",
      "description": "MQTT broker address",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT_BROKER_PORT",
      "key": "MQTT_BROKER_PORT",
      "value": "1883",
      "description": "MQTT broker port",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT_BROKER_USERNAME",
      "key": "MQTT_BROKER_USERNAME",
      "value": "",
      "description": "MQTT optional username",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT_BROKER_PASSWORD",
      "key": "MQTT_BROKER_PASSWORD",
      "value": "MQTT optional password",
      "description": "MQTT optional password",
      "required": false,
      "mask": true
    },
    {
      "name": "MQTT_BROKER_TOPIC_PREFIX",
      "key": "MQTT_BROKER_TOPIC_PREFIX",
      "value": "DahuaVTO",
      "description": "The MQTT topic prefix",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
