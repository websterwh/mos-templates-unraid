{
  "name": "MusicBrainz-Picard",
  "repo": "mikenye/picard",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/mikenye/picard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5800]",
  "icon": "https://raw.githubusercontent.com/RandomNinjaAtk/unraid-templates/master/randomninjaatk/img/picard.png",
  "project": "https://picard.musicbrainz.org/",
  "description": "Picard is a cross-platform music tagger written in Python.",
  "paths": [
    {
      "name": "Host Path for /config",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    },
    {
      "name": "Host Path for /storage",
      "host": "",
      "container": "/storage",
      "mode": "rw",
      "description": "Container Path: /storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port for 5800",
      "host": "5800",
      "container": "5800",
      "protocol": "tcp",
      "description": "Container Port: 5800",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Display Width",
      "key": "DISPLAY_WIDTH",
      "value": "1280",
      "description": "Width (in pixels) of the application's window.",
      "required": true,
      "mask": false
    },
    {
      "name": "Display Height",
      "key": "DISPLAY_HEIGHT",
      "value": "768",
      "description": "Height (in pixels) of the application's window.",
      "required": true,
      "mask": false
    },
    {
      "name": "USER_ID",
      "key": "USER_ID",
      "value": "500",
      "description": "Container Variable: USER_ID",
      "required": false,
      "mask": false
    },
    {
      "name": "GROUP_ID",
      "key": "GROUP_ID",
      "value": "500",
      "description": "Container Variable: GROUP_ID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
