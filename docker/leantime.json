{
  "name": "leantime",
  "repo": "leantime/leantime:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/leantime/leantime/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/install",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/leantime.png",
  "project": "https://leantime.io/",
  "description": "Leantime is an open source project management system for small teams and startups.",
  "paths": [
    {
      "name": "Userfiles Path",
      "host": "/mnt/cache/appdata/leantime/userfiles",
      "container": "/var/www/html/userfiles",
      "mode": "rw",
      "description": "Original mount name for compatibility",
      "required": false
    },
    {
      "name": "Plugins Path",
      "host": "/mnt/cache/appdata/leantime/plugins",
      "container": "/var/www/html/app/Plugins",
      "mode": "rw",
      "description": "Plugin storag",
      "required": false
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/leantime/logs",
      "container": "/var/www/html/storage/logs",
      "mode": "rw",
      "description": "Log storage",
      "required": false
    },
    {
      "name": "Public userfiles Path",
      "host": "/mnt/cache/appdata/leantime/public_userfiles",
      "container": "/var/www/html/public/userfiles",
      "mode": "rw",
      "description": "store public files, logo etc",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "LEAN_DB_HOST",
      "key": "LEAN_DB_HOST",
      "value": "Hostname or IP",
      "description": "Database Hostname or IP",
      "required": true,
      "mask": false
    },
    {
      "name": "LEAN_DB_USER",
      "key": "LEAN_DB_USER",
      "value": "leantime",
      "description": "LEAN_DB_USER",
      "required": true,
      "mask": false
    },
    {
      "name": "LEAN_DB_PASSWORD",
      "key": "LEAN_DB_PASSWORD",
      "value": "password",
      "description": "LEAN_DB_PASSWORD",
      "required": true,
      "mask": false
    },
    {
      "name": "LEAN_DB_DATABASE",
      "key": "LEAN_DB_DATABASE",
      "value": "leantime",
      "description": "LEAN_DB_DATABASE",
      "required": true,
      "mask": false
    },
    {
      "name": "LEAN_DB_PORT",
      "key": "LEAN_DB_PORT",
      "value": "3306",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LEAN_APP_URL",
      "key": "LEAN_APP_URL",
      "value": "http://192.168.0.100:8080",
      "description": "Define the url can be http://192.168.0.100:8080 or https://leantime.example.com",
      "required": true,
      "mask": false
    },
    {
      "name": "LEAN_SESSION_PASSWORD",
      "key": "LEAN_SESSION_PASSWORD",
      "value": "3evBlq9zdUEuzKvVJHWWx3QzsQhturBApxwcws2m",
      "description": "Salting sessions, replace with a strong password",
      "required": true,
      "mask": false
    },
    {
      "name": "LEAN_DEFAULT_TIMEZONE",
      "key": "LEAN_DEFAULT_TIMEZONE",
      "value": "America/Los_Angeles",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LEAN_TRUSTED_PROXIES",
      "key": "LEAN_TRUSTED_PROXIES",
      "value": "127.0.0.1,REMOTE_ADDR",
      "description": "Set trusted proxy ips. Can be used to restrict access or define access from certain proxies only",
      "required": false,
      "mask": false
    },
    {
      "name": "LEAN_SESSION_SECURE",
      "key": "LEAN_SESSION_SECURE",
      "value": "FALSE",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
