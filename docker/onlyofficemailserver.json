{
  "name": "onlyoffice-mail-server",
  "repo": "xternet/unraid-onlyoffice-mail-server",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/repository/docker/xternet/unraid-onlyoffice-mail-server",
  "network": "onlyoffice",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "-h yourdomain.com -p 25:25 -p 465:465 -p 143:143 -p 993:993 -p 110:110 -p 995:995 -p 587:587 -p 8081:8081 -p 4190:4190",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/AMJidovu/unraid-repository/master/img/onlyoffice-ce-ds.jpg",
  "project": "https://www.onlyoffice.com/",
  "description": "OnlyOffice Mail Server for external mail. Click advanced view and setup the yourdomain.com with your domain registered hostname. For more information visit the support thread https://forums.Unraid.net/topic/85643-support-amjidovu-onlyoffice-community-server/",
  "paths": [
    {
      "name": "Mounted Mail Data",
      "host": "/mnt/cache/appdata/onlyoffice/MailServer/data",
      "container": "/var/vmail",
      "mode": "rw",
      "description": "Container Path: /var/vmail",
      "required": false
    },
    {
      "name": "Mounted Certs Folder",
      "host": "/mnt/cache/appdata/onlyoffice/MailServer/data/certs",
      "container": "/etc/pki/tls/mailserver",
      "mode": "rw",
      "description": "Container Path: /etc/pki/tls/mailserver",
      "required": false
    },
    {
      "name": "Mounted Logs Folder",
      "host": "/mnt/cache/appdata/onlyoffice/MailServer/logs",
      "container": "/var/log",
      "mode": "rw",
      "description": "Container Path: /var/log",
      "required": false
    },
    {
      "name": "Mounted MySQL Data",
      "host": "/mnt/cache/appdata/onlyoffice/MailServer/mysql",
      "container": "/var/lib/mysql",
      "mode": "rw",
      "description": "Container Path: /var/lib/mysql",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "MySQL Host - Read Description for Changes ----&gt;",
      "key": "MYSQL_SERVER",
      "value": "onlyoffice-mysql-server",
      "description": "Container Variable: onlyoffice-mysql-server ---- For database hosted on another server use the external IP ( internet IP ).",
      "required": false,
      "mask": false
    },
    {
      "name": "MySQL Port",
      "key": "MYSQL_SERVER_PORT",
      "value": "3306",
      "description": "Container Variable: MYSQL_SERVER_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "Root User for MySQL ( Default is 'mail_admin' )",
      "key": "MYSQL_ROOT_USER",
      "value": "mail_admin",
      "description": "Container Variable: MYSQL_ROOT_USER",
      "required": false,
      "mask": false
    },
    {
      "name": "Root Password for MySQL ( Default password is 'Isadmin123' )",
      "key": "MYSQL_ROOT_PASSWD",
      "value": "Isadmin123",
      "description": "Container Variable: MYSQL_ROOT_PASSWD",
      "required": false,
      "mask": true
    },
    {
      "name": "Default Mail Server Database Name",
      "key": "MYSQL_SERVER_DB_NAME",
      "value": "onlyoffice_mailserver",
      "description": "Container Variable: MYSQL_SERVER_DB_NAME",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
