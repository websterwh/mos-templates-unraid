{
  "name": "WebComm-Calendar-Sync",
  "repo": "ghcr.io/2crazytv/webcomm-calendar-sync:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://ghcr.io/2crazytv/webcomm-calendar-sync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:8788]/",
  "icon": "https://raw.githubusercontent.com/2CrAzYTV/unraid-community-apps/main/icons/webcomm-calendar-sync.png",
  "project": "https://github.com/2CrAzYTV/webcomm-calendar-sync",
  "description": "WebComm Calendar Sync automatically reads WebComm duty schedules, detects changes, synchronizes work shifts to ICS, CalDAV or Google Calendar, can send optional Telegram notifications, and can optionally integrate with Alarm-HUB. Chromium and persistent configuration are included in the container.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/webcomm-calendar-sync",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent application settings, certificates, cached service cards and generated calendar data.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8788",
      "container": "8788",
      "protocol": "tcp",
      "description": "HTTPS port for the WebComm Calendar Sync WebUI.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Enabled",
      "key": "HTTPS_ENABLED",
      "value": "true",
      "description": "Enable the built-in HTTPS WebUI.",
      "required": true,
      "mask": false
    },
    {
      "name": "TLS SAN IPs",
      "key": "TLS_SAN_IPS",
