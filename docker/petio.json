{
  "name": "petio",
  "repo": "ghcr.io/petio-team/petio",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/petio-team/petio",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7777]",
  "icon": "https://github.com/PotentialIngenuity/petio-unraid/raw/master/petio.png",
  "project": "https://github.com/petio-team/petio",
  "description": "Petio is a third party companion app available to Plex server owners to allow their users to request, review and discover content",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/petio/config",
      "container": "/app/api/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/petio/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "7777",
      "container": "7777",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
