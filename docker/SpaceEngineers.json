{
  "name": "SpaceEngineers",
  "repo": "devidian/spaceengineers",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/devidian/spaceengineers/",
  "network": "Bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:27017]",
  "icon": "https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/46b63d3c-ae67-464c-9a37-670829b2a157/dby54ap-9d0b780d-2426-43af-95f9-01fa464557ad.png?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..0dVWg8D7LYI0hx-Hy760PYC8g51bS89Mb5zK041Y4s4",
  "project": "https://hub.docker.com/r/devidian/spaceengineers/",
  "description": "Space Engineers Dedicated Server build on Debian10 BETA Warning: Since this Docker runs with WINE it's marked as BETA, i can not guarantee if the server is running always as expected! ATTENTION: First Startup can take very long since it downloads the gameserver files! https://hub.docker.com/r/devidian/spaceengineers/ Credits to devidian, creator of the container.",
  "paths": [
    {
      "name": "SteamCMD",
      "host": "/mnt/cache/appdata/steamcmd/",
      "container": "/serverdata/steamcmd",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "ServerFiles",
      "host": "/mnt/cache/appdata/SpaceEngineersDedicated",
      "container": "/appdata/space-engineers/SpaceEngineersDedicated",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "ServerConfig",
      "host": "/mnt/cache/appdata/SpaceEngineersDedicated/Instances",
      "container": "/appdata/space-engineers/instances",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "UDP - Game Port",
      "host": "27017",
      "container": "27017",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TCP - Remote Control Port",
      "host": "18080",
      "container": "18080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Instance Name",
      "key": "INSTANCE_NAME",
      "value": "SE",
      "description": "The name of your instance, is used as a subfolder in the instances directory",
      "required": true,
      "mask": false
    },
    {
      "name": "Container Variable 3",
      "key": "WINEPREFIX",
      "value": "/root/server",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Container Variable 1",
      "key": "WINEARCH",
      "value": "win64",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Container Variable 2",
      "key": "WINEDEBUG",
      "value": "-all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Container Variable 4",
      "key": "APT_KEY_DONT_WARN_ON_DANGEROUS_USAGE",
      "value": "1",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
