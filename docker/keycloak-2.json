{
  "name": "keycloak",
  "repo": "bitnami/keycloak:latest",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/bitnami/keycloak/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/keycloak.png",
  "project": "https://www.keycloak.org/",
  "description": "Open Source Identity and Access Management.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Keycloak Hostname",
      "key": "KEYCLOAK_HOSTNAME",
      "value": "192.168.100.100",
      "description": "Put your IP:PORT (192.168.100.100) or Hostname (auth.exmaple.com)",
      "required": true,
      "mask": false
    },
    {
      "name": "Keycloak Admin User",
      "key": "KEYCLOAK_ADMIN",
      "value": "admin",
      "description": "Keycloak Admin User",
      "required": true,
      "mask": false
    },
    {
      "name": "Keycloak Admin Password",
      "key": "KEYCLOAK_ADMIN_PASSWORD",
      "value": "password",
      "description": "Keycloak Admin Password",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Database Hostname",
      "key": "KEYCLOAK_DATABASE_HOST",
      "value": "192.168.100.100",
      "description": "Postgres IP",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Port",
      "key": "KEYCLOAK_DATABASE_PORT",
      "value": "5432",
      "description": "Postgres Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Database User",
      "key": "KEYCLOAK_DATABASE_USER",
      "value": "keyclock",
      "description": "Postgres Database User",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Database Password",
      "key": "KEYCLOAK_DATABASE_PASSWORD",
      "value": "password",
      "description": "Postgres Database Password",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Database Name",
      "key": "KEYCLOAK_DATABASE_NAME",
      "value": "keyclock",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Keycloak Admin Hostname",
      "key": "KEYCLOAK_HOSTNAME_ADMIN",
      "value": "",
      "description": "URL for admin access, you can have this be the same as hostname if you want to have web access to Keycloak admin portal, or you can set to something else if you want to keep it local",
      "required": false,
      "mask": false
    },
    {
      "name": "KEYCLOAK_PRODUCTION",
      "key": "KEYCLOAK_PRODUCTION",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KEYCLOAK_HOSTNAME_STRICT",
      "key": "KEYCLOAK_HOSTNAME_STRICT",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KEYCLOAK_PROXY_HEADERS",
      "key": "KEYCLOAK_PROXY_HEADERS",
      "value": "xforwarded",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KEYCLOAK_EXTRA_ARGS",
      "key": "KEYCLOAK_EXTRA_ARGS",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
