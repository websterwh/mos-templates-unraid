{
  "name": "keycloak",
  "repo": "keycloak/keycloak:latest",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/keycloak/keycloak",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "start",
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/jcesclapez/unraid-templates/refs/heads/main/keycloak/keycloak.png",
  "project": "https://www.keycloak.org/",
  "description": "Open Source Identity and Access Management Add authentication to applications and secure services with minimum effort. No need to deal with storing users or authenticating users.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Keycloak Hostname",
      "key": "KC_HOSTNAME",
      "value": "",
      "description": "Put your IP:PORT (192.168.100.100) or Hostname (auth.exmaple.com)",
      "required": true,
      "mask": false
    },
    {
      "name": "Keycloak Admin User",
      "key": "KC_BOOTSTRAP_ADMIN_USERNAME",
      "value": "admin",
      "description": "Keycloak Admin User",
      "required": true,
      "mask": false
    },
    {
      "name": "Keycloak Admin Password",
      "key": "KC_BOOTSTRAP_ADMIN_PASSWORD",
      "value": "password",
      "description": "Keycloak Admin Password",
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres Database Hostname",
      "key": "KC_DB_URL",
      "value": "jdbc:postgresql://192.168.1.10:5432/keycloak",
      "description": "Postgres IP and DB",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Database User",
      "key": "KC_DB_USERNAME",
      "value": "keycloak",
      "description": "Postgres Database User",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Database Password",
      "key": "KC_DB_PASSWORD",
      "value": "password",
      "description": "Postgres Database Password",
      "required": true,
      "mask": true
    },
    {
      "name": "Enabling PostgreSQL",
      "key": "KC_DB",
      "value": "postgres",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Keycloak Admin Hostname",
      "key": "KC_HOSTNAME_ADMIN",
      "value": "",
      "description": "URL for admin access, you can have this be the same as hostname if you want to have web access to Keycloak admin portal, or you can set to something else if you want to keep it local",
      "required": false,
      "mask": false
    },
    {
      "name": "KEYCLOAK_HOSTNAME_STRICT",
      "key": "KC_HOSTNAME_STRICT",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KEYCLOAK_EXTRA_ARGS",
      "key": "KEYCLOAK_EXTRA_ARGS",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KC_CACHE",
      "key": "KC_CACHE",
      "value": "local",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KC_PROXY_HEADERS",
      "key": "KC_PROXY_HEADERS",
      "value": "xforwarded",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KC_HTTP_ENABLED",
      "key": "KC_HTTP_ENABLED",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
