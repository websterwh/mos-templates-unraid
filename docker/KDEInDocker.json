{
  "name": "KDEInDocker",
  "repo": "msjpq/firefox-vnc",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/msjpq/firefox-vnc/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/cheesemarathon/docker-templates/master/images/KID.png",
  "project": "https://github.com/ms-jpq/kde-in-docker",
  "description": "KDE In Docker + VNC + noVNC Web UI Default Password: admin",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/KID",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "noVNC Port",
      "host": "4686",
      "container": "8080",
      "protocol": "tcp",
      "description": "noVNC Port: 8080",
      "required": false,
      "mask": false
    },
    {
      "name": "VNC Port",
      "host": "4900",
      "container": "5900",
      "protocol": "tcp",
      "description": "VNC Port: 5900",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "SCR_WIDTH",
      "key": "SCR_WIDTH",
      "value": "1600",
      "description": "Container Variable: SCR_WIDTH",
      "required": true,
      "mask": false
    },
    {
      "name": "SCR_HEIGHT",
      "key": "SCR_HEIGHT",
      "value": "900",
      "description": "Container Variable: SCR_HEIGHT",
      "required": false,
      "mask": false
    },
    {
      "name": "PATH_PREFIX",
      "key": "noVNC PATH_PREFIX",
      "value": "/",
      "description": "Container Variable: noVNC PATH_PREFIX",
      "required": false,
      "mask": false
    },
    {
      "name": "VNC_RESIZE",
      "key": "VNC_RESIZE",
      "value": "scale",
      "description": "Container Variable: VNC_RESIZE remote = rescale remote desktop scale = stretch remote desktop off = disable resize",
      "required": false,
      "mask": false
    },
    {
      "name": "RECON_DELAY",
      "key": "RECON_DELAY",
      "value": "20",
      "description": "Container Variable: RECON_DELAY",
      "required": false,
      "mask": false
    },
    {
      "name": "PAGE_TITLE",
      "key": "PAGE_TITLE",
      "value": "KID",
      "description": "Container Variable: PAGE_TITLE",
      "required": false,
      "mask": false
    },
    {
      "name": "ROOT_PASSWORD",
      "key": "ROOT_PASSWORD",
      "value": "admin",
      "description": "Container Variable: ROOT_PASSWORD",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
