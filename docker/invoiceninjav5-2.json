{
  "name": "invoiceninja-v5",
  "repo": "anojht/invoiceninja",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/anojht/invoiceninja",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:443]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/invoiceninja.png",
  "project": "https://www.invoiceninja.com/",
  "description": "An open-source invoicing and time-tracking app built with Laravel https://www.invoiceninja.com",
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/invoiceninja/storage",
      "container": "/var/www/app/storage",
      "mode": "rw",
      "description": "Container Path: /var/www/app/storage",
      "required": false
    },
    {
      "name": "Logo",
      "host": "/mnt/cache/appdata/invoiceninja/logo",
      "container": "/var/www/app/public/logo",
      "mode": "rw",
      "description": "Container Path: /var/www/app/public/logo",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8000",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "8443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_ENV",
      "key": "APP_ENV",
      "value": "production",
      "description": "Container Variable: APP_ENV",
      "required": false,
      "mask": false
    },
    {
      "name": "Debug Mode",
      "key": "APP_DEBUG",
      "value": "false",
      "description": "Container Variable: APP_DEBUG",
      "required": false,
      "mask": false
    },
    {
      "name": "Require HTTPS",
      "key": "REQUIRE_HTTPS",
      "value": "false",
      "description": "Container Variable: REQUIRE_HTTPS",
      "required": false,
      "mask": false
    },
    {
      "name": "Trusted Proxies",
      "key": "TRUSTED_PROXIES",
      "value": "*",
      "description": "Container Variable: TRUSTED_PROXIES - Set to * when running behind a reverse proxy (e.g. SWAG, Nginx Proxy Manager) so Invoice Ninja honors X-Forwarded-* headers. Leave blank if not behind a proxy.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Host",
      "key": "DB_HOST",
      "value": "unraidIP",
      "description": "Container Variable: DB_HOST",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "DB_PORT",
      "value": "3306",
      "description": "Container Variable: DB_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "DB_DATABASE",
      "value": "ninja",
      "description": "Container Variable: DB_DATABASE",
      "required": false,
      "mask": false
    },
    {
      "name": "Database username",
      "key": "DB_USERNAME",
      "value": "ninja",
      "description": "Container Variable: DB_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "DB_PASSWORD",
      "value": "ninja",
      "description": "Container Variable: DB_PASSWORD",
      "required": false,
      "mask": true
    },
    {
      "name": "Initial User Email",
      "key": "IN_USER_EMAIL",
      "value": "user@user.com",
      "description": "Container Variable: IN_USER_EMAIL",
      "required": true,
      "mask": false
    },
    {
      "name": "Initial User Password",
      "key": "IN_PASSWORD",
      "value": "userpassword",
      "description": "Container Variable: IN_PASSWORD",
      "required": true,
      "mask": true
    },
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "https://invoice.domain.com",
      "description": "Container Variable: APP_URL",
      "required": true,
      "mask": false
    },
    {
      "name": "APP_KEY",
      "key": "APP_KEY",
      "value": "SomeRandom32CharacterLongAlphanumericString",
      "description": "Container Variable: APP_KEY",
      "required": true,
      "mask": false
    },
    {
      "name": "MAIL_MAILER",
      "key": "MAIL_MAILER",
      "value": "smtp",
      "description": "Container Variable: MAIL_MAILER",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PORT",
      "key": "MAIL_PORT",
      "value": "587",
      "description": "Container Variable: MAIL_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_ENCRYPTION",
      "key": "MAIL_ENCRYPTION",
      "value": "tls",
      "description": "Container Variable: MAIL_ENCRYPTION",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_HOST",
      "key": "MAIL_HOST",
      "value": "smtp.example.com",
      "description": "Container Variable: MAIL_HOST",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_USERNAME",
      "key": "MAIL_USERNAME",
      "value": "johndoe@example.com",
      "description": "Container Variable: MAIL_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_FROM_ADDRESS",
      "key": "MAIL_FROM_ADDRESS",
      "value": "invoice@example.com",
      "description": "Container Variable: MAIL_FROM_ADDRESS",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_FROM_NAME",
      "key": "MAIL_FROM_NAME",
      "value": "Invoice Department",
      "description": "Container Variable: MAIL_FROM_NAME",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PASSWORD",
      "key": "MAIL_PASSWORD",
      "value": "SUPERSECRETEMAILPASSWORD",
      "description": "Container Variable: MAIL_PASSWORD",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
