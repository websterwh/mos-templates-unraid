{
  "name": "Stash",
  "repo": "stashapp/stash",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/stashapp/stash/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9999]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/stash.png",
  "project": "https://github.com/stashapp/stash",
  "description": "Stash is a Go app which organizes and serves your NSFW adult media content. data: where your media collection is config: where the config file and the stash database file will be stored metadata: the main metadata folder, used for import/export functions cache: a folder to use as cache generated: where the previews, screenshots, transcoded files, and sprites will be generated. This can grow very large if you have a large collection, you may want it on your array instead of your cache, this choice is up to you.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/private/media/",
      "container": "/data",
      "mode": "rw",
      "description": "Path to your adult media content.",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/stash/config",
      "container": "/root/.stash",
      "mode": "rw",
      "description": "Container Path: /root/.stash",
      "required": false
    },
    {
      "name": "Metadata Path",
      "host": "/mnt/cache/appdata/stash/metadata",
      "container": "/metadata",
      "mode": "rw",
      "description": "Container Path: /metadata",
      "required": false
    },
    {
      "name": "Cache Path",
      "host": "/mnt/cache/appdata/stash/cache",
      "container": "/cache",
      "mode": "rw",
      "description": "Container Path: /cache",
      "required": false
    },
    {
      "name": "Generated Path",
      "host": "/mnt/cache/appdata/stash/generated",
      "container": "/generated",
      "mode": "rw",
      "description": "Container Path: /generated",
      "required": false
    },
    {
      "name": "Blobs Path",
      "host": "/mnt/cache/appdata/stash/blobs",
      "container": "/blobs",
      "mode": "rw",
      "description": "Container Path: /blobs",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "6969",
      "container": "9999",
      "protocol": "tcp",
      "description": "Container Port: 9999",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Cache Variable",
      "key": "STASH_CACHE",
      "value": "/cache/",
      "description": "Container Variable: STASH_CACHE",
      "required": false,
      "mask": false
    },
    {
      "name": "Metadata Variable",
      "key": "STASH_METADATA",
      "value": "/metadata/",
      "description": "Container Variable: STASH_METADATA",
      "required": false,
      "mask": false
    },
    {
      "name": "Generated Variable",
      "key": "STASH_GENERATED",
      "value": "/generated/",
      "description": "Container Variable: STASH_GENERATED",
      "required": false,
      "mask": false
    },
    {
      "name": "Data Variable",
      "key": "STASH_STASH",
      "value": "/data/",
      "description": "Container Variable: STASH_STASH",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
