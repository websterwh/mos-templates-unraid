{
  "name": "BTDEX",
  "repo": "furritos/docker-btdex:latest",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/furritos/docker-btdex:latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://github.com/furritos/docker-templates/raw/master/furritos/images/btdex.png",
  "project": "https://btdex.trade/",
  "description": "BTDEX in a Docker container based on linuxserver.io/KasmVNC Docker image. What is BTDEX? It's a unique, serverless, non-custodial exchange method for cryptocurrencies and fiat currencies based on the Signum cryptocurrency. The BTDEX application and the cross-chain/fiat smart contracts are open source. No need to trust your funds to closed source solutions. BTDEX is open-source software found at https://github.com/btdex/btdex.",
  "paths": [
    {
      "name": "Configuration Storage Path",
      "host": "",
      "container": "/opt/btdex/.config/btdex",
      "mode": "rw",
      "description": "BTDEX Configuration Path (e.g. /mnt/user/appdata/btdex/config)",
      "required": true
    },
    {
      "name": "Cache Storage Path",
      "host": "",
      "container": "/opt/btdex/cache",
      "mode": "rw",
      "description": "In-flight storage for plot creation (e.g. /mnt/user/appdata/btdex/cache)",
      "required": false
    },
    {
      "name": "Plot Storage Path",
      "host": "",
      "container": "/opt/btdex/plots",
      "mode": "rw",
      "description": "Plot files used for mining (e.g. /mnt/user/appdata/btdex/plots)",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "HTTP Port",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "HTTPS Port",
      "required": false,
      "mask": false
    },
    {
      "name": "BTDEX API Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "BTDEX API Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
