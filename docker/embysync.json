{
  "name": "emby-sync",
  "repo": "lastelement21/emby-sync",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/lastelement21/emby-sync/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/C4ArtZ/Unraid-Templates/master/templates/icons/emby-sync.png",
  "project": "https://github.com/cameronurnes/emby-sync",
  "description": "A small flask based service to sync up Emby clients",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API Key",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Your API Key for Emby",
      "required": true,
      "mask": true
    },
    {
      "name": "Emby server",
      "key": "EMBY_SERVER",
      "value": "https://",
      "description": "URL to your Emby server",
      "required": true,
      "mask": false
    },
    {
      "name": "Default room",
      "key": "DEFAULT_ROOM",
      "value": "",
      "description": "Make sure this room always exists! Leave empty for default. Default is 'Bacon Bar'",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
