{
  "name": "HA-Dashboard",
  "repo": "ghcr.io/tjindarr/family-hub-display:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://ghcr.io/tjindarr/family-hub-display",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/Tjindarr/family-hub-display/main/icon.png",
  "project": "https://github.com/Tjindarr/family-hub-display",
  "description": "A self-hosted Home Assistant dashboard with chores, sensors, calendar, weather, photos and push notifications. Optimised for wall-mounted kiosks (Raspberry Pi) and any modern browser. Configuration and data persist in /data.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/ha-dashboard",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent config, chores, photos, vapid keys",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8087",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP port for the dashboard",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
