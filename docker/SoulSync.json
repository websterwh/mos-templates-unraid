{
  "name": "SoulSync",
  "repo": "boulderbadgedad/soulsync:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/boulderbadgedad/soulsync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8008]",
  "icon": "https://raw.githubusercontent.com/Nezreka/SoulSync/main/assets/trans.png",
  "project": "https://github.com/Nezreka/SoulSync",
  "description": "Automated music discovery and collection manager. Sync Spotify/Tidal/YouTube playlists to Plex/Jellyfin via Soulseek.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/soulsync/config.json",
      "container": "/app/config/config.json",
      "mode": "rw",
      "description": "Configuration files",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/soulsync/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Log files",
      "required": false
    },
    {
      "name": "Music Share",
      "host": "/mnt/cache/Music",
      "container": "/host/music",
      "mode": "rw",
      "description": "Your music share for downloads and library",
      "required": true
    },
    {
      "name": "Database Volume",
      "host": "/mnt/cache/appdata/soulsync/database",
      "container": "/app/data",
      "mode": "rw",
      "description": "Database volume (leave empty for named volume)",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8008",
      "container": "8008",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    },
    {
      "name": "Spotify OAuth Port",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "Spotify OAuth callback port",
      "required": true,
      "mask": false
    },
    {
      "name": "Tidal OAuth Port",
      "host": "8889",
      "container": "8889",
      "protocol": "tcp",
      "description": "Tidal OAuth callback port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
