{
  "name": "CloudDrive",
  "repo": "cloudnas/clouddrive2",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/cloudnas/clouddrive2",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:19798]",
  "icon": "https://www.clouddrive2.com/img/clouddrive-512.png",
  "project": "https://www.clouddrive2.com/",
  "description": "CloudDrive is a powerful multi-cloud drive management tool, providing users with a one-stop multi-cloud drive solution that includes local mounting of cloud drives Unraid&CloudDrive\u4f7f\u7528\u7b54\u7591\u56e2\u8d2d\u8bf7\u6dfb\u52a0WeChat: anpple",
  "paths": [
    {
      "name": "Custom MountPoint",
      "host": "/mnt/cache/clouddrive/",
      "container": "/CloudNAS",
      "mode": "rw,shared",
      "description": "\u81ea\u5b9a\u4e49\u4e91\u76d8\u6302\u8f7d\u8def\u5f84",
      "required": true
    },
    {
      "name": "Config Dir",
      "host": "/mnt/cache/appdata/clouddrive",
      "container": "/Config",
      "mode": "rw",
      "description": "\u914d\u7f6e\u8def\u5f84",
      "required": true
    },
    {
      "name": "Movies Library",
      "host": "/mnt/cache/movies/",
      "container": "/movies",
      "mode": "rw,shared",
      "description": "\u4fee\u6539\u4e3a\u4f60\u7684\u7535\u5f71\u5e93\u8def\u5f84",
      "required": false
    },
    {
      "name": "TV Library",
      "host": "/mnt/cache/tv/",
      "container": "/tv",
      "mode": "rw,shared",
      "description": "\u4fee\u6539\u4e3a\u4f60\u7684\u5267\u96c6\u5e93\u8def\u5f84",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "19798",
      "container": "19798",
      "protocol": "tcp",
      "description": "\u9ed8\u8ba4\u7ba1\u7406\u7aef\u53e3",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "\u914d\u7f6e\u53d8\u91cf",
      "key": "CLOUDDRIVE_HOME",
      "value": "/Config",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "/dev/fuse",
      "host": "/dev/fuse",
      "container": "",
      "description": "Fuse\u8bbe\u5907",
      "required": true
    }
  ],
  "labels": []
}
