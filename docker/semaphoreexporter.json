{
  "name": "semaphore-exporter",
  "repo": "louij2/semaphore-exporter:latest",
  "category": [
    "Monitoring"
  ],
  "registry": "https://hub.docker.com/r/louij2/semaphore-exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --cpus=0.5",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9819]/metrics",
  "icon": "https://raw.githubusercontent.com/semaphoreui/semaphore/develop/web/src/assets/logo.svg",
  "project": "https://github.com/louij2/semaphore-exporter",
  "description": "Prometheus exporter for Semaphore (semaphoreui.com), which has no native /metrics endpoint. Read-only: only GETs from Semaphore's API. Exports semaphore_task_running_seconds for every non-terminal task, so a task stuck running for hours shows up, not just failed/succeeded ones.",
  "paths": [
    {
      "name": "semaphore-token",
      "host": "/mnt/cache/appdata/semaphore-exporter/semaphore-token",
      "container": "/run/secrets/semaphore-token",
      "mode": "ro",
      "description": "Read-only bind mount to a file containing your Semaphore API token.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 9819",
      "host": "9819",
      "container": "9819",
      "protocol": "tcp",
      "description": "Container Port: 9819",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SEMAPHORE_URL",
      "key": "SEMAPHORE_URL",
      "value": "",
      "description": "e.g. http://10.0.0.24:3000",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
