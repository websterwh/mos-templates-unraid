{
  "name": "An-Otter-Wiki",
  "repo": "redimp/otterwiki:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/redimp/otterwiki",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/redimp/otterwiki/main/otterwiki/static/img/otterhead.png",
  "project": "https://otterwiki.com",
  "description": "A Python-based collaborative content management system (wiki), powered by Git and Markdown.",
  "paths": [
    {
      "name": "Data storage",
      "host": "/mnt/cache/appdata/otterwiki",
      "container": "/app-data",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
