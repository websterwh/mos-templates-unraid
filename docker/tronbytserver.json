{
  "name": "tronbyt-server",
  "repo": "ghcr.io/tronbyt/server:2",
  "category": [
    "Home Automation"
  ],
  "registry": "https://ghcr.io/tronbyt/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/bigsing/unraid-templates/refs/heads/main/images/tronbyt-server.ico",
  "project": "https://github.com/tronbyt",
  "description": "Tronbyt is an ecosystem replacement for Tidbyt. Tronbyt-server is the system for adding and configuring apps as well as serving to the Tronbyt hardware.",
  "paths": [
    {
      "name": "Timezone",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "used to sync docker with host time",
      "required": true
    },
    {
      "name": "Config Path 1",
      "host": "/mnt/cache/appdata/tronbyt/data",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Config Path 2",
      "host": "/mnt/cache/appdata/tronbyt/users",
      "container": "/app/users",
      "mode": "rw",
      "description": "Required for v1. Can be removed after one-time db migration from v1 to v2.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
