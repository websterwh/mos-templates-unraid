{
  "name": "vLLM",
  "repo": "vllm/vllm-openai",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/vllm/vllm-openai",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia --ipc=host",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://i.imgur.com/oQcntuY.png",
  "project": "https://docs.vllm.ai/",
  "description": "Easy, fast, and cheap LLM serving for everyone",
  "paths": [
    {
      "name": "Model Storage",
      "host": "/mnt/cache/appdata/vllm",
      "container": "/root/.cache/huggingface",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Hugging Face Token",
      "key": "HUGGING_FACE_HUB_TOKEN",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
