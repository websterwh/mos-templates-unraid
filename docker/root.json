{
  "name": "root",
  "repo": "bgameiro/arch-cern-root",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/repository/docker/bgameiro/arch-cern-root",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8888]",
  "icon": "https://raw.githubusercontent.com/BGameiro2000/unraid-ca/master/root/logo.png",
  "project": "https://root.cern/",
  "description": "ROOT is a framework for data processing, born at CERN, at the heart of the research on high-energy physics. Every day, thousands of physicists use ROOT applications to analyze their data or to perform simulations.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/cern-root/config",
      "container": "/appdata",
      "mode": "rw",
      "description": "Container Path: /appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9999",
      "container": "8888",
      "protocol": "tcp",
      "description": "Container Port: 8888",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
