{
  "name": "netbox",
  "repo": "pitkley/netbox:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/pitkley/netbox",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/netbox.png",
  "project": "https://github.com/netbox-community/netbox",
  "description": "IP address management (IPAM) and data center infrastructure management (DCIM) tool. To create User cli to the docker then \"./manage.py createsuperuser\" Postgres required",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "postgres",
      "description": "DB Hostname or IP Postgres",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "netbox",
      "description": "DB NAME Postgres",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "netbox",
      "description": "DB USER Postgres",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PASS",
      "key": "DB_PASS",
      "value": "netbox",
      "description": "DB PASS Postgres",
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "ChangeMe",
      "description": "SECRET_KEY",
      "required": true,
      "mask": false
    },
    {
      "name": "ALLOWED_HOSTS",
      "key": "ALLOWED_HOSTS",
      "value": "*",
      "description": "ALLOWED_HOSTS",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
