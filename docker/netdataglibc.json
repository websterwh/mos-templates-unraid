{
  "name": "netdata-glibc",
  "repo": "d34dc3n73r/netdata-glibc",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/d34dc3n73r/netdata-glibc",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--hostname=unraid --runtime=nvidia --cap-add SYS_PTRACE --security-opt apparmor=unconfined",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:19999]",
  "icon": "https://raw.githubusercontent.com/netdata/netdata/master/web/gui/dashboard/images/ms-icon-310x310.png",
  "project": "https://github.com/D34DC3N73R/netdata-glibc",
  "description": "Netdata with Nvidia GPU monitoring in a container. An automated build of netdata with glibc for use with Nvidia GPUs. NOTE: An Nvidia GPU and the Unraid Nvidia Plugin are required to use this image. If you wish to use it without a gpu, (eg need glibc for another reason) turn on Advanced View and remove '--runtime=nvidia' from Extra Parameters, and remove NVIDIA_VISIBLE_DEVICES or set it to 'void'.",
  "paths": [
    {
      "name": "Netdata Config",
      "host": "/mnt/cache/appdata/netdata/config",
      "container": "/etc/netdata",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Netdata Cloud",
      "host": "/mnt/cache/appdata/netdata/cloud",
      "container": "/var/lib/netdata/cloud.d",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Netdata Cache",
      "host": "/mnt/cache/appdata/netdata/cache",
      "container": "/var/lib/cache/netdata",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Host /proc",
      "host": "/proc",
      "container": "/host/proc",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Host /sys",
      "host": "/sys",
      "container": "/host/sys",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "doker.sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Host group",
      "host": "/etc/group",
      "container": "/host/etc/group",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Host passwd",
      "host": "/etc/passwd",
      "container": "/host/etc/passwd",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Host OS",
      "host": "/etc/os-release",
      "container": "/host/etc/os-release",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Netdata Web UI Port",
      "host": "19999",
      "container": "19999",
      "protocol": "tcp",
      "description": "Netdata Web UI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Anonymous Statistics",
      "key": "DO_NOT_TRACK",
      "value": "",
      "description": "Set to 1 to disable anonymous statistics.",
      "required": false,
      "mask": false
    },
    {
      "name": "NETDATA_CLAIM_TOKEN",
      "key": "NETDATA_CLAIM_TOKEN",
      "value": "",
      "description": "See https://learn.netdata.cloud/docs/agent/claim#connect-an-agent-running-in-docker",
      "required": false,
      "mask": false
    },
    {
      "name": "NETDATA_CLAIM_URL",
      "key": "NETDATA_CLAIM_URL",
      "value": "https://app.netdata.cloud",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NETDATA_CLAIM_ROOMS",
      "key": "NETDATA_CLAIM_ROOMS",
      "value": "",
      "description": "See https://learn.netdata.cloud/docs/agent/claim#connect-an-agent-running-in-docker",
      "required": false,
      "mask": false
    },
    {
      "name": "Docker PGID",
      "key": "PGID",
      "value": "500",
      "description": "Host docker user gid. Required for container name resolution.",
      "required": true,
      "mask": false
    },
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": "Valid options: 0,1,2, GPU-fef8089b, all, none, void",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
