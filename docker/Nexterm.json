{
  "name": "Nexterm",
  "repo": "germannewsmaker/nexterm:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/germannewsmaker/nexterm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6989]",
  "icon": "https://raw.githubusercontent.com/tquizzle/Docker-xml/master/img/nexterm.png",
  "project": "https://docs.nexterm.dev/",
  "description": "Nexterm Server management The open-source server management software for SSH, VNC & RDP To generate the encryption key, you'll need to run the following in a terminal: openssl rand -hex 32 Modify the AI_SYSTEM_PROMPT at your leisure.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/nexterm",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6989",
      "container": "6989",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ENCRYPTION_KEY",
      "key": "ENCRYPTION_KEY",
      "value": "put that key here",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "AI_SYSTEM_PROMPT",
      "key": "AI_SYSTEM_PROMPT",
      "value": "You are an SSH next generation terminal.",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
