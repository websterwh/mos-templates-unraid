{
  "name": "TrackMania-EvoSC",
  "repo": "evoesports/evosc:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/evoesports/evosc",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/L4stIdi0t/Unraid-template/master/TrackMania2020-Server/logoTM.png",
  "project": "https://github.com/EvoEsports/EvoSC",
  "description": "A modern server controller for the game Trackmania (TM\u00b2, 2020). EvoSC for trackmania servers, default configuration is that it works with my trackmania2020 server template. Easiest way to make yourself admin for trackmania2020 is to join the server, then you login your database and go to the Players table. Then you change the 3 to 1 behind your username under group.",
  "paths": [
    {
      "name": "trackmania server",
      "host": "/mnt/cache/appdata/Trackmania2020Server/",
      "container": "/server/UserData",
      "mode": "rw",
      "description": "Container Path: /server/UserData",
      "required": true
    },
    {
      "name": "EvoSC Data",
      "host": "/mnt/cache/appdata/Trackmania2020Server/EvoSC/config/",
      "container": "/controller/config",
      "mode": "rw",
      "description": "Container Path: /controller/",
      "required": true
    },
    {
      "name": "EvoSC Data",
      "host": "/mnt/cache/appdata/Trackmania2020Server/EvoSC/modules",
      "container": "/controller/modules",
      "mode": "rw",
      "description": "Container Path: /controller/modules",
      "required": true
    },
    {
      "name": "EvoSc Data",
      "host": "/mnt/cache/appdata/Trackmania2020Server/EvoSC/cache",
      "container": "/controller/cache",
      "mode": "rw",
      "description": "Container Path: /controller/cache",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "MySQL / MariaDB DB_HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "",
      "description": "MySQL / MariaDB DB_NAME",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "",
      "description": "MySQL / MariaDB DB_USER",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "MySQL / MariaDB DB_PASSWORD",
      "required": true,
      "mask": true
    },
    {
      "name": "RPC_IP",
      "key": "RPC_IP",
      "value": "trackmania",
      "description": "TrackMania server IP",
      "required": true,
      "mask": false
    },
    {
      "name": "RPC_LOGIN",
      "key": "RPC_LOGIN",
      "value": "SuperAdmin",
      "description": "TrackMania server RPC_LOGIN, Default 'SuperAdmin'",
      "required": true,
      "mask": false
    },
    {
      "name": "RPC_PASSWORD",
      "key": "RPC_PASSWORD",
      "value": "SuperAdmin",
      "description": "TrackMania server RPC_PASSWORD, Default 'SuperAdmin'",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
