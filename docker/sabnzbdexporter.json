{
  "name": "sabnzbd_exporter",
  "repo": "msroest/sabnzbd_exporter",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/msroest/sabnzbd_exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9387]",
  "icon": "https://raw.githubusercontent.com/wupasscat/unraid-images/main/sabnzbd_exporter.png",
  "project": "https://github.com/msroest/sabnzbd_exporter",
  "description": "This is a metrics exporter for sending statistics from sabnzbd (https://sabnzbd.org/) to prometheus (http://prometheus.io).",
  "paths": [],
  "ports": [
    {
      "name": "Listen Port",
      "host": "9387",
      "container": "9387",
      "protocol": "tcp",
      "description": "Exporter port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Sabnzbd URL(s)",
      "key": "SABNZBD_BASEURLS",
      "value": "",
      "description": "example: http://192.168.1.100:8080/sabnzbd",
      "required": true,
      "mask": false
    },
    {
      "name": "Sabnzbd API key(s)",
      "key": "SABNZBD_APIKEYS",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
