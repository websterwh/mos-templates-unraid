{
  "name": "golang-kanban-sqlite",
  "repo": "ghcr.io/nicolashaas/golang-kanban:v2",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/NicolasHaas/golang-kanban",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user=99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:17808]",
  "icon": "https://github.com/NicolasHaas/unraid-xml-templates/blob/main/golang-kanban.jpg?raw=1",
  "project": "https://github.com/NicolasHaas/golang-kanban",
  "description": "No fancy features, it just works. Just a simple Kanban board made with Golang and HTMX, no nasty Node or Next.js. SQLite edition: no separate database server required.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/golang-kanban-sqlite",
      "container": "/data",
      "mode": "rw",
      "description": "SQLite data folder.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "17809",
      "container": "17808",
      "protocol": "tcp",
      "description": "Web UI port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "STORAGE",
      "key": "STORAGE",
      "value": "sqlite",
      "description": "Database backend.",
      "required": true,
      "mask": false
    },
    {
      "name": "SQLITE_PATH",
      "key": "SQLITE_PATH",
      "value": "/data/kanban.db",
      "description": "SQLite database file.",
      "required": true,
      "mask": false
    },
    {
      "name": "SERVER_PORT",
      "key": "SERVER_PORT",
      "value": "17808",
      "description": "Internal web port.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
