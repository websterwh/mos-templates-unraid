{
  "name": "bitcoind",
  "repo": "ghcr.io/anym001/docker-bitcoind:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/anym001/docker-bitcoind",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8332]",
  "icon": "https://raw.githubusercontent.com/anym001/unraid-docker-templates/main/anym001/images/bitcoin.png",
  "project": "https://github.com/bitcoin/bitcoin",
  "description": "Run your own Bitcoin node and contribute to the decentralization of the Bitcoin network! This template deploys a full bitcoind instance based on Bitcoin Core. (https://bitcoin.org) To allow other nodes to connect to your instance, make sure port 8333 on your router is forwarded to the container\u2019s P2P port configured below. For full customization, create a bitcoin.conf file inside the data directory. You can reference Bitcoin Core\u2019s example configuration for available options and advanced settings. Example: https://github.com/bitcoin/bitcoin/blob/master/share/examples/bitcoin.conf",
  "paths": [
    {
      "name": "Data Dir",
      "host": "/mnt/cache/bitcoin/bitcoind",
      "container": "/home/bitcoin/.bitcoin",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8332",
      "container": "8332",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "8333",
      "container": "8333",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DATA_PERM",
      "key": "DATA_PERM",
      "value": "2770",
      "description": "Permissions applied to the data directory.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
