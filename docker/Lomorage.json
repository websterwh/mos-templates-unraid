{
  "name": "Lomorage",
  "repo": "lomorage/amd64-lomorage",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/lomorage/amd64-lomorage",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user=99:100",
  "post_parameters": "8000",
  "web_ui_url": null,
  "icon": "https://lomorage.com/img/logo.png",
  "project": "https://github.com/lomorage/lomo-docker",
  "description": "Lomorage enables you to backup photos / videos from any devices to your self-hosted server, and intelligently manages these personal assets via AI. Run the Lomorage server at your home, download mobile client to save the memories, and enjoy the moments.",
  "paths": [
    {
      "name": "MediaDir",
      "host": "/mnt/cache/",
      "container": "/media",
      "mode": "rw",
      "description": "Volume to store photos, videos",
      "required": false
    },
    {
      "name": "AppDir",
      "host": "/mnt/cache/appdata/",
      "container": "/lomo",
      "mode": "rw",
      "description": "Volume for application configuration and logs",
      "required": false
    },
    {
      "name": "User",
      "host": "/etc/passwd",
      "container": "/etc/passwd",
      "mode": "ro",
      "description": "Container Path: /etc/passwd",
      "required": false
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
