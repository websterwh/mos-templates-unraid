{
  "name": "rotki",
  "repo": "rotki/rotki",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/rotki/rotki/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/rotki/rotki/develop/frontend/app/public/assets/images/rotkehlchen_no_text.png",
  "project": "https://github.com/rotki/rotki",
  "description": "Rotki is an open source portfolio tracking, analytics, accounting, and tax reporting tool that protects your privacy. The mission of rotki is to bring transparency into the crypto and financial sectors through the use of open source. Most importantly, unlike virtually every other competing service which consists of closed source SaaS onto which you are forced to hand over all your financial data, with rotki your data is stored encrypted locally in your computer. It enables you to take ownership of your financial data!",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/rotki/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/rotki/logs",
      "container": "/logs",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/rotki/config",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8282",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Loglevel",
      "key": "LOGLEVEL",
      "value": "debug",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
