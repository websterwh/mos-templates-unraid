{
  "name": "MUM",
  "repo": "ghcr.io/mrrobotjs/mum:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/mrrobotjs/mum",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/mum-icon.png",
  "project": "https://github.com/MrRobotjs/MUM",
  "description": "MUM (Multimedia User Management) is a powerful, self-hosted web application designed to centralize and simplify user management across a variety of media servers. Featuring a modular plugin system, MUM allows administrators to seamlessly manage users, invitations, and server access from a single, user-friendly interface.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/mum/data",
      "container": "/app/instance",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5699",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
