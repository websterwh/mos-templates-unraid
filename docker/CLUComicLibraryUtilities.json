{
  "name": "CLU-Comic-Library-Utilities",
  "repo": "allaboutduncan/comic-utils-web:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/allaboutduncan/comic-utils-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--log-opt max-size=20m --log-opt max-file=3",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5577]/",
  "icon": "https://raw.githubusercontent.com/allaboutduncan/clu-comics/refs/heads/main/images/clu-logo-360.png",
  "project": "https://github.com/allaboutduncan/clu-comics",
  "description": "Digital comic curation app to read, manage, edit, and update libraries of any size. Features: - Manage Comic Library - Folder Monitoring - Bulk Metadata Editing",
  "paths": [
    {
      "name": "Main Library",
      "host": "/mnt/cache/media/",
      "container": "/data",
      "mode": "rw",
      "description": "Map this to your main Comics library",
      "required": true
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/Downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "Optional: Map if you use folder monitoring.",
      "required": false
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/comic-library-utilities/config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Configuration files.",
      "required": true
    },
    {
      "name": "Cache",
      "host": "/mnt/cache/appdata/comic-library-utilities/cache",
      "container": "/cache",
      "mode": "rw",
      "description": "Storage for DB and thumbnails.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5577",
      "container": "5577",
      "protocol": "tcp",
      "description": "Main Web Interface",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Monitor",
      "key": "MONITOR",
      "value": "no",
      "description": "Set to 'yes' if you want to use folder monitoring.",
      "required": false,
      "mask": false
    },
    {
      "name": "Flask Env",
      "key": "FLASK_ENV",
      "value": "development",
      "description": "Flask Environment",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": "File creation mask. 000 -&gt; world-writable folders (drwxrwsrwx) and files (rw-rw-rw-). Use 002 for group-writable or 022 for owner-only.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
