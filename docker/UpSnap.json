{
  "name": "UpSnap",
  "repo": "ghcr.io/seriousm4x/upsnap:4",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/seriousm4x/UpSnap/pkgs/container/upsnap",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--http 0.0.0.0:8090",
  "web_ui_url": "http://[IP]:[PORT:8090]",
  "icon": "https://raw.githubusercontent.com/seriousm4x/unraid-community-apps/master/icons/upsnap.png",
  "project": "https://github.com/seriousm4x/UpSnap",
  "description": "A simple wake on lan web app written with SvelteKit, Go and PocketBase.",
  "paths": [
    {
      "name": "pb_data",
      "host": "/mnt/cache/appdata/upsnap/",
      "container": "/app/pb_data/",
      "mode": "rw",
      "description": "upsnap database",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/London",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
