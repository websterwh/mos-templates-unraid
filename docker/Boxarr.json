{
  "name": "Boxarr",
  "repo": "ghcr.io/iongpt/boxarr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/iongpt/boxarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8888]/",
  "icon": "https://raw.githubusercontent.com/tquizzle/Docker-xml/51d5f13416c4f9713e5f1dd38ac99ed134712728/img/boxarr.png",
  "project": "https://github.com/iongpt/boxarr",
  "description": "Boxarr solves the problem of keeping your media library current with popular movies without manual intervention. It automatically tracks what's trending at the box office and ensures your Radarr library has the movies people actually want to watch.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/boxarr",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TimeZone",
      "key": "TZ",
      "value": "YOUR TIMEZONE",
      "description": "Optional",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
