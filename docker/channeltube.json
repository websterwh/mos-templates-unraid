{
  "name": "channeltube",
  "repo": "thewicklowwolf/channeltube:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/thewicklowwolf/channeltube",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/TheWicklowWolf/ChannelTube/main/src/static/full_logo.png",
  "project": "https://github.com/TheWicklowWolf/ChannelTube",
  "description": "ChannelTube is a tool for synchronizing and fetching content from YouTube channels using yt-dlp.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/channeltube",
      "container": "/channeltube/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Video Download",
      "host": "/mnt/cache/channeltube/video",
      "container": "/channeltube/downloads",
      "mode": "rw",
      "description": "Set share where video downloads will be stored",
      "required": true
    },
    {
      "name": "Audio Downloads",
      "host": "/mnt/cache/channeltube/audio",
      "container": "/channeltube/audio_downloads",
      "mode": "rw",
      "description": "Set share where audio downloads will be stored",
      "required": true
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
