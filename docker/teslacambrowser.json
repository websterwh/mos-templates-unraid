{
  "name": "teslacam-browser",
  "repo": "theshulk/teslacam-browser",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/repository/docker/theshulk/teslacam-browser/general",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8088]/",
  "icon": "https://evbite.com/wp-content/uploads/2021/04/Tesla-Dashcam-Saved-Icon.png",
  "project": "https://github.com/BobStrogg/teslacam-browser",
  "description": "A Docker version of BobStrogg's TeslaCam Browser. Simply add the path to your TeslaCam videos and access the WebUI. GitHub repository located at https://github.com/BobStrogg/teslacam-browser",
  "paths": [
    {
      "name": "AppData Path",
      "host": "/mnt/cache/appdata/teslacam-browser",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Tesla Cam Path",
      "host": "",
      "container": "/media/TeslaCam",
      "mode": "rw",
      "description": "The path to your Tesla Cam clips",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port",
      "host": "8088",
      "container": "8088",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
