{
  "name": "Postgres12.5",
  "repo": "postgres:12.5-alpine",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/_/postgres/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://raw.githubusercontent.com/Flight777/unraid_justworks_templates/main/images/postgres/Postgresql_elephant.png",
  "project": "https://www.postgresql.org/",
  "description": "bPostgresql 12.5, alpine edition for less resource useage/b /br /br Unraid template that JUST WORKS, brought to you by Flight777!",
  "paths": [
    {
      "name": "Database Storage Path",
      "host": "/mnt/cache/appdata/dsmrdb/data/",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "This is where Postgres will store it's data.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Interface Port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "This is Postgres TCP connection port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "dsmrreader",
      "description": "Container Variable: POSTGRES_PASSWORD",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "dsmrreader",
      "description": "Container Variable: POSTGRES_USER",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "dsmrdb",
      "description": "Container Variable: POSTGRES_DB",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
