{
  "name": "Membarr",
  "repo": "yoruio/membarr",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/yoruio/membarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Yoruio/unraid-templates/master/membarr/icon.png",
  "project": "https://github.com/yoruio/membarr",
  "description": "Membarr is a discord bot that invites discord users to Plex and/or Jellyfin. Manually create users and invite server members with a single command, or let Membarr automatically add server members with a certain role.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/membarr/",
      "container": "/app/app/config",
      "mode": "rw",
      "description": "Config path (containing app.db and config.ini)",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Discord Bot Token",
      "key": "token",
      "value": "",
      "description": "Discord Bot Token",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
