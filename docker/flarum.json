{
  "name": "flarum",
  "repo": "crazymax/flarum:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/crazymax/flarum/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/flarum.png",
  "project": "https://flarum.org/",
  "description": "Flarum is the next-generation forum software that makes online discussion fun. It's simple, fast, and free. Default user/password User: flarum Password: flarum",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/flarum/",
      "container": "/data",
      "mode": "rw",
      "description": "Contains assets, extensions and storage",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "FLARUM_BASE_URL",
      "key": "FLARUM_BASE_URL",
      "value": "http://&lt;IP&gt;:8000",
      "description": "Make Sure the base url is right if it local use only use http://ip:8000 and if you are hosting it on your domain it should be http://example.com or https://example.com.",
      "required": false,
      "mask": false
    },
    {
      "name": "FLARUM_FORUM_TITLE",
      "key": "FLARUM_FORUM_TITLE",
      "value": "Flarum Dockerized",
      "description": "Flarum forum title, only used during first installation",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "MySQL database hostname / IP address required",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "3306",
      "description": "MySQL database port",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "flarum",
      "description": "MySQL database name",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "flarum",
      "description": "MySQL user",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "password",
      "description": "MySQL password",
      "required": false,
      "mask": false
    },
    {
      "name": "MEMORY_LIMIT",
      "key": "MEMORY_LIMIT",
      "value": "256M",
      "description": "PHP memory limit",
      "required": false,
      "mask": false
    },
    {
      "name": "UPLOAD_MAX_SIZE",
      "key": "UPLOAD_MAX_SIZE",
      "value": "16M",
      "description": "Upload max size",
      "required": false,
      "mask": false
    },
    {
      "name": "OPCACHE_MEM_SIZE",
      "key": "OPCACHE_MEM_SIZE",
      "value": "128",
      "description": "PHP OpCache memory consumption",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
