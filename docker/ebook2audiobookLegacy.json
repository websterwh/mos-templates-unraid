{
  "name": "ebook2audiobook---Legacy",
  "repo": "athomasson2/ebook2audiobookxtts:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/athomasson2/ebook2audiobookxtts",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--platform=linux/amd64",
  "post_parameters": "python app.py",
  "web_ui_url": "http://[IP]:[PORT:7860]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ebook-2-audiobook-icon.png",
  "project": "https://github.com/DrewThomasson/ebook2audiobook",
  "description": "This is a legacy version of ebook2audiobook. Please use the new version.",
  "paths": [
    {
      "name": "Temp Path",
      "host": "",
      "container": "/home/user/app/tmp",
      "mode": "rw",
      "description": "Path to temporary files.",
      "required": false
    },
    {
      "name": "Audiobooks Path",
      "host": "",
      "container": "/home/user/app/audiobooks",
      "mode": "rw",
      "description": "Path to audiobooks.",
      "required": false
    },
    {
      "name": "Models Path",
      "host": "",
      "container": "/home/user/app/models",
      "mode": "rw",
      "description": "Path to models. Warning, this can consume a large amount of space.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7860",
      "container": "7860",
      "protocol": "tcp",
      "description": "Container Port: 7860",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
