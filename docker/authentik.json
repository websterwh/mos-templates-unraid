{
  "name": "authentik",
  "repo": "ghcr.io/goauthentik/server:2025.8.1",
  "category": [
    "Security"
  ],
  "registry": "https://github.com/goauthentik/authentik/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": "server",
  "web_ui_url": "http://[IP]:[PORT:9000]",
  "icon": "https://raw.githubusercontent.com/ibracorp/app-logos/main/authentik/authentik.png",
  "project": "https://github.com/goauthentik/authentik",
  "description": "authentik is an open-source Identity Provider focused on flexibility and versatility. You can use authentik in an existing environment to add support for new protocols, implement sign-up/recovery/etc. in your application so you don't have to deal with it, and many other things. You will need the authentik-worker app. To start the initial setup, navigate to http://your-server-ip:9000/if/flow/initial-setup/. There you will be prompted to set a password for the akadmin user.",
  "paths": [
    {
      "name": "Custom Templates",
      "host": "",
      "container": "/templates",
      "mode": "rw",
      "description": "Container Path: /templates",
      "required": false
    },
    {
      "name": "Docker Socket",
      "host": "",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Container Path: /var/run/docker.sock",
      "required": false
    },
    {
      "name": "media",
      "host": "",
      "container": "/media",
      "mode": "rw",
      "description": "Container Path: /media",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "AUTHENTIK_PORT_HTTP",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Container Port: 9000",
      "required": true,
      "mask": false
    },
    {
      "name": "AUTHENTIK_PORT_HTTPS",
      "host": "9443",
      "container": "9443",
      "protocol": "tcp",
      "description": "Container Port: 9443",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Redis Host",
      "key": "AUTHENTIK_REDIS__HOST",
      "value": "redis",
      "description": "Container Variable: AUTHENTIK_REDIS__HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL Host",
      "key": "AUTHENTIK_POSTGRESQL__HOST",
      "value": "postgresql",
      "description": "Container Variable: AUTHENTIK_POSTGRESQL__HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL DB User",
      "key": "AUTHENTIK_POSTGRESQL__USER",
      "value": "authentik",
      "description": "Container Variable: AUTHENTIK_POSTGRESQL__USER",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL DB Name",
      "key": "AUTHENTIK_POSTGRESQL__NAME",
      "value": "authentik",
      "description": "Container Variable: AUTHENTIK_POSTGRESQL__NAME",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL DB Password",
      "key": "AUTHENTIK_POSTGRESQL__PASSWORD",
      "value": "",
      "description": "Container Variable: AUTHENTIK_POSTGRESQL__PASSWORD",
      "required": true,
      "mask": true
    },
    {
      "name": "Error Reporting",
      "key": "AUTHENTIK_ERROR_REPORTING__ENABLED",
      "value": "true",
      "description": "Container Variable: AUTHENTIK_ERROR_REPORTING__ENABLED: true or false",
      "required": false,
      "mask": false
    },
    {
      "name": "APP Key",
      "key": "AUTHENTIK_SECRET_KEY",
      "value": "",
      "description": "https://passwordsgenerator.net/",
      "required": true,
      "mask": true
    },
    {
      "name": "Redis Password",
      "key": "AUTHENTIK_REDIS__PASSWORD",
      "value": "",
      "description": "Container Variable: AUTHENTIK_REDIS__PASSWORD",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
