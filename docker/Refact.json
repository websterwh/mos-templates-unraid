{
  "name": "Refact",
  "repo": "smallcloud/refact_self_hosting",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/smallcloud/refact_self_hosting/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8008]/",
  "icon": "https://i.imgur.com/Q6SEUki.png",
  "project": "https://refact.ai",
  "description": "Refact WebUI for fine-tuning and self-hosting of code models, that you can later use inside Refact plugins for code completion and chat.",
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/refact",
      "container": "/perm_storage",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Interface",
      "host": "8008",
      "container": "8008",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
