{
  "name": "Fileflows-Forge",
  "repo": "revenz/fileflows-forge",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/revenz/fileflows/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:19201]",
  "icon": "https://raw.githubusercontent.com/revenz/FileFlowsUnraid/master/icon.png?raw=true",
  "project": "https://fileflows.com/",
  "description": "Additinal processing forge node for FileFlows. See http://fileflows.com for more information",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/appdata/fileflows-forge",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Connect",
      "host": "19201",
      "container": "19201",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/London",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
