{
  "name": "gotify",
  "repo": "gotify/server:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/gotify/server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/gotify.png",
  "project": "https://gotify.net/",
  "description": "A simple server for sending and receiving messages. Default user/password User: admin Password: admin Download config.yml mkdir -p /mnt/user/appdata/gotify/config/ wget -O /mnt/user/appdata/gotify/config/config.yml https://raw.githubusercontent.com/gotify/server/master/config.example.yml",
  "paths": [
    {
      "name": "Path 1",
      "host": "/mnt/cache/appdata/gotify/",
      "container": "/app/data",
      "mode": "rw",
      "description": "/app/data",
      "required": true
    },
    {
      "name": "Path 2",
      "host": "/mnt/cache/appdata/gotify/config/",
      "container": "/etc/gotify",
      "mode": "rw",
      "description": "/etc/gotify",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8070",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Default User Password",
      "key": "GOTIFY_DEFAULTUSER_PASS",
      "value": "admin",
      "description": "Default User Password",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
