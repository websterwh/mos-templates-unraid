{
  "name": "Pelican-Panel",
  "repo": "ghcr.io/pelican-dev/panel:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://ghcr.io/pelican-dev/panel",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/Mainfrezzer/UnRaid-Templates/main/icon/pelican.png",
  "project": "https://github.com/pelican-dev/",
  "description": "Pelican is a free, open-source game server management panel built with PHP, React, and Go. Designed with security in mind, Pelican runs all game servers in isolated Docker containers while exposing a beautiful and intuitive UI to end users.",
  "paths": [
    {
      "name": "Pelican-Data",
      "host": "/mnt/cache/appdata/pelican-panel/pelican-data",
      "container": "/pelican-data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Pelican-Logs",
      "host": "/mnt/cache/appdata/pelican-panel/pelican-log",
      "container": "/var/www/html/storage/logs",
      "mode": "rw",
      "description": "All the logs of pelican panel.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebHttp",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Http port for the web server",
      "required": true,
      "mask": false
    },
    {
      "name": "WebHttps",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Https port for the web server",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "App Url",
      "key": "APP_URL",
      "value": "http://192.168.0.5",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Lets Encrypt Email",
      "key": "LE_EMAIL",
      "value": "admin@example.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Behind Proxy",
      "key": "BEHIND_PROXY",
      "value": "false",
      "description": "Setting this to true removes the need for a custom caddyfile",
      "required": false,
      "mask": false
    },
    {
      "name": "Skip Caddy",
      "key": "SKIP_CADDY",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "APP_ENV",
      "key": "APP_ENV",
      "value": "production",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "XDG",
      "key": "XDG_DATA_HOME",
      "value": "/pelican-data",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
