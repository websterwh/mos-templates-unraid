{
  "name": "PeaNUT",
  "repo": "brandawg93/peanut",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/brandawg93/peanut",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/peanut-icon.png",
  "project": "https://github.com/Brandawg93/PeaNUT",
  "description": "A Tiny Dashboard for Network UPS Tools",
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NUT Server Host",
      "key": "NUT_HOST",
      "value": "",
      "description": "Hostname or IP of the NUT server",
      "required": true,
      "mask": false
    },
    {
      "name": "NUT Server Port",
      "key": "NUT_PORT",
      "value": "3493",
      "description": "Port of the NUT server",
      "required": true,
      "mask": false
    },
    {
      "name": "NUT Username",
      "key": "USERNAME",
      "value": "",
      "description": "Username for the NUT server",
      "required": false,
      "mask": false
    },
    {
      "name": "NUT Password",
      "key": "PASSWORD",
      "value": "",
      "description": "Password for the NUT server",
      "required": false,
      "mask": true
    },
    {
      "name": "Web Host",
      "key": "WEB_HOST",
      "value": "0.0.0.0",
      "description": "Hostname of web server",
      "required": true,
      "mask": false
    },
    {
      "name": "Web Port",
      "key": "WEB_PORT",
      "value": "8080",
      "description": "Port of web server. Changing will break default Web UI mapping.",
      "required": true,
      "mask": false
    },
    {
      "name": "Web Path",
      "key": "BASE_PATH",
      "value": "",
      "description": "Base path of web server for reverse proxy",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
