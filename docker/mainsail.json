{
  "name": "mainsail",
  "repo": "ghcr.io/mainsail-crew/mainsail",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/mainsail-crew/mainsail",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/mainsail-crew/docs/master/assets/img/logo.png",
  "project": "https://github.com/mainsail-crew/mainsail",
  "description": "Mainsail makes Klipper more accessible by adding a lightweight, responsive web user interface, centred around an intuitive and consistent design philosophy. Download config.json BEFORE you start your container https://raw.githubusercontent.com/patrickstigler/Unraid_app_templates/main/mainsail/config.json And put it in your config folder, the default is /mnt/user/appdata/mainsail/config.json Happy printing",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/mainsail/config.json",
      "container": "/usr/share/nginx/html/config.json",
      "mode": "rw",
      "description": "Container Path: /usr/share/nginx/html/config.json",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8099",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
