{
  "name": "Unsloth-Studio",
  "repo": "unsloth/unsloth",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/unsloth/unsloth",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://www.gravatar.com/avatar/a45c6f674175d3ee880235a68b2cbf78?s=120&r=g&d=404",
  "project": "https://github.com/unslothai/unsloth",
  "description": "Unsloth is an open-source web UI for running and training models.",
  "paths": [
    {
      "name": "HF Cache",
      "host": "/mnt/cache/appdata/unsloth-studio/cache",
      "container": "/data/studio/cache",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Exports",
      "host": "/mnt/cache/appdata/unsloth-studio/exports",
      "container": "/data/studio/exports",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Auth",
      "host": "/mnt/cache/appdata/unsloth-studio/auth",
      "container": "/data/studio/auth",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Output",
      "host": "/mnt/cache/appdata/unsloth-studio/outputs/",
      "container": "/data/studio/outputs",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Studio Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Jupyter Lab",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "SSH access",
      "host": "22222",
      "container": "22",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "JUPYTER_PASSWORD",
      "key": "JUPYTER_PASSWORD",
      "value": "unsloth",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "JUPYTER_PORT",
      "key": "JUPYTER_PORT",
      "value": "8888",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "USER_PASSWORD",
      "key": "USER_PASSWORD",
      "value": "unsloth",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "SSH_KEY",
      "key": "SSH_KEY",
      "value": "",
      "description": "SSH public key for authentication",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
