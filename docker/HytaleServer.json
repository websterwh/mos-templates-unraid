{
  "name": "Hytale-Server",
  "repo": "indifferentbroccoli/hytale-server-docker",
  "category": [
    "Game Server"
  ],
  "registry": "https://github.com/donkevlar/hytale-server-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5520]",
  "icon": "https://donkevlar.github.io/hytale-server-docker/images/icon.png",
  "project": "https://github.com/indifferentbroccoli/hytale-server-docker",
  "description": "A Docker container for running a Hytale dedicated server with automatic downloading and updates using the official Hytale Downloader CLI. Originally forked from indifferentbroccoli. For the full guide, please visit the original project repository Note: If you are having issues with initially connecting to the server, please ensure USE_AOT_CACHE is set to false. The newest version of the template has made this the default behaviour.",
  "paths": [
    {
      "name": "Server Directory",
      "host": "/mnt/cache/appdata/hytale-server/server-files",
      "container": "/home/hytale/server-files",
      "mode": "rw",
      "description": "path for storing server data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Server PORT",
      "host": "5520",
      "container": "5520",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SERVER NAME",
      "key": "SERVER_NAME",
      "value": "Hytale Server",
      "description": "Server Name",
      "required": true,
      "mask": false
    },
    {
      "name": "MAX PLAYERS",
      "key": "MAX_PLAYERS",
      "value": "20",
      "description": "Max number of players in a given server",
      "required": false,
      "mask": false
    },
    {
      "name": "Max Memory",
      "key": "MAX_MEMORY",
      "value": "8G",
      "description": "Maximum JVM heap size (e.g., 8G, 8192M)",
      "required": false,
      "mask": false
    },
    {
      "name": "JVM Arguments",
      "key": "JVM_ARGS",
      "value": "",
      "description": "Custom JVM arguments (optional)",
      "required": false,
      "mask": false
    },
    {
      "name": "Download on Start",
      "key": "DOWNLOAD_ON_START",
      "value": "true",
      "description": "Automatically download/update server files on startup",
      "required": false,
      "mask": false
    },
    {
      "name": "AOT Cache",
      "key": "USE_AOT_CACHE",
      "value": "false",
      "description": "Use Ahead-of-Time compilation cache for faster startup",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
