{
  "name": "ApacheGuacamoleNoMariaDB",
  "repo": "jasonbean/guacamole:latest-nomariadb",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/jasonbean/guacamole/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://i.imgur.com/eflpez4.png",
  "project": "https://guacamole.apache.org/",
  "description": "[h3]Apache Guacamole[/h3]Apache Guacamole is a clientless remote desktop gateway. It supports standard protocols like VNC and RDP. Note: This version comes without MariaDB and requires some external database source or to use the default authentication. Directions: Be sure to change the Host port from 8080 to something else as 8080 is quite a common port. /config : this path is where Apache Guacamole will store it's properties files, extensions, and the database which contains data for users and connections. Initial username and password are guacadmin",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/ApacheGuacamole",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OPT_MYSQL",
      "key": "OPT_MYSQL",
      "value": "Y",
      "description": "Container Variable: OPT_MYSQL",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_SQLSERVER",
      "key": "OPT_SQLSERVER",
      "value": "N",
      "description": "Container Variable: OPT_SQLSERVER",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_OPENID",
      "key": "OPT_OPENID",
      "value": "N",
      "description": "Container Variable: OPT_OPENID",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_LDAP",
      "key": "OPT_LDAP",
      "value": "N",
      "description": "Container Variable: OPT_LDAP",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_DUO",
      "key": "OPT_DUO",
      "value": "N",
      "description": "Container Variable: OPT_DUO",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_CAS",
      "key": "OPT_CAS",
      "value": "N",
      "description": "Container Variable: OPT_CAS",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_TOTP",
      "key": "OPT_TOTP",
      "value": "N",
      "description": "Container Variable: OPT_TOTP",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_QUICKCONNECT",
      "key": "OPT_QUICKCONNECT",
      "value": "N",
      "description": "Container Variable: OPT_QUICKCONNECT",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_HEADER",
      "key": "OPT_HEADER",
      "value": "N",
      "description": "Container Variable: OPT_HEADER",
      "required": false,
      "mask": false
    },
    {
      "name": "OPT_SAML",
      "key": "OPT_SAML",
      "value": "N",
      "description": "Container Variable: OPT_SAML",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
