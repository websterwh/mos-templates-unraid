      "required": false,
      "mask": true
    },
    {
      "name": "DashScope API key",
      "key": "DASHSCOPE_API_KEY",
      "value": "",
      "description": "Alibaba DashScope API key.",
      "required": false,
      "mask": true
    },
    {
      "name": "DeepSeek API key",
      "key": "DEEPSEEK_API_KEY",
      "value": "",
      "description": "DeepSeek API key.",
      "required": false,
      "mask": true
    },
    {
      "name": "OpenCode Zen API key",
      "key": "OPENCODE_ZEN_API_KEY",
      "value": "",
      "description": "OpenCode Zen API key.",
      "required": false,
      "mask": true
    },
    {
      "name": "OpenCode Go API key",
      "key": "OPENCODE_GO_API_KEY",
      "value": "",
      "description": "OpenCode Go API key.",
      "required": false,
      "mask": true
    },
    {
      "name": "Tavily API key",
      "key": "TAVILY_API_KEY",
      "value": "",
      "description": "Tavily API key for AI-native web search, extract, and crawl.",
      "required": false,
      "mask": true
    },
    {
      "name": "Exa API key",
      "key": "EXA_API_KEY",
      "value": "",
      "description": "Exa API key for AI-native web search and content retrieval.",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
