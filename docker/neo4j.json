{
  "name": "neo4j",
  "repo": "neo4j",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/_/neo4j/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7474]/",
  "icon": "https://raw.githubusercontent.com/Data-Monkey/docker-templates/master/Data-Monkey/img/neo4j.png",
  "project": "https://neo4j.com/",
  "description": "Neo4j is a highly scalable, robust native graph database.",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/neo4j/data/",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "7474",
      "container": "7474",
      "protocol": "tcp",
      "description": "WebUI HTTP Port",
      "required": false,
      "mask": false
    },
    {
      "name": "Bolt",
      "host": "7687",
      "container": "7687",
      "protocol": "tcp",
      "description": "Bolt access to the Neo4j API",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NEO4J_AUTH",
      "key": "NEO4J_AUTH",
      "value": "none",
      "description": "Container Variable: NEO4J_AUTH",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
