{
  "name": "redis",
  "repo": "bitnamisecure/redis:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/bitnamisecure/redis/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6379]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/redis.png",
  "project": "https://redis.io/",
  "description": "Redis is an open source (BSD licensed), in-memory data structure store, used as a database, cache and message broker.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/redis",
      "container": "/bitnami/redis",
      "mode": "rw",
      "description": "Appdata folder for database persistence. Remove if unneeded",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Redis Port",
      "host": "6379",
      "container": "6379",
      "protocol": "tcp",
      "description": "Redis Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ALLOW_EMPTY_PASSWORD",
      "key": "ALLOW_EMPTY_PASSWORD",
      "value": "yes",
      "description": "ALLOW_EMPTY_PASSWORD",
      "required": true,
      "mask": false
    },
    {
      "name": "Password",
      "key": "REDIS_PASSWORD",
      "value": "941378",
      "description": "If you want password put ALLOW_EMPTY_PASSWORD to no, then put the password here.",
      "required": false,
      "mask": false
    },
    {
      "name": "Redis Extra Flags",
      "key": "REDIS_EXTRA_FLAGS",
      "value": "--auto-aof-rewrite-percentage 100 --auto-aof-rewrite-min-size 64mb",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
