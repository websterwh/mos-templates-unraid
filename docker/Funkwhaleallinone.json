{
  "name": "Funkwhale-all-in-one",
  "repo": "funkwhale/all-in-one:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/funkwhale/all-in-one/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/thetarkus/docker-templates/master/images/funkwhale-logo-500.png",
  "project": "https://funkwhale.audio/",
  "description": "Funkwhale is a community-driven project that lets you listen and share music and audio within a decentralised, open network. This is an alternative Docker image you can use to deploy Funkwhale, that does not follow the \"one process per container\" philosophy. This one contains Postgres, Redis, Nginx and all the needed files and configuration to start a dockerized Funkwhale instance in a single container. To create admin account, run command \"sudo docker exec -it Funkwhale-all-in-one manage createsuperuser\"",
  "paths": [
    {
      "name": "Music Path",
      "host": "",
      "container": "/music",
      "mode": "ro",
      "description": "Container Path: /music",
      "required": true
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/funkwhale",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "3030",
      "container": "80",
      "protocol": "tcp",
      "description": "Container port 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Funkwhale Hostname",
      "key": "FUNKWHALE_HOSTNAME",
      "value": "",
      "description": "Container Variable: FUNKWHALE_HOSTNAME",
      "required": true,
      "mask": false
    },
    {
      "name": "Nested Proxy",
      "key": "NESTED_PROXY",
      "value": "0",
      "description": "Container Variable: NESTED_PROXY | Set to '1' when container is behind a reverse proxy.",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
