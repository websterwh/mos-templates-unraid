{
  "name": "ChromaDB",
  "repo": "docker.io/chromadb/chroma:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://registry.hub.docker.com",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/realitymolder/odysseus-ca-templates/main/templates/img/chromadb.svg",
  "project": "https://github.com/chroma-core/chroma",
  "description": "Vector database for AI applications with persistent embeddings storage. Compatible with Odysseus AI workspace.",
  "paths": [
    {
      "name": "Chroma Data",
      "host": "/mnt/cache/appdata/chromadb",
      "container": "/chroma/chroma",
      "mode": "rw",
      "description": "ChromaDB persistent data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "ChromaDB Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "ChromaDB API port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Telemetry",
      "key": "ANONYMIZED_TELEMETRY",
      "value": "FALSE",
      "description": "Disable telemetry",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
