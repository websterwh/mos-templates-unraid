{
  "name": "Epic-Games-Free-Games",
  "repo": "ghcr.io/claabs/epicgames-freegames-node:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/claabs/epicgames-freegames-node",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "-m 2g",
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/epicgames-freegames-icon.png",
  "project": "https://github.com/claabs/epicgames-freegames-node",
  "description": "Automatically login and find available free games the Epic Games Store. Sends you a prepopulated checkout link so you can complete the checkout after logging in. Supports multiple accounts, login sessions, and scheduled runs.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/auto-archiver/config",
      "container": "/usr/app/config",
      "mode": "rw",
      "description": "Path to the configuration folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
