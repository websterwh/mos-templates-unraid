{
  "name": "pia-wireguard",
  "repo": "thrnz/docker-wireguard-pia",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/thrnz/docker-wireguard-pia",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": null,
  "project": "https://github.com/thrnz/docker-wireguard-pia",
  "description": "A Docker container for using WireGuard with PIA. Can output the wiregard conf file to a directory",
  "paths": [
    {
      "name": "Conf file output directory",
      "host": "/mnt/cache/appdata/pia-wireguard",
      "container": "/etc/wireguard",
      "mode": "rw",
      "description": "Location where your wireguard conf file is being saved.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Server",
      "key": "LOC",
      "value": "",
      "description": "The location to use for your config. Can be found in https://serverlist.piaservers.net/vpninfo/servers/v6",
      "required": true,
      "mask": false
    },
    {
      "name": "PIA User Name",
      "key": "USER",
      "value": "",
      "description": "Set your PIA User Name",
      "required": true,
      "mask": false
    },
    {
      "name": "PIA Password",
      "key": "PASS",
      "value": "",
      "description": "Set your PIA Password",
      "required": true,
      "mask": false
    },
    {
      "name": "Port file",
      "key": "PORT_FILE",
      "value": "/mnt/user/appdata/pia-wg/port.dat",
      "description": "Also can request a port forward. Will save this port here.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
