{
  "name": "FFmpeg-mkvdts2ac3",
  "repo": "snoopy86/ffmpeg",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/snoopy86/ffmpeg",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/devdems/unraid/master/docker-repo/images/FFmpeg.png",
  "project": null,
  "description": "A Docker container designed to watch a directory and encode media files.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/ffmpeg",
      "container": "/config",
      "mode": "rw",
      "description": "Config",
      "required": true
    },
    {
      "name": "Watch",
      "host": "",
      "container": "/watch",
      "mode": "rw",
      "description": "Watch",
      "required": true
    },
    {
      "name": "Output",
      "host": "",
      "container": "/output",
      "mode": "rw",
      "description": "Output",
      "required": true
    },
    {
      "name": "Copy",
      "host": "",
      "container": "/copy",
      "mode": "rw",
      "description": "Copy",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Script to be executed",
      "key": "script",
      "value": "encode.sh",
      "description": "encode.sh or mkvdts2ac3.sh",
      "required": true,
      "mask": false
    },
    {
      "name": "Parameters",
      "key": "parameters",
      "value": "-map 0;-vcodec copy;-scodec copy;-acodec ac3;-b:a 640k",
      "description": "Parameters for FFmpeg",
      "required": false,
      "mask": false
    },
    {
      "name": "Output format",
      "key": "output_format",
      "value": "mkv",
      "description": "Format of output file.",
      "required": false,
      "mask": false
    },
    {
      "name": "mkvdts2ac3 parameters",
      "key": "mkvdts2ac3_params",
      "value": "--compress none;-d;-n;-w /output;--new",
      "description": "Parameters for mkvdts2ac3",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
