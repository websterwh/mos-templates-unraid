{
  "name": "Lab-Dash",
  "repo": "ghcr.io/anthonygress/lab-dash:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/anthonygress/lab-dash",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2022]/",
  "icon": "https://raw.githubusercontent.com/AnthonyGress/lab-dash/refs/heads/main/frontend/src/assets/gradient_logo.png",
  "project": "https://github.com/AnthonyGress/lab-dash",
  "description": "An open-source user interface designed to manage your server/homelab applications and services.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/lab-dash/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true
    },
    {
      "name": "Uploads Path",
      "host": "/mnt/cache/appdata/lab-dash/uploads",
      "container": "/app/public/uploads",
      "mode": "rw",
      "description": "Path to the uploads folder",
      "required": true
    },
    {
      "name": "System Path",
      "host": "/sys",
      "container": "/sys",
      "mode": "ro",
      "description": "Path to the system folder",
      "required": true
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "2022",
      "container": "2022",
      "protocol": "tcp",
      "description": "Container Port: 2022",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "SECRET",
      "value": "",
      "description": "Generate with 'openssl rand -base64 32'",
      "required": true,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID (Unraid: 99 = nobody)",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID (Unraid: 100 = users)",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
