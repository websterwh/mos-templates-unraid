{
  "name": "prometheus-immich-exporter",
  "repo": "friendlyfriend/prometheus-immich-exporter",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/friendlyfriend/prometheus-immich-exporter/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
