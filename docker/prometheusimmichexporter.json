  "project": "https://github.com/friendlyFriend4000/prometheus-immich-exporter",
  "description": "A simple prometheus exporter for immich to display its metrics in grafana",
  "paths": [],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8028",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "immich api token",
      "key": "IMMICH_API_TOKEN",
      "value": "",
      "description": "You need to log into to your immich admin account and create an api token in your settings",
      "required": false,
      "mask": false
    },
    {
      "name": "immich_host",
      "key": "IMMICH_HOST",
      "value": "",
      "description": "example: 192.168.178.2",
      "required": false,
      "mask": false
    },
    {
      "name": "immich port",
      "key": "IMMICH_PORT",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
