{
  "name": "Scraperr",
  "repo": "jpyles0524/scraperr:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/jpyles0524/scraperr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "npm run start",
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/scraperr-icon.png",
  "project": "https://github.com/jaypyles/Scraperr",
  "description": "A self-hosted web application that allows users to scrape data from web pages by specifying elements via XPath. Users can submit URLs and the corresponding elements to be scraped, and the results will be displayed in a table.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API URL",
      "key": "NEXT_PUBLIC_API_URL",
      "value": "http://IP_ADDRESS:8000",
      "description": "URL of the Scraperr API instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Statistics API URL",
      "key": "SERVER_URL",
      "value": "http://IP_ADDRESS:8000",
      "description": "URL of the Scraperr API instance",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
