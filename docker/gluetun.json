{
  "name": "gluetun",
  "repo": "qmcgaw/gluetun:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/qmcgaw/gluetun",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN --device /dev/net/tun:/dev/net/tun",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/gluetun.png",
  "project": "https://github.com/passteque/gluetun",
  "description": "VPN swiss-knife like client to tunnel to multiple VPN servers. VPN client in a thin Docker container for multiple VPN providers, written in Go, and using OpenVPN or Wireguard, DNS over TLS, with a few proxy servers built-in.",
  "paths": [
    {
      "name": "Appdata Directory",
      "host": "/mnt/cache/appdata/gluetun",
      "container": "/gluetun",
      "mode": "rw",
      "description": "Where Gluetun stores its configuration.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Control Server Port",
      "host": "8015",
      "container": "8000",
      "protocol": "tcp",
      "description": "WebUI / Control Server",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTP Proxy Port",
      "host": "8885",
      "container": "8888",
      "protocol": "tcp",
      "description": "HTTP proxy",
      "required": false,
      "mask": false
