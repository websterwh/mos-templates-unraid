{
  "name": "quant-ux-frontend",
  "repo": "bmcgonag/qux-fe",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/bmcgonag/qux-fe/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8082]",
  "icon": "https://i.imgur.com/jjSgyHO.png",
  "project": "https://github.com/KlausSchaefers/quant-ux",
  "description": "Front End for the Quant UX Project. Quant UX is a research, usability and prototyping tool to quickly test your designs and get data driven insights. You will need the quant-ux-backend for this to work.",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "8082",
      "container": "8082",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Quant UX Backend",
      "key": "QUX_PROXY_URL",
      "value": "http://server-ip:8383",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
