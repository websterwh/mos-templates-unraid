{
  "name": "FFmpeg_Malin",
  "repo": "sftpmalin/ffmpeg:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/sftpmalin/ffmpeg",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:60022]",
  "icon": "https://raw.githubusercontent.com/sftpmalin/Media-Remote-Convert/main/logo/sftpmalin1.png",
  "project": "https://hub.docker.com/r/sftpmalin/ffmpeg",
  "description": "FFmpeg_Malin est un conteneur FFmpeg + SSH/SFTP enti\u00e8rement automatis\u00e9 et pr\u00eat \u00e0 l\u2019emploi. Fonctionnalit\u00e9s principales : - G\u00e9n\u00e9ration automatique des cl\u00e9s SSH persistantes - Cr\u00e9ation des utilisateurs via users.conf (auto ou manuel) - Permissions Linux s\u00e9curis\u00e9es et strictes - Dossier /data/home utilis\u00e9 pour les transferts SFTP - FFmpeg GPU-ready (NVENC / VAAPI si support mat\u00e9riel) - Aucun r\u00e9glage obligatoire : installez \u2192 connectez-vous \u2192 encodez Pour les options avanc\u00e9es (SSH, multi-utilisateur, scripts, gestion UID/GID\u2026) consultez la documentation compl\u00e8te sur la page GitHub du projet.",
  "paths": [
    {
      "name": "Donn\u00e9es et Configuration",
      "host": "/mnt/cache/appdata/ffmpeg_malin/",
      "container": "/data",
      "mode": "rw",
      "description": "Dossier de configuration, cl\u00e9s et home",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "FFmpeg SSH",
      "host": "60022",
      "container": "22",
      "protocol": "tcp",
      "description": "Port SSH/SFTP du conteneur",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Paris",
      "description": "Fuseau horaire",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "ID utilisateur (Unraid : nobody=99)",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "ID groupe (Unraid : users=100)",
      "required": false,
      "mask": false
    },
    {
      "name": "Cl\u00e9 SSH",
      "key": "KEY_VAR",
      "value": "3072",
      "description": "Taille de la cl\u00e9 SSH g\u00e9n\u00e9r\u00e9e automatiquement. Valeurs possibles : 4096 3072 2048 Ed25519",
      "required": false,
      "mask": false
    },
    {
      "name": "Utilisateur 1",
      "key": "USERS_VAR1",
      "value": "user1:0000:1000:100",
      "description": "Format : username:password:UID:GID",
      "required": false,
      "mask": false
    },
    {
      "name": "Utilisateur 2",
      "key": "USERS_VAR2",
      "value": "user2:0000:1001:100",
      "description": "Format : username:password:UID:GID",
      "required": false,
      "mask": false
    },
    {
      "name": "Utilisateur 3",
      "key": "USERS_VAR3",
      "value": "user3:0000:1002:100",
      "description": "Format : username:password:UID:GID",
      "required": false,
      "mask": false
    },
    {
      "name": "Utilisateur 4",
      "key": "USERS_VAR4",
      "value": "user4:0000:1003:100",
      "description": "Format : username:password:UID:GID",
      "required": false,
      "mask": false
    },
    {
      "name": "Utilisateur 5",
      "key": "USERS_VAR5",
      "value": "user5:0000:1004:100",
      "description": "Format : username:password:UID:GID",
      "required": false,
      "mask": false
    },
    {
      "name": "Utilisateur 6",
      "key": "USERS_VAR6",
      "value": "user6:0000:1005:100",
      "description": "Format : username:password:UID:GID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
