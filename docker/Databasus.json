{
  "name": "Databasus",
  "repo": "databasus/databasus:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/databasus/databasus",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4005]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/databasus-icon.png",
  "project": "https://databasus.com/",
  "description": "Databasus is a free, open source and self-hosted tool to backup databases. Make backups with different storages (S3, Google Drive, FTP, etc.) and notifications about progress (Slack, Discord, Telegram, etc.). Previously known as Postgresus.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/databasus/data",
      "container": "/databasus-data",
      "mode": "rw",
      "description": "Path to app data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4005",
      "container": "4005",
      "protocol": "tcp",
      "description": "Container Port: 4005",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
