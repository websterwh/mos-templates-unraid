{
  "name": "homeassistant",
  "repo": "lscr.io/linuxserver/homeassistant",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/homeassistant",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8123]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/homeassistant-logo.png",
  "project": "https://www.home-assistant.io/",
  "description": "Home Assistant Core(https://www.home-assistant.io/) - Open source home automation that puts local control and privacy first. Powered by a worldwide community of tinkerers and DIY enthusiasts. Perfect to run on a Raspberry Pi or a local server",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Home Assistant config storage path.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port: 8123",
      "host": "8123",
      "container": "8123",
      "protocol": "tcp",
      "description": "Application WebUI, only use this if you are not using host mode.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "/path/to/device",
      "host": "/path/to/device",
      "container": "",
      "description": "For passing through USB, serial or gpio devices.",
      "required": false
    }
  ],
  "labels": []
}
