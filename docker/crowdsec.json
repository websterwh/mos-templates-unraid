{
  "name": "crowdsec",
  "repo": "crowdsecurity/crowdsec",
  "category": [
    "Security"
  ],
  "registry": "https://registry.hub.docker.com/r/crowdsecurity/crowdsec",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/ibracorp/app-logos/main/crowdsec/crowdsec.png",
  "project": "https://crowdsec.net/",
  "description": "CrowdSec is a free, open-source and collaborative IPS. Analyze behaviors, respond to attacks and share signals across the community. If using Traefik, you should also install the traefik-bouncer. See our instructions on CrowdSec here: https://docs.ibracorp.io",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/crowdsec/data/",
      "container": "/var/lib/crowdsec/data",
      "mode": "rw",
      "description": "Container Path: /var/lib/crowdsec/data",
      "required": false
    },
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/crowdsec/",
      "container": "/etc/crowdsec",
      "mode": "rw",
      "description": "Container Path: /etc/crowdsec",
      "required": false
    },
    {
      "name": "auth logs to analyze",
      "host": "/mnt/cache/dmz/crowdsec/auth/",
      "container": "/var/log/auth.log",
      "mode": "rw",
      "description": "Container Path: /var/log/auth.log",
      "required": false
    },
    {
      "name": "crowdsec logs to analyze",
      "host": "/mnt/cache/dmz/crowdsec/",
      "container": "/var/log/crowdsec",
      "mode": "rw",
      "description": "Container Path: /var/log/crowdsec",
      "required": false
    },
    {
      "name": "syslog path",
      "host": "/var/log/syslog",
      "container": "/syslog",
      "mode": "ro",
      "description": "Container Path: /syslog",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8081",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    },
    {
      "name": "Port",
      "host": "6060",
      "container": "6060",
      "protocol": "tcp",
      "description": "Container Port: 6060",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "COLLECTIONS",
      "key": "COLLECTIONS",
      "value": "crowdsecurity/traefik crowdsecurity/http-cve LePresidente/authelia",
      "description": "Container Variable: COLLECTIONS",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
