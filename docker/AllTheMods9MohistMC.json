{
  "name": "All-The-Mods-9---MohistMC",
  "repo": "cobbert/docker-allthemods9",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/cobbert/docker-allthemods9",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:25565]",
  "icon": "https://media.forgecdn.net/avatars/902/338/638350403793040080.png",
  "project": "https://www.curseforge.com/minecraft/modpacks/all-the-mods-9",
  "description": "All the Mods 9-1.0.3 MohistMC ATM9 has over 400 mods loaded and countless quests and a built in proper endgame. Can you craft the ATM Star? Do you dare take on the Gregstar?",
  "paths": [
    {
      "name": "Installed Location",
      "host": "/mnt/cache/appdata/atm9/",
      "container": "/data",
      "mode": "rw",
      "description": "Path to store the installed server files.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "25565",
      "container": "25565",
      "protocol": "tcp",
      "description": "Port for the server",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "EULA",
      "key": "EULA",
      "value": "false",
      "description": "Do you agree to the Mojang EULA available at https://account.mojang.com/documents/minecraft_eula? Server will not start without accepting. Set to 'true' to accept.",
      "required": true,
      "mask": false
    },
    {
      "name": "JVM_OPTS",
      "key": "JVM_OPTS",
      "value": "-Xms2048m -Xmx4096m",
      "description": "JAVA Options",
      "required": false,
      "mask": false
    },
    {
      "name": "OPS",
      "key": "OPS",
      "value": "",
      "description": "Comma separated list of players to have op capability",
      "required": false,
      "mask": false
    },
    {
      "name": "MOTD",
      "key": "MOTD",
      "value": "",
      "description": "Set the server MOTD",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
