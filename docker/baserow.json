{
  "name": "baserow",
  "repo": "baserow/baserow",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/baserow/baserow",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/tquizzle/Docker-xml/master/img/baserow.png",
  "project": "https://baserow.io",
  "description": "Baserow is an open source no-code database and Airtable alternative. Create your own database without technical experience. Our user friendly no-code tool gives you the powers of a developer without leaving your browser. Be sure to set the BASEROW_PUBLIC_URL to your public URL if you plan on using this over Cloudflare Tunnels.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/baserow",
      "container": "/baserow/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "URL",
      "key": "BASEROW_PUBLIC_URL",
      "value": "http://url:PORT",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
