{
  "name": "Spoolman",
  "repo": "ghcr.io/donkie/spoolman:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://ghcr.io/donkie/spoolman",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/m-klecka/unraid-templates/main/spoolman/spoolman.png",
  "project": "https://github.com/Donkie/Spoolman",
  "description": "Keep track of your inventory of 3D-printer filament spools. Spoolman is a web service that helps you keep track of your filament spools and how they are being used. It acts as a database, where other printer software such as Octoprint and Moonraker can interact with to have a centralized place for spool information. For example, if used together with Moonraker, your spool weight will automatically be reduced as your print is progressing. For more container variables visit the official github repo https://github.com/Donkie/Spoolman#using-docker",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/spoolman",
      "container": "/home/app/.local/share/spoolman",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "7912",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SPOOLMAN_DB_TYPE",
      "key": "SPOOLMAN_DB_TYPE",
      "value": "sqlite",
      "description": "Type of database, any of: postgres, mysql, sqlite, cockroachdb",
      "required": false,
      "mask": false
    },
    {
      "name": "SPOOLMAN_DB_HOST",
      "key": "SPOOLMAN_DB_HOST",
      "value": "remove variable if not used",
      "description": "Database hostname",
      "required": false,
      "mask": false
    },
    {
      "name": "SPOOLMAN_DB_PORT",
      "key": "SPOOLMAN_DB_PORT",
      "value": "remove variable if not used",
      "description": "Database port",
      "required": false,
      "mask": false
    },
    {
      "name": "SPOOLMAN_DB_NAME",
      "key": "SPOOLMAN_DB_NAME",
      "value": "remove variable if not used",
      "description": "Database name",
      "required": false,
      "mask": false
    },
    {
      "name": "SPOOLMAN_DB_USERNAME",
      "key": "SPOOLMAN_DB_USERNAME",
      "value": "remove variable if not used",
      "description": "Database username",
      "required": false,
      "mask": false
    },
    {
      "name": "SPOOLMAN_DB_PASSWORD",
      "key": "SPOOLMAN_DB_PASSWORD",
      "value": "remove variable if not used",
      "description": "Database password",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
