{
  "name": "calibre",
  "repo": "lscr.io/linuxserver/calibre",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/calibre",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:8181]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/calibre-logo.png",
  "project": "https://calibre-ebook.com/",
  "description": "Calibre(https://calibre-ebook.com/) is a powerful and easy to use e-book manager. Users say it's outstanding and a must-have. It'll allow you to do nearly everything and it takes things a step beyond normal e-book software. It's also completely free and open source and great for both casual users and computer experts.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Where calibre should store its database and library.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Calibre desktop gui (only for reverse proxy access).",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 8181",
      "host": "8181",
      "container": "8181",
      "protocol": "tcp",
      "description": "Calibre desktop gui HTTPS.",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 8081",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Calibre webserver gui (needs to be enabled in gui settings first).",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PASSWORD",
      "key": "PASSWORD",
      "value": "",
      "description": "Optionally set a password for the gui.",
      "required": false,
      "mask": true
    },
    {
      "name": "CLI_ARGS",
      "key": "CLI_ARGS",
      "value": "",
      "description": "Optionally pass cli start arguments to calibre.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
