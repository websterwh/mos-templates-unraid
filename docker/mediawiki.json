{
  "name": "mediawiki",
  "repo": "d8sychain/mediawiki",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/d8sychain/mediawiki/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/d8sychain/unraid-ca-templates/master/images/mediawiki.png",
  "project": "https://www.mediawiki.org",
  "description": "MediaWiki with WYSIWYG VisualEditor extension and Parsoid service. Built with Alpine, S6-overlay, NGINX, PHP-FPM with PHP 7.3, NodeJS, along with other extensions.",
  "paths": [
    {
      "name": "File Uploads",
      "host": "",
      "container": "/assets",
      "mode": "rw",
      "description": "OPTIONAL: Set a host path to use an alternate location for file uploads. Default container path: /config/www/mediawiki/images/br Container Path: /data",
      "required": false
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/mediawiki",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "9090",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Key 1",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "Allow Mediawiki Upgrades",
      "key": "UPGRADE_MEDIAWIKI",
      "value": "disable",
      "description": "Allow MediaWiki to automatically be upgraded with new docker images./br Set 'enable' to allow upgrades.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
