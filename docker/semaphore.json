{
  "name": "semaphore",
  "repo": "semaphoreui/semaphore:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/semaphoreui/semaphore",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/masterwishx/unraid-templates/main/images/semaphore.png",
  "project": "https://semaphoreui.com/",
  "description": "Semaphore is a modern UI for Ansible. It lets you easily run Ansible playbooks, get notifications about fails, control access to deployment system.",
  "paths": [
    {
      "name": "Appdata Config",
      "host": "/mnt/cache/appdata/semaphore",
      "container": "/etc/semaphore",
      "mode": "rw",
      "description": "Appdata Config Path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SEMAPHORE_DB_DIALECT",
      "key": "SEMAPHORE_DB_DIALECT",
      "value": "bolt",
      "description": "Choose either `bolt`, `postgres` or `mysql`. If `bolt` is chosen, the optional variables (`SEMAPHORE_DB...`) do not need to be specified as `bolt` is a 'built-in' database",
      "required": true,
      "mask": false
    },
    {
      "name": "SEMAPHORE_ADMIN",
      "key": "SEMAPHORE_ADMIN",
      "value": "admin",
      "description": "Specify the admin user",
      "required": true,
      "mask": false
    },
    {
      "name": "SEMAPHORE_ADMIN_PASSWORD",
      "key": "SEMAPHORE_ADMIN_PASSWORD",
      "value": "password",
      "description": "Specify the admin password",
      "required": true,
      "mask": true
    },
    {
      "name": "SEMAPHORE_ADMIN_NAME",
      "key": "SEMAPHORE_ADMIN_NAME",
      "value": "John Doe",
      "description": "Specify the admin name",
      "required": true,
      "mask": false
    },
    {
      "name": "SEMAPHORE_ADMIN_EMAIL",
      "key": "SEMAPHORE_ADMIN_EMAIL",
      "value": "example@me.com",
      "description": "Specify the admin email",
      "required": true,
      "mask": false
    },
    {
      "name": "SEMAPHORE_ACCESS_KEY_ENCRYPTION",
      "key": "SEMAPHORE_ACCESS_KEY_ENCRYPTION",
      "value": "xgPAWR6N6kZZ83JZ/ffLAgWgDEqE5OiA+T6fo5Qq1/A=",
      "description": "Specify the key for encrypting access keys in database. It must be generated by using the following command: `head -c32 /dev/urandom | base64`.",
      "required": true,
      "mask": true
    },
    {
      "name": "SEMAPHORE_DB_HOST",
      "key": "SEMAPHORE_DB_HOST",
      "value": "192.168.1.x:3000",
      "description": "Host IP of PostgreSQL or MySQL",
      "required": false,
      "mask": false
    },
    {
      "name": "SEMAPHORE_DB_USER",
      "key": "SEMAPHORE_DB_USER",
      "value": "semaphore",
      "description": "PostgreSQL/MySQL database user",
      "required": false,
      "mask": false
    },
    {
      "name": "SEMAPHORE_DB_PASS",
      "key": "SEMAPHORE_DB_PASS",
      "value": "semaphore",
      "description": "PostgreSQL/MySQL database password",
      "required": false,
      "mask": true
    },
    {
      "name": "SEMAPHORE_DB",
      "key": "SEMAPHORE_DB",
      "value": "semaphore",
      "description": "PostgreSQL/MySQL database",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
