{
  "name": "headphones",
  "repo": "lscr.io/linuxserver/headphones",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/headphones",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8181]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/headphones-logo.png",
  "project": "https://github.com/rembo10/headphones",
  "description": "Headphones(https://github.com/rembo10/headphones) is an automated music downloader for NZB and Torrent, written in Python. It supports SABnzbd, NZBget, Transmission, \u00b5Torrent and Blackhole.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration files.",
      "required": true
    },
    {
      "name": "Path: /downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "ISOs.",
      "required": true
    },
    {
      "name": "Path: /music",
      "host": "",
      "container": "/music",
      "mode": "rw",
      "description": "Your music directory.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8181",
      "container": "8181",
      "protocol": "tcp",
      "description": "Application WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
