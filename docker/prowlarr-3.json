{
  "name": "prowlarr",
  "repo": "bitlessbyte/prowlarr",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/bitlessbyte/prowlarr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9696]/system/status",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/prowlarr-logo.png",
  "project": "https://github.com/Prowlarr/Prowlarr",
  "description": "This is a modified version(https://github.com/BitlessByte0/docker-prowlarr-abb) of Prowlarr that adds back AudioBookBay since it was considered obsolete. Prowlarr(https://github.com/Prowlarr/Prowlarr) is an indexer manager/proxy built on the popular arr .net/reactjs base stack to integrate with your various PVR apps. Prowlarr supports both Torrent Trackers and Usenet Indexers. It integrates seamlessly with Sonarr, Radarr, Lidarr, and Readarr offering complete management of your indexers with no per app Indexer setup required (we do it all).",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/prowlarr",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9898",
      "container": "9696",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TimeZone",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
