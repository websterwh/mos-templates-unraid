{
  "name": "Huntarr",
  "repo": "huntarr/huntarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/huntarr/huntarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9705]/",
  "icon": "https://raw.githubusercontent.com/plexguide/Huntarr.io/main/frontend/static/logo/512.png",
  "project": "https://huntarr.io",
  "description": "A specialized utility that automates discovering missing and upgrading your media collection!",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/huntarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9705",
      "container": "9705",
      "protocol": "tcp",
      "description": "Container Port: 9705",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "",
      "description": "Base URL for Huntarr, leave empty for root path",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
