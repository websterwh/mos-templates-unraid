{
  "name": "koshelf",
  "repo": "ghcr.io/devtigro/koshelf:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/devtigro/koshelf-docker/pkgs/container/koshelf",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 1000:1000",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/koshelf.png",
  "project": "https://github.com/paviro/KoShelf",
  "description": "Unofficial Docker image for KoShelf. All your KOReader notes & highlights combined into a beautiful reading dashboard with statistics. KoShelf - All your KOReader notes & highlights combined into a beautiful reading dashboard with statistics.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/koshelf",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "KOReader Books Folder",
      "host": "",
      "container": "/books",
      "mode": "ro",
      "description": "Must be a books folder created by KOreader. Not your regular book library.",
      "required": true
    },
    {
      "name": "KOReader Settings Folder",
      "host": "",
      "container": "/settings",
      "mode": "ro",
      "description": "Folder that contains your KOReader settings",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
