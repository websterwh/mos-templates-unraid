{
  "name": "Puter",
  "repo": "ghcr.io/heyputer/puter:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/heyputer/puter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4100]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/puter-icon.png",
  "project": "https://puter.com",
  "description": "An advanced, open-source internet operating system designed to be feature-rich, exceptionally fast, and highly extensible.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/puter/config",
      "container": "/etc/puter",
      "mode": "rw",
      "description": "Config path",
      "required": true
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/puter/data",
      "container": "/var/puter",
      "mode": "rw",
      "description": "Data path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4100",
      "container": "4100",
      "protocol": "tcp",
      "description": "Container Port: 4100",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
