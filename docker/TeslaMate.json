{
  "name": "TeslaMate",
  "repo": "teslamate/teslamate:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/teslamate/teslamate",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4000]",
  "icon": "https://raw.githubusercontent.com/simonsickle/unraid-templates/main/teslamate/logo.png",
  "project": "https://github.com/adriankumpf/teslamate",
  "description": "TeslaMate is a powerful, self-hosted data logger for your Tesla. Postgres is required to save logged data.",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Encryption Key",
      "key": "ENCRYPTION_KEY",
      "value": "",
      "description": "generate a secure key to encrypt your Tesla API tokens",
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres User",
      "key": "DATABASE_USER",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Password",
      "key": "DATABASE_PASS",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Postgres Database",
      "key": "DATABASE_NAME",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_HOST",
      "key": "DATABASE_HOST",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Disable MQTT",
      "key": "DISABLE_MQTT",
      "value": "false",
      "description": "Set to",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT_HOST",
      "key": "MQTT_HOST",
      "value": "",
      "description": "IP address of your MQTT broker (mosquitto most commonly)",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT Username",
      "key": "MQTT_USERNAME",
      "value": "",
      "description": "Leave empty if usinge anonymous mode",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT Password",
      "key": "MQTT_PASSWORD",
      "value": "",
      "description": "Leave empty if usinge anonymous mode",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
