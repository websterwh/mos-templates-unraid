{
  "name": "SkillGoblin",
  "repo": "vladoportos/skillgoblin:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/vladoportos/skillgoblin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/VladoPortos/vladoportos-unraid-xml/main/img/SkillGoblin.png",
  "project": "https://skillgoblin.com",
  "description": "A streamlined, self-hosted learning platform focused on simplicity and ease of maintenance. Note!: Do not face this to internet ! There is no robust protection and its primary intended for local network",
  "paths": [
    {
      "name": "Database",
      "host": "/mnt/cache/appdata/skillgoblin/",
      "container": "/app/data/database",
      "mode": "rw",
      "description": "SQLite DB is stored here",
      "required": false
    },
    {
      "name": "Tutorials",
      "host": "/mnt/cache/tutorials/",
      "container": "/app/data/content",
      "mode": "rw",
      "description": "Path to your tutorials folder",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PORT",
      "key": "PORT",
      "value": "3000",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Host",
      "key": "HOST",
      "value": "0.0.0.0",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PollIntervall",
      "key": "CHOKIDAR_POLLING_INTERVAL",
      "value": "60000",
      "description": "How often to look for changes in ms",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
