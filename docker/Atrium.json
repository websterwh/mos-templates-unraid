{
  "name": "Atrium",
  "repo": "vibralabs/atrium:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/vibralabs/atrium",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/atrium-icon.png",
  "project": "https://atrium.vibralabs.co/",
  "description": "A self-hosted client portal for agencies and freelancers. Manage projects, share files, and give clients a branded portal to track progress.",
  "paths": [
    {
      "name": "Uploads Path",
      "host": "/mnt/cache/appdata/atrium/uploads",
      "container": "/app/uploads",
      "mode": "rw",
      "description": "Path to store uploaded files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "postgresql://atrium:atrium@localhost:5432/atrium",
      "description": "Connection URL for Postgres database",
      "required": true,
      "mask": false
    },
    {
      "name": "Auth Secret",
      "key": "BETTER_AUTH_SECRET",
      "value": "",
      "description": "Secret key. Generate a secure random key with `openssl rand -base64 32`",
      "required": true,
      "mask": true
    },
    {
      "name": "Storage Provider",
      "key": "STORAGE_PROVIDER",
      "value": "local",
      "description": "Storage provider to use for file uploads.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
