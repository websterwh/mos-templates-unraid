{
  "name": "vikunja-api",
  "repo": "vikunja/api:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/vikunja/api/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3456]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/vikunja.png",
  "project": "https://vikunja.io/",
  "description": "The to-do app to organize your life.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/vikunja",
      "container": "/app/vikunja/files",
      "mode": "rw",
      "description": "AppData",
      "required": false
    },
    {
      "name": "Config Folder",
      "host": "/mnt/cache/appdata/vikunja/config",
      "container": "/etc/vikunja",
      "mode": "rw",
      "description": "Folder where you place your 'config.yml' file",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "3456",
      "container": "3456",
      "protocol": "tcp",
      "description": "Port 1",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Sqlite Path",
      "key": "VIKUNJA_DATABASE_PATH",
      "value": "/etc/vikunja/vikunja.db",
      "description": "When using sqlite, this is the path where to store the data inisde the container",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Host",
      "key": "VIKUNJA_DATABASE_HOST",
      "value": "db",
      "description": "Database host - Only if Database Type is set to mysql or postgres",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "VIKUNJA_DATABASE_PASSWORD",
      "value": "password",
      "description": "Database Password - Only if Database Type is set to mysql or postgres",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Type",
      "key": "VIKUNJA_DATABASE_TYPE",
      "value": "sqlite",
      "description": "Database type to use. Supported types are mysql, postgres and sqlite.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "VIKUNJA_DATABASE_USER",
      "value": "root",
      "description": "Database User - Only if Database Type is set to mysql or postgres",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "VIKUNJA_DATABASE_DATABASE",
      "value": "vikunja",
      "description": "Database to use - Only if Database Type is set to mysql or postgres",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
