{
  "name": "Onedev",
  "repo": "1dev/server",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/1dev/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6610]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/onedev-logo.png",
  "project": "https://code.onedev.io/projects/160",
  "description": "OneDev is an all-in-one DevOps platform that features Git repository management with language-aware code search, issue management with custom states and fields, and a docker-first Kubernetes native build/CI engine. An alternative to GitLab, it is easier to use and maintain, with lots of unique features OneDev by default uses an embedded database to store data. You may use environment variables to connect to external database if desired. See Documentation https://code.onedev.io/projects/162/files",
  "paths": [
    {
      "name": "Data Dir",
      "host": "",
      "container": "/opt/onedev",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Docker Sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6610",
      "container": "6610",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "SSH Port",
      "host": "6611",
      "container": "6611",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
