{
  "name": "YACReaderLibraryServer",
  "repo": "xthursdayx/yacreaderlibrary-server-docker",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/xthursdayx/yacreaderlibrary-server-docker/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/xthursdayx/docker-templates/master/xthursdayx/images/yacreader-icon.png",
  "project": "https://www.yacreader.com",
  "description": "Headless version of the YACReaderLibraryServer. YACReader is the best comic reader and comic manager available, with support for cbr, cbz, zip, and rar comic files. YACReaderLibraryServer makes it easy to run a home comics server to serve your comics to any device running a YACReader client (including Windows, MacOS, Linux, and iOS).",
  "paths": [
    {
      "name": "Comics",
      "host": "",
      "container": "/comics",
      "mode": "rw",
      "description": "Container Path: /comics",
      "required": true
    },
    {
      "name": "Config",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Time Zone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
