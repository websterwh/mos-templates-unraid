{
  "name": "MyMPD",
  "repo": "ghcr.io/jcorporation/mympd/mympd:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jcorporation/mympd/mympd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 1000:1000",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://jcorporation.github.io/myMPD/assets/mympd-logo.svg",
  "project": "https://jcorporation.github.io/myMPD/",
  "description": "myMPD is a standalone and mobile friendly web-based MPD client with a tiny footprint and advanced features.",
  "paths": [
    {
      "name": "MPD Listening Socket",
      "host": "/run/mpd",
      "container": "/run/mpd",
      "mode": "rw",
      "description": "Path to the MPD listening socket",
      "required": true
    },
    {
      "name": "Working Directory",
      "host": "/mnt/cache/appdata/mympd/working",
      "container": "/var/lib/mympd",
      "mode": "rw",
      "description": "Path to the working directory",
      "required": true
    },
    {
      "name": "Cache Directory",
      "host": "/mnt/cache/appdata/mympd/cache",
      "container": "/var/cache/mympd",
      "mode": "rw",
      "description": "Path to the cache directory",
      "required": true
    },
    {
      "name": "Music Directory",
      "host": "",
      "container": "/var/lib/mpd/music",
      "mode": "ro",
      "description": "Path to the music directory",
      "required": true
    },
    {
      "name": "Playlist Directory",
      "host": "",
      "container": "/var/lib/mpd/playlists",
      "mode": "ro",
      "description": "Path to the playlist directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "UMask",
      "key": "UMASK_SET",
      "value": "022",
      "description": "Umask setting for file permissions",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable SSL",
      "key": "MYMPD_SSL",
      "value": "false|true",
      "description": "Enable SSL for MyMPD",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal HTTP Port",
      "key": "MYMPD_HTTP_PORT",
      "value": "8080",
      "description": "Internal HTTP port for MyMPD. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
