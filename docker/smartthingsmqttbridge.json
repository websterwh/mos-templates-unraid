{
  "name": "smartthings-mqtt-bridge",
  "repo": "stjohnjohnson/smartthings-mqtt-bridge",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/stjohnjohnson/smartthings-mqtt-bridge/~/dockerfile/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/smartthings-mqtt-bridge_icon.png",
  "project": null,
  "description": "A bridge between SmartThings and MQTT (there is NO webconsole!) This project was spawned by the desire to control SmartThings from within Home Assistant. Since Home Assistant already supports MQTT, we chose to go and build a bridge between SmartThings and MQTT. Setup info available at: https://github.com/stjohnjohnson/smartthings-mqtt-bridge",
  "paths": [
    {
      "name": "BridgeDataPath",
      "host": "/mnt/cache/appdata/smartthings-mqtt-bridge",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "BridgePort",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
