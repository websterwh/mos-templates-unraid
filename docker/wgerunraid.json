{
  "name": "wger-unraid",
  "repo": "wger/devel:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/wger/devel",
  "network": "sebnet",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/wger-project/wger/master/wger/core/static/images/logos/logo.png",
  "project": "https://wger.de/software/features",
  "description": "wger (\u02c8v\u025b\u0261\u0250) Workout Manager is a free, open source web application that help you manage your personal workouts, weight and diet plans and can also be used as a simple gym management utility. It offers a REST API as well, for easy integration with other projects and tools.",
  "paths": [
    {
      "name": "DJANGO_MEDIA_ROOT",
      "host": "/mnt/cache/appdata/wger/media",
      "container": "/home/wger/media",
      "mode": "rw",
      "description": "Path to uploaded files",
      "required": true
    },
    {
      "name": "DJANGO_STATIC_ROOT",
      "host": "/mnt/cache/appdata/wger/static",
      "container": "/home/wger/static",
      "mode": "rw",
      "description": "DJANGO_STATIC_ROOT",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "PORT",
      "host": "8555",
      "container": "8000",
      "protocol": "tcp",
      "description": "WebUI port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DJANGO_DB_ENGINE",
      "key": "DJANGO_DB_ENGINE",
      "value": "django.db.backends.postgresql",
      "description": "Database Engine",
      "required": true,
      "mask": false
    },
    {
      "name": "DJANGO_DB_DATABASE",
      "key": "DJANGO_DB_DATABASE",
      "value": "wger",
      "description": "Database Name",
      "required": true,
      "mask": false
    },
    {
      "name": "DJANGO_DB_USER",
      "key": "DJANGO_DB_USER",
      "value": "wger",
      "description": "Database User",
      "required": true,
      "mask": false
    },
    {
      "name": "DJANGO_DB_PASSWORD",
      "key": "DJANGO_DB_PASSWORD",
