{
  "name": "Plex-Poster-Helper-2",
  "repo": "tonywied17/plex-poster-helper-2:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/tonywied17/plex-poster-helper-2",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3939]",
  "icon": "https://raw.githubusercontent.com/molexxxx/plex-poster-set-helper-2/main/resources/icon.png",
  "project": "https://github.com/molexxxx/plex-poster-set-helper-2",
  "description": "Browse your Plex library and apply MediUX / ThePosterDB poster sets - follow creators, schedule weekly syncs, and reset posters. Native web UI in your browser (no VNC).",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/plex-poster-helper-2",
      "container": "/config",
      "mode": "rw",
      "description": "Config, schedules, applied-poster history, and installed Chromium.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3939",
      "container": "3939",
      "protocol": "tcp",
      "description": "Web UI port. Open http:// :3939 in your browser. Sign in with Plex to access the app.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Timezone (matches scheduler cron times)",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
