{
  "name": "4ga-Boards",
  "repo": "ghcr.io/rargames/4gaboards",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/users/RARgames/packages/container/package/4gaboards",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1337]",
  "icon": "https://raw.githubusercontent.com/Richardk2n/Unraid-templates/master/4gaBoards/4ga_favicon192w.png",
  "project": "https://github.com/RARgames/4gaBoards",
  "description": "4ga Boards(https://4gaboards.com) is an straightforward realtime kanban boards management for intuitive task tracking.",
  "paths": [
    {
      "name": "Data storage user avatars",
      "host": "/mnt/cache/appdata/4gaBoards/user-avatars",
      "container": "/app/public/user-avatars",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true
    },
    {
      "name": "Data storage project background images",
      "host": "/mnt/cache/appdata/4gaBoards/project-background-images",
      "container": "/app/public/project-background-images",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true
    },
    {
      "name": "Data storage attachments",
      "host": "/mnt/cache/appdata/4gaBoards/attachments",
      "container": "/app/private/attachments",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "1337",
      "container": "1337",
      "protocol": "tcp",
      "description": "4ga Boards web UI.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "BASE_URL",
      "key": "BASE_URL",
      "value": "https://4gaBoards.example.com",
      "description": "The URL you will use to access 4ga Boards including protocol, and port if not 80/443.",
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgresql://user:password@DB_HOST:DB_PORT/4gaBoards",
      "description": "Postgres database URL. Special characters must be url encoded(https://en.wikipedia.org/wiki/Percent-encoding).",
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "notasecretkey",
      "description": "Session encryption key, recommended 64 character alphanumeric.",
      "required": true,
      "mask": true
    },
    {
      "name": "DEFAULT_ADMIN_USERNAME",
      "key": "DEFAULT_ADMIN_USERNAME",
      "value": "demo",
      "description": "Default admin username (applied only on first run).",
      "required": true,
      "mask": false
    },
    {
      "name": "DEFAULT_ADMIN_EMAIL",
      "key": "DEFAULT_ADMIN_EMAIL",
      "value": "demo@demo.demo",
      "description": "Default admin email (applied only on first run).",
      "required": true,
      "mask": false
    },
    {
      "name": "DEFAULT_ADMIN_NAME",
      "key": "DEFAULT_ADMIN_NAME",
      "value": "Demo Demo",
      "description": "Default admin name (applied only on first run).",
      "required": true,
      "mask": false
    },
    {
      "name": "DEFAULT_ADMIN_PASSWORD",
      "key": "DEFAULT_ADMIN_PASSWORD",
      "value": "demo",
      "description": "Default admin password (applied only on first run).",
      "required": true,
      "mask": true
    },
    {
      "name": "TRUST_PROXY",
      "key": "TRUST_PROXY",
      "value": "0",
      "description": "Set to `1` to trust upstream proxies if reverse proxying.",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TZ for saving",
      "key": "TZ",
      "value": "UTC",
      "description": "Must be UTC",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
