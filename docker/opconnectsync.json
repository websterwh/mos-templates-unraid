{
  "name": "op-connect-sync",
  "repo": "1password/connect-sync:latest",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/1password/connect-sync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8098]",
  "icon": "https://github.com/undead-reaper/unraid-templates/blob/master/op-connect-sync/op-connect-sync.png?raw=true",
  "project": "https://github.com/1Password/connect",
  "description": "1Password Connect Sync keeps the information available on the Connect server in sync with 1Password.com.",
  "paths": [
    {
      "name": "Data Path /data",
      "host": "/mnt/cache/connect/data/",
      "container": "/home/opuser/.op/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Credentials Path",
      "host": "/mnt/cache/connect/config/1password-credentials.json",
      "container": "/home/opuser/.op/1password-credentials.json",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Sync Port",
      "host": "8098",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
