{
  "name": "StirlingPDF",
  "repo": "stirlingtools/stirling-pdf",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/stirlingtools/stirling-pdf",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/Stirling-Tools/Stirling-PDF/refs/heads/main/app/core/src/main/resources/static/favicon.png",
  "project": "https://github.com/Stirling-Tools/Stirling-PDF/",
  "description": "Stirling PDF (S-PDF) SPDF is a locally hosted web application that allows you to perform various operations on PDF files, such as merging, splitting and converting PDFs and more advanced features like OCR and compression Additional Unraid docker settings in advanced section if required The majority of variable settings override any settings in /configs/settings.yml You can edit setting there instead of using docker variables if you want (You would need to remove them from docker to avoid override)",
  "paths": [
    {
      "name": "configs",
      "host": "/mnt/cache/appdata/Stirling-PDF/configs/",
      "container": "/configs",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "CustomFiles",
      "host": "/mnt/cache/appdata/Stirling-PDF/customFiles",
      "container": "/customFiles",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SYSTEM_GOOGLEVISIBILITY",
      "key": "SYSTEM_GOOGLEVISIBILITY",
      "value": "false",
      "description": "'true' to allow Google visibility (via robots.txt), 'false' to disallow",
      "required": false,
      "mask": false
    },
    {
      "name": "SYSTEM_DEFAULT_LOCALE",
      "key": "SYSTEM_DEFAULT_LOCALE",
      "value": "en-GB",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "METRICS_ENABLED",
      "key": "METRICS_ENABLED",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SYSTEM_CONNECTIONTIMEOUTMINUTES",
      "key": "SYSTEM_CONNECTIONTIMEOUTMINUTES",
      "value": "3000000",
      "description": "set custom connection timeout values",
      "required": false,
      "mask": false
    },
    {
      "name": "SYSTEM_ROOT_URI_PATH",
      "key": "SYSTEM_ROOT_URI_PATH",
      "value": "/",
      "description": "changes the websites root path, ie if set to pdf-app to application will be viewable at address localhost:8080/pdf-app instead of localhost:8080/",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
