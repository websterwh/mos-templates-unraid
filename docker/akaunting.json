{
  "name": "akaunting",
  "repo": "akaunting/akaunting",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/akaunting/akaunting",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://avatars.githubusercontent.com/u/26357771?s=200&v=4",
  "project": "https://github.com/akaunting/docker",
  "description": "Accounting Application created based on https://akaunting.com/",
  "paths": [],
  "ports": [
    {
      "name": "Web portal",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Setup Account",
      "key": "AKAUNTING_SETUP",
      "value": "true",
      "description": "Do you wish to start the Setup wizard. Need to keep this enabled for the first time",
      "required": false,
      "mask": false
    },
    {
      "name": "MySql Database IP:Port",
      "key": "DB_HOST",
      "value": "",
      "description": "MySql Database format :[Port]",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "DB_DATABASE",
      "value": "",
      "description": "Database Name",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Username",
      "key": "DB_USERNAME",
      "value": "",
      "description": "Database Username",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "Database password",
      "required": true,
      "mask": true
    },
    {
      "name": "Default Company Name",
      "key": "COMPANY_NAME",
      "value": "personal",
      "description": "Your company name",
      "required": true,
      "mask": false
    },
    {
      "name": "Company email address",
      "key": "COMPANY_EMAIL",
      "value": "",
      "description": "Company Email address",
      "required": true,
      "mask": false
    },
    {
      "name": "Login Email address",
      "key": "ADMIN_EMAIL",
      "value": "",
      "description": "Web UI Login Email address",
      "required": true,
      "mask": false
    },
    {
      "name": "Login Password",
      "key": "ADMIN_PASSWORD",
      "value": "",
      "description": "Web Ui Login Password",
      "required": true,
      "mask": true
    },
    {
      "name": "LOCALE",
      "key": "LOCALE",
      "value": "US_EN",
      "description": "Container Variable: LOCALE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
