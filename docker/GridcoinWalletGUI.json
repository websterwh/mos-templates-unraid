{
  "name": "GridcoinWalletGUI",
  "repo": "sublivion/gridcoinwalletgui:latest",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/repository/docker/sublivion/gridcoinwalletgui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6901]",
  "icon": "https://raw.githubusercontent.com/gridcoin-community/Gridcoin-Site/master/assets/img/favicons/favicon-196x196.png",
  "project": "https://gridcoin.world/",
  "description": "Get some Gridcoins from Boinc and Folding@home work. This docker contains Gridcoin Wallet with GUI running on Ubuntu. You can access the wallet via VNC and NoVNC. Check the project page for more info about Gridcoin",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/gridcoinresearch/",
      "container": "/headless/.GridcoinResearch/",
      "mode": "rw,slave",
      "description": "/mnt/user/appdata/gridcoinresearch/",
      "required": true
    },
    {
      "name": "BOINC DATA DIR",
      "host": "",
      "container": "/var/lib/boinc-client/",
      "mode": "rw,slave",
      "description": "BOINC data location if solo crunching (not needed if pool crunching): /mnt/user/appdata/boinc/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "NOVNC PORT",
      "host": "6901",
      "container": "6901",
      "protocol": "tcp",
      "description": "default: 6901",
      "required": false,
      "mask": false
    },
    {
      "name": "VNC PORT",
      "host": "5901",
      "container": "5901",
      "protocol": "tcp",
      "description": "default: 5901",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VNC PASSWORD",
      "key": "VNC_PW",
      "value": "vncpassword",
      "description": "default: vncpassword",
      "required": false,
      "mask": false
    },
    {
      "name": "VNC RESOLUTION",
      "key": "VNC_RESOLUTION",
      "value": "1920x1080",
      "description": "default: 1920x1080",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
