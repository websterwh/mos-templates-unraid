{
  "name": "nzbgetvpn",
  "repo": "dyonr/nzbgetvpn",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/dyonr/nzbgetvpn",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:6791]/",
  "icon": "https://raw.githubusercontent.com/DyonR/docker-templates/master/Icons/nzbgetvpn/nzbgetvpn-icon-256.png",
  "project": "https://github.com/nzbget/nzbget",
  "description": "Docker container which runs the NZBGet while connecting to WireGuard or OpenVPN with iptables killswitch to prevent IP leakage when the tunnel goes down.",
  "paths": [
    {
      "name": "Downloads Path",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Path for /downloads",
      "required": true
    },
    {
      "name": "config",
      "host": "/mnt/cache/appdata/nzbgetvpn/",
      "container": "/config",
      "mode": "rw",
      "description": "config path of nzbgetvpn",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEBUI_PORT_HTTP",
      "host": "6789",
      "container": "6789",
      "protocol": "tcp",
      "description": "Port used to access NZBGet (HTTP) remotely",
      "required": true,
      "mask": false
    },
    {
      "name": "WEBUI_PORT_HTTPS",
      "host": "6791",
      "container": "6791",
      "protocol": "tcp",
      "description": "Port used to access NZBGet (HTTPS) remotely",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VPN_ENABLED",
      "key": "VPN_ENABLED",
      "value": "yes",
      "description": "Enable VPN? yes/no",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_TYPE",
      "key": "VPN_TYPE",
      "value": "openvpn",
      "description": "openvpn / wireguard?",
      "required": true,
      "mask": false
    },
    {
      "name": "VPN_USERNAME",
      "key": "VPN_USERNAME",
      "value": "",
      "description": "Username used to authenticate to the VPN (OpenVPN only)",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_PASSWORD",
      "key": "VPN_PASSWORD",
      "value": "",
      "description": "Password used to authenticate to the VPN (OpenVPN only)",
      "required": false,
      "mask": true
    },
    {
      "name": "LAN_NETWORK",
      "key": "LAN_NETWORK",
      "value": "192.168.0.0/24",
      "description": "Your local network address in CIDR notation",
      "required": true,
      "mask": false
    },
    {
      "name": "ENABLE_SSL",
      "key": "ENABLE_SSL",
      "value": "yes",
      "description": "Let the container handle SSL (yes/no)?",
      "required": true,
      "mask": false
    },
    {
      "name": "WEBUI_USERNAME",
      "key": "WEBUI_USERNAME",
      "value": "nzbget",
      "description": "Username used to connect to the WebUI",
      "required": true,
      "mask": false
    },
    {
      "name": "WEBUI_PASSWORD",
      "key": "WEBUI_PASSWORD",
      "value": "tegbzn6789",
      "description": "Password used to connect to the WebUI",
      "required": true,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "The UID applied to the /config and /downloads",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "The GID applied to the /config and /downloads",
      "required": false,
      "mask": false
    },
    {
      "name": "NAME_SERVERS",
      "key": "NAME_SERVERS",
      "value": "1.1.1.1,1.0.0.1",
      "description": "DNS used by the container",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "umask used by the container",
      "required": false,
      "mask": false
    },
    {
      "name": "HEALTH_CHECK_HOST",
      "key": "HEALTH_CHECK_HOST",
      "value": "one.one.one.one",
      "description": "Host used to check if connection is up",
      "required": false,
      "mask": false
    },
    {
      "name": "HEALTH_CHECK_INTERVAL",
      "key": "HEALTH_CHECK_INTERVAL",
      "value": "300",
      "description": "Interval in seconds between connection check",
      "required": false,
      "mask": false
    },
    {
      "name": "HEALTH_CHECK_SILENT",
      "key": "HEALTH_CHECK_SILENT",
      "value": "1",
      "description": "1 supresses the 'Network is up' message",
      "required": false,
      "mask": false
    },
    {
      "name": "INSTALL_PYTHON3",
      "key": "INSTALL_PYTHON3",
      "value": "no",
      "description": "Set to 'yes' to install Python3",
      "required": false,
      "mask": false
    },
    {
      "name": "ADDITIONAL_PORTS",
      "key": "ADDITIONAL_PORTS",
      "value": "",
      "description": "Additional ports for routing other containers through this one",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
