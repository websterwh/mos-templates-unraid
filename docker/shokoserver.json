{
  "name": "shoko-server",
  "repo": "ghcr.io/shokoanime/server:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/ShokoAnime/ShokoServer/pkgs/container/server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8111]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/shoko-server.png",
  "project": "https://shokoanime.com/",
  "description": "Shoko started as a small AniDB Mylist program to a full blown client-server architecture Have a large Anime Library? File management is a tedious process, so why not let Shoko handle that? Within FIVE minutes, you\u2019ll have Shoko up and running and populating your collection database with information about the various series and episodes in your collection. For those looking for more advanced options, we offer a wide range of utilities in Shoko Desktop to configure your collection workflow to your liking. Please note, Shoko does not provide any way to download files, stream files from streaming sites or access files that are not part of your perosnal collection.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/shokoserver",
      "container": "/home/shoko/.shoko/",
      "mode": "rw",
      "description": "Container Path: /home/shoko/.shoko/",
      "required": true
    },
    {
      "name": "Anime Folder",
      "host": "/mnt/cache/appdata/shokoserver/anime",
      "container": "/anime",
      "mode": "rw",
      "description": "Container Path: /anime",
      "required": true
    },
    {
      "name": "Import Folder",
      "host": "/mnt/cache/appdata/shokoserver/import",
      "container": "/import",
      "mode": "rw",
      "description": "Container Path: /import",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8111",
      "container": "8111",
      "protocol": "tcp",
      "description": "Container Port: 8111",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "USER_ID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "GROUP_ID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
