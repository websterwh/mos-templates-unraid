{
  "name": "immich-power-tools",
  "repo": "ghcr.io/varun-raj/immich-power-tools",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/varun-raj/immich-power-tools/pkgs/container/immich-power-tools",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/TheMapledCog/unraid-templates/refs/heads/main/immich-power-tools/favicon.png",
  "project": "https://github.com/varun-raj/immich-power-tools",
  "description": "A unofficial immich client to provide better tools to organize and manage your immich account. Built to speed up your workflows in Immich to organize your people and albums.",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "8001",
      "container": "3000",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "IMMICH_URL",
      "key": "IMMICH_URL",
      "value": "",
      "description": "Immich URL If using local ip do not include trailing /",
      "required": true,
      "mask": false
    },
    {
      "name": "IMMICH_API_KEY",
      "key": "IMMICH_API_KEY",
      "value": "",
      "description": "Immich API Key https://immich.app/docs/features/command-line-interface/#obtain-the-api-key",
      "required": true,
      "mask": true
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": "",
      "description": "Postgress Database Username",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "Postgres Database Password",
      "required": true,
      "mask": true
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "Postgres Host (IP address or hostname of the database)",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "",
      "description": "Postgres Port number (Default: 5432)",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_DATABASE_NAME",
      "key": "DB_DATABASE_NAME",
      "value": "",
      "description": "Name of the database",
      "required": true,
      "mask": false
    },
    {
      "name": "GEMINI_API_KEY",
      "key": "GEMINI_API_KEY",
      "value": "",
      "description": "Optional: For rewind video generation",
      "required": false,
      "mask": true
    },
    {
      "name": "GOOGLE_MAPS_API_KEY",
      "key": "GOOGLE_MAPS_API_KEY",
      "value": "",
      "description": "Optional: Google Maps Javascript API Key is used for heatmap",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
