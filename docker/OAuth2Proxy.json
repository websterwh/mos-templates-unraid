{
  "name": "OAuth2-Proxy",
  "repo": "quay.io/oauth2-proxy/oauth2-proxy",
  "category": [
    "Network"
  ],
  "registry": "https://quay.io/repository/pusher/oauth2_proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--config=/etc/oauth2/oauth2_proxy.cfg",
  "web_ui_url": "http://[IP]:[PORT:4180]",
  "icon": "https://github.com/oauth2-proxy/oauth2-proxy/raw/master/docs/static/img/logos/OAuth2_Proxy_icon.png",
  "project": null,
  "description": "A reverse proxy and static file server that provides authentication using Providers (Google, GitHub, and others) to validate accounts by email, domain or group. Please visit support thread for install / setup instructions",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/oauth2/",
      "container": "/etc/oauth2/",
      "mode": "rw",
      "description": "Container Path: /etc/oauth2/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP PORT",
      "host": "4180",
      "container": "4180",
      "protocol": "tcp",
      "description": "Container Port: 4180",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
