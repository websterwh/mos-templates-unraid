{
  "name": "TeamCity-BuildAgent",
  "repo": "jetbrains/teamcity-agent",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/jetbrains/teamcity-agent/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://seeklogo.com/images/T/team-city-logo-8FEEB62EC1-seeklogo.com.png",
  "project": "https://hub.docker.com/r/jetbrains/teamcity-agent/",
  "description": "This is an official JetBrains TeamCity build agent image. The TeamCity build agent connects to the TeamCity server and spawns the actual build processes. You can use the jetbrains/teamcity-server image to run a TeamCity server. This image adds a TeamCity agent suitable for Java development. It is based on jetbrains/teamcity-minimal-agent but gives you more benefits, e.g. client-side checkout if you use 'git' or 'mercurial' more bundled build tools 'docker-in-docker' on Linux",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/teamcity-buildagent",
      "container": "/data/teamcity_agent/conf",
      "mode": "rw",
      "description": "Container Path: /data/teamcity_agent/conf",
      "required": true
    },
    {
      "name": "Work",
      "host": "",
      "container": "/opt/buildagent/work",
      "mode": "rw",
      "description": "Container Path: /opt/buildagent/work",
      "required": true
    },
    {
      "name": "Temp",
      "host": "",
      "container": "/opt/buildagent/temp",
      "mode": "rw",
      "description": "Container Path: /opt/buildagent/temp",
      "required": true
    },
    {
      "name": "Docker Volumes",
      "host": "buildagent_volumes",
      "container": "/var/lib/docker",
      "mode": "rw",
      "description": "Container Path: /var/lib/docker",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "SERVER_URL",
      "key": "SERVER_URL",
      "value": "",
      "description": "URL to TeamCity server",
      "required": true,
      "mask": false
    },
    {
      "name": "AGENT_NAME",
      "key": "AGENT_NAME",
      "value": "Phil Coulson",
      "description": "Name of this TeamCity Build Agent",
      "required": true,
      "mask": false
    },
    {
      "name": "DOCKER_IN_DOCKER",
      "key": "DOCKER_IN_DOCKER",
      "value": "start",
      "description": "Run Docker daemon within your container (note that in this case the container should be run with \u2014privileged flag)",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
