{
  "name": "Flood-UI",
  "repo": "figro/flood-ui",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/figro/flood-ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/AriaGomes/Unraid-Templates/master/Images/flood-ui.png",
  "project": "https://flood.js.org",
  "description": "Standalone UI. Requires an existing instance of rTorroent, qBittorrent, Deluge, Transmission.",
  "paths": [
    {
      "name": "appdata",
      "host": "",
      "container": "/.local/share/flood",
      "mode": "rw",
      "description": "Appdata path for persistence Permissions must be sufficent before starting the containe. Check logs for more info (Optional but recommended)",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
