{
  "name": "chrome",
  "repo": "zenika/alpine-chrome",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/zenika/alpine-chrome/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": "--no-sandbox --disable-gpu --disable-dev-shm-usage --remote-debugging-address=0.0.0.0 --remote-debugging-port=9222 --hide-scrollbars",
  "web_ui_url": "http://[IP]:[PORT:9222]",
  "icon": "https://raw.githubusercontent.com/sgraaf/Unraid-Docker-Templates/main/chrome/icon.png",
  "project": "https://hub.docker.com/r/zenika/alpine-chrome/",
  "description": "Chrome running in headless mode in a tiny Alpine image.",
  "paths": [],
  "ports": [
    {
      "name": "Port: WebUI",
      "host": "9222",
      "container": "9222",
      "protocol": "tcp",
      "description": "chrome WebUI port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
