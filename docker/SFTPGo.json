{
  "name": "SFTPGo",
  "repo": "drakkan/sftpgo",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/drakkan/sftpgo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/sftpgo.png",
  "project": "https://github.com/drakkan/sftpgo",
  "description": "Fully featured and highly configurable SFTP server with optional HTTP/S, FTP, FTPS and WebDAV support. Several storage backends are supported: local filesystem, encrypted local filesystem, S3 (compatible) Object Storage, Google Cloud Storage, Azure Blob Storage, SFTP.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/sftpgo/data",
      "container": "/srv/sftpgo/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Backup Directory",
      "host": "/mnt/cache/appdata/sftpgo/backups",
      "container": "/srv/sftpgo/backups",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/sftpgo/config",
      "container": "/var/lib/sftpgo",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Share Access",
      "host": "/mnt/user",
      "container": "/unraid",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "2221",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTP Port",
      "host": "2121",
      "container": "2121",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SFTP Port",
      "host": "2022",
      "container": "2022",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Passive Ports",
      "host": "50000-50100",
      "container": "50000-50100",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "WebDAV Port",
      "host": "10080",
      "container": "10080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Passive Mode IP",
      "key": "SFTPGO_FTPD__BINDINGS__0__FORCE_PASSIVE_IP",
      "value": "10.0.0.10",
      "description": "Put your server IP here for local access, or your public IP for public access via port forwarding.",
      "required": false,
      "mask": false
    },
    {
      "name": "Defender Enabled",
      "key": "SFTPGO_COMMON__DEFENDER__ENABLED",
      "value": "true",
      "description": "https://github.com/drakkan/sftpgo/blob/main/docs/defender.md",
      "required": false,
      "mask": false
    },
    {
      "name": "SFTPGO_FTPD__PASSIVE_PORT_RANGE__START",
      "key": "SFTPGO_FTPD__PASSIVE_PORT_RANGE__START",
      "value": "50000",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SFTPGO_FTPD__PASSIVE_PORT_RANGE__END",
      "key": "SFTPGO_FTPD__PASSIVE_PORT_RANGE__END",
      "value": "50100",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Container FTP Port Binding",
      "key": "SFTPGO_FTPD__BINDINGS__0__PORT",
      "value": "2121",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Container WebDAV Port Binding",
      "key": "SFTPGO_WEBDAVD__BINDINGS__0__PORT",
      "value": "10080",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Debug Mode",
      "key": "SFTPGO_FTPD__BINDINGS__0__DEBUG",
      "value": "0",
      "description": "0 = false, 1 = true",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
