{
  "name": "Libation",
  "repo": "rmcrackan/libation:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/rmcrackan/libation",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "-u 99:100",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/libation-icon.png",
  "project": "https://github.com/rmcrackan/Libation",
  "description": "Liberate your Library. An Audible audiobook downloader.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/libation/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true
    },
    {
      "name": "Books Path",
      "host": "/mnt/cache/appdata/libation/books",
      "container": "/data",
      "mode": "rw",
      "description": "Path to book files",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Sleep Time",
      "key": "SLEEP_TIME",
      "value": "30m",
      "description": "The time to sleep between checks",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Config Path",
      "key": "LIBATION_CONFIG_DIR",
      "value": "/config",
      "description": "Internal path to configuration files. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Books Path",
      "key": "LIBATION_BOOKS_DIR",
      "value": "/data",
      "description": "Internal path to book files. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Create Database If Missing",
      "key": "LIBATION_CREATE_DB",
      "value": "true|false",
      "description": "Whether or not the image should create a database file if none are found.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
