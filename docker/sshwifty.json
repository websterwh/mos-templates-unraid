{
  "name": "sshwifty",
  "repo": "niruix/sshwifty",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/niruix/sshwifty",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8182]",
  "icon": "https://raw.githubusercontent.com/Frooodle/unraid-templates/main/icons/sshwifty.png",
  "project": "https://github.com/nirui/sshwifty",
  "description": "Sshwifty is a SSH and Telnet connector made for the Web. It can be deployed on your computer or server to provide SSH and Telnet access interface for any compatible (standard) web browser. For support in chrome website must run in HTTPS mode, as such a .crt and .key file must be privded in /mnt/user/appdata/sshwifty/certs/ Supports configuration file for hosts with passwords/private key matches prepopulated https://github.com/nirui/sshwifty",
  "paths": [
    {
      "name": "Certs",
      "host": "/mnt/cache/appdata/sshwifty/certs/",
      "container": "/certs/",
      "mode": "rw",
      "description": "Container Path: /certs/",
      "required": false
    },
    {
      "name": "Configuration path for sshwifty.conf.json file",
      "host": "/mnt/cache/appdata/sshwifty/config/",
      "container": "/home/sshwifty/.config/",
      "mode": "rw",
      "description": "Configuration path for optional sshwifty.conf.json file",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8182",
      "container": "8182",
      "protocol": "tcp",
      "description": "Container Port: 8182",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Host Key 1",
      "key": "SSHWIFTY_TLSCERTIFICATEFILE",
      "value": "/certs/cert.crt",
      "description": "Container Variable: TLSCertificateFile",
      "required": false,
      "mask": false
    },
    {
      "name": "Host Key 2",
      "key": "SSHWIFTY_TLSCERTIFICATEKEYFILE",
      "value": "/certs/cert.key",
      "description": "Container Variable: SSHWIFTY_TLSCERTIFICATEKEYFILE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
