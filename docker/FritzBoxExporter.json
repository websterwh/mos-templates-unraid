{
  "name": "FritzBox-Exporter",
  "repo": "pdreker/fritz_exporter:2",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/pdreker/fritz_exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9787]",
  "icon": "https://upload.wikimedia.org/wikipedia/de/thumb/6/68/Fritz%21_Logo.svg/1024px-Fritz%21_Logo.svg.png",
  "project": "https://github.com/Kippenhof/docker-templates",
  "description": "This is a prometheus exporter for AVM Fritz! home network devices commonly found in Europe. This exporter uses the devices builtin TR-064 API via the fritzconnection python module. GitHub repo: https://github.com/sberk42/fritzbox_exporter Docs: https://fritz-exporter.readthedocs.io/en/latest/quickstart.html",
  "paths": [],
  "ports": [
    {
      "name": "Listen Port",
      "host": "9787",
      "container": "9787",
      "protocol": "tcp",
      "description": "Container Port: 9787, you have to enter it in your Prometheus Conf",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "FRITZ_HOSTNAME",
      "key": "FRITZ_HOSTNAME",
      "value": "192.168.178.1",
      "description": "Fritz!Box URL",
      "required": true,
      "mask": false
    },
    {
      "name": "FRITZ_USERNAME",
      "key": "FRITZ_USERNAME",
      "value": "your_fritzbox_username",
      "description": "Fritz!Box Username",
      "required": true,
      "mask": false
    },
    {
      "name": "FRITZ_PASSWORD",
      "key": "FRITZ_PASSWORD",
      "value": "",
      "description": "Fritz!Box Password",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
