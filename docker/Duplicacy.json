{
  "name": "Duplicacy",
  "repo": "saspus/duplicacy-web",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/saspus/duplicacy-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--hostname=duplicacy-unraid",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3875]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/duplicacy.png",
  "project": "https://duplicacy.com",
  "description": "Web GUI for Duplicacy. Duplicacy backs up your files to many cloud storages with client-side encryption and the highest level of deduplication http://duplicacy.com Note: - It's imporatant to pass hostname (Advanced View > Extra Parameters > --hostname=), as duplicacy license is requested based on hostname and machine-id provided by dbus. - Machine-id will be persisted in the /config directory. - Default hostname set to 'duplicacy-Unraid'. - If you want to backup the Unraid FLASH drive then you will have to run Duplicacy as root i.e. USR_ID=0 and GRP_ID=0 - /config -- is where configuration data will be stored. Should be backed up. - /logs -- logs will go there. - /cache -- transient and temporary files will be stored here. Can be safely deleted. - Readme: https://hub.docker.com/r/saspus/duplicacy-web",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/Duplicacy/config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    },
    {
      "name": "Cache",
      "host": "/mnt/cache/appdata/Duplicacy/cache",
      "container": "/cache",
      "mode": "rw",
      "description": "Container Path: /cache",
      "required": false
    },
    {
      "name": "User Data",
      "host": "",
      "container": "/backuproot",
      "mode": "rw",
      "description": "Container Path: /backuproot",
      "required": false
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/Duplicacy/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Container Path: /logs",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3875",
      "container": "3875",
      "protocol": "tcp",
      "description": "Container Port: 3875",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "User ID",
      "key": "USR_ID",
      "value": "99",
      "description": "Container Variable: USR_ID",
      "required": false,
      "mask": false
    },
    {
      "name": "Group ID",
      "key": "GRP_ID",
      "value": "100",
      "description": "Container Variable: GRP_ID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
