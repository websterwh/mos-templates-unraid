{
  "name": "Gollum",
  "repo": "gollumwiki/gollum:master",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/gollumwiki/gollum",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4567]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/gollum-icon.png",
  "project": "https://github.com/gollum/gollum",
  "description": "A simple wiki system built on top of Git.",
  "paths": [
    {
      "name": "Data storage",
      "host": "/mnt/cache/appdata/gollum",
      "container": "/wiki",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4567",
      "container": "4567",
      "protocol": "tcp",
      "description": "Container Port: 4567",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
