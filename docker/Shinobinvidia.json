{
  "name": "Shinobi-nvidia",
  "repo": "ivaxor/shinobi:latest-nvidia",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/ivaxor/shinobi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/ivaxor/unraid-ca-docker-templates/main/shinobi.png",
  "project": "https://gitlab.com/Shinobi-Systems/Shinobi",
  "description": "Shinobi Pro - The Next Generation in Open-Source Video Management Software with support for over 6000 IP and USB Cameras",
  "paths": [
    {
      "name": "Videos",
      "host": "/mnt/cache/appdata/shinobi/videos",
      "container": "/home/Shinobi/videos",
      "mode": "rw",
      "description": "Container Path: /home/Shinobi/videos",
      "required": true
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/shinobi/config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    },
    {
      "name": "Custom auto load libs",
      "host": "/mnt/cache/appdata/shinobi/libs",
      "container": "/home/Shinobi/libs/customAutoLoad",
      "mode": "rw",
      "description": "Container Path: /home/Shinobi/libs/customAutoLoad",
      "required": false
    },
    {
      "name": "MySQL",
      "host": "/mnt/cache/appdata/shinobi/mysql",
      "container": "/var/lib/mysql",
      "mode": "rw",
      "description": "Container Path: /var/lib/mysql",
      "required": false
    },
    {
      "name": "Plugins",
      "host": "/mnt/cache/appdata/shinobi/plugins",
      "container": "/home/Shinobi/plugins",
      "mode": "rw",
      "description": "Container Path: /home/Shinobi/plugins",
      "required": false
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "r",
      "description": "Container Path: /etc/localtime",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "GUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Nvidia visible devices",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "",
      "description": "Container Variable: NVIDIA_VISIBLE_DEVICES",
      "required": false,
      "mask": false
    },
    {
      "name": "Nvidia driver capabilities",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "",
      "description": "Container Variable: NVIDIA_DRIVER_CAPABILITIES",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
