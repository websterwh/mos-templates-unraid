{
  "name": "evcc-calendar",
  "repo": "ghcr.io/cmdrsabre/evcc-calendar:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/cmdrsabre/evcc-calendar/pkgs/container/evcc-calendar",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100 --sysctl net.ipv4.ip_unprivileged_port_start=0",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/cmdrsabre/evcc-calendar/main/templates/icon.png",
  "project": "https://github.com/cmdrsabre/evcc-calendar",
  "description": "Sets a one-time evcc charging plan (target SoC and time) for your car from calendar appointments read through Home Assistant. Starts in dry-run mode: nothing is written until you set dry_run to false in config.yaml. On first start an example config.yaml is created in the appdata folder; edit it, then restart the container. Requires evcc, Home Assistant and an OpenRouteService API key.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/evcc-kalender",
      "container": "/data",
      "mode": "rw",
      "description": "Holds config.yaml, state.db and the optional personal/ folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "8180",
      "container": "80",
      "protocol": "tcp",
      "description": "Port of the web UI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "HA_TOKEN",
      "key": "HA_TOKEN",
      "value": "",
      "description": "Home Assistant long-lived access token",
      "required": true,
      "mask": true
    },
    {
      "name": "EVCC_API_KEY",
      "key": "EVCC_API_KEY",
      "value": "",
      "description": "evcc API key",
      "required": true,
      "mask": true
    },
    {
      "name": "ORS_KEY",
      "key": "ORS_KEY",
      "value": "",
      "description": "OpenRouteService API key",
      "required": true,
      "mask": true
    },
    {
      "name": "Time zone",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Container time zone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
