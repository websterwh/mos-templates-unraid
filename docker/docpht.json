{
  "name": "docpht",
  "repo": "docpht/docpht:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/docpht/docpht/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/docpht.png",
  "project": "https://docpht.org/",
  "description": "DocPHT you can take notes and quickly document anything and without the use of any database.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/docpht/config/",
      "container": "/var/www/app/src/config",
      "mode": "rw",
      "description": "Config",
      "required": false
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/docpht/data/",
      "container": "/var/www/app/data",
      "mode": "rw",
      "description": "Data",
      "required": false
    },
    {
      "name": "Pages",
      "host": "/mnt/cache/appdata/docpht/pages/",
      "container": "/var/www/app/pages",
      "mode": "rw",
      "description": "Pages",
      "required": false
    },
    {
      "name": "SSL",
      "host": "/mnt/cache/appdata/docpht/ssl/",
      "container": "/etc/nginx/ssl",
      "mode": "rw",
      "description": "SSL - NOT REQUIRE IF YOU ARE USING REVERSE PROXY",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8000",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "HTTPS",
      "key": "443",
      "value": "8443",
      "description": "HTTPS - NOT REQUIRE IF YOU ARE USING REVERSE PROXY",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
