{
  "name": "Emoncms",
  "repo": "galexjunk/emoncms:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/alexjunk/emoncms",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/emoncms-icon.png",
  "project": "https://emoncms.org/",
  "description": "Emoncms is a powerful open-source web-app for processing, logging and visualising energy, temperature and other environmental data.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/emoncms/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8081",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP Port",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "8082",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS Port",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT Port",
      "host": "1883",
      "container": "1883",
      "protocol": "tcp",
      "description": "MQTT Port, if using internal broker. Remove if using external broker.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database - Host",
      "key": "MYSQL_DATABASE",
      "value": "",
      "description": "Database host",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - User",
      "key": "MYSQL_USER",
      "value": "emoncms",
      "description": "Database user",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Password",
      "key": "MYSQL_PASSWORD",
      "value": "",
      "description": "Database password",
      "required": true,
      "mask": true
    },
    {
      "name": "MQTT - Host",
      "key": "MQTT_HOST",
      "value": "localhost",
      "description": "MQTT host. If using internal broker, set to 'localhost'.",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - User",
      "key": "MQTT_USER",
      "value": "",
      "description": "MQTT user.",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - Password",
      "key": "MQTT_PASSWORD",
      "value": "",
      "description": "MQTT password.",
      "required": true,
      "mask": true
    },
    {
      "name": "MQTT - Log Level",
      "key": "MQTT_LOG_LEVEL",
      "value": "info|error|warn",
      "description": "MQTT log level.",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis Low-Write Mode",
      "key": "REDIS_BUFFER",
      "value": "1|0",
      "description": "Enable Redis low-write mode. Set to 1 to enable, 0 to disable.",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "EMONCMS_LOG_LEVEL",
      "value": "1|2|3",
      "description": "1=INFO, 2=WARN, 3=ERROR",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal CRT File",
      "key": "CRT_FILE",
      "value": "/etc/ssl/apache2/server.pem",
      "description": "Path to the internal CRT file. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Key File",
      "key": "KEY_FILE",
      "value": "/etc/ssl/apache2/server.key",
      "description": "Path to the internal Key file. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "CName",
      "key": "CNAME",
      "value": "localhost",
      "description": "CName for the server. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
