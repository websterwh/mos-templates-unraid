{
  "name": "dispatch",
  "repo": "khlieng/dispatch",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/khlieng/dispatch/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/dispatch.png",
  "project": "https://github.com/khlieng/dispatch",
  "description": "Web-based IRC client in Go.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dispatch/",
      "container": "/data",
      "mode": "rw",
      "description": "Data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8000",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPs",
      "host": "4596",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPs (Not Required if you use reverse proxy)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
