{
  "name": "ebookbuddy",
  "repo": "thewicklowwolf/ebookbuddy:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/thewicklowwolf/eBookBuddy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/icons/main/ebookbuddy.png",
  "project": "https://github.com/TheWicklowWolf/BookBounty",
  "description": "Web GUI for finding books that are similar to selected Readarr books.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/ebookbuddy",
      "container": "/ebookbuddy/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
