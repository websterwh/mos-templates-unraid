{
  "name": "Kavita",
  "repo": "jvmilazz0/kavita",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jvmilazz0/kavita",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/Kareadita/Kavita/develop/UI/Web/src/assets/icons/android-chrome-192x192.png",
  "project": "https://github.com/Kareadita/Kavita",
  "description": "Lightning fast with a slick design, Kavita is a rocket fueled self-hosted digital library which supports a vast array of file formats. Install to start reading comics, books and manga. You can also share your server with your friends! **Important!** Once you update to 0.8.0 or higher, you MUST perform a forced library scan on all libraries to migrate properly to the new foundation. Failure to do so may result in data loss.",
  "paths": [
    {
      "name": "Data Directory",
      "host": "",
      "container": "/kavita/config",
      "mode": "rw",
      "description": "Container Path: /kavita/config",
      "required": false
    },
    {
      "name": "Book Library",
      "host": "",
      "container": "/library",
      "mode": "rw",
      "description": "Container Path: /library",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web App Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
