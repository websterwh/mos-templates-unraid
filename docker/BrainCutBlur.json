{
  "name": "BrainCut-Blur",
  "repo": "crazydevil35/braincut-blur:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/crazydevil35/braincut-blur",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/CrazyDevil66/braincut-blur/main/icon.png",
  "project": "https://github.com/CrazyDevil66/braincut-blur",
  "description": "Blur service for the BrainCut n8n workflow. Automatically blurs faces and license plates in videos via REST API. Called by the n8n workflow and reports back via webhook when done.",
  "paths": [
    {
      "name": "BrainCut Folder",
      "host": "/mnt/cache/n8n_automation/BrainCut",
      "container": "/data",
      "mode": "rw",
      "description": "BrainCut working folder on Unraid.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port used by n8n to reach the blur service.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "N8N-Server IP",
      "key": "N8N_SERVER_IP",
      "value": "192.168.1.x",
      "description": "IP address of your n8n server.",
      "required": true,
      "mask": false
    },
    {
      "name": "N8N-Server Port",
      "key": "N8N_SERVER_PORT",
      "value": "5678",
      "description": "Port of your n8n server (default: 5678).",
      "required": true,
      "mask": false
    },
    {
      "name": "PLATE_MODEL_PATH",
      "key": "PLATE_MODEL_PATH",
      "value": "",
      "description": "Optional path to a .pt model file for license plate detection. Leave empty if not needed.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
