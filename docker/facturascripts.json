{
  "name": "facturascripts",
  "repo": "patrickstigler/facturascripts",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/patrickstigler/facturascripts",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/patrickstigler/unraid_app_templates/raw/main/facturaScripts/facturascripts.png",
  "project": "https://facturascripts.com/",
  "description": "FacturaScripts is an accounting and billing program. With it you can manage the day to day of your company: make invoices, orders, delivery notes, budgets, accounting, inventory and much more. Requires MYSQL Server or MariaDB or Postgress",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/facturascripts/www/",
      "container": "/var/www/html",
      "mode": "rw",
      "description": "Container Path: /var/www/html",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
