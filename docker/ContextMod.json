{
  "name": "ContextMod",
  "repo": "ghcr.io/foxxmd/context-mod:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/foxxmd/context-mod",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8085]/",
  "icon": "https://contextmod.dev/logo.png",
  "project": "https://contextmod.dev/",
  "description": "Context Mod (CM) is an event-based, reddit moderation bot built on top of snoowrap and written in typescript. It is designed to help fill in the gaps for automoderator in regard to more complex behavior with a focus on user-history based moderation.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/contextmod/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8085",
      "container": "8085",
      "protocol": "tcp",
      "description": "Container Port: 8085",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Internal Data Directory",
      "key": "DATA_DIR",
      "value": "/config",
      "description": "Internal path to the data directory. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
