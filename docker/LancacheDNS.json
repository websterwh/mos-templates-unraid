{
  "name": "Lancache-DNS",
  "repo": "lancachenet/lancache-dns:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/lancachenet/lancache-dns",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:53]",
  "icon": "https://raw.githubusercontent.com/redvex2460/docker-templates/master/redvex2460/images/lancache.png",
  "project": "http://lancache.net",
  "description": "This docker container provides DNS entries for caching services to be used in conjunction with a container. The DNS is generated automatically at startup of the container",
  "paths": [],
  "ports": [
    {
      "name": "DNS-Port",
      "host": "53",
      "container": "53",
      "protocol": "udp",
      "description": "Container Port: 53",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "USE_GENERIC_CACHE",
      "key": "USE_GENERIC_CACHE",
      "value": "true",
      "description": "Container Variable: USE_GENERIC_CACHE",
      "required": false,
      "mask": false
    },
    {
      "name": "LANCACHE_IP",
      "key": "LANCACHE_IP",
      "value": "Please enter IP of Lancache-Docker",
      "description": "Container Variable: LANCACHE_IP",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
