{
  "name": "mkfd",
  "repo": "tbosk/mkfd:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/tbosk/mkfd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/mkfd-icon.png",
  "project": "https://github.com/TBosak/mkfd",
  "description": "RSS feed builder created with Bun and Hono.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/mkfd/feeds",
      "container": "/public/feeds",
      "mode": "rw",
      "description": "Data path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Passkey",
      "key": "PASSKEY",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Cookie Secret",
      "key": "COOKIE_SECRET",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
