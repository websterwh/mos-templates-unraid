{
  "name": "CronMaster",
  "repo": "ghcr.io/fccview/cronmaster:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://ghcr.io/fccview/cronmaster",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--pid=host --init --user root",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/Skylinar/unraid_templates/refs/heads/main/images/cronmaster.png?raw=true",
  "project": "https://github.com/fccview/cronmaster",
  "description": "Cr*nmaster (cronmaster) is a pretty powerful tool that allows you to view/create/edit/manage all your host cronjobs comfortable from an intuitive UI, it has features such as pausing jobs, adding comment to them, running them right from the UI, and from the latest update you'll be able to have nicely structured logs for your jobs on top of exit statuses being shown right there and then. You will be able to see if a job failed at a glance and view the logs to see what's going on. NOTE: The app needs to run privileged to work like it is intended to be used.",
  "paths": [
    {
      "name": "Docker",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "scripts",
      "host": "/mnt/cache/appdata/cronmaster/scripts",
      "container": "/app/scripts",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "data",
      "host": "/mnt/cache/appdata/cronmaster/data",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "snippets",
      "host": "/mnt/cache/appdata/cronmaster/snippets",
      "container": "/app/snippets",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "UI",
      "host": "40123",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NEXT_PUBLIC_CLOCK_UPDATE_INTERVAL",
      "key": "NEXT_PUBLIC_CLOCK_UPDATE_INTERVAL",
      "value": "30000",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "AUTH_PASSWORD",
      "key": "AUTH_PASSWORD",
      "value": "very_strong_password",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HOST_CRONTAB_USER",
      "key": "HOST_CRONTAB_USER",
      "value": "root",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "NODE_ENV",
      "key": "NODE_ENV",
      "value": "production",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DOCKER",
      "key": "DOCKER",
      "value": "true",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
