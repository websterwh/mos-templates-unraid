{
  "name": "SoulSync",
  "repo": "boulderbadgedad/soulsync:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/boulderbadgedad/soulsync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8008]",
  "icon": "https://raw.githubusercontent.com/snuffomega/SoulSync_unraid/main/soulsync.png",
  "project": "https://github.com/Nezreka/SoulSync",
  "description": "Music discovery and automation platform. Find new music, curate playlists, sync libraries, and integrate with popular streaming services, Soulseek (slskd), and media servers.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/soulsync/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Configuration files",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/soulsync/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Log files",
      "required": false
    },
    {
      "name": "Database Volume",
      "host": "/mnt/cache/appdata/soulsync/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Database storage (SQLite)",
      "required": false
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/downloads/",
      "container": "/app/downloads",
      "mode": "rw",
      "description": "Path to Soulseek (slskd) downloads folder \u2014 should match your slskd download path",
      "required": false
    },
    {
      "name": "Library/Transfer",
      "host": "/mnt/cache/library/",
      "container": "/app/Transfer",
      "mode": "rw",
      "description": "Your music library folder for organized/transferred files",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8008",
      "container": "8008",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    },
    {
      "name": "Spotify OAuth Port",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "Spotify OAuth callback port",
      "required": true,
      "mask": false
    },
    {
      "name": "Tidal OAuth Port",
      "host": "8889",
      "container": "8889",
      "protocol": "tcp",
      "description": "Tidal OAuth callback port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file permissions (default 99 = nobody on Unraid)",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file permissions (default 100 = users on Unraid)",
      "required": false,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Timezone for log timestamps and scheduling (e.g., America/New_York)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
