{
  "name": "Pelican-Wing",
  "repo": "ghcr.io/pelican-dev/wings:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://ghcr.io/pelican-dev/wings",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/Mainfrezzer/UnRaid-Templates/main/icon/pelican.png",
  "project": "https://github.com/pelican-dev/",
  "description": "Pelican is a free, open-source game server management panel built with PHP, React, and Go. Designed with security in mind, Pelican runs all game servers in isolated Docker containers while exposing a beautiful and intuitive UI to end users. **!!!WARNING!!!** This is somewhat of a clusterf##k and needs a lot of manual configuration **!!!WARNING!!!** See below in \"Additional Requirements\"",
  "paths": [
    {
      "name": "Docker Sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Pelican - Etc",
      "host": "/mnt/cache/appdata/pelican-wing/etc/pelican",
      "container": "/etc/pelican",
      "mode": "rw",
      "description": "For the config.yml",
      "required": true
    },
    {
      "name": "Pelican - Tmp",
      "host": "/tmp/pelican/",
      "container": "/tmp/pelican/",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Pelican Data",
      "host": "/mnt/cache/appdata/pelican-wing/data",
      "container": "/mnt/user/appdata/pelican-wing/data",
      "mode": "rw",
      "description": "Should match the UnRaid Host Mapping. See 'Additional Requirements' above",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebHttp",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Http port for the web server",
      "required": true,
      "mask": false
    },
    {
      "name": "SFTP",
      "host": "2022",
      "container": "2022",
      "protocol": "tcp",
      "description": "Sftp port for uploads to the gameservers",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Wings_UID",
      "key": "WINGS_UID",
      "value": "99",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Wings_GID",
      "key": "WINGS_GID",
      "value": "100",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "WINGS_USERNAME",
      "key": "WINGS_USERNAME",
      "value": "nobody",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
