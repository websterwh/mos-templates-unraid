{
  "name": "SkyrimTogetherRebornServer",
  "repo": "tiltedphoques/st-reborn-server:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/tiltedphoques/st-reborn-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:10578]",
  "icon": "https://raw.githubusercontent.com/Joey291/unraid-templates/main/templates/skyrim-together-reborn.png",
  "project": "https://skyrim-together.com/",
  "description": "Skyrim Together Reborn Coop Server. This Docker image is not managed by me. I'm just providing it to the Unraid Store from the offical Docker image",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/skyrimserver/config",
      "container": "/home/server/config/",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/skyrimserver/Data",
      "container": "/home/server/Data/",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Log Path",
      "host": "/mnt/cache/appdata/skyrimserver/logs",
      "container": "/home/server/logs/",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "UDP",
      "host": "10578",
      "container": "10578",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
