{
  "name": "Weewx",
  "repo": "felddy/weewx",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/felddy/weewx",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://www.weewx.com/weewx-logo-128x128.png",
  "project": "https://github.com/felddy/weewx-docker",
  "description": "This docker container can be used to quickly get a WeeWX instance up and running. This container has the following WeeWX extensions installed: interceptor mqtt",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/Appdata/weewx",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Timezone",
      "key": "TIMEZONE",
      "value": "Europe/Berlin",
      "description": "Container Variable: TIMEZONE",
      "required": false,
      "mask": false
    },
    {
      "name": "Weewx UID",
      "key": "WEEWX_UID",
      "value": "99",
      "description": "Container Variable: WEEWX_UID",
      "required": false,
      "mask": false
    },
    {
      "name": "Weewx GID",
      "key": "WEEWX_GID",
      "value": "100",
      "description": "Container Variable: WEEWX_GID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "MQTT Device",
      "host": "/dev/ttyUSB0",
      "container": "",
      "description": "Container Device: MQTT Device",
      "required": false
    }
  ],
  "labels": []
}
