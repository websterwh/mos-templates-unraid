{
  "name": "Kometa-Quickstart",
  "repo": "kometateam/quickstart:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/kometateam/quickstart",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7171]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/kometa-icon.png",
  "project": "https://github.com/Kometa-Team/Quickstart",
  "description": "A Web UI tool will guide you through creating a configuration file to use with Kometa.",
  "paths": [
    {
      "name": "Kometa Config Path",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the Kometa configuration directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7171",
      "container": "7171",
      "protocol": "tcp",
      "description": "Container Port: 7171",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Internal Port",
      "key": "QS_PORT",
      "value": "7171",
      "description": "Internal port for the web UI. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable Debug",
      "key": "QS_DEBUG",
      "value": "0",
      "description": "Enable debug mode for the web UI",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
