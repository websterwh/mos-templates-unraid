{
  "name": "Reclaimerr",
  "repo": "ghcr.io/jessielw/reclaimerr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/jessielw/Reclaimerr/pkgs/container/reclaimerr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/jessielw/Reclaimerr/refs/heads/main/public/logo.png",
  "project": "https://github.com/jessielw/Reclaimerr",
  "description": "Automatically reclaim space in your media library using customizable rules. Integrates with Jellyfin and/or Plex to analyze and manage your content. Functions similarly to Seerr (in reverse), providing efficient media cleanup and organization",
  "paths": [
    {
      "name": "Path: /app/data",
      "host": "/mnt/cache/appdata/reclaimerr",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Path: /media",
      "host": "",
      "container": "/media",
      "mode": "rw",
      "description": "Optional: Bind mount for media files (adjust the host path as needed) this is needed for Reclaimerr to clean up additional files on delete when deleting via the main media server directly",
      "required": false
    },
    {
      "name": "Path: /moved_files",
      "host": "",
      "container": "/moved_files",
      "mode": "rw",
      "description": "Optional: Volume for moved files (adjust the host path as needed) - /moved_files:/moved_files",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port for 8000",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
