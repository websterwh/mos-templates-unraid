{
  "name": "FMD-Server",
  "repo": "registry.gitlab.com/fmd-foss/fmd-server:0",
  "category": [
    "Productivity"
  ],
  "registry": "https://gitlab.com/fmd-foss/fmd-server/container_registry/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/fmd-server-icon.png",
  "project": "https://gitlab.com/fmd-foss/fmd-server",
  "description": "A server to communicate with the FMD Android app, to locate and control your devices.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/fmd_server/config.yml",
      "container": "/etc/fmd-server/config.yml",
      "mode": "ro",
      "description": "Path to the configuration file",
      "required": true
    },
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/fmd_server/db",
      "container": "/var/lib/fmd-server/db/",
      "mode": "rw",
      "description": "Path to the database",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
