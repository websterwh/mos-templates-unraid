{
  "name": "nethermind-ethereum",
  "repo": "nethermind/nethermind",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/nethermind/nethermind/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--datadir data",
  "web_ui_url": "http://[IP]:[PORT:8545]",
  "icon": "https://nethermind.io/wp-content/themes/nethermind/images/logo.svg",
  "project": "https://github.com/NethermindEth/nethermind",
  "description": "Official .net implementation of the Ethereum protocol.",
  "paths": [
    {
      "name": "data-path",
      "host": "/mnt/cache/blockchain/ethereum/",
      "container": "/nethermind/data",
      "mode": "rw",
      "description": "Persistent data directory for blockchain files, keys",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "JSON-RPC HTTP",
      "host": "8545",
      "container": "8545",
      "protocol": "tcp",
      "description": "JSON-RPC HTTP server supports a number of APIs.",
      "required": true,
      "mask": false
    },
    {
      "name": "JSON-RPC Web-Socket",
      "host": "8546",
      "container": "8546",
      "protocol": "tcp",
      "description": "Web-Sockets server supports a number of APIs.",
      "required": true,
      "mask": false
    },
    {
      "name": "listener",
      "host": "30303",
      "container": "30303",
      "protocol": "tcp",
      "description": "listener (TCP) port",
      "required": true,
      "mask": false
    },
    {
      "name": "discovery",
      "host": "30303",
      "container": "30303",
      "protocol": "udp",
      "description": "discovery (UDP) port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NETHERMIND_INITCONFIG_ISMINING",
      "key": "NETHERMIND_INITCONFIG_ISMINING",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NETHERMIND_JSONRPCCONFIG_ENABLED",
      "key": "NETHERMIND_JSONRPCCONFIG_ENABLED",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NETHERMIND_JSONRPCCONFIG_HOST",
      "key": "NETHERMIND_JSONRPCCONFIG_HOST",
      "value": "0.0.0.0",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NETHERMIND_JSONRPCCONFIG_ENGINEHOST",
      "key": "NETHERMIND_JSONRPCCONFIG_ENGINEHOST",
      "value": "0.0.0.0",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NETHERMIND_JSONRPCCONFIG_ENGINEPORT",
      "key": "NETHERMIND_JSONRPCCONFIG_ENGINEPORT",
      "value": "8551",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NETHERMIND_JSONRPCCONFIG_JWTSECRETFILE",
      "key": "NETHERMIND_JSONRPCCONFIG_JWTSECRETFILE",
      "value": "/nethermind/data/keystore/jwt-secret/jwt.hex",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
