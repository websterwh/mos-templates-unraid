{
  "name": "sonarrtorss",
  "repo": "gbendy/sonarrtorss",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/gbendy/sonarrtorss/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:18989]",
  "icon": "https://raw.githubusercontent.com/gbendy/sonarrToRSS/main/img/sonarrToRSS.png",
  "project": "https://github.com/gbendy/sonarrToRSS",
  "description": "Sonarr To RSS is a Sonarr Webhook connection endpoint that streams events to RSS/Atom/JSON feeds and provides a paginated website to browse historical events.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Database and Sonarr to RSS configs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "18989",
      "container": "18989",
      "protocol": "tcp",
      "description": "The port for the Sonarr to RSS web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
