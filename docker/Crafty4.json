{
  "name": "Crafty-4",
  "repo": "arcadiatechnology/crafty-4",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/arcadiatechnology/crafty-4",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:8443]/",
  "icon": "https://gitlab.com/crafty-controller/crafty-4/-/raw/master/app/frontend/static/assets/images/Crafty_4-0_Logo_square.ico",
  "project": "https://craftycontrol.com/",
  "description": "Crafty 4 is the next generation of our server wrapper, controller, and launcher for game servers. In addition to full Minecraft server management, Crafty 4 now supports Hytale servers. Rebuilt from the ground up, Crafty 4 features a modern, streamlined interface and a significantly improved internal architecture. With SteamCMD support on the way! **Default login Credentrails are stored in your Crafty Configuration location in the file default-creds.txt ** Crafty 4 is the successor of Crafty Controller. For official support join the Discord server https://discord.gg/9VJPhCE For migration from 3.x please refer to the documentation: https://wiki.craftycontrol.com/en/4/",
  "paths": [
    {
      "name": "Server files",
      "host": "/mnt/cache/appdata/crafty-4/servers/",
      "container": "/crafty/servers",
      "mode": "rw",
      "description": "Path to the minecraft server folders",
      "required": true
    },
    {
      "name": "Backup files",
      "host": "/mnt/cache/appdata/crafty-4/backups/",
      "container": "/crafty/backups",
      "mode": "rw",
      "description": "Server Backups",
      "required": true
    },
    {
      "name": "Server Logs",
      "host": "/mnt/cache/appdata/crafty-4/logs/",
      "container": "/crafty/logs",
      "mode": "rw",
      "description": "Logs",
      "required": true
    },
    {
      "name": "Crafty Configuration",
      "host": "/mnt/cache/appdata/crafty-4/config/",
      "container": "/crafty/app/config",
      "mode": "rw",
      "description": "Path to the persistent Crafty files",
      "required": true
    },
    {
      "name": "Import folder",
      "host": "/mnt/cache/appdata/crafty-4/import/",
      "container": "/crafty/import",
      "mode": "rw",
      "description": "Import existing Mincecraft Servers",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "Web UI [HTTPS]",
      "required": true,
      "mask": false
    },
    {
      "name": "Minecraft ports",
      "host": "25500-25600",
      "container": "25500-25600",
      "protocol": "tcp",
      "description": "TCP Ports for Minecraft",
      "required": true,
      "mask": false
    },
    {
      "name": "Port for dynmap",
      "host": "8123",
      "container": "8123",
      "protocol": "tcp",
      "description": "Dynmap Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port for bedrock server",
      "host": "19132",
      "container": "19132",
      "protocol": "udp",
      "description": "Bedrock server port",
      "required": true,
      "mask": false
    },
    {
      "name": "Hytale Ports",
      "host": "5520-5550",
      "container": "5520-5550",
      "protocol": "udp",
      "description": "UDP Ports for Hytale",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
