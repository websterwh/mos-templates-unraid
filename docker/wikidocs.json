{
  "name": "wikidocs",
  "repo": "zavy86/wikidocs",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/zavy86/wikidocs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/icons/main/book-svgrepo-com.jpg",
  "project": "https://www.wikidocs.it",
  "description": "Wiki|Docs Just a databaseless markdown flat-file wiki engine. NOTE: Will show error on first run due to no config file. Setup script should still complete and create config file.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/wikidocs",
      "container": "/datasets",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
