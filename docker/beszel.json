  "project": "https://github.com/henrygd/beszel",
  "description": "A lightweight server monitoring hub with historical data, docker stats, and alerts.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/beszel/",
      "container": "/beszel_data",
      "mode": "rw",
      "description": "Where the container data will be stored",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8090",
      "container": "8090",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
