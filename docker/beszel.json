{
  "name": "beszel",
  "repo": "henrygd/beszel:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/henrygd/beszel/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8090]",
