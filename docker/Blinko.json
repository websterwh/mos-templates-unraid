{
  "name": "Blinko",
  "repo": "blinkospace/blinko:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/blinkospace/blinko",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1111]/",
  "icon": "https://github.com/UnToobed/Unraid-Docker-Templates/blob/main/Icons/Blinko-Icon-256x256.png?raw=true",
  "project": "https://blinko.mintlify.app/introduction",
  "description": "Blinko is an innovative open-source project designed for individuals who want to quickly capture and organize their fleeting thoughts. Blinko allows users to seamlessly jot down ideas the moment they strike, ensuring that no spark of creativity is lost. I have created this community template for Blinko to make it easy to setup and run for people. I am not affiliated with Blinko. In case you need any support for this template specifically, send a message in the support thread and I will try to help you!",
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/Blinko",
      "container": "/app/.blinko",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Service Port",
      "host": "1111",
      "container": "1111",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NODE_ENV",
      "key": "NODE_ENV",
      "value": "production",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NEXTAUTH_URL",
      "key": "NEXTAUTH_URL",
      "value": "http://localhost:1111",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NEXT_PUBLIC_BASE_URL",
      "key": "NEXT_PUBLIC_BASE_URL",
      "value": "http://localhost:1111",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NEXTAUTH_SECRET",
      "key": "NEXTAUTH_SECRET",
      "value": "my_ultra_secure_nextauth_secret",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgresql://blinko_user:slapping-selector-unpeeled-crepe@192.168.1.10:5432/blinko",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
