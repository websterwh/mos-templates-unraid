{
  "name": "daps",
  "repo": "drazzilb08/daps",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/drazzilb08/daps",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/Drazzilb08/daps/master/daps_logo.png",
  "project": "https://github.com/Drazzilb08/daps",
  "description": "DAPS (Drazzilb's Arr PMM Scripts) A collection of useful scripts for media management and automation Support for this container can be found on Trash's Guide's Discord server https://trash-guides.info/discord",
  "paths": [
    {
      "name": "Posters",
      "host": "",
      "container": "/posters",
      "mode": "rw",
      "description": "Location where gDrive sync will place posters and renamer will pull posters from",
      "required": false
    },
    {
      "name": "PMM Assets",
      "host": "",
      "container": "/pmm",
      "mode": "rw",
      "description": "The location for your Plex-Meta-Manager's assets directory",
      "required": false
    },
    {
      "name": "Config",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Location for your appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port for the web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
