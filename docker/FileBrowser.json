{
  "name": "FileBrowser",
  "repo": "hernandito/filebrowser",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/hernandito/filebrowser",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "-d /db/database.db",
  "web_ui_url": "http://[IP]/files/",
  "icon": "https://github.com/maschhoff/docker/raw/master/filebrowser/35781395.png",
  "project": "https://github.com/filebrowser/filebrowser",
  "description": "File Browser - Webbased File Browser including sharing functions etc. https://docs.filebrowser.xyz/configuration for the config",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/",
      "container": "/srv",
      "mode": "rw",
      "description": "Container Path: /srv",
      "required": false
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/filebrowser/db/",
      "container": "/db",
      "mode": "rw",
      "description": "Container Path: /db/",
      "required": false
    },
    {
      "name": "Host Path 3",
      "host": "/mnt/cache/appdata/filebrowser/app/",
      "container": "/app",
      "mode": "rw",
      "description": "Container Path: /app/",
      "required": false
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
