{
  "name": "dd-agent",
  "repo": "registry.datadoghq.com/agent:latest",
  "category": [
    "System"
  ],
  "registry": "https://registry.datadoghq.com/agent",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--pid host",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/allistera/datadog-unraid/main/datadog.png",
  "project": "https://www.datadoghq.com/",
  "description": "Datadog is a monitoring service for cloud-scale applications, providing monitoring of servers, databases, tools, and services, through a SaaS-based data analytics platform. The Datadog Agent is software that runs on your hosts. It collects events and metrics from hosts and sends them to Datadog, where you can analyze your monitoring and performance data.",
  "paths": [
    {
      "name": "Datadog Socket Path",
      "host": "/var/run/datadog",
      "container": "/var/run/datadog",
      "mode": "rw",
      "description": "Container Path: /var/run/datadog",
      "required": true
    },
    {
      "name": "Agent Run Path",
      "host": "/opt/datadog-agent/run",
      "container": "/opt/datadog-agent/run",
      "mode": "rw",
      "description": "Container Path: /opt/datadog-agent/run",
      "required": true
    },
    {
      "name": "Passwd Path",
      "host": "/etc/passwd",
      "container": "/etc/passwd",
      "mode": "ro",
      "description": "Container Path: /etc/passwd",
      "required": true
    },
    {
      "name": "Group Path",
      "host": "/etc/group",
      "container": "/etc/group",
      "mode": "ro",
      "description": "Container Path: /etc/group",
      "required": true
    },
    {
      "name": "Host Root Path",
      "host": "/",
      "container": "/host/root",
      "mode": "ro",
      "description": "Container Path: /host/root",
      "required": true
    },
    {
      "name": "DebugFS",
      "host": "/sys/kernel/debug",
      "container": "/sys/kernel/debug",
      "mode": "rw",
      "description": "Container Path: /sys/kernel/debug",
      "required": false
    },
    {
      "name": "OS Release",
      "host": "/etc/os-release",
      "container": "/etc/os-release",
      "mode": "ro",
      "description": "Container Path: /etc/os-release",
      "required": false
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Container Path: /var/run/docker.sock",
      "required": true
    },
    {
      "name": "Proc Path",
      "host": "/proc/",
      "container": "/host/proc/",
      "mode": "ro",
      "description": "Container Path: /host/proc/",
      "required": true
    },
    {
      "name": "Cgroup Path",
      "host": "/sys/fs/cgroup/",
      "container": "/host/sys/fs/cgroup",
      "mode": "ro",
      "description": "Container Path: /host/sys/fs/cgroup",
      "required": true
    },
    {
      "name": "Container Logs Path",
      "host": "/var/lib/docker/containers",
      "container": "/var/lib/docker/containers",
      "mode": "ro",
      "description": "Container Path: /var/lib/docker/containers",
      "required": true
    },
    {
      "name": "Lib Modules Path",
      "host": "/lib/modules",
      "container": "/lib/modules",
      "mode": "ro",
      "description": "Container Path: /lib/modules",
      "required": false
    },
    {
      "name": "Kernel Source Path",
      "host": "/usr/src",
      "container": "/usr/src",
      "mode": "ro",
      "description": "Container Path: /usr/src",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "DD_API_KEY",
      "key": "DD_API_KEY",
      "value": "",
      "description": "Datadog API Key",
      "required": true,
      "mask": true
    },
    {
      "name": "DD_SITE",
      "key": "DD_SITE",
      "value": "datadoghq.eu",
      "description": "Datadog Site",
      "required": true,
      "mask": false
    },
    {
      "name": "DD_DOGSTATSD_NON_LOCAL_TRAFFIC",
      "key": "DD_DOGSTATSD_NON_LOCAL_TRAFFIC",
      "value": "true",
      "description": "Enable DogStatsD non-local traffic",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_APM_ENABLED",
      "key": "DD_APM_ENABLED",
      "value": "true",
      "description": "Enable APM",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_APM_NON_LOCAL_TRAFFIC",
      "key": "DD_APM_NON_LOCAL_TRAFFIC",
      "value": "true",
      "description": "Enable APM non-local traffic",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_APM_RECEIVER_SOCKET",
      "key": "DD_APM_RECEIVER_SOCKET",
      "value": "/var/run/datadog/apm.socket",
      "description": "APM Receiver Socket",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_DOGSTATSD_SOCKET",
      "key": "DD_DOGSTATSD_SOCKET",
      "value": "/var/run/datadog/dsd.socket",
      "description": "DogStatsD Socket",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_PROFILING_ENABLED",
      "key": "DD_PROFILING_ENABLED",
      "value": "auto",
      "description": "Enable Profiling",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_DATA_STREAMS_ENABLED",
      "key": "DD_DATA_STREAMS_ENABLED",
      "value": "true",
      "description": "Enable Data Streams",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_LOGS_ENABLED",
      "key": "DD_LOGS_ENABLED",
      "value": "true",
      "description": "Enable Logs",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_LOGS_CONFIG_AUTO_MULTI_LINE_DETECTION",
      "key": "DD_LOGS_CONFIG_AUTO_MULTI_LINE_DETECTION",
      "value": "true",
      "description": "Enable Auto Multi-line Detection for Logs",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL",
      "key": "DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL",
      "value": "true",
      "description": "Collect Logs from all containers",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_CONTAINER_EXCLUDE_LOGS",
      "key": "DD_CONTAINER_EXCLUDE_LOGS",
      "value": "name:dd-agent",
      "description": "Exclude logs from specific containers",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_ROOT_VAR",
      "key": "HOST_ROOT",
      "value": "/host/root",
      "description": "Host Root Variable",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_SYSTEM_PROBE_ENABLED",
      "key": "DD_SYSTEM_PROBE_ENABLED",
      "value": "true",
      "description": "Enable System Probe (required for Runtime Security)",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_RUNTIME_SECURITY_CONFIG_ENABLED",
      "key": "DD_RUNTIME_SECURITY_CONFIG_ENABLED",
      "value": "true",
      "description": "Enable Runtime Security",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_SECURITY_AGENT_ENABLED",
      "key": "DD_SECURITY_AGENT_ENABLED",
      "value": "true",
      "description": "Enable Security Agent",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_SYSTEM_PROBE_RUNTIME_SECURITY_CONFIG_ENABLED",
      "key": "DD_SYSTEM_PROBE_RUNTIME_SECURITY_CONFIG_ENABLED",
      "value": "true",
      "description": "Enable Runtime Security in System Probe",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_RUNTIME_SECURITY_CONFIG_RUNTIME_COMPILER_ENABLED",
      "key": "DD_RUNTIME_SECURITY_CONFIG_RUNTIME_COMPILER_ENABLED",
      "value": "true",
      "description": "Enable Runtime Compiler for Security",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_SECURITY_AGENT_V1_ENABLED",
      "key": "DD_SECURITY_AGENT_V1_ENABLED",
      "value": "true",
      "description": "Enable Security Agent (Legacy)",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_RUNTIME_SECURITY_CONFIG_REMOTE_CONFIGURATION_ENABLED",
      "key": "DD_RUNTIME_SECURITY_CONFIG_REMOTE_CONFIGURATION_ENABLED",
      "value": "true",
      "description": "Enable Remote Configuration for Runtime Security",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_CLOUD_PROVIDER_METADATA",
      "key": "DD_CLOUD_PROVIDER_METADATA",
      "value": "[]",
      "description": "Cloud Provider Metadata (set to [] to disable cloud auto-detection on Unraid)",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_SYSTEM_PROBE_CONFIG_ENABLE_RUNTIME_COMPILER",
      "key": "DD_SYSTEM_PROBE_CONFIG_ENABLE_RUNTIME_COMPILER",
      "value": "true",
      "description": "Enable System Probe Runtime Compiler",
      "required": false,
      "mask": false
    },
    {
      "name": "DD_SYSTEM_PROBE_CONFIG_ENABLE_BTF",
      "key": "DD_SYSTEM_PROBE_CONFIG_ENABLE_BTF",
      "value": "true",
      "description": "Enable System Probe BTF",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
