{
  "name": "redis-stack",
  "repo": "redis/redis-stack:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/redis/redis-stack",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8001]/",
  "icon": "https://www.gravatar.com/avatar/d97b18081fdbcb9838acfeaa4335e3d3",
  "project": "https://redis.io",
  "description": "redis-stack installs a Redis server with additional database capabilities and the RedisInsight.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/redis_stack/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the app data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": "Container Port: 8001",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis Port",
      "host": "6379",
      "container": "6379",
      "protocol": "tcp",
      "description": "Redis Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
