{
  "name": "amule",
  "repo": "ngosang/amule",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/ngosang/amule",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4711]",
  "icon": "https://github.com/riffsphereha/Unraid-Templates/blob/main/amule/amule.png?raw=true",
  "project": "https://www.amule.org/",
  "description": "aMule is a free peer-to-peer file sharing utility that works with the eDonkey network and the Kad network, offering similar features to eMule and adding others such as GeoIP (country flags).",
  "paths": [
    {
      "name": "AppData",
      "host": "",
      "container": "/home/amule/.aMule",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Complete Downloads",
      "host": "",
      "container": "/incoming",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Incomplete Downloads",
      "host": "",
      "container": "/temp",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4711",
      "container": "4711",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Remote UI",
      "host": "4712",
      "container": "4712",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "ed2k tcp port",
      "host": "4662",
      "container": "4662",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "ed2k global search",
      "host": "4665",
      "container": "4665",
      "protocol": "udp",
      "description": "Has to be ed2k tcp port +3",
      "required": true,
      "mask": false
    },
    {
      "name": "ed2k udp port",
      "host": "4672",
      "container": "4672",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Password",
      "key": "WEBUI_PWD",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Remote Password",
      "key": "GUI_PWD",
      "value": "",
      "description": "Password used by other tools using the Remote UI port (like amarr)",
      "required": true,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MOD_FIX_KAD_GRAPH_ENABLE",
      "key": "MOD_FIX_KAD_GRAPH_ENABLE",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MOD_FIX_KAD_BOOTSTRAP_ENABLED",
      "key": "MOD_FIX_KAD_BOOTSTRAP_ENABLED",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
