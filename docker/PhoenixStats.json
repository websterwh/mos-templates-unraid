{
  "name": "PhoenixStats",
  "repo": "lnxd/phoenixstats",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/lnxd/phoenixstats",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/lnxd/docker-phoenixstats/master/phoenixstats-logo.png",
  "project": null,
  "description": "Simple container for displaying stats from any PhoenixMiner instance. Made to go with PhoenixMiner-AMD.",
  "paths": [],
  "ports": [
    {
      "name": "Apache",
      "host": "5449",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Name",
      "key": "S_NAME",
      "value": "Unraid",
      "description": "Server name for miner (Can be set to anything)",
      "required": false,
      "mask": false
    },
    {
      "name": "Miner Host",
      "key": "S_HOST",
      "value": "unraid.local",
      "description": "Host for miner (usually an IP)",
      "required": false,
      "mask": false
    },
    {
      "name": "Miner Port",
      "key": "S_PORT",
      "value": "5450",
      "description": "Port shared by miner over http (usually 5450)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
