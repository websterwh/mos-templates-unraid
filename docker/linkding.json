{
  "name": "linkding",
  "repo": "sissbruecker/linkding",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/sissbruecker/linkding/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9090]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/linkding.png",
  "project": "https://github.com/sissbruecker/linkding",
  "description": "linkding is a simple bookmark service that you can host yourself. Creating user by using console \"python manage.py createsuperuser --username=joe --email=joe@example.com\"",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/linkding/",
      "container": "/etc/linkding/data",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
