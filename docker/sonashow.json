{
  "name": "sonashow",
  "repo": "thewicklowwolf/sonashow:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/thewicklowwolf/sonashow",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/TheWicklowWolf/SonaShow/59934ecdd6b2d2edb21f8591c125ef8c269af965/src/static/sonashow.png",
  "project": "https://github.com/TheWicklowWolf/SonaShow?tab=readme-ov-file",
  "description": "Web GUI for finding similar shows to selected Sonarr shows.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/sonashow",
      "container": "/sonashow/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
