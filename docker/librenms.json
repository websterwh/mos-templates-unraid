{
  "name": "librenms",
  "repo": "librenms/librenms:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/librenms/librenms/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/librenms.png",
  "project": "https://www.librenms.org/",
  "description": "a fully featured network monitoring system that provides a wealth of features and device support. Database must be CHARACTER SET utf8 COLLATE utf8_unicode_ci For Poller to work please follow https://forums.Unraid.net/topic/89502-support-a75g-repo/?do=findComment&comment=1318785",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/librenms/",
      "container": "/data",
      "mode": "rw",
      "description": "Appdata",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "6980",
      "container": "8000",
      "protocol": "tcp",
      "description": "HTTP Port",
      "required": false,
      "mask": false
    },
    {
      "name": "Syslog Port",
      "host": "514",
      "container": "514",
      "protocol": "udp",
      "description": "Syslog Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MEMORY_LIMIT",
      "key": "MEMORY_LIMIT",
      "value": "256M",
      "description": "PHP memory limit",
      "required": false,
      "mask": false
    },
    {
      "name": "UPLOAD_MAX_SIZE",
      "key": "UPLOAD_MAX_SIZE",
      "value": "16M",
      "description": "Upload max size",
      "required": false,
      "mask": false
    },
    {
      "name": "OPCACHE_MEM_SIZE",
      "key": "OPCACHE_MEM_SIZE",
      "value": "128",
      "description": "PHP OpCache memory consumption",
      "required": false,
      "mask": false
    },
    {
      "name": "LISTEN_IPV6",
      "key": "LISTEN_IPV6",
      "value": "true",
      "description": "Enable IPv6 for Nginx",
      "required": false,
      "mask": false
    },
    {
      "name": "REAL_IP_FROM",
      "key": "REAL_IP_FROM",
      "value": "0.0.0.0/32",
      "description": "Trusted addresses that are known to send correct replacement addresses",
      "required": false,
      "mask": false
    },
    {
      "name": "REAL_IP_HEADER",
      "key": "REAL_IP_HEADER",
      "value": "X-Forwarded-For",
      "description": "Request header field whose value will be used to replace the client address",
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_IP_VAR",
      "key": "LOG_IP_VAR",
      "value": "remote_addr",
      "description": "Use another variable to retrieve the remote IP address for access log_format on Nginx.",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "192.168.0.100",
      "description": "MySQL database hostname / IP address",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "3306",
      "description": "MySQL database port",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "librenms",
      "description": "MySQL database name",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "librenms",
      "description": "MySQL user",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "librenms",
      "description": "MySQL password",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_TIMEOUT",
      "key": "DB_TIMEOUT",
      "value": "60",
      "description": "Time in seconds after which we stop trying to reach the MySQL server",
      "required": false,
      "mask": false
    },
    {
      "name": "LIBRENMS_BASE_URL",
      "key": "LIBRENMS_BASE_URL",
      "value": "/",
      "description": "URL of your LibreNMS instance",
      "required": false,
      "mask": false
    },
    {
      "name": "LIBRENMS_SNMP_COMMUNITY",
      "key": "LIBRENMS_SNMP_COMMUNITY",
      "value": "public",
      "description": "This container's SNMP v2c community string",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
