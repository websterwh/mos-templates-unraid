{
  "name": "Koffan",
  "repo": "ghcr.io/pansalut/koffan:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://ghcr.io/pansalut/koffan",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/PanSalut/Koffan/main/static/icon-192.png",
  "project": "https://github.com/PanSalut/Koffan",
  "description": "Koffan is a lightweight, self-hosted shopping list app designed for families and couples. Features: - Real-time sync (WebSockets) - Offline-first / PWA support - Minimal resource usage - Simple password-based auth Change APP_PASSWORD on first install.",
  "paths": [
    {
      "name": "AppData Directory",
      "host": "/mnt/cache/appdata/koffan",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Application Password",
      "key": "APP_PASSWORD",
      "value": "change-me",
      "description": "Login password for Koffan (CHANGE THIS)",
      "required": true,
      "mask": true
    },
    {
      "name": "Application Environment",
      "key": "APP_ENV",
      "value": "development",
      "description": "Set to 'production' when using HTTPS or reverse proxy",
      "required": false,
      "mask": false
    },
    {
      "name": "Disable Authentication",
      "key": "DISABLE_AUTH",
      "value": "false",
      "description": "Disable login entirely (ONLY if proxy handles auth)",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Path",
      "key": "DB_PATH",
      "value": "/data/shopping.db",
      "description": "SQLite database file location",
      "required": false,
      "mask": false
    },
    {
      "name": "Default Language",
      "key": "DEFAULT_LANG",
      "value": "en",
      "description": "UI language (en, no, de, fr, es, pl, pt, uk, lt)",
      "required": false,
      "mask": false
    },
    {
      "name": "API Token",
      "key": "API_TOKEN",
      "value": "",
      "description": "Optional REST API token (leave empty to disable)",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
