{
  "name": "WordPress",
  "repo": "wordpress",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/_/wordpress/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://s.w.org/style/images/about/WordPress-logotype-wmark.png",
  "project": "https://wordpress.org/",
  "description": "WordPress is a free and open source blogging tool and a content management system (CMS) based on PHP and MySQL, which runs on a web hosting service. Use MariaDB (recommended) or Mysql as the external database.",
  "paths": [
    {
      "name": "www",
      "host": "/mnt/cache/appdata/wordpress",
      "container": "/var/www/html",
      "mode": "rw",
      "description": "Container Path: /var/www/html",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Container port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Connects to internal port 80 (Ex. 8080:80)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "WORDPRESS_DB_HOST",
      "key": "WORDPRESS_DB_HOST",
      "value": "",
      "description": "External database container hostname and port &lt;br&gt;ex. 192.168.1.100:8080",
      "required": false,
      "mask": false
    },
    {
      "name": "WORDPRESS_DB_USER",
      "key": "WORDPRESS_DB_USER",
      "value": "",
      "description": "External database user",
      "required": false,
      "mask": false
    },
    {
      "name": "WORDPRESS_DB_PASSWORD",
      "key": "WORDPRESS_DB_PASSWORD",
      "value": "",
      "description": "External database password",
      "required": false,
      "mask": false
    },
    {
      "name": "WORDPRESS_DB_NAME",
      "key": "WORDPRESS_DB_NAME",
      "value": "",
      "description": "The WORDPRESS_DB_NAME needs to already exist on the given DB server; it will not be created by the wordpress container.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
