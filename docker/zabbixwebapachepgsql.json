{
  "name": "zabbix-web-apache-pgsql",
  "repo": "zabbix/zabbix-web-apache-pgsql",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/zabbix/zabbix-web-apache-pgsql/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/andaks/unraid-templates/master/zabbix/Zabbix_logo.jpg",
  "project": "https://www.zabbix.com/",
  "description": "Zabbix web-interface based on Apache2 web server with PostgreSQL database support. Zabbix web interface is a part of Zabbix software. It is used to manage resources under monitoring and view monitoring statistics.",
  "paths": [
    {
      "name": "Rebrand Path",
      "host": "/mnt/cache/appdata/zabbix-web-apache-pgsql/rebrand",
      "container": "/usr/share/zabbix/local/conf",
      "mode": "rw",
      "description": "Configuration path for rebrand (https://www.initmax.com/wiki/zabbix-rebranding/)",
      "required": false
    },
    {
      "name": "Rebrand Logo Path",
      "host": "/mnt/cache/appdata/zabbix-web-apache-pgsql/logo",
      "container": "/usr/share/zabbix/assets/img/rebrand",
      "mode": "rw",
      "description": "Rebrand logo directory",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8085",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port for HTTP Access",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database Server",
      "key": "DB_SERVER_HOST",
      "value": "SERVER_HOST",
      "description": "IP or DNS name of PostgreSQL server",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "DB_SERVER_PORT",
      "value": "5432",
      "description": "Port of PostgreSQL server. By default, value is '5432'.",
      "required": true,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "POSTGRES_USER",
      "value": "DB_USER",
      "description": "Database User",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "POSTGRES_PASSWORD",
      "value": "DB_PASS",
      "description": "Database Password",
      "required": true,
      "mask": true
    },
    {
      "name": "Database Name",
      "key": "POSTGRES_DB",
      "value": "zabbix",
      "description": "Zabbix database name. By default, value is zabbix",
      "required": true,
      "mask": false
    },
    {
      "name": "Zabbix Server Host",
      "key": "ZBX_SERVER_HOST",
      "value": "ZBX_HOST",
      "description": "IP or DNS name of Zabbix server. By default, value is zabbix-server.",
      "required": true,
      "mask": false
    },
    {
      "name": "Zabbix Server Port",
      "key": "ZBX_SERVER_PORT",
      "value": "10051",
      "description": "Port Zabbix server listening on.",
      "required": true,
      "mask": false
    },
    {
      "name": "PHP Timezone",
      "key": "PHP_TZ",
      "value": "Asia/Kuala_Lumpur",
      "description": "The variable is timezone in PHP format. Full list of supported timezones are available on php.net",
      "required": false,
      "mask": false
    },
    {
      "name": "Zabbix Server Name",
      "key": "ZBX_SERVER_NAME",
      "value": "My Zabbix Instance",
      "description": "The variable is visible Zabbix installation name in right or left top corner of the web interface.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
