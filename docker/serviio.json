{
  "name": "serviio",
  "repo": "soerentsch/serviio",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/soerentsch/serviio",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:23423]/console",
  "icon": "https://i.imgur.com/Pcals31.png",
  "project": "https://serviio.org/",
  "description": "Serviio media and DLNA server. Based on Alpine Linux Edge",
  "paths": [
    {
      "name": "Media path",
      "host": "/mnt/cache/media/",
      "container": "/media/serviio",
      "mode": "rw",
      "description": "Container Path: /media/serviio",
      "required": false
    },
    {
      "name": "Serviio DB path",
      "host": "/mnt/cache/appdata/serviio/library",
      "container": "/opt/serviio/library",
      "mode": "rw",
      "description": "Container Path: /opt/serviio/library",
      "required": false
    },
    {
      "name": "Serviio plugins path",
      "host": "/mnt/cache/appdata/serviio/plugins",
      "container": "/opt/serviio/plugins",
      "mode": "rw",
      "description": "Container Path: /opt/serviio/plugins",
      "required": false
    },
    {
      "name": "Serviio log path",
      "host": "/mnt/cache/appdata/serviio/log",
      "container": "/opt/serviio/log",
      "mode": "rw",
      "description": "Container Path: /opt/serviio/log",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "DLNA",
      "host": "1900",
      "container": "1900",
      "protocol": "udp",
      "description": "Container Port: 1900",
      "required": false,
      "mask": false
    },
    {
      "name": "Serviio Content Delivery",
      "host": "8895",
      "container": "8895",
      "protocol": "tcp",
      "description": "Container Port: 8895",
      "required": false,
      "mask": false
    },
    {
      "name": "Webconsole (HTTP)",
      "host": "23423",
      "container": "23423",
      "protocol": "tcp",
      "description": "Container Port: 23423",
      "required": false,
      "mask": false
    },
    {
      "name": "Mediabrowser (HTTP)",
      "host": "23424",
      "container": "23424",
      "protocol": "tcp",
      "description": "Container Port: 23424",
      "required": false,
      "mask": false
    },
    {
      "name": "Webconsole (HTTPS)",
      "host": "23523",
      "container": "23523",
      "protocol": "tcp",
      "description": "Container Port: 23523",
      "required": false,
      "mask": false
    },
    {
      "name": "Mediabrowser (HTTPS)",
      "host": "23524",
      "container": "23524",
      "protocol": "tcp",
      "description": "Container Port: 23524",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
