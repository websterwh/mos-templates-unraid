{
  "name": "openobserve",
  "repo": "public.ecr.aws/zinclabs/openobserve:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/openobserve/openobserve/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5080]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/openobserve.png",
  "project": "https://openobserve.ai/",
  "description": "a simple yet sophisticated log search, infrastructure monitoring, and APM solution. It is a full-fledged observability platform that can reduce your storage costs by ~140x compared to other solutions and requires much lower resource utilization resulting in much lower cost.",
  "paths": [
    {
      "name": "Path 1",
      "host": "/mnt/cache/appdata/openobserve",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "5080",
      "container": "5080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Username",
      "key": "ZO_ROOT_USER_EMAIL",
      "value": "root@example.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Password",
      "key": "ZO_ROOT_USER_PASSWORD",
      "value": "Complexpass#123",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
