{
  "name": "pterodactyl-daemon",
  "repo": "ccarney16/pterodactyl-daemon:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/ccarney16/pterodactyl-daemon",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--privileged=true --restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2022]",
  "icon": "https://raw.githubusercontent.com/ibracorp/unraid-templates/master/icons/pterodactyl-panel.png",
  "project": "https://pterodactyl.io/",
  "description": "Pterodactyl is an open-source game server management panel built with PHP 7, React, and Go. Designed with security in mind, Pterodactyl runs all game servers in isolated Docker containers while exposing a beautiful and intuitive UI to end users. Find a guide on how to get this up and running at https://docs.ibracorp.io",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/pterodactyl-node/",
      "container": "/etc/pterodactyl",
      "mode": "rw",
      "description": "Container Path: /etc/pterodactyl",
      "required": true
    },
    {
      "name": "docker.sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Container Path: /var/run/docker.sock",
      "required": true
    },
    {
      "name": "data",
      "host": "/mnt/cache/pterodactyl-node/data",
      "container": "/mnt/user/pterodactyl-node/data",
      "mode": "rw",
      "description": "Container Path: /mnt/user/pterodactyl-node/data",
      "required": false
    },
    {
      "name": "tmp",
      "host": "/tmp/pterodactyl",
      "container": "/tmp/pterodactyl",
      "mode": "rw",
      "description": "Container Path: /tmp/pterodactyl",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "2022",
      "container": "2022",
      "protocol": "tcp",
      "description": "Container Port: 2022",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "8181",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
