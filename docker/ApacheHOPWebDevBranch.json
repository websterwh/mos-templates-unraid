{
  "name": "Apache-HOP-Web-DevBranch",
  "repo": "apache/hop:Development",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/apache/hop-web/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:10880]/ui/",
  "icon": "https://d36jcksde1wxzq.cloudfront.net/be7833db9bddb4494d2a7c3dd659199a.png",
  "project": "https://hop.apache.org/",
  "description": "Built this into the Dev Branch, as Production is 2 months old.",
  "paths": [
    {
      "name": "Config Storage Path",
      "host": "/mnt/cache/appdata/hopwebdev",
      "container": "",
      "mode": "rw",
      "description": "This is where Apache Hop-Web will store its databases and configuration.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Interface Port",
      "host": "10880",
      "container": "10880",
      "protocol": "tcp",
      "description": "This is HOPs Web UI port you can access via a web browser.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
