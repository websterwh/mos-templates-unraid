{
  "name": "EmBoxd",
  "repo": "ghcr.io/computer-geek64/emboxd:v0.1.0",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/computer-geek64/emboxd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/emboxd-icon.png",
  "project": "https://github.com/computer-geek64/emboxd",
  "description": "Provides live integration with Letterboxd for users of self-hosted media servers. It tracks watch activity on the media server and synchronizes Letterboxd user data to match. Changes to a movie's played status are reflected in the user's watched films, and movies that are fully played are logged in the user's diary.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/emboxd/config",
      "container": "/config",
      "mode": "ro",
      "description": "Path to config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
