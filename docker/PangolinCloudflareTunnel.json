{
  "name": "Pangolin-Cloudflare-Tunnel",
  "repo": "hhftechnology/pangolin-cloudflare-tunnel:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/hhftechnology/pangolin-cloudflare-tunnel",
  "network": "pangolin_network",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/pangolin-cloudflare-tunnel-icon.png",
  "project": "https://github.com/hhftechnology/pangolin-cloudflare-tunnel",
  "description": "A bridge between Traefik and Cloudflare Zero-Trust tunnels that enables Pangolin users to leverage Cloudflare's global network alongside WireGuard tunnels.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Cloudflare - API Token",
      "key": "CLOUDFLARE_API_TOKEN",
      "value": "",
      "description": "Cloudflare API Token with permissions to manage tunnels",
      "required": true,
      "mask": true
    },
    {
      "name": "Cloudflare - Account ID",
      "key": "CLOUDFLARE_ACCOUNT_ID",
      "value": "",
      "description": "Cloudflare Account ID",
      "required": true,
      "mask": false
    },
    {
      "name": "Cloudflare - Tunnel ID",
      "key": "CLOUDFLARE_TUNNEL_ID",
      "value": "",
      "description": "Cloudflare Tunnel ID",
      "required": true,
      "mask": false
    },
    {
      "name": "Cloudflare - Zone ID",
      "key": "CLOUDFLARE_ZONE_ID",
      "value": "",
      "description": "Cloudflare Zone ID",
      "required": true,
      "mask": false
    },
    {
      "name": "Traefik - Service Endpoint",
      "key": "TRAEFIK_SERVICE_ENDPOINT",
      "value": "https://TRAEFIK_IP_ADDRESS:443",
      "description": "Traefik service endpoint",
      "required": true,
      "mask": false
    },
    {
      "name": "Traefik - API Endpoint",
      "key": "TRAEFIK_API_ENDPOINT",
      "value": "http://TRAEFIK_IP_ADDRESS:8080",
      "description": "Traefik API endpoint",
      "required": true,
      "mask": false
    },
    {
      "name": "Traefik - Entrypoints",
      "key": "TRAEFIK_ENTRYPOINTS",
      "value": "web,websecure",
      "description": "Comma-separated list of Traefik entrypoints",
      "required": true,
      "mask": false
    },
    {
      "name": "Poll Interval",
      "key": "POLL_INTERVAL",
      "value": "10s",
      "description": "Interval to poll Traefik for changes",
      "required": true,
      "mask": false
    },
    {
      "name": "Skip TLS Routes",
      "key": "SKIP_TLS_ROUTES",
      "value": "false|true",
      "description": "Skip TLS routes when creating tunnels",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "info|debug|warn|error",
      "description": "Log level for the application",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
