{
  "name": "invidious",
  "repo": "quay.io/invidious/invidious",
  "category": [
    "Network"
  ],
  "registry": "https://quay.io/repository/invidious/invidious",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/Joshndroid/joshndroid-unraid-docker-templates/main/icons/invidious.png",
  "project": "https://github.com/iv-org/invidious",
  "description": "An open source alternative front-end to YouTube",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/invidious/config/",
      "container": "/invidious/config",
      "mode": "rw",
      "description": "Config",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Webgui port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
