{
  "name": "ViniPlay",
  "repo": "ardovini/viniplay:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/ardovini/viniplay",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8998]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/viniplay-icon.png",
  "project": "https://github.com/ardoviniandrea/ViniPlay",
  "description": "A powerful, self-hosted IPTV player with a modern web interface. Stream your M3U playlists with EPG data, manage users, cast to your TV, and watch multiple channels at once. For Nvidia GPU transcoding support, add \"--gpus all\" to the Extra Parameters field under Advanced.",
  "paths": [
    {
      "name": "DVR Recordings",
      "host": "/mnt/cache/dvr/viniplay/dvr",
      "container": "/dvr",
      "mode": "rw",
      "description": "Path to DVR recordings",
      "required": true
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/viniplay/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8998",
      "container": "8998",
      "protocol": "tcp",
      "description": "Container Port: 8998",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Session Secret",
      "key": "SESSION_SECRET",
      "value": "",
      "description": "A long random string used to secure sessions",
      "required": true,
      "mask": true
    },
    {
      "name": "VAPID Contact Email",
      "key": "VAPID_CONTACT_EMAIL",
      "value": "mailto:admin@example.com",
      "description": "Add a contact email for VAPID push notifications. This is required by push services. It should start with mailto:",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
