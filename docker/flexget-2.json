{
  "name": "flexget",
  "repo": "lscr.io/linuxserver/flexget",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/flexget",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5050]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "http://flexget.com/",
  "description": "Flexget(http://flexget.com/) is a multipurpose automation tool for all of your media.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Local path for FlexGet config files.",
      "required": true
    },
    {
      "name": "Path: /data",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Default path for downloads.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5050",
      "container": "5050",
      "protocol": "tcp",
      "description": "HTTP port for the WebUI.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "FG_LOG_LEVEL",
      "key": "FG_LOG_LEVEL",
      "value": "info",
      "description": "Set the FlexGet logging level.",
      "required": true,
      "mask": false
    },
    {
      "name": "FG_LOG_FILE",
      "key": "FG_LOG_FILE",
      "value": "/config/flexget.log",
      "description": "Set the FlexGet log file location.",
      "required": true,
      "mask": false
    },
    {
      "name": "FG_CONFIG_FILE",
      "key": "FG_CONFIG_FILE",
      "value": "/config/.flexget/config.yml",
      "description": "Set the FlexGet config file location.",
      "required": true,
      "mask": false
    },
    {
      "name": "FG_WEBUI_PASSWORD",
      "key": "FG_WEBUI_PASSWORD",
      "value": "info",
      "description": "Set the FlexGet webui password. Pay attention to Bash/YAML reserved characters.",
      "required": false,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
