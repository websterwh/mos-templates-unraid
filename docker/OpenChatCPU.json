{
  "name": "OpenChat-CPU",
  "repo": "ghcr.io/edgar971/open-chat-cpu:v1.0.6",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/edgar971/open-chat-cpu",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://github.com/edgar971/open-chat/raw/main/logo.png",
  "project": "https://github.com/edgar971/open-chat",
  "description": "A self-hosted, offline, ChatGPT-like chatbot with open source LLM support. 100% private, with no data leaving your device.",
  "paths": [
    {
      "name": "Model Directory",
      "host": "/mnt/cache/appdata/models",
      "container": "/models",
      "mode": "rw",
      "description": "The local model directory to use as a cache",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Chat UI Port",
      "required": false,
      "mask": false
    },
    {
      "name": "API Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "HTTP API Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Local Model Path",
      "key": "MODEL",
      "value": "/models/llama-2-7b-chat.bin",
      "description": "The local model path",
      "required": true,
      "mask": false
    },
    {
      "name": "Model Download URL",
      "key": "MODEL_DOWNLOAD_URL",
      "value": "https://huggingface.co/TheBloke/Llama-2-7B-Chat-GGML/resolve/main/llama-2-7b-chat.ggmlv3.q4_0.bin",
      "description": "GGML Model Binary.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
