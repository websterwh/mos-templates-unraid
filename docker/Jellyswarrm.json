{
  "name": "Jellyswarrm",
  "repo": "ghcr.io/llukas22/jellyswarrm:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/llukas22/jellyswarrm/pkgs/container/jellyswarrm",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/master/logos/jellyswarrm.png",
  "project": "https://github.com/llukas22/jellyswarrm",
  "description": "Combine all your Jellyfin Servers into one.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/jellyswarrm",
      "container": "/app/data",
      "mode": "rw",
      "description": "Specify the path to the data directory.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Jellyswarrm Username",
      "key": "JELLYSWARRM_USERNAME",
      "value": "",
      "description": "The username for the Jellyswarrm server.",
      "required": true,
      "mask": false
    },
    {
      "name": "Jellyswarrm Password",
      "key": "JELLYSWARRM_PASSWORD",
      "value": "",
      "description": "The password for the Jellyswarrm server.",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
