{
  "name": "Streamyfin---Optimised-Versions",
  "repo": "fredrikburmester/streamyfin-optimized-versions-server:master",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/streamyfin/optimized-versions-server",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/master/logos/streamyfin.png",
  "project": "https://github.com/streamyfin/optimized-versions-server",
  "description": "A streamyfin companion server program to transcode videos into a supported format before downloading.",
  "paths": [
    {
      "name": "Cache Path",
      "host": "/mnt/cache/appdata/streamyfin-optimised-versions",
      "container": "/usr/src/app/cache",
      "mode": "rw",
      "description": "Specify the path to the cache directory.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Jellyfin URL",
      "key": "JELLYFIN_URL",
      "value": "http://jellyfin:8096",
      "description": "Specify the URL to your Jellyfin instance.",
      "required": true,
      "mask": false
    },
    {
      "name": "Max Concurrent Jobs",
      "key": "MAX_CONCURRENT_JOBS",
      "value": "1",
      "description": "Specify the maximum number of concurrent jobs to run.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
