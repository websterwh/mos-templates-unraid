{
  "name": "Portabase-Dashboard",
  "repo": "portabase/portabase:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/portabase/portabase",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://avatars.githubusercontent.com/u/249081024?s=200&v=4",
  "project": "https://github.com/Portabase/portabase",
  "description": "Portabase is a tool designed to simplify the backup and restoration of your database instances",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/portabase/dashboard",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8887",
      "container": "80",
      "protocol": "tcp",
      "description": "Host port for the Portabase web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database String",
      "key": "DATABASE_URL",
      "value": "",
      "description": "enter in the format of postgresql://{Username}:{Secret}@{hostname or ip}:{port}/{Database Name}?schema=public i.e. postgresql://username:password@hostname:1234/portabase?schema=public",
      "required": true,
      "mask": true
    },
    {
      "name": "New User Registration Allowed",
      "key": "AUTH_SIGNUP_ENABLED",
      "value": "",
      "description": "true/false set to true to enable new user registration from the login page. Required for initial setup if not passing a user via Default User Name, Default User, and Default Password",
      "required": true,
      "mask": false
    },
    {
      "name": "Passkey Auth Enabled",
      "key": "AUTH_PASSKEY_ENABLED",
      "value": "true",
      "description": "true/false Allow Passkey authentication",
      "required": true,
      "mask": false
    },
    {
      "name": "Project URL",
      "key": "PROJECT_URL",
      "value": "",
      "description": "URL of your Portabase dashboard as reachable from your agents i.e. http://portabase.local or https://portabase.myfancydomain.com",
      "required": true,
      "mask": false
    },
    {
      "name": "Project Secret",
      "key": "PROJECT_SECRET",
      "value": "",
      "description": "Secret for your Portabase installation. Must be a hex token i.e. openssl rand -hex 32",
      "required": true,
      "mask": true
    },
    {
      "name": "Default User Name",
      "key": "AUTH_DEFAULT_USER_NAME",
      "value": "",
      "description": "Default User Name (i.e. first {space} last, or nickname)",
      "required": false,
      "mask": false
    },
    {
      "name": "Default User Email",
      "key": "AUTH_DEFAULT_USER",
      "value": "",
      "description": "Default User Email Address",
      "required": false,
      "mask": false
    },
    {
      "name": "Default User Password",
      "key": "AUTH_DEFAULT_PASSWORD",
      "value": "",
      "description": "Default Password",
      "required": false,
      "mask": true
    },
    {
      "name": "Project Name",
      "key": "PROJECT_NAME",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Retention Cron",
      "key": "RETENTION_CRON",
      "value": "0 0 * * *",
      "description": "Schedule for automatic deletion of backups according to the retention policies.",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Host",
      "key": "SMTP_HOST",
      "value": "",
      "description": "SMTP server address (e.g. smtp.resend.com)",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Port",
      "key": "SMTP_PORT",
      "value": "",
      "description": "SMTP server port (e.g. 587)",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP User",
      "key": "SMTP_USER",
      "value": "",
      "description": "SMTP username",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Password",
      "key": "SMTP_PASSWORD",
      "value": "",
      "description": "SMTP password",
      "required": false,
      "mask": true
    },
    {
      "name": "SMTP From",
      "key": "SMTP_FROM",
      "value": "",
      "description": "From email address (e.g. no-reply@your-domain.com)",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Secure",
      "key": "SMTP_SECURE",
      "value": "false",
      "description": "Enable SMTP TLS/SSL (true/false)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
