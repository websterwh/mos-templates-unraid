{
  "name": "Alexa-Subwatch",
  "repo": "simplysublime/alexa-subwatch:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/simplysublime/alexa-subwatch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/alexa-subwatch-icon.png",
  "project": "https://github.com/senpaiSubby/alexa-subwatch",
  "description": "Ask Alexa to add movie and shows to Radarr and Sonarr.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/alexa_subwatch/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
