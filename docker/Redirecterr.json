{
  "name": "Redirecterr",
  "repo": "varthe/redirecterr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/varthe/redirecterr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8481]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/redirecterr-icon.png",
  "project": "https://github.com/varthe/Redirecterr",
  "description": "Filter and redirect Overseerr requests based on requester, keywords, age ratings, and more. Supports routing to multiple instances simultaneously.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/redirecterr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration data",
      "required": true
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/redirecterr/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Path to log files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8481",
      "container": "8481",
      "protocol": "tcp",
      "description": "Container Port: 8481",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "info|debug|warn|error",
      "description": "Log level",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
