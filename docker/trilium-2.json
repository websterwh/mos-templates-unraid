{
  "name": "trilium",
  "repo": "ghcr.io/triliumnext/trilium:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/triliumnext/trilium",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/triliumnext.png",
  "project": "https://github.com/TriliumNext/Trilium",
  "description": "Trilium Notes is an open-source, cross-platform hierarchical note-taking application with focus on building large personal knowledge bases.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/trilium",
      "container": "/home/node/trilium-data",
      "mode": "rw",
      "description": "Container Path: /home/node/trilium-data",
      "required": true
    },
    {
      "name": "Backups",
      "host": "/mnt/cache/appdata/trilium/backup",
      "container": "/home/node/trilium-data/backup",
      "mode": "rw",
      "description": "Container Path: /home/node/trilium-data/backup",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9999",
      "container": "8080",
      "protocol": "tcp",
      "description": "WebUI - Default 9999",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
