{
  "name": "satisfactory-server",
  "repo": "wolveix/satisfactory-server",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/wolveix/satisfactory-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7777]",
  "icon": "https://img2.storyblok.com/fit-in/0x200/filters:format(webp)/f/110098/268x268/d1ebbafe03/logo.png",
  "project": "https://hub.docker.com/r/wolveix/satisfactory-server",
  "description": "This is a Dockerized version of the Satisfactory dedicated server.",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/unraid-satisfactory-server",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Game port",
      "host": "7777",
      "container": "7777",
      "protocol": "udp",
      "description": "Set the game's port",
      "required": false,
      "mask": false
    },
    {
      "name": "Game port",
      "host": "7777",
      "container": "7777",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Game port",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MAXPLAYERS",
      "key": "MAXPLAYERS",
      "value": "4",
      "description": "Set the player limit for your server.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Set the group ID of the user the server will run as",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Set the user ID of the user the server will run as",
      "required": false,
      "mask": false
    },
    {
      "name": "Steam beta",
      "key": "STEAMBETA",
      "value": "false",
      "description": "Set experimental game version",
      "required": false,
      "mask": false
    },
    {
      "name": "Memory",
      "key": "memory",
      "value": "6G",
      "description": "Recent updates consume 4GB - 6GB RAM, but the official wiki recommends allocating 12GB - 16GB RAM.",
      "required": true,
      "mask": false
    },
    {
      "name": "Memory Reservation",
      "key": "memory-reservation",
      "value": "4G",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "AUTOPAUSE",
      "key": "AUTOPAUSE",
      "value": "true",
      "description": "Pause game when no player is connected",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
