{
  "name": "dolibarr",
  "repo": "dolibarr/dolibarr",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dolibarr/dolibarr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/kilrah/unraid-docker-templates/raw/main/icons/dolibarr.png",
  "project": "https://www.dolibarr.org/",
  "description": "Open Source ERP and CRM for business. Default login is admin/admin. Database creation takes a few minutes on first launch.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dolibarr/documents",
      "container": "/var/www/documents/",
      "mode": "rw",
      "description": "Data location",
      "required": true
    },
    {
      "name": "Modules",
      "host": "/mnt/cache/appdata/dolibarr/modules",
      "container": "/var/www/html/custom",
      "mode": "rw",
      "description": "Data location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB Host",
      "key": "DOLI_DB_HOST",
      "value": "",
      "description": "MySQL Database Host",
      "required": true,
      "mask": false
    },
    {
      "name": "DB Port",
      "key": "DOLI_DB_HOST_PORT",
      "value": "3306",
      "description": "MySQL Database Port",
      "required": true,
      "mask": false
    },
    {
      "name": "DB User",
      "key": "DOLI_DB_USER",
      "value": "",
      "description": "Database User",
      "required": true,
      "mask": false
    },
    {
      "name": "DB Password",
      "key": "DOLI_DB_PASSWORD",
      "value": "",
      "description": "Database Password",
      "required": true,
      "mask": true
    },
    {
      "name": "DB Name",
      "key": "DOLI_DB_NAME",
      "value": "",
      "description": "Database Name",
      "required": true,
      "mask": false
    },
    {
      "name": "Root URL",
      "key": "DOLI_URL_ROOT",
      "value": "",
      "description": "URL you will be accessing the site with",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "PHP_INI_DATE_TIMEZONE",
      "value": "Europe/Paris",
      "description": "Timezone",
      "required": false,
      "mask": false
    },
    {
      "name": "User",
      "key": "WWW_USER_ID",
      "value": "99",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "Group",
      "key": "WWW_GROUP_ID",
      "value": "100",
      "description": "Group ID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
