{
  "name": "wyzesense2mqtt",
  "repo": "raetha/wyzesense2mqtt",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/raetha/wyzesense2mqtt/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://github.com/digiblur/unraid-docker-templates/raw/master/images/wyzesense2mqtt.png",
  "project": null,
  "description": "Configurable WyzeSense to MQTT Gateway for Home Assistant. Refer to the WyzeSense2MQTT docs for configuration. Change your hidraw port to pass into the container as necessary.",
  "paths": [
    {
      "name": "ConfigPath",
      "host": "/mnt/cache/appdata/wyzesense2mqtt/config",
      "container": "/wyzesense2mqtt/config",
      "mode": "rw",
      "description": "Container Path: /wyzesense2mqtt/config",
      "required": true
    },
    {
      "name": "LogsPath",
      "host": "/mnt/cache/appdata/wyzesense2mqtt/logs/",
      "container": "/mnt/user/appdata/wyzesense2mqtt/logs/",
      "mode": "rw",
      "description": "Container Path: /wyzesense2mqtt/logs",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [
    {
      "name": "WyzeSensePort",
      "host": "/dev/hidraw0",
      "container": "/dev/hidraw0",
      "description": "Container Device",
      "required": true
    }
  ],
  "labels": []
}
