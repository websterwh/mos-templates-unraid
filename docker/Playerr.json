{
  "name": "Playerr",
  "repo": "maikboarder/playerr:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/maikboarder/playerr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2727]/",
  "icon": "https://raw.githubusercontent.com/Maikboarder/Playerr/master/frontend/src/assets/app_logo.png",
  "project": "https://github.com/Maikboarder/Playerr",
  "description": "Playerr is a self-hosted game library manager and PVR, inspired by Radarr and Sonarr. It manages your game library, fetches metadata from IGDB/Steam, and handles downloads via Prowlarr/Jackett.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/playerr/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Location for Playerr configuration and database.",
      "required": true
    },
    {
      "name": "Games Library",
      "host": "/mnt/cache/games",
      "container": "/media",
      "mode": "rw",
      "description": "Location of your game library.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "2727",
      "container": "2727",
      "protocol": "tcp",
      "description": "The port for the Playerr Web UI.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
