{
  "name": "jetlog",
  "repo": "pbogre/jetlog:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/pbogre/jetlog/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/Upmacc/unraid-templates/refs/heads/main/Jetlog/Jetlog_favicon.png",
  "project": "https://github.com/pbogre/jetlog",
  "description": "Personal flight tracker and viewer Share permissions can be finicky, check your selected PUID and PGID exist in Unraid (in terminal type 'cat /etc/passwd' to see all users) and that your chosen user has permission on the file share. https://hub.docker.com/r/pbogre/jetlog/",
  "paths": [
    {
      "name": "DATA_PATH",
      "host": "/mnt/cache/appdata/jetlog/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "JETLOG_PORT",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "APP_PATH",
      "key": "APP_PATH",
      "value": "/mnt/user/appdata/jetlog",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Enter a long random string of characters",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
