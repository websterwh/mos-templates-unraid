{
  "name": "Arr-Tools",
  "repo": "ghcr.io/l4stidi0t/arr-tools/main:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/L4stIdi0t?tab=packages&repo_name=arr-tools",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9000]",
  "icon": "https://raw.githubusercontent.com/l4stidi0t/arr-tools/main/src/frontend/public/favicon/android-chrome-192x192.png",
  "project": "https://github.com/L4stIdi0t/arr-tools",
  "description": "Tools that I use to manage my media library. Main tools are Dynarr and Swipearr. But there are more tools which are unlisted here. Dynarr being a tool which automatically manages files and quality of files based on settings Swipearr is a Tinder like interface to go through the items that are in your *Arr instances",
  "paths": [
    {
      "name": "Persistent data",
      "host": "/mnt/cache/appdata/arr-tools",
      "container": "/app/backend/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Music video output",
      "host": "",
      "container": "/app/backend/musicVideoOutput",
      "mode": "rw",
      "description": "The output of downloaded music videos",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "1290",
      "container": "9000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
