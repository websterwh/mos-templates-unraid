{
  "name": "clonehero",
  "repo": "ghcr.io/funkecoder23/clonehero-server-docker",
  "category": [
    "Game Server"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/funkecoder23/clonehero-server-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:14242]",
  "icon": "https://raw.githubusercontent.com/funkecoder23/unraid-templates/master/clonehero/clonehero.png",
  "project": "https://github.com/clonehero-game/releases",
  "description": "CloneHero is an clone of the popular rhythm game, providing a fun and engaging experience for players.",
  "paths": [
    {
      "name": "Settings Dir",
      "host": "/mnt/cache/appdata/clonehero",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "14242",
      "container": "14242",
      "protocol": "udp",
      "description": "This is the game port (UDP)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Name",
      "key": "SERVER_NAME",
      "value": "CloneHeroServer",
      "description": "Server Name",
      "required": true,
      "mask": false
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": "",
      "description": "Password",
      "required": false,
      "mask": true
    },
    {
      "name": "Server IP",
      "key": "HOST",
      "value": "0.0.0.0",
      "description": "Host IP, don't change unless you know what you're doing",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "4|3|2|1|0",
      "description": "Log Level. Default 4",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
