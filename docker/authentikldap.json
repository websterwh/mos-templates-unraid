{
  "name": "authentik-ldap",
  "repo": "ghcr.io/goauthentik/ldap:2025.8.1",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/goauthentik/authentik",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:389]",
  "icon": "https://raw.githubusercontent.com/Zuerrex/icons/main/authentik.png",
  "project": "https://goauthentik.io",
  "description": "Provides an LDAP interface for applications that require LDAP authentication, exposing Authentik users and groups to legacy systems.",
  "paths": [],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "389",
      "container": "3389",
      "protocol": "tcp",
      "description": "Outpost HTTP port",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "636",
      "container": "6636",
      "protocol": "tcp",
      "description": "Outpost HTTPS port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Authentik Host",
      "key": "AUTHENTIK_HOST",
      "value": "https://example.domain.com",
      "description": "Authentik server URL (from outpost deployment info)",
      "required": false,
      "mask": false
    },
    {
      "name": "Authentik Token",
      "key": "AUTHENTIK_TOKEN",
      "value": "",
      "description": "Authentik API token (from outpost deployment info)",
      "required": false,
      "mask": true
    },
    {
      "name": "Authentik Insecure",
      "key": "AUTHENTIK_INSECURE",
      "value": "true",
      "description": "Allow insecure SSL (from outpost deployment info)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
