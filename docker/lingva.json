  "project": "https://github.com/TheDavidDelta/lingva-translate",
  "description": "Alternative front-end for Google Translate, serving as a Free and Open Source translator with over a hundred languages available",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Domain",
      "key": "site_domain",
      "value": "lingva.ml",
      "description": "The domain address where you will host Lingva",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
