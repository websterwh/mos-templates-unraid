{
  "name": "lingva",
  "repo": "thedaviddelta/lingva-translate",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/thedaviddelta/lingva-translate",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
