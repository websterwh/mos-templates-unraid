{
  "name": "opensearch",
  "repo": "opensearchproject/opensearch:2",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/opensearchproject/opensearch/tags",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--ulimit nofile=262144:262144",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9200]",
  "icon": "https://raw.githubusercontent.com/Richy1989/unraid-icons/main/icons/opensearch.png",
  "project": "https://opensearch.org/",
  "description": "OpenSearch is a scalable, flexible, and extensible open-source software suite for search, analytics, and observability applications derived from Elasticsearch 7.10.2 and Kibana 7.10.2 and licensed under Apache 2.0. It consists of a search engine daemon (OpenSearch) and a user interface for data administration and visualizations (OpenSearch Dashboards). Make sure Opensearch has access rights to the \"Log Data\" folder. Permissions may need to be fixed with integrated Unraid File Manager. Steps below MUST be used in order to get Opensearch working correctly. Check support thread for more information. 1. Install CA User Scripts 2. Create a new script named \"set_max_map_count\" 3. Contents of script as follows: #!/bin/bash sysctl -w vm.max_map_count=262144 4. Set script schedule to At Startup of Array",
  "paths": [
    {
      "name": "Log Data",
      "host": "/mnt/cache/database/opensearch/log_data",
      "container": "/usr/share/opensearch/data",
      "mode": "rw",
      "description": "Log Data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "9200",
      "container": "9200",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OPENSEARCH_JAVA_OPTS",
      "key": "OPENSEARCH_JAVA_OPTS",
      "value": "-Xms1g -Xmx1g",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "bootstrap.memory_lock",
      "key": "bootstrap.memory_lock",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "discovery.type",
      "key": "discovery.type",
      "value": "single-node",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "action.auto_create_index",
      "key": "action.auto_create_index",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "plugins.security.ssl.http.enabled",
      "key": "plugins.security.ssl.http.enabled",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "plugins.security.disabled",
      "key": "plugins.security.disabled",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OPENSEARCH_INITIAL_ADMIN_PASSWORD",
      "key": "OPENSEARCH_INITIAL_ADMIN_PASSWORD",
      "value": "SetPassw0rdL3ttersAndNumb3r5",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
