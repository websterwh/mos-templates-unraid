{
  "name": "quickshare",
  "repo": "hexxa/quickshare:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/hexxa/quickshare/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8686]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/quickshare.png",
  "project": "https://ihexxa.github.io/quickshare.site/",
  "description": "Quick and simple file sharing between different devices, built with Go, React and Typescript.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/quickshare/",
      "container": "/quickshare/root",
      "mode": "rw",
      "description": "Data Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "8686",
      "container": "8686",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin Username",
      "key": "DEFAULTADMIN",
      "value": "admin",
      "description": "Admin Username",
      "required": false,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "DEFAULTADMINPWD",
      "value": "password",
      "description": "Admin Password",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
