{
  "name": "RIPEAtlasProbe",
  "repo": "jamesits/ripe-atlas:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/jamesits/ripe-atlas",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--cap-drop=ALL --cap-add=CHOWN --cap-add=SETUID --cap-add=SETGID --cap-add=DAC_OVERRIDE --cap-add=NET_RAW",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://www.netdata.cloud/img/ripe.png",
  "project": null,
  "description": "This is the RIPE Atlas software probe packaged as a Docker image.",
  "paths": [
    {
      "name": "etc",
      "host": "/mnt/cache/appdata/atlas-probe/etc",
      "container": "/var/atlas-probe/etc",
      "mode": "rw",
      "description": "Stores config.txt and probe_key.pub, where you will need to extract the public key and paste into the RIPE Atlas probe setup",
      "required": true
    },
    {
      "name": "status",
      "host": "/mnt/cache/appdata/atlas-probe/status",
      "container": "/var/atlas-probe/status",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "RXTXRPT",
      "key": "RXTXRPT",
      "value": "yes",
      "description": "Enables sending interface traffic statistics as Atlas measurement results",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": [
    {
      "name": "Enable Traefik",
      "value": "false",
      "description": null
    },
    {
      "name": "Watchtower",
      "value": "true",
      "description": null
    }
  ]
}
