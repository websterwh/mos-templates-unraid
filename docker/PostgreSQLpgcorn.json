{
  "name": "PostgreSQL_pg_corn",
  "repo": "ossapps/postgres:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ossapps/postgres",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "postgres -c shared_preload_libraries=pg_cron -c cron.database_name=DB_Name -c cron.timezone=UTC",
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://raw.githubusercontent.com/swiss01/unraid-templates/refs/heads/main/swiss01/images/logo_postgresql.png",
  "project": "https://hub.docker.com/r/ossapps/splitpro/",
  "description": "PostgreSQL is a powerful, open source object-relational database system with over 35 years of active development that has earned it a strong reputation for reliability, feature robustness, and performance. This Docker is from OSS Apps with integratet pg_cron",
  "paths": [
    {
      "name": "Path: /var/lib/postgresql/data",
      "host": "/mnt/cache/appdata/postgresql_pg_corn",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "PostgreSQL data storage location.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port: PostgreSQL access port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "PostgreSQL TCP connection port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Variable: POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "Initial superuser password (required).",
      "required": true,
      "mask": false
    },
    {
      "name": "Variable: POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "",
      "description": "Initial superuser name (default: postgres).",
      "required": true,
      "mask": false
    },
    {
      "name": "Variable: POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "",
      "description": "Initial database name (default: postgres).",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
