{
  "name": "Lunarr",
  "repo": "sayem314/lunarr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/sayem314/lunarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/lunarr-app/lunarr-go/refs/heads/main/static/images/lunarr-icon.png",
  "project": "https://github.com/lunarr-app/lunarr-go",
  "description": "Self-hosted media streaming server designed as an alternative to Plex, allowing you to monitor and manage your movie and TV show files on a headless server.",
  "paths": [
    {
      "name": "Media Library",
      "host": "",
      "container": "/media",
      "mode": "ro",
      "description": "Path to media files",
      "required": true
    },
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/lunarr/config",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the config data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Auth Secret",
      "key": "AUTH_SECRET",
      "value": "",
      "description": "Generate a secure random key with `openssl rand -base64 32`",
      "required": true,
      "mask": true
    },
    {
      "name": "Public Domain",
      "key": "ORIGIN",
      "value": "",
      "description": "Domain where this instance will be accessed (e.g. https://lunarr.example.com)",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
