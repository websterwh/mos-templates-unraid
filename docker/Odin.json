{
  "name": "Odin",
  "repo": "ghcr.io/ad-on-is/odin:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/ad-on-is/odin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6060]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/odin-icon.png",
  "project": "https://github.com/ad-on-is/odin-server",
  "description": "A self-hosted streaming service to stream from RealDebrid or AllDebrid to the Android app. Follow configuration instructions on the GitHub page: https://github.com/ad-on-is/odin-server#1%EF%B8%8F%E2%83%A3-first-steps",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/odin/data",
      "container": "/pb_data",
      "mode": "rw",
      "description": "Path to store data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "6060",
      "container": "6060",
      "protocol": "tcp",
      "description": "Container Port: 6060",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Jackett - URL",
      "key": "JACKETT_URL",
      "value": "http://jackett:9117",
      "description": "URL of the Jackett server",
      "required": true,
      "mask": false
    },
    {
      "name": "Jackett - API Key",
      "key": "JACKETT_KEY",
      "value": "",
      "description": "API key of the Jackett server",
      "required": true,
      "mask": true
    },
    {
      "name": "TMDb - API Key",
      "key": "TMDB_KEY",
      "value": "",
      "description": "API key for The Movie Database",
      "required": true,
      "mask": true
    },
    {
      "name": "Trakt - Client ID",
      "key": "TRAKT_CLIENTID",
      "value": "",
      "description": "Client ID for Trakt",
      "required": true,
      "mask": false
    },
    {
      "name": "Trakt - Client Secret",
      "key": "TRAKT_SECRET",
      "value": "",
      "description": "Client secret for Trakt",
      "required": true,
      "mask": true
    },
    {
      "name": "AllDebrid - API Key",
      "key": "ALLDEBRID_KEY",
      "value": "",
      "description": "API key for AllDebrid. Remove if you don't use AllDebrid",
      "required": false,
      "mask": true
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "info|debug|warn|error",
      "description": "Log level",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
