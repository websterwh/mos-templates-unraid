{
  "name": "cryptpad",
  "repo": "cryptpad/cryptpad:version-2024.12.0",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/cryptpad/cryptpad/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/cryptpad.png",
  "project": "https://cryptpad.fr/",
  "description": "CryptPad is the Zero Knowledge realtime collaborative editor. Before Installing the docker Unraid CLI cd /mnt/user/appdata && mkdir cryptpad && cd cryptpad mkdir -p block customize data datastore config onlyoffice-dist onlyoffice-conf chown -R 4001:4001 block customize data datastore onlyoffice-dist onlyoffice-conf wget -O /mnt/user/appdata/cryptpad/config/config.js https://raw.githubusercontent.com/xwiki-labs/cryptpad/main/config/config.example.js Edit /mnt/user/appdata/cryptpad/config/config.js Change httpUnsafeOrigin:http://Unraid_IP/DOMAIN:PORT Example httpUnsafeOrigin: 'http://192.168.0.99:3000', In httpAddress: remove // and put httpAddress: '0.0.0.0', More info https://docs.cryptpad.org/fr/admin_guide/installation.html#configure-cryptpad",
  "paths": [
    {
      "name": "Blob Path",
      "host": "/mnt/cache/appdata/cryptpad/blob",
      "container": "/cryptpad/blob",
      "mode": "rw",
      "description": "Blob Path",
      "required": false
    },
    {
      "name": "Block Path",
      "host": "/mnt/cache/appdata/cryptpad/block",
      "container": "/cryptpad/block",
      "mode": "rw",
      "description": "Block Path",
      "required": false
    },
    {
      "name": "Customize Path",
      "host": "/mnt/cache/appdata/cryptpad/customize",
      "container": "/cryptpad/customize",
      "mode": "rw",
      "description": "Customize Path",
      "required": false
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/cryptpad/data",
      "container": "/cryptpad/data",
      "mode": "rw",
      "description": "Data Path",
      "required": false
    },
    {
      "name": "Datastore Path",
      "host": "/mnt/cache/appdata/cryptpad/datastore",
      "container": "/cryptpad/datastore",
      "mode": "rw",
      "description": "Datastore Path",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/cryptpad/config/config.js",
      "container": "/cryptpad/config/config.js",
      "mode": "rw",
      "description": "Config Path",
      "required": false
    },
    {
      "name": "Onlyoffice Conf Path",
      "host": "/mnt/cache/appdata/cryptpad/onlyoffice-conf",
      "container": "/cryptpad/onlyoffice-conf",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Onlyoffice Dist Path",
      "host": "/mnt/cache/appdata/cryptpad/onlyoffice-dist",
      "container": "/cryptpad/www/common/onlyoffice/dist",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Port 1",
      "required": false,
      "mask": false
    },
    {
      "name": "Port 2",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "Port 2",
      "required": false,
      "mask": false
    },
    {
      "name": "Port 3",
      "host": "3003",
      "container": "3003",
      "protocol": "tcp",
      "description": "Port 3",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "CPAD_MAIN_DOMAIN",
      "key": "CPAD_MAIN_DOMAIN",
      "value": "http://UNRAID_IP:3000",
      "description": "If you changed the port change it here with the Unraid IP if you are using reverse proxy you may require to edit this too",
      "required": false,
      "mask": false
    },
    {
      "name": "CPAD_INSTALL_ONLYOFFICE",
      "key": "CPAD_INSTALL_ONLYOFFICE",
      "value": "yes",
      "description": "https://github.com/ONLYOFFICE/web-apps/blob/master/LICENSE.txt",
      "required": false,
      "mask": false
    },
    {
      "name": "CPAD_CONF",
      "key": "CPAD_CONF",
      "value": "/cryptpad/config/config.js",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
