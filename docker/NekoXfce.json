{
  "name": "Neko-Xfce",
  "repo": "ghcr.io/m1k1o/neko/xfce:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/m1k1o/neko/xfce",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/m1k1o/neko/refs/heads/master/webpage/static/img/icons/xfce.svg",
  "project": "https://neko.m1k1o.net/",
  "description": "A self-hosted virtual desktop that runs in Docker and uses WebRTC technology. Neko allows you to run a fully-functional desktop in a virtual environment, providing secure and private internet access from anywhere. It's perfect for developers, privacy-conscious users, and anyone needing a virtual desktop environment.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/neko/config.yaml",
      "container": "/etc/neko/neko.yaml",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    },
    {
      "name": "WebRTC UDP Ports",
      "host": "52000-52100",
      "container": "52000-52100",
      "protocol": "udp",
      "description": "UDP ports for client traffic",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
