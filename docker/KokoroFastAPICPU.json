{
  "name": "Kokoro-FastAPI---CPU",
  "repo": "ghcr.io/remsky/kokoro-fastapi-cpu:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/remsky/kokoro-fastapi-cpu",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8880]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/kokoro-fastapi-icon.png",
  "project": "https://github.com/remsky/Kokoro-FastAPI",
  "description": "Dockerized FastAPI wrapper for Kokoro-82M text-to-speech model w/CPU ONNX and NVIDIA GPU PyTorch support, handling, and auto-stitching. This is a version meant for running on CPUs. It is not recommended to run this on a CPU unless you have a very powerful CPU, as it will be slow. If you have a GPU, please use the GPU version of this container.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/kokoro-fastapi/data",
      "container": "/app/api",
      "mode": "rw",
      "description": "Path to the app data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8880",
      "container": "8880",
      "protocol": "tcp",
      "description": "Container Port: 8880",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Download Model",
      "key": "DOWNLOAD_MODEL",
      "value": "true|false",
      "description": "Download model on start",
      "required": true,
      "mask": false
    },
    {
      "name": "Python Path",
      "key": "PYTHONPATH",
      "value": "/app:/app/api",
      "description": "Python path environment variable",
      "required": true,
      "mask": false
    },
    {
      "name": "ONNX Optimization - Thread Count",
      "key": "ONNX_NUM_THREADS",
      "value": "8",
      "description": "Number of threads to use for ONNX model inference",
      "required": true,
      "mask": false
    },
    {
      "name": "ONNX Optimization - Inter Op Thread Count",
      "key": "ONNX_INTER_OP_THREADS",
      "value": "4",
      "description": "ONNX inter operation thread count",
      "required": true,
      "mask": false
    },
    {
      "name": "ONNX Optimization - Execution Mode",
      "key": "ONNX_EXECUTION_MODE",
      "value": "parallel",
      "description": "ONNX execution mode",
      "required": true,
      "mask": false
    },
    {
      "name": "ONNX Optimization - Optimization Level",
      "key": "ONNX_OPTIMIZATION_LEVEL",
      "value": "all",
      "description": "ONNX optimization level",
      "required": true,
      "mask": false
    },
    {
      "name": "ONNX Optimization - Memory Pattern",
      "key": "ONNX_MEMORY_PATTERN",
      "value": "true",
      "description": "Enable ONNX memory pattern optimization",
      "required": true,
      "mask": false
    },
    {
      "name": "ONNX Optimization - Arena Extend Strategy",
      "key": "ONNX_ARENA_EXTEND_STRATEGY",
      "value": "kNextPowerOfTwo",
      "description": "ONNX arena extend strategy",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "API_LOG_LEVEL",
      "value": "DEBUG",
      "description": "Logging level for the API",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
