{
  "name": "unimus",
  "repo": "croc/unimus",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/croc/unimus/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8085]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/unimus.png",
  "project": null,
  "description": "Unimus is a multi-vendor network device configuration backup and management solution, designed from the ground up with user friendliness, workflow optimization and ease-of-use in mind. You can get a free 5-device license at https://unimus.net/",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/unimus/",
      "container": "/etc/unimus/",
      "mode": "rw",
      "description": "Appdata Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "UI",
      "host": "8085",
      "container": "8085",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
