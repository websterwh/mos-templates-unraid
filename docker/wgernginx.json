{
  "name": "wger-nginx",
  "repo": "nginx:stable",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/_/nginx",
  "network": "wger_network",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--health-cmd=service nginx status --health-interval=10s --health-retries=5 --health-start-period=30s --health-timeout=5s",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8557]",
  "icon": "https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/wger-logo.png",
  "project": "https://wger.de",
  "description": "Nginx reverse proxy that serves static content from shared volumes and forwards requests to the wger server.",
  "paths": [
    {
      "name": "NGINX_CONFIG",
      "host": "/mnt/cache/appdata/wger/nginx/",
      "container": "/etc/nginx/conf.d/",
      "mode": "ro",
      "description": "Path to nginx configuration",
      "required": true
    },
    {
      "name": "STATIC_ROOT",
      "host": "/mnt/cache/appdata/wger/static/",
      "container": "/wger/static",
      "mode": "ro",
      "description": "Path to static files (read-only)",
      "required": true
    },
    {
      "name": "MEDIA_ROOT",
      "host": "/mnt/cache/appdata/wger/media/",
      "container": "/wger/media",
      "mode": "ro",
      "description": "Path to media files (read-only)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "PORT",
      "host": "8557",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP port for the nginx container (container port 80)",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "File creation mask",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
