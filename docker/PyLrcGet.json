{
  "name": "PyLrcGet",
  "repo": "crywolf203/pylrcget-unraid:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/crywolf203/pylrcget-unraid",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:3001]/",
  "icon": "https://raw.githubusercontent.com/crywolf203/pylrcget-unraid/main/icon.png",
  "project": "https://github.com/saitatter/pylrcget",
  "description": "Unofficial Unraid-friendly Docker container for PyLrcGet, packaged inside LinuxServer Webtop for browser-based desktop access. Includes PyLrcGet, Firefox, Google Chrome, ffmpeg, mediainfo, kid3-cli, and desktop launchers. Use HTTPS for the WebUI.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/pylrcget",
      "container": "/config",
      "mode": "rw",
      "description": "Container config, Webtop profile, browser data, and app settings.",
      "required": true
    },
    {
      "name": "Music",
      "host": "/mnt/cache/media/music",
      "container": "/music",
      "mode": "rw",
      "description": "Music library path. Use /music inside PyLrcGet. Change this to your actual Unraid music path.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI HTTPS Port",
      "host": "5801",
      "container": "3001",
      "protocol": "tcp",
      "description": "HTTPS Webtop browser access port. Open https:// :[PORT:3001]/",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID. Unraid default is 99.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID. Unraid default is 100.",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Container timezone.",
      "required": true,
      "mask": false
    },
    {
      "name": "GUI Autostart",
      "key": "GUIAUTOSTART",
      "value": "true",
      "description": "Enable Webtop GUI autostart.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
