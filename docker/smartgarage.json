{
  "name": "smart-garage",
  "repo": "ghcr.io/flizzy27/smart-garage:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/flizzy27/smart-garage/main/templates/icon.png",
  "project": "https://github.com/flizzy27/smart-garage",
  "description": "Smart Garage \u2014 self-hosted vehicle management for Unraid. Maintenance, fuel analytics, expenses, documents, and reminders. One container, SQLite database, automatic updates via :latest image.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/smart-garage",
      "container": "/data",
      "mode": "rw",
      "description": "SQLite database and uploads. Created automatically by Unraid.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Max upload size (MB)",
      "key": "MAX_UPLOAD_SIZE_MB",
      "value": "25",
      "description": "Maximum document upload size (PDF, receipts).",
      "required": false,
      "mask": false
    },
    {
      "name": "Max image size (MB)",
      "key": "MAX_IMAGE_SIZE_MB",
      "value": "10",
      "description": "Maximum vehicle image upload size.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "file:/data/smart-garage.db",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Upload directory",
      "key": "UPLOAD_DIR",
      "value": "/data/uploads",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Node environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
