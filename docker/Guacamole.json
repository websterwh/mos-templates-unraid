{
  "name": "Guacamole",
  "repo": "cleao/guacamole:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/cleao/guacamole",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/cleao01/docker-guacamole/master/GuacaIcon.png",
  "project": "https://github.com/cleao01/UnraidDockerGuacamole",
  "description": "Clientless remote desktop gateway. Supports standard protocols like VNC and RDP. Uses internal MariaDB or external database source authentication and data storage. Initial username and password are guacadmin.",
  "paths": [
    {
      "name": "Session recordings path",
      "host": "",
      "container": "/var/lib/guacamole/recordings",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/Guacamole",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8088",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "External authentication provider(s)",
      "key": "EXTENSION_PRIORITY",
      "value": "",
      "description": "Comma-separated list of external database server (mysql, sqlserver or postgresql) and authentication providers (ldap, duo, totp, cas, openid, saml, ssl, json, header, quickconnect) that should be acessed in specific order. Use internal (MariaDB) if any external database chosen",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_HOSTNAME:PORT",
      "key": "DATABASE_HOSTNAME",
      "value": "",
      "description": "External database server name or IP adress, and port",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_NAME",
      "key": "DATABASE_NAME",
      "value": "",
      "description": "External database name",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_USERNAME",
      "key": "DATABASE_USERNAME",
      "value": "",
      "description": "External database user name",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_PASSWORD",
      "key": "DATABASE_PASSWORD",
      "value": "",
      "description": "External database password",
      "required": false,
      "mask": true
    },
    {
      "name": "LDAP_HOSTNAME:PORT",
      "key": "LDAP_HOSTNAME",
      "value": "",
      "description": "External LDAP server name or IP adress, and port",
      "required": false,
      "mask": false
    },
    {
      "name": "LDAP_USER_BASE_DN",
      "key": "LDAP_USER_BASE_DN",
      "value": "",
      "description": "External LDAP user base dn",
      "required": false,
      "mask": false
    },
    {
      "name": "DUO_API_HOSTNAME",
      "key": "DUO_API_HOSTNAME",
      "value": "",
      "description": "External duo api hostname",
      "required": false,
      "mask": false
    },
    {
      "name": "DUO_CLIENT_ID",
      "key": "DUO_CLIENT_ID",
      "value": "",
      "description": "External duo client id",
      "required": false,
      "mask": false
    },
    {
      "name": "DUO_CLIENT_SECRET",
      "key": "DUO_CLIENT_SECRET",
      "value": "",
      "description": "External duo client secret",
      "required": false,
      "mask": true
