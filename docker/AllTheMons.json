{
  "name": "AllTheMons",
  "repo": "itsnotwebby/docker-atmons:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/repository/docker/itsnotwebby/docker-atmons",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:25565]",
  "icon": "https://media.forgecdn.net/avatars/thumbnails/1567/555/256/256/639016249214580144.png",
  "project": "https://www.curseforge.com/minecraft/modpacks/all-the-mons",
  "description": "A Modded Java Minecraft server container for Unraid that runs All the Mons",
  "paths": [
    {
      "name": "Installed Location",
      "host": "/mnt/cache/appdata/allthemons/",
      "container": "/data",
      "mode": "rw",
      "description": "Path to store the installed server files.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "25565",
      "container": "25565",
      "protocol": "tcp",
      "description": "Port for the server",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "EULA",
      "key": "EULA",
      "value": "false",
      "description": "Do you agree to the Mojang EULA available at https://account.mojang.com/documents/minecraft_eula? Server will not start without accepting. Set to 'true' to accept.",
      "required": true,
      "mask": false
    },
    {
      "name": "JVM_OPTS",
      "key": "JVM_OPTS",
      "value": "-Xms2048m -Xmx4096m",
      "description": "JAVA Options",
      "required": false,
      "mask": false
    },
    {
      "name": "MOTD",
      "key": "MOTD",
      "value": "",
      "description": "Set the server MOTD",
      "required": false,
      "mask": false
    },
    {
      "name": "ALLOW_FLIGHT",
      "key": "ALLOW_FLIGHT",
      "value": "true",
      "description": "Set Flight",
      "required": false,
      "mask": false
    },
    {
      "name": "MAX_PLAYERS",
      "key": "MAX_PLAYERS",
      "value": "5",
      "description": "Set Player Limit",
      "required": false,
      "mask": false
    },
    {
      "name": "ONLINE_MODE",
      "key": "ONLINE_MODE",
      "value": "true",
      "description": "Set Online Mode",
      "required": false,
      "mask": false
    },
    {
      "name": "ENABLE_WHITELIST",
      "key": "ENABLE_WHITELIST",
      "value": "true",
      "description": "Enable (true)/Disable (false) Whitelist on the Server",
      "required": false,
      "mask": false
    },
    {
      "name": "WHITELIST_USERS",
      "key": "WHITELIST_USERS",
      "value": "",
      "description": "Add Users comma-seperated to the Whitelist. Example Value: TestUserName1, TestUserName2",
      "required": false,
      "mask": false
    },
    {
      "name": "OP_USERS",
      "key": "OP_USERS",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
