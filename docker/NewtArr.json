{
  "name": "NewtArr",
  "repo": "tobin2010/newtarr",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/tobin2010/newtarr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9705]",
  "icon": "https://docs.elfhosted.com/images/logo.png",
  "project": "https://github.com/elfhosted/newtarr",
  "description": "NewtArr continuously searches your *arr media libraries for missing content and items that need quality upgrades. It helps you complete your media collection by automatically triggering searches while remaining gentle on your indexers.",
  "paths": [
    {
      "name": "AppData Directory",
      "host": "/mnt/cache/appdata/newtarr",
      "container": "/config",
      "mode": "rw",
      "description": "Directory for storing NewtArr configuration",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebGUI Port",
      "host": "9705",
      "container": "9705",
      "protocol": "tcp",
      "description": "Port for NewtArr WebGUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Los_Angeles",
      "description": "Container timezone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
