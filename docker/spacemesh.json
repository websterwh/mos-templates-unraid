{
  "name": "spacemesh",
  "repo": "furritos/go-spacemesh:latest",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/furritos/go-spacemesh",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7513]",
  "icon": "https://github.com/furritos/docker-templates/raw/master/furritos/images/spacemesh_icon.png",
  "project": "https://spacemesh.io/",
  "description": "Docker image of the Spacemesh cryptocurrency built from the code found at https://github.com/spacemeshos/go-spacemesh/. NOTE: It is HIGHLY RECOMMENDED that a proper configuration is provided and stored in the node-data path below. This image provides node-only services.",
  "paths": [
    {
      "name": "node-data",
      "host": "/mnt/cache/appdata/spacemesh/node",
      "container": "/root/spacemesh",
      "mode": "rw",
      "description": "Node Data Path",
      "required": true
    },
    {
      "name": "post-data",
      "host": "/mnt/cache/appdata/spacemesh/post",
      "container": "/root/post",
      "mode": "rw",
      "description": "Post Files Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "p2p-listener",
      "host": "7513",
      "container": "7513",
      "protocol": "tcp",
      "description": "P2P port",
      "required": true,
      "mask": false
    },
    {
      "name": "grpc-public-listener",
      "host": "9092",
      "container": "9092",
      "protocol": "tcp",
      "description": "Public GRPC API Port",
      "required": false,
      "mask": false
    },
    {
      "name": "grpc-private-listener",
      "host": "9093",
      "container": "9093",
      "protocol": "tcp",
      "description": "Private GRPC API Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
