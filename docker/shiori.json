{
  "name": "shiori",
  "repo": "radhifadlillah/shiori:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/radhifadlillah/shiori/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/shiori.png",
  "project": "https://github.com/go-shiori/shiori",
  "description": "Simple bookmark manager built with Go. Default user/password User: shiori Password: gopher Create new account inside the web gui so the default one will be removed.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/shiori/",
      "container": "/srv/shiori/",
      "mode": "rw",
      "description": "Appdata",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
