{
  "name": "GuppyFLO",
  "repo": "ballaswag/guppyflo:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/ballaswag/guppyflo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9873]",
  "icon": "https://avatars.githubusercontent.com/u/145094472?s=48&v=4",
  "project": "https://github.com/ballaswag/guppyflo/",
  "description": "GuppyFLO is a self-hosted service that enables local/remote management of multiple Klipper printers using Moonraker.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/guppyflo",
      "container": "/guppyflo/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "9873",
      "container": "9873",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Tailscale Auth Key",
      "key": "TS_AUTHKEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
