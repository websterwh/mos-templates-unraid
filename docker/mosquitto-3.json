{
  "name": "mosquitto",
  "repo": "eclipse-mosquitto:2",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/_/eclipse-mosquitto",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1883]",
  "icon": "https://raw.githubusercontent.com/simonsickle/unraid-templates/main/mosquitto/logo.png",
  "project": "https://mosquitto.org",
  "description": "MQTT Data Broker",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/mosquitto/config/",
      "container": "/mosquitto/config",
      "mode": "rw",
      "description": "Store mosquitto.conf and passwd files",
      "required": false
    },
    {
      "name": "data",
      "host": "/mnt/cache/appdata/mosquitto/data",
      "container": "/mosquitto/data",
      "mode": "rw",
      "description": "Store persistent MQTT data. Note: Persistent data must be enabled in the mosquitto.conf config file.",
      "required": false
    },
    {
      "name": "logs",
      "host": "/mnt/cache/appdata/mosquitto/log",
      "container": "/mosquitto/log",
      "mode": "rw",
      "description": "Store mosquitto logs. Note: Logs must be enabled in the mosquitto.conf config file",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "MQTT Port",
      "host": "1883",
      "container": "1883",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
