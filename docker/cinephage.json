{
  "name": "cinephage",
  "repo": "ghcr.io/moldytaint/cinephage:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=256m",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/MoldyTaint/Cinephage/main/deploy/unraid/icon.png",
  "project": "https://github.com/MoldyTaint/Cinephage",
  "description": "Cinephage is a self-hosted media management application \u2014 automated movie/TV library management, quality upgrades, subtitle sync, and streaming. **Setup:** On first launch, visit the WebUI to create your admin account.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/cinephage",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration and app data",
      "required": true
    },
    {
      "name": "Media",
      "host": "/mnt/cache/media",
      "container": "/media",
      "mode": "rw",
      "description": "Media library",
      "required": false
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "Download directory",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Web UI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Auth Secret",
      "key": "BETTER_AUTH_SECRET",
      "value": "",
      "description": "Required: Authentication secret (generate with: openssl rand -base64 32)",
      "required": true,
      "mask": true
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "UTC",
      "description": "Timezone (e.g. America/New_York)",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file ownership",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file ownership",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
