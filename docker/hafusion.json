{
  "name": "ha-fusion",
  "repo": "ghcr.io/matt8707/ha-fusion",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/matt8707/ha-fusion",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5050]",
  "icon": "https://raw.githubusercontent.com/MiranoVerhoef/Unraid-Mirano/main/ha-fusion/seo-unraid.ico",
  "project": "https://github.com/matt8707/ha-fusion",
  "description": "A modern, easy-to-use and performant custom Home Assistant dashboard",
  "paths": [
    {
      "name": "/App/data Directory",
      "host": "",
      "container": "/app/data",
      "mode": "rw",
      "description": "/App/data Directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Webui Port",
      "host": "5050",
      "container": "5050",
      "protocol": "tcp",
      "description": "Webui Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Amsterdam",
      "description": "Timezone",
      "required": false,
      "mask": false
    },
    {
      "name": "Home assistant URL",
      "key": "HASS_URL",
      "value": "http://192.168.*.***:8123",
      "description": "Home assistant URL",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
