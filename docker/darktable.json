{
  "name": "darktable",
  "repo": "mdschaefer/darktable",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/repository/docker/mdschaefer/darktable",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/mikeylikesrocks/unraid-docker-templates/master/darktable-icon.png",
  "project": "https://github.com/mikeylikesrocks/darktable",
  "description": "Darktable is an open source photography workflow application and raw developer. A virtual lighttable and darkroom for photographers. It manages your digital negatives in a database, lets you view them through a zoomable lighttable and enables you to develop raw images and enhance them.",
  "paths": [
    {
      "name": "Darktable config and library folder",
      "host": "/mnt/cache/appdata/darktable",
      "container": "/config",
      "mode": "rw",
      "description": "Container path: /config",
      "required": true
    },
    {
      "name": "unRAID Share Path",
      "host": "/mnt/cache/",
      "container": "/images",
      "mode": "rw",
      "description": "Container path: /images",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "HTTP Port 8080",
      "required": true,
      "mask": false
    },
    {
      "name": "RDP Port",
      "host": "3389",
      "container": "3389",
      "protocol": "tcp",
      "description": "RDP Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "UID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "GID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
