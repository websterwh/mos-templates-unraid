{
  "name": "organizrv2",
  "repo": "organizr/organizr",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/organizr/organizr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/causefx/Organizr/v2-master/plugins/images/organizr/logo-no-border.png",
  "project": "https://github.com/causefx/Organizr",
  "description": "Your Media Server's one-stop shop! HTPC/Homelab services organizer, written in PHP. The new, upgraded official image for Organzir v2.",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/organizr",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Branch",
      "key": "branch",
      "value": "master",
      "description": "Chooses which branch of organizr you wish to use",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Variable: PGID",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
