{
  "name": "TodoChat",
  "repo": "ghcr.io/itsluminous/todochat:main",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/itsluminous/todochat",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/todochat-icon.png",
  "project": "https://todo-list-seven-teal.vercel.app",
  "description": "Minimal web UI for Gemini Pro Chat, hidden behind a Todo app to avoid censorship.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Gemini API Key",
      "key": "GEMINI_API_KEY",
      "value": "",
      "description": "Gemini API Key",
      "required": true,
      "mask": true
    },
    {
      "name": "Secret Switch",
      "key": "TODO_SECRET",
      "value": "",
      "description": "Secret to-do item to switch to chat mode",
      "required": true,
      "mask": true
    },
    {
      "name": "API Base URL",
      "key": "API_BASE_URL",
      "value": "",
      "description": "Custom base URL for the Gemini API",
      "required": false,
      "mask": false
    },
    {
      "name": "Head Scripts",
      "key": "HEAD_SCRIPTS",
      "value": "",
      "description": "Custom scripts to include in the head of the page",
      "required": false,
      "mask": false
    },
    {
      "name": "Public Secret Key",
      "key": "PUBLIC_SECRET_KEY",
      "value": "",
      "description": "Public secret key to generate signatures for API calls",
      "required": false,
      "mask": true
    },
    {
      "name": "Site Password",
      "key": "SITE_PASSWORD",
      "value": "",
      "description": "Comma-separated list of passwords to access the site. If not provided, site will be public.",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
