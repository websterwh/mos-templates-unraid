{
  "name": "journali-db",
  "repo": "pgvector/pgvector:pg18",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/pgvector/pgvector",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://raw.githubusercontent.com/journalipim/journali/master/unraid/journali.png",
  "project": "https://journali.de",
  "description": "PostgreSQL 18 with the vector extension: the database for journali. journali creates the extension itself on its first start. Set the password here; the first visit of the journali web UI asks for it again.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/journali-db",
      "container": "/var/lib/postgresql",
      "mode": "rw",
      "description": "Data directory of the database",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "Port of the database; journali connects to it",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "Password of the user postgres; the same password goes into the setup dialog of journali",
      "required": true,
      "mask": true
    },
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "postgres",
      "description": "Database user",
      "required": false,
      "mask": false
    },
    {
      "name": "POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "journali",
      "description": "Name of the database",
      "required": false,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Time zone of the container",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
