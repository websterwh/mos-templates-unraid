{
  "name": "Siphon",
  "repo": "ghcr.io/whydahgally/siphon:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/WhydahGally/Siphon/pkgs/container/siphon",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/WhydahGally/Siphon/main/src/ui/public/favicon.png",
  "project": "https://github.com/WhydahGally/Siphon",
  "description": "YT playlist watcher with auto-download, scheduling, and smart renaming. Built for music. Watches playlists for new additions and downloads them automatically on a configurable schedule.",
  "paths": [
    {
      "name": "Downloads",
      "host": "/mnt/cache/downloads/siphon/",
      "container": "/app/downloads",
      "mode": "rw",
      "description": "Path to store downloaded media",
      "required": true
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/siphon/",
      "container": "/app/.data",
      "mode": "rw",
      "description": "Path to store application data (database, logs)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8778",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port for the Siphon web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file permissions",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file permissions",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": "File permission mask for new files",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
