{
  "name": "homer",
  "repo": "b4bz/homer:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/b4bz/homer/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/homer.png",
  "project": "https://github.com/bastienwirtz/homer",
  "description": "A dead simple static HOMe for your servER to keep your services on hand from a simple yaml config.",
  "paths": [
    {
      "name": "Assets Path",
      "host": "/mnt/cache/appdata/homer/assets/",
      "container": "/www/assets",
      "mode": "rw",
      "description": "Container Path: /www/assets",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
