{
  "name": "changedetection.io",
  "repo": "dgtlmoon/changedetection.io",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/dgtlmoon/changedetection.io/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/changedetection.io.png",
  "project": "https://github.com/dgtlmoon/changedetection.io/",
  "description": "Self-hosted website change detection monitoring.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/changedetection/",
      "container": "/datastore",
      "mode": "rw",
      "description": "Appdata",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "",
      "description": "The URL this application will be accessed from your clients without trailing slash. Needed for notifications if you want to be linked to the diff page for example.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
