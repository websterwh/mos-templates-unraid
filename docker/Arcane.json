{
  "name": "Arcane",
  "repo": "ghcr.io/getarcaneapp/arcane:latest",
  "category": [
    "Network"
  ],
  "registry": "https://ghcr.io/getarcaneapp/arcane",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3552]",
  "icon": "https://raw.githubusercontent.com/tajniak81/unraid-docker-templates/refs/heads/main/arcane/icon/arcane.png",
  "project": "https://getarcane.app/",
  "description": "Modern Docker Management, Designed for Everyone. https://getarcane.app/docs/setup/installation Arcane needs a 32\u2011byte ENCRYPTION_KEY. On Windows PowerShell: $bytes = New-Object byte[] 32 [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes) $ENCRYPTION_KEY = [Convert]::ToBase64String($bytes) $ENCRYPTION_KEY 64-character hex JWT secret. On Windows PowerShell: $bytes = New-Object byte[] 32 [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes) $JWT_SECRET = ($bytes | ForEach-Object { $_.ToString(\"x2\") }) -join \"\" $JWT_SECRET",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/arcane",
      "container": "/app/data",
      "mode": "rw",
      "description": "Arcane data directory",
      "required": true
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker socket for Arcane to manage containers",
      "required": true
    },
    {
      "name": "Projects",
      "host": "/mnt/cache/projects",
      "container": "/app/data/projects",
      "mode": "rw",
      "description": "Directory containing your compose projects (host path must match inside container)",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3552",
      "container": "3552",
      "protocol": "tcp",
      "description": "Arcane web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "http://localhost:3552",
      "description": "Base URL for Arcane",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false
    },
    {
      "name": "ENCRYPTION_KEY",
      "key": "ENCRYPTION_KEY",
      "value": "",
      "description": "32-byte encryption key (keep secret!)",
      "required": true,
      "mask": true
    },
    {
      "name": "JWT_SECRET",
      "key": "JWT_SECRET",
      "value": "",
      "description": "JWT secret (if required by your setup)",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
