{
  "name": "ambientweather2mqtt",
  "repo": "ghcr.io/neilenns/ambientweather2mqtt:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/neilenns/ambientweather2mqtt",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8132]",
  "icon": "https://brands.home-assistant.io/_/ambient_station/logo.png",
  "project": "https://github.com/neilenns/ambientweather2mqtt",
  "description": "This package listens for local data from Ambient Weather stations (such as the WS-2902C) and converts the incoming data to MQTT events. The sensor data is published with auto-discovery so they show up automatically as sensors in Home Assistant. The following Ambient Weather station models are confirmed to work: WS-2902C",
  "paths": [],
  "ports": [
    {
      "name": "Main Port Mapping",
      "host": "8132",
      "container": "8132",
      "protocol": "tcp",
      "description": "The port that the weather station will point towards.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Station Mac Address",
      "key": "STATION_MAC_ADDRESS",
      "value": "40:f5:20:0b:73:d7",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT Server",
      "key": "MQTT_SERVER",
      "value": "http://192.168.50.106:1883",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT_USERNAME",
      "key": "MQTT_USERNAME",
      "value": "nickmowen",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT_PASSWORD",
      "key": "MQTT_PASSWORD",
      "value": "@MQTTbrick8",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Denver",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Main Port",
      "key": "PORT",
      "value": "8132",
      "description": "The port this service runs on. If changing the port variable then this needs to be changed as well.",
      "required": true,
      "mask": false
    },
    {
      "name": "Unauthorized",
      "key": "MQTT_REJECT_UNAUTHORIZED",
      "value": "false",
      "description": "Leave as-is unless you know what you are doing.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
