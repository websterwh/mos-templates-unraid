{
  "name": "flink",
  "repo": "quay.io/rtraceio/flink",
  "category": [
    "Productivity"
  ],
  "registry": "https://quay.io/repository/rtraceio/flink",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/Collectathon/unraid-templates/refs/heads/main/icons/flink.png",
  "project": "https://gitlab.com/rtraceio/web/flink",
  "description": "Flink is a simple, Free, Libre, and Open Source URL Shortener built with love and a ASP.NET Core 8 Web API. Why yet another URL Shortener, you might ask yourself? Well, because Flink has a unique feature set, and demands around scalability, simplicity, security and traceability that no other URL shortener was able to fulfil.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database Type",
      "key": "DBCONFIGURATION__DBTYPE",
      "value": "sqlite",
      "description": "sqlite, postgres, or mysql",
      "required": false,
      "mask": false
    },
    {
      "name": "Postgres DB Connection",
      "key": "DBCONFIGURATION__POSTGRESCONNECTIONSTRING",
      "value": "Server=localhost;Port=5432;Database=flink;User Id=flink;Password=flink;",
      "description": "Database string for postgres",
      "required": false,
      "mask": false
    },
    {
      "name": "Enable Metrics",
      "key": "METRICSCONFIGURATION__ENABLEMETRICS",
      "value": "true",
      "description": "Enable metrics",
      "required": false,
      "mask": false
    },
    {
      "name": "Metrics Username",
      "key": "METRICSCONFIGURATION__BASICAUTHUSERNAME",
      "value": "flink",
      "description": "Username for metrics",
      "required": false,
      "mask": false
    },
    {
      "name": "Metrics Password",
      "key": "METRICSCONFIGURATION__BASICAUTHPASSWORD",
      "value": "flink",
      "description": "Password for metrics",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
