{
  "name": "MailDev",
  "repo": "maildev/maildev:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/maildev/maildev",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "bin/maildev --base-pathname /maildev -w 1080 -s 1025",
  "web_ui_url": "http://[IP]:[PORT:1080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/maildev-icon.png",
  "project": "https://maildev.github.io/maildev/",
  "description": "SMTP Server + Web Interface for viewing and testing emails during development.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "1080",
      "container": "1080",
      "protocol": "tcp",
      "description": "Container Port: 1080",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP Port",
      "host": "1025",
      "container": "1025",
      "protocol": "tcp",
      "description": "Container Port: 1025",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
