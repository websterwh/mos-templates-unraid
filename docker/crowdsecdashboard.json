{
  "name": "crowdsec-dashboard",
  "repo": "metabase/metabase:latest",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/metabase/metabase",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/ibracorp/app-logos/main/crowdsec/crowdsec.png",
  "project": "https://crowdsec.net/",
  "description": "Metabase dashboard template for displaying Crowdsec statistics. MySQL and PostgreSQL are currently not supported, must use SQLite (default) as storage database with your local API.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/crowdsec/data/",
      "container": "/metabase-data/",
      "mode": "rw",
      "description": "Location of crowdsec.db",
      "required": true
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/crowdsec/dashboard/",
      "container": "/data/",
      "mode": "rw",
      "description": "Location of metabase.db",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MUID",
      "key": "MUID",
      "value": "99",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "MGID",
      "key": "MGID",
      "value": "98",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Host Key 1",
      "key": "depends_on",
      "value": "crowdsec",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DB Location",
      "key": "MB_DB_FILE",
      "value": "/data/metabase.db",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
