{
  "name": "purgebot",
  "repo": "ghcr.io/prophetse7en/purgebot:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/prophetse7en/purgebot/pkgs/container/purgebot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3050]",
  "icon": "https://raw.githubusercontent.com/prophetse7en/purgebot/main/icon.png",
  "project": "https://github.com/prophetse7en/purgebot",
  "description": "Automated Discord message cleanup with retention policies, Web UI, and auto-discovery. Define per-category and per-channel retention rules, and PurgeBot handles the rest on a schedule or on-demand. Built-in Web UI for managing categories, editing retention, triggering runs, and viewing real-time logs.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/purgebot",
      "container": "/config",
      "mode": "rw",
      "description": "Config, logs, and stats storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3050",
      "container": "3050",
      "protocol": "tcp",
      "description": "Web UI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Discord Token",
      "key": "DISCORD_TOKEN",
      "value": "",
      "description": "Bot token from Discord Developer Portal",
      "required": true,
      "mask": true
    },
    {
      "name": "Guild ID",
      "key": "GUILD_ID",
      "value": "",
      "description": "Discord server (guild) ID",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file ownership",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file ownership",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "File creation mask",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
