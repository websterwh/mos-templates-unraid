{
  "name": "NetlifyDDNS",
  "repo": "daredoes/netlify-ddns:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/daredoes/netlify-ddns",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://api.iconify.design/logos/netlify.svg",
  "project": "https://github.com/oscartbeaumont/netlify-dynamic-dns",
  "description": "Like DuckDNS, but for Netlify",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Access Token",
      "key": "NETLIFY_TOKEN",
      "value": "",
      "description": "It can be created here: https://app.netlify.com/account/applications",
      "required": true,
      "mask": false
    },
    {
      "name": "Domain",
      "key": "NETLIFY_DOMAIN",
      "value": "example.com",
      "description": "Container Variable: NETLIFY_DOMAIN",
      "required": true,
      "mask": false
    },
    {
      "name": "Subdomain",
      "key": "NETLIFY_SUBDOMAIN",
      "value": "home",
      "description": "Container Variable: NETLIFY_SUBDOMAIN",
      "required": true,
      "mask": false
    },
    {
      "name": "Interval",
      "key": "NETLIFY_TTL",
      "value": "3600",
      "description": "Interval of time in minutes between IP address updates",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
