{
  "name": "Kometa-Asset-Manager",
  "repo": "ghcr.io/thedinz/kam:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/thedinz/kam",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/thedinz/unraid-templates/main/appdata/logo.png",
  "project": "https://github.com/thedinz/kam",
  "description": "KAM moves uploaded posters/backgrounds into Kometa asset folders and provides an in-app settings UI.",
  "paths": [
    {
      "name": "Assets Root",
      "host": "/mnt/cache/kometa/assets",
      "container": "/assets",
      "mode": "rw",
      "description": "Root folder that contains Movies/TV/Collections subfolders",
      "required": true
    },
    {
      "name": "Config Folder",
      "host": "/mnt/cache/appdata/kam",
      "container": "/config",
      "mode": "rw",
      "description": "Location to persist the KAM database and settings",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "7171",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container 8000 -> Host port for the web UI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Container timezone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
