{
  "name": "OVPN_Privoxy",
  "repo": "alturismo/ovpn_privoxy",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/alturismo/ovpn_privoxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--cap-add=NET_ADMIN --device /dev/net/tun --sysctl net.ipv6.conf.all.disable_ipv6=0 --dns=8.8.8.8",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8118]",
  "icon": "https://www.heise.de/download/media/openvpn-22153/openvpn-logo_1-1-30.png",
  "project": "https://github.com/alturismo/ovpn_privoxy",
  "description": "openvpn with privoxy in docker with cron after docker start check your config folder, add your *.ovpn file(s) and edit logindata.conf LOCAL_NET - CIDR mask of the local IP addresses which will acess the proxy and bypass it, comma seperated OPENVPN_FILE - full path to ovpn file OVPN_SOCKS - set to off if not wanted OVPN_PRIVOXY - set to off if not wanted ONLINECHECK - set to off if not wanted ONLINECHECK_IP - default 8.8.4.4, change if wanted use privoxy on ip:8118 use socks on ip:1080",
  "paths": [
    {
      "name": "/config",
      "host": "/mnt/cache/appdata/OpenVPN/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8118",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    },
    {
      "name": "Microsocks Port",
      "host": "1080",
      "container": "1080",
      "protocol": "tcp",
      "description": "Container Port: 1080",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "LOCAL_NET",
      "key": "LOCAL_NET",
      "value": "192.168.1.0/24",
      "description": "Container Variable: LOCAL_NET",
      "required": true,
      "mask": false
    },
    {
      "name": "OPENVPN_FILE",
      "key": "OPENVPN_FILE",
      "value": "Frankfurt.ovpn",
      "description": "Container Variable: OPENVPN_FILE",
      "required": true,
      "mask": false
    },
    {
      "name": "OVPN_PRIVOXY",
      "key": "OVPN_PRIVOXY",
      "value": "on",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OVPN_SOCKS",
      "key": "OVPN_SOCKS",
      "value": "on",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ONLINECHECK",
      "key": "ONLINECHECK",
      "value": "on",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ONLINECHECK_IP",
      "key": "ONLINECHECK_IP",
      "value": "8.8.4.4",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
