{
  "name": "blynk-server",
  "repo": "mpherg/blynk-server:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/mpherg/blynk-server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:9443]/admin",
  "icon": "https://lh3.googleusercontent.com/rTRWfl713otPTrmafsJ3OLb7I30XS1iBSZyP1WXYXKAlwkTMhihdMw_gDv5ogjEtQ1P6",
  "project": null,
  "description": "Template to setup a Blynk server on Unraid There is an issue where this Docker doesn't seem to create the server.properties file in the config directory, located at appdata/blynk-server/config by default. You will need manually create this file before the server will start. Just create a blank file at that location called server.properties and your server will start.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/blynk-server/data",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/blynk-server/config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    },
    {
      "name": "Host Port 2",
      "host": "9443",
      "container": "9443",
      "protocol": "tcp",
      "description": "Container Port: 9443",
      "required": false,
      "mask": false
    },
    {
      "name": "Host Port 3",
      "host": "8440",
      "container": "8440",
      "protocol": "tcp",
      "description": "Container Port: 8440",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
