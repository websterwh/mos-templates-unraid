{
  "name": "Photoview",
  "repo": "viktorstrate/photoview",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/viktorstrate/photoview",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/photoview.png",
  "project": "https://github.com/photoview/photoview",
  "description": "Photoview is a simple and user-friendly photo gallery that can easily be installed on personal servers. It's made for photographers and aims to provide an easy and fast way to navigate directories, with thousands of high resolution photos.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/photoview",
      "container": "/app/cache",
      "mode": "rw",
      "description": "Container Path: /app/cache",
      "required": true
    },
    {
      "name": "Photos Share",
      "host": "/mnt/cache/photos/",
      "container": "/photos",
      "mode": "ro",
      "description": "Container Path: /photos",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "8694",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PHOTOVIEW_MYSQL_URL",
      "key": "PHOTOVIEW_MYSQL_URL",
      "value": "user:pass@tcp(IP:PORT)/database",
      "description": "Example: photouser:photopass@tcp(192.168.1.100:3306)/photoview",
      "required": true,
      "mask": false
    },
    {
      "name": "PHOTOVIEW_PUBLIC_ENDPOINT",
      "key": "PHOTOVIEW_PUBLIC_ENDPOINT",
      "value": "https://photos.domain.com/",
      "description": "Public URL for generating sharable links.",
      "required": false,
      "mask": false
    },
    {
      "name": "MAPBOX_TOKEN",
      "key": "MAPBOX_TOKEN",
      "value": "",
      "description": "To enable map features, a token can be generated for free here https://account.mapbox.com/access-tokens/",
      "required": false,
      "mask": false
    },
    {
      "name": "PHOTOVIEW_MEDIA_CACHE",
      "key": "PHOTOVIEW_MEDIA_CACHE",
      "value": "/app/cache",
      "description": "Container Variable: PHOTOVIEW_MEDIA_CACHE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
