{
  "name": "Flixor",
  "repo": "ghcr.io/flixorui/flixor:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/flixorui/flixor",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/flixor-icon.png",
  "project": "https://github.com/Flixorui/flixor",
  "description": "A fast, Netflix\u2011style web app, Android, iOS, and MacOS for your Plex library. Browse beautiful rows, see rich details (IMDb/Rotten Tomatoes), and play instantly in your browser with built\u2011in DASH/HLS playback. Works on any modern desktop or mobile browser.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/flixor/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to the config files",
      "required": true
    },
    {
      "name": "Cache Path",
      "host": "/mnt/cache/appdata/flixor/cache",
      "container": "/app/cache",
      "mode": "rw",
      "description": "Path to the cache files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Session Secret",
      "key": "SESSION_SECRET",
      "value": "",
      "description": "A long, random string used to sign session cookies.",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
