{
  "name": "Mp4Forge",
  "repo": "ghcr.io/jessielw/mp4forge",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/jessielw/MP4Forge/pkgs/container/mp4forge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://github.com/jessielw/MP4Forge/blob/main/runtime/images/mp4.png?raw=true",
  "project": "https://github.com/jessielw/MP4Forge",
  "description": "Mp4Forge (https://github.com/jessielw/MP4Forge) is a lightweight open source MP4Box GUI.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/mp4forge/runtime",
      "container": "/app/runtime",
      "mode": "rw",
      "description": "Config and logs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port for webui",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
