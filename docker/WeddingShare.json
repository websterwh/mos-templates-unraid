{
  "name": "WeddingShare",
  "repo": "cirx08/wedding_share:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/cirx08/wedding_share",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/Cirx08/WeddingShare/master/logo.png",
  "project": "https://github.com/Cirx08/WeddingShare",
  "description": "WeddingShare is a very basic site with only one goal. It provides you and your guests a way to share memories of and leading up to the big day.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/WeddingShare/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to configuration related data",
      "required": true
    },
    {
      "name": "Uploads Path",
      "host": "/mnt/cache/appdata/WeddingShare/uploads",
      "container": "/app/wwwroot/uploads",
      "mode": "rw",
      "description": "Path to gallery images",
      "required": true
    },
    {
      "name": "Thumbnails Path",
      "host": "/mnt/cache/appdata/WeddingShare/thumbnails",
      "container": "/app/wwwroot/thumbnails",
      "mode": "rw",
      "description": "Path to image thumbnails",
      "required": true
    },
    {
      "name": "Custom Resources Path",
      "host": "/mnt/cache/appdata/WeddingShare/custom_resources",
      "container": "/app/wwwroot/custom_resources",
      "mode": "rw",
      "description": "Path to custom uploaded resource files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Port used to connect to the web UI",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Title",
      "key": "TITLE",
      "value": "WeddingShare",
      "description": "Application title to appear in headers",
      "required": false,
      "mask": false
    },
    {
      "name": "Logo",
      "key": "LOGO",
      "value": "/images/logo.png",
      "description": "Relative path to the logo image",
      "required": false,
      "mask": false
    },
    {
      "name": "Single Gallery Mode",
      "key": "SINGLE_GALLERY_MODE",
      "value": "false",
      "description": "Should this instance host a single gallery instance. Set to false for multi-gallery instances",
      "required": false,
      "mask": false
    },
    {
      "name": "Owner Username",
      "key": "ACCOUNT_OWNER_USERNAME",
      "value": "admin",
      "description": "The username of the primary owner account",
      "required": false,
      "mask": false
    },
    {
      "name": "Owner Password",
      "key": "ACCOUNT_OWNER_PASSWORD",
      "value": "admin",
      "description": "The password of the primary owner account",
      "required": false,
      "mask": true
    },
    {
      "name": "Encryption Key",
      "key": "ENCRYPTION_KEY",
      "value": "ChangeMe",
      "description": "The key used to encrypt data",
      "required": false,
      "mask": true
    },
    {
      "name": "Encryption Salt",
      "key": "ENCRYPTION_SALT",
      "value": "ChangeMe",
      "description": "The salt used to randomize the encryption",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
