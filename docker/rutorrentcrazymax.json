{
  "name": "rutorrent-crazymax",
  "repo": "crazymax/rtorrent-rutorrent",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/crazy-max/docker-rtorrent-rutorrent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--ulimit nproc=65535 --ulimit nofile=32000:40000",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://github.com/superboki/ressources/blob/main/rutorrent-crazymax/rutorrent-crazymax.png?raw=true",
  "project": "https://github.com/crazy-max/docker-rtorrent-rutorrent",
  "description": "Si vous \u00eates sujets au bug connu de la 6.10.1 concernant les droits utilisateurs : Apr\u00e8s l'installation du container : - ouvrir un Terminal depuis Unraid : - executer les commandes suivantes chmod -R 0775 /mnt/user/appdata/rutorrent-crazymax chown -R 99:100 /mnt/user/appdata/rutorrent-crazymax Apr\u00e8s quoi vous pourrez modifier la variable PORT FORWARD. ------------------------------------------------------------------------- Pour ajouter un mot de passe sans passer par nginx proxy manager - clic droit sur le container rutorrent -> Console - Taper la ligne ci-dessous htpasswd -Bbn pseudo mot_de_passe >> /passwd/rutorrent.htpasswd - Remplacer par votre pseudo et votre mot de passe - Red\u00e9marrer le container",
  "paths": [
    {
      "name": "Dossier de telechargement",
      "host": "/mnt/cache/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/rutorrent-crazymax/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "stockage du htpassword",
      "host": "/mnt/cache/appdata/rutorrent-crazymax/passwd",
      "container": "/passwd",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port allou\u00e9 au service DHT (si besoin)",
      "host": "6881",
      "container": "6881",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Webui de Rutorrent",
      "host": "8095",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Port Forward (doit \u00eatre identique \u00e0 la valeur pr\u00e9cedente)",
      "host": "50000",
      "container": "50000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Port Forward",
      "key": "RT_INC_PORT",
      "value": "50000",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
