{
  "name": "snipe-it",
  "repo": "lscr.io/linuxserver/snipe-it",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/snipe-it",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/setup",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/snipe-it-logo.png",
  "project": "https://github.com/grokability/snipe-it",
  "description": "Snipe-it(https://github.com/grokability/snipe-it) makes asset management easy. It was built by people solving real-world IT and asset management problems, and a solid UX has always been a top priority. Straightforward design and bulk actions mean getting things done faster.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Contains your config files and data storage for Snipe-IT",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Snipe-IT Web UI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_KEY",
      "key": "APP_KEY",
      "value": "",
      "description": "App key used for encrypting stored data. Generate with `docker exec snipe-it php /app/www/artisan key:generate --show`.",
      "required": true,
      "mask": true
    },
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "http://localhost:8080",
      "description": "Hostname or IP and port if applicable, be sure to define https/http",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_PORT_3306_TCP_ADDR",
      "key": "MYSQL_PORT_3306_TCP_ADDR",
      "value": "",
      "description": "Mysql hostname or IP to use",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_PORT_3306_TCP_PORT",
      "key": "MYSQL_PORT_3306_TCP_PORT",
      "value": "",
      "description": "Mysql port to use",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_DATABASE",
      "key": "MYSQL_DATABASE",
      "value": "",
      "description": "Mysql database to use",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_USER",
      "key": "MYSQL_USER",
      "value": "",
      "description": "Mysql user to use",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_PASSWORD",
      "key": "MYSQL_PASSWORD",
      "value": "",
      "description": "Mysql password to use",
      "required": true,
      "mask": true
    },
    {
      "name": "APP_DEBUG",
      "key": "APP_DEBUG",
      "value": "false",
      "description": "Set to `true` to see debugging output in the web UI.",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_ENV",
      "key": "APP_ENV",
      "value": "production",
      "description": "Default is `production` but can use `testing` or `develop`.",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_FORCE_TLS",
      "key": "APP_FORCE_TLS",
      "value": "false",
      "description": "Set to `true` if running behind a reverse proxy",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_LOCALE",
      "key": "APP_LOCALE",
      "value": "",
      "description": "Default is `en-US`. Set to a language from this list(https://snipe-it.readme.io/docs/configuration#section-setting-a-language).",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PORT_587_TCP_ADDR",
      "key": "MAIL_PORT_587_TCP_ADDR",
      "value": "",
      "description": "SMTP mail server ip or hostname.",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PORT_587_TCP_PORT",
      "key": "MAIL_PORT_587_TCP_PORT",
      "value": "",
      "description": "SMTP mail server port.",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_ENV_FROM_ADDR",
      "key": "MAIL_ENV_FROM_ADDR",
      "value": "",
      "description": "The email address mail should be replied to and listed when sent.",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_ENV_FROM_NAME",
      "key": "MAIL_ENV_FROM_NAME",
      "value": "",
      "description": "The name listed on email sent from the default account on the system.",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_ENV_ENCRYPTION",
      "key": "MAIL_ENV_ENCRYPTION",
      "value": "",
      "description": "Mail encryption to use e.g. `tls`.",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_ENV_USERNAME",
      "key": "MAIL_ENV_USERNAME",
      "value": "",
      "description": "SMTP server login username.",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_ENV_PASSWORD",
      "key": "MAIL_ENV_PASSWORD",
      "value": "",
      "description": "SMTP server login password.",
      "required": false,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
