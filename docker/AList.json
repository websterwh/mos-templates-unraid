{
  "name": "AList",
  "repo": "xhofe/alist:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/xhofe/alist",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5244]",
  "icon": "https://alist.nn.ci/logo.svg",
  "project": "https://github.com/Xhofe/alist",
  "description": "A file list program that supports multiple storage, and supports web browsing and webdav, powered by gin and React. English documents are translated using Google.You can click the Edit this page button below to help improve the translation Important: Initial password in the log.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/",
      "container": "/mnt/data",
      "mode": "rw",
      "description": "Mount at /mnt/data",
      "required": false
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/alist",
      "container": "/opt/alist/data",
      "mode": "rw",
      "description": "Appdata Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5244",
      "container": "5244",
      "protocol": "tcp",
      "description": "Web UI Port: 5244",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
