{
  "name": "Promtail-Syslog",
  "repo": "mcjoppy/promtail-syslog",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/repository/docker/mcjoppy/promtail-syslog",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9080]",
  "icon": "https://raw.githubusercontent.com/McJoppy/promtail-syslog/main/icon/grafana-loki.png",
  "project": "https://github.com/McJoppy/promtail-syslog",
  "description": "Run a remote syslog server which will send to Grafana Loki and can be used for routers, switches and other hardware that allows sending logs to remote syslog and not install and configure promtail directly.",
  "paths": [],
  "ports": [
    {
      "name": "Syslog TCP",
      "host": "1514",
      "container": "514",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Syslog UDP",
      "host": "1514",
      "container": "514",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Web UI",
      "host": "9080",
      "container": "9080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Loki Client URL",
      "key": "CLIENT_URL",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
