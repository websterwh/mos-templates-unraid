{
  "name": "github-actions-runner-exporter",
  "repo": "ghcr.io/drumandbytes/github-actions-runner-exporter:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/drumandbytes/github-actions-runner-exporter/pkgs/container/github-actions-runner-exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9222]/metrics",
  "icon": "https://raw.githubusercontent.com/drumandbytes/unraid-templates/main/icons/github-actions-runner-exporter.png",
  "project": "https://github.com/drumandbytes/github-actions-runner-exporter",
  "description": "Prometheus exporter for GitHub Actions self-hosted runner status (online/busy), plus repo CI health, PR counts and Dependabot alerts, polled from the org API on a rate-limit-friendly cache.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "9222",
      "container": "9222",
      "protocol": "tcp",
      "description": "Metrics port (/metrics, /healthz).",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "GitHub org",
      "key": "GITHUB_ORG",
      "value": "",
      "description": "Organization whose runners to watch.",
      "required": true,
      "mask": false
    },
    {
      "name": "GitHub token",
      "key": "GITHUB_TOKEN",
      "value": "",
      "description": "Token with read access to org self-hosted runners; see the README.",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
