{
  "name": "Grimmory",
  "repo": "ghcr.io/grimmory-tools/grimmory:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/grimmory-tools/grimmory",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6060]",
  "icon": "https://raw.githubusercontent.com/Watso4183/Unraid/master/grimmory.png",
  "project": "https://github.com/grimmory-tools/grimmory",
  "description": "Grimmory, previously known as BookLore, is a self-hosted application for managing your entire book collection in one place. Organize, read, annotate, sync across devices, and share without relying on third-party services.",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/grimmory",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "bookdrop",
      "host": "/mnt/cache/appdata/grimmory",
      "container": "/bookdrop",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Books",
      "host": "/mnt/cache/Books",
      "container": "/books",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6060",
      "container": "6060",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "jdbc:mariadb://localhost:3306/grimmory",
      "description": "Database URL",
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_USERNAME",
      "key": "DATABASE_USERNAME",
      "value": "grimmory",
      "description": "Database Username",
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_PASSWORD",
      "key": "DATABASE_PASSWORD",
      "value": "password",
      "description": "Database Password",
      "required": true,
      "mask": false
    },
    {
      "name": "USER_ID",
      "key": "USER_ID",
      "value": "500",
      "description": "USER_ID",
      "required": true,
      "mask": false
    },
    {
      "name": "GROUP_ID",
      "key": "GROUP_ID",
      "value": "500",
      "description": "GROUP_ID",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
