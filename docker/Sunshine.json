{
  "name": "Sunshine",
  "repo": "lizardbyte/sunshine:latest-debian-bookworm",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/lizardbyte/sunshine",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:47990]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/sunshine-icon.png",
  "project": "https://app.lizardbyte.dev/Sunshine/",
  "description": "A self-hosted game stream host for Moonlight. You can connect to Sunshine from any Moonlight client on a variety of devices. See documentation for further configuration: https://docs.lizardbyte.dev/projects/sunshine/en/latest/about/docker.html",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/sunshine/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Server Port",
      "host": "48010",
      "container": "48010",
      "protocol": "tcp",
      "description": "Server Port",
      "required": true,
      "mask": false
    },
    {
      "name": "TCP Ports",
      "host": "47984-47990",
      "container": "47984-47990",
      "protocol": "tcp",
      "description": "TCP ports for client traffic",
      "required": true,
      "mask": false
    },
    {
      "name": "UDP Ports",
      "host": "47998-48000",
      "container": "47998-48000",
      "protocol": "udp",
      "description": "UDP ports for client traffic",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
