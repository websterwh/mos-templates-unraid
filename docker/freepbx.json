{
  "name": "freepbx",
  "repo": "tiredofit/freepbx:15-latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/tiredofit/freepbx/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/admin/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/freepbx.png",
  "project": "https://github.com/tiredofit/docker-freepbx/",
  "description": "FreePBX is a web-based open-source graphical user interface that manages Asterisk, a voice over IP and telephony server.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/freepbx/data/",
      "container": "/data",
      "mode": "rw",
      "description": "Data",
      "required": false
    },
    {
      "name": "Log",
      "host": "/mnt/cache/appdata/freepbx/logs/",
      "container": "/var/log",
      "mode": "rw",
      "description": "Log",
      "required": false
    },
    {
      "name": "WWW",
      "host": "/mnt/cache/appdata/freepbx/www/",
      "container": "/var/www/html",
      "mode": "rw",
      "description": "WWW",
      "required": false
    },
    {
      "name": "Certs",
      "host": "/mnt/cache/appdata/freepbx/certs/",
      "container": "/certs",
      "mode": "rw",
      "description": "Certs",
      "required": false
    },
    {
      "name": "DB Path",
      "host": "/mnt/cache/appdata/freepbx/db/",
      "container": "/var/lib/mysql",
      "mode": "rw",
      "description": "DB Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8150",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPs",
      "host": "4150",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPs",
      "required": false,
      "mask": false
    },
    {
      "name": "PJSIP",
      "host": "5060",
      "container": "5060",
      "protocol": "udp",
      "description": "PJSIP",
      "required": false,
      "mask": false
    },
    {
      "name": "SIP",
      "host": "5160",
      "container": "5160",
      "protocol": "udp",
      "description": "SIP",
      "required": false,
      "mask": false
    },
    {
      "name": "TLS SIP",
      "host": "5161",
      "container": "5161",
      "protocol": "tcp",
      "description": "TLS SIP",
      "required": false,
      "mask": false
    },
    {
      "name": "RTP Ports",
      "host": "18000-20000",
      "container": "18000-20000",
      "protocol": "udp",
      "description": "RTP Ports",
      "required": false,
      "mask": false
    },
    {
      "name": "FOP",
      "host": "4445",
      "container": "4445",
      "protocol": "tcp",
      "description": "FOP",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_EMBEDDED",
      "key": "DB_EMBEDDED",
      "value": "TRUE",
      "description": "Allows you to use an internally provided MariaDB Server e.g. TRUE or FALSE",
      "required": false,
      "mask": false
    },
    {
      "name": "ENABLE_FAIL2BAN",
      "key": "ENABLE_FAIL2BAN",
      "value": "FALSE",
      "description": "ENABLE_FAIL2BAN",
      "required": false,
      "mask": false
    },
    {
      "name": "Flash Operator Panel",
      "key": "ENABLE_FOP",
      "value": "TRUE",
      "description": "Enable Flash Operator Panel",
      "required": false,
      "mask": false
    },
    {
      "name": "ENABLE_SSL",
      "key": "ENABLE_SSL",
      "value": "FALSE",
      "description": "Enable HTTPs to serve SSL requests - Default FALSE",
      "required": false,
      "mask": false
    },
    {
      "name": "ENABLE_XMPP",
      "key": "ENABLE_XMPP",
      "value": "FALSE",
      "description": "Enable XMPP Module with MongoDB - Default FALSE",
      "required": false,
      "mask": false
    },
    {
      "name": "INSTALL_ADDITIONAL_MODULES",
      "key": "INSTALL_ADDITIONAL_MODULES",
      "value": "",
      "description": "Comma seperated list of modules to additionally install on first container startup",
      "required": false,
      "mask": false
    },
    {
      "name": "RTP_START",
      "key": "RTP_START",
      "value": "18000",
      "description": "What port to start RTP Transmissions",
      "required": false,
      "mask": false
    },
    {
      "name": "RTP_FINISH",
      "key": "RTP_FINISH",
      "value": "20000",
      "description": "What port to end RTP Transmissions",
      "required": false,
      "mask": false
    },
    {
      "name": "TLS_CERT",
      "key": "TLS_CERT",
      "value": "cert.pem",
      "description": "TLS Certificate to drop in /certs for HTTPS if no reverse proxy",
      "required": false,
      "mask": false
    },
    {
      "name": "TLS_KEY",
      "key": "TLS_KEY",
      "value": "key.pem",
      "description": "TLS Key to drop in /certs for HTTPS if no reverse proxy",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_EMBEDDED",
      "key": "DB_EMBEDDED",
      "value": "TRUE",
      "description": "Allows you to use an internally provided MariaDB Server e.g. TRUE or FALSE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
