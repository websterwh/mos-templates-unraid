{
  "name": "Kaizoku",
  "repo": "ghcr.io/oae/kaizoku:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/oae/kaizoku",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/oae/kaizoku/main/public/kaizoku.png",
  "project": "https://kaizoku.app/",
  "description": "A self-hosted manga downloader.",
  "paths": [
    {
      "name": "Library Path",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Path to store downloaded files",
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/kaizoku/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to store configuration files",
      "required": true
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/kaizoku/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Path to store logs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Postgres - Database URL",
      "key": "DATABASE_URL",
      "value": "postgresql://kaizoku:kaizoku@db:5432/kaizoku",
      "description": "Postgres database URL",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis - Host",
      "key": "REDIS_HOST",
      "value": "",
      "description": "Redis host",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis - Port",
      "key": "REDIS_PORT",
      "value": "6379",
      "description": "Redis port",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Port",
      "key": "KAIZOKU_PORT",
      "value": "3000",
      "description": "Internal port for Kaizoku. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
