{
  "name": "Snapcast",
  "repo": "kevineye/snapcast",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/kevineye/snapcast",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "snapserver -s pipe:///data/snapfifo?name=Example&sampleformat=44100:16:2",
  "web_ui_url": null,
  "icon": "https://icons.iconarchive.com/icons/alecive/flatwoken/512/Apps-Player-Audio-icon.png",
  "project": "https://hub.docker.com/r/kevineye/snapcast",
  "description": "use this Audio option in mopidy.conf in mopidy docker to use Snapcast: [audio] output = audioresample ! audio/x-raw,rate=48000,channels=2,format=S16LE ! audioconvert ! wavenc ! filesink location=/tmp/snapfifo",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/mopidy/tmp/",
      "container": "/data/",
      "mode": "rw",
      "description": "Container Path: /data/",
      "required": false
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
