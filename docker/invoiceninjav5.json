{
  "name": "invoiceninja-v5",
  "repo": "maihai/invoiceninja_v5",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/maihai/invoiceninja_v5",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:443]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/invoiceninja.png",
  "project": "https://www.invoiceninja.com/",
  "description": "Invoice Ninja v5: an open-source invoicing and time-tracking app built with Laravel https://www.invoiceninja.com. This container requires a separate MySQL running container and the credentials passed via DB_* variables below. SSL certificates are generated automatically and stored in certs/ folder in Storage as invoiceninja.crt and invoiceninja.key. Feel free to overwrite this files with others, if you use LetsEncrypt for example. When migrating for v4 to v5 please follow this tutorial: https://github.com/kiwimato/invoiceninja_v5#upgrade-from-v4-to-v5",
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/invoiceninjav5/storage",
      "container": "/var/www/app/storage",
      "mode": "rw",
      "description": "Container Path: /var/www/app/storage",
      "required": false
    },
    {
      "name": "Logo",
      "host": "/mnt/cache/appdata/invoiceninjav5/logo",
      "container": "/var/www/app/public/storage",
      "mode": "rw",
      "description": "Container Path: /var/www/app/public/storage",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8000",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "8443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_ENV",
      "key": "APP_ENV",
      "value": "production",
      "description": "Container Variable: APP_ENV",
      "required": false,
      "mask": false
    },
    {
      "name": "Debug Mode",
      "key": "APP_DEBUG",
      "value": "0",
      "description": "Container Variable: APP_DEBUG",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Host",
      "key": "DB_HOST",
      "value": "unraidIP",
      "description": "Container Variable: DB_HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "Database port",
      "key": "DB_PORT",
      "value": "3306",
      "description": "Container Variable: DB_PORT",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "DB_DATABASE",
      "value": "ninjav5",
      "description": "Container Variable: DB_DATABASE",
      "required": true,
      "mask": false
    },
    {
      "name": "Database username",
      "key": "DB_USERNAME",
      "value": "ninjav5",
      "description": "Container Variable: DB_USERNAME",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "DB_PASSWORD",
      "value": "ninja",
      "description": "Container Variable: DB_PASSWORD",
      "required": true,
      "mask": true
    },
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "https://unraidIP:port",
      "description": "Container Variable: APP_URL",
      "required": false,
      "mask": false
    },
    {
      "name": "IN_USER_EMAIL",
      "key": "IN_USER_EMAIL",
      "value": "",
      "description": "Initial user email",
      "required": true,
      "mask": false
    },
    {
      "name": "IN_PASSWORD",
      "key": "IN_PASSWORD",
      "value": "",
      "description": "Initial user password",
      "required": true,
      "mask": true
    },
    {
      "name": "SNAPPDF_EXECUTABLE_PATH",
      "key": "SNAPPDF_EXECUTABLE_PATH",
      "value": "/usr/bin/chromium-browser",
      "description": "Container Variable: SNAPPDF_EXECUTABLE_PATH",
      "required": false,
      "mask": false
    },
    {
      "name": "PHANTOMJS_PDF_GENERATION",
      "key": "PHANTOMJS_PDF_GENERATION",
      "value": "false",
      "description": "Container Variable: PHANTOMJS_PDF_GENERATION",
      "required": false,
      "mask": false
    },
    {
      "name": "QUEUE_CONNECTION",
      "key": "QUEUE_CONNECTION",
      "value": "database",
      "description": "Container Variable: QUEUE_CONNECTION",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_MAILER",
      "key": "MAIL_MAILER",
      "value": "log",
      "description": "Container Variable: MAIL_MAILER",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PORT",
      "key": "MAIL_PORT",
      "value": "587",
      "description": "Container Variable: MAIL_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_ENCRYPTION",
      "key": "MAIL_ENCRYPTION",
      "value": "tls",
      "description": "Container Variable: MAIL_ENCRYPTION",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_HOST",
      "key": "MAIL_HOST",
      "value": "smtp.example.com",
      "description": "Container Variable: MAIL_HOST",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_USERNAME",
      "key": "MAIL_USERNAME",
      "value": "null",
      "description": "Container Variable: MAIL_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_FROM_ADDRESS",
      "key": "MAIL_FROM_ADDRESS",
      "value": "null",
      "description": "Container Variable: MAIL_FROM_ADDRESS",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_FROM_NAME",
      "key": "MAIL_FROM_NAME",
      "value": "Invoice Department",
      "description": "Container Variable: MAIL_FROM_NAME",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PASSWORD",
      "key": "MAIL_PASSWORD",
      "value": "SUPERSECRETEMAILPASSWORD",
      "description": "Container Variable: MAIL_PASSWORD",
      "required": false,
      "mask": true
    },
    {
      "name": "MEMORY_LIMIT",
      "key": "MEMORY_LIMIT",
      "value": "256M",
      "description": "Container Variable: MEMORY_LIMIT",
      "required": false,
      "mask": false
    },
    {
      "name": "Require HTTPS",
      "key": "REQUIRE_HTTPS",
      "value": "false",
      "description": "Whether to force redirect http to https",
      "required": false,
      "mask": false
    },
    {
      "name": "SSL_HOSTNAME",
      "key": "SSL_HOSTNAME",
      "value": "tower",
      "description": "Hostname to be used as SSL CN",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
