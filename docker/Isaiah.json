{
  "name": "Isaiah",
  "repo": "mosswill/isaiah:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/mosswill/isaiah",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/master/logos/isaiah.png",
  "project": "https://github.com/will-moss/isaiah",
  "description": "Self-hostable clone of lazydocker for the web. Manage your Docker fleet with ease.",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3912",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Authentication Secret",
      "key": "AUTHENTICATION_SECRET",
      "value": "your-very-long-and-mysterious-secret",
      "description": "Used to access your servers web portal",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
