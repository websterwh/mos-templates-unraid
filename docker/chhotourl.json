{
  "name": "chhoto-url",
  "repo": "sintan1729/chhoto-url:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/sintan1729/chhoto-url",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4567]",
  "icon": "https://raw.githubusercontent.com/Collectathon/unraid-templates/refs/heads/main/icons/chhoto-url.png",
  "project": "https://github.com/SinTan1729/chhoto-url",
  "description": "A simple selfhosted URL shortener with no unnecessary features. Simplicity and speed are the main foci of this project. The docker image is ~6 MB (compressed), and it uses 5 MB of RAM under regular use. Setup: mkdir /mnt/user/appdata/chhoto-url touch /mnt/user/appdata/chhoto-url/urls.sqlite",
  "paths": [
    {
      "name": "Database",
      "host": "/mnt/cache/appdata/chhoto-url/urls.sqlite",
      "container": "/urls.sqlite",
      "mode": "rw",
      "description": "Location of the URL database",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "4567",
      "container": "4567",
      "protocol": "tcp",
      "description": "Web UI Pro",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Password (Recommended)",
      "key": "password",
      "value": "",
      "description": "Password for Web UI",
      "required": false,
      "mask": true
    },
    {
      "name": "Base URL (Optional)",
      "key": "site_url",
      "value": "",
      "description": "Base URL",
      "required": false,
      "mask": false
    },
    {
      "name": "API Key (Optional)",
      "key": "api_key",
      "value": "masterkeymasterkeymasterkeymasterkey",
      "description": "Activate JSON result mode",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
