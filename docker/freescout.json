{
  "name": "freescout",
  "repo": "tiredofit/freescout:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/tiredofit/freescout/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/freescout.png",
  "project": "https://freescout.net/",
  "description": "Open Source Helpscout/Zendesk Alternative based on Alpine linux. Creating account CLI \"cd /www/html\" then \"php artisan freescout:create-user\"",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/freescout/",
      "container": "/data",
      "mode": "rw",
      "description": "Data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APPLICATION_NAME",
      "key": "APPLICATION_NAME",
      "value": "Freescout",
      "description": "Change default application name",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "DB HOST",
      "description": "Host or container name of MariaDB Server e.g",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "3306",
      "description": "MariaDB Port",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "freescout",
      "description": "MariaDB Database name e.g.",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_DATABASE",
      "key": "DB_DATABASE",
      "value": "freescout",
      "description": "DB to use for CLI environment",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "root",
      "description": "MariaDB Username for above Database e.g.",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": "root",
      "description": "DB username for CLI environment",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PASS",
      "key": "DB_PASS",
      "value": "password",
      "description": "MariaDB Password for above Database e.g.",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "password",
      "description": "DB Pass for CLI environment",
      "required": false,
      "mask": false
    },
    {
      "name": "SITE_URL",
      "key": "SITE_URL",
      "value": "http://&lt;IP&gt;:8000",
      "description": "The url your site listens",
      "required": false,
      "mask": false
    },
    {
      "name": "DISPLAY_ERRORS",
      "key": "DISPLAY_ERRORS",
      "value": "FALSE",
      "description": "Display Errors on Website",
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_EMAIL",
      "key": "ADMIN_EMAIL",
      "value": "admin@admin.com",
      "description": "Admin Email address",
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_FIRST_NAME",
      "key": "ADMIN_FIRST_NAME",
      "value": "Admin",
      "description": "Admin first name",
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_LAST_NAME",
      "key": "ADMIN_LAST_NAME",
      "value": "User",
      "description": "Admin Last Name",
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_PASS",
      "key": "ADMIN_PASS",
      "value": "Passw0rd",
      "description": "Admin password",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
