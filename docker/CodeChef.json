{
  "name": "CodeChef",
  "repo": "ghcr.io/ipdotsetaf/codechef:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/ipdotsetaf/codechef",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4200]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/codechef-icon.png",
  "project": "https://codechef.ipdotsetaf.ir/",
  "description": "A developer tool for converting different languages repetitive codes to another language.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4200",
      "container": "4200",
      "protocol": "tcp",
      "description": "Container Port: 4200",
      "required": true,
      "mask": false
    },
    {
      "name": "Proxy Port",
      "host": "50505",
      "container": "50505",
      "protocol": "tcp",
      "description": "Proxy Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Allowed Origin",
      "key": "ALLOWED_ORIGIN",
      "value": "http://localhost:4200",
      "description": "Allowed Origin",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
