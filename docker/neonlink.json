{
  "name": "neonlink",
  "repo": "alexscifier/neonlink:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/alexscifier/neonlink/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user=0:0",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3333]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/neonlink.png",
  "project": "https://github.com/AlexSciFier/neonlink",
  "description": "Simple self-hosted bookmark service.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/neonlink/data/",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Background Path",
      "host": "/mnt/cache/appdata/neonlink/background/",
      "container": "/app/public/static/media/background",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "3333",
      "container": "3333",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "FASTIFY_PLUGIN_TIMEOUT",
      "key": "FASTIFY_PLUGIN_TIMEOUT",
      "value": "120000",
      "description": "optional: change to 0 if AVV_ERR_READY TIMEOUT error is occured",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
