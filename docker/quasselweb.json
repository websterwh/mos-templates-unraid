{
  "name": "quassel-web",
  "repo": "lscr.io/linuxserver/quassel-web",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/quassel-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:64443]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/quassel-web-logo.png",
  "project": "https://github.com/magne4000/quassel-webserver",
  "description": "Quassel-web(https://github.com/magne4000/quassel-webserver) is a web client for Quassel. Note that a Quassel-Core instance is required, we have a container available here.(https://hub.docker.com/r/linuxserver/quassel-core/)",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "this will store config on the docker host",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port: 64080",
      "host": "64080",
      "container": "64080",
      "protocol": "tcp",
      "description": "Quassel-web http webui",
      "required": false,
      "mask": false
    },
    {
      "name": "Port: 64443",
      "host": "64443",
      "container": "64443",
      "protocol": "tcp",
      "description": "Quassel-web https webui",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "QUASSEL_CORE",
      "key": "QUASSEL_CORE",
      "value": "192.168.1.10",
      "description": "specify the URL or IP address of your Quassel Core instance",
      "required": false,
      "mask": false
    },
    {
      "name": "QUASSEL_PORT",
      "key": "QUASSEL_PORT",
      "value": "4242",
      "description": "specify the port of your Quassel Core instance",
      "required": false,
      "mask": false
    },
    {
      "name": "QUASSEL_HTTPS",
      "key": "QUASSEL_HTTPS",
      "value": "",
      "description": "Set to `true` to have Quassel web serve over https on port 64443 instead of http on port 64080.",
      "required": false,
      "mask": false
    },
    {
      "name": "URL_BASE",
      "key": "URL_BASE",
      "value": "/quassel",
      "description": "Specify a url-base in reverse proxy setups ie. `/quassel`",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
