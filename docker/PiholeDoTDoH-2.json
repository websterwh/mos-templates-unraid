{
  "name": "Pihole-DoT-DoH",
  "repo": "testdasi/pihole-dot-doh:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/testdasi/pihole-dot-doh/",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN --restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/admin",
  "icon": "https://raw.githubusercontent.com/testdasi/pihole-base-buster-plus/master/pi_hole_bw.png",
  "project": "https://docs.pi-hole.net/guides/dns-over-https/",
  "description": "Pi-Hole - let's block those pesky ads! Now with DNS-over-HTTPS and DNS-over-TLS! pihole.doh! Don't send your DNS queries in plain text. YOU MUST ASSIGN A STATIC IP TO THE DOCKER FOR PIHOLE TO WORK. You must set both DNS1 and DNS2 variables to 127.1.1.1#5153 (DoH) and/or 127.2.2.2#5253 (DoT). To use just DoH or just DoT, set both DNS1 and DNS2 to the same value. Otherwise, same instructions as official Pi-Hole. NOTE 1: Port 53 can only be used with custom br0/br1 network and a static IP address. NOTE 2: DNS lookup rarely ever works with ports other than 53 i.e. see note above about static IP. NOTE 3: Unraid network settings DNS server cannot point to a docker IP.",
  "paths": [
    {
      "name": "pihole config",
      "host": "/mnt/cache/appdata/pihole-dot-doh/pihole/",
      "container": "/etc/pihole/",
      "mode": "rw",
      "description": "Container Path: /etc/pihole/",
      "required": true
    },
    {
      "name": "dnsmasq config",
      "host": "/mnt/cache/appdata/pihole-dot-doh/dnsmasq.d/",
      "container": "/etc/dnsmasq.d/",
      "mode": "rw",
      "description": "Container Path: /etc/dnsmasq.d/",
      "required": true
    },
    {
      "name": "DoT DoH config",
      "host": "/mnt/cache/appdata/pihole-dot-doh/config/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "DNS Port TCP",
      "host": "53",
      "container": "53",
      "protocol": "tcp",
      "description": "Container Port: 53",
      "required": true,
      "mask": false
    },
    {
      "name": "DNS Port UDP",
      "host": "53",
      "container": "53",
      "protocol": "udp",
      "description": "Container Port: 53",
      "required": true,
      "mask": false
    },
    {
      "name": "DHCP Port",
      "host": "67",
      "container": "67",
      "protocol": "udp",
      "description": "Container Port: 67",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ENV 1",
      "key": "DNS1",
      "value": "127.1.1.1#5153",
      "description": "Container Variable: DNS1",
      "required": true,
      "mask": false
    },
    {
      "name": "ENV 2",
      "key": "DNS2",
      "value": "127.2.2.2#5253",
      "description": "Container Variable: DNS2",
      "required": true,
      "mask": false
    },
    {
      "name": "ENV 3",
      "key": "TZ",
      "value": "Europe/London",
      "description": "Container Variable: TZ",
      "required": false,
      "mask": false
    },
    {
      "name": "ENV 4",
      "key": "WEBPASSWORD",
      "value": "password",
      "description": "Container Variable: WEBPASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "ENV 5",
      "key": "INTERFACE",
      "value": "eth0",
      "description": "Container Variable: INTERFACE",
      "required": false,
      "mask": false
    },
    {
      "name": "ENV 6",
      "key": "ServerIP",
      "value": "192.168.1.24",
      "description": "Container Variable: ServerIP",
      "required": false,
      "mask": false
    },
    {
      "name": "ENV 7",
      "key": "ServerIPv6",
      "value": "",
      "description": "Container Variable: ServerIPv6",
      "required": false,
      "mask": false
    },
    {
      "name": "ENV 8",
      "key": "IPv6",
      "value": "False",
      "description": "Container Variable: IPv6",
      "required": false,
      "mask": false
    },
    {
      "name": "ENV 9",
      "key": "DNSMASQ_LISTENING",
      "value": "all",
      "description": "Container Variable: DNSMASQ_LISTENING",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
