{
  "name": "ampd",
  "repo": "rain0r/ampd:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/rain0r/ampd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ampd-icon.png",
  "project": "https://rain0r.github.io/ampd/",
  "description": "ampd is a free web-based client for MPD.",
  "paths": [
    {
      "name": "Working Directory",
      "host": "/mnt/cache/appdata/ampd",
      "container": "/opt/ampd/home",
      "mode": "rw",
      "description": "Path to the working directory. This is where ampd stores its data.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MPD Server",
      "key": "MPD_SERVER",
      "value": "",
      "description": "URL to the MPD server.",
      "required": true,
      "mask": false
    },
    {
      "name": "MPD Port",
      "key": "MPD_PORT",
      "value": "6600",
      "description": "Port of the MPD server.",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable Local Cover Cache",
      "key": "LOCAL_COVER_CACHE",
      "value": "false|true",
      "description": "Enable local cover cache for faster loading of covers.",
      "required": true,
      "mask": false
    },
    {
      "name": "MB Cover Cache",
      "key": "MB_COVER_CACHE",
      "value": "false|true",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Reset Modes on Clear",
      "key": "RESET_MODES_ON_CLEAR",
      "value": "false|true",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Create New Playlists",
      "key": "CREATE_NEW_PLAYLISTS",
      "value": "false|true",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Delete Existing Playlists",
      "key": "DELETE_EXISTING_PLAYLISTS",
      "value": "false|true",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Working Directory",
      "key": "HOME_DIR",
      "value": "/opt/ampd/home",
      "description": "Internal working directory for ampd. Do not change unless you know what you are doing.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
