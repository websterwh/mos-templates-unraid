{
  "name": "ResilioSync",
  "repo": "resilio/sync:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/resilio/sync/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8888]/gui",
  "icon": "https://raw.githubusercontent.com/mak-cs/unraid/master/icons/resiliosync.png",
  "project": "https://www.resilio.com/individuals/",
  "description": "Sync uses peer-to-peer technology to provide fast, private file sharing for teams and individuals. By skipping the cloud, transfers can be significantly faster because files take the shortest path between devices. Sync does not store your information on servers in the cloud, avoiding cloud privacy concerns.",
  "paths": [
    {
      "name": "Path Sync",
      "host": "/mnt/cache/appdata/ResilioSync/sync",
      "container": "/mnt/sync",
      "mode": "rw",
      "description": "Where resilio-sync should store its config file.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port WebUI",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false
    },
    {
      "name": "Port Sync",
      "host": "55555",
      "container": "55555",
      "protocol": "tcp",
      "description": "Sync Port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
