{
  "name": "CloudBeaver",
  "repo": "dbeaver/cloudbeaver",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/dbeaver/cloudbeaver/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8978]/",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/cloudbeaver.png",
  "project": "https://github.com/dbeaver/cloudbeaver",
  "description": "Cloud Database Manager (Official Docker Image) As an open-source product it already supports the most popular open source databases, such as PostgreSQL, MySQL, MariaDB, SQLite and Firebird.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/cloudbeaver",
      "container": "/opt/cloudbeaver/workspace",
      "mode": "rw",
      "description": "Container Path: /opt/cloudbeaver/workspace",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Interface Port",
      "host": "8978",
      "container": "8978",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
