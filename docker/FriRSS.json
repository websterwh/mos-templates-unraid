{
  "name": "FriRSS",
  "repo": "ghcr.io/fripix/frirss:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/Fripix/Frirss/pkgs/container/frirss",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/Fripix/Frirss/main/public/pwa-icon.png",
  "project": "https://github.com/Fripix/Frirss",
  "description": "FriRSS is a modern, self-hosted, customizable web frontend for FreshRSS. It provides a desktop interface and mobile PWA, full-text extraction, offline reading, multiple languages, themes and extensive interface customization.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/frirss",
      "container": "/app/data",
      "mode": "rw",
      "description": "Persistent FriRSS data, including the SQLite database.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8787",
      "container": "80",
      "protocol": "tcp",
      "description": "Port used to access the FriRSS web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NODE_ENV",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Node.js environment.",
      "required": true,
      "mask": false
    },
    {
      "name": "FRIRSS_DATA_DIR",
      "key": "FRIRSS_DATA_DIR",
      "value": "/app/data",
      "description": "Internal FriRSS data directory.",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Zurich",
      "description": "Container timezone, for example Europe/Zurich.",
      "required": false,
      "mask": false
    },
    {
      "name": "Base URL",
      "key": "FRIRSS_BASE_URL",
      "value": "",
      "description": "Public URL of your FriRSS instance, for example https://rss.example.com.",
      "required": false,
      "mask": false
    },
    {
      "name": "Redis URL",
      "key": "REDIS_URL",
      "value": "",
      "description": "Optional Redis connection URL for shared caching.",
      "required": false,
      "mask": false
    },
    {
      "name": "Cache Sync Interval",
      "key": "CACHE_SYNC_INTERVAL",
      "value": "15",
      "description": "Redis cache synchronization interval.",
      "required": false,
      "mask": false
    },
    {
      "name": "Proxy Rewrites",
      "key": "PROXY_REWRITES",
      "value": "",
      "description": "Optional proxy rewrite configuration.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
