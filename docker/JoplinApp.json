{
  "name": "JoplinApp",
  "repo": "acaranta/docker-joplin",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/acaranta/docker-joplin/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5800]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/joplin.png",
  "project": "https://github.com/acaranta/docker-joplin",
  "description": "This container allows you to have a working Joplin desktop app, reachable via a http noVNC that can be placed behind a reverse proxy. Can also be used with the Joplin server container to have a full Joplin stack on Unraid! More info about Joplin : https://joplinapp.org/",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/joplinapp",
      "container": "/app/.config",
      "mode": "rw",
      "description": "Container Path: /app/.config",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "5800",
      "container": "5800",
      "protocol": "tcp",
      "description": "Container Port: 5800",
      "required": false,
      "mask": false
    },
    {
      "name": "Web Clipper Port",
      "host": "41184",
      "container": "41184",
      "protocol": "tcp",
      "description": "Likely can't be used unless you have an advanced use case.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VNC_PASSWORD",
      "key": "VNC_PASSWORD",
      "value": "",
      "description": "Container Variable: VNC_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "DISPLAY_WIDTH",
      "key": "DISPLAY_WIDTH",
      "value": "1280",
      "description": "Container Variable: DISPLAY_WIDTH",
      "required": false,
      "mask": false
    },
    {
      "name": "DISPLAY_HEIGHT",
      "key": "DISPLAY_HEIGHT",
      "value": "768",
      "description": "Container Variable: DISPLAY_HEIGHT",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
