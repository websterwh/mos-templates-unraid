{
  "name": "Mainfrezzer-Pelican-Panel",
  "repo": "ghcr.io/mainfrezzer/pelican-panel:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://github.com/Mainfrezzer/Mainfrezzer-Pelican-Panel/pkgs/container/pelican-panel",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/Mainfrezzer/UnRaid-Templates/main/icon/pelican.png",
  "project": "https://github.com/pelican-dev/",
  "description": "A modified version of Pelican-Panel to work easier with Unraid",
  "paths": [
    {
      "name": "Pelican-Data",
      "host": "/mnt/cache/appdata/pelican-panel/pelican-data",
      "container": "/pelican-data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Pelican-Plugins",
      "host": "/mnt/cache/appdata/pelican-panel/pelican-plugins",
      "container": "/var/www/html/plugins",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Pelican-Logs",
      "host": "/mnt/cache/appdata/pelican-panel/pelican-log",
      "container": "/var/www/html/storage/logs",
      "mode": "rw",
      "description": "All the logs of pelican panel.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebHttp",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Http port for the web server, reverse proxy recommended!",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "App Url",
      "key": "APP_URL",
      "value": "http://CHANGEME",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "XDG",
      "key": "XDG_DATA_HOME",
      "value": "/pelican-data",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
