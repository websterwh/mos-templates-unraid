{
  "name": "planka",
  "repo": "lscr.io/linuxserver/planka",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/planka",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1337]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/planka-logo.png",
  "project": "https://github.com/plankanban/planka/",
  "description": "Planka(https://github.com/plankanban/planka/) is an elegant open source project tracking tool.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Local path for planka config files.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "1337",
      "container": "1337",
      "protocol": "tcp",
      "description": "Planka web UI.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "BASE_URL",
      "key": "BASE_URL",
      "value": "https://planka.example.com",
      "description": "The URL you will use to access planka including protocol, and port if not 80/443.",
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgresql://user:password@planka-db:5432/planka",
      "description": "Postgres database URL. Special characters must be url encoded(https://en.wikipedia.org/wiki/Percent-encoding).",
      "required": true,
      "mask": false
    },
    {
      "name": "DEFAULT_ADMIN_EMAIL",
      "key": "DEFAULT_ADMIN_EMAIL",
      "value": "demo@demo.demo",
      "description": "Email address for default user.",
      "required": true,
      "mask": false
    },
    {
      "name": "DEFAULT_ADMIN_USERNAME",
      "key": "DEFAULT_ADMIN_USERNAME",
      "value": "demo",
      "description": "Username for default user.",
      "required": true,
      "mask": false
    },
    {
      "name": "DEFAULT_ADMIN_PASSWORD",
      "key": "DEFAULT_ADMIN_PASSWORD",
      "value": "demo",
      "description": "Password for default user.",
      "required": true,
      "mask": true
    },
    {
      "name": "DEFAULT_ADMIN_NAME",
      "key": "DEFAULT_ADMIN_NAME",
      "value": "Demo User",
      "description": "Display name for default user.",
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "notasecretkey",
      "description": "Session encryption key, recommended 32-64 character alphanumeric.",
      "required": true,
      "mask": true
    },
    {
      "name": "TRUST_PROXY",
      "key": "TRUST_PROXY",
      "value": "false",
      "description": "Set to `true` to trust upstream proxies if reverse proxying.",
      "required": true,
      "mask": false
    },
    {
      "name": "DEFAULT_LANGUAGE",
      "key": "DEFAULT_LANGUAGE",
      "value": "en-US",
      "description": "This sets the default language for sending notifications per user (if a user hasn't selected a language) and per board.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
