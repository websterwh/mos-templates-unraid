{
  "name": "bookshelf",
  "repo": "ghcr.io/pennydreadful/bookshelf:softcover",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/pennydreadful/bookshelf",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8787]/",
  "icon": "https://github.com/pennydreadful/bookshelf/blob/develop/Logo/128.png?raw=true",
  "project": "https://github.com/pennydreadful/bookshelf",
  "description": "Fork of Readarr, Arr For Books",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/bookshelf/",
      "container": "/config",
      "mode": "rw",
      "description": "Bookshelf config file.",
      "required": true
    },
    {
      "name": "Downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Location of download client folder.",
      "required": false
    },
    {
      "name": "media",
      "host": "",
      "container": "/media",
      "mode": "rw",
      "description": "Location of audiobooks on disk.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Webui",
      "host": "8787",
      "container": "8787",
      "protocol": "tcp",
      "description": "Port to bookshelf web ui.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Metadata URL",
      "key": "METADATA_URL",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
