{
  "name": "Sneedznab",
  "repo": "ghcr.io/turbocheetah/sneedznab:master",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/turbocheetah/sneedznab",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://cdn.discordapp.com/attachments/909787515345575976/1049405403626209381/3b0c74dc8fb6a2fd0b973f3661a410e5.png",
  "project": "https://sneedex.moe/",
  "description": "Sneedznab is a Torznab Indexer which pulls data directly from Sneedex, to use, simply create a new torznab indexer, and use [ServerURL]:[Port] for the indexer. It can be used both as a Torrent Indexer, and NZB Indexer. Sneedex tracks the best releases of anime torrents; taking video, audio, and subtitle quality into consideration. WARNING: This software is still in early development, expect heavy changes as time goes by, maybe redownload the app when an update rolls around.",
  "paths": [],
  "ports": [
    {
      "name": "Sneedznab Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port where Sonarr, Radarr etc. will access the Sneedznab API",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NYAA_ENABLED",
      "key": "NYAA_ENABLED",
      "value": "True",
      "description": "Use Nyaa.si (Default True)",
      "required": true,
      "mask": false
    },
    {
      "name": "ANIMETOSHO_ENABLED",
      "key": "ANIMETOSHO_ENABLED",
      "value": "True",
      "description": "Use AnimeTosho (Default True)",
      "required": true,
      "mask": false
    },
    {
      "name": "RUTRACKER_ENABLED",
      "key": "RUTRACKER_ENABLED",
      "value": "True",
      "description": "Use RUTracker (Default True)",
      "required": true,
      "mask": false
    },
    {
      "name": "ANIMEBYTES_ENABLED",
      "key": "ANIMEBYTES_ENABLED",
      "value": "False",
      "description": "Use AnimeBytes (Default False)",
      "required": true,
      "mask": false
    },
    {
      "name": "ANIMEBYTES_USERNAME",
      "key": "ANIMEBYTES_USERNAME",
      "value": "",
      "description": "Your AnimeBytes username",
      "required": false,
      "mask": false
    },
    {
      "name": "ANIMEBYTES_PASSKEY",
      "key": "ANIMEBYTES_PASSKEY",
      "value": "",
      "description": "Your AnimeBytes Passkey",
      "required": false,
      "mask": false
    },
    {
      "name": "REDIS_ENABLED",
      "key": "REDIS_ENABLED",
      "value": "False",
      "description": "Enable Redis cache (Needs Upstash URL and Key)",
      "required": false,
      "mask": false
    },
    {
      "name": "REDIS_URL",
      "key": "REDIS_URL",
      "value": "",
      "description": "Upstash URL",
      "required": false,
      "mask": false
    },
    {
      "name": "REDIS_TOKEN",
      "key": "REDIS_TOKEN",
      "value": "",
      "description": "Upstash Token",
      "required": false,
      "mask": false
    },
    {
      "name": "CACHE_TTL",
      "key": "CACHE_TTL",
      "value": "120",
      "description": "Cache TTL",
      "required": true,
      "mask": false
    },
    {
      "name": "DEBUG",
      "key": "DEBUG",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
