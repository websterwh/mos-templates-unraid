{
  "name": "telegram-delay-channel-cloner",
  "repo": "drumsergio/telegram-delay-channel-cloner:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/drumsergio/telegram-delay-channel-cloner",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/GeiserX/docker-templates/master/drumsergio/images/telegram-delay-channel-cloner.png",
  "project": "https://github.com/GeiserX/telegram-delay-channel-cloner",
  "description": "Telegram bot that relays messages from a source channel to a target channel after a configurable delay. Handles deleted and edited messages gracefully with SQLite persistence. Perfect for creating delayed mirrors of channels or implementing message scheduling workflows. Requires a Telegram bot token and the bot must be admin in both source and target channels. More info: https://github.com/GeiserX/telegram-delay-channel-cloner",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/telegram-delay-channel-cloner",
      "container": "/data",
      "mode": "rw",
      "description": "SQLite database for message persistence",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Bot Token",
      "key": "BOT_TOKEN",
      "value": "",
      "description": "Telegram bot API token from @BotFather",
      "required": true,
      "mask": true
    },
    {
      "name": "Source Channel",
      "key": "SOURCE_CHANNEL",
      "value": "",
      "description": "Source channel ID (numeric, e.g. -1001234567890)",
      "required": true,
      "mask": false
    },
    {
      "name": "Target Channel",
      "key": "TARGET_CHANNEL",
      "value": "",
      "description": "Target channel ID (numeric, e.g. -1001234567890)",
      "required": true,
      "mask": false
    },
    {
      "name": "Delay (seconds)",
      "key": "DELAY",
      "value": "10",
      "description": "Delay in seconds before relaying messages",
      "required": false,
      "mask": false
    },
    {
      "name": "Copy Mode",
      "key": "COPY_MESSAGE",
      "value": "True",
      "description": "True = copy message, False = forward message",
      "required": false,
      "mask": false
    },
    {
      "name": "Batch Size",
      "key": "BATCH_SIZE",
      "value": "10",
      "description": "Messages to process per cycle",
      "required": false,
      "mask": false
    },
    {
      "name": "Retention Days",
      "key": "RETENTION_PERIOD",
      "value": "7",
      "description": "Days to keep message records in database",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
