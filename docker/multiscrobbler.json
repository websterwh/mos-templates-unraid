{
  "name": "multi-scrobbler",
  "repo": "foxxmd/multi-scrobbler:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/repository/docker/foxxmd/multi-scrobbler",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9078]/",
  "icon": "https://github.com/FoxxMD/unraid-docker-templates/raw/master/icons/multi-scrobbler.png",
  "project": null,
  "description": "Track your music listening history from api-based sources like Spotify, Plex (Tautulli), Subsonic (Airsonic), Jellyfin, Mopidy, Deezer, JRiver, Kodi and record to Last.fm, Maloja, and Listenbrainz",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/multi-scrobbler/config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "9078",
      "container": "9078",
      "protocol": "tcp",
      "description": "Container Port: 9078",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "UID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "GID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
