{
  "name": "PS5-MQTT",
  "repo": "ghcr.io/funkeyflo/ps5-mqtt/amd64:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/FunkeyFlo/ps5-mqtt/pkgs/container/ps5-mqtt%2Famd64",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "sh /app/run-standalone.sh",
  "web_ui_url": "http://[IP]:[PORT:8645]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ps5-mqtt-icon.png",
  "project": "https://github.com/FunkeyFlo/ps5-mqtt",
  "description": "Integrate your Sony Playstation 5 devices with Home Assistant using MQTT.",
  "paths": [
    {
      "name": "Config File Path",
      "host": "/mnt/cache/appdata/ps5_mqtt/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to application config data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Application Port",
      "host": "8645",
      "container": "8645",
      "protocol": "tcp",
      "description": "Container Port: 8645",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MQTT - Host",
      "key": "MQTT_HOST",
      "value": "0.0.0.0",
      "description": "MQTT Host",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - Port",
      "key": "MQTT_PORT",
      "value": "1883",
      "description": "MQTT Port",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - Username",
      "key": "MQTT_USERNAME",
      "value": "",
      "description": "MQTT Username",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - Password",
      "key": "MQTT_PASSWORD",
      "value": "",
      "description": "MQTT Password",
      "required": true,
      "mask": true
    },
    {
      "name": "MQTT - Discovery Topic",
      "key": "DISCOVERY_TOPIC",
      "value": "homeassistant",
      "description": "MQTT Topic. Default for Home Assistant is 'homeassistant'",
      "required": false,
      "mask": false
    },
    {
      "name": "Interval - Device Check",
      "key": "DEVICE_CHECK_INTERVAL",
      "value": "5000",
      "description": "Interval in ms to check for new devices",
      "required": true,
      "mask": false
    },
    {
      "name": "Interval - Device Discovery",
      "key": "DEVICE_DISCOVERY_INTERVAL",
      "value": "60000",
      "description": "Interval in ms to discover new devices",
      "required": true,
      "mask": false
    },
    {
      "name": "Interval - Account Check",
      "key": "ACCOUNT_CHECK_INTERVAL",
      "value": "5000",
      "description": "Interval in ms to check for new accounts",
      "required": true,
      "mask": false
    },
    {
      "name": "PlayStation Network Accounts",
      "key": "PSN_ACCOUNTS",
      "value": "",
      "description": "JSON array of PSN accounts to monitor. Example: [{\"username\": \"MyPsnUser\", \"npsso\":\"npsso_value\"}] Delete if not used.",
      "required": false,
      "mask": false
    },
    {
      "name": "Include PS4 Devices",
      "key": "INCLUDE_PS4_DEVICES",
      "value": "false|true",
      "description": "Include PS4 devices in discovery",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Port",
      "key": "FRONTEND_PORT",
      "value": "8645",
      "description": "Internal port for web interface",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Credential Storage Path",
      "key": "CREDENTIALS_STORAGE_PATH",
      "value": "/config/credentials.json",
      "description": "Path to store credentials",
      "required": true,
      "mask": false
    },
    {
      "name": "Debug Topic",
      "key": "DEBUG",
      "value": "@ha:ps5:*",
      "description": "Debug topic for logging",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
