{
  "name": "Influxdb-1.8",
  "repo": "influxdb:1.8",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/_/influxdb/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8083]/",
  "icon": "https://raw.githubusercontent.com/simonsickle/unraid-templates/main/influxdb1/logo.png",
  "project": "https://influxdata.com/",
  "description": "InfluxDB is an open source time series database with no external dependencies. It's useful for recording metrics, events, and performing analytics.",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/influxdb",
      "container": "/var/lib/influxdb",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP WebUI",
      "host": "8083",
      "container": "8083",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP API",
      "host": "8086",
      "container": "8086",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
