{
  "name": "restic-rest-server",
  "repo": "restic/rest-server",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/restic/rest-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
