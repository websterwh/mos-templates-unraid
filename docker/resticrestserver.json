  "project": "https://github.com/restic/rest-server",
  "description": "Rest Server is a high performance HTTP server that implements restic's REST backend API. It provides secure and efficient way to backup data remotely, using restic backup client via the rest: URL.",
  "paths": [
    {
      "name": "Data directory",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Rest-server listen port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Additional rest-server options",
      "key": "OPTIONS",
      "value": "",
      "description": "Container Variable: OPTIONS",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
