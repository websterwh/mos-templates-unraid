{
  "name": "coturn",
  "repo": "instrumentisto/coturn",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/instrumentisto/coturn/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "-c /coturn/turnserver.conf",
  "web_ui_url": "http://[IP]:[PORT:3478]",
  "icon": "https://raw.githubusercontent.com/xthursdayx/docker-templates/master/xthursdayx/images/webrtc-icon.png",
  "project": "https://github.com/coturn/coturn",
  "description": "Coturn TURN Server is a VoIP media traffic NAT traversal server and gateway. It can be used as a general-purpose network traffic TURN server and gateway, too.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/coturn/turnserver.conf",
      "container": "/coturn/turnserver.conf",
      "mode": "rw",
      "description": "Container Path: /coturn/turnserver.conf",
      "required": true
    },
    {
      "name": "Keys",
      "host": "/mnt/cache/appdata/coturn/keys",
      "container": "/etc/ssl/",
      "mode": "rw",
      "description": "Container Path: /etc/ssl/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "TURN over TCP",
      "host": "3478",
      "container": "3478",
      "protocol": "tcp",
      "description": "Container Port: 3478",
      "required": true,
      "mask": false
    },
    {
      "name": "TURN over UDP",
      "host": "3478",
      "container": "3478",
      "protocol": "udp",
      "description": "Container Port: 3478",
      "required": true,
      "mask": false
    },
    {
      "name": "TURN over TCP - TLS",
      "host": "5349",
      "container": "5349",
      "protocol": "tcp",
      "description": "Container Port: 5349",
      "required": true,
      "mask": false
    },
    {
      "name": "TURN over UDP - TLS",
      "host": "5349",
      "container": "5349",
      "protocol": "udp",
      "description": "Container Port: 5349",
      "required": true,
      "mask": false
    },
    {
      "name": "TURN over UDP",
      "host": "49152:49172",
      "container": "49152:49172",
      "protocol": "tcp",
      "description": "Container Port: 49152:49172",
      "required": true,
      "mask": false
    },
    {
      "name": "TURN over UDP",
      "host": "49152:65535",
      "container": "49152:65535",
      "protocol": "udp",
      "description": "Container Path: 49152:65535",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
