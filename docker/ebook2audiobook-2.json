{
  "name": "ebook2audiobook",
  "repo": "athomasson2/ebook2audiobook:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/athomasson2/ebook2audiobook",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--platform=linux/amd64",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7860]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ebook-2-audiobook-icon.png",
  "project": "https://github.com/DrewThomasson/ebook2audiobook",
  "description": "CPU/GPU Converter from eBooks to audiobooks with chapters and metadata using Calibre, ffmpeg, XTTSv2, Fairseq and more. Supports voice cloning and 1124 languages! For Nvidia GPU support, add \"--runtime=nvidia --gpus all\" to the Extra Parameters field under Advanced.",
  "paths": [
    {
      "name": "Temp Path",
      "host": "",
      "container": "/home/user/app/tmp",
      "mode": "rw",
      "description": "Path to temporary files.",
      "required": false
    },
    {
      "name": "Audiobooks Path",
      "host": "",
      "container": "/home/user/app/audiobooks",
      "mode": "rw",
      "description": "Path to audiobooks.",
      "required": false
    },
    {
      "name": "Models Path",
      "host": "",
      "container": "/home/user/app/models",
      "mode": "rw",
      "description": "Path to models. Warning, this can consume a large amount of space.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7860",
      "container": "7860",
      "protocol": "tcp",
      "description": "Container Port: 7860",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
