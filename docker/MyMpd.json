{
  "name": "MyMpd",
  "repo": "daredoes/mympd:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/daredoes/mympd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9001]/",
  "icon": "https://avatars.githubusercontent.com/u/765844",
  "project": "https://jcorporation.github.io/myMPD/",
  "description": "MyMPD + MPD pre-configured for Snapcast",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/mympd/mpd",
      "container": "/user/config/",
      "mode": "rw",
      "description": "MPD config",
      "required": false
    },
    {
      "name": "Snapcast FIFO",
      "host": "/dev/shm/snapcast",
      "container": "/tmp/",
      "mode": "rw",
      "description": "Container Path: /tmp/snapfifo",
      "required": false
    },
    {
      "name": "Music",
      "host": "",
      "container": "/music",
      "mode": "rw",
      "description": "Container Path: /music",
      "required": false
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/mympd/log",
      "container": "/log",
      "mode": "rw",
      "description": "Container Path: /log",
      "required": false
    },
    {
      "name": "Playlists",
      "host": "/mnt/cache/appdata/mympd/playlists",
      "container": "/playlists",
      "mode": "rw",
      "description": "Container Path: /playlists",
      "required": false
    },
    {
      "name": "DB",
      "host": "/mnt/cache/appdata/mympd/db",
      "container": "/db",
      "mode": "rw",
      "description": "Container Path: /db",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "MPD Port",
      "host": "6600",
      "container": "6600",
      "protocol": "tcp",
      "description": "This should match whats in your config",
      "required": true,
      "mask": false
    },
    {
      "name": "MyMPD HTTP Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Where the webserver lives",
      "required": true,
      "mask": false
    },
    {
      "name": "Supervisord Port",
      "host": "9001",
      "container": "9001",
      "protocol": "tcp",
      "description": "Where the supervisord web UI lives",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
