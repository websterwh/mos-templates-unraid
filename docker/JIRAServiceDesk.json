{
  "name": "JIRA-Service-Desk",
  "repo": "atlassian/jira-servicedesk",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/atlassian/jira-servicedesk",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://i.imgur.com/rNMse7m.png",
  "project": "https://www.atlassian.com/software/jira/service-desk",
  "description": "Jira Service Desk is a fully featured service desk tool used by modern IT teams.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/JiraServiceDesk",
      "container": "/var/atlassian/application-data/jira",
      "mode": "rw",
      "description": "Container Path: /var/atlassian/application-data/jira",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8585",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ATL_PROXY_NAME",
      "key": "ATL_PROXY_NAME",
      "value": "support.ibracorp.io",
      "description": "If behind a reverse proxy, what's the root address. i.e. jira.example.com",
      "required": false,
      "mask": false
    },
    {
      "name": "ATL_PROXY_PORT",
      "key": "ATL_PROXY_PORT",
      "value": "443",
      "description": "Container Variable: ATL_PROXY_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "ATL_TOMCAT_SCHEME",
      "key": "ATL_TOMCAT_SCHEME",
      "value": "https",
      "description": "Container Variable: ATL_TOMCAT_SCHEME",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
