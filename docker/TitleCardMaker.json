{
  "name": "TitleCardMaker",
  "repo": "ghcr.io/titlecardmaker/titlecardmaker:latest",
  "category": [
    "System"
  ],
  "registry": "https://ghcr.io/titlecardmaker/titlecardmaker",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4242]/",
  "icon": "https://raw.githubusercontent.com/CollinHeist/TitleCardMaker/refs/heads/web-ui/.github/logo.png",
  "project": "https://titlecardmaker.com",
  "description": "Automated title card maker for Plex, Emby, and Jellyfin. Setup instructions: https://titlecardmaker.com/getting_started",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/TitleCardMaker/config",
      "container": "/config",
      "mode": "rw",
      "description": "Directory to contain all TCM files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "4242",
      "container": "4242",
      "protocol": "tcp",
      "description": "Port to the web interface",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Group ID",
      "key": "PGID",
      "value": "500",
      "description": "Container Group ID (PGID)",
      "required": true,
      "mask": false
    },
    {
      "name": "User ID",
      "key": "PUID",
      "value": "500",
      "description": "Container User ID (PUID)",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "File creation mode mask",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
