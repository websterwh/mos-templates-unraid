{
  "name": "solr",
  "repo": "bitnami/solr:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/bitnami/solr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8983]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/solr.png",
  "project": "https://lucene.apache.org/solr/",
  "description": "Solr is the popular, blazing-fast, open source enterprise search platform built on Apache Lucene.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/solr/",
      "container": "/bitnami",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8983",
      "container": "8983",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SOLR_PORT_NUMBER",
      "key": "SOLR_PORT_NUMBER",
      "value": "8983",
      "description": "Port used by Solr server. Default: 8983",
      "required": true,
      "mask": false
    },
    {
      "name": "SOLR_CORE",
      "key": "SOLR_CORE",
      "value": "my_core",
      "description": "Core name to create at first run.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
