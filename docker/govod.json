{
  "name": "go-vod",
  "repo": "radialapps/go-vod:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/radialapps/go-vod/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime nvidia",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:47788]",
  "icon": "https://raw.githubusercontent.com/glls/Docker-Templates-Unraid/refs/heads/main/assets/memories.png",
  "project": "https://hub.docker.com/r/radialapps/go-vod/",
  "description": "Unraid Docker based transcoder for Nextcloud Memories Links https://memories.gallery/ https://memories.gallery/hw-transcoding/",
  "paths": [
    {
      "name": "nc data",
      "host": "/mnt/cache/appdata/nextcloud",
      "container": "/ncdata",
      "mode": "ro",
      "description": "Nextcloud app data dir",
      "required": false
    },
    {
      "name": "data",
      "host": "/mnt/cache/appdata/nextcloud/data/",
      "container": "/var/www/html/data/",
      "mode": "ro",
      "description": "Nextcloud user data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "47788",
      "container": "47788",
      "protocol": "tcp",
      "description": "Listening port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA driver caps",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "compute,video,utility",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Nextcloud Host",
      "key": "NEXTCLOUD_HOST",
      "value": "http://192.168.33.5:8060",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "NEXTCLOUD_ALLOW_INSECURE",
      "key": "NEXTCLOUD_ALLOW_INSECURE",
      "value": "1",
      "description": "If you are using a self-signed certificate or http, you set to 1",
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "/dev/dri",
      "host": "/dev/dri",
      "container": "/dev/dri",
      "description": null,
      "required": false
    }
  ],
  "labels": []
}
