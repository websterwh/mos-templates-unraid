{
  "name": "nut",
  "repo": "shawly/nut:edge",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/shawly/nut",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9000]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/nut.png",
  "project": "https://github.com/shawly/docker-nut",
  "description": "nut server docker image for serving switch nsp and xci to tinfoil on local network. Default username and password is \"guest\" \"guest\"",
  "paths": [
    {
      "name": "Games Path",
      "host": "/mnt/cache/games/Nintendo Switch/NSZ/",
      "container": "/nut/titles",
      "mode": "rw",
      "description": "path NUT will use to scan for nsps",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/games/Nintendo Switch/nut/conf",
      "container": "/nut/conf",
      "mode": "rw",
      "description": "path NUT will use to read its config files",
      "required": false
    },
    {
      "name": "NSPOUT Path",
      "host": "/mnt/cache/games/Nintendo Switch/nut/_NSPOUT",
      "container": "/nut/_NSPOUT",
      "mode": "rw",
      "description": "path NUT uses for outputting nsp files",
      "required": false
    },
    {
      "name": "Titledb Path",
      "host": "/mnt/cache/games/Nintendo Switch/nut/titledb",
      "container": "/nut/titledb",
      "mode": "rw",
      "description": "path NUT stores the titledb",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "FIX_OWNERSHIP",
      "key": "FIX_OWNERSHIP",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TITLEDB_UPDATE",
      "key": "TITLEDB_UPDATE",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TITLEDB_URL",
      "key": "TITLEDB_URL",
      "value": "https://github.com/blawar/titledb",
      "description": "If you change this URL you need to remove the /nut/titledb folder within your container",
      "required": false,
      "mask": false
    },
    {
      "name": "TITLEDB_REGION",
      "key": "TITLEDB_REGION",
      "value": "US",
      "description": "Region to be used when importing the titledb",
      "required": false,
      "mask": false
    },
    {
      "name": "TITLEDB_LANGUAGE",
      "key": "TITLEDB_LANGUAGE",
      "value": "en",
      "description": "Language to be used when importing the titledb",
      "required": false,
      "mask": false
    },
    {
      "name": "NUT_API_SCHEDULES",
      "key": "NUT_API_SCHEDULES",
      "value": "[{\"scan\": \"0/30 * * * *\"}]",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "USER_ID",
      "key": "USER_ID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "GROUP_ID",
      "key": "GROUP_ID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
