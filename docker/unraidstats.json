{
  "name": "unraid-stats",
  "repo": "ghcr.io/xexsolutions/unraid-stats:latest",
  "category": [
    "Monitoring"
  ],
  "registry": "https://github.com/XeXSolutions/unraid-stats/pkgs/container/unraid-stats",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8085]/",
  "icon": "https://raw.githubusercontent.com/XeXSolutions/unraid-stats/main/images/logo.png",
  "project": "https://github.com/XeXSolutions/unraid-stats",
  "description": "A modern, real-time system monitoring dashboard for Unraid servers. Features include CPU, memory, network monitoring, and array status tracking with a clean, responsive interface.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/proc",
      "container": "/host/proc",
      "mode": "ro,rslave",
      "description": "System information path",
      "required": true
    },
    {
      "name": "Host Path 2",
      "host": "/sys",
      "container": "/host/sys",
      "mode": "ro,rslave",
      "description": "System information path",
      "required": true
    },
    {
      "name": "Host Path 3",
      "host": "/var/local/emhttp",
      "container": "/host/var/local/emhttp",
      "mode": "ro,rslave",
      "description": "Unraid configuration path",
      "required": true
    },
    {
      "name": "Host Path 4",
      "host": "/var/run/mdstat",
      "container": "/var/run/mdstat",
      "mode": "ro",
      "description": "Array status path",
      "required": true
    },
    {
      "name": "Host Path 5",
      "host": "/var/run/mdcmd.socket",
      "container": "/var/run/mdcmd.socket",
      "mode": "ro",
      "description": "Array command socket",
      "required": true
    },
    {
      "name": "Host Path 6",
      "host": "/mnt",
      "container": "/host/mnt",
      "mode": "ro,rslave",
      "description": "Mount points path",
      "required": true
    },
    {
      "name": "Host Path 7",
      "host": "/dev/disk/by-id",
      "container": "/host/dev/disk/by-id",
      "mode": "ro",
      "description": "Disk identification path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8085",
      "container": "8085",
      "protocol": "tcp",
      "description": "Web Interface Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
