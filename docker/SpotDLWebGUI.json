{
  "name": "SpotDL-WebGUI",
  "repo": "spotdl/spotify-downloader",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/spotDL/spotify-downloader",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "web --host 0.0.0.0 --web-use-output-dir",
  "web_ui_url": "http://[IP]:[PORT:8800]",
  "icon": "https://user-images.githubusercontent.com/19922556/111815072-5a83fe00-892f-11eb-9833-7930d1a2d08f.png",
  "project": "https://github.com/spotDL/spotify-downloader",
  "description": "Container spotDL finds songs from Spotify playlists on YouTube and downloads them - along with album art, lyrics and metadata. Additionally provides a web interface for easily adding media links to process.",
  "paths": [
    {
      "name": "Music Location",
      "host": "/mnt/cache/music",
      "container": "/music",
      "mode": "rw",
      "description": "Directory for storing downloaded music files",
      "required": true
    },
    {
      "name": "AppData Directory",
      "host": "/mnt/cache/appdata/spotdl",
      "container": "/appdata",
      "mode": "rw",
      "description": "Directory for storing SpotDL configuration and cache",
      "required": true
    },
    {
      "name": "Cookie File Path",
      "host": "/mnt/cache/appdata/spotdl/cookies.txt",
      "container": "/appdata/cookies.txt",
      "mode": "rw",
      "description": "Path to YouTube Music cookie file",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebGUI Port",
      "host": "8800",
      "container": "8800",
      "protocol": "tcp",
      "description": "Port for SpotDL WebGUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Output Format",
      "key": "/etc/spotdl/config.json",
      "value": "mp3",
      "description": "Audio output format (mp3/m4a/opus)",
      "required": true,
      "mask": false
    },
    {
      "name": "Bitrate",
      "key": "/etc/spotdl/config.json",
      "value": "128",
      "description": "Audio bitrate in kbps (128/256)",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable Bitrate Conversion",
      "key": "/etc/spotdl/config.json",
      "value": "False",
      "description": "Whether to disable automatic bitrate conversion",
      "required": false,
      "mask": false
    },
    {
      "name": "WebGUI Host",
      "key": "0.0.0.0",
      "value": "0.0.0.0",
      "description": "Host binding for SpotDL WebGUI",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
