{
  "name": "WakeBot",
  "repo": "dgongut/wakebot",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/dgongut/wakebot",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--tty",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/dgongut/pictures/main/WakeBot/WakeBot.png",
  "project": "https://github.com/dgongut/wakebot",
  "description": "Telegram Bot - Wake up your devices via Wake on LAN",
  "paths": [
    {
      "name": "Device Storage",
      "host": "/mnt/cache/appdata/wakebot/",
      "container": "/app/data",
      "mode": "rw",
      "description": "This is where the data of the devices will be stored.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TELEGRAM_ADMIN",
      "key": "TELEGRAM_ADMIN",
      "value": "",
      "description": "Administrator Telegram User ID (numbers). More than 1 could be set splitted by commas",
      "required": true,
      "mask": false
    },
    {
      "name": "TELEGRAM_TOKEN",
      "key": "TELEGRAM_TOKEN",
      "value": "",
      "description": "Telegram Bot Token",
      "required": true,
      "mask": true
    },
    {
      "name": "LANGUAGE",
      "key": "LANGUAGE",
      "value": "ES",
      "description": "Language ES/EN",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
