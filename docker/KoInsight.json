{
  "name": "KoInsight",
  "repo": "ghcr.io/georgesg/koinsight:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/georgesg/koinsight",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/GeorgeSG/KoInsight/refs/heads/master/images/logo.svg",
  "project": "https://github.com/GeorgeSG/KoInsight",
  "description": "KoInsight brings your KOReader reading stats to life with a clean, web-based dashboard.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/koinsight/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Max Upload Size (MB)",
      "key": "MAX_FILE_SIZE_MB",
      "value": "100",
      "description": "Maximum upload size in megabytes",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
