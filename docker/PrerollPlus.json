{
  "name": "Preroll-Plus",
  "repo": "chadwpalm/prerollplus:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/chadwpalm/prerollplus",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4949]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/preroll-plus-icon.png",
  "project": "https://github.com/chadwpalm/PrerollPlus",
  "description": "Preroll Plus is a dynamic preroll updater and scheduler. This app bypasses the limitations Plex has for combining random and sequential prerolls (using the \",\" and \";\" delimiters). It works by using Plex webhooks to update the preroll string in Plex whenever a movie is started, allowing file sets that require randomization to remain randomized while maintaining a broader sequence.",
  "paths": [
    {
      "name": "Prerolls Files",
      "host": "",
      "container": "/prerolls",
      "mode": "rw",
      "description": "Path to preroll files",
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/prerolls_plus/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4949",
      "container": "4949",
      "protocol": "tcp",
      "description": "Container Port: 4949",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
