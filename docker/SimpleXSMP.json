{
  "name": "SimpleX-SMP",
  "repo": "simplexchat/smp-server",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/simplexchat/smp-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5223]",
  "icon": "https://avatars.githubusercontent.com/u/59927747?s=200&v=4.png",
  "project": "https://simplex.chat/",
  "description": "Provides the offical message queue server for SimpleX Chat",
  "paths": [
    {
      "name": "Path SMP Config",
      "host": "/mnt/cache/appdata/simplex/smp/config",
      "container": "/etc/opt/simplex",
      "mode": "rw,shared",
      "description": "This is where the SimpleX SMP Config is stored",
      "required": true
    },
    {
      "name": "Path SMP Logs",
      "host": "/mnt/cache/appdata/simplex/smp/logs",
      "container": "/var/opt/simplex",
      "mode": "rw,shared",
      "description": "This is where the SimpleX SMP Logs are stored",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "SimpleX SMP Port",
      "host": "5223",
      "container": "5223",
      "protocol": "tcp",
      "description": "SimpleX SMP Service Port",
      "required": true,
      "mask": false
    },
    {
      "name": "SimpleX Infopage Port",
      "host": "8181",
      "container": "8000",
      "protocol": "tcp",
      "description": "SimpleX SMP Infopage Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "IP / Domain",
      "key": "ADDR",
      "value": "your_ip_or_domain",
      "description": "Enter the IP or Domain your Simplex SMP should run on.",
      "required": true,
      "mask": false
    },
    {
      "name": "Password",
      "key": "PASS",
      "value": "change_me",
      "description": "Protect your SimpleX SMP with a password.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
