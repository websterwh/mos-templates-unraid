{
  "name": "tautulli",
  "repo": "tautulli/tautulli",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/tautulli/tautulli",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8181]/",
  "icon": "https://raw.githubusercontent.com/Tautulli/Tautulli-Unraid-Template/master/img/logo-circle.png",
  "project": "http://tautulli.com/",
  "description": "This is the official container supported by the Tautulli devs. Tautulli is a 3rd party application that you can run alongside your Plex Media Server to monitor activity and track various statistics.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/tautulli",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8181",
      "container": "8181",
      "protocol": "tcp",
      "description": "Container Port: 8181",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "UTC",
      "description": "Container Variable: TZ",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
