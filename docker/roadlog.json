{
  "name": "roadlog",
  "repo": "ghcr.io/stomko11/roadlog:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://ghcr.io/stomko11/roadlog",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/stomko11/roadlog/main/icon.png",
  "project": "https://github.com/stomko11/roadlog",
  "description": "Roadlog is a self-hosted vehicle fuel and expense tracker. Track fill-ups, expenses, consumption stats, and costs per vehicle. Includes CSV import, backup/restore, and multi-user support.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/roadlog",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent data storage (database).",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Port for the Roadlog web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
