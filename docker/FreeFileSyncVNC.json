{
  "name": "FreeFileSync-VNC",
  "repo": "kilrah/freefilesync-vnc",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/kilrah/freefilesync-vnc",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://github.com/kilrah/unraid-docker-templates/raw/main/icons/FreeFileSync.png",
  "project": "https://freefilesync.org/",
  "description": "DEPRECATED - PLEASE UNINSTALL AND SWITCH TO THE NEW V2 TEMPLATE",
  "paths": [
    {
      "name": "Path 1",
      "host": "",
      "container": "/home/freefilesync/path1",
      "mode": "rw",
      "description": "Path to expose to FreeFileSync",
      "required": true
    },
    {
      "name": "Path 2",
      "host": "",
      "container": "/home/freefilesync/path2",
      "mode": "rw",
      "description": "Optional second path to expose",
      "required": false
    },
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/freefilesync",
      "container": "/home/freefilesync/.config/FreeFileSync/",
      "mode": "rw",
      "description": "Application data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "VNC interface",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "VNC interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
