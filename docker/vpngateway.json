{
  "name": "vpn-gateway",
  "repo": "ghcr.io/prophetse7en/vpn-gateway:v1.4.5",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/prophetse7en/vpn-gateway/pkgs/container/vpn-gateway",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--hostname=vpn-gateway.internal --cap-add=NET_ADMIN",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6050]",
  "icon": "https://raw.githubusercontent.com/prophetse7en/vpn-gateway/main/icon.png",
  "project": "https://github.com/prophetse7en/vpn-gateway",
  "description": "VPN gateway with nftables bandwidth limiting, scheduling, hot-reload, and web UI. Built on hotio/base:alpinevpn \u2014 all hotio VPN features (WireGuard, PIA, Proton) work out of the box. Route containers through WireGuard with per-service rate limits, time-based rules, and real-time traffic monitoring. First boot redirects to /setup to create an admin account \u2014 Radarr/Sonarr-style auth with API key for Homepage/scripts.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/vpn-gateway",
      "container": "/config",
      "mode": "rw",
      "description": "Config directory (WireGuard conf, traffic.conf, stats)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Traffic Monitor Web UI",
      "host": "6050",
      "container": "6050",
      "protocol": "tcp",
      "description": "Traffic monitor and bandwidth management web UI",
      "required": true,
      "mask": false
    },
    {
      "name": "Container Web UI",
      "host": "7075",
      "container": "7075",
      "protocol": "tcp",
      "description": "Web UI port for a container routed through the gateway (e.g. qBittorrent, Deluge, IPTV). Must match the listening port on that container and be included in VPN_EXPOSE_PORTS_ON_LAN. Add additional port mappings for more containers.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VPN_ENABLED",
      "key": "VPN_ENABLED",
      "value": "true|false",
      "description": "Container Variable: VPN_ENABLED",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_CONF",
      "key": "VPN_CONF",
      "value": "wg0",
      "description": "Container Variable: VPN_CONF",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_PROVIDER",
      "key": "VPN_PROVIDER",
      "value": "generic|proton|pia",
      "description": "Container Variable: VPN_PROVIDER",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_LAN_NETWORK",
      "key": "VPN_LAN_NETWORK",
      "value": "192.168.1.0/24",
      "description": "Container Variable: VPN_LAN_NETWORK",
      "required": true,
      "mask": false
    },
    {
      "name": "VPN_LAN_LEAK_ENABLED",
      "key": "VPN_LAN_LEAK_ENABLED",
      "value": "false|true",
      "description": "Container Variable: VPN_LAN_LEAK_ENABLED",
      "required": false,
      "mask": false
