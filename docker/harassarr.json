{
  "name": "harassarr",
  "repo": "mtrogman/harassarr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/mtrogman/harassarr",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/mtrogman/harassarr/master/logo.png",
  "project": "https://github.com/mtrogman/harassarr",
  "description": "harassarr is a discord bot that allows you to notify (cough... harass) users that their Plex/Emby/JellyFin subscription is almost up.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/harassarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Where config file will be stored",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Notification Time",
      "key": "TIME",
      "value": "08:00",
      "description": "Time for notifications in HH:MM format",
      "required": false,
      "mask": false
    },
    {
      "name": "Dry Run",
      "key": "DRYRUN",
      "value": "False",
      "description": "Enable dry-run mode",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
