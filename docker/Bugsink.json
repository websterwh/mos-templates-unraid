{
  "name": "Bugsink",
  "repo": "bugsink/bugsink:2",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/bugsink/bugsink",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://www.bugsink.com/static/images/bugsink-logo.7a9597e724ff.webp",
  "project": "https://www.bugsink.com/",
  "description": "Self-hosted Error Tracking",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Generate with `penssl rand -base64 50`",
      "required": true,
      "mask": true
    },
    {
      "name": "Create Superuser",
      "key": "CREATE_SUPERUSER",
      "value": "admin:admin",
      "description": "Create an initial superuser in the format username:password",
      "required": false,
      "mask": true
    },
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "postgresql://user:password@host:port/database",
      "description": "Postgres database connection URL",
      "required": true,
      "mask": false
    },
    {
      "name": "Behind HTTPS Proxy",
      "key": "BEHIND_HTTPS_PROXY",
      "value": "false|true",
      "description": "Set to true if running behind an HTTPS terminating proxy",
      "required": true,
      "mask": false
    },
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "http://localhost:8000",
      "description": "The base URL where Bugsink will be accessible",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "8000",
      "description": "Internal application port. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
