{
  "name": "Proxmox-Backup-Client",
  "repo": "aterfax/pbs-client",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/aterfax/pbs-client",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--mount type=tmpfs,target=/tmp,tmpfs-size=1G --mount type=tmpfs,target=/run:exec,tmpfs-size=64m --restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/andrejwithj/Unraid-Templates/refs/heads/main/icons/proxmox-backup-client.png",
  "project": "https://github.com/Aterfax/pbs-client-docker",
  "description": "A Docker image to run the Proxmox Backup Server client and backup things from any directory mounted within /backups inside the container.",
  "paths": [
    {
      "name": "Config Directory",
      "host": "/mnt/cache/appdata/proxmox-backup-client/",
      "container": "/root/.config/proxmox-backup/",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Backup Path 1",
      "host": "",
      "container": "/backups/path1",
      "mode": "ro",
      "description": null,
      "required": false
    },
    {
      "name": "Backup Path 2",
      "host": "",
      "container": "/backups/path2",
      "mode": "ro",
      "description": null,
      "required": false
    },
    {
      "name": "Backup Path 3",
      "host": "",
      "container": "/backups/path3",
      "mode": "ro",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PBS Encryption Password",
      "key": "PBS_ENCRYPTION_PASSWORD",
      "value": "",
      "description": "Encryption Password is Generated on first startup. Copy it from the console log and store it somewhere safe.",
      "required": false,
      "mask": true
    },
    {
      "name": "PBS Endpoint",
      "key": "PBS_ENDPOINT",
      "value": "",
      "description": "URL or IP of your Proxmox Backup Server instance",
      "required": true,
      "mask": false
    },
    {
      "name": "PBS Datastore",
      "key": "PBS_DATASTORE",
      "value": "",
      "description": "Name of the Datastore you want to backup to.",
      "required": true,
      "mask": false
    },
    {
      "name": "CRON Schedule",
      "key": "CRON_SCHEDULE",
      "value": "0 */4 * * *",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PBS API Key Name",
      "key": "PBS_API_KEY_NAME",
      "value": "username@pam!test",
      "description": "Use of the PBS_API_KEY_NAME and PBS_API_KEY_SECRET is recommended",
      "required": false,
      "mask": false
    },
    {
      "name": "PBS API Key Secret",
      "key": "PBS_API_KEY_SECRET",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "PBS User",
      "key": "PBS_USER",
      "value": "",
      "description": "PBS_USER/PBS_PASSWORD is not required if PBS_API_KEY_NAME is set.",
      "required": false,
      "mask": false
    },
    {
      "name": "PBS Password",
      "key": "PBS_PASSWORD",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "PBS Fingerprint",
      "key": "PBS_FINGERPRINT",
      "value": "",
      "description": "PBS_FINGERPRINT is required if using a self signed SSL certificate.",
      "required": false,
      "mask": false
    },
    {
      "name": "PBS Datastore Namespace",
      "key": "PBS_DATASTORE_NS",
      "value": "",
      "description": "PBS_DATASTORE_NS is optional but should be set if using namespaces.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
