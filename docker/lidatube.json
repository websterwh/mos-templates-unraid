{
  "name": "lidatube",
  "repo": "thewicklowwolf/lidatube:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/thewicklowwolf/lidatube",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://user-images.githubusercontent.com/111055425/272870500-69396f7a-af18-42a9-b1ea-0585b488bdec.png",
  "project": "https://github.com/TheWicklowWolf/LidaTube",
  "description": "Web GUI for finding and downloading missing Lidarr albums",
  "paths": [
    {
      "name": "Downloads",
      "host": "/mnt/cache/data/downloads",
      "container": "/lidatube/downloads",
      "mode": "rw,shared",
      "description": null,
      "required": false
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Lidarr",
      "key": "lidarr_address",
      "value": "http://SERVER-IP:8686",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Lidarr API",
      "key": "lidarr_api_key",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Thread Limit",
      "key": "thread_limit",
      "value": "1",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
