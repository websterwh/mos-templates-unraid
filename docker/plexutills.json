{
  "name": "plex-utills",
  "repo": "jkirkcaldy/plex-utills",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jkirkcaldy/plex-utills/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/jkirkcaldy/plex-utills/blob/7cf707f3aee6aa865a811b88d9ced865626bf7bd/app/img/plex-utills_square.png?raw=1",
  "project": "https://github.com/jkirkcaldy/plex-utills",
  "description": "A utility to help manage your library. Options include adding 4k banners and HDR banners to your poster art automactically, auto collections for Disney and Pixar Studios and hiding/auto optimising media files where there is only a 4k version available.",
  "paths": [
    {
      "name": "Plex Library",
      "host": "/mnt/cache/Plex/",
      "container": "/films",
      "mode": "ro",
      "description": "Location of your Plex media files. Needed if you want to create backup posters",
      "required": false
    },
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/plex-utills/",
      "container": "/config",
      "mode": "rw",
      "description": "Location of your config file",
      "required": false
    },
    {
      "name": "Logs",
      "host": "/mnt/disks/Docker_SSD/plex-utills/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Container Path: /logs",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Webui Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
