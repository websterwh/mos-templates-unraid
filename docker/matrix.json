{
  "name": "matrix",
  "repo": "avhost/docker-matrix:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/avhost/docker-matrix/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8008]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/matrix.png",
  "project": "https://hub.docker.com/r/avhost/docker-matrix",
  "description": "Docker Image for the matrix chat server.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/matrix/",
      "container": "/data",
      "mode": "rw",
      "description": "Appdata",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8008",
      "container": "8008",
      "protocol": "tcp",
      "description": "HTTP",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS",
      "host": "8448",
      "container": "8448",
      "protocol": "tcp",
      "description": "HTTPS",
      "required": false,
      "mask": false
    },
    {
      "name": "STUN TCP",
      "host": "3478",
      "container": "3478",
      "protocol": "tcp",
      "description": "STUN TCP",
      "required": false,
      "mask": false
    },
    {
      "name": "STUN UDP",
      "host": "3478",
      "container": "3478",
      "protocol": "udp",
      "description": "STUN UDP",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Name",
      "key": "SERVER_NAME",
      "value": "matrix",
      "description": "Server and domain name, mandatory, needed only for generate",
      "required": false,
      "mask": false
    },
    {
      "name": "Report Stats",
      "key": "REPORT_STATS",
      "value": "no",
      "description": "statistic report, mandatory, values: yes or no, needed only for generate",
      "required": false,
      "mask": false
    },
    {
      "name": "CACHE_FACTOR",
      "key": "SYNAPSE_CACHE_FACTOR",
      "value": "0.5",
      "description": "https://github.com/matrix-org/synapse#id19",
      "required": false,
      "mask": false
    },
    {
      "name": "UID",
      "key": "MATRIX_UID",
      "value": "99",
      "description": "UID",
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "MATRIX_GID",
      "value": "100",
      "description": "GID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
