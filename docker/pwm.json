{
  "name": "pwm",
  "repo": "fjudith/pwm",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/fjudith/pwm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://i.imgur.com/dAMqu51.png",
  "project": "https://github.com/pwm-project/pwm",
  "description": "PWM is a free and opensource password self-service application enabling end-users to reset their enterprise password themselves.",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/pwm",
      "container": "/usr/share/pwm",
      "mode": "rw",
      "description": "Container Path: /usr/share/pwm",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8282",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "File Lock Bypass",
      "key": "PWM_APPLICATIONFLAGS",
      "value": "NoFileLock",
      "description": "Container Variable: PWM_APPLICATIONFLAGS",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
