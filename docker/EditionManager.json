{
  "name": "Edition-Manager",
  "repo": "entree3000/edition-manager",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/entree3000/edition-manager/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Entree3k/Unraid-Templates/main/edition-manager/kQSCOtN6.png",
  "project": "https://github.com/Entree3k/edition-manager",
  "description": "Edition Manager is a tool that automatically manages and updates movie edition information in your Plex library.",
  "paths": [
    {
      "name": "Config Directory",
      "host": "/mnt/cache/appdata/edition-manager/",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration directory",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Run All",
      "key": "RUN_MODE",
      "value": "--all",
      "description": "Run all operations",
      "required": false,
      "mask": false
    },
    {
      "name": "Run New",
      "key": "RUN_MODE",
      "value": "--new",
      "description": "Add edition info to new movies",
      "required": false,
      "mask": false
    },
    {
      "name": "Reset",
      "key": "RUN_MODE",
      "value": "--reset",
      "description": "Reset edition info for all movies",
      "required": false,
      "mask": false
    },
    {
      "name": "Backup",
      "key": "RUN_MODE",
      "value": "--backup",
      "description": "Backup movie metadata",
      "required": false,
      "mask": false
    },
    {
      "name": "Restore",
      "key": "RUN_MODE",
      "value": "--restore",
      "description": "Restore movie metadata from backup",
      "required": false,
      "mask": false
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "",
      "description": "Set to 'true' to run with Debug Logs",
      "required": false,
      "mask": false
    },
    {
      "name": "Config File",
      "key": "CONFIG_FILE",
      "value": "",
      "description": "Specify a custom config file location",
      "required": false,
      "mask": false
    },
    {
      "name": "Plex URL",
      "key": "PLEX_URL",
      "value": "",
      "description": "Plex server URL",
      "required": false,
      "mask": false
    },
    {
      "name": "Plex Token",
      "key": "PLEX_TOKEN",
      "value": "",
      "description": "Plex server token",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
