{
  "name": "MeshSense",
  "repo": "ghcr.io/poag/meshsense:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/Poag/meshsense/pkgs/container/meshsense",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5920]/",
  "icon": "https://raw.githubusercontent.com/Poag/docker-xml/refs/heads/main/images/meshsense.png",
  "project": "https://github.com/Affirmatech/MeshSense",
  "description": "Headless MeshSense: web UI that monitors and maps your Meshtastic network via a WiFi/TCP node.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/meshsense",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent MeshSense state.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5920",
      "container": "5920",
      "protocol": "tcp",
      "description": "Web UI port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ADDRESS",
      "key": "ADDRESS",
      "value": "",
      "description": "IP or hostname of your Meshtastic node (WiFi/TCP).",
      "required": false,
      "mask": false
    },
    {
      "name": "ACCESS_KEY",
      "key": "ACCESS_KEY",
      "value": "",
      "description": "Optional API access key (not a web UI login).",
      "required": false,
      "mask": true
    },
    {
      "name": "PORT",
      "key": "PORT",
      "value": "5920",
      "description": "Listen port inside the container; match the WebUI mapping.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID that runs the app (Unraid default 99).",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID that runs the app (Unraid default 100).",
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "UTC",
      "description": "Timezone, e.g. Europe/London.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
