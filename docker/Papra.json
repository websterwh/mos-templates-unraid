{
  "name": "Papra",
  "repo": "ghcr.io/papra-hq/papra:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/papra-hq/papra",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user=99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1221]",
  "icon": "https://raw.githubusercontent.com/egnerdata/unraid-docker-templates/main/icons/papra.png",
  "project": "https://github.com/papra-hq/papra",
  "description": "Papra is a lightweight document management solution (DMS) that automatically imports, stores, and organizes your files. A simpler alternative to Paperless. Installation: Fill in your App Base URL (ip or domain of server), listed below as \"http://localhost:1221\" That's it, your Papra server is ready!",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/papra",
      "container": "/app/app-data",
      "mode": "rw",
      "description": "Papra app data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "1221",
      "container": "1221",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "App Base URL (ip or domain of server)",
      "key": "APP_BASE_URL",
      "value": "http://localhost:1221",
      "description": "Replace with ip-adress/domain of server",
      "required": true,
      "mask": false
    },
    {
      "name": "Auth_Secret (32+ chars)",
      "key": "AUTH_SECRET",
      "value": "papra-default-auth-secret-change-me",
      "description": "The secret for the auth, it should be at least 32 characters long",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
