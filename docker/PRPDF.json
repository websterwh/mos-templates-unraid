{
  "name": "PRPDF",
  "repo": "knex666/prpdf",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/knex666/prpdf",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn2.iconfinder.com/data/icons/adobe-acrobat-pdf/154/adobe-acrobat-pdf-file-document-512.png",
  "project": "https://github.com/maschhoff/prpdf",
  "description": "This tool is for Preview and Rename scanned PDF-Documents. Rulebased autoscan with OCR. Merge etc. Its an open beta that I am testing on. Please add a scan source folder and a folder where your files shoud be sorted and archived into the subfolders existing there Any Issus report on github.",
  "paths": [
    {
      "name": "Files",
      "host": "",
      "container": "/Archiv/",
      "mode": "rw",
      "description": "Document Repository: /Archiv/",
      "required": false
    },
    {
      "name": "Host Path 2",
      "host": "",
      "container": "/source/static/pdf/",
      "mode": "rw",
      "description": "Scan Import Path: /source/static/pdf/",
      "required": false
    },
    {
      "name": "Host Path 4",
      "host": "/mnt/cache/appdata/prpdf/",
      "container": "/source/config",
      "mode": "rw",
      "description": "Configuration",
      "required": false
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
