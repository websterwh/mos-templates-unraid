{
  "name": "karakeep-chrome",
  "repo": "ghcr.io/karakeep-app/karakeep-chrome:release",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/karakeep-app/karakeep/pkgs/container/karakeep-chrome",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--init --restart unless-stopped",
  "post_parameters": "--disable-gpu --disable-dev-shm-usage --hide-scrollbars --disable-blink-features=AutomationControlled --window-size=1440,900",
  "web_ui_url": "http://[IP]:[PORT:9222]",
  "icon": "https://raw.githubusercontent.com/Collectathon/unraid-templates/main/icons/karakeep-chrome.png",
  "project": "https://github.com/karakeep-app/karakeep",
  "description": "Headless Chrome for Karakeep. Runs Google Chrome stable (Debian Chromium on arm64) in Chrome's new headless mode, exposing the DevTools endpoint on port 9222 for Karakeep's archiving and screenshotting. Not meant to be reached directly from a browser.",
  "paths": [],
  "ports": [
    {
      "name": "Debug Port",
      "host": "9222",
      "container": "9222",
      "protocol": "tcp",
      "description": "Chrome DevTools port. Karakeep connects here via BROWSER_WEB_URL (http:// :9222).",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Chrome Version",
      "key": "KARAKEEP_CHROME_VERSION",
      "value": "release",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
