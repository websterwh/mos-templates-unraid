{
  "name": "geoip2influx",
  "repo": "ghcr.io/gilbn/geoip2influx",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/gilbn/geoip2influx",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": null,
  "project": "https://github.com/gilbN/geoip2influx",
  "description": "A python script that will parse the nginx access.log and send geolocation metrics and log metrics to InfluxDB Grafans dashboard link: https://grafana.com/grafana/dashboards/12268 See readme for instructions and additional environment variables. https://github.com/gilbN/geoip2influx/blob/master/README.md",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    },
    {
      "name": "Nginx access.log folder",
      "host": "",
      "container": "/config/log/nginx/",
      "mode": "rw",
      "description": "Container Path: /config/log/nginx/",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB host",
      "key": "INFLUX_HOST",
      "value": "",
      "description": "Container Variable: INFLUX_HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "InfluxDB port",
      "key": "INFLUX_HOST_PORT",
      "value": "",
      "description": "Container Variable: INFLUX_HOST_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB user",
      "key": "INFLUX_USER",
      "value": "",
      "description": "Container Variable: INFLUX_USER",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB password",
      "key": "INFLUX_PASS",
      "value": "",
      "description": "Container Variable: INFLUX_PASS",
      "required": false,
      "mask": true
    },
    {
      "name": "MaxmindDB license key",
      "key": "MAXMINDDB_LICENSE_KEY",
      "value": "",
      "description": "Container Variable: MAXMINDDB_LICENSE_KEY",
      "required": true,
      "mask": true
    },
    {
      "name": "MaxmindDB account id",
      "key": "MAXMINDDB_USER_ID",
      "value": "",
      "description": "Container Variable: MAXMINDDB_USER_ID",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
