{
  "name": "scrutiny-web",
  "repo": "ghcr.io/starosdev/scrutiny:latest-web",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/Starosdev/scrutiny/pkgs/container/scrutiny",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/web/dashboard",
  "icon": "https://raw.githubusercontent.com/Starosdev/scrutiny/master/webapp/frontend/src/assets/images/logo/scrutiny-logo-dark.png",
  "project": "https://github.com/Starosdev/scrutiny",
  "description": "Scrutiny Web Server (Hub/Spoke mode). Provides the web dashboard and API for S.M.A.R.T monitoring. Requires a separate InfluxDB instance and one or more Scrutiny collector containers. Use the omnibus template instead if you want an all-in-one deployment.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/scrutiny-web/config",
      "container": "/opt/scrutiny/config",
      "mode": "rw",
      "description": "Scrutiny configuration and SQLite database.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web dashboard port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "InfluxDB Host",
      "key": "SCRUTINY_WEB_INFLUXDB_HOST",
      "value": "",
      "description": "Hostname or IP of your InfluxDB instance (e.g. influxdb or 192.168.1.100). Required.",
      "required": true,
      "mask": false
    },
    {
      "name": "InfluxDB Port",
      "key": "SCRUTINY_WEB_INFLUXDB_PORT",
      "value": "8086",
      "description": "InfluxDB port.",
      "required": false,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "",
      "description": "Timezone (e.g. America/New_York). See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT Enabled",
      "key": "SCRUTINY_WEB_MQTT_ENABLED",
      "value": "false",
      "description": "Enable Home Assistant MQTT Discovery. Drives will auto-appear in Home Assistant.",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT Broker",
      "key": "SCRUTINY_WEB_MQTT_BROKER",
      "value": "",
      "description": "MQTT broker URL (e.g. tcp://mosquitto:1883). Required when MQTT is enabled.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
