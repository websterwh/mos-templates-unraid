{
  "name": "media-triage",
  "repo": "drumsergio/media-triage:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/drumsergio/media-triage",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4850]/",
  "icon": "https://raw.githubusercontent.com/GeiserX/docker-templates/master/drumsergio/images/media-triage.png",
  "project": "https://github.com/GeiserX/media-triage",
  "description": "Automated media pipeline that monitors a Telegram group for torrent tracker posts, parses release metadata using regex, and presents everything in a review-ready web dashboard. Integrates with Prowlarr (indexer aggregator), qBittorrent, and TMDB for metadata enrichment. Built on FastAPI with PostgreSQL and Telethon. Requires: PostgreSQL, Telegram API credentials, TMDB API key. More info: https://github.com/GeiserX/media-triage",
  "paths": [
    {
      "name": "Sessions",
      "host": "/mnt/cache/appdata/media-triage/sessions",
      "container": "/data/sessions",
      "mode": "rw",
      "description": "Telethon session files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4850",
      "container": "4850",
      "protocol": "tcp",
      "description": "Web dashboard port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Telegram API ID",
      "key": "TELEGRAM_API_ID",
      "value": "",
      "description": "Telegram API ID from my.telegram.org",
      "required": true,
      "mask": false
    },
    {
      "name": "Telegram API Hash",
      "key": "TELEGRAM_API_HASH",
      "value": "",
      "description": "Telegram API hash",
      "required": true,
      "mask": true
    },
    {
      "name": "Telegram Phone",
      "key": "TELEGRAM_PHONE",
      "value": "",
      "description": "Phone number with country code",
      "required": true,
      "mask": false
    },
    {
      "name": "Telegram Group ID",
      "key": "TELEGRAM_GROUP_ID",
      "value": "",
      "description": "Telegram group ID to monitor",
      "required": true,
      "mask": false
    },
    {
      "name": "Bot Token",
      "key": "TELEGRAM_BOT_TOKEN",
      "value": "",
      "description": "Telegram bot token",
      "required": true,
      "mask": true
    },
    {
      "name": "Owner ID",
      "key": "TELEGRAM_OWNER_ID",
      "value": "",
      "description": "Your Telegram user ID for admin commands",
      "required": true,
      "mask": false
    },
    {
      "name": "TMDB API Key",
      "key": "TMDB_API_KEY",
      "value": "",
      "description": "TMDB API key for metadata",
      "required": true,
      "mask": true
    },
    {
      "name": "PostgreSQL Host",
      "key": "POSTGRES_HOST",
      "value": "media-triage-postgres",
      "description": "PostgreSQL hostname",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL Password",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "PostgreSQL password",
      "required": true,
      "mask": true
    },
    {
      "name": "Prowlarr URL",
      "key": "PROWLARR_URL",
      "value": "",
      "description": "Prowlarr instance URL (optional)",
      "required": false,
      "mask": false
    },
    {
      "name": "Prowlarr API Key",
      "key": "PROWLARR_API_KEY",
      "value": "",
      "description": "Prowlarr API key",
      "required": false,
      "mask": true
    },
    {
      "name": "qBittorrent URL",
      "key": "QBITTORRENT_URL",
      "value": "",
      "description": "qBittorrent instance URL (optional)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
