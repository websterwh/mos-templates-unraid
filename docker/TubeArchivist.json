{
  "name": "TubeArchivist",
  "repo": "bbilly1/tubearchivist:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/bbilly1/tubearchivist/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://i.imgur.com/6n4ljjQ.png",
  "project": "https://github.com/tubearchivist/tubearchivist",
  "description": "Your self hosted YouTube media server. https://docs.tubearchivist.com/installation/Unraid/",
  "paths": [
    {
      "name": "Youtube Media Path",
      "host": "/mnt/cache/",
      "container": "/youtube",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/TubeArchivist/",
      "container": "/cache",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "HOST",
      "key": "TA_HOST",
      "value": "IP ADDRESSES",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TA Username",
      "key": "TA_USERNAME",
      "value": "tubearchivist",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TA Password",
      "key": "TA_PASSWORD",
      "value": "verysecret",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Redis",
      "key": "REDIS_CON",
      "value": "redis://archivist-redis:6379",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ElasticSearch Password",
      "key": "ELASTIC_PASSWORD",
      "value": "verysecret",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ElasticSearch",
      "key": "ES_URL",
      "value": "http://HOSTIPADDRESS:9200",
      "description": "leave the 'http://'",
      "required": false,
      "mask": false
    },
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "America/Chicago",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "HOST_GID",
      "value": "100",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UID",
      "key": "HOST_UID",
      "value": "99",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
