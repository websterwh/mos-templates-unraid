{
  "name": "LibreX",
  "repo": "librex/librex:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/librex/librex",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/librex-icon.png",
  "project": "https://github.com/hnhx/librex",
  "description": "A framework- and JavaScript-free privacy respecting meta search engine, giving you results from Google, Qwant, Ahmia and popular torrent sites without spying on you.",
  "paths": [
    {
      "name": "Nginx Logs Path",
      "host": "/mnt/cache/appdata/librex/nginx",
      "container": "/var/log/nginx",
      "mode": "rw",
      "description": "Path to Nginx logs",
      "required": true
    },
    {
      "name": "PHP Logs Path",
      "host": "/mnt/cache/appdata/librex/php",
      "container": "/var/log/php7",
      "mode": "rw",
      "description": "Path to PHP logs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Google - Domain",
      "key": "CONFIG_GOOGLE_DOMAIN",
      "value": "com",
      "description": "Which Google domain the search will be done on. Change according to your country.",
      "required": true,
      "mask": false
    },
    {
      "name": "Google - Site Language",
      "key": "CONFIG_GOOGLE_LANGUAGE_SITE",
      "value": "en",
      "description": "Language to use for Google site",
      "required": true,
      "mask": false
    },
    {
      "name": "Google - Results Language",
      "key": "CONFIG_GOOGLE_LANGUAGE_RESULTS",
      "value": "en",
      "description": "Language to use for Google results",
      "required": true,
      "mask": false
    },
    {
      "name": "Wikipedia - Language",
      "key": "CONFIG_WIKIPEDIA_LANGUAGE",
      "value": "en",
      "description": "Language to use for Wikipedia",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Version",
      "key": "VERSION",
      "value": "docker",
      "description": "Tell application it is running as a Docker container. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
