{
  "name": "OpenClaw",
  "repo": "medzin/openclaw",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/medzin/openclaw",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:18789]",
  "icon": "https://raw.githubusercontent.com/medzin/docker-templates/main/images/openclaw-icon.png",
  "project": "https://github.com/openclaw/openclaw",
  "description": "Your own personal AI assistant. Any OS. Any Platform. The lobster way.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/openclaw",
      "container": "/home/node/.openclaw",
      "mode": "rw",
      "description": "OpenClaw state, config, and workspace.",
      "required": true
    },
    {
      "name": "Auth Profile Secrets",
      "host": "/mnt/cache/appdata/openclaw/auth-profile-secrets",
      "container": "/home/node/.config/openclaw",
      "mode": "rw",
      "description": "OpenClaw auth profile secrets directory.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "18789",
      "container": "18789",
      "protocol": "tcp",
      "description": "OpenClaw gateway web interface.",
      "required": true,
      "mask": false
    },
    {
      "name": "Bridge",
      "host": "18790",
      "container": "18790",
      "protocol": "tcp",
      "description": "OpenClaw bridge port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OPENCLAW_GATEWAY_TOKEN",
      "key": "OPENCLAW_GATEWAY_TOKEN",
      "value": "",
      "description": "Shared token required to connect to the OpenClaw gateway. Set this before exposing the WebUI port.",
      "required": true,
      "mask": true
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "UTC",
      "description": "Container timezone.",
      "required": false,
      "mask": false
    },
    {
      "name": "OPENCLAW_DISABLE_BONJOUR",
      "key": "OPENCLAW_DISABLE_BONJOUR",
      "value": "1",
      "description": "Disable Bonjour/mDNS discovery inside the container.",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for the OpenClaw process and file permissions.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for the OpenClaw process and file permissions.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
