{
  "name": "DollarDollar",
  "repo": "harung43/dollardollar:latest",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/harung43/dollardollar",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5001]/",
  "icon": "https://raw.githubusercontent.com/jordan-dalby/unraidtemplates/refs/heads/main/images/dollardollar.png",
  "project": "https://github.com/harung1993/dollardollar",
  "description": "Docker container for DollarDollar application.",
  "paths": [],
  "ports": [
    {
      "name": "WEB_UI",
      "host": "5001",
      "container": "5001",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SQLALCHEMY_DATABASE_URI",
      "key": "SQLALCHEMY_DATABASE_URI",
      "value": "postgresql://your_db_user:your_db_pass@your_db_host:5432/your_db_name",
      "description": "Replace your_ with your postgresql details.",
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "your_very_long_random_secret_key",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DISABLE_SIGNUPS",
      "key": "DISABLE_SIGNUPS",
      "value": "False",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DEBUG",
      "key": "DEBUG",
      "value": "True",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_LEVEL",
      "key": "LOG_LEVEL",
      "value": "INFO",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_SERVER",
      "key": "MAIL_SERVER",
      "value": "smtp.gmail.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PORT",
      "key": "MAIL_PORT",
      "value": "587",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_USE_TLS",
      "key": "MAIL_USE_TLS",
      "value": "True",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_USE_SSL",
      "key": "MAIL_USE_SSL",
      "value": "False",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_USERNAME",
      "key": "MAIL_USERNAME",
      "value": "your_email@gmail.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PASSWORD",
      "key": "MAIL_PASSWORD",
      "value": "your_app_password",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_DEFAULT_SENDER",
      "key": "MAIL_DEFAULT_SENDER",
      "value": "your_email@gmail.com",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
