{
  "name": "ParkPow-Plate-Recognizer---Stream---GPU",
  "repo": "platerecognizer/alpr-stream:gpu",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/platerecognizer/alpr-stream",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://app.parkpow.com/static/images/Icon_ParkPow_100x100.jpg",
  "project": "https://platerecognizer.com/",
  "description": "Read a license plate from a live video stream, powered by ParkPow. With Nvidia GPU support.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/plate_recognizer/stream",
      "container": "/user-data",
      "mode": "rw",
      "description": "Path to app data",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "API Token",
      "key": "TOKEN",
      "value": "",
      "description": "API Token for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true
    },
    {
      "name": "License",
      "key": "LICENSE_KEY",
      "value": "",
      "description": "License Key for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
