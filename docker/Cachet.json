{
  "name": "Cachet",
  "repo": "cachethq/docker:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/cachethq/docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://i.imgur.com/dSBbxqj.png",
  "project": "https://github.com/CachetHQ/Cachet",
  "description": "Cachet is a beautiful and powerful open source status page system, a free replacement for services such as StatusPage.io, Status.io, and others. Docs: https://docs.cachethq.io/docs/installing-cachet",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/Cachet/",
      "container": "/var/www/cachet/",
      "mode": "rw",
      "description": "Container Path: /var/www/Cachet/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_DRIVER",
      "key": "DB_DRIVER",
      "value": "mysql",
      "description": "Container Variable: DB_DRIVER",
      "required": true,
      "mask": false
    },
    {
      "name": "APP_KEY",
      "key": "APP_KEY",
      "value": "base64:2iJWPWu9PWzkI4B2CcdVYQo0CPvtXIhS1vVi/GCGn5A=",
      "description": "Container Variable: APP_KEY. Some random string",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "192.168.1.100",
      "description": "Container Variable: DB_HOST",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_DATABASE",
      "key": "DB_DATABASE",
      "value": "cachet",
      "description": "Container Variable: DB_DATABASE",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": "cachet",
      "description": "Container Variable: DB_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "password",
      "description": "Container Variable: DB_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "3306",
      "description": "Container Variable: DB_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_DRIVER",
      "key": "MAIL_DRIVER",
      "value": "smtp",
      "description": "Container Variable: MAIL_DRIVER",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_HOST",
      "key": "MAIL_HOST",
      "value": "smtp.mailgun.org",
      "description": "Container Variable: MAIL_HOST",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PORT",
      "key": "MAIL_PORT",
      "value": "587",
      "description": "Container Variable: MAIL_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_USERNAME",
      "key": "MAIL_USERNAME",
      "value": "postmaster@domain.com",
      "description": "Container Variable: MAIL_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_PASSWORD",
      "key": "MAIL_PASSWORD",
      "value": "password",
      "description": "Container Variable: MAIL_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_ADDRESS",
      "key": "MAIL_ADDRESS",
      "value": "status@domain.com",
      "description": "Container Variable: MAIL_ADDRESS",
      "required": false,
      "mask": false
    },
    {
      "name": "MAIL_NAME",
      "key": "MAIL_NAME",
      "value": "Status",
