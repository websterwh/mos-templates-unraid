{
  "name": "droppy",
  "repo": "silverwind/droppy",
  "category": [
    "Misc"
  ],
  "registry": "https://registry.hub.docker.com/r/silverwind/droppy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8989]",
  "icon": "https://raw.githubusercontent.com/type0dev/Unraid-Template/main/droppy/droppy-logo.png",
  "project": "https://github.com/silverwind/droppy",
  "description": "droppy is a self-hosted file storage server with a web interface and capabilities to edit files and view media directly in the browser. It is particularly well-suited to be run on low-end hardware like the Raspberry Pi. **Development on droppy has ceased, However it is a solid simple solution for file sharing and management.**",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/droppy",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Files",
      "host": "/mnt/cache/appdata/droppy/files",
      "container": "/files",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8989",
      "container": "8989",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
