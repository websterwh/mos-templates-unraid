{
  "name": "flexget",
  "repo": "wiserain/flexget:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/wiserain/flexget:latest",
  "network": "none",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--net=container:binhex-delugevpn",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://github.com/paulpoco/docker-templates/raw/master/paulpoco/images/Deluge-Flexget-icon-small.png",
  "project": "http://flexget.com/",
  "description": "FlexGet is a multipurpose automation tool for all of your media. REQUIRES binhex-delugevpn to be installed 1st. Then follow instructions at Binhex's VPN FAQ Q24.",
  "paths": [
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/Media",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    },
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/flexget",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Key 1",
      "key": "FG_WEBUI_PASSWD",
      "value": "16 charactor password",
      "description": "Container Variable: FG_WEBUI_PASSWD",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "UMASK",
      "value": "000",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 3",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 4",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
