{
  "name": "Reubah",
  "repo": "ghcr.io/dendianugerah/reubah:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/dendianugerah/reubah",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/reubah-icon.png",
  "project": "https://github.com/dendianugerah/reubah",
  "description": "A simple web-based tool for processing images and converting documents with a simple interface.",
  "paths": [
    {
      "name": "Temp Directory",
      "host": "/mnt/cache/appdata/reubah/tmp",
      "container": "/app/tmp",
      "mode": "rw",
      "description": "Path to temporary files",
      "required": true
    },
    {
      "name": "Doc Temp Directory",
      "host": "/mnt/cache/appdata/reubah/doc_tmp",
      "container": "/tmp",
      "mode": "rw",
      "description": "Path to temporary files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "8081",
      "description": "Internal Port",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
