{
  "name": "Nightscout",
  "repo": "nightscout/cgm-remote-monitor:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/nightscout/cgm-remote-monitor",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1337]",
  "icon": "https://avatars2.githubusercontent.com/u/7661012?s=200&v=4",
  "project": "https://github.com/nightscout/cgm-remote-monitor",
  "description": "Allows the installation of Nightscout, a remote CGM monitoring system. It allows the upload and display of blood glucous values and can be configuered to issue warnings etc. This is mainly useful to diabetics. For more information see: http://www.nightscout.info/ Note that this container only contains the required data to run the website. For data logging, a MongoDB instance is necessary. Configuration of Nightscout is done over variables that are passed through Docker. For ease of use, only required and important variables are exposed by default. For an extensive list of all variables, please refer to: https://github.com/nightscout/cgm-remote-monitor#environment",
  "paths": [],
  "ports": [
    {
      "name": "WebUI port",
      "host": "1337",
      "container": "1337",
      "protocol": "tcp",
      "description": "Container Port: 1337",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MongoDB Database",
      "key": "MONGO_CONNECTION",
      "value": "mongodb://db-user:db-password@mongodb-instance:port/db-name",
      "description": "Container Variable: MONGO_CONNECTION",
      "required": true,
      "mask": false
    },
    {
      "name": "Unit",
      "key": "DISPLAY_UNITS",
      "value": "",
      "description": "Set to mg/dl or mmol",
      "required": true,
      "mask": false
    },
    {
      "name": "URL",
      "key": "BASE_URL",
      "value": "",
      "description": "Container Variable: BASE_URL",
      "required": true,
      "mask": false
    },
    {
      "name": "API_SECRET",
      "key": "API_SECRET",
      "value": "",
      "description": "Container Variable: API_SECRET Should be a complex key",
      "required": true,
      "mask": false
    },
    {
      "name": "ENABLE",
      "key": "ENABLE",
      "value": "delta direction upbat timeago devicestatus errorcodes ar2 simplealarms profile",
      "description": "Container Variable: ENABLE",
      "required": false,
      "mask": false
    },
    {
      "name": "BG_HIGH",
      "key": "BG_HIGH",
      "value": "",
      "description": "Container Variable: BG_HIGH",
      "required": false,
      "mask": false
    },
    {
      "name": "BG_LOW",
      "key": "BG_LOW",
      "value": "",
      "description": "Container Variable: BG_LOW",
      "required": false,
      "mask": false
    },
    {
      "name": "BG_TARGET_BOTTOM",
      "key": "BG_TARGET_BOTTOM",
      "value": "",
      "description": "Container Variable: BG_TARGET_BOTTOM",
      "required": false,
      "mask": false
    },
    {
      "name": "BG_TARGET_TOP",
      "key": "BG_TARGET_TOP",
      "value": "",
      "description": "Container Variable: BG_TARGET_TOP",
      "required": false,
      "mask": false
    },
    {
      "name": "THEME",
      "key": "THEME",
      "value": "colors",
      "description": "Container Variable: THEME",
      "required": false,
      "mask": false
    },
    {
      "name": "TIME_FORMAT",
      "key": "TIME_FORMAT",
      "value": "24",
      "description": "Container Variable: TIME_FORMAT",
      "required": false,
      "mask": false
    },
    {
      "name": "INSECURE_USE_HTTP",
      "key": "INSECURE_USE_HTTP",
      "value": "false",
      "description": "Container Variable: INSECURE_USE_HTTP Set to true if used with reverse proxy",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
