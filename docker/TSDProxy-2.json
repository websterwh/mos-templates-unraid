{
  "name": "TSDProxy",
  "repo": "almeidapaulopt/tsdproxy:2",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/almeidapaulopt/tsdproxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--add-host host.docker.internal:host-gateway",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": null,
  "project": "https://github.com/almeidapaulopt/tsdproxy",
  "description": "TSDProxy automatically creates Tailscale machines for your Docker containers without requiring sidecar containers. Add tsdproxy.enable=true to any container label, and TSDProxy handles the rest \u2014 automatic HTTPS via Tailscale, dynamic lifecycle management, and a real-time dashboard.",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/tsdproxy/config",
      "container": "/config",
      "mode": "rw",
      "description": "Directory for tsdproxy.yaml configuration file (auto-generated on first boot)",
      "required": true
    },
    {
      "name": "Data path",
      "host": "/mnt/cache/appdata/tsdproxy/data",
      "container": "/data",
      "mode": "rw",
      "description": "Directory for Tailscale state data",
      "required": true
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker daemon socket \u2014 required for container auto-discovery",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web dashboard port (HTTP)",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
