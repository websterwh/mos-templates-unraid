{
  "name": "TSDProxy",
  "repo": "almeidapaulopt/tsdproxy:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/almeidapaulopt/tsdproxy/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/dkaser/unraid-plugins/main/tsdproxy.png",
  "project": "https://github.com/almeidapaulopt/tsdproxy/",
  "description": "TSDProxy automatically creates Tailscale machines for your containers without requiring changes to the container. Easy to configure and deploy, based on Docker container labels.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/tsdproxy/config",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/tsdproxy/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "/var/run/docker.sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Dashboard",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
