{
  "name": "DumbDo",
  "repo": "dumbwareio/dumbdo:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dumbwareio/dumbdo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/dumbdo-logo.png",
  "project": "https://github.com/DumbWareio/DumbDo",
  "description": "A stupidly simple todo list application that just works. No complex database, no unnecessary features - just todos.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dumbdo",
      "container": "/app/data",
      "mode": "rw",
      "description": "Data Dir",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port on which the application will run.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
