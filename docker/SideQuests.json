{
  "name": "SideQuests",
  "repo": "need4swede/sidequests:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/need4swede/sidequests",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
