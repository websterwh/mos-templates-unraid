  "project": "https://github.com/need4swede/SideQuests",
  "description": "SideQuests - Objective Tracker SideQuests provides an intuitive and mobile friendly web-interface for managing tasks and objectives.",
  "paths": [
    {
      "name": "Instance",
      "host": "/mnt/cache/appdata/sidequests",
      "container": "/app/instance",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ADMIN_USERNAME",
      "key": "ADMIN_USERNAME",
      "value": "",
      "description": "Admin Username",
      "required": true,
      "mask": false
    },
    {
      "name": "ADMIN_PASSWORD",
      "key": "ADMIN_PASSWORD",
      "value": "",
      "description": "Admin Password",
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "RANDOM_CHARACTERS",
      "description": "Secret Key",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
