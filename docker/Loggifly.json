{
  "name": "Loggifly",
  "repo": "ghcr.io/clemcer/loggifly:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/clemcer/loggifly",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/clemcer/loggifly/main/images/icon.png",
  "project": "https://github.com/clemcer/loggifly",
  "description": "Monitor Docker logs and send notifications",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/loggifly",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
