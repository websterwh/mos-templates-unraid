{
  "name": "Mafl",
  "repo": "ghcr.io/hywax/mafl",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/hywax/mafl/pkgs/container/mafl",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/mafl.png",
  "project": "https://mafl.hywax.space",
  "description": "Mafl is an intuitive service for organizing your homepage. Customize Mafl to your individual needs and work even more efficiently!",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/mafl/config.yaml",
      "container": "/app/data/config.yml",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Local Icons",
      "host": "/mnt/cache/appdata/mafl/favicons",
      "container": "/app/public/favicons",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Favicon Icons",
      "host": "/mnt/cache/appdata/mafl/icons",
      "container": "/app/public/icons",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Web UI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
