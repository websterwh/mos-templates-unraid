{
  "name": "bliss",
  "repo": "elstensoftware/bliss",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/elstensoftware/bliss",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3220]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/bliss-icon.png",
  "project": "https://www.blisshq.com/",
  "description": "bliss is an automated music library organizer for self-hosters and music hoarders.",
  "paths": [
    {
      "name": "Music Files",
      "host": "",
      "container": "/music",
      "mode": "rw",
      "description": "Path to music files",
      "required": true
    },
    {
      "name": "Configuration Data",
      "host": "/mnt/cache/appdata/bliss/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3220",
      "container": "3220",
      "protocol": "tcp",
      "description": "Container Port: 3220",
      "required": true,
      "mask": false
    },
    {
      "name": "Services Port",
      "host": "3221",
      "container": "3221",
      "protocol": "tcp",
      "description": "Container Port: 3221",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
