{
  "name": "openHAB",
  "repo": "openhab/openhab:latest-debian",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/openhab/openhab/",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--tty --shm-size 2g",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/tinglis1/docker-containers/master/openhab/openhab-logo-square.png",
  "project": "https://github.com/maschhoff/docker/tree/master/openhab",
  "description": "openHAB - a vendor and technology agnostic open source automation software for your home. For sample rules etc. have a look at https://github.com/maschhoff/OpenHAB",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "Container Path: /etc/localtime",
      "required": true
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/openhab2/conf/",
      "container": "/openhab/conf",
      "mode": "rw",
      "description": "Container Path: /openhab/conf",
      "required": true
    },
    {
      "name": "Host Path 3",
      "host": "/mnt/cache/appdata/openhab2/userdata/",
      "container": "/openhab/userdata",
      "mode": "rw",
      "description": "Container Path: /openhab/userdata",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
