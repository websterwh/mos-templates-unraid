{
  "name": "AppFlowy-AI",
  "repo": "appflowyinc/appflowy_ai:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/appflowyinc/appflowy_ai",
  "network": "custom:appflowy",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://avatars.githubusercontent.com/u/81710027?s=200&v=4",
  "project": "https://github.com/vmalinics0/unraid-appflowy",
  "description": "Step 6/7 (optional): AppFlowy AI \u2014 optional Python service providing LLM-powered chat, document summarisation, and embedding generation for AppFlowy Cloud. Requires an OpenAI or Azure OpenAI API key. Part of the AppFlowy Cloud stack.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "OpenAI API Key",
      "key": "OPENAI_API_KEY",
      "value": "",
      "description": "OpenAI API key. Required unless using Azure OpenAI. Used for chat and embeddings.",
      "required": false,
      "mask": true
    },
    {
      "name": "Azure OpenAI API Key",
      "key": "AZURE_OPENAI_API_KEY",
      "value": "",
      "description": "Azure-hosted OpenAI API key. Use this instead of OPENAI_API_KEY for Azure deployments.",
      "required": false,
      "mask": true
    },
    {
      "name": "Azure OpenAI Endpoint",
      "key": "AZURE_OPENAI_ENDPOINT",
      "value": "",
      "description": "Azure OpenAI resource endpoint URL (e.g. https://my-resource.openai.azure.com/).",
      "required": false,
      "mask": false
    },
    {
      "name": "Azure OpenAI API Version",
      "key": "AZURE_OPENAI_API_VERSION",
      "value": "",
      "description": "Azure OpenAI API version string (e.g. 2024-02-01).",
      "required": false,
      "mask": false
    },
    {
      "name": "AppFlowy Host (Base URL)",
      "key": "AI_APPFLOWY_HOST",
      "value": "http://YOUR_SERVER_IP",
      "description": "Public-facing base URL. Must match APPFLOWY_BASE_URL in AppFlowy-Cloud.",
      "required": true,
      "mask": false
    },
    {
      "name": "JWT Secret",
      "key": "APPFLOWY_GOTRUE_JWT_SECRET",
      "value": "changeme_jwt_secret_min32chars!!",
      "description": "Shared JWT secret. Must be identical to GoTrue and AppFlowy-Cloud.",
      "required": true,
      "mask": true
    },
    {
      "name": "Database URL",
      "key": "AI_DATABASE_URL",
      "value": "postgresql+psycopg://postgres:changeme_strong_password@AppFlowy-Postgres:5432/postgres",
      "description": "PostgreSQL connection string for the AI service (uses psycopg driver syntax).",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis URL",
      "key": "AI_REDIS_URL",
      "value": "redis://AppFlowy-Redis:6379",
      "description": "Redis connection URL.",
      "required": true,
      "mask": false
    },
    {
      "name": "Use MinIO",
      "key": "AI_USE_MINIO",
      "value": "true",
      "description": "Set true to use MinIO.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Access Key",
      "key": "APPFLOWY_S3_ACCESS_KEY",
      "value": "minioadmin",
      "description": "S3/MinIO access key.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Secret Key",
      "key": "APPFLOWY_S3_SECRET_KEY",
      "value": "changeme_minio_secret",
      "description": "S3/MinIO secret key.",
      "required": true,
      "mask": true
    },
    {
      "name": "S3 Bucket",
      "key": "APPFLOWY_S3_BUCKET",
      "value": "appflowy",
      "description": "S3/MinIO bucket name.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Region",
      "key": "APPFLOWY_S3_REGION",
      "value": "",
      "description": "AWS S3 region (leave empty for MinIO).",
      "required": false,
      "mask": false
    },
    {
      "name": "MinIO URL (internal)",
      "key": "AI_MINIO_URL",
      "value": "http://AppFlowy-MinIO:9000",
      "description": "Internal MinIO API URL.",
      "required": true,
      "mask": false
    },
    {
      "name": "AI Server Port",
      "key": "AI_SERVER_PORT",
      "value": "5001",
      "description": "Port the AI service listens on. Must match AI_SERVER_PORT in AppFlowy-Cloud.",
      "required": false,
      "mask": false
    },
    {
      "name": "Default AI Model",
      "key": "DEFAULT_AI_MODEL",
      "value": "gpt-4.1-mini",
      "description": "Default OpenAI chat model (e.g. gpt-4.1-mini, gpt-4o). Must be available in your OpenAI account.",
      "required": false,
      "mask": false
    },
    {
      "name": "Default Completion Model",
      "key": "DEFAULT_AI_COMPLETION_MODEL",
      "value": "gpt-4.1-mini",
      "description": "Model used for completions/summaries.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
