{
  "name": "onlyoffice-document-server",
  "repo": "xternet/unraid-onlyoffice-document-server:b722d7ee269b89afabea70dce3acfdc8eca6d7e5",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/repository/docker/xternet/unraid-onlyoffice-document-server",
  "network": "onlyoffice",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/AMJidovu/unraid-repository/d5a562fa4a7b73065dd022e585d80d4b77d0abfa/img/onlyoffice-ce-ds.jpg",
  "project": "https://www.onlyoffice.com/",
  "description": "Before you start this container you need to create the onlyoffice network. Open Unraid terminal and paste this command in there: \" sudo docker network create --driver bridge onlyoffice \" -- withouth the \" \" If you pair this container with onlyoffice-community-server then this container needs to start first. HTTPS Support can be enable creating a \"certs\" folder in the data directory and placing onlyoffice.crt and onlyoffice.key in it. Add fonts by placing .ttf in the font folder and force updating the container. For more information visit the support thread https://forums.Unraid.net/topic/85643-support-amjidovu-onlyoffice-community-server/",
  "paths": [
    {
      "name": "Mounted folder for logs",
      "host": "/mnt/cache/appdata/onlyoffice/DocumentServer/logs",
      "container": "/var/log/onlyoffice",
      "mode": "rw",
      "description": "Container Path: /var/log/onlyoffice",
      "required": false
    },
    {
      "name": "Mounted folder for data files ( SSL certificates can be added in the /cert subfolder )",
      "host": "/mnt/cache/appdata/onlyoffice/DocumentServer/data",
      "container": "/var/www/onlyoffice/Data",
      "mode": "rw",
      "description": "Container Path: /var/www/onlyoffice/Data",
      "required": false
    },
    {
      "name": "Mounted folder for file cache",
      "host": "/mnt/cache/appdata/onlyoffice/DocumentServer/lib",
      "container": "/var/lib/onlyoffice",
      "mode": "rw",
      "description": "Container Path: /var/lib/onlyoffice",
      "required": false
    },
    {
      "name": "Mounted folder for database",
      "host": "/mnt/cache/appdata/onlyoffice/DocumentServer/db",
      "container": "/var/lib/postgresql",
      "mode": "rw",
      "description": "Container Path: /var/lib/postgresql",
      "required": false
    },
    {
      "name": "Mounted folder where you can add your custom fonts",
      "host": "/mnt/cache/appdata/onlyoffice/DocumentServer/fonts",
      "container": "/usr/share/fonts/truetype/custom",
      "mode": "rw",
      "description": "Container Path: /usr/share/fonts/truetype/custom",
      "required": false
    },
    {
      "name": "Mounted folder for unsaved files",
      "host": "/mnt/cache/appdata/onlyoffice/DocumentServer/forgotten",
      "container": "/var/lib/onlyoffice/documentserver/App_Data/cache/files/forgotten",
      "mode": "rw",
      "description": "Container Path: /var/lib/onlyoffice/documentserver/App_Data/cache/files/forgotten",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8082",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "4432",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
