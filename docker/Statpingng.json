{
  "name": "Statping-ng",
  "repo": "adamboutcher/statping-ng",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/adamboutcher/statping-ng",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/statping.png",
  "project": "https://github.com/statping-ng/statping-ng",
  "description": "Statping-ng aims to be an updated drop-in replacement of statping after development stopped on the original fork. An easy to use Status Page for your websites and applications. Statping will automatically fetch the application and render a beautiful status page with tons of features for you to build an even better status page.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/statping-ng",
      "container": "/app",
      "mode": "rw",
      "description": "Container Path: /app",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web",
      "host": "8366",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
