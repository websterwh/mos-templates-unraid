{
  "name": "Sablier",
  "repo": "sablierapp/sablier:1.15.0",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/sablierapp/sablier",
  "network": "traefik",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:10000]",
  "icon": "https://raw.githubusercontent.com/MikaPST/unraid-community-apps/main/icon-sablier.png",
  "project": "https://github.com/sablierapp/sablier",
  "description": "Sablier is a lightweight Docker-aware middleware that automatically starts and stops containers based on incoming requests. It integrates with reverse proxies such as Traefik and helps reduce resource consumption by stopping unused applications.",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker socket used by Sablier to monitor and control Docker containers.",
      "required": true
    },
    {
      "name": "Sablier Configuration",
      "host": "/mnt/cache/appdata/sablier/sablier.yml",
      "container": "/etc/sablier/sablier.yml",
      "mode": "rw",
      "description": "Path to the Sablier configuration file.",
      "required": true
    },
    {
      "name": "Themes",
      "host": "/mnt/cache/appdata/sablier/themes",
      "container": "/etc/sablier/themes",
      "mode": "rw",
      "description": "Directory containing Sablier themes.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "10000",
      "container": "10000",
      "protocol": "tcp",
      "description": "Sablier HTTP API port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [
    {
      "name": "Traefik Enabled",
      "value": "true",
      "description": "Enable Traefik integration for Sablier."
    },
    {
      "name": "Traefik Service Port",
      "value": "10000",
      "description": "Internal Sablier HTTP port used by Traefik."
    }
  ]
}
