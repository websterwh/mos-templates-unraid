{
  "name": "GLauth",
  "repo": "glauth/glauth",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/repository/docker/glauth/glauth",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5555]",
  "icon": "https://raw.githubusercontent.com/glauth/glauth.github.io/master/assets/logo.png",
  "project": "https://glauth.github.io",
  "description": "GLAuth is a secure, easy-to-use, LDAP server with configurable backends.",
  "paths": [
    {
      "name": "Configuration Path",
      "host": "/mnt/cache/appdata/glauth/config/",
      "container": "/app/config",
      "mode": "rw",
      "description": "Configuration and Local Database (if configured) Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "LDAP Port",
      "host": "389",
      "container": "389",
      "protocol": "tcp",
      "description": "Container LDAP Port",
      "required": false,
      "mask": false
    },
    {
      "name": "LDAPS Port",
      "host": "636",
      "container": "636",
      "protocol": "tcp",
      "description": "Container LDAPS Port",
      "required": false,
      "mask": false
    },
    {
      "name": "Management Port",
      "host": "5555",
      "container": "5555",
      "protocol": "tcp",
      "description": "Container Management Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
