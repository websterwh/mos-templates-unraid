{
  "name": "Koillection",
  "repo": "koillection/koillection",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/koillection/koillection/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/koillection.png",
  "project": "https://github.com/koillection/koillection",
  "description": "Collection manager to keep track of collections of any kind like games, books, DVDs, stamps, etc... As Koillection is meant to be used for any kind of collections, it doesn't support automatic download of metadata, but offer the possibility to add your own metadata freely.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/koillection/conf",
      "container": "/conf",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Upload Path",
      "host": "/mnt/cache/appdata/koillection/uploads",
      "container": "/uploads",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "8737",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PHP Timzeone",
      "key": "PHP_TZ",
      "value": "America/Detroit",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Database Driver",
      "key": "DB_DRIVER",
      "value": "pdo_pgsql",
      "description": "pdo_pgsql (or pdo_mysql) - Note that MariaDB is NOT supported!",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Host",
      "key": "DB_HOST",
      "value": "10.0.0.10",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "DB_NAME",
      "value": "koillection",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "DB_PORT",
      "value": "5432",
      "description": "5432 for PgSQL or 3306 for MySQL by default.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "DB_USER",
      "value": "koillection",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "DB_PASSWORD",
      "value": "password",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "Database Version",
      "key": "DB_VERSION",
      "value": "14.4",
      "description": "The version of the database you are running, e.g. 14.4 for PostgreSQL",
      "required": false,
      "mask": false
    },
    {
      "name": "Debug",
      "key": "APP_DEBUG",
      "value": "0",
      "description": "0=false 1=true",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
