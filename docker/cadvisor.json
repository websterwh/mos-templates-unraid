{
  "name": "cadvisor",
  "repo": "gcr.io/cadvisor/cadvisor",
  "category": [
    "System"
  ],
  "registry": "https://gcr.io/cadvisor/cadvisor",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/cadvisor.png",
  "project": "https://github.com/google/cadvisor",
  "description": "cAdvisor (Container Advisor) provides container users an understanding of the resource usage and performance characteristics of their running containers. It is a running daemon that collects, aggregates, processes, and exports information about running containers. Specifically, for each container it keeps resource isolation parameters, historical resource usage, histograms of complete historical resource usage and network statistics. This data is exported by container and machine-wide.",
  "paths": [
    {
      "name": "Root Filesystem",
      "host": "/",
      "container": "/rootfs",
      "mode": "ro",
      "description": "Container Path: /rootfs",
      "required": true
    },
    {
      "name": "Runtime Variable Data",
      "host": "/var/run",
      "container": "/var/run",
      "mode": "ro",
      "description": "Container Path: /var/run",
      "required": true
    },
    {
      "name": "Sys Filesystem",
      "host": "/sys",
      "container": "/sys",
      "mode": "ro",
      "description": "Container Path: /sys",
      "required": true
    },
    {
      "name": "Docker Storage Filesystem",
      "host": "/var/lib/docker",
      "container": "/var/lib/docker/",
      "mode": "ro",
      "description": "Container Path: /var/lib/docker/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
