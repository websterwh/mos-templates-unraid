{
  "name": "thingsboard-postgres",
  "repo": "thingsboard/tb-postgres",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/thingsboard/tb-postgres/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9090]",
  "icon": "https://github.com/kilrah/unraid-docker-templates/raw/main/icons/thingsboard-postgres.png",
  "project": "https://thingsboard.io",
  "description": "ThingsBoard is an open-source IoT platform for data collection, processing, visualization, and device management. Default Creds: System Administrator: sysadmin@thingsboard.org / sysadmin Tenant Administrator: tenant@thingsboard.org / tenant Customer User: customer@thingsboard.org / customer Initial setup: Run the container once so it creates the directories, it won't start due to permission issues, stop it Run \"chown -R 799:799 /mnt/user/appdata/thingsboard-postgres\" (adapt as appropriate if you changed defaults) in Unraid terminal Start container again, it should now be good after a couple of minutes needed for initial setup.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/thingsboard-postgres/data",
      "container": "/data",
      "mode": "rw",
      "description": "Data location",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/thingsboard-postgres/logs",
      "container": "/var/log/thingsboard",
      "mode": "rw",
      "description": "Logs location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Web UI Port",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT Port",
      "host": "1883",
      "container": "1883",
      "protocol": "tcp",
      "description": "MQTT Port",
      "required": true,
      "mask": false
    },
    {
      "name": "RPC Port",
      "host": "7070",
      "container": "7070",
      "protocol": "tcp",
      "description": "Edge RPC Port",
      "required": true,
      "mask": false
    },
    {
      "name": "COAP Ports",
      "host": "5683-5688",
      "container": "5683-5688",
      "protocol": "udp",
      "description": "COAP and LwM2M ports",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
