{
  "name": "Plex-Notifier",
  "repo": "jjermany/plex-notifier:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jjermany/plex-notifier",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/jjermany/plex-notifier/main/media/logo.png",
  "project": "https://github.com/jjermany/plex-notifier",
  "description": "Plex Notifier periodically checks for new Plex episodes and sends user-specific email alerts based on their watch history, powered by Tautulli. \u2705 Supports per-user unsubscribe links (global and per-show) \ud83d\udd10 Protects the settings WebUI with optional HTTP Basic Auth \ud83d\udce7 All configuration (Plex, Tautulli, SMTP) is done in the Web UI",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/plex-notifier",
      "container": "/app/instance",
      "mode": "rw",
      "description": "Stores user config and internal database",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container listens on port 5000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Chicago",
      "description": "Container timezone",
      "required": false,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Required. Generate with: openssl rand -hex 32",
      "required": true,
      "mask": true
    },
    {
      "name": "WEBUI_USER",
      "key": "WEBUI_USER",
      "value": "",
      "description": "Optional username for HTTP Basic Auth protecting the WebUI",
      "required": false,
      "mask": false
    },
    {
      "name": "WEBUI_PASS",
      "key": "WEBUI_PASS",
      "value": "",
      "description": "Optional password for HTTP Basic Auth protecting the WebUI",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
