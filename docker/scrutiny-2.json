{
  "name": "scrutiny",
  "repo": "lscr.io/linuxserver/scrutiny",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/scrutiny",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=SYS_RAWIO",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/scrutiny-logo.png",
  "project": "https://github.com/AnalogJ/scrutiny",
  "description": "Scrutiny(https://github.com/AnalogJ/scrutiny) WebUI for smartd S.M.A.R.T monitoring. Scrutiny is a Hard Drive Health Dashboard and Monitoring solution, merging manufacturer provided S.M.A.R.T metrics with real-world failure rates from Backblaze.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Where config is stored.",
      "required": true
    },
    {
      "name": "Path: /run/udev",
      "host": "",
      "container": "/run/udev",
      "mode": "ro",
      "description": "Provides necessary metadata to Scrutiny.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port for scrutiny's web interface and API.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SCRUTINY_API_ENDPOINT",
      "key": "SCRUTINY_API_ENDPOINT",
      "value": "http://localhost:8080",
      "description": "# optional - API endpoint of the scrutiny UI. Do not change unless using as a remote collector",
      "required": true,
      "mask": false
    },
    {
      "name": "SCRUTINY_WEB",
      "key": "SCRUTINY_WEB",
      "value": "true",
      "description": "# optional - Run the web service.",
      "required": true,
      "mask": false
    },
    {
      "name": "SCRUTINY_COLLECTOR",
      "key": "SCRUTINY_COLLECTOR",
      "value": "true",
      "description": "# optional - Run the metrics collector.",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "/dev/sda",
      "host": "/dev/sda",
      "container": "",
      "description": "This is how Scrutiny accesses drives. Optionally supply `/dev:/dev` instead for all devices.",
      "required": true
    },
    {
      "name": "/dev/sdb",
      "host": "/dev/sdb",
      "container": "",
      "description": "A second drive.",
      "required": true
    },
    {
      "name": "/dev/nvme1n1",
      "host": "/dev/nvme1n1",
      "container": "",
      "description": "An NVMe drive. NVMe requires `--cap-add=SYS_ADMIN`.",
      "required": true
    }
  ],
  "labels": []
}
