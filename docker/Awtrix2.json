{
  "name": "Awtrix2",
  "repo": "whyet/awtrix2",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/whyet/awtrix2",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7000]",
  "icon": "https://avatars.githubusercontent.com/u/38006982?s=200&v=4",
  "project": "https://awtrixdocs.blueforcer.de/",
  "description": "Docker Container for Awtrix2 Host in collaboration with Blueforcer. The Container is based on the anapsix/alpine-java:8_JDK image. It has an autoupdate feature witch will get the latest Host from the Awtrix Site on a restart from the Container.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/awtrix2",
      "container": "/data",
      "mode": "rw",
      "description": "Config Path Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Controller Port",
      "host": "7000",
      "container": "7000",
      "protocol": "tcp",
      "description": "Web Controller Port",
      "required": true,
      "mask": false
    },
    {
      "name": "API Port",
      "host": "7001",
      "container": "7001",
      "protocol": "tcp",
      "description": "API Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port 3",
      "host": "5568",
      "container": "5568",
      "protocol": "udp",
      "description": "Container Port: 5568",
      "required": true,
      "mask": false
    },
    {
      "name": "Amazon Alexa Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "For Amazon Alexa Support you need this Port. If This Port is already used this can be changed in the config file.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "Asia/Shanghai",
      "description": "Container Variable: TZ",
      "required": true,
      "mask": false
    },
    {
      "name": "Language",
      "key": "JAVA_TOOL_OPTIONS",
      "value": "-Duser.language=en -Duser.country=US",
      "description": "If you want AWTRIX to automatically display some apps like DayOfTheWeek in your local language/format (e.g.",
      "required": true,
      "mask": false
    },
    {
      "name": "Auto Update",
      "key": "AUTOUPDATE",
      "value": "true",
      "description": "Container Variable: AUTOUPDATE",
      "required": true,
      "mask": false
    },
    {
      "name": "Beta Version",
      "key": "AWTRIX_BETA",
      "value": "true",
      "description": "Container Variable: AWTRIX_BETA",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
