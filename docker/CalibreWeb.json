{
  "name": "CalibreWeb",
  "repo": "technosoft2000/calibre-web",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/technosoft2000/calibre-web/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8083]",
  "icon": "https://raw.githubusercontent.com/fanningert/unraid-docker-templates/master/fanningert/icons/calibreweb.png",
  "project": null,
  "description": "Calibre Web is a web app providing a clean interface for browsing, reading and downloading eBooks using an bexisting Calibre database/b.",
  "paths": [
    {
      "name": "Calibre library path",
      "host": "",
      "container": "/books",
      "mode": "rw",
      "description": "Container Path: /books",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebFrontend",
      "host": "8083",
      "container": "8083",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "GroupID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UserID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "SET_CONTAINER_TIMEZONE",
      "key": "SET_CONTAINER_TIMEZONE",
      "value": "true",
      "description": "Container Variable: SET_CONTAINER_TIMEZONE",
      "required": true,
      "mask": false
    },
    {
      "name": "CONTAINER_TIMEZONE",
      "key": "CONTAINER_TIMEZONE",
      "value": "UTC",
      "description": "The possible container timezones can be found under the directory /usr/share/zoneinfo/. UTC, Europe/Berlin, Europe/Vienna , ...",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
