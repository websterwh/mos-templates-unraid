{
  "name": "telegram-slskd-local-bot",
  "repo": "drumsergio/telegram-slskd-local-bot:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/drumsergio/telegram-slskd-local-bot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/GeiserX/docker-templates/master/drumsergio/images/telegram-slskd-local-bot.png",
  "project": "https://github.com/GeiserX/telegram-slskd-local-bot",
  "description": "Telegram bot for automated music discovery and downloading. Resolves track metadata from Spotify, searches Soulseek (via slskd) for FLAC files, and places them in your music library with proper naming. Includes a scoring algorithm for quality selection. Requires: slskd instance, Spotify API credentials, and a Telegram bot token. More info: https://github.com/GeiserX/telegram-slskd-local-bot",
  "paths": [
    {
      "name": "Downloads",
      "host": "/mnt/cache/Multimedia/Music/Downloads",
      "container": "/downloads",
      "mode": "ro",
      "description": "slskd completed downloads directory (read-only)",
      "required": true
    },
    {
      "name": "Music Output",
      "host": "/mnt/cache/Multimedia/Music/FLAC",
      "container": "/music",
      "mode": "rw",
      "description": "Output directory for renamed FLAC files",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Bot Token",
      "key": "TELEGRAM_BOT_TOKEN",
      "value": "",
      "description": "Telegram bot token from @BotFather",
      "required": true,
      "mask": true
    },
    {
      "name": "Spotify Client ID",
      "key": "SPOTIFY_CLIENT_ID",
      "value": "",
      "description": "Spotify Developer API client ID",
      "required": true,
      "mask": false
    },
    {
      "name": "Spotify Client Secret",
      "key": "SPOTIFY_CLIENT_SECRET",
      "value": "",
      "description": "Spotify Developer API client secret",
      "required": true,
      "mask": true
    },
    {
      "name": "slskd Host",
      "key": "SLSKD_HOST",
      "value": "http://slskd:5030",
      "description": "URL of your slskd instance",
      "required": true,
      "mask": false
    },
    {
      "name": "slskd API Key",
      "key": "SLSKD_API_KEY",
      "value": "",
      "description": "slskd API key",
      "required": true,
      "mask": true
    },
    {
      "name": "Allowed Users",
      "key": "TELEGRAM_ALLOWED_USERS",
      "value": "",
      "description": "Comma-separated Telegram user IDs (empty = open)",
      "required": false,
      "mask": false
    },
    {
      "name": "Auto Mode",
      "key": "AUTO_MODE",
      "value": "false",
      "description": "Automatically download best match without confirmation",
      "required": false,
      "mask": false
    },
    {
      "name": "Max Results",
      "key": "MAX_RESULTS",
      "value": "5",
      "description": "Number of search results to display",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
