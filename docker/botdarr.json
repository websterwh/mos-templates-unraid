{
  "name": "botdarr",
  "repo": "shayaantx/botdarr",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/shayaantx/botdarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/qubex22/unraid-templates/main/botdarr/icon.png",
  "project": "https://github.com/shayaantx/botdarr",
  "description": "Botdarr is a simple multi chat-client bot to access radarr, sonarr, and lidarr. Now supporting Discord, Telegram, Matrix, Slack. The default template is for use with telegram, however in the project github there are the variables for the other chat-clients.",
  "paths": [
    {
      "name": "logs",
      "host": "",
      "container": "/home/botdarr/logs",
      "mode": "rw",
      "description": "Container Path: /home/botdarr/logs",
      "required": false
    },
    {
      "name": "database",
      "host": "",
      "container": "/home/botdarr/database",
      "mode": "rw",
      "description": "Container Path: /home/botdarr/database",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TELEGRAM_TOKEN",
      "key": "TELEGRAM_TOKEN",
      "value": "",
      "description": "Token generated by BotFather Required for telegram",
      "required": false,
      "mask": false
    },
    {
      "name": "RADARR_URL",
      "key": "RADARR_URL",
      "value": "",
      "description": "required for radarr",
      "required": false,
      "mask": false
    },
    {
      "name": "RADARR_TOKEN",
      "key": "RADARR_TOKEN",
      "value": "",
      "description": "required for radarr",
      "required": false,
      "mask": false
    },
    {
      "name": "RADARR_DEFAULT_PROFILE",
      "key": "RADARR_DEFAULT_PROFILE",
      "value": "HD-1080p",
      "description": "Quality profile for radarr",
      "required": false,
      "mask": false
    },
    {
      "name": "RADARR_PATH",
      "key": "RADARR_PATH",
      "value": "/media",
      "description": "media path in radarr",
      "required": false,
      "mask": false
    },
    {
      "name": "COMMAND_PREFIX",
      "key": "COMMAND_PREFIX",
      "value": "!",
      "description": "Prefix for commands. Default is !",
      "required": false,
      "mask": false
    },
    {
      "name": "TELEGRAM_PRIVATE_CHANNELS",
      "key": "TELEGRAM_PRIVATE_CHANNELS",
      "value": "",
      "description": "name:id Required for telegram",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
