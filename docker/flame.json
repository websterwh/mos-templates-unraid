{
  "name": "flame",
  "repo": "pawelmalak/flame",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/pawelmalak/flame",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--init",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5005]",
  "icon": "https://raw.githubusercontent.com/pawelmalak/unraid-templates/master/templates/icons/flame.png",
  "project": "https://github.com/pawelmalak/flame",
  "description": "Flame is self-hosted startpage for your server. Easily manage your apps and bookmarks with built-in editors.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/flame",
      "container": "/app/data",
      "mode": "rw",
      "description": "Container Path: /app/data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "5030",
      "container": "5005",
      "protocol": "tcp",
      "description": "Container Port: 5005",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "User password",
      "key": "PASSWORD",
      "value": "flame_password",
      "description": "Container Variable: PASSWORD",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
