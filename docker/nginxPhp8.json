{
  "name": "nginx-Php8",
  "repo": "tangramor/nginx-php8-fpm",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/tangramor/nginx-php8-fpm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/nginx-logo.png",
  "project": "https://nginx.org/",
  "description": "Nginx(https://nginx.org/) is a simple webserver with php support. The config is in the docker side go in the console. `cd /etc/nginx`",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/nginxphp8/www",
      "container": "/var/www/html/",
      "mode": "rw",
      "description": "Contains your www content and all relevant",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "http",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 443",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "https",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
