{
  "name": "mqttwarn",
  "repo": "ghcr.io/mqtt-tools/mqttwarn-full:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/mqtt-tools/mqttwarn-full",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://mqttwarn.readthedocs.io/en/latest/_static/mqttwarn-logo.png",
  "project": "https://github.com/mqtt-tools/mqttwarn",
  "description": "Subscribe to MQTT topics and notify pluggable services.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/mqttwarn/config",
      "container": "/etc/mqttwarn",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    },
    {
      "name": "Localtime path",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "Localtime path",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Internal INI Path",
      "key": "MQTTWARNINI",
      "value": "/etc/mqttwarn/mqttwarn.ini",
      "description": "Internal path to the INI file. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
