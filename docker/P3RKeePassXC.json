{
  "name": "P3R-KeePassXC",
  "repo": "p3rco/keepassxc:latest",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/repository/docker/p3rco/keepassxc",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5800]/",
  "icon": "https://raw.githubusercontent.com/P3R-CO/unraid/master/KeePassXC-P3R-256px.png",
  "project": "https://github.com/P3R-CO/keepassxc-container",
  "description": "KeePassXC in a container. Keep your passwords safe! I highly recommend also downloading the KeePassXC browser extension for easy input of passwords on webpages. Save your database in the /config folder for persistence after updates/reboots and backups with your AppData.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/P3R-KeePassXC/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "5800",
      "container": "5800",
      "protocol": "tcp",
      "description": "Container Port: 5800",
      "required": true,
      "mask": false
    },
    {
      "name": "VNC Port",
      "host": "5900",
      "container": "5900",
      "protocol": "tcp",
      "description": "Container Port: 5900",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VNC Password",
      "key": "VNC_PASSWORD",
      "value": "",
      "description": "Set New VNC Password",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
