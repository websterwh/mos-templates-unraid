{
  "name": "Teedy-docs",
  "repo": "sismics/docs:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/sismics/docs/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/sismics/docs/master/docs-web/src/main/resources/image/logo.png",
  "project": "https://github.com/sismics/docs",
  "description": "Teedy is an open-source, lightweight document management system (DMS) for individuals and businesses. The default admin password is \"admin\". Don't forget to change it before going to production.",
  "paths": [
    {
      "name": "Data Storage",
      "host": "/mnt/cache/appdata/Teedy",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DOCS_BASE_URL",
      "key": "DOCS_BASE_URL",
      "value": "",
      "description": "For using an external URL, for example https://teedy.mycompany.com",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
