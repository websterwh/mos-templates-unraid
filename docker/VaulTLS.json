{
  "name": "VaulTLS",
  "repo": "ghcr.io/7ritn/vaultls:latest",
  "category": [
    "Security"
  ],
  "registry": "https://github.com/7ritn/VaulTLS/pkgs/container/vaultls",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/vaultls.png",
  "project": "https://github.com/7ritn/VaulTLS",
  "description": "Selfhostable web app to manage mTLS certificates: create, distribute and track expirations, with optional OIDC login and ACME CA support (Traefik, acme.sh). Recommended to run behind a reverse proxy for TLS termination.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/vaultls",
      "container": "/app/data",
      "mode": "rw",
      "description": "Contains database, CA certificate and CRLs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "5173",
      "container": "80",
      "protocol": "tcp",
      "description": "Port for the web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VAULTLS_API_SECRET",
      "key": "VAULTLS_API_SECRET",
      "value": "",
      "description": "Required. Generate with: openssl rand -base64 32",
      "required": true,
      "mask": true
    },
    {
      "name": "VAULTLS_URL",
      "key": "VAULTLS_URL",
      "value": "https://vaultls.example.com/",
      "description": "Public URL of this VaulTLS instance",
      "required": false,
      "mask": false
    },
    {
      "name": "VAULTLS_INSECURE",
      "key": "VAULTLS_INSECURE",
      "value": "false",
      "description": "Set to 'true' if you want to access without HTTPS (not recommended)",
      "required": false,
      "mask": false
    },
    {
      "name": "VAULTLS_DB_SECRET",
      "key": "VAULTLS_DB_SECRET",
      "value": "",
      "description": "Optional: encrypts the database. Note: this is irreversible. Remove if not needed to prevent startup errors",
      "required": false,
      "mask": true
    },
    {
      "name": "VAULTLS_LOG_LEVEL",
      "key": "VAULTLS_LOG_LEVEL",
      "value": "info",
      "description": "Log level: error, warn, info, debug, trace",
      "required": false,
      "mask": false
    },
    {
      "name": "VAULTLS_OIDC_AUTH_URL",
      "key": "VAULTLS_OIDC_AUTH_URL",
      "value": "",
      "description": "OIDC: base URL of your auth provider",
      "required": false,
      "mask": false
    },
    {
      "name": "VAULTLS_OIDC_CALLBACK_URL",
      "key": "VAULTLS_OIDC_CALLBACK_URL",
      "value": "",
      "description": "OIDC: callback URL, e.g. https://vaultls.example.com/api/auth/oidc/callback",
      "required": false,
      "mask": false
    },
    {
      "name": "VAULTLS_OIDC_ID",
      "key": "VAULTLS_OIDC_ID",
      "value": "",
      "description": "OIDC: client ID",
      "required": false,
      "mask": false
    },
    {
      "name": "VAULTLS_OIDC_SECRET",
      "key": "VAULTLS_OIDC_SECRET",
      "value": "",
      "description": "OIDC: client secret",
      "required": false,
      "mask": true
    },
    {
      "name": "VAULTLS_ACME_ENABLED",
      "key": "VAULTLS_ACME_ENABLED",
      "value": "false",
      "description": "Set to 'true' to use VaulTLS as an ACME CA (e.g. for Traefik/acme.sh)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
