{
  "name": "snippet-box",
  "repo": "pawelmalak/snippet-box",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/pawelmalak/snippet-box",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--init",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/pawelmalak/unraid-templates/master/templates/icons/snippet-box.png",
  "project": "https://github.com/pawelmalak/snippet-box",
  "description": "Snippet Box is a simple self-hosted app for organizing your code snippets. It allows you to easily create, edit, browse and manage your snippets in various languages.",
  "paths": [
    {
      "name": "Application Data",
      "host": "/mnt/cache/appdata/snippet-box/",
      "container": "/app/data",
      "mode": "rw",
      "description": "Container Path: /app/data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Application Port",
      "host": "5039",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
