{
  "name": "joplin-server",
  "repo": "joplin/server:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/joplin/server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:22300]",
  "icon": "https://raw.githubusercontent.com/bigsing/unraid-templates/refs/heads/main/images/joplin-logo.png",
  "project": "https://joplinapp.org/",
  "description": "Official Joplin Server Docker Image",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "22300",
      "container": "22300",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_PORT",
      "key": "APP_PORT",
      "value": "22300",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    },
    {
      "name": "APP_BASE_URL",
      "key": "APP_BASE_URL",
      "value": "http://[IP]:22300",
      "description": "Application Base URL",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_CLIENT",
      "key": "DB_CLIENT",
      "value": "pg",
      "description": "Database Client - pg = postgres",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_HOST",
      "key": "POSTGRES_HOST",
      "value": "[IP]",
      "description": "Database Host",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_DATABASE",
      "key": "POSTGRES_DATABASE",
      "value": "joplindb",
      "description": "Database Name",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_PORT",
      "key": "POSTGRES_PORT",
      "value": "5432",
      "description": "Database Port",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "joplin",
      "description": "Database Name",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "Database Password",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
