{
  "name": "Dockwatch",
  "repo": "ghcr.io/notifiarr/dockwatch:main",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/notifiarr/dockwatch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dockwatch-icon.png",
  "project": "https://dockwatch.wiki/",
  "description": "Simple UI driven way to manage updates and notifications for Docker containers.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/dockwatch/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9999",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
