{
  "name": "Convert-Commander",
  "repo": "benzauber/convert-commander:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/benzauber/convert-commander",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/convert-commander-icon.png",
  "project": "https://cc.bleibundgut.ch/",
  "description": "With Convert-Commander, you can convert files directly on your locally hosted server without uploading sensitive data to external servers.",
  "paths": [
    {
      "name": "Uploads Path",
      "host": "/mnt/cache/appdata/convert_commander/uploads",
      "container": "/app/uploads",
      "mode": "rw",
      "description": "Path to uploaded files. Remove to make ephemeral",
      "required": true
    },
    {
      "name": "Converts Path",
      "host": "/mnt/cache/appdata/convert_commander/converts",
      "container": "/app/convert",
      "mode": "rw",
      "description": "Path to converted files. Remove to make ephemeral",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9595",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Keep Logs",
      "key": "PYTHONUNBUFFERED",
      "value": "1",
      "description": "Keep logs in real-time. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
