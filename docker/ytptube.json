{
  "name": "ytptube",
  "repo": "ghcr.io/arabcoders/ytptube",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/arabcoders/ytptube/pkgs/container/ytptube",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8081]",
  "icon": "https://raw.githubusercontent.com/arabcoders/unraid-templates/master/arabcoders/images/ytptube.png",
  "project": "https://github.com/arabcoders/ytptube",
  "description": "A Web GUI for yt-dlp",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/ytptube/config",
      "container": "/config",
      "mode": "rw",
      "description": "All application data will be stored in this path",
      "required": true
    },
    {
      "name": "Downloads Path",
      "host": "/mnt/cache/appdata/ytptube/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "This directory will be used as base for downloads",
      "required": true
    },
    {
      "name": "Temp Path",
      "host": "/mnt/cache/appdata/ytptube/tmp",
      "container": "/tmp",
      "mode": "rw",
      "description": "Temporary files will be stored in this path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebGUI Port",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Exposed port for WebGUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
