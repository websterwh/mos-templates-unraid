{
  "name": "ownCloud",
  "repo": "dlandon/owncloud",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/dlandon/owncloud/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--log-opt max-size=50m --log-opt max-file=1 --sysctl=net.core.somaxconn=511",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:443]/",
  "icon": "https://github.com/dlandon/docker.templates/raw/master/owncloud.png",
  "project": "https://owncloud.org/",
  "description": "OwnCloud provides universal access to your files via the web, your computer or your mobile devices wherever you are. Mariadb is built into the image. Built with php 7.4, mariadb 10.6 and nginx 1.18. Configuration: **/config** - Where ownCloud should store its config files. **/data** - Where ownCloud should store its data files. **Note:** Set Network to br0 and assign a static IP address.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/ownCloud/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/ownCloud",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8443",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MySQL Password",
      "key": "DB_PASS",
      "value": "owncloud",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Auto OS Updates",
      "key": "AUTO_OS_UPDATES",
      "value": "1",
      "description": "When set to 1, OS and Package updates will be done on every restart.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
