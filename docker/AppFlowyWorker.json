{
  "name": "AppFlowy-Worker",
  "repo": "appflowyinc/appflowy_worker:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/appflowyinc/appflowy_worker",
  "network": "custom:appflowy",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://avatars.githubusercontent.com/u/81710027?s=200&v=4",
  "project": "https://github.com/vmalinics0/unraid-appflowy",
  "description": "Step 6/7: AppFlowy Worker \u2014 background job processor handling document imports, exports, and async tasks for AppFlowy Cloud. Part of the AppFlowy Cloud stack.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Database URL",
      "key": "APPFLOWY_WORKER_DATABASE_URL",
      "value": "postgres://postgres:changeme_strong_password@AppFlowy-Postgres:5432/postgres",
      "description": "PostgreSQL connection string. Must match AppFlowy-Cloud.",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "APPFLOWY_WORKER_DATABASE_NAME",
      "value": "postgres",
      "description": "PostgreSQL database name.",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis URL",
      "key": "APPFLOWY_WORKER_REDIS_URL",
      "value": "redis://AppFlowy-Redis:6379",
      "description": "Redis connection URL. Must match AppFlowy-Cloud.",
      "required": true,
      "mask": false
    },
    {
      "name": "Use MinIO",
      "key": "APPFLOWY_S3_USE_MINIO",
      "value": "true",
      "description": "Set true to use MinIO. Must match AppFlowy-Cloud.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Access Key",
      "key": "APPFLOWY_S3_ACCESS_KEY",
      "value": "minioadmin",
      "description": "S3/MinIO access key. Must match AppFlowy-MinIO.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Secret Key",
      "key": "APPFLOWY_S3_SECRET_KEY",
      "value": "changeme_minio_secret",
      "description": "S3/MinIO secret key. Must match AppFlowy-MinIO.",
      "required": true,
      "mask": true
    },
    {
      "name": "S3 Bucket",
      "key": "APPFLOWY_S3_BUCKET",
      "value": "appflowy",
      "description": "S3/MinIO bucket name. Must match AppFlowy-Cloud.",
      "required": true,
      "mask": false
    },
    {
      "name": "MinIO URL (internal)",
      "key": "APPFLOWY_S3_MINIO_URL",
      "value": "http://AppFlowy-MinIO:9000",
      "description": "Internal MinIO API URL.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Region",
      "key": "APPFLOWY_S3_REGION",
      "value": "",
      "description": "AWS S3 region. Leave empty when using MinIO.",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Host",
      "key": "APPFLOWY_MAILER_SMTP_HOST",
      "value": "",
      "description": "SMTP host for worker outgoing mail.",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Port",
      "key": "APPFLOWY_MAILER_SMTP_PORT",
      "value": "465",
      "description": "SMTP port.",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Username",
      "key": "APPFLOWY_MAILER_SMTP_USERNAME",
      "value": "",
      "description": "SMTP username.",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Email",
      "key": "APPFLOWY_MAILER_SMTP_EMAIL",
      "value": "",
      "description": "Sender email address.",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Password",
      "key": "APPFLOWY_MAILER_SMTP_PASSWORD",
      "value": "",
      "description": "SMTP password.",
      "required": false,
      "mask": true
    },
    {
      "name": "SMTP TLS Kind",
      "key": "APPFLOWY_MAILER_SMTP_TLS_KIND",
      "value": "wrapper",
      "description": "TLS mode: wrapper, required, opportunistic, or none.",
      "required": false,
      "mask": false
    },
    {
      "name": "Import Tick Interval (s)",
      "key": "APPFLOWY_WORKER_IMPORT_TICK_INTERVAL",
      "value": "30",
      "description": "How often (seconds) the worker polls the import queue.",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "RUST_LOG",
      "value": "info",
      "description": "Rust log level.",
      "required": false,
      "mask": false
    },
    {
      "name": "Environment",
      "key": "APPFLOWY_WORKER_ENVIRONMENT",
      "value": "production",
      "description": "Worker environment. Keep as production.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
