{
  "name": "Crypt-Dashboard",
  "repo": "ghcr.io/dj3vil/crypt-dashboard:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/DJ3vil/crypt-dashboard/pkgs/container/crypt-dashboard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/DJ3vil/unraid-templates/master/icons/crypt-dashboard.png",
  "project": "https://github.com/DJ3vil/crypt-dashboard",
  "description": "A sleek Docker management dashboard with real-time container monitoring, start/stop controls, compact mode, and 13 themes. Auto-discovers containers via Docker labels (homepage.*).",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Required: Docker socket for container management",
      "required": true
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/crypt-dashboard",
      "container": "/appdata",
      "mode": "rw",
      "description": "Persistent storage for settings",
      "required": true
    },
    {
      "name": "Host Proc",
      "host": "/proc",
      "container": "/host/proc",
      "mode": "ro",
      "description": "Mount /proc for CPU and RAM monitoring",
      "required": false
    },
    {
      "name": "Host Sys",
      "host": "/sys",
      "container": "/host/sys",
      "mode": "ro",
      "description": "Mount /sys for temperature and disk monitoring",
      "required": false
    },
    {
      "name": "NPM Database",
      "host": "",
      "container": "/data/npm.sqlite",
      "mode": "ro",
      "description": "Optional: Nginx Proxy Manager database for auto-detecting proxy URLs",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3080",
      "container": "3000",
      "protocol": "tcp",
      "description": "Dashboard web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Timezone",
      "required": false,
      "mask": false
    },
    {
      "name": "Server IP",
      "key": "SERVER_IP",
      "value": "",
      "description": "Optional: Your server IP for generating WebUI links",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_PROC",
      "key": "HOST_PROC",
      "value": "/host/proc",
      "description": "Internal path for proc mount",
      "required": false,
      "mask": false
    },
    {
      "name": "HOST_SYS",
      "key": "HOST_SYS",
      "value": "/host/sys",
      "description": "Internal path for sys mount",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
