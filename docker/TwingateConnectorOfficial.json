{
  "name": "Twingate-Connector-Official",
  "repo": "twingate/connector:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/twingate/connector",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://auth.twingate.com/signin",
  "icon": "https://www.twingate.com/assets/logo_dark.png",
  "project": "https://www.twingate.com/",
  "description": "A lightweight, outbound-only service that securely connects your private resources to Twingate's network without exposing any inbound ports to the internet.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Access Token",
      "key": "TWINGATE_ACCESS_TOKEN",
      "value": "",
      "description": "General access token used for authenticating connector",
      "required": true,
      "mask": true
    },
    {
      "name": "Refresh Token",
      "key": "TWINGATE_REFRESH_TOKEN",
      "value": "",
      "description": "Refresh token used to keep the connector authenticated.",
      "required": true,
      "mask": true
    },
    {
      "name": "Remote Network Name",
      "key": "TWINGATE_NETWORK",
      "value": "",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "TWINGATE_LOG_LEVEL",
      "value": "3",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Deployed By Label",
      "key": "TWINGATE_LABEL_DEPLOYED_BY",
      "value": "unraid",
      "description": "Meta data about deployment technology",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
