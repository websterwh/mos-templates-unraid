{
  "name": "joal",
  "repo": "digrouz/joal:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/digrouz/joal",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1234]",
  "icon": "https://raw.githubusercontent.com/anthonyraymond/joal-desktop/master/resources/icons/1024x1024.png",
  "project": "https://github.com/anthonyraymond/joal",
  "description": "JOAL is an open-source ratio master with a web UI. It is not designed to help or encourage downloading illegal content: you must respect the law of your country. First launch: set your own path prefix and secret token, open http://IP:PORT/PATH_PREFIX/ui/ and enter the same host, port, path prefix and secret token in the UI settings. The path prefix is secret, so the template has no WebUI link: add it in the WebUI field (advanced view) if you want one. Add .torrent files from the UI or drop them in the torrents folder of the Config path.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/joal",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration, clients and torrents",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "1234",
      "container": "1234",
      "protocol": "tcp",
      "description": "WebUI port (must match JOAL_PORT)",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Path prefix",
      "key": "JOAL_SECRET_OBFUSCATION_PATH",
      "value": "",
      "description": "Secret WebUI path, alphanumeric only (http://IP:PORT/PATH_PREFIX/ui/)",
      "required": true,
      "mask": true
    },
    {
      "name": "Secret token",
      "key": "JOAL_SECRET_TOKEN",
      "value": "",
      "description": "WebUI password, choose a long random string",
      "required": true,
      "mask": true
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Paris",
      "description": "Timezone",
      "required": false,
      "mask": false
    },
    {
      "name": "JOAL_PORT",
      "key": "JOAL_PORT",
      "value": "1234",
      "description": "Internal listen port (must match WebUI Port container port)",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "UID",
      "value": "500",
      "description": "User ID (Unraid: 99)",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "GID",
      "value": "500",
      "description": "Group ID (Unraid: 100)",
      "required": true,
      "mask": false
    },
    {
      "name": "AUTOUPGRADE",
      "key": "AUTOUPGRADE",
      "value": "0",
      "description": "Update OS packages at startup (0 or 1)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
