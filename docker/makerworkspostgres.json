{
  "name": "makerworks-postgres",
  "repo": "postgres:15",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/_/postgres",
  "network": "makerworks-net",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://raw.githubusercontent.com/devicons/devicon/master/icons/postgresql/postgresql-original.svg",
  "project": "https://github.com/schartrand77/makerworks-unraid-templates",
  "description": "PostgreSQL 15 database for the MakerWorks suite. Install this before MakerWorks and StockWorks when you want a shared suite database on Unraid.",
  "paths": [
    {
      "name": "Database Storage",
      "host": "/mnt/cache/appdata/makerworks/postgres",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "Persistent PostgreSQL data directory.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "PostgreSQL Port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "Optional host port for PostgreSQL. Keep closed to the internet.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PostgreSQL User",
      "key": "POSTGRES_USER",
      "value": "postgres",
      "description": "Database superuser name.",
      "required": true,
      "mask": false
    },
    {
      "name": "PostgreSQL Password",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "Database password. Generate a strong secret before first start.",
      "required": true,
      "mask": true
    },
    {
      "name": "PostgreSQL Database",
      "key": "POSTGRES_DB",
      "value": "makerworks",
      "description": "Default database name created on first start.",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": "Container timezone.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
