  "project": "https://github.com/esanchezm/prometheus-qbittorrent-exporter",
  "description": "Get metrics from a qBittorrent server and offers them in a prometheus format.",
  "paths": [],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "qBittorrent Port",
      "key": "QBITTORRENT_PORT",
      "value": "",
      "description": "Port of your qBittorrent instance",
      "required": true,
      "mask": false
    },
    {
      "name": "qBittorrent Host",
      "key": "QBITTORRENT_HOST",
      "value": "",
      "description": "Hostname/IP of your qBittorrent instance",
      "required": true,
      "mask": false
    },
    {
      "name": "qBittorrent User",
      "key": "QBITTORRENT_USER",
      "value": "",
      "description": "Username to your qBittorrent instance",
      "required": true,
      "mask": false
    },
    {
      "name": "qBittorrent Password",
      "key": "QBITTORRENT_PASS",
      "value": "",
      "description": "Password to your qBittorrent instance",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
