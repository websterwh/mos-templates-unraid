{
  "name": "prometheus-qbittorrent-exporter",
  "repo": "esanchezm/prometheus-qbittorrent-exporter",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/esanchezm/prometheus-qbittorrent-exporter/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
