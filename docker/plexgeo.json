{
  "name": "plexgeo",
  "repo": "ghcr.io/inch-high/plexgeo:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/Inch-high/plexgeo/pkgs/container/plexgeo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7842]",
  "icon": "https://raw.githubusercontent.com/Inch-high/plexgeo/main/unraid/plexgeo-icon.png",
  "project": "https://github.com/Inch-high/plexgeo",
  "description": "Stream intelligence dashboard for Plex \u2014 live world map, session logs, and anomaly alerts when users stream from unusual locations.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/plexgeo",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "7842",
      "container": "7842",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Plex URL",
      "key": "PLEX_URL",
      "value": "",
      "description": "URL of your Plex server, e.g. http://192.168.1.50:32400",
      "required": true,
      "mask": false
    },
    {
      "name": "Plex Token",
      "key": "PLEX_TOKEN",
      "value": "",
      "description": "Your Plex authentication token (X-Plex-Token)",
      "required": true,
      "mask": false
    },
    {
      "name": "Encryption Key",
      "key": "ENCRYPTION_KEY",
      "value": "",
      "description": "Encryption key for sensitive settings. Generate with: openssl rand -base64 32",
      "required": true,
      "mask": false
    },
    {
      "name": "Poll Interval",
      "key": "POLL_INTERVAL",
      "value": "30",
      "description": "Seconds between Plex polls",
      "required": false,
      "mask": false
    },
    {
      "name": "Outlier Threshold",
      "key": "OUTLIER_THRESHOLD",
      "value": "0.10",
      "description": "A country must account for less than this fraction of sessions to be flagged",
      "required": false,
      "mask": false
    },
    {
      "name": "Outlier Min Sessions",
      "key": "OUTLIER_MIN_SESSIONS",
      "value": "5",
      "description": "Minimum sessions before outlier detection kicks in",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
