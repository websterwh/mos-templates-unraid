{
  "name": "PotatoMesh-Web---AMD64",
  "repo": "ghcr.io/l5yth/potato-mesh-web-linux-amd64:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/l5yth/potato-mesh-web-linux-amd64",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/potatomesh-icon.png",
  "project": "https://potatomesh.net/",
  "description": "A federated, Meshtastic-powered node dashboard for your local community. This is the web container that displays data from ingested Meshtastic nodes.",
  "paths": [
    {
      "name": "Data Storage",
      "host": "/mnt/cache/appdata/potato-mesh-web/data",
      "container": "/app/.local/share/potato-mesh",
      "mode": "rw",
      "description": "Path to store application data.",
      "required": true
    },
    {
      "name": "Config Storage",
      "host": "/mnt/cache/appdata/potato-mesh-web/config",
      "container": "/app/.config/potato-mesh",
      "mode": "rw",
      "description": "Path to store configuration data.",
      "required": true
    },
    {
      "name": "Logs Storage",
      "host": "/mnt/cache/appdata/potato-mesh-web/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Path to store log files.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PotatoMesh Instance",
      "key": "INSTANCE_DOMAIN",
      "value": "",
      "description": "Domain of the PotatoMesh instance to connect to.",
      "required": true,
      "mask": false
    },
    {
      "name": "API Key",
      "key": "API_TOKEN",
      "value": "",
      "description": "API key for authenticating with the PotatoMesh instance.",
      "required": true,
      "mask": true
    },
    {
      "name": "Site Name",
      "key": "SITE_NAME",
      "value": "PotatoMesh",
      "description": "Mesh network name",
      "required": true,
      "mask": false
    },
    {
      "name": "Channel",
      "key": "CHANNEL",
      "value": "#LongFast",
      "description": "Default channel to display on the web interface.",
      "required": true,
      "mask": false
    },
    {
      "name": "Frequency",
      "key": "FREQUENCY",
      "value": "915MHz|868MHz|433MHz",
      "description": "Frequency the mesh is operating on.",
      "required": true,
      "mask": false
    },
    {
      "name": "Map - Center",
      "key": "MAP_CENTER",
      "value": "",
      "description": "Default map center coordinates (latitude,longitude).",
      "required": true,
      "mask": false
    },
    {
      "name": "Map - Zoom",
      "key": "MAP_ZOOM",
      "value": "",
      "description": "Default map zoom level.",
      "required": false,
      "mask": false
    },
    {
      "name": "Max Distance",
      "key": "MAX_DISTANCE",
      "value": "42",
      "description": "Maximum distance (in km) to show nodes from the map center.",
      "required": true,
      "mask": false
    },
    {
      "name": "Contact Link",
      "key": "CONTACT_LINK",
      "value": "#potatomesh:dod.ngo",
      "description": "Community chat link or Matrix room for your community",
      "required": false,
      "mask": false
    },
    {
      "name": "Federation",
      "key": "FEDERATION",
      "value": "1|0",
      "description": "Enable or disable PotatoMesh federation features.",
      "required": true,
      "mask": false
    },
    {
      "name": "Private",
      "key": "PRIVATE",
      "value": "0|1",
      "description": "Hide public mesh messages from unauthenticated visitors (1=hidden, 0=public)",
      "required": true,
      "mask": false
    },
    {
      "name": "Debugging",
      "key": "DEBUG",
      "value": "0|1",
      "description": "Enable or disable debugging.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
