{
  "name": "hermes-agent",
  "repo": "nousresearch/hermes-agent:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/nousresearch/hermes-agent/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1g --user 0:0 --hostname=hermes-agent --restart=unless-stopped",
  "post_parameters": "gateway run",
  "web_ui_url": "http://[IP]:[PORT:9119]",
  "icon": "https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/hermes-agent-logo.png",
  "project": "https://hermes-agent.nousresearch.com/",
  "description": "Hermes Agent is a self-improving AI agent built by Nous Research. Features a built-in learning loop, memory system, and supports multiple messaging platforms (Telegram, Discord, Slack, WhatsApp, Matrix, Email, etc.). Stores all config, memory, sessions, and skills in /opt/data. Access the web dashboard at the same port as the gateway API (default: 9119). For detailed setup instructions, see the official docs: https://hermes-agent.nousresearch.com/docs",
  "paths": [
    {
      "name": "Path: Config",
      "host": "/mnt/cache/appdata/hermes-agent",
      "container": "/opt/data",
      "mode": "rw",
      "description": "Persistent config directory for Hermes (.env, config.yaml, skills, memories, logs).",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port: Web Dashboard",
      "host": "9119",
      "container": "9119",
      "protocol": "tcp",
      "description": "HTTP port for the web dashboard. After setup, configure Hermes to run the dashboard command. See: https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Variable: TZ",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Timezone for scheduling. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List",
      "required": false,
      "mask": false
    },
    {
      "name": "--- API Server ---",
      "key": "--- API Server ---",
      "value": "",
      "description": "Docs: https://hermes-agent.nousresearch.com/docs",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: API_SERVER_ENABLED",
      "key": "API_SERVER_ENABLED",
      "value": "true",
      "description": "Enable the built-in HTTP API server (required for dashboard and integrations).",
      "required": true,
      "mask": false
    },
    {
      "name": "Variable: API_SERVER_HOST",
      "key": "API_SERVER_HOST",
      "value": "0.0.0.0",
      "description": "Host address for the API server (0.0.0.0 for all interfaces).",
      "required": true,
      "mask": false
    },
    {
      "name": "Variable: API_SERVER_PORT",
      "key": "API_SERVER_PORT",
      "value": "8642",
      "description": "Port for the API server.",
      "required": true,
      "mask": false
    },
    {
      "name": "Variable: API_SERVER_KEY",
      "key": "API_SERVER_KEY",
      "value": "",
      "description": "Bearer token for API authentication. Required when binding to non-localhost. Use the same value in Open WebUI. Generate with: openssl rand -hex 32",
      "required": true,
      "mask": true
    },
    {
      "name": "--- Matrix ---",
      "key": "--- Matrix ---",
      "value": "",
      "description": "Docs: https://hermes-agent.nousresearch.com/docs/user-guide/messaging/matrix",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_HOMESERVER",
      "key": "MATRIX_HOMESERVER",
      "value": "https://matrix-client.matrix.org",
      "description": "Matrix homeserver URL.",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_ACCESS_TOKEN",
      "key": "MATRIX_ACCESS_TOKEN",
      "value": "",
      "description": "Matrix access token (recommended). User ID is auto-detected from token.",
      "required": false,
      "mask": true
    },
    {
      "name": "Variable: MATRIX_USER_ID",
      "key": "MATRIX_USER_ID",
      "value": "",
      "description": "Matrix user ID. Not required if MATRIX_ACCESS_TOKEN is set.",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_PASSWORD",
      "key": "MATRIX_PASSWORD",
      "value": "",
      "description": "Matrix password. Not required if MATRIX_ACCESS_TOKEN is set.",
      "required": false,
      "mask": true
    },
    {
      "name": "Variable: MATRIX_RECOVERY_KEY",
      "key": "MATRIX_RECOVERY_KEY",
      "value": "",
      "description": "Matrix recovery key for cross-signing (for E2EE).",
      "required": false,
      "mask": true
    },
    {
      "name": "Variable: MATRIX_DEVICE_ID",
      "key": "MATRIX_DEVICE_ID",
      "value": "HERMES_BOT",
      "description": "Matrix device ID (leave empty for auto-generated).",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_HOME_ROOM",
      "key": "MATRIX_HOME_ROOM",
      "value": "",
      "description": "Matrix room ID for bot's home room (for cron notifications).",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_ALLOWED_USERS",
      "key": "MATRIX_ALLOWED_USERS",
      "value": "",
      "description": "Comma-separated list of allowed Matrix user IDs (empty = deny all except self).",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_ENCRYPTION",
      "key": "MATRIX_ENCRYPTION",
      "value": "true",
      "description": "Enable end-to-end encryption (requires libolm).",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_REQUIRE_MENTION",
      "key": "MATRIX_REQUIRE_MENTION",
      "value": "false",
      "description": "Bot only responds when mentioned in rooms (DMs always respond).",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_REACTIONS",
      "key": "MATRIX_REACTIONS",
      "value": "true",
      "description": "Show emoji reactions during message processing.",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_AUTO_THREAD",
      "key": "MATRIX_AUTO_THREAD",
      "value": "true",
      "description": "Auto-create threads for responses in rooms.",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: MATRIX_FREE_RESPONSE_ROOMS",
      "key": "MATRIX_FREE_RESPONSE_ROOMS",
      "value": "",
      "description": "Comma-separated room IDs that respond without mention.",
      "required": false,
      "mask": false
    },
    {
      "name": "--- Telegram ---",
      "key": "--- Telegram ---",
      "value": "",
      "description": "Docs: https://hermes-agent.nousresearch.com/docs/user-guide/messaging/telegram",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: TELEGRAM_BOT_TOKEN",
