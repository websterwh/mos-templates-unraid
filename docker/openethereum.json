{
  "name": "open-ethereum",
  "repo": "openethereum/openethereum",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/openethereum/openethereum/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--base-path /home/openethereum/.local/share/openethereum/ --config /home/openethereum/.local/share/openethereum/config.toml",
  "web_ui_url": "http://[IP]:[PORT:8545]",
  "icon": "https://openethereum.github.io/images/logo-openethereum.svg",
  "project": "https://github.com/openethereum/openethereum",
  "description": "The fast, light, and robust client for the Ethereum mainnet.",
  "paths": [
    {
      "name": "base-path",
      "host": "/mnt/cache/docker/",
      "container": "/home/openethereum/.local/share/openethereum/",
      "mode": "rw",
      "description": "Persistent data directory for blockchain files, keys",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "JSON-RPC HTTP",
      "host": "8545",
      "container": "8545",
      "protocol": "tcp",
      "description": "JSON-RPC HTTP server supports a number of APIs.",
      "required": true,
      "mask": false
    },
    {
      "name": "Web-Sockets server",
      "host": "8546",
      "container": "8546",
      "protocol": "tcp",
      "description": "Web-Sockets server supports a number of APIs.",
      "required": true,
      "mask": false
    },
    {
      "name": "listener",
      "host": "30303",
      "container": "30303",
      "protocol": "tcp",
      "description": "listener (TCP) port",
      "required": true,
      "mask": false
    },
    {
      "name": "discovery",
      "host": "30303",
      "container": "30303",
      "protocol": "udp",
      "description": "discovery (UDP) port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
