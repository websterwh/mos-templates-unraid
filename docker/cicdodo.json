{
  "name": "cicdodo",
  "repo": "ghcr.io/jordan-dalby/cicdodo:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/jordan-dalby/cicdodo/pkgs/container/cicdodo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/jordan-dalby/CICDodo/refs/heads/main/logo.jpg",
  "project": "https://github.com/jordan-dalby/CICDodo",
  "description": "CICDodo is a Discord bot interface for ARK: Survival Ascended mod creators who want to automatically send messages when new releases are approved",
  "paths": [
    {
      "name": "Releases Directory",
      "host": "/mnt/cache/appdata/cicdodo/releases",
      "container": "/app/releases",
      "mode": "rw",
      "description": "Directory for release files",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Mod IDs",
      "key": "MOD_IDS",
      "value": "123456,789012",
      "description": "Comma-separated list of CurseForge mod IDs to monitor",
      "required": true,
      "mask": false
    },
    {
      "name": "Debug Channel ID",
      "key": "DEBUG_CHANNEL_ID",
      "value": "",
      "description": "Discord channel ID for debug messages",
      "required": true,
      "mask": false
    },
    {
      "name": "Releases Channel IDs",
      "key": "RELEASES_CHANNEL_IDS",
      "value": "",
      "description": "Discord channel IDs for release announcements",
      "required": true,
      "mask": false
    },
    {
      "name": "Bot Token",
      "key": "BOT_TOKEN",
      "value": "your_discord_bot_token_here",
      "description": "Discord bot token",
      "required": true,
      "mask": true
    },
    {
      "name": "CurseForge API Key",
      "key": "CURSEFORGE_API_KEY",
      "value": "",
      "description": "CurseForge API key",
      "required": true,
      "mask": true
    },
    {
      "name": "Message Tag",
      "key": "MESSAGE_TAG",
      "value": "@everyone",
      "description": "Tag to use in announcement messages",
      "required": false,
      "mask": false
    },
    {
      "name": "Message Header",
      "key": "MESSAGE_HEADER",
      "value": "Version {version} is now available!",
      "description": "Header template for announcement messages",
      "required": false,
      "mask": false
    },
    {
      "name": "Message Footer",
      "key": "MESSAGE_FOOTER",
      "value": "Update now!",
      "description": "Footer template for announcement messages",
      "required": false,
      "mask": false
    },
    {
      "name": "Show Logo",
      "key": "SHOW_LOGO",
      "value": "true",
      "description": "Whether to show the mod logo in announcements",
      "required": false,
      "mask": false
    },
    {
      "name": "Announce Messages",
      "key": "ANNOUNCE_MESSAGES",
      "value": "true",
      "description": "Whether to send announcement messages",
      "required": false,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO",
      "description": "Logging level (DEBUG, INFO, WARNING, ERROR)",
      "required": false,
      "mask": false
    },
    {
      "name": "Debug Mode",
      "key": "DEBUG",
      "value": "false",
      "description": "Enable debug mode",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
