{
  "name": "Chibisafe---Backend",
  "repo": "chibisafe/chibisafe:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/chibisafe/chibisafe",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/chibisafe-icon.png",
  "project": "https://chibisafe.app/",
  "description": "A modern and self-hosted take on file uploading services that can handle anything you throw at it thanks to its robust and fast API, chunked uploads support and more. This is the backend server. You will need to install Chibisafe - Frontend as well.",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/chibisafe-server/database",
      "container": "/app/database",
      "mode": "rw",
      "description": "Path to the database",
      "required": true
    },
    {
      "name": "Uploads Path",
      "host": "/mnt/cache/appdata/chibisafe-server/uploads",
      "container": "/app/uploads",
      "mode": "rw",
      "description": "Path to uploaded files",
      "required": true
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/chibisafe-server/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Path to log files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": "",
      "description": "Admin password for the API",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
