{
  "name": "mumble",
  "repo": "phlak/mumble:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/phlak/mumble/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:64738]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/mumble.png",
  "project": "https://www.mumble.info/",
  "description": "Mumble is an open source voice communication application Download config.ini wget -O /mnt/user/appdata/mumble/config.ini https://raw.githubusercontent.com/PHLAK/docker-mumble/master/files/config.ini",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/mumble/",
      "container": "/etc/mumble",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port TCP",
      "host": "64738",
      "container": "64738",
      "protocol": "tcp",
      "description": "64738 TCP",
      "required": true,
      "mask": false
    },
    {
      "name": "Port UDP",
      "host": "64738",
      "container": "64738",
      "protocol": "udp",
      "description": "64738 UDP",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SUPERUSER_PASSWORD",
      "key": "SUPERUSER_PASSWORD",
      "value": "Password",
      "description": "SUPERUSER_PASSWORD",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
