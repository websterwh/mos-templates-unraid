{
  "name": "UnstructuredAPI",
  "repo": "downloads.unstructured.io/unstructured-io/unstructured-api:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/Unstructured-IO/unstructured-api/pkgs/container/unstructured-api",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--port 8000 --host 0.0.0.0",
  "web_ui_url": "http://[IP]:[PORT:8000]/docs",
  "icon": "https://raw.githubusercontent.com/chrizzo84/unraid-templates/refs/heads/main/icons/unstructured.png",
  "project": "https://unstructured.io/",
  "description": "Provides an API to extract text from unstructured documents like PDFs, images, and more. unstructured is an open-source library for preprocessing documents.",
  "paths": [
    {
      "name": "Input Directory",
      "host": "/mnt/cache/appdata/unstructured/input",
      "container": "/mnt/input",
      "mode": "rw",
      "description": "The folder containing the documents to be processed.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "The port for the API.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
