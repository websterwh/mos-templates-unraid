{
  "name": "Cardano-Node",
  "repo": "cardanocommunity/cardano-node",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/cardanocommunity/cardano-node",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6000]",
  "icon": "https://raw.githubusercontent.com/Cobbert/unraid-templates/a3e5b1b77066f22f06e44470ee6e2a4859cb8428/cardano-node/Cardano.png",
  "project": "https://github.com/cardano-community/guild-operators",
  "description": "https://docs.cardano.org/about-cardano/introduction/",
  "paths": [
    {
      "name": "priv",
      "host": "/mnt/cache/appdata/cnode/priv",
      "container": "/opt/cardano/cnode/priv",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "db",
      "host": "/mnt/cache/appdata/cnode/db",
      "container": "/opt/cardano/cnode/db",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "cnode port",
      "host": "6000",
      "container": "6000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Network",
      "key": "NETWORK",
      "value": "mainnet",
      "description": "Choose network to run cnode on",
      "required": true,
      "mask": false
    },
    {
      "name": "Mithril Bootstrap",
      "key": "MITHRIL_DOWNLOAD",
      "value": "Y",
      "description": "This option will allow Mithril client to download the latest Mithril snapshot of the blockchain when the container starts and does not have a copy of the blockchain yet. This is useful when you want to start a new node from scratch and don't want to wait for the node to sync from the network. This option is not currently available for the guild network. &lt;br&gt;&lt;br&gt; Y for yes&lt;br&gt; N for no",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
