{
  "name": "cloudflared",
  "repo": "cloudflare/cloudflared:2021.8.2",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/cloudflare/cloudflared/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": "tunnel run UUID",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/aeleos/cloudflared/main/cloudflare-icon.png",
  "project": "https://github.com/aeleos/cloudflared",
  "description": "Contains the command-line client for Argo Tunnel, a tunneling daemon that proxies any local webserver through the Cloudflare network. Extensive documentation can be found in the Argo Tunnel section of the Cloudflare Docs. Instructions for installation can be found at https://github.com/aeleos/cloudflared",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/cloudflared",
      "container": "/home/nonroot/.cloudflared/",
      "mode": "rw",
      "description": "Container Path: /home/nonroot/.cloudflared/",
      "required": false
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
