{
  "name": "Home-Assistant-Time-Machine",
  "repo": "ghcr.io/saihgupr/homeassistanttimemachine:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/saihgupr/homeassistanttimemachine",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:54000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/home-assistant-time-machine-icon.png",
  "project": "https://github.com/saihgupr/HomeAssistantTimeMachine",
  "description": "Home Assistant Time Machine is a web-based tool that acts as a \"Time Machine\" for your Home Assistant configuration.",
  "paths": [
    {
      "name": "Backups Storage",
      "host": "",
      "container": "/media",
      "mode": "rw",
      "description": "Where to store Home Assistant backups",
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/home_assistant_time_machine/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config data",
      "required": true
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/home_assistant_time_machine/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "54000",
      "container": "54000",
      "protocol": "tcp",
      "description": "Container Port: 54000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Home Assistant URL",
      "key": "HOME_ASSISTANT_URL",
      "value": "http://localhost:8123",
      "description": "URL for the Home Assistant instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Home Assistant Long-Lived Access Token",
      "key": "LONG_LIVED_ACCESS_TOKEN",
      "value": "",
      "description": "Long-lived access token for the Home Assistant instance",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
