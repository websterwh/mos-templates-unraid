{
  "name": "jump",
  "repo": "daledavies/jump",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/daledavies/jump/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://github.com/daledavies/jump/blob/main/jumpapp/assets/images/favicon/icon.png?raw=true",
  "project": "https://github.com/daledavies/jump",
  "description": "Jump is a simple, stylish, fast and secure self-hosted startpage for your server. https://hub.docker.com/r/daledavies/jump/",
  "paths": [
    {
      "name": "Backgrounds",
      "host": "/mnt/cache/appdata/jump/backgrounds",
      "container": "/backgrounds",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Sites",
      "host": "/mnt/cache/appdata/jump/sites",
      "container": "/sites",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Container Port 1",
      "host": "8123",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Site Name",
      "key": "SITENAME:",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OWMAPIKEY",
      "key": "OWMAPIKEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Lat Long",
      "key": "LATLONG",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
