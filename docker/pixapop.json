{
  "name": "pixapop",
  "repo": "lscr.io/linuxserver/pixapop",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/pixapop",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/pixapop-logo.png",
  "project": "https://github.com/bierdok/pixapop",
  "description": "Pixapop(https://github.com/bierdok/pixapop) is an open-source single page application to view your photos in the easiest way possible.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Stores config and logs for nginx base.",
      "required": true
    },
    {
      "name": "Path: /photos",
      "host": "",
      "container": "/photos",
      "mode": "rw",
      "description": "Your local folder of photos.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "APP_USERNAME",
      "key": "APP_USERNAME",
      "value": "admin",
      "description": "Specify a username to enable authentication.",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_PASSWORD",
      "key": "APP_PASSWORD",
      "value": "admin",
      "description": "Specify a password to enable authentication.",
      "required": false,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
