{
  "name": "Frigate-Plate-Recognizer",
  "repo": "lmerza/frigate_plate_recognizer:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/lmerza/frigate_plate_recognizer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/blakeblackshear/frigate/refs/heads/dev/docs/static/img/logo.svg",
  "project": "https://github.com/ljmerza/frigate_plate_recognizer",
  "description": "Identify license plates via Plate Recognizer or CodeProject.AI and add them as sublabels to Frigate.",
  "paths": [
    {
      "name": "Plate Image Storage",
      "host": "",
      "container": "/plates",
      "mode": "rw",
      "description": "Path to store plate images",
      "required": true
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/frigate_plate_recognizer/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to app data",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
