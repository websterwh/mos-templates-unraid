{
  "name": "deluge",
  "repo": "lscr.io/linuxserver/deluge",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/deluge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8112]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/deluge-logo.png",
  "project": "http://deluge-torrent.org/",
  "description": "Deluge(http://deluge-torrent.org/) is a lightweight, Free Software, cross-platform BitTorrent client. * Full Encryption * WebUI * Plugin System * Much more...",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "deluge configs",
      "required": true
    },
    {
      "name": "Path: /downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "torrent download directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8112",
      "container": "8112",
      "protocol": "tcp",
      "description": "Port for webui",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 6881",
      "host": "6881",
      "container": "6881",
      "protocol": "tcp",
      "description": "Inbound torrent traffic (See App Setup)",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 6881",
      "host": "6881",
      "container": "6881",
      "protocol": "udp",
      "description": "Inbound torrent traffic (See App Setup)",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 58846",
      "host": "58846",
      "container": "58846",
      "protocol": "tcp",
      "description": "Default deluged port for thin client connectivity",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DELUGE_LOGLEVEL",
      "key": "DELUGE_LOGLEVEL",
      "value": "error",
      "description": "set the loglevel output when running Deluge, default is info for deluged and warning for delgued-web",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
