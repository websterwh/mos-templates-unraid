{
  "name": "QuestDB",
  "repo": "questdb/questdb",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/questdb/questdb/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9000]",
  "icon": "https://gitlab.com/yayitazale/unraid-templates/-/raw/main/QuestDB.png",
  "project": "https://questdb.io/",
  "description": "QuestDB is an open-source database designed to make time-series lightning fast and easy.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/questdb",
      "container": "/var/lib/questdb",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Postgres wire protocol",
      "host": "8812",
      "container": "8812",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "API Rest and webgui",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "InfluxDB line protocol",
      "host": "9009",
      "container": "9009",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
