{
  "name": "VERTd",
  "repo": "ghcr.io/vert-sh/vertd:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/vert-sh/vertd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:24153]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/vert-icon.png",
  "project": "https://github.com/VERT-sh/vertd",
  "description": "VERT's solution to crappy video conversion services. For Nvidia GPU support, add \"--gpus all\" to the Extra Parameters field under Advanced. For Intel iGPU support, add \"/dev/dri\" as a Device and add \"--device=/dev/dri\" to the Extra Parameters field under Advanced.",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "24153",
      "container": "24153",
      "protocol": "tcp",
      "description": "Container Port: 24153",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Encoder",
      "key": "VERTD_FORCE_GPU",
      "value": "cpu|nvidia|amd|intel|apple",
      "description": "Force specific hardware encoder",
      "required": true,
      "mask": false
    },
    {
      "name": "Webhook URL",
      "key": "WEBHOOK_URL",
      "value": "",
      "description": "Optional Discord webhook URL to notify of failed conversions",
      "required": false,
      "mask": false
    },
    {
      "name": "Webhook Pings",
      "key": "WEBHOOK_PINGS",
      "value": "",
      "description": "Optional user or role ID to ping in Discord webhook notifications",
      "required": false,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": "",
      "description": "Admin password for kept videos.",
      "required": true,
      "mask": true
    },
    {
      "name": "Public URL",
      "key": "PUBLIC_URL",
      "value": "https://vertd.example.com",
      "description": "Public URL for kept video access.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
