{
  "name": "Monero-GUI",
  "repo": "ghcr.io/ich777/monero-gui",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/ich777/monero-gui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/vnc.html?autoconnect=true",
  "icon": "https://raw.githubusercontent.com/ich777/docker-templates/master/ich777/images/monero.png",
  "project": "https://www.getmonero.org/",
  "description": "Monero-GUI is a simple but yet powerfull Monero Wallet. **ATTENTION:** By default your wallet is saved in ../Monero/wallet (please don't store your Wallet in the .../bin directory since it get's deleted after a update is released) I strongly recommend you to backup your keyfile on a regular basis! **NOTE:** If you minimize the window by accident you have to restart the container to see the GUI again.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/monero-gui",
      "container": "/monero",
      "mode": "rw",
      "description": "Please keep in mind that your wallet is stored there and I strongly recommend you to backup that path (ATTENTION: By default your wallet is saved in ../Monero/wallet - please don't store your Wallet in the .../bin directory since it get's deleted after a update is released).",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebGUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "TCP noVNC WebGUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Custom Screen Width",
      "key": "CUSTOM_RES_W",
      "value": "1280",
      "description": "Minimum screen width 1280 pixels",
      "required": true,
      "mask": false
    },
    {
      "name": "Custom Screen Height",
      "key": "CUSTOM_RES_H",
      "value": "1024",
      "description": "Minimum screen hight 1024 pixels",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "DATA_PERM",
      "key": "DATA_PERM",
      "value": "770",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
