{
  "name": "xteve-vpn",
  "repo": "brycelarge/xteve-vpn",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/brycelarge/xteve-vpn",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:34400]/web/",
  "icon": "https://raw.githubusercontent.com/brycelarge/unraid-templates/main/images/xteve.png",
  "project": null,
  "description": "[p] \u26a0\ufe0f DEPRECATED - No Longer Maintained [/p][p]This template is no longer maintained. Please use tuliprox-vpn instead, which provides a more modern and actively maintained alternative.[/p][p]Search for tuliprox-vpn in the Unraid Community Applications to find the replacement template.[/p]",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/xteve-vpn/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /home/xteve/conf",
      "required": true
    },
    {
      "name": "Temp Directory",
      "host": "/tmp/xteve",
      "container": "/temp/xteve",
      "mode": "rw",
      "description": "Container Path: /temp/xteve",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port: Privoxy",
      "host": "8181",
      "container": "8181",
      "protocol": "tcp",
      "description": "Privoxy Port: 8181",
      "required": true,
      "mask": false
    },
    {
      "name": "Host Port: xTeVe",
      "host": "34400",
      "container": "34400",
      "protocol": "tcp",
      "description": "xTeVe Port: 34400",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "",
      "description": "Container Variable: TZ",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenVPN Provider",
      "key": "OPENVPN_PROVIDER",
      "value": "**None**|PIA|SURFSHARK|VYPRVPN|CUSTOM",
      "description": "Container Variable: OPENVPN_PROVIDER",
      "required": true,
      "mask": false
    },
    {
      "name": "OpenVPN Username",
      "key": "OPENVPN_USERNAME",
      "value": "**None**",
      "description": "Container Variable: OPENVPN_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenVPN Password",
      "key": "OPENVPN_PASSWORD",
      "value": "**None**",
      "description": "Container Variable: OPENVPN_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenVPN config file",
      "key": "OPENVPN_CONFIG",
      "value": "ca_toronto",
      "description": "Container Variable: OPENVPN_CONFIG - Not needed if provider is custom",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenVPN Protocol (udp|tcp)",
      "key": "OPENVPN_PROTOCOL",
      "value": "udp",
      "description": "Container Variable: OPENVPN_PROTOCOL - Not needed if provider is custom",
      "required": false,
      "mask": false
    },
    {
      "name": "Privoxy enabled",
      "key": "PRIVOXY_ENABLED",
      "value": "false",
      "description": "Container Variable: PRIVOXY_ENABLED - disabled when OpenVPN is disabled. Runs on port 8181",
      "required": false,
      "mask": false
    },
    {
      "name": "Local Network",
      "key": "LOCAL_NETWORK",
      "value": "",
      "description": "Container Variable: LOCAL_NETWORK 192.168.0.0/24 - if this is not set then you will not have access to the container when OpenVPN is running",
      "required": false,
      "mask": false
    },
    {
      "name": "Name servers",
      "key": "NAME_SERVERS",
      "value": "1.1.1.1,1.0.0.1",
      "description": "Container Variable: NAME_SERVERS",
      "required": false,
      "mask": false
    },
    {
      "name": "Container Debug",
      "key": "DEBUG",
      "value": "false",
      "description": "Container Variable: DEBUG",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenVPN custom options",
      "key": "OPENVPN_OPTIONS",
      "value": "--ping 10 --ping-restart 120",
      "description": "Container Variable: OPENVPN_OPTIONS --ping 10 --ping-restart 120",
      "required": false,
      "mask": false
    },
    {
      "name": "xTeVe Debug",
      "key": "XTEVE_DEBUG",
      "value": "0",
      "description": "optional set debug 0-3",
      "required": false,
      "mask": false
    },
    {
      "name": "xTeVe Branch",
      "key": "XTEVE_BRANCH",
      "value": "master",
      "description": "optional set to beta",
      "required": false,
      "mask": false
    },
    {
      "name": "xTeVe Port",
      "key": "XTEVE_PORT",
      "value": "34400",
      "description": "Container Variable: XTEVE_PORT (tells xTeVe which port its on))",
      "required": false,
      "mask": false
    },
    {
      "name": "xTeVe API",
      "key": "XTEVE_API",
      "value": "1",
      "description": "Container Variable: XTEVE_API",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
