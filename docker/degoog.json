{
  "name": "degoog",
  "repo": "ghcr.io/degoog-org/degoog:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/degoog-org/degoog",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4444]/",
  "icon": "https://raw.githubusercontent.com/davidjkling/unraid-templates/refs/heads/main/static/degoog.png",
  "project": "https://github.com/fccview/degoog",
  "description": "Search aggregator that queries multiple engines and shows results in one place. You can add custom search engines, bang-command plugins, and slot plugins (query-triggered panels above/below results or in the sidebar). The dream would be to eventually have a user made marketplace for plugins/engines.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/degoog",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "4444",
      "container": "4444",
      "protocol": "tcp",
      "description": "Port to access WebUI.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
