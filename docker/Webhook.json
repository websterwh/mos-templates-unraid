{
  "name": "Webhook",
  "repo": "almir/webhook:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/almir/webhook",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "-verbose -hooks=/etc/webhook/hooks.json -hotreload",
  "web_ui_url": "http://[IP]:[PORT:9000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/webhook-icon.png",
  "project": "https://github.com/adnanh/webhook",
  "description": "A lightweight configurable tool that allows you to easily create HTTP endpoints (hooks) on your server, which you can use to execute configured commands. You can also pass data from the HTTP request (such as headers, payload or query variables) to your commands. webhook also allows you to specify rules which have to be satisfied in order for the hook to be triggered.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/webhook",
      "container": "/etc/webhook",
      "mode": "rw",
      "description": "Path to the config directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Container Port: 9000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
