{
  "name": "ws-ephemeral",
  "repo": "dhruvinsh/ws-ephemeral:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/dhruvinsh/ws-ephemeral",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://cdn.jsdelivr.net/gh/dhruvinsh/unraid-icons@master/icons/png/windscribe.png",
  "project": "https://github.com/dhruvinsh/ws-ephemeral",
  "description": "For windscribe VPN user this tool allows you to automate the opening ephemeral port. For example P2P application behind VPN requires UDP port open, while using VPN, ephemeral port is great option but it comes with 7 days expiry. This tool allows you to automate that part.",
  "paths": [
    {
      "name": "Cookie path",
      "host": "/mnt/cache/appdata/ws-ephemeral",
      "container": "/cookie",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [],
