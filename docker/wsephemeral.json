      "name": "WS_USERNAME",
      "key": "WS_USERNAME",
      "value": "",
      "description": "windscribe username",
      "required": true,
      "mask": false
    },
    {
      "name": "WS_PASSWORD",
      "key": "WS_PASSWORD",
      "value": "",
      "description": "windscribe password",
      "required": true,
      "mask": true
    },
    {
      "name": "WS_TOTP",
