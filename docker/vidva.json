{
  "name": "vidva",
  "repo": "vanshady/vidva:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/vanshady/vidva",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5173]",
  "icon": "https://raw.githubusercontent.com/vanshady/vidva/main/public/logo.png",
  "project": "https://github.com/vanshady/vidva",
  "description": "View Plex library statistics in real-time with interactive charts and visualizations. See breakdowns for genres, countries, decades, directors, and cast.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "5173",
      "container": "5173",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Plex Server URL",
      "key": "PLEX_SERVER_URL",
      "value": "",
      "description": "http://Your Plex's IP Address:32400",
      "required": true,
      "mask": false
    },
    {
      "name": "Plex Token",
      "key": "PLEX_TOKEN",
      "value": "",
      "description": "https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/",
      "required": true,
      "mask": true
    },
    {
      "name": "Plex Server ID",
      "key": "PLEX_SERVER_ID",
      "value": "",
      "description": "Go to /identity and copy the server ID from machineIdentifier=",
      "required": true,
      "mask": true
    },
    {
      "name": "Default top cast count",
      "key": "VIDVA_DEFAULT_TOP_CAST_COUNT",
      "value": "4",
      "description": "all or 3 (plex default) or 4 (letterboxd default) or 5 or 10",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
