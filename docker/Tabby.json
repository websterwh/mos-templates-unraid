{
  "name": "Tabby",
  "repo": "tabbyml/tabby",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/tabbyml/tabby/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia",
  "post_parameters": "serve --model TabbyML/DeepseekCoder-6.7B --device cuda",
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://i.imgur.com/95GUyHf.png",
  "project": "https://tabby.tabbyml.com/",
  "description": "Opensource, self-hosted AI coding assistant",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/tabby",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
