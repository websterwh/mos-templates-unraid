{
  "name": "SyncYomi",
  "repo": "ghcr.io/syncyomi/syncyomi:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/syncyomi/syncyomi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8282]/",
  "icon": "https://raw.githubusercontent.com/SyncYomi/SyncYomi/develop/.github/images/logo.png",
  "project": "https://github.com/SyncYomi/SyncYomi",
  "description": "SyncYomi is an open-source project designed to offer a seamless synchronization experience for your Tachiyomi manga reading progress and library across multiple devices. This server can be self-hosted, allowing you to sync your Tachiyomi library effortlessly. More info at: https://github.com/SyncYomi/SyncYomi As for now this project rely on a specific Tachiyomi build available at: https://discord.gg/aydqBWAZs8",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/syncyomi/",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8282",
      "container": "8282",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TimeZone",
      "key": "TZ",
      "value": "Asia/Shanghai",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
