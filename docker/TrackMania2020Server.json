{
  "name": "TrackMania2020-Server",
  "repo": "evoesports/trackmania:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/evoesports/trackmania",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2350]",
  "icon": "https://raw.githubusercontent.com/L4stIdi0t/Unraid-template/master/TrackMania2020-Server/logoTM.png",
  "project": "https://github.com/EvoEsports/docker-trackmania",
  "description": "This will run a TrackMania 2020 server. You can also install the EvoSC to get an admin interface in the game. Create an account here https://players.trackmania.com/server/dedicated/create",
  "paths": [
    {
      "name": "ServerData",
      "host": "/mnt/cache/appdata/Trackmania2020Server/",
      "container": "/server/UserData",
      "mode": "rw",
      "description": "Container Path: /server/UserData",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Game TCP",
      "host": "2350",
      "container": "2350",
      "protocol": "tcp",
      "description": "Required to connect to the game server",
      "required": true,
      "mask": false
    },
    {
      "name": "Game UDP",
      "host": "2350",
      "container": "2350",
      "protocol": "udp",
      "description": "Required to connect to the game server",
      "required": true,
      "mask": false
    },
    {
      "name": "XMLRPC",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "This port can be safely removed for improved security of your server.(no remote control)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MASTER_LOGIN",
      "key": "MASTER_LOGIN",
      "value": "",
      "description": "https://players.trackmania.com/server/dedicated/create",
      "required": true,
      "mask": false
    },
    {
      "name": "MASTER_PASSWORD",
      "key": "MASTER_PASSWORD",
      "value": "",
      "description": "https://players.trackmania.com/server/dedicated/create",
      "required": true,
      "mask": true
    },
    {
      "name": "XMLRPC_ALLOWREMOTE",
      "key": "XMLRPC_ALLOWREMOTE",
      "value": "false",
      "description": "Container Variable: XMLRPC_ALLOWREMOTE",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
