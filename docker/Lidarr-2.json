{
  "name": "Lidarr",
  "repo": "volikon/lidarr",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/volikon/lidarr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8686]/",
  "icon": "https://i.imgur.com/tWOwRrb.png",
  "project": null,
  "description": "Lidarr is a music collection manager for Usenet and BitTorrent users. It can monitor multiple RSS feeds for new tracks from your favorite artists and will grab, sort and rename them. It can also be configured to automatically upgrade the quality of files already downloaded when a better quality format becomes available. /config : Storing all Lidarr config files /data : Storing all Lidarr data files /music : Point to your music location",
  "paths": [
    {
      "name": "config",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    },
    {
      "name": "data",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    },
    {
      "name": "music",
      "host": "",
      "container": "/music",
      "mode": "rw",
      "description": "Container Path: /music",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host port 1",
      "host": "8686",
      "container": "8686",
      "protocol": "tcp",
      "description": "Container Port: 8686",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
