{
  "name": "GroveMap",
  "repo": "ghcr.io/robsmallridge/grovemap:latest",
  "category": [
    "System"
  ],
  "registry": "https://ghcr.io/robsmallridge/grovemap",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/robsmallridge/GroveMap/main/frontend/public/icon-192.png",
  "project": "https://github.com/robsmallridge/GroveMap",
  "description": "Web-based disk usage analyzer with interactive treemap visualization. Mount your Unraid shares to see what's consuming your storage. Drill down into folders, filter by file name, extension, or date. Lightweight, read-only, no database required.",
  "paths": [
    {
      "name": "Share 1",
      "host": "/mnt/user",
      "container": "/data/share1",
      "mode": "ro",
      "description": "First directory to analyze",
      "required": true
    },
    {
      "name": "Share 2",
      "host": "",
      "container": "/data/share2",
      "mode": "ro",
      "description": "Second directory to analyze (optional)",
      "required": false
    },
    {
      "name": "Share 3",
      "host": "",
      "container": "/data/share3",
      "mode": "ro",
      "description": "Third directory to analyze (optional)",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port for the web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Cache TTL",
      "key": "SCAN_CACHE_TTL",
      "value": "300",
      "description": "Seconds to cache scan results",
      "required": false,
      "mask": false
    },
    {
      "name": "Scan on Start",
      "key": "SCAN_ON_START",
      "value": "true",
      "description": "Auto-scan when container starts",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
