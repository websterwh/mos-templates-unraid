{
  "name": "wger-celery-flower",
  "repo": "wger/server:latest",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/wger/server",
  "network": "wger_network",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--entrypoint /start-flower",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5555]",
  "icon": "https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/wger-logo.png",
  "project": "https://wger.de",
  "description": "Flower is a web-based monitoring and management tool for Celery clusters. This template starts the Flower service for the wger application to monitor background tasks.",
  "paths": [
    {
      "name": "DJANGO_MEDIA_ROOT",
      "host": "/mnt/cache/appdata/wger/media",
      "container": "/home/wger/media",
      "mode": "rw",
      "description": "Path to media files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Flower WebUI Port",
      "host": "8559",
      "container": "5555",
      "protocol": "tcp",
      "description": "Port for the Flower web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "wger-docker-supersecret-key-1234567890!@#$%^&amp;*(-_)",
      "description": "Django SECRET_KEY \u2013 must match wger-server. CHANGE THIS!",
      "required": true,
      "mask": false
    },
    {
      "name": "SIGNING_KEY",
      "key": "SIGNING_KEY",
      "value": "wger-docker-secret-jwtkey-1234567890!@#$%^&amp;*(-_=+)",
      "description": "JWT signing key \u2013 must match wger-server. CHANGE THIS!",
      "required": true,
      "mask": false
    },
    {
      "name": "TIME_ZONE",
      "key": "TIME_ZONE",
      "value": "Europe/Berlin",
      "description": "Server timezone",
      "required": true,
      "mask": false
    },
    {
      "name": "DJANGO_DB_HOST",
      "key": "DJANGO_DB_HOST",
      "value": "wger-db",
      "description": "PostgreSQL database container hostname",
      "required": true,
      "mask": false
    },
    {
      "name": "DJANGO_DB_PORT",
      "key": "DJANGO_DB_PORT",
      "value": "5432",
      "description": "Database port",
      "required": false,
      "mask": false
    },
    {
      "name": "CELERY_BROKER",
      "key": "CELERY_BROKER",
      "value": "redis://wger-redis:6379/2",
      "description": "Celery broker URL (Redis)",
      "required": true,
      "mask": false
    },
    {
      "name": "CELERY_BACKEND",
      "key": "CELERY_BACKEND",
      "value": "redis://wger-redis:6379/2",
      "description": "Celery result backend URL (Redis)",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "File creation mask",
      "required": false,
      "mask": false
    },
    {
      "name": "CELERY_FLOWER_PASSWORD",
      "key": "CELERY_FLOWER_PASSWORD",
      "value": "adminadmin",
      "description": "Password for Celery Flower web interface",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
