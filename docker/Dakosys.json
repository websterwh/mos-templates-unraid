{
  "name": "Dakosys",
  "repo": "ghcr.io/sahara101/dakosys:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/sahara101/dakosys",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "daemon",
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/cglatot/Dakosys-Overlay-Only/main/dakosys-logo.png",
  "project": "https://github.com/sahara101/Dakosys",
  "description": "DAKOSYS is a powerful tool for Plex users that creates and manages Trakt.tv lists and Kometa/PMM overlays. It helps you categorize anime episodes by type, track TV show statuses, display media file sizes, all running in Docker with automatic scheduling. This is a CLI tool. Please edit the **Post Arguments** accordingly. See documentation: https://github.com/sahara101/Dakosys#-usage-examples",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/dakosys/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Data path",
      "required": true
    },
    {
      "name": "Kometa Data Path",
      "host": "",
      "container": "/kometa",
      "mode": "rw",
      "description": "Path to Kometa config",
      "required": true
    },
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/dakosys/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Configuration data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
