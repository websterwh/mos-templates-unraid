{
  "name": "Liquid-dl",
  "repo": "kthulu120/liquid_dl",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/kthulu120/liquid_dl/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://i.imgur.com/9UXxDSr.png",
  "project": "https://github.com/Kthulu120/liquid_dl",
  "description": "Liquid-dl is a simple tool for utlities such as FFMPEG, youtube-dl, and scdl. It provides a simple framework with simple point and click options allowing users to just click on what they need and use the bare minimum commands to get the results needed.",
  "paths": [
    {
      "name": "Download Directory",
      "host": "/mnt/cache/appdata/liquid-dl",
      "container": "/downloads",
      "mode": "rw",
      "description": "Container path: /downloads",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8734",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
