{
  "name": "timetagger",
  "repo": "ghcr.io/almarklein/timetagger",
  "category": [
    "Productivity"
  ],
  "registry": "https://ghcr.io/almarklein/timetagger",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://i.imgur.com/kQTshW1.png",
  "project": "https://timetagger.app/",
  "description": "Tag your time, get the insight - An open source time-tracker with an interactive user experience and powerful reporting. Use https://timetagger.app/cred to generate your credentials you will use to log in to timetagger. You can add multiple users this way (separated by commas).",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/timetagger",
      "container": "/root/_timetagger",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8089",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TIMETAGGER_BIND",
      "key": "TIMETAGGER_BIND",
      "value": "0.0.0.0:80",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TIMETAGGER_DATADIR",
      "key": "TIMETAGGER_DATADIR",
      "value": "/root/_timetagger",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TIMETAGGER_LOG_LEVEL",
      "key": "TIMETAGGER_LOG_LEVEL",
      "value": "info",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TIMETAGGER_CREDENTIALS",
      "key": "TIMETAGGER_CREDENTIALS",
      "value": "",
      "description": "Use https://timetagger.app/cred to generate your credentials you will use to log in to timetagger. You can add multiple users this way (separated by commas).",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
