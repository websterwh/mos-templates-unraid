{
  "name": "Seawise",
  "repo": "ghcr.io/seawise-io/seawise-client:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/seawise-io/seawise-client/pkgs/container/seawise-client",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8082]",
  "icon": "https://raw.githubusercontent.com/seawise-io/seawise-client/main/.github/assets/icon.png",
  "project": "https://seawise.io",
  "description": "Share your self-hosted apps (Jellyfin, Plex, Immich, Home Assistant and more) with family and friends, without port forwarding. The client connects out to Seawise.io, so nothing on your network is opened. Requires a free Seawise.io account. After the first start, open the web UI and set a password within 5 minutes.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/seawise",
      "container": "/config",
      "mode": "rw",
      "description": "Client settings and pairing",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "WebUI Port",
      "key": "SEAWISE_PORT",
      "value": "8082",
      "description": "Web UI port",
      "required": true,
      "mask": false
    },
    {
      "name": "Host network mode",
      "key": "SEAWISE_HOST_NETWORK",
      "value": "true",
      "description": "Leave true while Network is host. Set to false if you switch to bridge.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
