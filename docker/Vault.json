{
  "name": "Vault",
  "repo": "hashicorp/vault",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/hashicorp/vault",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=IPC_LOCK",
  "post_parameters": "server",
  "web_ui_url": "http://[IP]:[PORT:8200]",
  "icon": "https://www.gravatar.com/avatar/f7304a610df968cef5badc9e9dcd40e0?s=120&r=g&d=404",
  "project": "https://www.hashicorp.com/products/vault",
  "description": "Manage access to secrets and protect sensitive data with identity-based security. config.hcl: ui = \"true\" listener \"tcp\" { address = \"0.0.0.0:8200\" tls_disable = \"true\" } storage \"file\" { path = \"/vault/file\" } api_addr = \"http://0.0.0.0:8200\" disable_mlock = \"true\"",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/vault/data/",
      "container": "/vault/file/",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "config",
      "host": "/mnt/cache/appdata/vault/config.hcl",
      "container": "/vault/config/config.hcl",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "ui",
      "host": "8200",
      "container": "8200",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VAULT_ADDR",
      "key": "VAULT_ADDR",
      "value": "https://vault.mars.local",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
