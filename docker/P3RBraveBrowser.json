{
  "name": "P3R-Brave-Browser",
  "repo": "p3rco/brave:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/repository/docker/p3rco/brave",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--shm-size=2g",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5800]/",
  "icon": "https://raw.githubusercontent.com/P3R-CO/unraid/master/Brave-P3R-256px.png",
  "project": "https://github.com/P3R-CO/brave-container",
  "description": "Brave Browser in a forwarded X11 container. Brave is a free and open-source web browser developed by Brave Software, Inc. based on the Chromium web browser. It blocks ads and website trackers, and provides a way for users to send cryptocurrency contributions in the form of Basic Attention Tokens to websites and content creators.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/P3R-Brave-Browser/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config/",
      "required": true
    },
    {
      "name": "Browser Downloads Folder",
      "host": "",
      "container": "/Downloads/",
      "mode": "rw",
      "description": "Container Path: /Downloads",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "5800",
      "container": "5800",
      "protocol": "tcp",
      "description": "Container Port: 5800",
      "required": true,
      "mask": false
    },
    {
      "name": "VNC Port",
      "host": "5900",
      "container": "5900",
      "protocol": "tcp",
      "description": "Container Port: 5900",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Browser Display Width",
      "key": "DISPLAY_WIDTH",
      "value": "1920",
      "description": "Display Width in Pixels",
      "required": true,
      "mask": false
    },
    {
      "name": "Browser Display Height",
      "key": "DISPLAY_HEIGHT",
      "value": "1080",
      "description": "Display Height in Pixels",
      "required": true,
      "mask": false
    },
    {
      "name": "VNC Password",
      "key": "VNC_PASSWORD",
      "value": "",
      "description": "Set New VNC Password",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
