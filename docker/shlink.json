{
  "name": "shlink",
  "repo": "shlinkio/shlink:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/shlinkio/shlink/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/shlink.png",
  "project": "https://shlink.io/",
  "description": "A self-hosted and PHP-based URL shortener application with CLI and REST interfaces. More Variables: https://shlink.io/documentation/install-docker-image/#supported-env-vars",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Short Domain Host",
      "key": "DEFAULT_DOMAIN",
      "value": "doma.in",
      "description": "The custom short domain used for this shlink instance. For example doma.in.",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS Enabled?",
      "key": "IS_HTTPS_ENABLED",
      "value": "true",
      "description": "Either true or false.",
      "required": false,
      "mask": false
    },
    {
      "name": "Geolite License Key",
      "key": "GEOLITE_LICENSE_KEY",
      "value": "",
      "description": "https://dev.maxmind.com/geoip/geoip2/geolite2/",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Driver",
      "key": "DB_DRIVER",
      "value": "maria",
      "description": "Database Driver",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "DB_NAME",
      "value": "shlink",
      "description": "The database name to be used. Defaults to shlink.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "DB_USER",
      "value": "root",
      "description": "The username credential for the database server.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "DB_PASSWORD",
      "value": "password",
      "description": "The password credential for the database server.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Host",
      "key": "DB_HOST",
      "value": "192.168.0.100",
      "description": "The host name of the server running the database engine.",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "DB_PORT",
      "value": "3306",
      "description": "mysql or maria -&gt; 3306 - postgres -&gt; 5432 - mssql -&gt; 1433",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
