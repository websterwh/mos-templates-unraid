{
  "name": "msedge",
  "repo": "lscr.io/linuxserver/msedge",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/msedge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:3001]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "https://www.microsoft.com/edge",
  "description": "Microsoft Edge(https://www.microsoft.com/edge) is a cross-platform web browser developed by Microsoft and based on Chromium.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Users home directory in the container, stores local files and settings",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "HTTP Edge desktop gui, needs to be proxied.",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 3001",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "HTTPS Edge desktop gui.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "EDGE_CLI",
      "key": "EDGE_CLI",
      "value": "https://www.linuxserver.io/",
      "description": "Specify one or multiple Chromium CLI flags, this string will be passed to the application in full.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
