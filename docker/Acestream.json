{
  "name": "Acestream",
  "repo": "vstavrinov/acestream-engine",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/vstavrinov/acestream-engine",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8008]",
  "icon": "https://raw.githubusercontent.com/qubex22/unraid-templates/main/acestream/acestream.png",
  "project": "https://github.com/vstavrinov/acestream-engine",
  "description": "Acestream-engine To access it you can use the HTTP api as shown in their wiki: https://wiki.acestream.media/Engine_HTTP_API For example in VLC: http://[YOUR IP]:8008/ace/getstream?id=[ACESTREAM id] Also you can create an m3u list and integrate in Jellyfin Live TV with the m3u tuner: #EXTM3U #EXTINF:0,EXAMPLE http://[YOUR IP]:8008/ace/getstream?id=[ACESTREAM id]",
  "paths": [
    {
      "name": "acestream cache",
      "host": "/mnt/cache/appdata/acestream/",
      "container": "/srv/ace/.ACEStream",
      "mode": "rw",
      "description": "Stream cache data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HOST PORT",
      "host": "8008",
      "container": "6878",
      "protocol": "tcp",
      "description": "Redirect default engine port 6878",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
