{
  "name": "Streamystats---Frontend",
  "repo": "fredrikburmester/streamystats-nextjs:edge",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/fredrikburmester/streamystats-nextjs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/streamystats-icon.png",
  "project": "https://github.com/fredrikburmester/streamystats",
  "description": "Streamystats is a statistics service for Jellyfin, providing analytics and data visualization. This is the frontend container.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API URL",
      "key": "API_URL",
      "value": "http://IP_ADDRESS:4000/api",
      "description": "URL for the backend API",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
