{
  "name": "Bambi",
  "repo": "kaoshunter/bambi:1.0.0",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/kaoshunter/bambi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5050]/",
  "icon": "https://raw.githubusercontent.com/Ka0sHuNT3R/bambi-unraid-template/main/bambi-logo.png",
  "project": "https://hub.docker.com/r/kaoshunter/bambi",
  "description": "Bambi control dashboard for Bambu Lab printers.",
  "paths": [
    {
      "name": "Bambi Appdata",
      "host": "/mnt/cache/appdata/bambi/app",
      "container": "/app/dashboard",
      "mode": "rw",
      "description": "Persistent Bambi dashboard files",
      "required": true
    },
    {
      "name": "Bambi Cache",
      "host": "/mnt/cache/appdata/bambi/cache",
      "container": "/app/cache",
      "mode": "rw",
      "description": "Persistent Bambi cache and print working files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "6060",
      "container": "5050",
      "protocol": "tcp",
      "description": "Bambi WebUI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Printer IP Address",
      "key": "BAMBU_IP",
      "value": "",
      "description": "IP address of the Bambu Lab printer",
      "required": true,
      "mask": false
    },
    {
      "name": "Printer Serial Number",
      "key": "BAMBU_SERIAL",
      "value": "",
      "description": "Bambu Lab printer serial number",
      "required": true,
      "mask": false
    },
    {
      "name": "Printer Access Code",
      "key": "BAMBU_ACCESS_CODE",
      "value": "",
      "description": "Bambu Lab printer access code",
      "required": true,
      "mask": true
    },
    {
      "name": "Bambi Print Token",
      "key": "BAMBI_PRINT_TOKEN",
      "value": "",
      "description": "Bambi print service token",
      "required": true,
      "mask": true
    },
    {
      "name": "Bambi Test Access Code",
      "key": "BAMBI_TEST_ACCESS_CODE",
      "value": "",
      "description": "Bambi test access code",
      "required": true,
      "mask": true
    },
    {
      "name": "Bambu Username",
      "key": "BAMBU_USERNAME",
      "value": "bblp",
      "description": "Bambu printer FTP username",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
