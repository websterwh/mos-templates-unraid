{
  "name": "Wanderer",
  "repo": "flomp/wanderer-web:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/flomp/wanderer-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/Flomp/wanderer/refs/heads/main/web/static/favicon.png",
  "project": "https://github.com/Flomp/wanderer",
  "description": "A self-hosted trail database. You can upload your recorded tracks or create new ones and add various metadata to build an easily searchable catalogue. This is the web component.",
  "paths": [
    {
      "name": "Uploads Path",
      "host": "/mnt/cache/appdata/wanderer/uploads",
      "container": "/app/uploads",
      "mode": "rw",
      "description": "Path to uploaded files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Meilisearch - URL",
      "key": "MEILI_URL",
      "value": "http://meilisearch:7700",
      "description": "URL of the Meilisearch instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Meilisearch - Master Key",
      "key": "MEILI_MASTER_KEY",
      "value": "",
      "description": "Master key for the Meilisearch instance",
      "required": false,
      "mask": true
    },
    {
      "name": "Database - URL",
      "key": "PUBLIC_POCKETBASE_URL",
      "value": "http://wanderer-db:8090",
      "description": "URL of the Wanderer - Database instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable Signups",
      "key": "PUBLIC_DISABLE_SIGNUP",
      "value": "false|true",
      "description": "Disable the ability to sign up",
      "required": true,
      "mask": false
    },
    {
      "name": "Origin",
      "key": "ORIGIN",
      "value": "http://localhost:3000",
      "description": "Origin of the web app",
      "required": true,
      "mask": false
    },
    {
      "name": "Body Size Limit",
      "key": "BODY_SIZE_LIMIT",
      "value": "Infinity",
      "description": "Maximum size of the body",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Uploads Path",
      "key": "UPLOAD_FOLDER",
      "value": "/app/uploads",
      "description": "Path to uploaded files",
      "required": true,
      "mask": false
    },
    {
      "name": "Upload User",
      "key": "UPLOAD_USER",
      "value": "",
      "description": "User to upload files",
      "required": false,
      "mask": false
    },
    {
      "name": "Upload Password",
      "key": "UPLOAD_PASSWORD",
      "value": "",
      "description": "Password to upload files",
      "required": false,
      "mask": true
    },
    {
      "name": "Public Valhalla URL",
      "key": "PUBLIC_VALHALLA_URL",
      "value": "https://valhalla1.openstreetmap.de",
      "description": "URL of the Valhalla instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Public Nominatim URL",
      "key": "PUBLIC_NOMINATIM_URL",
      "value": "https://nominatim.openstreetmap.org",
      "description": "URL of the Nominatim instance",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
