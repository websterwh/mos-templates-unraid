{
  "name": "Hawser",
  "repo": "ghcr.io/finsys/hawser:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/Finsys/hawser",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2376]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/hawser-logo.png",
  "project": "https://dockhand.pro/",
  "description": "Remote Docker agent for (https://dockhand.pro) - manage Docker hosts anywhere. Hawser is a lightweight Go agent that enables Dockhand to manage Docker hosts in various network configurations. It supports two operational modes: - **Standard Mode**: Agent listens for incoming connections (ideal for LAN/homelab with static IPs)",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker Socket",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Com port",
      "host": "2376",
      "container": "2376",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TOKEN",
      "key": "TOKEN",
      "value": "",
      "description": null,
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
