{
  "name": "fr24feed-piaware",
  "repo": "thomx/fr24feed-piaware",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/thomx/fr24feed-piaware/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/gmap.html",
  "icon": "https://github.com/FoxxMD/unraid-docker-templates/raw/master/icons/flightaware.jpg",
  "project": "https://github.com/Thom-x/docker-fr24feed-piaware-dump1090-mutability",
  "description": "All-in-one image for feeding FlightRadar24/FlightAware ADS-B/MLAT data with an RTL-SDR device and local web server for displaying aircraft positions on a map. Docker contains: * Piaware (Flightaware ADS-B and MLAT ground station software/feed) * fr24feed (FlightRadar24 ADS-B software feed) * Dump1090 for receiving and parsing data to the above software * Simple HTTP Server to display received data (aircraft positions/track) on a real-time map Installation Follow the directions on the github README (Project Page link on Unraid) with the provided Config entries in this template. See the support thread for more info. Usage If the container starts without error you can verify RTL-SDR is in use and feeds are working by checking the container log. Use the WebUI button to see the map;",
  "paths": [
    {
      "name": "Piaware Config",
      "host": "/mnt/cache/appdata/fr24feed-piaware/piaware.conf",
      "container": "/etc/piaware.conf",
      "mode": "rw",
      "description": "Container Path: /etc/piaware.conf",
      "required": true
    },
    {
      "name": "Dump1090 Config",
      "host": "/mnt/cache/appdata/fr24feed-piaware/config.js",
      "container": "/usr/lib/fr24/public_html/config.js",
      "mode": "rw",
      "description": "Container Path: /usr/lib/fr24/public_html/config.js",
      "required": true
    },
    {
      "name": "fr24feed Config",
      "host": "/mnt/cache/appdata/fr24feed-piaware/fr24feed.ini",
      "container": "/etc/fr24feed.ini",
      "mode": "rw",
      "description": "Container Path: /etc/fr24feed.ini",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false
    },
    {
      "name": "fr24feed Admin HTTP Port",
      "host": "8754",
      "container": "8754",
      "protocol": "tcp",
      "description": "Container Port: 8754",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [
    {
      "name": "RTL-SDR Device",
      "host": "",
      "container": "",
      "description": "Container Device: RTL-SDR",
      "required": true
    }
  ],
  "labels": []
}
