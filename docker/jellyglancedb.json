{
  "name": "jellyglance-db",
  "repo": "postgres:16-alpine",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/_/postgres",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --shm-size=1g",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Nerdy-Technician/JellyGlance/main/.github/assets/icon-b-512.png",
  "project": "https://github.com/Nerdy-Technician/JellyGlance",
  "description": "PostgreSQL 16 companion for JellyGlance. Install on the same custom Docker network as jellyglance, then set JellyGlance POSTGRES_IP to jellyglance-db with matching credentials.",
  "paths": [
    {
      "name": "Database Data",
      "host": "/mnt/cache/appdata/jellyglance/postgres",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "Postgres data directory",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "postgres",
      "description": "Postgres username",
      "required": true,
      "mask": false
    },
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "Postgres password (must match JellyGlance)",
      "required": true,
      "mask": true
    },
    {
      "name": "POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "jellyglance",
      "description": "Database name",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
