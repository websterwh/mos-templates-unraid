{
  "name": "JellEmPlex-Dedupe",
  "repo": "spaceinvaderone/jellemplex-dedupe:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/spaceinvaderone/jellemplex-dedupe",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://github.com/SpaceinvaderOne/JellEmPlex-Dedupe/raw/main/JellEmPlex-Dedupe-logo.png",
  "project": "https://github.com/SpaceinvaderOne/JellEmPlex-Dedupe",
  "description": "JellEmPlex. A dedupe tool for Jellyfin, Emby and Plex",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/JellEmPlex-Dedupe",
      "container": "/app/serverconfig",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3699",
      "container": "80",
      "protocol": "tcp",
      "description": "Webui",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
