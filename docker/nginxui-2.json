{
  "name": "nginx-ui",
  "repo": "uozi/nginx-ui:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/uozi/nginx-ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/nginxui/unraid/main/icon.svg",
  "project": "https://nginxui.com",
  "description": "Official standalone Nginx UI template with bundled Nginx. Nginx configuration, Nginx UI data, and web content are persisted on the Unraid array.",
  "paths": [
    {
      "name": "Nginx UI appdata",
      "host": "/mnt/cache/appdata/nginx-ui",
      "container": "/etc/nginx-ui",
      "mode": "rw",
      "description": "Nginx UI database, settings, and startup secret.",
      "required": true
    },
    {
      "name": "Nginx configuration",
      "host": "/mnt/cache/appdata/nginx-ui/nginx",
      "container": "/etc/nginx",
      "mode": "rw",
      "description": "Bundled Nginx configuration.",
      "required": true
    },
    {
      "name": "Web root",
      "host": "/mnt/cache/appdata/nginx-ui/www",
      "container": "/var/www",
      "mode": "rw",
      "description": "Static website content managed by Nginx UI.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI HTTP port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP port used to open Nginx UI.",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS port",
      "host": "8443",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS port served by the bundled Nginx instance.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": "IANA timezone, for example Europe/Berlin.",
      "required": true,
      "mask": false
    },
    {
      "name": "Disable container self-update",
      "key": "NGINX_UI_IGNORE_DOCKER_SOCKET",
      "value": "true",
      "description": "Unraid manages image updates; keep the Docker socket disabled.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
