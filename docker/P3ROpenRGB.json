{
  "name": "P3R-OpenRGB",
  "repo": "p3rco/openrgb:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/repository/docker/p3rco/openrgb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5800]/",
  "icon": "https://raw.githubusercontent.com/P3R-CO/unraid/master/OpenRGB-P3R-256px.png",
  "project": "https://github.com/P3R-CO/openrgb-container",
  "description": "A simple container that opens OpenRGB in a browser so that you can control all of your System lighting while still running UnraidOS. OpenRGB is an Open source RGB lighting control that doesn't depend on manufacturer software. ASUS, ASRock, Corsair, G.Skill, Gigabyte, HyperX, MSI, Razer, ThermalTake, and more are currently supported. WARNING! This project provides a tool to probe the SMBus. This is a potentially dangerous operation if you don't know what you're doing. Exercise caution when clicking the Detect Devices or Dump Device buttons. There have been reports of Gigabyte motherboards having serious issues (bricking the RGB or bricking the entire board) when dumping certain devices. On the same lines, exercise the same caution when using the i2cdump and i2cdetect commands on Linux, as they perform the same functionality. OpenRGB is not liable for damage caused by improper SMBus access. As of now, only Gigabyte RGB Fusion 2.0 boards have been reported to have issues.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/P3R-OpenRGB/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "5800",
      "container": "5800",
      "protocol": "tcp",
      "description": "Container Port: 5800",
      "required": true,
      "mask": false
    },
    {
      "name": "VNC Port",
      "host": "5900",
      "container": "5900",
      "protocol": "tcp",
      "description": "Container Port: 5900",
      "required": false,
      "mask": false
    },
    {
      "name": "SDK Server Port",
      "host": "6742",
      "container": "6742",
      "protocol": "tcp",
      "description": "Container Port: 6742",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VNC Password",
      "key": "VNC_PASSWORD",
      "value": "",
      "description": "Set New VNC Password",
      "required": false,
      "mask": false
    },
    {
      "name": "Default Profile",
      "key": "DEFAULT_PROFILE",
      "value": "default.orp",
      "description": "Set Default Profile",
      "required": false,
      "mask": false
    },
    {
      "name": "USER ID",
      "key": "USER_ID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "GROUP ID",
      "key": "GROUP_ID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "SYS I2C",
      "host": "/sys/bus/i2c/devices",
      "container": "",
      "description": null,
      "required": true
    },
    {
      "name": "DEV I2C",
      "host": "/dev/i2c-0",
      "container": "",
      "description": null,
      "required": true
    }
  ],
  "labels": []
}
