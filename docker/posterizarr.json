{
  "name": "posterizarr",
  "repo": "ghcr.io/fscorrupt/posterizarr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/fscorrupt/posterizarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 099:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/fscorrupt/Posterizarr/refs/heads/main/docs/images/webhook.png",
  "project": "https://github.com/fscorrupt/Posterizarr",
  "description": "Automated poster maker for Plex/Jellyfin/Emby with a full Web UI.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/posterizarr",
      "container": "/config",
      "mode": "rw",
      "description": "Storage for config files",
      "required": true
    },
    {
      "name": "Asset Path",
      "host": "/mnt/cache/appdata/posterizarr/assets",
      "container": "/assets",
      "mode": "rw",
      "description": "Storage for assets",
      "required": true
    },
    {
      "name": "Manual Asset Path",
      "host": "/mnt/cache/appdata/posterizarr/manualassets",
      "container": "/manualassets",
      "mode": "rw",
      "description": "Storage for manual assets",
      "required": true
    },
    {
      "name": "Backup Path",
      "host": "/mnt/cache/appdata/posterizarr/assetsbackup",
      "container": "/assetsbackup",
      "mode": "rw",
      "description": "Storage for asset backups",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port for the Web UI. Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Run time",
      "key": "RUN_TIME",
      "value": "disabled",
      "description": "[Advanced] Set the run time (e.g., 00:00) or set to 'disabled' to use the Web UI scheduler (recommended).",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "TERM",
      "key": "TERM",
      "value": "xterm",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "ARR_WAIT_TIME",
      "key": "ARR_WAIT_TIME",
      "value": "",
      "description": "Wait time for Arr services (optional).",
      "required": false,
      "mask": false
    },
    {
      "name": "Internal App Port",
      "key": "APP_PORT",
      "value": "8000",
      "description": "The internal port the Web UI listens on. Default is 8000. Change this to a different port (e.g. 9000) if you are routing this container through a VPN like Gluetun, as Gluetun already uses port 8000 internally.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
