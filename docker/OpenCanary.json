      "container": "22",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "telnet",
      "host": "23",
      "container": "23",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "https",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
