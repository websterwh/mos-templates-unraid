  "registry": "https://hub.docker.com/r/imthai/opencanary",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/thinkst/opencanary/blob/master/docs/logo.png?raw=1",
  "project": "https://github.com/thinkst/opencanary",
  "description": "OpenCanary is a multi-protocol network honeypot. It's primary use-case is to catch hackers after they've breached non-public networks. It has extremely low resource requirements and can be tweaked, modified, and extended. !! It is obviously recommended to use a dedicated IP for this container so as not to have port conflicts used. The following services are enabled by default: telnet ssh http https",
  "paths": [
    {
