{
  "name": "CUPS-Virtual-PDF-Printer",
  "repo": "fxqq/cups-virtual-pdf-printer:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/fxqq/cups-virtual-pdf-printer",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:631",
  "icon": "https://raw.githubusercontent.com/fxqq/cups-virtual-pdf-printer/main/icon.png",
  "project": "https://github.com/fxqq/cups-virtual-pdf-printer",
  "description": "\u8f7b\u91cf\u7ea7\u5c40\u57df\u7f51\u865a\u62df PDF \u6253\u5370\u673a\u3002\u652f\u6301\u4ece\u4efb\u4f55\u8bbe\u5907\uff08\u5305\u62ec\u5b89\u5353\u5e73\u677f\u3001\u5b66\u4e60\u673a\u7b49\uff09\u6253\u5370\uff0c\u81ea\u52a8\u4fdd\u5b58\u4e3a PDF \u6587\u4ef6\u3002\u5185\u7f6e mDNS/Bonjour \u81ea\u52a8\u53d1\u73b0\uff0c\u8bbe\u5907\u53ef\u76f4\u63a5\u641c\u7d22\u5230\u6253\u5370\u673a\u3002 A lightweight virtual PDF printer for LAN environments. Print from any device (including Android tablets, learning machines, etc.) and automatically save output as PDF files. Built-in mDNS/Bonjour auto-discovery.",
  "paths": [
    {
      "name": "PDF Output Directory",
      "host": "/mnt/cache/cups-pdf",
      "container": "/var/spool/cups-pdf/ANONYMOUS",
      "mode": "rw",
      "description": "PDF \u6587\u4ef6\u4fdd\u5b58\u76ee\u5f55",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "CUPS Admin Username",
      "key": "CUPSADMIN",
      "value": "admin",
      "description": "CUPS \u7ba1\u7406\u754c\u9762\u7528\u6237\u540d",
      "required": false,
      "mask": false
    },
    {
      "name": "CUPS Admin Password",
      "key": "CUPSPASSWORD",
      "value": "admin",
      "description": "CUPS \u7ba1\u7406\u754c\u9762\u5bc6\u7801",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
