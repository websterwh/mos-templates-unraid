{
  "name": "pgvector-14",
  "repo": "pgvector/pgvector:pg14",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/pgvector/pgvector",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/pgvector-icon.png",
  "project": "https://github.com/pgvector/pgvector",
  "description": "Open-source vector similarity search for Postgres.",
  "paths": [
    {
      "name": "Database Storage Path",
      "host": "/mnt/cache/appdata/pgvector14",
      "container": "/var/lib/postgresql",
      "mode": "rw",
      "description": "Path to store database files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "Container Port: 5432",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Username",
      "key": "POSTGRES_USER",
      "value": "",
      "description": "PostgreSQL superuser name",
      "required": true,
      "mask": false
    },
    {
      "name": "Password",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "PostgreSQL superuser password",
      "required": true,
      "mask": true
    },
    {
      "name": "Database Name",
      "key": "POSTGRES_DB",
      "value": "",
      "description": "Initial database name",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
