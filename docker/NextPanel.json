{
  "name": "NextPanel",
  "repo": "kirantheram/nextpanel:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/kirantheram/nextpanel",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6995]/",
  "icon": "https://raw.githubusercontent.com/KiranTheRam/NextPanel/main/frontend/public/nextpanel-icon-192.png",
  "project": "https://github.com/KiranTheRam/NextPanel",
  "description": "Let users request manga and comics, approve them in one place, and send approved titles to Mangarr or Pullarr.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/nextpanel",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent database, sessions, and settings.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "6995",
      "container": "6995",
      "protocol": "tcp",
      "description": "NextPanel web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Secure Session Cookie",
      "key": "NEXTPANEL_SESSION_COOKIE_SECURE",
      "value": "false",
      "description": "False for direct local HTTP access. Set true when NextPanel is served over HTTPS, especially for remote access.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
