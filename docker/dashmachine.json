{
  "name": "dashmachine",
  "repo": "rmountjoy/dashmachine:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/rmountjoy/dashmachine/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/dashmachine.png",
  "project": "https://hub.docker.com/r/rmountjoy/dashmachine/",
  "description": "Another web application bookmark dashboard, with fun features. Default user/password User: admin Password: admin",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/dashmachine/",
      "container": "/dashmachine/dashmachine/user_data",
      "mode": "rw",
      "description": "Container Path: /dashmachine/dashmachine/user_data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
