{
  "name": "Icecast",
  "repo": "infiniteproject/icecast",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/infiniteproject/icecast/",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://rockhost.com/wp-content/uploads/2018/11/icecast-server-hosting-cdn.jpg",
  "project": "https://github.com/maschhoff/docker/tree/master/icecast",
  "description": "Icecast for Mopidy http stream setup mopidy audio docker: mopidy.conf [audio] output = lamemp3enc ! shout2send async=false mount=mopidy ip=XX.XX.XX.XX port=8000 password=hackme NOTE: Please download the icecast.xml and void.mp3 from https://github.com/maschhoff/docker/tree/master/icecast change username and password etc. there",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/icecast/icecast.xml",
      "container": "/etc/icecast.xml",
      "mode": "rw",
      "description": "Container Path: /etc/icecast.xml",
      "required": false
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/icecast/void.mp3",
      "container": "/usr/share/icecast/web/void.mp3",
      "mode": "rw",
      "description": "Container Path: /void.mp3",
      "required": false
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
