{
  "name": "monitorss-bot",
  "repo": "synzen/monitorss",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/synzen/monitorss",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/monitorss.png",
  "project": "https://github.com/synzen/MonitoRSS",
  "description": "Discord RSS bot (formerly known as Discord.RSS) with customizable feeds. Requires a separate container for MongoDB. Also has a optional WebUI More configuration options available on [monitorss.xyz](https://docs.monitorss.xyz/configuration/bot-configuration)",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "BOT_PREFIX",
      "key": "DRSS_BOT_PREFIX",
      "value": "\\",
      "description": "Information here https://docs.monitorss.xyz/configuration/bot-configuration#bot",
      "required": true,
      "mask": false
    },
    {
      "name": "TOKEN",
      "key": "DRSS_BOT_TOKEN",
      "value": "22222222222",
      "description": "Information here https://docs.monitorss.xyz/configuration/bot-configuration#bot",
      "required": true,
      "mask": true
    },
    {
      "name": "DATABASE_URI",
      "key": "DRSS_DATABASE_URI",
      "value": "mongodb://[REPLACE-WITH-IP]:27017/drss",
      "description": "Information here https://docs.monitorss.xyz/configuration/web-interface#database",
      "required": true,
      "mask": false
    },
    {
      "name": "Component",
      "key": "DRSS_START",
      "value": "bot",
      "description": "Do not change",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
