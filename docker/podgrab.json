{
  "name": "podgrab",
  "repo": "akhilrex/podgrab",
  "category": [
    "Downloader"
  ],
  "registry": "http://hub.docker.com/akhilrex/podgrab/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": null,
  "project": "https://github.com/akhilrex/podgrab",
  "description": "A self-hosted podcast manager to download episodes as soon as they become live",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    },
    {
      "name": "Assets",
      "host": "",
      "container": "/assets",
      "mode": "rw",
      "description": "Location for the podcasts",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Check Frequency",
      "key": "CHECK_FREQUENCY",
      "value": "240",
      "description": "Container Variable: CHECK_FREQUENCY",
      "required": true,
      "mask": false
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": "",
      "description": "When set, the default password is `podgrab`",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
