{
  "name": "tvhproxy",
  "repo": "knex666/tvhproxy:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/maschhoff/TVHProxy",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5004]",
  "icon": "https://freepngimg.com/icon/download/temp_icon/9311-television-color_64x64.ico",
  "project": "https://github.com/maschhoff/TVHProxy",
  "description": "TVHProxy provides an HTTP proxy for Tvheadend streams and exposes them through a simple HTTP interface. It can be used by clients that require a direct HTTP stream endpoint instead of communicating directly with Tvheadend.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/tvhproxy/",
      "container": "/data/",
      "mode": "rw",
      "description": "Persistent storage for TVHProxy data and EPG cache.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TVH URL",
      "key": "TVH_URL",
      "value": "http://IP:9981",
      "description": "URL of the Tvheadend server, including port 9981.",
      "required": true,
      "mask": false
    },
    {
      "name": "TVH Proxy Port",
      "key": "TVH_PROXY_PORT",
      "value": "5004",
      "description": "Port on which TVHProxy listens.",
      "required": true,
      "mask": false
    },
    {
      "name": "TVH Profile",
      "key": "TVH_PROFILE",
      "value": "pass",
      "description": "Tvheadend streaming profile.",
      "required": true,
      "mask": false
    },
    {
      "name": "TVH User",
      "key": "TVH_USER",
      "value": "",
      "description": "Optional Tvheadend username.",
      "required": false,
      "mask": false
    },
    {
      "name": "TVH Password",
      "key": "TVH_PASSWORD",
      "value": "",
      "description": "Optional Tvheadend password.",
      "required": false,
      "mask": true
    },
    {
      "name": "TVH Proxy URL",
      "key": "TVH_PROXY_URL",
      "value": "http://127.0.0.1:5004",
      "description": "Internal URL used by TVHProxy.",
      "required": false,
      "mask": false
    },
    {
      "name": "Device ID",
      "key": "DEVICE_ID",
      "value": "TVHP0001",
      "description": "Unique UPnP/device identifier.",
      "required": false,
      "mask": false
    },
    {
      "name": "TVH Tuner Count",
      "key": "TVH_TUNER_COUNT",
      "value": "1",
      "description": "Number of tuners presented by the proxy.",
      "required": false,
      "mask": false
    },
    {
      "name": "TVH Weight",
      "key": "TVH_WEIGHT",
      "value": "300",
      "description": "TVHProxy tuner/device weight.",
      "required": false,
      "mask": false
    },
    {
      "name": "TVH Chunk Size",
      "key": "TVH_CHUNK_SIZE",
      "value": "1048576",
      "description": "Streaming chunk size in bytes.",
      "required": false,
      "mask": false
    },
    {
      "name": "TVH Cache File",
      "key": "TVH_CACHE_FILE",
      "value": "/data/epg.xml",
      "description": "Location of the cached EPG XML file inside the container.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
