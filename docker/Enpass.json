{
  "name": "Enpass",
  "repo": "ghcr.io/ich777/enpass",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ich777/enpass",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/vnc.html?autoconnect=true",
  "icon": "https://raw.githubusercontent.com/ich777/docker-templates/master/ich777/images/enpass.png",
  "project": "https://www.enpass.io/",
  "description": "Enpass is a cross-platform password management app to securely store passwords and other credentials in a virtual vault locked with a master password. Unlike most other popular password managers, Enpass is an offline password manager. The app does not store user data on its servers, but locally on their own devices, encrypted. Users can choose to synchronize their data between different devices using their own preferred cloud storage service like Google Drive, Box, Dropbox, OneDrive, iCloud, and WebDAV.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/enpass",
      "container": "/enpass",
      "mode": "rw",
      "description": "Data Directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebGUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "TCP noVNC WebGUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Custom Screen Height",
      "key": "CUSTOM_RES_H",
      "value": "768",
      "description": "Minimum screen hight 768 pixels",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": "Container Variable: UMASK",
      "required": true,
      "mask": false
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": "Container Variable: UID",
      "required": true,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": "Container Variable: GID",
      "required": true,
      "mask": false
    },
    {
      "name": "DATA_PERM",
      "key": "DATA_PERM",
      "value": "770",
      "description": "Container Variable: DATA_PERM",
      "required": true,
      "mask": false
    },
    {
      "name": "Custom Screen Width",
      "key": "CUSTOM_RES_W",
      "value": "1024",
      "description": "Minimum screen width 1024 pixels",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
