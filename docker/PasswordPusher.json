{
  "name": "PasswordPusher",
  "repo": "pglombardo/pwpush-postgres",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/pglombardo/pwpush-postgres/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5100]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/passwordpusher.png",
  "project": "https://github.com/pglombardo/PasswordPusher",
  "description": "This version requires a separate PostgreSQL container. PasswordPusher or PWPush is an opensource application to communicate passwords over the web. Links to passwords expire after a certain number of views and/or time has passed.",
  "paths": [],
  "ports": [
    {
      "name": "Web Interface",
      "host": "51U00",
      "container": "5100",
      "protocol": "tcp",
      "description": "Container Port: 5100",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PostgreSQL Database",
      "key": "DATABASE_URL",
      "value": "postgresql://pwpush_user:pwpush_pass@pgsql_server:5432/pwpush_db",
      "description": "Format: postgresql://username:password@server:port/database",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
