{
  "name": "zappiti-server",
  "repo": "theimmortal/zappiti-server",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/theimmortal/zappiti-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--hostname=zappiti-server --restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8777]",
  "icon": "https://raw.githubusercontent.com/theimmortal68/zappiti-server-docker/main/zappiti-server.png",
  "project": "https://github.com/theimmortal68/zappiti-server-docker",
  "description": "Docker container to install and run Zappiti Server app as a local Cloud to manage your library using your Unraid server. Your files used for the collection are saved only on your machine.",
  "paths": [
    {
      "name": "Application Data",
      "host": "/mnt/cache/appdata/zappiti/bin",
      "container": "/app/bin",
      "mode": "rw,slave",
      "description": null,
      "required": true
    },
    {
      "name": "User Data",
      "host": "/mnt/cache/appdata/zappiti/data",
      "container": "/app/data",
      "mode": "rw,slave",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8777",
      "container": "8777",
      "protocol": "tcp",
      "description": "Container Port: 8777",
      "required": true,
      "mask": false
    },
    {
      "name": "Autodiscovery Port",
      "host": "8777",
      "container": "8777",
      "protocol": "udp",
      "description": "Container Port: 8777",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
