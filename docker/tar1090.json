{
  "name": "tar1090",
  "repo": "mikenye/tar1090:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/mikenye/tar1090/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/tar1090.png",
  "project": "https://hub.docker.com/r/mikenye/tar1090",
  "description": "Multi-arch tar1090 container for visualising ADSB data.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8078",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "BEASTHOST",
      "key": "BEASTHOST",
      "value": "&lt;BEASTHOST&gt;",
      "description": "You will need a source of Beast data. This could be an RPi running PiAware, the mikenye/piaware image or mikenye/readsb.",
      "required": true,
      "mask": false
    },
    {
      "name": "MLATHOST",
      "key": "MLATHOST",
      "value": "&lt;MLATHOST&gt;",
      "description": "IP address of a host that can provide MLAT data.",
      "required": true,
      "mask": false
    },
    {
      "name": "LAT",
      "key": "LAT",
      "value": "xx.xxxxx",
      "description": "Latitude",
      "required": true,
      "mask": false
    },
    {
      "name": "LONG",
      "key": "LONG",
      "value": "xx.xxxxx",
      "description": "Longitude",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
