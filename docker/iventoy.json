{
  "name": "iventoy",
  "repo": "devzwf/iventoy:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/devzwf/iventoy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:26000]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/iventoy.png",
  "project": "https://www.iventoy.com/en/index.html",
  "description": "iVentoy is an enhanced version of the PXE server. With iVentoy you can boot and install OS on multiple machines at the same time through the network. iVentoy is extremely easy to use, without complicated configuration, just put the ISO file in the specified location and select PXE boot in the client machine. iVentoy supports x86 Legacy BIOS, IA32 UEFI, x86_64 UEFI and ARM64 UEFI mode at the same time. iVentoy support 110+ common types of OS (Windows/WinPE/Linux/VMware)",
  "paths": [
    {
      "name": "Config dir",
      "host": "/mnt/cache/appdata/iventoy/config",
      "container": "/app/data",
      "mode": "rw",
      "description": "Config Dir",
      "required": true
    },
    {
      "name": "Isos dir",
      "host": "/mnt/cache/isos/",
      "container": "/app/iso",
      "mode": "rw",
      "description": "Isos Directory",
      "required": true
    },
    {
      "name": "Log dir",
      "host": "/mnt/cache/appdata/iventoy/log",
      "container": "/app/log",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "User dir",
      "host": "/mnt/cache/appdata/iventoy/user",
      "container": "/app/user",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "TFTP Server Port",
      "host": "69",
      "container": "69",
      "protocol": "udp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "WEB UI",
      "host": "26000",
      "container": "26000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PXE HTTP port",
      "host": "16000",
      "container": "16000",
      "protocol": "tcp",
      "description": "iVentoy PXE Service HTTP Server Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
