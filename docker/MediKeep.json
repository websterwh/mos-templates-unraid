{
  "name": "MediKeep",
  "repo": "ghcr.io/afairgiant/medikeep:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/afairgiant/MediKeep/main/docs/assets/Icon.png",
  "project": "https://github.com/afairgiant/MediKeep",
  "description": "MediKeep - Your personal health record keeper with React frontend and FastAPI backend. Provides secure patient record management, and medical history tracking.",
  "paths": [
    {
      "name": "Uploads",
      "host": "/mnt/cache/appdata/medikeep/uploads",
      "container": "/app/uploads",
      "mode": "rw",
      "description": "Path to store uploaded files",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/medikeep/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Path to store application logs",
      "required": false
    },
    {
      "name": "Backups",
      "host": "/mnt/cache/appdata/medikeep/backups",
      "container": "/app/backups",
      "mode": "rw",
      "description": "Path to store database backups",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port for accessing the web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database Host",
      "key": "DB_HOST",
      "value": "postgres",
      "description": "PostgreSQL database hostname or IP",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Port",
      "key": "DB_PORT",
      "value": "5432",
      "description": "PostgreSQL database port",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Name",
      "key": "DB_NAME",
      "value": "medical_records",
      "description": "PostgreSQL database name",
      "required": true,
      "mask": false
    },
    {
      "name": "Database User",
      "key": "DB_USER",
      "value": "medapp",
      "description": "PostgreSQL database username",
      "required": true,
      "mask": false
    },
    {
      "name": "Database Password",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "PostgreSQL database password",
      "required": true,
      "mask": true
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Secret key for JWT tokens (generate a random string)",
      "required": true,
      "mask": true
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO",
      "description": "Logging level (DEBUG/INFO/WARNING/ERROR)",
      "required": false,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Timezone for the application",
      "required": false,
      "mask": false
    },
    {
      "name": "Enable SSL",
      "key": "ENABLE_SSL",
      "value": "false",
      "description": "Enable HTTPS/SSL (requires certificate setup)",
      "required": false,
      "mask": false
    },
    {
      "name": "SSO Provider Type",
      "key": "SSO_PROVIDER_TYPE",
      "value": "oidc",
      "description": "SSO Provider Type (oidc/saml)",
      "required": false,
      "mask": false
    },
    {
      "name": "SSO Issuer URL",
      "key": "SSO_ISSUER_URL",
      "value": "",
      "description": "SSO Issuer/Provider URL",
      "required": false,
      "mask": false
    },
    {
      "name": "SSO Redirect URI",
      "key": "SSO_REDIRECT_URI",
      "value": "",
      "description": "SSO Redirect URI",
      "required": false,
      "mask": false
    },
    {
      "name": "SSO Allowed Domains",
      "key": "SSO_ALLOWED_DOMAINS",
      "value": "[]",
      "description": "SSO Allowed Domains (JSON array)",
      "required": false,
      "mask": false
    },
    {
      "name": "SSO Enabled",
      "key": "SSO_ENABLED",
      "value": "false",
      "description": "Enable Single Sign-On",
      "required": false,
      "mask": false
    },
    {
      "name": "SSO Client ID",
      "key": "SSO_CLIENT_ID",
      "value": "",
      "description": "SSO Client ID (if SSO enabled)",
      "required": false,
      "mask": false
    },
    {
      "name": "SSO Client Secret",
      "key": "SSO_CLIENT_SECRET",
      "value": "",
      "description": "SSO Client Secret (if SSO enabled)",
      "required": false,
      "mask": true
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
