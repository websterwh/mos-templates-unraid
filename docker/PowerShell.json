{
  "name": "PowerShell",
  "repo": "mcr.microsoft.com/powershell:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/mcr.microsoft.com/powershell",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "pwsh",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/powershell-icon.png",
  "project": "https://learn.microsoft.com/en-us/powershell/scripting/install/powershell-in-docker",
  "description": "A Docker container with PowerShell pre-installed. Useful for running PowerShell scripts. This is a CLI tool. Please edit the **Post Arguments** accordingly.",
  "paths": [
    {
      "name": "Scripts Path",
      "host": "/mnt/cache/appdata/powershell/scripts",
      "container": "/scripts",
      "mode": "rw",
      "description": "Path to your PowerShell scripts directory",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
