{
  "name": "Crontab",
  "repo": "willfarrell/crontab:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/willfarrell/crontab",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/crontab-icon.png",
  "project": "https://github.com/willfarrell/docker-crontab",
  "description": "A simple wrapper over the Docker CLI to all complex cron job to be run in other containers.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/crontab/config",
      "container": "/opt/crontab",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/crontab/logs",
      "container": "/var/log/crontab",
      "mode": "rw",
      "description": "Path to logs",
      "required": true
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
