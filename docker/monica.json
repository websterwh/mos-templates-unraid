{
  "name": "monica",
  "repo": "lscr.io/linuxserver/monica",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/monica",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/monica-logo.png",
  "project": "https://github.com/monicahq/monica",
  "description": "Monica(https://github.com/monicahq/monica) is an open source personal relationship management system, that lets you document your life.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "http gui",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 443",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "https gui",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "Mariadb DB server hostname.",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "",
      "description": "Mariadb DB server port.",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": "",
      "description": "Mariadb DB user.",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "Mariadb DB password.",
      "required": true,
      "mask": true
    },
    {
      "name": "DB_DATABASE",
      "key": "DB_DATABASE",
      "value": "",
      "description": "Mariadb DB name.",
      "required": true,
      "mask": false
    },
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "http://localhost:80",
      "description": "The URL you will use to access Monica including protocol, and port where appropriate.",
      "required": false,
      "mask": false
    },
    {
      "name": "TRUSTED_PROXIES",
      "key": "TRUSTED_PROXIES",
      "value": "",
      "description": "Set to the IP or netmask covering your reverse proxy, if running behind one. Set to `*` to trust all IPs (**do not** use `*` if exposed to the internet`).",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_ENV",
      "key": "APP_ENV",
      "value": "local",
      "description": "Set to `production` when exposing the container to anyone else; this also makes https mandatory.",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_DISABLE_SIGNUP",
      "key": "APP_DISABLE_SIGNUP",
      "value": "true",
      "description": "Set to `false` to enable new account sign-ups.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
