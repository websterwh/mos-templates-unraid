{
  "name": "ts-dnsserver",
  "repo": "roxedus/ts-dnsserver",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/roxedus/ts-dnsserver/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5380]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/Technitium.png",
  "project": "https://github.com/TechnitiumSoftware/DnsServer",
  "description": "DEPRECATED, use technitium/dns-server instead",
  "paths": [
    {
      "name": "App data",
      "host": "/mnt/cache/appdata/ts-dnsserver",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5380",
      "container": "5380",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": false,
      "mask": false
    },
    {
      "name": "DNS Port",
      "host": "53",
      "container": "53",
      "protocol": "udp",
      "description": "Container Port: 53",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID 99",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
