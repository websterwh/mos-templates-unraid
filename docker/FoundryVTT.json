{
  "name": "FoundryVTT",
  "repo": "gitea.fithwum.tech/fithwum/foundry_vtt:alpine",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/fithwum/foundry_vtt/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:30000]",
  "icon": "https://gitea.fithwum.tech/fithwum/files-for-dockers/raw/branch/master/icons/d20.png",
  "project": "https://foundryvtt.com/",
  "description": "FoundryVTT is a web based Dungeons and Dragons application that allows users to play with others over the internet. You will have to purchase a copy of foundryvtt from https://foundryvtt.com Configuration /FoundryVTT is where all configuration files and data will be. You will have to purchase a copy of foundryvtt from https://foundryvtt.com then download the linux version and unpack it to the fvtt folder. Connect to the server using the host IP address and port 30000 once connected it will ask you for a licence code. Notes If you run into permission problems with some files simply restart the docker and it will fix itself. i am working on a propor fix for this problem",
  "paths": [
    {
      "name": "Data Path",
      "host": "",
      "container": "/foundry/data",
      "mode": "rw",
      "description": "Container Path: /foundry/data",
      "required": true
    },
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/FoundryVTT",
      "container": "/foundry/fvtt",
      "mode": "rw",
      "description": "Container Path: /foundry/fvtt",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "30000",
      "container": "30000",
      "protocol": "tcp",
      "description": "Container Port: 30000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "FoundryVTT Version",
      "key": "FOUNDRYVTT_VERSION",
      "value": "13.351",
      "description": "Pick your FoundryVTT version.",
      "required": true,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 3",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
