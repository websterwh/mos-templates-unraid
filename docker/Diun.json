{
  "name": "Diun",
  "repo": "crazymax/diun:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/crazymax/diun",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/crazy-max/diun/master/.res/diun.png",
  "project": "https://crazymax.dev/diun",
  "description": "Diun is a CLI application to receive notifications when a Docker image is updated on a Docker registry. Requires a configuration file at the Config File path: https://crazymax.dev/diun/config/#configuration-file",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/diun/diun.yml",
      "container": "/diun.yml",
      "mode": "ro",
      "description": "Path to the Diun configuration file",
      "required": true
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/diun/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path where Diun should store its data",
      "required": true
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "info|error|debug",
      "description": "Log level",
      "required": true,
      "mask": false
    },
    {
      "name": "Log JSON",
      "key": "LOG_JSON",
      "value": "false|true",
      "description": "Enable JSON logging",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
