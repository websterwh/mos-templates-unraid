{
  "name": "double-take",
  "repo": "skrashevich/double-take:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/skrashevich/double-take/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/corgan2222/unraid-templates/main/img/double-take.png",
  "project": "https://github.com/skrashevich/double-take",
  "description": "Unified UI and API for processing and training images for facial recognition.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/double-take",
      "container": "/.storage",
      "mode": "rw",
      "description": "Container Path: /.storage",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI HTTP Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
