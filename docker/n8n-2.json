{
  "name": "n8n",
  "repo": "docker.n8n.io/n8nio/n8n",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/docker.n8n.io/n8nio/n8n",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5678]/",
  "icon": "https://raw.githubusercontent.com/Balya/unraid-templates/main/n8n/icon-512.png",
  "project": "https://community.n8n.io",
  "description": "n8n \u2013 workflow automation tool",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/n8n",
      "container": "/home/node/.n8n",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5678",
      "container": "5678",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "GENERIC_TIMEZONE",
      "key": "GENERIC_TIMEZONE",
      "value": "Europe/Kaliningrad",
      "description": "The n8n instance timezone. Important for schedule nodes (such as Cron).",
      "required": false,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Kaliningrad",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS",
      "key": "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS",
      "value": "true",
      "description": "Set to true to try to set 0600 permissions for the settings file, giving only the owner read and write access.",
      "required": false,
      "mask": false
    },
    {
      "name": "N8N_RUNNERS_ENABLED",
      "key": "N8N_RUNNERS_ENABLED",
      "value": "true",
      "description": "Are task runners enabled.",
      "required": false,
      "mask": false
    },
    {
      "name": "N8N_SECURE_COOKIE",
      "key": "N8N_SECURE_COOKIE",
      "value": "true",
      "description": "Ensures that cookies are only sent over HTTPS, enhancing security.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
