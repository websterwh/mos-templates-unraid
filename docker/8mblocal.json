{
  "name": "8mb-local",
  "repo": "jms1717/8mblocal",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/jms1717/8mblocal/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8001]",
  "icon": "https://github.com/brockbreacher/images-for-projects/blob/main/8mblocallogo.svg?raw=1",
  "project": "https://8mb.campuscal.tech/",
  "description": "a local self hosted webui version of 8mb.video https://github.com/JMS1717/8mb.local https://hub.docker.com/r/jms1717/8mblocal/ GPU SUPPORT: Add --gpus all to Extra Parameters NVIDIA USERS: Also make sure you have the Nvidia driver plugin installed, then place \"compute,video,utility\" in the NVIDIA_DRIVER_CAPABILITIES option below",
  "paths": [
    {
      "name": "Uploads Temp",
      "host": "/mnt/cache/appdata/8mb/uploads/",
      "container": "/uploads",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Outputs Temp",
      "host": "/mnt/cache/appdata/8mb/outputs/",
      "container": "/outputs",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "",
      "description": "Add",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTH_ENABLED",
      "key": "AUTH_ENABLED",
      "value": "FALSE",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "AUTH_USER",
      "key": "AUTH_USER",
      "value": "admin",
      "description": "Username",
      "required": false,
      "mask": false
    },
    {
      "name": "AUTH_PASS",
      "key": "AUTH_PASS",
      "value": "",
      "description": "Password",
      "required": false,
      "mask": true
    },
    {
      "name": "FILE_RETENTION_HOURS",
      "key": "FILE_RETENTION_HOURS",
      "value": "1",
      "description": "Hours before temp video files are wiped from storage.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
