      "value": "600000",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DEFAULT_BLOCK_ADS",
      "key": "DEFAULT_BLOCK_ADS",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DEFAULT_STEALTH",
      "key": "DEFAULT_STEALTH",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    }
