{
  "name": "browserless",
  "repo": "browserless/chrome",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/browserless/chrome/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --shm-size=2G",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/masterwishx/unraid-templates/main/images/browserless_logo.png",
  "project": "https://github.com/browserless/chrome",
  "description": "browserless is a web-service that allows for remote clients to connect, drive, and execute headless work; all inside of docker. It offers first-class integrations for puppeteer, playwright, selenium's webdriver, and a slew of handy REST APIs for doing more common work. This docker is needed for changedetection.io for Playwright content fetcher. more read here: https://github.com/dgtlmoon/changedetection.io/wiki/Playwright-content-fetcher https://docs.browserless.io/docs/docker-quickstart.html Docker size about 910Mb. add this var after install to your changedetection.io: PLAYWRIGHT_DRIVER_URL=ws://yourIP:yourPORT/?stealth=1&--disable-web-security=true",
  "paths": [],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SCREEN_WIDTH",
      "key": "SCREEN_WIDTH",
      "value": "2560",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SCREEN_HEIGHT",
      "key": "SCREEN_HEIGHT",
      "value": "1440",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SCREEN_DEPTH",
      "key": "SCREEN_DEPTH",
      "value": "16",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "CONNECTION_TIMEOUT",
      "key": "CONNECTION_TIMEOUT",
      "value": "300000",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ENABLE_DEBUGGER",
      "key": "ENABLE_DEBUGGER",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PREBOOT_CHROME",
      "key": "PREBOOT_CHROME",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MAX_CONCURRENT_SESSIONS",
      "key": "MAX_CONCURRENT_SESSIONS",
      "value": "10",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "CHROME_REFRESH_TIME",
