{
  "name": "matomo",
  "repo": "bitnami/matomo:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/bitnami/matomo/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/matomo.png",
  "project": "https://matomo.org/",
  "description": "Matomo is a free and open source web analytics application written by a team of international developers that runs on a PHP/MySQL webserver.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/matomo/",
      "container": "/bitnami",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "HTTP",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MATOMO_DATABASE_HOST",
      "key": "MATOMO_DATABASE_HOST",
      "value": "mariadb",
      "description": "Hostname or IP for MariaDB server.",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_PORT_NUMBER",
      "key": "MATOMO_DATABASE_PORT_NUMBER",
      "value": "3306",
      "description": "Port used by MariaDB server.",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_NAME",
      "key": "MATOMO_DATABASE_NAME",
      "value": "bitnami_matomo",
      "description": "Database name that Matomo will use to connect with the database.",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_USER",
      "key": "MATOMO_DATABASE_USER",
      "value": "bn_matomo",
      "description": "Database user that Matomo will use to connect with the database.",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_PASSWORD",
      "key": "MATOMO_DATABASE_PASSWORD",
      "value": "password",
      "description": "Database password that Matomo will use to connect with the database.",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_USERNAME",
      "key": "MATOMO_USERNAME",
      "value": "User",
      "description": "Matomo application username.",
      "required": false,
      "mask": false
    },
    {
      "name": "MATOMO_HOST",
      "key": "MATOMO_HOST",
      "value": "192.168.0.100",
      "description": "Matomo application host. Change it to your IP",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_PASSWORD",
      "key": "MATOMO_PASSWORD",
      "value": "bitnami",
      "description": "Matomo application password",
      "required": false,
      "mask": false
    },
    {
      "name": "ALLOW_EMPTY_PASSWORD",
      "key": "ALLOW_EMPTY_PASSWORD",
      "value": "no",
      "description": "It can be used to allow blank passwords.",
      "required": true,
      "mask": false
    },
    {
      "name": "PHP_MEMORY_LIMIT",
      "key": "PHP_MEMORY_LIMIT",
      "value": "128M",
      "description": "Memory limit for PHP.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
