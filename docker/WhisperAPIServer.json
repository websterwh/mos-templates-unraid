{
  "name": "Whisper-API-Server",
  "repo": "didmar/whisper-api-server",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/didmar/whisper-api-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/whisper-api-server-icon.png",
  "project": "https://github.com/didmar/whisper-api-server",
  "description": "A drop-in replacement for the OpenAI's Whisper API using the same API but running locally.",
  "paths": [
    {
      "name": "Cache Directory",
      "host": "/mnt/cache/appdata/whisper_api_server/cache",
      "container": "/root/.cache",
      "mode": "rw",
      "description": "Path to the cache directory. This is where models will be stored, which can be quite large.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
