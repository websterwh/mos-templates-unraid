{
  "name": "tabby-web",
  "repo": "ghcr.io/eugeny/tabby-web:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/outlinewiki/outline/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": null,
  "project": "https://tabby.sh",
  "description": "Tabby Web - an SSH/Telnet/Serial client in your browser.",
  "paths": [],
  "ports": [
    {
      "name": "Port HTTP",
      "host": "9090",
      "container": "80",
      "protocol": "tcp",
      "description": "This sets the internal to external port mapping for WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "mysql://root:123@db/tabby",
      "description": "Sets the database location and credentials.",
      "required": true,
      "mask": false
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "false",
      "description": "Turns on/off debugging for the application.",
      "required": true,
      "mask": false
    },
    {
      "name": "Docker Arguments",
      "key": "DOCKERIZE_ARGS",
      "value": "-wait tcp://db:3306 -timeout 60s",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Port",
      "key": "PORT",
      "value": "80",
      "description": "DO NOT CHANGE - This is setting the internal Web UI port for the container.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
