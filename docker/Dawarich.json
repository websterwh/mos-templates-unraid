{
  "name": "Dawarich",
  "repo": "freikin/dawarich:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/freikin/dawarich",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--entrypoint web-entrypoint.sh",
  "post_parameters": "bin/rails server -p 3000 -b ::",
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dawarich-icon.png",
  "project": "https://dawarich.app",
  "description": "A self-hosted web app designed to replace Google Timeline (aka Google Location History). Visualize your data on an interactive map, import your location history from Google Maps Timeline and Owntracks, and explore statistics like the number of countries and cities visited, total distance traveled, and more! Additional optional configuration is available. See available variables: https://github.com/Freika/dawarich/blob/master/docker/.env.example",
  "paths": [
    {
      "name": "Imports Path",
      "host": "/mnt/cache/appdata/dawarich/imports",
      "container": "/var/app/tmp/imports/watched",
      "mode": "rw",
      "description": "Path to watch for imports",
      "required": true
    },
    {
      "name": "Storage Path",
      "host": "/mnt/cache/appdata/dawarich/storage",
      "container": "/var/app/storage",
      "mode": "rw",
      "description": "Path to store application data",
      "required": true
    },
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/dawarich/db_data",
      "container": "/dawarich_db_data",
      "mode": "rw",
      "description": "Path to store database data",
      "required": true
    },
    {
      "name": "Web Files Path",
      "host": "/mnt/cache/appdata/dawarich/wwwroot",
      "container": "/var/app/public",
      "mode": "rw",
      "description": "Path to web files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    },
    {
      "name": "Prometheus Exporter - Port",
      "host": "9394",
      "container": "9394",
      "protocol": "tcp",
      "description": "Container Port: 9394 (optional, for Prometheus monitoring)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Redis URL",
      "key": "REDIS_URL",
      "value": "redis://redis:6379",
      "description": "Redis server URL for background processing",
      "required": true,
      "mask": false
    },
    {
      "name": "PostGIS - Host",
      "key": "DATABASE_HOST",
      "value": "",
      "description": "Host of the PostGIS server",
      "required": true,
      "mask": false
    },
    {
      "name": "PostGIS - Port",
      "key": "DATABASE_PORT",
      "value": "5432",
      "description": "Port of the PostGIS server",
      "required": false,
      "mask": false
    },
    {
      "name": "PostGIS - Username",
      "key": "DATABASE_USERNAME",
      "value": "",
      "description": "Username of the PostGIS server",
      "required": true,
      "mask": false
    },
    {
      "name": "PostGIS - Password",
      "key": "DATABASE_PASSWORD",
      "value": "",
      "description": "Password of the PostGIS server",
      "required": true,
      "mask": true
    },
    {
      "name": "PostGIS - Database",
      "key": "DATABASE_NAME",
      "value": "",
      "description": "Name of the PostGIS database",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TIME_ZONE",
      "value": "UTC",
      "description": "Timezone of the application",
      "required": true,
      "mask": false
    },
    {
      "name": "Minimum City Minutes",
      "key": "MIN_MINUTES_SPENT_IN_CITY",
      "value": "60",
      "description": "Minimum minutes spent in a city to be considered a visit",
      "required": true,
      "mask": false
    },
    {
      "name": "Store Geodata",
      "key": "STORE_GEODATA",
      "value": "true|false",
      "description": "Store geodata in the database",
      "required": true,
      "mask": false
    },
    {
      "name": "Photon API - Host",
      "key": "PHOTON_API_HOST",
      "value": "photon.komoot.io",
      "description": "Host of the Photon API",
      "required": false,
      "mask": false
    },
    {
      "name": "Photon API - Use HTTPS",
      "key": "PHOTON_API_USE_HTTPS",
      "value": "true|false",
      "description": "Use HTTPS for the Photon API",
      "required": false,
      "mask": false
    },
    {
      "name": "Prometheus Exporter - Enable",
      "key": "PROMETHEUS_EXPORTER_ENABLED",
      "value": "false",
      "description": "Enable the Prometheus exporter",
      "required": true,
      "mask": false
    },
    {
      "name": "2FA - OTP Encryption Primary Key",
      "key": "OTP_ENCRYPTION_PRIMARY_KEY",
      "value": "",
      "description": "Required to enable 2FA.",
      "required": false,
      "mask": true
    },
    {
      "name": "2FA - OTP Encryption Deterministic Key",
      "key": "OTP_ENCRYPTION_DETERMINISTIC_KEY",
      "value": "",
      "description": "Required to enable 2FA.",
      "required": false,
      "mask": true
    },
    {
      "name": "2FA - OTP Encryption Key Derivation Salt",
      "key": "OTP_ENCRYPTION_KEY_DERIVATION_SALT",
      "value": "",
      "description": "Required to enable 2FA.",
      "required": false,
      "mask": true
    },
    {
      "name": "Enable Telemetry",
      "key": "ENABLE_TELEMETRY",
      "value": "false|true",
      "description": "Enable telemetry",
      "required": false,
      "mask": false
    },
    {
      "name": "Rails Environment",
      "key": "RAILS_ENV",
      "value": "production",
      "description": "Rails environment. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Application Hosts",
      "key": "APPLICATION_HOSTS",
      "value": "localhost",
      "description": "Hosts of the application",
      "required": true,
      "mask": false
    },
    {
      "name": "Background Processing Concurrency",
      "key": "BACKGROUND_PROCESSING_CONCURRENCY",
      "value": "10",
      "description": "Number of background processing threads",
      "required": true,
      "mask": false
    },
    {
      "name": "Web Concurrency",
      "key": "WEB_CONCURRENCY",
      "value": "1",
      "description": "One preloaded Puma worker is plenty for a household instance and halves idle memory. Raise for busier instances.",
      "required": true,
      "mask": false
    },
    {
      "name": "Application Protocol",
      "key": "APPLICATION_PROTOCOL",
      "value": "http",
      "description": "Protocol of the application",
      "required": true,
      "mask": false
    },
    {
      "name": "Is Self-Hosted",
      "key": "SELF_HOSTED",
      "value": "true|false",
      "description": "Is the application self-hosted?",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
