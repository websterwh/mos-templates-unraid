{
  "name": "NodeCast-TV",
  "repo": "ghcr.io/technomancer702/nodecast-tv:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/technomancer702/nodecast-tv",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/nodecast-tv-icon.png",
  "project": "https://github.com/technomancer702/nodecast-tv",
  "description": "A modern, web-based IPTV player featuring Live TV, EPG, Movies (VOD), and Series support. Built with performance and user experience in mind.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/nodecast_tv/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to the app data folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Node Environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Set the Node environment. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "3000",
      "description": "Internal port used by the application. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
