{
  "name": "Mydia",
  "repo": "ghcr.io/getmydia/mydia:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/getmydia/mydia",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/mydia-icon.png",
  "project": "https://github.com/getmydia/mydia",
  "description": "A modern, self-hosted media management platform for tracking, organizing, and monitoring your media library.",
  "paths": [
    {
      "name": "Movies Path",
      "host": "",
      "container": "/media/movies",
      "mode": "rw",
      "description": "Path to your movies folder on the host system",
      "required": true
    },
    {
      "name": "TV Shows Path",
      "host": "",
      "container": "/media/tv",
      "mode": "rw",
      "description": "Path to your TV shows folder on the host system",
      "required": true
    },
    {
      "name": "Downloads Path",
      "host": "",
      "container": "/media/downloads",
      "mode": "rw",
      "description": "Path to your downloads folder on the host system",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/mydia/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the configuration folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": "Container Port: 4000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Secret Key Base",
      "key": "SECRET_KEY_BASE",
      "value": "",
      "description": "Generate with 'openssl rand -base64 48'",
      "required": true,
      "mask": true
    },
    {
      "name": "Guardian Secret Key",
      "key": "GUARDIAN_SECRET_KEY",
      "value": "",
      "description": "Generate with 'openssl rand -base64 48'",
      "required": true,
      "mask": true
    },
    {
      "name": "Host Domain",
      "key": "PHX_HOST",
      "value": "localhost",
      "description": "Change to your domain or IP address",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "4000",
      "description": "Internal application port. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Movies Path",
      "key": "MOVIES_PATH",
      "value": "/media/movies",
      "description": "Internal path to movies folder. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal TV Shows Path",
      "key": "TV_PATH",
      "value": "/media/tv",
      "description": "Internal path to TV shows folder. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Database Path",
      "key": "DATABASE_PATH",
      "value": "/config/mydia.db",
      "description": "Internal path to the database file. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
