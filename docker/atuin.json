{
  "name": "atuin",
  "repo": "ghcr.io/atuinsh/atuin:100de6e",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/atuinsh/atuin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "start",
  "web_ui_url": "http://[IP]:[PORT:8888]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/atuin-icon.png",
  "project": "https://atuin.sh/",
  "description": "Atuin replaces your existing shell history with a SQLite database, and records additional context for your commands. Additionally, it provides optional and fully encrypted synchronisation of your history between machines, via an Atuin server.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/atuin/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to app data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "Container Port: 8888",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Database Connection",
      "key": "ATUIN_DB_URI",
      "value": "postgres://$ATUIN_DB_USERNAME:$ATUIN_DB_PASSWORD@db/$ATUIN_DB_NAME",
      "description": "Connection string to the database. This is automatically set by the container.",
      "required": true,
      "mask": false
    },
    {
      "name": "Allow Registration",
      "key": "ATUIN_OPEN_REGISTRATION",
      "value": "true|false",
      "description": "Allow new users to register",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Host",
      "key": "ATUIN_HOST",
      "value": "0.0.0.0",
      "description": "Internal host for the Atuin server. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Log",
      "key": "RUST_LOG",
      "value": "info,atuin_server=debug",
      "description": "Log level for the Atuin server. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
