{
  "name": "GoldeneyeSourceServer",
  "repo": "jcoker85/goldeneyesourceserver",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/jcoker85/goldeneyesourceserver",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:27030]",
  "icon": "https://raw.githubusercontent.com/jcoker85/UnraidTemplates/main/Jamxx/images/gsstransparent.png",
  "project": "https://github.com/jcoker85/UnraidGameServers/tree/goldeneyesourceserver",
  "description": "This Docker will download and install SteamCMD. It will also install a Goldeneye Source server and run it. **ATTENTION:** First startup can take a long time since it downloads the server files and installs the runtimes! Update Notice: Simply restart the container if a newer version of the game is available. For more server setup information, please visit: https://docs.geshl2.com/server/",
  "paths": [
    {
      "name": "Server Data",
      "host": "/mnt/cache/appdata/goldeneyesourceserver",
      "container": "/servers/geserver",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "RCON Port",
      "host": "27030",
      "container": "27030",
      "protocol": "tcp",
      "description": "RCON port (see https://developer.valvesoftware.com/wiki/Source_Dedicated_Server)",
      "required": true,
      "mask": false
    },
    {
      "name": "Game Port",
      "host": "27030",
      "container": "27030",
      "protocol": "udp",
      "description": "Game port (see https://developer.valvesoftware.com/wiki/Source_Dedicated_Server)",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Game Parameters",
      "key": "GAME_PARAMS",
      "value": "-port 27030",
      "description": "Enter your start up commands for the server.",
      "required": false,
      "mask": false
    },
    {
      "name": "Map",
      "key": "MAP",
      "value": "ge_depot",
      "description": "Map that server will start on.",
      "required": false,
      "mask": false
    },
    {
      "name": "Max Player Count",
      "key": "MAXPLAYERS",
      "value": "16",
      "description": "Maximum player count allowed on the server.",
      "required": false,
      "mask": false
    },
    {
      "name": "Install Mods",
      "key": "INSTALL_MODS",
      "value": "false",
      "description": "Install Metamod:Source 1.12 and Sourcemod 1.12 automatically.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
