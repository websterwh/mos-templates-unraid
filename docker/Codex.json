{
  "name": "Codex",
  "repo": "ghcr.io/ajslater/codex",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/ajslater/codex/pkgs/container/codex",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9810]/",
  "icon": "https://raw.githubusercontent.com/Saetron/unRAID-CA-templates/refs/heads/main/templates/codex/codex.png",
  "project": "https://github.com/ajslater/codex",
  "description": "Codex is a web server comic book browser and reader.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/codex",
      "container": "/config",
      "mode": "rw",
      "description": "Core application data.",
      "required": true
    },
    {
      "name": "Comics",
      "host": "/mnt/cache/comics",
      "container": "/comics",
      "mode": "ro",
      "description": "Comics directory.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9810",
      "container": "9810",
      "protocol": "tcp",
      "description": "Web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
