{
  "name": "crowdsec-cloudflare-bouncer",
  "repo": "crowdsecurity/cloudflare-bouncer:latest",
  "category": [
    "Security"
  ],
  "registry": "https://registry.hub.docker.com/r/crowdsecurity/cloudflare-bouncer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2112]/metrics",
  "icon": "https://raw.githubusercontent.com/ibracorp/app-logos/main/crowdsec/crowdsec.png",
  "project": "https://github.com/crowdsecurity/cs-cloudflare-bouncer",
  "description": "A bouncer that syncs the decisions made by CrowdSec with CloudFlare's firewall. Manages multi user, multi account, multi zone setup. Supports IP, Country and AS scoped decisions.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/crowdsec/",
      "container": "/etc/crowdsec",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "2112",
      "container": "2112",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
