{
  "name": "umami",
  "repo": "docker.umami.is/umami-software/umami:postgresql-latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/umami-software/umami/pkgs/container/umami",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://github.com/JPDVM2014/umami/blob/main/umami_icon.png?raw=true",
  "project": "https://umami.is/docs/getting-started",
  "description": "Umami is a simple, fast, privacy-focused alternative to Google Analytics. Requires a separate Postgresql container and external access via reverse proxy.",
  "paths": [],
  "ports": [
    {
      "name": "Host Port 2",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgresql://root:password@192.168.1.10:5432/umami",
      "description": "Example: postgresql://username:password@ :[port]/[database_name]",
      "required": true,
      "mask": false
    },
    {
      "name": "DATABASE_TYPE",
      "key": "DATABASE_TYPE",
      "value": "postgresql",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HASH_SALT",
      "key": "HASH_SALT",
      "value": "Change to a random string!",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
