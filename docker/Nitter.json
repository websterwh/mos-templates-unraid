{
  "name": "Nitter",
  "repo": "zedeus/nitter:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/zedeus/nitter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-drop ALL",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/nitter-icon.png",
  "project": "https://nitter.net",
  "description": "A free and open source alternative Twitter front-end focused on privacy and performance.",
  "paths": [
    {
      "name": "Nitter Configuration",
      "host": "",
      "container": "/src/nitter.conf",
      "mode": "ro",
      "description": "Path to Nitter configuration file",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
