{
  "name": "graph-node",
  "repo": "graphprotocol/graph-node",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/graphprotocol/graph-node/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://storage.googleapis.com/graph-web/favicon.png",
  "project": "https://github.com/graphprotocol/graph-node",
  "description": "The Graph is a protocol for building decentralized applications (dApps) quickly on Ethereum and IPFS using GraphQL. Graph Node is an open source Rust implementation that event sources the Ethereum blockchain to deterministically update a data store that can be queried via the GraphQL endpoint. For detailed instructions and more context, check out the Getting Started Guide.",
  "paths": [],
  "ports": [
    {
      "name": "GraphQL interface",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "GraphQL interface",
      "required": true,
      "mask": false
    },
    {
      "name": "JSON-RPC",
      "host": "8020",
      "container": "8020",
      "protocol": "tcp",
      "description": "JSON-RPC admin server.",
      "required": true,
      "mask": false
    },
    {
      "name": "GraphQL WebSocket",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": "GraphQL WebSocket server",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "postgres host",
      "key": "postgres_host",
      "value": "localhost",
      "description": "postgres_host",
      "required": true,
      "mask": false
    },
    {
      "name": "postgres user",
      "key": "postgres_user",
      "value": "dsmrreader",
      "description": "postgre user",
      "required": true,
      "mask": false
    },
    {
      "name": "postgres password",
      "key": "postgres_pass",
      "value": "dsmrreader",
      "description": "postgres password",
      "required": true,
      "mask": true
    },
    {
      "name": "postgres_db",
      "key": "postgres_db",
      "value": "graph-node",
      "description": "postgres db name",
      "required": true,
      "mask": false
    },
    {
      "name": "ipfs url",
      "key": "ipfs",
      "value": "localhost:5001",
      "description": "Container Variable: ipfs",
      "required": true,
      "mask": false
    },
    {
      "name": "ethereum node url",
      "key": "ethereum",
      "value": "mainnet:http://localhost:8545",
      "description": "ethereum node url",
      "required": true,
      "mask": false
    },
    {
      "name": "postgres port",
      "key": "postgres_port",
      "value": "5732",
      "description": "postgres port",
      "required": true,
      "mask": false
    },
    {
      "name": "GRAPH_LOG",
      "key": "GRAPH_LOG",
      "value": "info",
      "description": "log level",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
