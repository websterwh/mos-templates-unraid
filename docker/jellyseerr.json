{
  "name": "jellyseerr",
  "repo": "fallenbagel/jellyseerr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/fallenbagel/jellyseerr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5055]/",
  "icon": "https://raw.githubusercontent.com/Fallenbagel/jellyseerr/main/public/android-chrome-512x512.png",
  "project": "https://github.com/Fallenbagel/jellyseerr",
  "description": "Jellyseerr is a free and open-source software application for managing requests for your media library. It is a fork of Overseerr built to bring support for Jellyfin & Emby media servers! To enable Emby support please add the variable 'JELLYFIN_TYPE=emby' in the template. This project is constantly updating with new features and bug fixes. See the GitHub page for current and developing features! https://github.com/Fallenbagel/jellyseerr/",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/jellyseerr",
      "container": "/app/config/",
      "mode": "rw",
      "description": "Appdata directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Network",
      "host": "5055",
      "container": "5055",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Log",
      "key": "LOG_LEVEL",
      "value": "info",
      "description": "Log verbosity.",
      "required": false,
      "mask": false
    },
    {
      "name": "Emby Support",
      "key": "JELLYFIN_TYPE",
      "value": "emby",
      "description": "Emby users need to fill 'emby' to enable emby support! Enabling emby support will cause problems with Plex and make Jellyfin unavailable.",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
