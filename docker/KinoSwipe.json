{
  "name": "Kino-Swipe",
  "repo": "bergasha/kino-swipe:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/repository/docker/bergasha/kino-swipe",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5005]",
  "icon": "https://raw.githubusercontent.com/Bergasha/kino-swipe/main/app/static/main.png",
  "project": "https://github.com/Bergasha/kino-swipe",
  "description": "Swipe and match movies for Plex and Jellyfin. Basic dating app rules: swipe left if it is a no and swipe right if it is a yes. Two right swipes and it's a match. All matches are stored in your match history for later viewing.",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/kino-swipe/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Persistent storage for Kino Swipe data",
      "required": true
    },
    {
      "name": "Static Content Path",
      "host": "/mnt/cache/appdata/kino-swipe/static",
      "container": "/app/static",
      "mode": "rw",
      "description": "Persistent storage for local static files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "5005",
      "container": "5005",
      "protocol": "tcp",
      "description": "Port used to access Kino Swipe",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PLEX_URL",
      "key": "PLEX_URL",
      "value": "",
      "description": "URL of your Plex server (Optional)",
      "required": false,
      "mask": false
    },
    {
      "name": "PLEX_TOKEN",
      "key": "PLEX_TOKEN",
      "value": "",
      "description": "Your Plex token (Optional)",
      "required": false,
      "mask": true
    },
    {
      "name": "JELLYFIN_URL",
      "key": "JELLYFIN_URL",
      "value": "",
      "description": "URL of your Jellyfin server (Optional)",
      "required": false,
      "mask": false
    },
    {
      "name": "JELLYFIN_API_KEY",
      "key": "JELLYFIN_API_KEY",
      "value": "",
      "description": "Your Jellyfin API Key (Optional)",
      "required": false,
      "mask": true
    },
    {
      "name": "TMDB_API_KEY",
      "key": "TMDB_API_KEY",
      "value": "",
      "description": "TMDB API key for trailers and metadata to work",
      "required": true,
      "mask": true
    },
    {
      "name": "FLASK_SECRET",
      "key": "FLASK_SECRET",
      "value": "",
      "description": "Random secret string for session security",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
