{
  "name": "adminer",
  "repo": "adminer",
  "category": [
    "System"
  ],
  "registry": "http://hub.docker.com/_/adminer/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/adminer.png",
  "project": "https://github.com/vrana/adminer",
  "description": "Adminer (formerly phpMinAdmin) is a full-featured database management tool written in PHP. Conversely to phpMyAdmin, it consist of a single file ready to deploy to the target server. Adminer is available for MySQL, PostgreSQL, SQLite, MS SQL, Oracle, Firebird, SimpleDB, Elasticsearch and MongoDB. Go to https://github.com/vrana/adminer/tree/master/designs for themes Plugins: https://github.com/vrana/adminer/tree/master/plugins",
  "paths": [],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Theme",
      "key": "ADMINER_DESIGN",
      "value": "flat",
      "description": "Container Variable: ADMINER_DESIGN",
      "required": false,
      "mask": false
    },
    {
      "name": "Plugins",
      "key": "ADMINER_PLUGINS",
      "value": "",
      "description": "e.g. ADMINER_PLUGINS='tables-filter tinymce'",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
