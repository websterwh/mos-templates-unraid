{
  "name": "mattermost",
  "repo": "mattermost/mattermost-team-edition:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/mattermost/mattermost-team-edition/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8065]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/mattermost.png",
  "project": "https://mattermost.com/",
  "description": "Mattermost a flexible, open source messaging platform that enables secure team collaboration. The official Docker image for Mattermost Team Edition.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/mattermost/data/",
      "container": "/mattermost/data",
      "mode": "rw",
      "description": "Data Path",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/mattermost/logs/",
      "container": "/mattermost/logs",
      "mode": "rw",
      "description": "Logs Path",
      "required": true
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/mattermost/config/",
      "container": "/mattermost/config",
      "mode": "rw",
      "description": "Config Path",
      "required": true
    },
    {
      "name": "Plugins",
      "host": "/mnt/cache/appdata/mattermost/plugins/",
      "container": "/mattermost/plugins",
      "mode": "rw",
      "description": "Plugins Path",
      "required": true
    },
    {
      "name": "Client Plugins",
      "host": "/mnt/cache/appdata/mattermost/client/plugins/",
      "container": "/mattermost/client/plugins",
      "mode": "rw",
      "description": "Client Plugins Path",
      "required": true
    },
    {
      "name": "Bleve Indexes",
      "host": "/mnt/cache/appdata/mattermost/bleve-indexes/",
      "container": "/mattermost/bleve-indexes",
      "mode": "rw",
      "description": "Bleve Indexes Path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Listen Address",
      "host": "8065",
      "container": "8065",
      "protocol": "tcp",
      "description": "The address and port to which to bind and listen.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DATASOURCE",
      "key": "MM_SQLSETTINGS_DATASOURCE",
      "value": "MM_USERNAME:MM_PASSWORD@tcp(DB_HOST:DB_PORT_NUMBER)/MM_DBNAME?charset=utf8mb4,utf8&amp;readTimeout=30s&amp;writeTimeout=30s",
      "description": "https://docs.mattermost.com/configure/environment-configuration-settings.html",
      "required": true,
      "mask": false
    },
    {
      "name": "Site URL",
      "key": "MM_SERVICESETTINGS_SITEURL",
      "value": "http://192.168.100.100:8065",
      "description": "Application host address",
      "required": true,
      "mask": false
    },
    {
      "name": "Databse Type",
      "key": "Databse Type",
      "value": "mysql",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
