{
  "name": "ipfs-kubo",
  "repo": "ipfs/kubo:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ipfs/kubo/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5001]/webui",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/ipfs-kubo.png",
  "project": "https://github.com/ipfs/kubo",
  "description": "IPFS is a global, versioned, peer-to-peer filesystem. It combines good ideas from previous systems such as Git, BitTorrent, Kademlia, SFS, and the Web. It is like a single BitTorrent swarm, exchan> \u26d4\u26d4NEVER EXPOSE THE RPC API TO THE PUBLIC INTERNET\u26d4\u26d4 The API port (by default 5001) provides admin-level access to your Kubo IPFS node. See RPC API v0 docs for more information. https://docs.ipfs.tech/reference/kubo/rpc/",
  "paths": [
    {
      "name": "IPFS Staging",
      "host": "/mnt/cache/appdata/ipfs-kubo/staging",
      "container": "/export",
      "mode": "rw",
      "description": "Container Path: /export",
      "required": false
    },
    {
      "name": "IPFS Data",
      "host": "/mnt/cache/appdata/ipfs-kubo/data",
      "container": "/data/ipfs",
      "mode": "rw",
      "description": "Container Path: /data/ipfs",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "P2P TCP/QUIC",
      "host": "4001",
      "container": "4001",
      "protocol": "tcp",
      "description": "Container Port: 4001/tcp",
      "required": false,
      "mask": false
    },
    {
      "name": "P2P UDP/QUIC",
      "host": "4001",
      "container": "4001",
      "protocol": "udp",
      "description": "Container Port: 4001/udp",
      "required": false,
      "mask": false
    },
    {
      "name": "RPC API",
      "host": "5001",
      "container": "5001",
      "protocol": "tcp",
      "description": "Container Port: 5001/tcp",
      "required": false,
      "mask": false
    },
    {
      "name": "Gateway",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080/tcp",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
