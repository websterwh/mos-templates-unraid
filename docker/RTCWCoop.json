{
  "name": "RTCWCoop",
  "repo": "ivaxor/rtcwcoop:1.0.2",
  "category": [
    "Game Server"
  ],
  "registry": "https://registry.hub.docker.com/r/ivaxor/rtcwcoop",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "+set dedicated 2 +map swf +set fs_homepath /home/rtcw",
  "web_ui_url": "http://[IP]:[PORT:27960]",
  "icon": "https://raw.githubusercontent.com/ivaxor/unraid-ca-docker-templates/main/rtcwcoop.png",
  "project": "https://www.rtcwcoop.com",
  "description": "A Return to Castle Wolfenstein modification which enables cooperative gameplay, based on iortcw. To run this you need legitimate copy of RTCW and RealRTCW from Steam. Copy all *.pk3 files from RTCW and RealRTCW to corresponding folders. If your server aren't visible in server browser - try to add +net_ip [YOUR_IP] +net_port 27960 to Post Arguments .",
  "paths": [
    {
      "name": "RTCW",
      "host": "/mnt/cache/appdata/rtcw/main",
      "container": "/home/rtcw/main",
      "mode": "rw",
      "description": "Folder with RTCW/Main/*.pk3 files",
      "required": true
    },
    {
      "name": "RealRTCW",
      "host": "/mnt/cache/appdata/rtcw/coopmain",
      "container": "/home/rtcw/coopmain",
      "mode": "rw",
      "description": "Folder with RealRTCW/coop/coopmain/*.pk3 files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Game",
      "host": "27960",
      "container": "27960",
      "protocol": "udp",
      "description": "Container Port: 27960",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
