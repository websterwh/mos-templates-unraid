{
  "name": "simstudio-valkey",
  "repo": "valkey/valkey:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/valkey/valkey",
  "network": "simstudio_internal",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--health-cmd=valkey-cli ping || exit 1 --health-interval=10s --health-retries=5 --health-start-period=10s --health-timeout=5s",
  "post_parameters": "valkey-server --maxmemory 0 --appendonly yes --tcp-keepalive 60",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/valkey-logo.png",
  "project": "https://valkey.io",
  "description": "Valkey is an open-source, high-performance key/value store (Redis fork). Used by Sim Studio for session persistence, caching, and real-time data synchronization. This is a lightweight component. Must be on the same Docker network (simstudio_internal) as the simstudio-realtime and simstudio-app containers.",
  "paths": [
    {
      "name": "Path: Data",
      "host": "/mnt/cache/appdata/simstudio-valkey/",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent Valkey data directory. Stores RDB snapshots and AOF logs for session persistence and data durability.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "--- System ---",
      "key": "--- System ---",
      "value": "",
      "description": "General settings.",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable: TZ",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Timezone. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
