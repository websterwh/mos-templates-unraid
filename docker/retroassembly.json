{
  "name": "retroassembly",
  "repo": "arianrhodsandlot/retroassembly",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/arianrhodsandlot/retroassembly",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://github.com/arianrhodsandlot/retroassembly/raw/main/public/assets/logo/logo-512x512.png",
  "project": "https://github.com/arianrhodsandlot/retroassembly",
  "description": "This template is for playing retro classic games through your web browser on Unraid.",
  "paths": [
    {
      "name": "volumes:",
      "host": "/mnt/cache/appdata/retroassembly",
      "container": "/app/data",
      "mode": "rw",
      "description": "The actual path where you want to store your game data, ROMs, and save states.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Docker_NAT_Port8000",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Docker NAT port 8000.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
