{
  "name": "kanboard",
  "repo": "kanboard/kanboard",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/kanboard/kanboard/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "cp -u /var/www/app/config.php /var/www/app/data/config.php",
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/ArieDed/unraid-template/master/img/kanboard_logo.png",
  "project": "https://github.com/kanboard/kanboard",
  "description": "Kanboard is project management software that focuses on the Kanban methodology.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/kanboard/data",
      "container": "/var/www/app/data",
      "mode": "rw",
      "description": "Container Path: /var/www/app/data",
      "required": false
    },
    {
      "name": "plugins",
      "host": "/mnt/cache/appdata/kanboard/plugins",
      "container": "/var/www/app/plugins",
      "mode": "rw",
      "description": "Container Path: /var/www/app/plugins",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "8001",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "Plugins",
      "key": "PLUGIN_INSTALLER",
      "value": "false",
      "description": "Set to 'true' to enable plugins right away.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
