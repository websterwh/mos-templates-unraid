{
  "name": "Tauticord",
  "repo": "nwithan8/tauticord:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/nwithan8/tauticord",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8283]",
  "icon": "https://raw.githubusercontent.com/nwithan8/tauticord/master/documentation/images/icon.png",
  "project": "https://github.com/nwithan8/tauticord",
  "description": "Tauticord is a Discord bot that displays live data from Tautulli, including stream summaries, bandwidth and library statistics.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/tauticord/config",
      "container": "/config",
      "mode": "rw",
      "description": "Where config file will be stored",
      "required": true
    },
    {
      "name": "Log Path",
      "host": "/mnt/cache/appdata/tauticord/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Where debug logs will be stored",
      "required": true
    },
    {
      "name": "Monitor Path",
      "host": "/mnt/cache/appdata/tauticord/monitor",
      "container": "/monitor",
      "mode": "ro",
      "description": "Directory to monitor usage percentage of (e.g. your Plex library)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8283",
      "container": "8283",
      "protocol": "tcp",
      "description": "Port for the API server",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
