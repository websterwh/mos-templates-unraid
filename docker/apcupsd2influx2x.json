{
  "name": "apcupsd2influx2.x",
  "repo": "ghcr.io/freeskier93/apcupsd2influx2.x:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/freeskier93/apcupsd2influx2.x/pkgs/container/apcupsd2influx2.x",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://img.icons8.com/office/40/database-export.png",
  "project": "https://github.com/freeskier93/apcupsd2influx2.x",
  "description": "Collects UPS data from APCUPSD and exports it to InfuxDB 2.x for use with Grafana or other data visulization tools",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "APCUPSD_HOST",
      "key": "APCUPSD_HOST",
      "value": "127.0.0.1",
      "description": "Hostname/IP where APCUPSD is running",
      "required": true,
      "mask": false
    },
    {
      "name": "APCUPSD_NOMINAL_POWER",
      "key": "APCUPSD_NOMINAL_POWER",
      "value": "",
      "description": "Nominal power rating of your UPS, required if your UPS does not report NOMPOWER value (watts)",
      "required": false,
      "mask": false
    },
    {
      "name": "COST_PER_KWH",
      "key": "COST_PER_KWH",
      "value": "",
      "description": "Cost of your energy per kWh",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_HOST",
      "key": "INFLUXDB_HOST",
      "value": "127.0.0.1",
      "description": "Hostname/IP where InfluxDB is running",
      "required": true,
      "mask": false
    },
    {
      "name": "INFLUXDB_TOKEN",
      "key": "INFLUXDB_TOKEN",
      "value": "",
      "description": "User generated InfluxDB token",
      "required": true,
      "mask": true
    },
    {
      "name": "INFLUXDB_PORT",
      "key": "INFLUXDB_PORT",
      "value": "8086",
      "description": "Port InfluxDB is listening on",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_BUCKET",
      "key": "INFLUXDB_BUCKET",
      "value": "apcupsd",
      "description": "Name of the bucket data will be saved to",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_MEASUREMENT",
      "key": "INFLUXDB_MEASUREMENT",
      "value": "ups_telemetry",
      "description": "Name of the measurement data will be save to in the bucket",
      "required": false,
      "mask": false
    },
    {
      "name": "APCUPSD_POLL_RATE",
      "key": "APCUPSD_POLL_RATE",
      "value": "5",
      "description": "Rate to poll data from UPS (seconds) WARNING: Poll rate may affect how energy (kWh) and costs are calculated",
      "required": false,
      "mask": false
    },
    {
      "name": "APCUPSD_PORT",
      "key": "APCUPSD_PORT",
      "value": "3551",
      "description": "Port that APCUPSD is listening on",
      "required": false,
      "mask": false
    },
    {
      "name": "INFLUXDB_ORG",
      "key": "INFLUXDB_ORG",
      "value": "homelab",
      "description": "Organization name",
      "required": false,
      "mask": false
    },
    {
      "name": "DEBUG",
      "key": "DEBUG",
      "value": "false",
      "description": "Enable/Disable Debug logging (true/false)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
