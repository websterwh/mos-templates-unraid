{
  "name": "wger-celery-worker",
  "repo": "wger/server:latest",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/wger/server",
  "network": "wger_network",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--entrypoint /start-worker",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/wger-logo.png",
  "project": "https://wger.de",
  "description": "Celery worker that processes asynchronous background tasks for the wger application (exercise sync, image processing, etc.).",
  "paths": [
    {
      "name": "DJANGO_MEDIA_ROOT",
      "host": "/mnt/cache/appdata/wger/media/",
      "container": "/home/wger/media",
      "mode": "rw",
      "description": "Path to media files (must match wger-server)",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "wger-docker-supersecret-key-1234567890!@#$%^&amp;*(-_)",
      "description": "Django SECRET_KEY \u2013 must match wger-server. CHANGE THIS!",
      "required": true,
      "mask": false
    },
    {
      "name": "SIGNING_KEY",
      "key": "SIGNING_KEY",
      "value": "wger-docker-secret-jwtkey-1234567890!@#$%^&amp;*(-_=+)",
      "description": "JWT signing key \u2013 must match wger-server. CHANGE THIS!",
      "required": true,
      "mask": false
    },
    {
      "name": "TIME_ZONE",
      "key": "TIME_ZONE",
      "value": "Europe/Berlin",
      "description": "Timezone (must match wger-server)",
      "required": true,
      "mask": false
    },
    {
      "name": "DJANGO_DB_HOST",
      "key": "DJANGO_DB_HOST",
      "value": "wger-db",
      "description": "Database container hostname",
      "required": false,
      "mask": false
    },
    {
      "name": "CELERY_BROKER",
      "key": "CELERY_BROKER",
      "value": "redis://wger-redis:6379/2",
      "description": "Celery broker URL (Redis)",
      "required": false,
      "mask": false
    },
    {
      "name": "CELERY_BACKEND",
      "key": "CELERY_BACKEND",
      "value": "redis://wger-redis:6379/2",
      "description": "Celery result backend URL (Redis)",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "File creation mask",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
