{
  "name": "Pritunl",
  "repo": "bashninja/docker-pritunl",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/bashninja/docker-pritunl/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:443]",
  "icon": "https://cdn.rawgit.com/bashNinja-dockers/docker-pritunl/0cf3b425/logo.png",
  "project": "https://pritunl.com/",
  "description": "Run a Pritunl VPN Server Configuration /config This is where the default configs and logs are. Launch the Web Interface at port `9700` to manage Pritunl. Port `1194` udp/tcp is default for the VPN. When you add a \"server\" and set the bind port to 0.0.0.0` , until Unraid supports ipv6. Submit any Unraid issues here: http://lime-technology.com/forum/index.php?topic=48370.0",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/pritunl",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "http",
      "host": "9699",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80. Only used for LetsEncrypt.",
      "required": false,
      "mask": false
    },
    {
      "name": "https",
      "host": "9700",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN/tcp",
      "host": "1194",
      "container": "1194",
      "protocol": "tcp",
      "description": "Container Port: 1194/tcp",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN/udp",
      "host": "1194",
      "container": "1194",
      "protocol": "udp",
      "description": "Container Port: 1194/udp",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "UID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "GID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
