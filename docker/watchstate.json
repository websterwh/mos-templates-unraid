{
  "name": "watchstate",
  "repo": "ghcr.io/arabcoders/watchstate",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/arabcoders/watchstate/pkgs/container/watchstate",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/arabcoders/unraid-templates/master/arabcoders/images/watchstate.png",
  "project": "https://github.com/arabcoders/watchstate",
  "description": "Self-hosted service to sync your plex, jellyfin and emby play state. without relying on 3rd-party external services.",
  "paths": [
    {
      "name": "WatchState AppData",
      "host": "/mnt/cache/appdata/watchstate/config",
      "container": "/config",
      "mode": "rw",
      "description": "All application data will be stored in this path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "The HTTP Port for WebUI and API access",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
