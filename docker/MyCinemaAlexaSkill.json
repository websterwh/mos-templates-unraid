{
  "name": "MyCinema-Alexa-Skill",
  "repo": "ghcr.io/ripleyxlr8/my-cinema-amazon-skill-for-kodi:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/ripleyxlr8/my-cinema-amazon-skill-for-kodi/packages",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/ripleyxlr8/my-cinema-amazon-skill-for-kodi/main/icon.png",
  "project": "https://github.com/ripleyxlr8/my-cinema-amazon-skill-for-kodi",
  "description": "A dockerized Amazon Skill to start movies or series with voice control using the Kodi Fenlight add-on (via TMBDHelper).",
  "paths": [
    {
      "name": "Appdata Config Path",
      "host": "/mnt/cache/appdata/mycinema-alexa-skill/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Persistent storage for Trakt tokens",
      "required": true
    },
    {
      "name": "Persistant ADB keys Path",
      "host": "/mnt/cache/appdata/mycinema-alexa-skill/adb_keys",
      "container": "/root/.android",
      "mode": "rw",
      "description": "Persistent storage for ADB keys",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "App Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Port mapping for the Alexa Skill endpoint",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Shield IP",
      "key": "SHIELD_IP",
      "value": "",
      "description": "Nvidia Shield IP address",
      "required": true,
      "mask": false
    },
    {
      "name": "Shield MAC",
      "key": "SHIELD_MAC",
      "value": "",
      "description": "Shield MAC address (for Wake-on-LAN)",
      "required": true,
      "mask": false
    },
    {
      "name": "TMDB API Key",
      "key": "TMDB_API_KEY",
      "value": "",
      "description": "Your TheMovieDB API Key",
      "required": true,
      "mask": false
    },
    {
      "name": "Trakt Client ID",
      "key": "TRAKT_CLIENT_ID",
      "value": "",
      "description": "Trakt.tv Client ID",
      "required": true,
      "mask": false
    },
    {
      "name": "Trakt Access Token",
      "key": "TRAKT_ACCESS_TOKEN",
      "value": "",
      "description": "Trakt.tv Access Token",
      "required": true,
      "mask": false
    },
    {
      "name": "Trakt Refresh Token",
      "key": "TRAKT_REFRESH_TOKEN",
      "value": "",
      "description": "Trakt.tv Refresh Token (Optional)",
      "required": false,
      "mask": false
    },
    {
      "name": "Kodi Port",
      "key": "KODI_PORT",
      "value": "8080",
      "description": "Kodi Web Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Kodi User",
      "key": "KODI_USER",
      "value": "kodi",
      "description": "Kodi User",
      "required": false,
      "mask": false
    },
    {
      "name": "Kodi Password",
      "key": "KODI_PASS",
      "value": "kodi",
      "description": "Kodi Password",
      "required": false,
      "mask": true
    },
    {
      "name": "Player Default",
      "key": "PLAYER_DEFAULT",
      "value": "fenlight_auto.json",
      "description": "Auto player filename",
      "required": false,
      "mask": false
    },
    {
      "name": "Player Select",
      "key": "PLAYER_SELECT",
      "value": "fenlight_select.json",
      "description": "Manual player filename",
      "required": false,
      "mask": false
    },
    {
      "name": "Debug Mode",
      "key": "DEBUG_MODE",
      "value": "false",
      "description": "Enable Debug mode (true/false)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
