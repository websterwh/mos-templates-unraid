{
  "name": "NodeRedv2Beta",
  "repo": "nodered/node-red-dev:beta",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/nodered/node-red-dev/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1880]",
  "icon": "https://nodered.org/about/resources/media/node-red-icon.png",
  "project": "https://nodered.org",
  "description": "Node-RED is a visual tool for wiring the Internet of Things Node-RED is a tool for wiring together hardware devices, APIs and online services in new and interesting ways. See NodeRed.org and flows.nodered.org for more info. NodeRed will run on port 1880. This is the official BETA Version 2 Docker release from the NodeRed team - I just created the template. Directions: /data : in this path, Node Red will store it's configuration files. 15.JUN.2021: First template",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/nodered2/",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "1880",
      "container": "1880",
      "protocol": "tcp",
      "description": "Container Port: 1880",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Safe mode",
      "key": "NODE_RED_ENABLE_SAFE_MODE",
      "value": "false",
      "description": "Container Variable: NODE_RED_ENABLE_SAFE_MODE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
