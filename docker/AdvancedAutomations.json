{
  "name": "Advanced-Automations",
  "repo": "ghcr.io/jstnjx/uc-advanced-automations:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jstnjx/uc-advanced-automations",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9201]/",
  "icon": "https://raw.githubusercontent.com/jstnjx/uc-advanced-automations/refs/heads/main/advanced-automations.png",
  "project": "https://github.com/jstnjx/uc-advanced-automations",
  "description": "Advanced Automations is a local visual automation engine for Unfolded Circle Remote Two and Remote 3.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/advanced_automations/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the app data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9201",
      "container": "9201",
      "protocol": "tcp",
      "description": "Container Port: 9201",
      "required": true,
      "mask": false
    },
    {
      "name": "Integration HTTP Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Container Port: 9090",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "UC_EXTERNAL",
      "key": "UC_EXTERNAL",
      "value": "true|false",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "UC_RUNTIME_MODE",
      "key": "UC_RUNTIME_MODE",
      "value": "external",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "UC_DISABLE_MDNS_PUBLISH",
      "key": "UC_DISABLE_MDNS_PUBLISH",
      "value": "true|false",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Internal Data Path",
      "key": "UC_AUTOMATIONS_DATA_DIR",
      "value": "/data",
      "description": "Internal data path. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Integration HTTP Host",
      "key": "UC_INTEGRATION_INTERFACE",
      "value": "0.0.0.0",
      "description": "Internal host. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Integration HTTP Port",
      "key": "UC_INTEGRATION_HTTP_PORT",
      "value": "9090",
      "description": "Internal port. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Web UI Host",
      "key": "UC_AUTOMATIONS_WEB_HOST",
      "value": "0.0.0.0",
      "description": "Internal host. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Web UI Port",
      "key": "UC_AUTOMATIONS_WEB_PORT",
      "value": "9201",
      "description": "Internal port. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
