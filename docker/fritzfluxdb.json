{
  "name": "fritzfluxdb",
  "repo": "giiibates/fritzfluxdb:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/giiibates/fritzfluxdb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Gill-Bates/unraid-app-templates/main/icons/01_fritzboxinflux.png",
  "project": "https://github.com/Gill-Bates/fritzfluxdb",
  "description": "Daemon that reads metrics from an AVM Fritz!Box (DSL/Cable, WLAN, VPN, home automation, logs) and writes them to InfluxDB v1, InfluxDB v2, or QuestDB. No Web UI. Configured entirely via environment variables. Grafana dashboards included. Source: https://github.com/Gill-Bates/fritzfluxdb",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Europe/Berlin",
      "description": "Container timezone (e.g. Europe/Berlin, Etc/UTC). Fritz!Box timezone is auto-detected at startup.",
      "required": false,
      "mask": false
    },
    {
      "name": "Fritz!Box Hostname/IP",
      "key": "FRITZBOX_HOSTNAME",
      "value": "192.168.178.1",
      "description": "Hostname or IP of the Fritz!Box on your LAN.",
      "required": true,
      "mask": false
    },
    {
      "name": "Fritz!Box Username",
      "key": "FRITZBOX_USERNAME",
      "value": "",
      "description": "Fritz!Box login username.",
      "required": true,
      "mask": false
    },
    {
      "name": "Fritz!Box Password",
      "key": "FRITZBOX_PASSWORD",
      "value": "",
      "description": "Fritz!Box login password.",
      "required": true,
      "mask": true
    },
    {
      "name": "Fritz!Box Request Interval (s)",
      "key": "FRITZBOX_REQUEST_INTERVAL",
      "value": "10",
      "description": "Seconds between TR-064 poll cycles (minimum 10).",
      "required": false,
      "mask": false
    },
    {
      "name": "Database Type",
      "key": "DB_TYPE",
      "value": "influxdb_v2",
      "description": "Target database: influxdb_v1, influxdb_v2, or questdb.",
      "required": true,
      "mask": false
    },
    {
      "name": "InfluxDB Hostname/IP",
      "key": "INFLUXDB_HOSTNAME",
      "value": "",
      "description": "Hostname or IP of the InfluxDB instance.",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Port",
      "key": "INFLUXDB_PORT",
      "value": "8086",
      "description": "InfluxDB port (default 8086).",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB TLS",
      "key": "INFLUXDB_TLS_ENABLED",
      "value": "false",
      "description": "Enable TLS for InfluxDB connection (true/false).",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Measurement Name",
      "key": "INFLUXDB_MEASUREMENT_NAME",
      "value": "fritzbox",
      "description": "InfluxDB measurement / table name.",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Token (v2)",
      "key": "INFLUXDB_TOKEN",
      "value": "",
      "description": "InfluxDB v2 API token.",
      "required": false,
      "mask": true
    },
    {
      "name": "InfluxDB Organization (v2)",
      "key": "INFLUXDB_ORGANIZATION",
      "value": "",
      "description": "InfluxDB v2 organization name.",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Bucket (v2)",
      "key": "INFLUXDB_BUCKET",
      "value": "fritzflux",
      "description": "InfluxDB v2 bucket.",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Database (v1)",
      "key": "INFLUXDB_DATABASE",
      "value": "fritzflux",
      "description": "InfluxDB v1 database name.",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Username (v1)",
      "key": "INFLUXDB_USERNAME",
      "value": "",
      "description": "InfluxDB v1 username (optional).",
      "required": false,
      "mask": false
    },
    {
      "name": "InfluxDB Password (v1)",
      "key": "INFLUXDB_PASSWORD",
      "value": "",
      "description": "InfluxDB v1 password (optional).",
      "required": false,
      "mask": true
    },
    {
      "name": "QuestDB Hostname/IP",
      "key": "QUESTDB_HOSTNAME",
      "value": "",
      "description": "Hostname or IP of the QuestDB instance (only for DB_TYPE=questdb).",
      "required": false,
      "mask": false
    },
    {
      "name": "QuestDB Port",
      "key": "QUESTDB_PORT",
      "value": "9000",
      "description": "QuestDB HTTP port (default 9000).",
      "required": false,
      "mask": false
    },
    {
      "name": "QuestDB TLS",
      "key": "QUESTDB_TLS_ENABLED",
      "value": "false",
      "description": "Enable TLS for QuestDB connection (true/false).",
      "required": false,
      "mask": false
    },
    {
      "name": "QuestDB Username",
      "key": "QUESTDB_USERNAME",
      "value": "",
      "description": "QuestDB username (optional).",
      "required": false,
      "mask": false
    },
    {
      "name": "QuestDB Password",
      "key": "QUESTDB_PASSWORD",
      "value": "",
      "description": "QuestDB password (optional).",
      "required": false,
      "mask": true
    },
    {
      "name": "QuestDB Token",
      "key": "QUESTDB_TOKEN",
      "value": "",
      "description": "QuestDB bearer token (optional).",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
