{
  "name": "traefik",
  "repo": "traefik:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/_/traefik",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/ibracorp/unraid-templates/master/traefik/traefik.png",
  "project": "https://traefik.io/",
  "description": "The world\u2019s most popular cloud-native application proxy that helps developers and operations teams build, deploy and run modern microservices applications quickly and easily. For a guide on how to install this reverse proxy, head over to our documentation website. https://docs.ibracorp.io Come join in on the community fun and get support by joining our discord! https://discord.gg/VWAG7rZ",
  "paths": [
    {
      "name": "Config Folder",
      "host": "/mnt/cache/appdata/traefik",
      "container": "/etc/traefik",
      "mode": "rw",
      "description": "Appdata Location",
      "required": false
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "The default is /var/run/docker.sock",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "https Port",
      "host": "44301",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS Port",
      "required": false,
      "mask": false
    },
    {
      "name": "http Port",
      "host": "8001",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP Port",
      "required": false,
      "mask": false
    },
    {
      "name": "Web UI Port",
      "host": "8183",
      "container": "8080",
      "protocol": "tcp",
      "description": "Dashboard WebUI Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Cloudflare API Token",
      "key": "CF_DNS_API_TOKEN",
      "value": "YOUR_SUPER_SECURE_CLOUDFLARE_API_TOKEN",
      "description": "Cloudflare DNS API Token",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": [
    {
      "name": "Traefik Dashboard Subdomain",
      "value": "Host(`traefik.DOMAIN.COM`)",
      "description": "Traefik dashboard URL"
    },
    {
      "name": "Traefik Entrypoint",
      "value": "https",
      "description": "Traefik Dashboard Entrypoint"
    },
    {
      "name": "Traefik API",
      "value": "api@internal",
      "description": "Routing Traefik to its API Dashboard"
    },
    {
      "name": "Enable Traefik (Dashboard)",
      "value": "true",
      "description": "Enable/Disable Traefik Dashboard"
    }
  ]
}
