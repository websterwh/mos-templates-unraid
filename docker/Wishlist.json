{
  "name": "Wishlist",
  "repo": "charmcli/wishlist:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/charmcli/wishlist",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2222]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/wishlist-icon.png",
  "project": "https://github.com/charmbracelet/charm",
  "description": "The SSH directory from Charm Bracelet",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/wishlist",
      "container": "/.wishlist",
      "mode": "rw",
      "description": "Storage for app files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "SSH Port",
      "host": "2222",
      "container": "22",
      "protocol": "tcp",
      "description": "Container Port: 22",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
