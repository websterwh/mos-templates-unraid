{
  "name": "cronicle",
  "repo": "soulteary/cronicle:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/soulteary/cronicle",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3012]",
  "icon": "https://github.com/brianmiller/docker-templates/raw/master/cronicle/cronicle.png",
  "project": "https://github.com/jhuckaby/Cronicle",
  "description": "Cronicle is a multi-server task scheduler and runner, with a web based front-end UI. It handles both scheduled, repeating and on-demand jobs, targeting any number of worker servers, with real-time stats and live log viewer. It's basically a fancy Cron replacement written in Node.js. You can give it simple shell commands, or write Plugins in virtually any language. A huge thank you to github.com/jhuckab for the Cronicle project and github.com/soulteary for the container!",
  "paths": [
    {
      "name": "Stateful Data Path",
      "host": "/mnt/cache/appdata/cronicle/data",
      "container": "/opt/cronicle/data",
      "mode": "rw",
      "description": "Internal Container Path: /opt/cronicle/data",
      "required": true
    },
    {
      "name": "Stateful Logs Path",
      "host": "/mnt/cache/appdata/cronicle/logs",
      "container": "/opt/cronicle/logs",
      "mode": "rw",
      "description": "Internal Container Path: /opt/cronicle/logs",
      "required": true
    },
    {
      "name": "Stateful Plugins Path",
      "host": "/mnt/cache/appdata/cronicle/plugins",
      "container": "/opt/cronicle/plugins",
      "mode": "rw",
      "description": "Internal Container Path: /opt/cronicle/plugins",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Interface Port",
      "host": "3012",
      "container": "3012",
      "protocol": "tcp",
      "description": "The port cronicle will listen on.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
