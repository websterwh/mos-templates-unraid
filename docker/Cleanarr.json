{
  "name": "Cleanarr",
  "repo": "selexin/cleanarr",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/selexin/cleanarr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/Alphacosmos/unraid-templetes/main/Images/plex-library-cleaner.ico",
  "project": "https://github.com/se1exin/cleanarr",
  "description": "A simple UI to help find and delete duplicate and sample files from your Plex server.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/plex-library-cleaner",
      "container": "/frontend",
      "mode": "rw",
      "description": "Container Path: /frontend",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "5000",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PLEX_BASE_URL",
      "key": "PLEX_BASE_URL",
      "value": "",
      "description": "(required) Plex Server Address (e.g. http://192.169.1.100:32400)",
      "required": false,
      "mask": false
    },
    {
      "name": "PLEX_TOKEN",
      "key": "PLEX_TOKEN",
      "value": "",
      "description": "(required) A valid Plex token for your Plex Server",
      "required": false,
      "mask": false
    },
    {
      "name": "LIBRARY_NAMES",
      "key": "LIBRARY_NAMES",
      "value": "",
      "description": "(optional) Name(s) of your Plex Libraries to search. Separate multiple library names with",
      "required": false,
      "mask": false
    },
    {
      "name": "BYPASS_SSL_VERIFY",
      "key": "BYPASS_SSL_VERIFY",
      "value": "",
      "description": "(optional) Disable SSL certificate verification. Use this if your Plex Server has",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
