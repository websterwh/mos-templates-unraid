  "project": "https://notemark.docs.enchantedcode.co.uk/",
  "description": "Note Mark is a lighting fast and minimal; web-based Markdown notes app. Featuring a sleek and responsive web UI.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/note-mark",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Service Port",
      "host": "8888",
      "container": "8000",
      "protocol": "tcp",
      "description": "Service Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "JWT Secret",
      "key": "JWT_SECRET",
      "value": "0sPU8EPDkLTI",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "CORS Origins",
      "key": "CORS_ORIGINS",
      "value": "http://[IP]:[PORT:8000]",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
