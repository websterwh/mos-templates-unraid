{
  "name": "IPMI-Tools",
  "repo": "edchamberlain/ipmi-tools",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/edchamberlain/ipmi-tools",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://github.com/EdwardChamberlain/unraid-templates/blob/main/assets/server_icon.png?raw=true",
  "project": "https://github.com/EdwardChamberlain/IPMI-Fan-Controller",
  "description": "This is a container with a webGUI to manage a Dell servers fan speeds using IPMI. You must enable IPMI from iDRAC. You can pass credentials through environment variables or enter them in the webGUI at runtime.",
  "paths": [
    {
      "name": "Appdata Location",
      "host": "/mnt/cache/appdata/ipmi_tools",
      "container": "/data",
      "mode": "rw",
      "description": "/data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4017",
      "container": "80",
      "protocol": "tcp",
      "description": "WebUI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "IPMI Host",
      "key": "APP_IPMI_HOST",
      "value": "",
      "description": "The IP or host of your iDRAC interface.",
      "required": false,
      "mask": false
    },
    {
      "name": "IPMI User",
      "key": "APP_IPMI_USER",
      "value": "",
      "description": "Your IPMI username (same as your iDRAC user)",
      "required": false,
      "mask": false
    },
    {
      "name": "IPMI Password",
      "key": "APP_IPMI_PASS",
      "value": "",
      "description": "Your IPMI password (same as your iDRAC password)",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
