{
  "name": "Govee2MQTT",
  "repo": "ghcr.io/wez/govee2mqtt:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/wez/govee2mqtt",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/govee2mqtt-icon.png",
  "project": "https://github.com/wez/govee2mqtt",
  "description": "Connect Govee lights and devices to Home Assistant via MQTT.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Govee - Account Email",
      "key": "GOVEE_EMAIL",
      "value": "",
      "description": "Govee account email address",
      "required": true,
      "mask": false
    },
    {
      "name": "Govee - Account Password",
      "key": "GOVEE_PASSWORD",
      "value": "",
      "description": "Govee account password",
      "required": true,
      "mask": true
    },
    {
      "name": "Govee - API Key",
      "key": "GOVEE_API_KEY",
      "value": "",
      "description": "Govee API key.",
      "required": true,
      "mask": true
    },
    {
      "name": "MQTT - Host",
      "key": "GOVEE_MQTT_HOST",
      "value": "",
      "description": "MQTT Host",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - Port",
      "key": "GOVEE_MQTT_PORT",
      "value": "1883",
      "description": "MQTT Port",
      "required": true,
      "mask": false
    },
    {
      "name": "MQTT - Username",
      "key": "GOVEE_MQTT_USER",
      "value": "",
      "description": "MQTT Username. Remove if no authentication required.",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT - Password",
      "key": "GOVEE_MQTT_PASSWORD",
      "value": "",
      "description": "MQTT Password. Remove if no authentication required.",
      "required": false,
      "mask": true
    },
    {
      "name": "Temperature Unit",
      "key": "GOVEE_TEMPERATURE_SCALE",
      "value": "C|F",
      "description": "Temperature unit for devices. Celsius or Fahrenheit.",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Style",
      "key": "RUST_LOG_STYLE",
      "value": "always",
      "description": "When to use Rust-style colored output for logs",
      "required": true,
      "mask": false
    },
    {
      "name": "Log Level",
      "key": "RUST_LOG",
      "value": "",
      "description": "Set to 'govee=trace' for debug logs",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
