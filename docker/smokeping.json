{
  "name": "smokeping",
  "repo": "lscr.io/linuxserver/smokeping",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/smokeping",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/smokeping/smokeping.cgi",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/smokeping-logo.png",
  "project": "https://oss.oetiker.ch/smokeping/",
  "description": "Smokeping(https://oss.oetiker.ch/smokeping/) keeps track of your network latency. For a full example of what this application is capable of visit UCDavis(http://smokeping.ucdavis.edu/cgi-bin/smokeping.fcgi).",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    },
    {
      "name": "Path: /data",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Storage location for db and application data (graphs etc)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Allows HTTP access to the internal webserver.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MASTER_URL",
      "key": "MASTER_URL",
      "value": "http://master-host-ip:80/smokeping/",
      "description": "Specify the master url to connect to. Used when in slave mode.",
      "required": false,
      "mask": false
    },
    {
      "name": "SHARED_SECRET",
      "key": "SHARED_SECRET",
      "value": "password",
      "description": "Specify the master shared secret for this host. Used when in slave mode.",
      "required": false,
      "mask": false
    },
    {
      "name": "CACHE_DIR",
      "key": "CACHE_DIR",
      "value": "/tmp",
      "description": "Specify the cache directory for this host. Used when in slave mode.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
