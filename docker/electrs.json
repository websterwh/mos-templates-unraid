{
  "name": "electrs",
  "repo": "ghcr.io/anym001/docker-electrs:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/anym001/docker-electrs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:50001]",
  "icon": "https://raw.githubusercontent.com/anym001/unraid-docker-templates/main/anym001/images/electrs.png",
  "project": "https://github.com/romanz/electrs",
  "description": "Run your own Electrum server backed by your Bitcoin Core node! This container deploys Electrs, a fast and lightweight Electrum Rust Server that indexes your Bitcoin blockchain and provides a local Electrum-compatible API. Make sure your bitcoind container is running and the RPC/P2P ports are reachable by Electrs. Create an electrs.toml configuration file in your data directory. Project: https://github.com/romanz/electrs",
  "paths": [
    {
      "name": "Data Dir",
      "host": "/mnt/cache/bitcoin/electrs",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Bitcoind Dir",
      "host": "/mnt/cache/bitcoin/bitcoind",
      "container": "/home/electrs/.bitcoin",
      "mode": "ro",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "50001",
      "container": "50001",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
