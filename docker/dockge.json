{
  "name": "dockge",
  "repo": "louislam/dockge:1",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/louislam/dockge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5001]/",
  "icon": "https://raw.githubusercontent.com/alex3305/unraid-docker-templates/master/images/dockge.png",
  "project": "https://github.com/louislam/dockge",
  "description": "A fancy, easy-to-use and reactive self-hosted docker compose.yaml stack-oriented manager.",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "App data",
      "host": "/mnt/cache/appdata/dockge/data",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Stacks Directory Path",
      "host": "/mnt/cache/appdata/dockge/stacks",
      "container": "/mnt/user/appdata/dockge/stacks",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5001",
      "container": "5001",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Stacks Directory Variable",
      "key": "DOCKGE_STACKS_DIR",
      "value": "/mnt/user/appdata/dockge/stacks",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
