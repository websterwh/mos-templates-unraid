{
  "name": "SearXNG",
  "repo": "searxng/searxng",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/searxng/searxng",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://github.com/kilrah/unraid-docker-templates/raw/main/icons/searxng.png",
  "project": "https://github.com/searxng/searxng",
  "description": "Privacy-respecting, hackable metasearch engine. SearXNG is a fork of searx.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/searxng/",
      "container": "/etc/searxng",
      "mode": "rw",
      "description": "SearXNG's config location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SearXNG Instance Name",
      "key": "INSTANCE_NAME",
      "value": "",
      "description": "Your SearXNG instance name",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
