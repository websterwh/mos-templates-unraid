{
  "name": "Yamtrack",
  "repo": "ghcr.io/fuzzygrim/yamtrack",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/fuzzygrim/Yamtrack/pkgs/container/yamtrack",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/yamtrack-icon.png",
  "project": "https://github.com/FuzzyGrim/Yamtrack",
  "description": "Yamtrack is a self-hosted media tracker for movies, tv shows, anime and manga.",
  "paths": [
    {
      "name": "Database storage path",
      "host": "/mnt/cache/appdata/yamtrack/db",
      "container": "/yamtrack/db",
      "mode": "rw",
      "description": "Path to the database storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Secret",
      "key": "SECRET",
      "value": "",
      "description": "Secret key for the application",
      "required": true,
      "mask": true
    },
    {
      "name": "Redis Host",
      "key": "REDIS_URL",
      "value": "redis://localhost:6379",
      "description": "Redis connection details",
      "required": true,
      "mask": false
    },
    {
      "name": "TMDb API key",
      "key": "TMDB_API",
      "value": "",
      "description": "Override default The Movie Database API key",
      "required": false,
      "mask": true
    },
    {
      "name": "Allow NSFW on TMDb",
      "key": "TMDB_NSFW",
      "value": "False|True",
      "description": "Allow NSFW content from TMDb",
      "required": true,
      "mask": false
    },
    {
      "name": "TMDb language",
      "key": "TMDB_LANG",
      "value": "en",
      "description": "The language to use for TMDb",
      "required": true,
      "mask": false
    },
    {
      "name": "MyAnimeList API key",
      "key": "MAL_API",
      "value": "",
      "description": "Override default MyAnimeList API key",
      "required": false,
      "mask": true
    },
    {
      "name": "Allow NSFW on MyAnimeList",
      "key": "MAL_NSFW",
      "value": "False|True",
      "description": "Allow NSFW content from MyAnimeList",
      "required": true,
      "mask": false
    },
    {
      "name": "IGDB API key",
      "key": "IGDB_ID",
      "value": "",
      "description": "Override default IGDB API key",
      "required": false,
      "mask": true
    },
    {
      "name": "IGDB API secret",
      "key": "IGDB_SECRET",
      "value": "",
      "description": "Override default IGDB API secret",
      "required": false,
      "mask": true
    },
    {
      "name": "Allow NSFW on IGDB",
      "key": "IGDB_NSFW",
      "value": "False|True",
      "description": "Allow NSFW content from IGDB",
      "required": true,
      "mask": false
    },
    {
      "name": "Allowed hosts",
      "key": "ALLOWED_HOSTS",
      "value": "",
      "description": "Host/domain names that this Django site can serve, set this to your domain name if exposing to the public",
      "required": false,
      "mask": false
    },
    {
      "name": "Allow user registration",
      "key": "REGISTRATION",
      "value": "True|False",
      "description": "Allow users to register for an account",
      "required": true,
      "mask": false
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "False|True",
      "description": "Enable debug mode",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "The user ID of the user running the container",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "The group ID of the user running the container",
      "required": true,
      "mask": false
    },
    {
      "name": "Webserver process count",
      "key": "WEB_CONCURRENCY",
      "value": "1",
      "description": "Number of webserver processes, recommended to have a value of (2 x num cores) + 1",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
