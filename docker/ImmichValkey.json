{
  "name": "Immich_Valkey",
  "repo": "valkey/valkey:8.0.6-trixie",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/valkey/valkey",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--health-cmd=valkey-cli -a \\$VALKEY_PASSWORD\\ ping || exit 1 --health-interval=30s --health-timeout=10s --health-retries=3",
  "post_parameters": "sh -c exec valkey-server --appendonly yes --protected-mode yes --requirepass $VALKEY_PASSWORD",
  "web_ui_url": "http://[IP]:[PORT:6379]",
  "icon": "https://raw.githubusercontent.com/SnuK87/unraid-templates/refs/heads/main/icons/valkey-logo.png",
  "project": "https://valkey.io/",
  "description": "Valkey is an open source (BSD) high-performance key/value datastore that supports a variety of workloads such as caching and message queues, and can act as a primary database.",
  "paths": [
    {
      "name": "ConfigData",
      "host": "/mnt/cache/appdata/Immich/database/redis",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Valkey Port",
      "host": "6379",
      "container": "6379",
      "protocol": "tcp",
      "description": "Default port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VALKEY_PASSWORD",
      "key": "VALKEY_PASSWORD",
      "value": "Change_ME",
      "description": "Set a password for Valkey/Redis, or remove the extra parameters and post arguments and then delete this variable to run passwordless.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
