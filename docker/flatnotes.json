{
  "name": "flatnotes",
  "repo": "dullage/flatnotes",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dullage/flatnotes",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/tquizzle/Docker-xml/master/img/flatnotes.png",
  "project": "https://github.com/Dullage/flatnotes",
  "description": "A self-hosted, database-less note taking web app that utilises a flat folder of markdown files for storage.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/flatnotes",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "User ID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Group ID",
      "key": "GUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Auth Type",
      "key": "FLATNOTES_AUTH_TYPE",
      "value": "password",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Username",
      "key": "FLATNOTES_USERNAME",
      "value": "user",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Password",
      "key": "FLATNOTES_PASSWORD",
      "value": "changeMe!",
      "description": null,
      "required": true,
      "mask": true
    },
    {
      "name": "Secret Key",
      "key": "FLATNOTES_SECRET_KEY",
      "value": "aLongRandomSeriesOfCharacters",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
