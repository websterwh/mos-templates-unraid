{
  "name": "Wanderer---Database",
  "repo": "flomp/wanderer-db:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/flomp/wanderer-db",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8090]",
  "icon": "https://raw.githubusercontent.com/Flomp/wanderer/refs/heads/main/web/static/favicon.png",
  "project": "https://github.com/Flomp/wanderer",
  "description": "A self-hosted trail database. You can upload your recorded tracks or create new ones and add various metadata to build an easily searchable catalogue. This is the database component.",
  "paths": [
    {
      "name": "Database Storage Path",
      "host": "/mnt/cache/appdata/wanderer/db",
      "container": "/pb_data",
      "mode": "rw",
      "description": "Path to store the database",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Connection Port",
      "host": "8090",
      "container": "8090",
      "protocol": "tcp",
      "description": "Container Port: 8090",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Meilisearch - URL",
      "key": "MEILI_URL",
      "value": "http://meilisearch:7700",
      "description": "URL of the Meilisearch instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Meilisearch - Master Key",
      "key": "MEILI_MASTER_KEY",
      "value": "",
      "description": "Master key for the Meilisearch instance",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
