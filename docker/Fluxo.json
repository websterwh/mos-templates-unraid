{
  "name": "Fluxo",
  "repo": "ghcr.io/synshiftlabs/fluxo:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/SynShiftLabs/Fluxo/pkgs/container/fluxo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/SynShiftLabs/Fluxo_Unraid/main/icon.png",
  "project": "https://github.com/SynShiftLabs/Fluxo_Unraid",
  "description": "Fluxo \u2013 Pers\u00f6nliche Haushaltsbuch-App. ASP.NET Core Backend mit integriertem React-Frontend. Ben\u00f6tigt eine externe PostgreSQL-Datenbank.",
  "paths": [
    {
      "name": "App Daten",
      "host": "/mnt/cache/appdata/fluxo",
      "container": "/data",
      "mode": "rw",
      "description": "Hier werden die automatisch generierten Secrets gespeichert.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Port \u00fcber den Fluxo im Browser erreichbar ist. Standard 80 = kein Port in der URL n\u00f6tig.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Datenbank Host",
      "key": "DB_HOST",
      "value": "",
      "description": "IP-Adresse oder Hostname des PostgreSQL-Containers, z.B. 192.168.178.115",
      "required": true,
      "mask": false
    },
    {
      "name": "Datenbank Port",
      "key": "DB_PORT",
      "value": "5432",
      "description": "PostgreSQL Port. Standard: 5432",
      "required": true,
      "mask": false
    },
    {
      "name": "Datenbank Name",
      "key": "DB_NAME",
      "value": "fluxo",
      "description": "Name der Datenbank.",
      "required": true,
      "mask": false
    },
    {
      "name": "Datenbank Benutzer",
      "key": "DB_USER",
      "value": "",
      "description": "PostgreSQL Benutzername.",
      "required": true,
      "mask": false
    },
    {
      "name": "Datenbank Passwort",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "PostgreSQL Passwort.",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
