{
  "name": "Viseron",
  "repo": "roflcoopter/viseron",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/roflcoopter/viseron/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8888]/",
  "icon": "https://github.com/roflcoopter/viseron/raw/master/docs/static/img/viseron-logo.png",
  "project": "https://viseron.netlify.app/",
  "description": "Self-hosted, local only NVR and AI Computer Vision software.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/viseron-config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "Default Container Port: 8888 (can be changed in Viseron config.yaml)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User identifier",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group identifier",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
