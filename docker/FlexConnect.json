{
  "name": "FlexConnect",
  "repo": "digitalhigh/flexconnect",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/digitalhigh/flexconnect",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5667]",
  "icon": "https://github.com/d8ahazard/Phlex/raw/master/img/android-icon-144x144.png",
  "project": "https://github.com/d8ahazard/FlexConnect",
  "description": "FlexConnect is a stand-alone version of the FlexTV Plugin. It is intended as a replacement once Plex sunsest the plugin feature. This is currently for development purposes only.",
  "paths": [
    {
      "name": "Host Path 2",
      "host": "",
      "container": "/plex",
      "mode": "ro",
      "description": "Container Path: /plex",
      "required": true
    },
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/FlexConnect",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
