{
  "name": "droppy",
  "repo": "silverwind/droppy:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/silverwind/droppy/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8989]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/droppy.png",
  "project": "https://hub.docker.com/r/silverwind/droppy/",
  "description": "Self-hosted file storage server with a web interface and capabilities to edit files and view media directly in the browser.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/doppy/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    },
    {
      "name": "Files",
      "host": "/mnt/cache/droppy/",
      "container": "/files",
      "mode": "rw",
      "description": "Container Path: /files",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8686",
      "container": "8989",
      "protocol": "tcp",
      "description": "Container Port: 8989",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": "Container Variable: UID",
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": "Container Path: GID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
