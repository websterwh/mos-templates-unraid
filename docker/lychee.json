{
  "name": "lychee",
  "repo": "lscr.io/linuxserver/lychee",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/lychee",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/lychee-logo.png",
  "project": "https://lycheeorg.github.io/",
  "description": "Lychee(https://lycheeorg.github.io/) is a free photo-management tool, which runs on your server or web-space. Installing is a matter of seconds. Upload, manage and share photos like from a native application. Lychee comes with everything you need and all your photos are stored securely.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files.",
      "required": true
    },
    {
      "name": "Path: /pictures",
      "host": "",
      "container": "/pictures",
      "mode": "rw",
      "description": "Where lychee will store uploaded images.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "http gui",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DB_CONNECTION",
      "key": "DB_CONNECTION",
      "value": "",
      "description": "DB type, from `sqlite`, `mysql`, `pqsql`.",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "",
      "description": "DB server hostname. For `mysql` and `pgsql` only.",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "",
      "description": "DB server port. For `mysql` and `pgsql` only.",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": "",
      "description": "DB user. For `mysql` and `pgsql` only.",
      "required": true,
      "mask": false
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "DB password. For `mysql` and `pgsql` only.",
      "required": true,
      "mask": true
    },
    {
      "name": "DB_DATABASE",
      "key": "DB_DATABASE",
      "value": "",
      "description": "Path to DB file for `sqlite`. DB name for `mysql` and `pgsql`.",
      "required": true,
      "mask": false
    },
    {
      "name": "APP_NAME",
      "key": "APP_NAME",
      "value": "Lychee",
      "description": "The gallery name.",
      "required": false,
      "mask": false
    },
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "",
      "description": "The URL you will use to access Lychee including protocol, and port where appropriate.",
      "required": false,
      "mask": false
    },
    {
      "name": "TRUSTED_PROXIES",
      "key": "TRUSTED_PROXIES",
      "value": "",
      "description": "Set to the IP or netmask covering your reverse proxy, if running behind one. Set to `*` to trust all IPs (**do not** use `*` if exposed to the internet`).",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
