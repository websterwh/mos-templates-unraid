{
  "name": "IPTV-Tunerr",
  "repo": "ghcr.io/snapetech/iptvtunerr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/snapetech/iptvtunerr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --security-opt=no-new-privileges:true",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:48879]/",
  "icon": "https://raw.githubusercontent.com/snapetech/iptvtunerr/main/docs/assets/iptvtunerr-icon.svg",
  "project": "https://github.com/snapetech/iptvtunerr",
  "description": "IPTV to Plex, Emby, and Jellyfin: HDHomeRun-emulating tuner, custom merged XMLTV guide, resilient stream gateway, DVR and recording rules, VOD libraries, and an operator dashboard.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/iptvtunerr",
      "container": "/var/lib/iptvtunerr",
      "mode": "rw",
      "description": "Persistent catalog and dashboard state.",
      "required": true
    },
    {
      "name": "Cache",
      "host": "/mnt/cache/appdata/iptvtunerr/cache",
      "container": "/var/cache/iptvtunerr",
      "mode": "rw",
      "description": "Persistent guide and provider caches. This directory can grow with provider data.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Tuner Port",
      "host": "5004",
      "container": "5004",
      "protocol": "tcp",
      "description": "HTTP tuner, stream, playlist, and guide endpoint. Keep this on a trusted LAN or VPN.",
      "required": true,
      "mask": false
    },
    {
      "name": "Operator Dashboard Port",
      "host": "48879",
      "container": "48879",
      "protocol": "tcp",
      "description": "Authenticated Tunerr operator dashboard. Do not expose this port publicly.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Catalog File",
      "key": "IPTV_TUNERR_CATALOG",
      "value": "/var/lib/iptvtunerr/catalog.json",
      "description": "Persistent channel catalog path.",
      "required": true,
      "mask": false
    },
    {
      "name": "Cache Directory",
      "key": "IPTV_TUNERR_CACHE",
      "value": "/var/cache/iptvtunerr",
      "description": "Persistent cache directory.",
      "required": true,
      "mask": false
    },
    {
      "name": "Dashboard State File",
      "key": "IPTV_TUNERR_WEBUI_STATE_FILE",
      "value": "/var/lib/iptvtunerr/webui-state.json",
      "description": "Persistent operator dashboard preferences and state.",
      "required": true,
      "mask": false
    },
    {
      "name": "Base URL",
      "key": "IPTV_TUNERR_BASE_URL",
      "value": "",
      "description": "Required URL that Plex, Emby, or Jellyfin can reach, including the host port if remapped (for example http://192.168.1.20:5004).",
      "required": true,
      "mask": false
    },
    {
      "name": "Provider URL",
      "key": "IPTV_TUNERR_PROVIDER_URL",
      "value": "",
      "description": "Optional Xtream-style provider base URL.",
      "required": false,
      "mask": false
    },
    {
      "name": "Provider Username",
      "key": "IPTV_TUNERR_PROVIDER_USER",
      "value": "",
      "description": "Optional provider username.",
      "required": false,
      "mask": false
    },
    {
      "name": "Provider Password",
      "key": "IPTV_TUNERR_PROVIDER_PASS",
      "value": "",
      "description": "Optional provider password.",
      "required": false,
      "mask": true
    },
    {
      "name": "M3U URL",
      "key": "IPTV_TUNERR_M3U_URL",
      "value": "",
      "description": "Optional M3U source URL. Treat URLs containing credentials as secrets.",
      "required": false,
      "mask": true
    },
    {
      "name": "Plex URL",
      "key": "IPTV_TUNERR_PMS_URL",
      "value": "",
      "description": "Optional Plex Media Server URL for automatic tuner registration.",
      "required": false,
      "mask": false
    },
    {
      "name": "Plex Token",
      "key": "IPTV_TUNERR_PMS_TOKEN",
      "value": "",
      "description": "Optional Plex token for automatic tuner registration.",
      "required": false,
      "mask": true
    },
    {
      "name": "API-Sports Key",
      "key": "IPTV_TUNERR_API_SPORTS_KEY",
      "value": "",
      "description": "Optional server-side API-Sports key for Sports Automation.",
      "required": false,
      "mask": true
    },
    {
      "name": "Dashboard Username",
      "key": "IPTV_TUNERR_WEBUI_USER",
      "value": "admin",
      "description": "Username for the operator dashboard.",
      "required": true,
      "mask": false
    },
    {
      "name": "Dashboard Password",
      "key": "IPTV_TUNERR_WEBUI_PASS",
      "value": "",
      "description": "Required strong password for the operator dashboard.",
      "required": true,
      "mask": true
    },
    {
      "name": "Dashboard LAN Access",
      "key": "IPTV_TUNERR_WEBUI_ALLOW_LAN",
      "value": "1",
      "description": "Allow the authenticated dashboard to accept connections on the mapped LAN port.",
      "required": true,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": "Container timezone.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
