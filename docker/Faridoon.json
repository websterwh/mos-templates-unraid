{
  "name": "Faridoon",
  "repo": "ghcr.io/jamesread/faridoon:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jamesread/faridoon",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/faridoon-icon.png",
  "project": "https://jamesread.github.io/Faridoon/",
  "description": "A web app to publish your favourite chat quotes.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/faridoon/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to store configuration files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MySQL - Host",
      "key": "DB_HOST",
      "value": "",
      "description": "MySQL host",
      "required": true,
      "mask": false
    },
    {
      "name": "MySQL - Name",
      "key": "DB_NAME",
      "value": "faridoon",
      "description": "MySQL database name",
      "required": true,
      "mask": false
    },
    {
      "name": "MySQL - User",
      "key": "DB_USER",
      "value": "faridoon",
      "description": "MySQL user",
      "required": true,
      "mask": false
    },
    {
      "name": "MySQL - Password",
      "key": "DB_PASS",
      "value": "",
      "description": "MySQL password",
      "required": true,
      "mask": true
    },
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": "",
      "description": "Admin password",
      "required": true,
      "mask": true
    },
    {
      "name": "Site Title",
      "key": "SITE_TITLE",
      "value": "Faridoon",
      "description": "Title of the site",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable Voting",
      "key": "ENABLE_VOTING",
      "value": "0|1",
      "description": "Set to 1 to enable voting on quotes.",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable Syntax Highlighting",
      "key": "ENABLE_SYNTAX_HIGHLIGHTING",
      "value": "0|1",
      "description": "Set to 1 to enable syntax highlighting in quotes.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
