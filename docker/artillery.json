{
  "name": "artillery",
  "repo": "obviousviking/artillery",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/obviousviking/artillery/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/ObviousViking/Artillery/refs/heads/main/logo.png",
  "project": "https://github.com/ObviousViking/Artillery",
  "description": "Artillery is a simple web-ui for gallery-dl. It helps less experienced users easily set tasks and download the art they want. This is still a work in progress so bugs are likely",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/artillery/config",
      "container": "/config",
      "mode": "rw",
      "description": "The location of the global gallery-dl config file",
      "required": true
    },
    {
      "name": "downloads",
      "host": "/mnt/cache/artillery/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "This is where your downloaded media will be stored",
      "required": true
    },
    {
      "name": "tasks",
      "host": "/mnt/cache/artillery/tasks",
      "container": "/tasks",
      "mode": "rw",
      "description": "This location will store your scheduled tasks",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Container Port 1",
      "host": "8088",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
