{
  "name": "ESPHome-LibreTiny",
  "repo": "ghcr.io/libretiny-eu/libretiny-esphome-docker:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/orgs/libretiny-eu/packages/container/package/libretiny-esphome-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6052]/",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/esphome-libretiny.png",
  "project": "https://docs.libretiny.eu/",
  "description": "The official LibreTiny Fork of ESPHome. What is the difference of the fork? This enables the use of the BK7231 and RTL8710B chips with ESPHome. No more manually building the container! Video of CloudCutter and LibreTiny/Tuya - https://youtu.be/i9HokGpj-kE",
  "paths": [
    {
      "name": "Config Folder",
      "host": "/mnt/cache/appdata/esphome-lt",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Communication",
      "host": "6124",
      "container": "6123",
      "protocol": "tcp",
      "description": "Communication Port",
      "required": false,
      "mask": false
    },
    {
      "name": "WebUI",
      "host": "6053",
      "container": "6052",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Dashboard Use Ping",
      "key": "ESPHOME_DASHBOARD_USE_PING",
      "value": "false",
      "description": "Set this to true if the devices are showing offline",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
