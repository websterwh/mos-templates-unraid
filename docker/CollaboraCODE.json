{
  "name": "Collabora-CODE",
  "repo": "collabora/code",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/collabora/code/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:9980]/browser/dist/admin/admin.html",
  "icon": "https://raw.githubusercontent.com/chvb/docker-templates/master/chvb/img/collabora.png",
  "project": "https://sdk.collaboraonline.com/docs/installation/CODE_Docker_image.html",
  "description": "Updated to not use domain enviroment variable Collabora/Code Online Development Edition - an awesome, Online Office suite image suitable for home use. You can use Collabora/Code for your Nextcloud an edit your Office Documents Online!",
  "paths": [],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "9980",
      "container": "9980",
      "protocol": "tcp",
      "description": "Container Port: 9980",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Username",
      "key": "username",
      "value": "admin",
      "description": "Container Variable: username",
      "required": false,
      "mask": false
    },
    {
      "name": "Password",
      "key": "password",
      "value": "yourpassword",
      "description": "Container Variable: password",
      "required": false,
      "mask": false
    },
    {
      "name": "Spelling dictionaries",
      "key": "dictionaries",
      "value": "de_DE en_GB en_US es_ES fr_FR it nl pt_BR pt_PT ru",
      "description": "By default only limited set of spelling dictionaries and thesauri are configured for CODE, mainly for performance reasons.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
