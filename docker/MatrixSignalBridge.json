{
  "name": "MatrixSignalBridge",
  "repo": "dock.mau.dev/mautrix/signal:latest",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/r/dock.mau.dev/mautrix/signal",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:29328]",
  "icon": "https://raw.githubusercontent.com/Richy1989/unraid-icons/main/icons/signal.png",
  "project": "https://docs.mau.fi/bridges/general/docker-setup.html?bridge=signal",
  "description": "A bridge for Signal and Matrix. Requirements - Docker - A Matrix homeserver that supports application services (e.g. Synapse) You need access to register an appservice, which usually involves editing the homeserver config file. - A Signal client that can add linked devices (both official mobile apps and some unofficial clients like signal-cli work). Initial Bridge Config Help: - https://docs.mau.fi/bridges/general/initial-config.html Authentication Help: - https://docs.mau.fi/bridges/go/signal/authentication.html",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/matrix_signal_bridge",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "29328",
      "container": "29328",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
