{
  "name": "kiwix-serve",
  "repo": "ghcr.io/kiwix/kiwix-serve",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/kiwix/kiwix-tools/tree/main/docker/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "*.zim",
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/kiwix.png",
  "project": "https://www.kiwix.org/",
  "description": "Kiwix enables you to have the whole Wikipedia at hand wherever you go! Remove download link after download complete.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/kiwix-serve/",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8040",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Download",
      "key": "DOWNLOAD",
      "value": "http://download.kiwix.org/zim/wikipedia_en_chemistry_nopic.zim",
      "description": "Add download link here to download contents https://wiki.kiwix.org/wiki/Content",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
