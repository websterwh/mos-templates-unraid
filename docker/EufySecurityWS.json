{
  "name": "Eufy-Security-WS",
  "repo": "bropat/eufy-security-ws",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/bropat/eufy-security-ws/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://github.com/bropat/eufy-security-ws/raw/master/docs/_media/eufy-security-ws.png",
  "project": "https://github.com/bropat/eufy-security-ws",
  "description": "A small server wrapper around eufy-security-client library to access it via a WebSocket Exposes the client library over websocket Implements almost all functionality of the client library Including live streaming https://hub.docker.com/r/bropat/eufy-security-ws/",
  "paths": [
    {
      "name": "Container Path 1",
      "host": "/mnt/cache/appdata/eufy-security-ws",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Container Port 1",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "USERNAME",
      "key": "USERNAME",
      "value": "",
      "description": "Eufy Account Username (required)",
      "required": true,
      "mask": false
    },
    {
      "name": "PASSWORD",
      "key": "PASSWORD",
      "value": "",
      "description": "Eufy Account Password (required)",
      "required": true,
      "mask": true
    },
    {
      "name": "COUNTRY",
      "key": "COUNTRY",
      "value": "US",
      "description": "ISO 3166-1 Alpha-2 country code (default: US)",
      "required": true,
      "mask": false
    },
    {
      "name": "LANGUAGE",
      "key": "LANGUAGE",
      "value": "en",
      "description": "ISO 639 language code (default: en)",
      "required": true,
      "mask": false
    },
    {
      "name": "TRUSTED_DEVICE_NAME",
      "key": "TRUSTED_DEVICE_NAME",
      "value": "eufyclient",
      "description": "Label of the trusted devices (viewable with 2fa activated in Eufy App; default: random device name)",
      "required": false,
      "mask": false
    },
    {
      "name": "EVENT_DURATION_SECONDS",
      "key": "EVENT_DURATION_SECONDS",
      "value": "10",
      "description": "Duration in seconds before an event is reset E.g. motion event (default: 10 sec.)",
      "required": false,
      "mask": false
    },
    {
      "name": "P2P_CONNECTION_SETUP",
      "key": "P2P_CONNECTION_SETUP",
      "value": "0",
      "description": "P2P connection setup (default: 0 ; Prefers local connection over cloud)",
      "required": false,
      "mask": false
    },
    {
      "name": "POLLING_INTERVAL_MINUTES",
      "key": "POLLING_INTERVAL_MINUTES",
      "value": "10",
      "description": "Polling intervall for data refresh from Eufy Cloud (default: 10 min.)",
      "required": false,
      "mask": false
    },
    {
      "name": "ACCEPT_INVITATIONS",
      "key": "ACCEPT_INVITATIONS",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "STATION_IP_ADDRESSES",
      "key": "STATION_IP_ADDRESSES",
      "value": "",
      "description": "Suggested IP addresses for a stations (default: unset; value format: station_serial1:ipaddress1;station_serial2:ipaddress2)",
      "required": false,
      "mask": false
    },
    {
      "name": "DEBUG",
      "key": "DEBUG",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
