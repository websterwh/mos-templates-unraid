{
  "name": "bliss",
  "repo": "romancin/bliss",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/romancin/bliss/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3220]",
  "icon": "https://www.blisshq.com/images/logo_551x198.png",
  "project": "https://hub.docker.com/r/romancin/bliss/",
  "description": "Instructions: Map any local port to 3220 for web access Map any local port to 3221 (used for bliss internal web server) Map a local volume to /config (Stores configuration data) Map a local volume to /music (This is the directory wher you should put your music for bliss to scan) Setup the application Once the docker container is up and running you can access the WebUI at host-ip-address:3220. Out of the box you have 100 fixes included as a trial, but I recommend that you buy the amount of fixes you need.",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/cache/appdata/bliss",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "music",
      "host": "",
      "container": "/music",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3220",
      "container": "3220",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Web Server",
      "host": "3221",
      "container": "3221",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
