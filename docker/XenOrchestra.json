{
  "name": "XenOrchestra",
  "repo": "ronivay/xen-orchestra",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ronivay/xen-orchestra",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://xen-orchestra.com/assets/logo.png",
  "project": "https://xen-orchestra.com",
  "description": "Xen-Orchestra is a Web-UI for managing your existing XenServer infrastructure. If you want to mount NFS shares for Remotes within docker, you need to enable privilaged mode.",
  "paths": [
    {
      "name": "Data xo-server",
      "host": "/mnt/cache/appdata/xen-orchestra/xo-server",
      "container": "/var/lib/xo-server",
      "mode": "rw",
      "description": "Container Path: /var/lib/xo-server",
      "required": false
    },
    {
      "name": "Data Redis",
      "host": "/mnt/cache/appdata/xen-orchestra/redis",
      "container": "/var/lib/redis",
      "mode": "rw",
      "description": "Container Path: /var/lib/redis",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP WebUI",
      "required": false,
      "mask": false
    },
    {
      "name": "WebUI HTTPS",
      "host": "8443",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS WebUI",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
