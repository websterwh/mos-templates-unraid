{
  "name": "Pulse",
  "repo": "rcourtman/pulse:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/rcourtman/pulse",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7655]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/pulse-logo.png",
  "project": "https://github.com/rcourtman/Pulse",
  "description": "Real-time monitoring for Proxmox VE, Proxmox Mail Gateway, PBS, and Docker infrastructure with alerts and webhooks. Monitor your hybrid Proxmox and Docker estate from a single dashboard. Get instant alerts when nodes go down, containers misbehave, backups fail, or storage fills up. Supports email, Discord, Slack, Telegram, and more. Try the live demo: https://demo.pulserelay.pro/ (read-only with mock data)",
  "paths": [
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/pulse",
      "container": "/data",
      "mode": "rw",
      "description": "Data Directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEBUI",
      "host": "7655",
      "container": "7655",
      "protocol": "tcp",
      "description": "Web Interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "WEB admin user",
      "key": "PULSE_AUTH_USER",
      "value": "admin",
      "description": "Username for web UI login",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin password",
      "key": "PULSE_AUTH_PASS",
      "value": "",
      "description": "Plain text or bcrypt hash (auto-hashed if plain)",
      "required": true,
      "mask": true
    },
    {
      "name": "Log level",
      "key": "LOG_LEVEL",
      "value": "info",
      "description": "Log level: debug/info/warn/error (default: info)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
