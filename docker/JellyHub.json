{
  "name": "JellyHub",
  "repo": "zigleur/jellyhub:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/zigleur/jellyhubr",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/master/logos/jellyhub.png",
  "project": "https://github.com/Zigl3ur/jellyhub",
  "description": "Indexes all content from multiple Jellyfin servers, allowing you to see which items are available on which server.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "JWT Secret",
      "key": "JWT_SECRET",
      "value": "your-very-long-and-mysterious-secret",
      "description": "Change this to a random secure string.",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Connection String",
      "key": "DATABASE_URL",
      "value": "postgresql://jellyhub:jellyhub@localhost:5432/jellyhub?schema=prisma",
      "description": "Change this to your Postgres connection string.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
