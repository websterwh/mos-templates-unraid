{
  "name": "Ripper",
  "repo": "rix1337/docker-ripper:manual-latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/rix1337/docker-ripper",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--device=/dev/sr0:/dev/sr0",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9090]",
  "icon": "https://raw.githubusercontent.com/rix1337/docker-templates/main/rix1337/ripper.png",
  "project": null,
  "description": "This container will detect optical disks by their type and rip them automatically.",
  "paths": [
    {
      "name": "Output Dir",
      "host": "/mnt/cache/Downloads/",
      "container": "/out",
      "mode": "rw",
      "description": "Output files are stored here",
      "required": true
    },
    {
      "name": "Config Dir",
      "host": "/mnt/cache/appdata/ripper",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration files are stored here",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Webserver",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Web UI Port to view the Ripper log: 9090",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Web Path Prefix",
      "key": "OPTIONAL_WEB_UI_PATH_PREFIX",
      "value": "",
      "description": "Optional: can be used to set a path prefix (e.g. /ripper-ui). This is useful when you are running multiple services at one domain.",
      "required": false,
      "mask": false
    },
    {
      "name": "Web UI Username",
      "key": "OPTIONAL_WEB_UI_USERNAME",
      "value": "",
      "description": "Optional: Requires OPTIONAL_WEB_UI_PASSWORD, enables http-Auth in Web UI",
      "required": false,
      "mask": false
    },
    {
      "name": "Web UI Password",
      "key": "OPTIONAL_WEB_UI_PASSWORD",
      "value": "",
      "description": "Optional: Requires OPTIONAL_WEB_UI_USERNAME, enables http-Auth in Web UI",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
