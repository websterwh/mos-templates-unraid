{
  "name": "firecrawl-postgres",
  "repo": "ghcr.io/firecrawl/nuq-postgres:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/firecrawl/firecrawl",
  "network": "firecrawl",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Sherr0/unraid-firecrawl/main/icons/firecrawl-postgres.png",
  "project": "https://github.com/firecrawl/firecrawl",
  "description": "Firecrawl NuQ PostgreSQL is the PostgreSQL database used by Firecrawl for its NuQ job queue and application data. Uses the official Firecrawl nuq-postgres Docker image. Configuration /mnt/user/appdata/firecrawl/postgres Persistent PostgreSQL data storage. PostgreSQL Port 5432 Internal PostgreSQL connection port. Firecrawl connects to PostgreSQL through the firecrawl Docker network. No host port is required. POSTGRES_USER PostgreSQL username. Defaults to postgres. POSTGRES_PASSWORD PostgreSQL superuser password. Required. POSTGRES_DB PostgreSQL database name. Defaults to postgres.",
  "paths": [
    {
      "name": "Database Storage Path",
      "host": "/mnt/cache/appdata/firecrawl/postgres",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "PostgreSQL data storage location",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "postgres",
      "description": "Initial superuser password (required)",
      "required": true,
      "mask": true
    },
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "postgres",
      "description": "Initial superuser name (default: postgres)",
      "required": false,
      "mask": false
    },
    {
      "name": "POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "postgres",
      "description": "Initial database name (default: postgres)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
