{
  "name": "Intel-IPEX-LLM-Ollama",
  "repo": "ghcr.io/justjoseorg/ollama-intel-gpu:main",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/justjoseorg/ollama-intel-gpu",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:11434]",
  "icon": "https://raw.githubusercontent.com/justjoseorg/ollama-intel-gpu/main/doc/LlamaIntel.png",
  "project": null,
  "description": "IPEX-LLM is an LLM acceleration library for Intel GPU (e.g., local PC with iGPU, discrete GPU such as Arc, Flex and Max), NPU and CPU This Image is meant to be a one way stop for AI enthusiasts with an Intel iGPU or dGPU to run models using Ollama. Make sure to have reBar enabled",
  "paths": [
    {
      "name": "Models",
      "host": "/mnt/cache/Models/ollama",
      "container": "/root/.ollama",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Ollama port",
      "host": "11434",
      "container": "11434",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OLLAMA_HOST",
      "key": "OLLAMA_HOST:",
      "value": "0.0.0.0",
      "description": "Allow connections from the Value",
      "required": true,
      "mask": false
    },
    {
      "name": "ONEAPI_DEVICE_SELECTOR",
      "key": "ONEAPI_DEVICE_SELECTOR",
      "value": "level_zero:0",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "IPEX_LLM_NUM_CTX",
      "key": "IPEX_LLM_NUM_CTX",
      "value": "16384",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OLLAMA_INTEL_GPU",
      "key": "OLLAMA_INTEL_GPU",
      "value": "1",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OLLAMA_NUM_GPU",
      "key": "OLLAMA_NUM_GPU",
      "value": "999",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "ZES_ENABLE_SYSMAN",
      "key": "ZES_ENABLE_SYSMAN",
      "value": "1",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OLLAMA_DEBUG",
      "key": "OLLAMA_DEBUG",
      "value": "1",
      "description": "Enable Ollama debug logs",
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "GPU",
      "host": "/dev/dri",
      "container": "/dev/dri",
      "description": null,
      "required": true
    }
  ],
  "labels": []
}
