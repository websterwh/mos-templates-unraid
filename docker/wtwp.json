{
  "name": "wtwp",
  "repo": "netplexflix/wtwp:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/netplexflix/wtwp",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/MrCorehh/unraid-templates/main/netplexflix/wtwp.png",
  "project": "https://github.com/netplexflix/What-to-watch-on-Plex",
  "description": "What to Watch? Decide what to watch on your Plex server by swiping cards based on your group's preferences. Find a Movie or TV Show everyone wants to watch.",
  "paths": [
    {
      "name": "/app/data",
      "host": "/mnt/cache/appdata/wtwp",
      "container": "/app/data",
      "mode": "rw",
      "description": "Persistent data storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEBUI_PORT",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "CORS_ORIGINS",
      "key": "CORS_ORIGINS",
      "value": "",
      "description": "EG: http://192.168.1.100:PORT,https://wtw.yourdomain.com",
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Australia/Brisbane",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DATA_PATH",
      "key": "DATA_PATH",
      "value": "/app/data",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NODE_ENV",
      "key": "NODE_ENV",
      "value": "production",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file permissions",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file permissions",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
