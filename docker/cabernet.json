{
  "name": "cabernet",
  "repo": "ghcr.io/cabernetwork/cabernet:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/cabernetwork/cabernet",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6077]/",
  "icon": "https://avatars.githubusercontent.com/u/84645683?s=48&v=4",
  "project": "https://github.com/cabernetwork/cabernet/tree/master",
  "description": "Cabernet allows control of IPTV streams. Plugins supports DaddyLive, Pluto TV, XUMO, M3U/XMLTV.XML files (SamsungTV, STIRR, DistroTV, Plex TV)",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/cabernet",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Plugins",
      "host": "/mnt/cache/appdata/cabernet/plugins_ext",
      "container": "/app/plugins_ext",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Encyprtion Key",
      "host": "/mnt/cache/appdata/cabernet/secrets",
      "container": "/app/.cabernet",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6077",
      "container": "6077",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Streaming Port",
      "host": "5004",
      "container": "5004",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
