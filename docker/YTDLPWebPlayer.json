{
  "name": "YT-DLP-Web-Player",
  "repo": "ghcr.io/matszwe02/ytdlp_web_player:stable",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/matszwe02/ytdlp_web_player/main/src/static/favicon.svg",
  "project": "https://github.com/Matszwe02/ytdlp_web_player",
  "description": "YT-DLP Web Player - Internet video player powered by yt-dlp",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "HTTP port for the WebUI.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "App Title",
      "key": "APP_TITLE",
      "value": "YT-DLP Player",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Theme Color",
      "key": "THEME_COLOR",
      "value": "#ff7300",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Generate Sprite Below",
      "key": "GENERATE_SPRITE_BELOW",
      "value": "1800",
      "description": "generate sprites for videos below this duration (0 to disable)",
      "required": false,
      "mask": false
    },
    {
      "name": "Amoled Bg",
      "key": "AMOLED_BG",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Max Video Age",
      "key": "MAX_VIDEO_AGE",
      "value": "3600",
      "description": "inactivity after which video is removed",
      "required": false,
      "mask": false
    },
    {
      "name": "Max Video Duration",
      "key": "MAX_VIDEO_DURATION",
      "value": "36000",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Default Quality",
      "key": "DEFAULT_QUALITY",
      "value": "720",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Max Quality",
      "key": "MAX_QUALITY",
      "value": "2160",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Autoplay",
      "key": "AUTOPLAY",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Always Transcode",
      "key": "ALWAYS_TRANSCODE",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Disable Transcoding",
      "key": "DISABLE_TRANSCODING",
      "value": "false",
      "description": "useful for low-performance machines, only basic features will work",
      "required": false,
      "mask": false
    },
    {
      "name": "Autoskip Sb Segments",
      "key": "AUTOSKIP_SB_SEGMENTS",
      "value": "",
      "description": "comma separated, e.g. selfpromo,outro,sponsor,preview,interaction,intro,music_offtopic",
      "required": false,
      "mask": false
    },
    {
      "name": "Cookies Only On Failure",
      "key": "COOKIES_ONLY_ON_FAILURE",
      "value": "true",
      "description": "only use cookies if necessary",
      "required": false,
      "mask": false
    },
    {
      "name": "Auto Bg Playback",
      "key": "AUTO_BG_PLAYBACK",
      "value": "true",
      "description": "keep playing videos in background after leaving application or locking screen",
      "required": false,
      "mask": false
    },
    {
      "name": "Audio Visualizer",
      "key": "AUDIO_VISUALIZER",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Proxy",
      "key": "PROXY",
      "value": "",
      "description": "proxy for accessing video sources, e.g. http://127.0.0.1:8888",
      "required": false,
      "mask": false
    }
