{
  "name": "Lufi",
  "repo": "ghcr.io/megalis-bretagne/lufi:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/megalis-bretagne/lufi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://framagit.org/uploads/-/system/project/avatar/1998/lufi.png",
  "project": "https://framagit.org/fiat-tux/hat-softwares/lufi",
  "description": "Let's Upload that FIle - An E2E encrypted file sharing software.",
  "paths": [
    {
      "name": "File Storage",
      "host": "/mnt/cache/appdata/lufi/files",
      "container": "/lufi/files",
      "mode": "rw",
      "description": "Path to file storage",
      "required": true
    },
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/lufi/lufi.conf",
      "container": "/home/nonroot/lufi/lufi.conf",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
