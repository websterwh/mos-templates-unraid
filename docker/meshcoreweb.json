{
  "name": "meshcore-web",
  "repo": "ghcr.io/drewzh/meshcore-web-docker:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/drewzh/meshcore-web-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/drewzh/unraid-templates/main/icons/meshcore-web.png",
  "project": "https://github.com/drewzh/meshcore-web-docker",
  "description": "Docker container that downloads and hosts the MeshCore web application with automatic version management and persistent storage.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/meshcore-web/versions",
      "container": "/app/versions",
      "mode": "rw",
      "description": "Persistent storage for MeshCore versions",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container web UI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/London",
      "description": "Container timezone",
      "required": false,
      "mask": false
    },
    {
      "name": "MESHCORE_BASE_URL",
      "key": "MESHCORE_BASE_URL",
      "value": "https://files.liamcottle.net/MeshCore",
      "description": "Base URL for MeshCore downloads",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file permissions",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file permissions",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
