{
  "name": "Pelagica",
  "repo": "kartoffelchipss/pelagica:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/kartoffelchipss/pelagica",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/master/logos/pelagica.png",
  "project": "https://github.com/KartoffelChipss/pelagica",
  "description": "An alternative, modern and configurable web frontend for Jellyfin built using React. Provides a fast, modern, and customizable user experience for browsing and watching your media library.",
  "paths": [
    {
      "name": "Config Folder",
      "host": "/mnt/cache/appdata/pelagica",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "The port for accessing the Pelagica web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
