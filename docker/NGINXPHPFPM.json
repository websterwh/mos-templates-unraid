{
  "name": "NGINX---PHP-FPM",
  "repo": "richarvey/nginx-php-fpm:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/richarvey/nginx-php-fpm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/nginx-php-fpm-icon.png",
  "project": "https://github.com/richarvey/nginx-php-fpm",
  "description": "Nginx + PHP-FPM capable of pulling application code from git.",
  "paths": [],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "1080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "1443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Git - Email",
      "key": "GIT_EMAIL",
      "value": "",
      "description": "Git email",
      "required": false,
      "mask": false
    },
    {
      "name": "Git - Name",
      "key": "GIT_NAME",
      "value": "",
      "description": "Git name",
      "required": false,
      "mask": false
    },
    {
      "name": "Git - Username",
      "key": "GIT_USERNAME",
      "value": "",
      "description": "Git username",
      "required": false,
      "mask": false
    },
    {
      "name": "Git - Repository",
      "key": "GIT_REPO",
      "value": "",
      "description": "Git repository",
      "required": false,
      "mask": false
    },
    {
      "name": "Git - Personal Token",
      "key": "GIT_PERSONAL_TOKEN",
      "value": "",
      "description": "Git personal token",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
