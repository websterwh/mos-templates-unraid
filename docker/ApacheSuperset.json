{
  "name": "Apache-Superset",
  "repo": "ghcr.io/jarretraim/unraid-superset:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/jarretraim/unraid-superset/pkgs/container/unraid-superset",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8088]/",
  "icon": "https://raw.githubusercontent.com/apache/superset/master/superset-frontend/src/assets/images/superset-logo-horiz.png",
  "project": "https://superset.apache.org/",
  "description": "Apache Superset is a modern data exploration and visualization platform. This container is packaged specifically for Unraid, featuring automated database initialization and admin account creation on the first run.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/superset",
      "container": "/app/superset_home",
      "mode": "rw",
      "description": "Persistent storage for the SQLite database and configurations.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8088",
      "container": "8088",
      "protocol": "tcp",
      "description": "Port for the Superset WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin Username",
      "key": "ADMIN_USERNAME",
      "value": "admin",
      "description": "Default admin username",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": "admin",
      "description": "Default admin password",
      "required": true,
      "mask": true
    },
    {
      "name": "Admin Email",
      "key": "ADMIN_EMAIL",
      "value": "admin@localhost",
      "description": "Default admin email",
      "required": true,
      "mask": false
    },
    {
      "name": "Secret Key",
      "key": "SUPERSET_SECRET_KEY",
      "value": "change_this_to_a_random_string",
      "description": "Secret key for Flask. Change this to a secure random string.",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
