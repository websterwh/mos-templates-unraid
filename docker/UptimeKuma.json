{
  "name": "UptimeKuma",
  "repo": "louislam/uptime-kuma",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/louislam/uptime-kuma/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3001]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/uptimekuma.png",
  "project": "https://github.com/louislam/uptime-kuma",
  "description": "Self-hosted monitoring tool like \"Uptime Robot\". Monitoring uptime for HTTP(s) / TCP / Ping. Fancy, Reactive, Fast UI/UX.Notifications via Webhook, Telegram, Discord, Gotify, Slack, Pushover, Email (SMTP) and more by Apprise. Fast 20 second inverval checks.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/uptimekuma",
      "container": "/app/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
