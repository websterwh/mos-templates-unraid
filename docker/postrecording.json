{
  "name": "post-recording",
  "repo": "chacawaca/post-recording",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/chacawaca/post-recording",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/chacawaca/docker-post-recording/master/Icon.png",
  "project": "https://github.com/chacawaca/docker-post-recording",
  "description": "Watches for .ts files made by Live TV recordings, convert them to a friendly format, extract .srt file, add chapters with comchap or remove them with comcut. Tested with Emby recordings. Nvidia GPU Use Using the Unraid Nvidia Plugin to install a version of Unraid with the Nvidia Drivers installed and add --runtime=nvidia to \"extra parameters\" (switch on advanced view) and copy your GPU UUID to NVIDIA_VISIBLE_DEVICES --------New Variable added --- verify your old custom.sh--------",
  "paths": [
    {
      "name": "CONFIG FOLDER",
      "host": "/mnt/cache/appdata/post-recording",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration folder /config",
      "required": true
    },
    {
      "name": "WATCH FOLDER",
      "host": "",
      "container": "/watch",
      "mode": "rw",
      "description": "This location contains .ts files that need converting /watch",
      "required": false
    },
    {
      "name": "BACKUP FOLDER",
      "host": "",
      "container": "/backup",
      "mode": "rw",
      "description": "Optional, only used if DELETE_TS is set to 2 /backup",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "DELETE_TS",
      "key": "DELETE_TS",
      "value": "1",
      "description": "Remove the original .ts recording file. 0 = Yes, 1 = No, 2 = Move to backup directory",
      "required": false,
      "mask": false
    },
    {
      "name": "SUBTITLES",
      "key": "SUBTITLES",
      "value": "0",
      "description": "Extract subtitles to .srt. 0= Yes, 1 = No",
      "required": false,
      "mask": false
    },
    {
      "name": "CONVERSION_FORMAT",
      "key": "CONVERSION_FORMAT",
      "value": "mkv",
      "description": "mkv or mp4",
      "required": false,
      "mask": false
    },
    {
      "name": "SOURCE_EXT",
      "key": "SOURCE_EXT",
      "value": "ts",
      "description": "Source file extension, default .ts",
      "required": false,
      "mask": false
    },
    {
      "name": "POST_PROCESS",
      "key": "POST_PROCESS",
      "value": "comchap",
      "description": "comchap or comcut default: comchap",
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "",
      "description": "GPU UUID retrieved from Nvidia plugin settings",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
