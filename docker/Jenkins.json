{
  "name": "Jenkins",
  "repo": "jenkins/jenkins",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/jenkins/jenkins/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "-u 99:100",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/jenkins.png",
  "project": "https://www.jenkins.io/",
  "description": "The leading open source automation server, Jenkins provides hundreds of plugins to support building, deploying and automating any project.",
  "paths": [
    {
      "name": "jenkins_home",
      "host": "/mnt/cache/appdata/Jenkins",
      "container": "/var/jenkins_home",
      "mode": "rw",
      "description": "Container Path: /var/jenkins_home",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
