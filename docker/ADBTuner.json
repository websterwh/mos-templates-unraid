{
  "name": "ADBTuner",
  "repo": "turtletank99/adbtuner",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/turtletank99/adbtuner",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5592]",
  "icon": "https://github.com/timstephens24/docker-templates/raw/master/img/adb-logo.png",
  "project": "https://community.getchannels.com/t/adbtuner-a-channel-tuning-application-for-networked-google-tv-android-tv-devices",
  "description": "ADBTuner is a small, containerized, web-based application that can load deep linked content on networked Android TV devices via ADB (Android Debug Bridge). ADBTuner is fully configurable via a web interface interface with support for multiple \"tuner\" devices and easily managed \"channels.\"",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/adbtuner",
      "container": "/app/.config",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5592",
      "container": "5592",
      "protocol": "tcp",
      "description": "Admin Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
