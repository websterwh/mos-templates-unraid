{
  "name": "setuparr",
  "repo": "ghcr.io/p1zzm1ssile/setuparr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/p1zzm1ssile/Setuparr/pkgs/container/setuparr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9893]/",
  "icon": "https://raw.githubusercontent.com/p1zzm1ssile/Setuparr/main/src/web/icon.png",
  "project": "https://github.com/p1zzm1ssile/Setuparr",
  "description": "Checks your Unraid media setup against the TRaSH guides, then fixes what doesn't match with one button, or shows you how to fix it yourself. Starts in report-only mode and is set up in its web UI. Free forever: no paid tiers, no Pro account, no subscriptions.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/setuparr",
      "container": "/config",
      "mode": "rw",
      "description": "Settings, login and logs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "9893",
      "container": "9893",
      "protocol": "tcp",
      "description": "Port for the Setuparr web UI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
