{
  "name": "jackettvpn",
  "repo": "dyonr/jackettvpn",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/dyonr/jackettvpn",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9117]/",
  "icon": "https://raw.githubusercontent.com/DyonR/docker-templates/master/Icons/jackettvpn/jackettvpn-icon.png",
  "project": "https://github.com/Jackett/Jackett",
  "description": "Docker container which runs the latest headless Jackett Server while connecting to WireGuard or OpenVPN with iptables killswitch to prevent IP leakage when the tunnel goes down.",
  "paths": [
    {
      "name": "Blackhole Path",
      "host": "",
      "container": "/blackhole",
      "mode": "rw",
      "description": "Path for /blackhole",
      "required": false
    },
    {
      "name": "config",
      "host": "/mnt/cache/appdata/jackettvpn/",
      "container": "/config",
      "mode": "rw",
      "description": "config path of jackettvpn",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEBUI_PORT",
      "host": "9117",
      "container": "9117",
      "protocol": "tcp",
      "description": "Port used to access Jackett remotely",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VPN_ENABLED",
      "key": "VPN_ENABLED",
      "value": "yes",
      "description": "Enable VPN? yes/no",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_TYPE",
      "key": "VPN_TYPE",
      "value": "openvpn",
      "description": "openvpn / wireguard?",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_USERNAME",
      "key": "VPN_USERNAME",
      "value": "",
      "description": "Username used to authenticate to the VPN",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_PASSWORD",
      "key": "VPN_PASSWORD",
      "value": "",
      "description": "Password used to authenticate to the VPN",
      "required": false,
      "mask": true
    },
    {
      "name": "WEBUI_PASSWORD",
      "key": "WEBUI_PASSWORD",
      "value": "",
      "description": "Password for Jackett's web interface",
      "required": false,
      "mask": true
    },
    {
      "name": "LAN_NETWORK",
      "key": "LAN_NETWORK",
      "value": "192.168.0.0/24",
      "description": "Your local network address in CIDR notation",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "The UID applied to the /config and /blackhole",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "The GID applied to the /config and /blackhole",
      "required": false,
      "mask": false
    },
    {
      "name": "NAME_SERVERS",
      "key": "NAME_SERVERS",
      "value": "1.1.1.1,1.0.0.1",
      "description": "DNS used by the container",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "umask used by the container",
      "required": false,
      "mask": false
    },
    {
      "name": "HEALTH_CHECK_HOST",
      "key": "HEALTH_CHECK_HOST",
      "value": "one.one.one.one",
      "description": "Host used to check if connection is up",
      "required": false,
      "mask": false
    },
    {
      "name": "HEALTH_CHECK_INTERVAL",
      "key": "HEALTH_CHECK_INTERVAL",
      "value": "300",
      "description": "Interval in seconds between connection check",
      "required": false,
      "mask": false
    },
    {
      "name": "HEALTH_CHECK_SILENT",
      "key": "HEALTH_CHECK_SILENT",
      "value": "1",
      "description": "1 supresses the 'Network is up' message",
      "required": false,
      "mask": false
    },
    {
      "name": "ADDITIONAL_PORTS",
      "key": "ADDITIONAL_PORTS",
      "value": "",
      "description": "Additional ports for routing other containers through this one",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
