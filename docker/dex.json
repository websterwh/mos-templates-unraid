{
  "name": "dex",
  "repo": "ghcr.io/dexidp/dex:latest",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/dexidp/dex",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "dex serve /var/dex/config.yaml",
  "web_ui_url": "http://[IP]:[PORT:4190]/",
  "icon": "https://raw.githubusercontent.com/alex3305/unraid-docker-templates/master/images/dex.png",
  "project": "https://dexidp.io/",
  "description": "Integrate any identity provider into your application using OpenID Connect.",
  "paths": [
    {
      "name": "App data",
      "host": "/mnt/cache/appdata/dex",
      "container": "/var/dex",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "4190",
      "container": "4190",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
