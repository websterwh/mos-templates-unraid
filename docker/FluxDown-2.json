{
  "name": "FluxDown",
  "repo": "ghcr.io/zerx-lab/fluxdown-server:0.1.54",
  "category": [
    "Downloader"
  ],
  "registry": "https://ghcr.io/zerx-lab/fluxdown-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:17800]/",
  "icon": "https://cdn.jsdelivr.net/gh/zerx-lab/FluxDown@main/assets/logo/fluxdown_logo.svg",
  "project": "https://github.com/zerx-lab/FluxDown",
  "description": "A blazing fast, multi-protocol download manager powered by a Rust engine. Supports HTTP/HTTPS/FTP/BitTorrent/HLS with intelligent segmentation, resume, speed control, a browser extension, aria2-compatible JSON-RPC and an MCP endpoint. A free alternative to Internet Download Manager and aria2. NOTE: first launch prints a one-time admin token in the container log (grep -i token). The management API and MCP endpoint require this token.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/fluxdown/data",
      "container": "/data",
      "mode": "rw",
      "description": "Database, logs and admin token",
      "required": true
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/downloads",
      "container": "/root/Downloads",
      "mode": "rw",
      "description": "Default download directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "17800",
      "container": "17800",
      "protocol": "tcp",
      "description": "FluxDown Web UI / REST API / WebSocket",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": "Timezone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
