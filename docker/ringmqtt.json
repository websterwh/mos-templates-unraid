{
  "name": "ring-mqtt",
  "repo": "tsightler/ring-mqtt",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/tsightler/ring-mqtt/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/tsightler/ring-mqtt/main/images/ring-mqtt-icon.png",
  "project": "https://github.com/tsightler/ring-mqtt",
  "description": "Interact with Ring Inc products (cameras/alarms/smart lighting) via MQTT - See the project page for token auth procedure - https://github.com/tsightler/ring-mqtt#authentication",
  "paths": [
    {
      "name": "DataPath",
      "host": "/mnt/cache/appdata/ring-mqtt",
      "container": "/data",
      "mode": "rw",
      "description": "Data Path",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "RINGTOKEN",
      "key": "RINGTOKEN",
      "value": "",
      "description": "Container Variable: RINGTOKEN",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTTHOST",
      "key": "MQTTHOST",
      "value": "",
      "description": "Container Variable: MQTTHOST",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTTPORT",
      "key": "MQTTPORT",
      "value": "1883",
      "description": "Container Variable: MQTTPORT",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTTUSER",
      "key": "MQTTUSER",
      "value": "",
      "description": "Container Variable: MQTTUSER",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTTPASSWORD",
      "key": "MQTTPASSWORD",
      "value": "",
      "description": "Container Variable: MQTTPASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "ENABLECAMERAS",
      "key": "ENABLECAMERAS",
      "value": "false",
      "description": "Container Variable: ENABLECAMERAS",
      "required": false,
      "mask": false
    },
    {
      "name": "SNAPSHOTMODE",
      "key": "SNAPSHOTMODE",
      "value": "disabled",
      "description": "Container Variable: SNAPSHOTMODE",
      "required": false,
      "mask": false
    },
    {
      "name": "ENABLEMODES",
      "key": "ENABLEMODES",
      "value": "false",
      "description": "Container Variable: ENABLEMODES",
      "required": false,
      "mask": false
    },
    {
      "name": "ENABLEPANIC",
      "key": "ENABLEPANIC",
      "value": "false",
      "description": "Container Variable: ENABLEPANIC",
      "required": false,
      "mask": false
    },
    {
      "name": "BEAMDURATION",
      "key": "BEAMDURATION",
      "value": "0",
      "description": "Container Variable: BEAMDURATION",
      "required": false,
      "mask": false
    },
    {
      "name": "DISARMCODE",
      "key": "DISARMCODE",
      "value": "",
      "description": "Container Variable: DISARMCODE",
      "required": false,
      "mask": false
    },
    {
      "name": "RINGLOCATIONIDS",
      "key": "RINGLOCATIONIDS",
      "value": "",
      "description": "Container Variable: RINGLOCATIONIDS",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
