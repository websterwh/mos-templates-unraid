{
  "name": "tidbyt-unraid",
  "repo": "ghcr.io/cmalec/tidbyt-unraid:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/cmalec/tidbyt-unraid/main/assets/tidbyt-unraid.png",
  "project": "https://github.com/cmalec/tidbyt-unraid",
  "description": "Display live Unraid server metrics on your Tidbyt device. Uses the official Unraid GraphQL API (Unraid 7.2+) and pushes directly to your Tidbyt over WiFi.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Unraid URL",
      "key": "UNRAID_URL",
      "value": "",
      "description": "Your Unraid server URL (e.g. https://tower.local or http://192.168.1.100)",
      "required": true,
      "mask": false
    },
    {
      "name": "Unraid API Key",
      "key": "UNRAID_API_KEY",
      "value": "",
      "description": "API key from Unraid (Settings \u2192 Management Access \u2192 API Keys)",
      "required": true,
      "mask": true
    },
    {
      "name": "Tidbyt Device ID",
      "key": "TIDBYT_DEVICE_ID",
      "value": "",
      "description": "Your Tidbyt device ID (from Tidbyt app)",
      "required": true,
      "mask": false
    },
    {
      "name": "Tidbyt API Key",
      "key": "TIDBYT_API_KEY",
      "value": "",
      "description": "Your Tidbyt API key (from Tidbyt app settings)",
      "required": true,
      "mask": true
    },
    {
      "name": "Update Interval",
      "key": "UPDATE_INTERVAL",
      "value": "3600",
      "description": "Seconds between updates (default 1hr)",
      "required": false,
      "mask": false
    },
    {
      "name": "Metrics",
      "key": "METRICS",
      "value": "cpu,ram,array,uptime",
      "description": "Comma-separated, max 4: cpu,ram,array,temps,docker,vms,uptime,network",
      "required": false,
      "mask": false
    },
    {
      "name": "Temperature Unit",
      "key": "TEMP_UNIT",
      "value": "F",
      "description": "C or F",
      "required": false,
      "mask": false
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Los_Angeles",
      "description": "Timezone for logs",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
