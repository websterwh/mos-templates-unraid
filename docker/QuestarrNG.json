{
  "name": "QuestarrNG",
  "repo": "ghcr.io/snapetech/questarrng:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/snapetech/questarrng",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/snapetech/QuestarrNG/main/images/Questarr_icon.png",
  "project": "https://github.com/snapetech/QuestarrNG",
  "description": "Standalone NG fork of Questarr for PC game discovery and acquisition, with optional SeerrNG integration.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/questarrng",
      "container": "/app/data",
      "mode": "rw",
      "description": "Persistent QuestarrNG database and settings.",
      "required": false
    },
    {
      "name": "Game Library",
      "host": "/mnt/cache/media/games",
      "container": "/data",
      "mode": "rw",
      "description": "Game library root.",
      "required": false
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "Downloads shared with the configured download client.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Web UI Port for the standalone web interface.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for files created by this service.",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for files created by this service.",
      "required": false,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": "Time zone used by this service.",
      "required": false,
      "mask": false
    },
    {
      "name": "PORT",
      "key": "PORT",
      "value": "5000",
      "description": "Internal QuestarrNG web port.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
