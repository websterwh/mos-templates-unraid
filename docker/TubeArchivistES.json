{
  "name": "TubeArchivist-ES",
  "repo": "bbilly1/tubearchivist-es:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/_/elasticsearch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9200]",
  "icon": "https://i.imgur.com/ftggG6O.jpg",
  "project": "https://github.com/elastic/elasticsearch",
  "description": "This is a dependancy container for the application \"TubeArchivist\"",
  "paths": [
    {
      "name": "ElasticSearch Data",
      "host": "/mnt/cache/appdata/TubeArchivist/es",
      "container": "/usr/share/elasticsearch/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "9200",
      "host": "9200",
      "container": "9200",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ElasticSearch Password",
      "key": "ELASTIC_PASSWORD",
      "value": "verysecret",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Java Options",
      "key": "ES_JAVA_OPTS",
      "value": "-Xms512m -Xmx512m",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Discovery Type",
      "key": "discovery.type",
      "value": "single-node",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Xpack Security",
      "key": "xpack.security.enabled",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Snapshot Path",
      "key": "path.repo",
      "value": "/usr/share/elasticsearch/data/snapshot",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
