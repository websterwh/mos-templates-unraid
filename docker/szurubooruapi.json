{
  "name": "szurubooru-api",
  "repo": "szurubooru/server:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/szurubooru/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6666]",
  "icon": "https://github.com/FoxxMD/unraid-docker-templates/raw/master/szurubooru.png",
  "project": "https://github.com/rr-/szurubooru",
  "description": "Backend API container for Szurubooru, an image board engine for small and medium communities",
  "paths": [
    {
      "name": "Image Data",
      "host": "/mnt/cache/appdata/szurubooru/data",
      "container": "/data",
      "mode": "rw",
      "description": "Directory on host to store image data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Api Port",
      "host": "6666",
      "container": "6666",
      "protocol": "tcp",
      "description": "Port to expose API interface on. This is accessed by the frontend.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Postgres Host",
      "key": "POSTGRES_HOST",
      "value": "",
      "description": "IP address of Postgres instance",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres DB",
      "key": "POSTGRES_DB",
      "value": "",
      "description": "Name of the database on Postgres instance to use",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres User",
      "key": "POSTGRES_USER",
      "value": "",
      "description": "Username of Postgres user",
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres Password",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "Password of Postgres user",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
