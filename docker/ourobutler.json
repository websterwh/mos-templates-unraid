{
  "name": "ouro-butler",
  "repo": "ghcr.io/ourostack/ouroboros-butler:0.1.0-alpha.815",
  "category": [
    "System"
  ],
  "registry": "https://github.com/ourostack/ouroboros/pkgs/container/ouroboros-butler",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --user=10001:10001",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/ourostack/ouroboros/main/assets/ouroboros.png",
  "project": "https://ouroboros.bot",
  "description": "Mendelow Cloud Butler is a friendly Telegram steward for an Unraid household. It turns system evidence into useful agent-owned help, keeps each family member private, and asks before consequential actions.",
  "paths": [
    {
      "name": "Runtime state",
      "host": "/mnt/cache/appdata/ouro-butler/runtime/.ouro-cli",
      "container": "/home/ouro/.ouro-cli",
      "mode": "rw",
      "description": "Machine-scoped runtime",
      "required": true
    },
    {
      "name": "Agent bundle",
      "host": "/mnt/cache/appdata/ouro-butler/agent/sanctuary.ouro",
      "container": "/home/ouro/AgentBundles/sanctuary.ouro",
      "mode": "rw",
      "description": "Sanctuary bundle",
      "required": true
    },
    {
      "name": "Privileged event spool",
      "host": "/boot/config/custom/ouro-events/spool",
      "container": "/run/ouro-events",
      "mode": "ro",
      "description": "Root-owned detector envelopes, read-only inside the Butler",
      "required": true
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": []
}
