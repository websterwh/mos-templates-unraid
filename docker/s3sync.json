{
  "name": "s3sync",
  "repo": "whatname/docker-s3sync",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/repository/docker/whatname/docker-s3sync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/what-name/unraid-templates/main/static/s3-icon.png",
  "project": "https://github.com/what-name/docker-s3sync",
  "description": "This application backs up every folder mounted at `/data/` to a given AWS S3 path using the `aws s3 sync` command. It requires a pair of (IAM) Access and Secret Keys. You can supply the usual s3 sync parameters such as `--delete` and everything else. The cron schedule defines how often the sync command is executed, and it uses a lockfile to avoid parallel executions.",
  "paths": [
    {
      "name": "Backup Source Example",
      "host": "/mnt/cache/example",
      "container": "/data/example",
      "mode": "ro",
      "description": "This folder will be backed up.",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "ACCESS_KEY",
      "key": "ACCESS_KEY",
      "value": "your_access_key_here",
      "description": "Your AWS Access Key.",
      "required": true,
      "mask": false
    },
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "your_secret_key_here",
      "description": "Your AWS Secret Key.",
      "required": true,
      "mask": false
    },
    {
      "name": "Region",
      "key": "REGION",
      "value": "bucket_region_here",
      "description": "The region of your bucket.",
      "required": true,
      "mask": false
    },
    {
      "name": "S3 Sync Parameters",
      "key": "S3SYNCPARAMS",
      "value": "",
      "description": "(Optional) Extra parameters for the s3 sync command.",
      "required": false,
      "mask": false
    },
    {
      "name": "S3 Path",
      "key": "S3PATH",
      "value": "s3://your_bucket_name",
      "description": "The target bucket path with optional prefix.",
      "required": true,
      "mask": false
    },
    {
      "name": "Cron Schedule",
      "key": "CRON_SCHEDULE",
      "value": "0 * * * *",
      "description": "Cron schedule of backup.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
