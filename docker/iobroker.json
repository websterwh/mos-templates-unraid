{
  "name": "iobroker",
  "repo": "buanet/iobroker",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/buanet/iobroker/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--no-healthcheck",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://raw.githubusercontent.com/mgutt/unraid-docker-templates/main/mgutt/images/iobroker.png",
  "project": "https://www.iobroker.net/",
  "description": "ioBroker is an Open Source IoT platform (Fog computing) which has the ability to manage your IoT system through an graphical interface.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/iobroker/data",
      "container": "/opt/iobroker",
      "mode": "rw",
      "description": "Container Path: /opt/iobroker",
      "required": false
    },
    {
      "name": "Scripts",
      "host": "/mnt/cache/appdata/iobroker/scripts",
      "container": "/opt/userscripts",
      "mode": "rw",
      "description": "Container Path: /opt/userscripts",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "CoAP Port (Shelly)",
      "host": "5683",
      "container": "5683",
      "protocol": "udp",
      "description": "Container Port: 5683",
      "required": false,
      "mask": false
    },
    {
      "name": "flot Port",
      "host": "8282",
      "container": "8282",
      "protocol": "tcp",
      "description": "flot adapter",
      "required": false,
      "mask": false
    },
    {
      "name": "HomeMatic Port",
      "host": "2001",
      "container": "2001",
      "protocol": "tcp",
      "description": "Container Port: 2001",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT Port",
      "host": "1883",
      "container": "1883",
      "protocol": "tcp",
      "description": "Container Port: 1883",
      "required": false,
      "mask": false
    },
    {
      "name": "MQTT SSL Port",
      "host": "8883",
      "container": "8883",
      "protocol": "tcp",
      "description": "Container Port: 8883",
      "required": false,
      "mask": false
    },
    {
      "name": "Node-RED Port",
      "host": "1880",
      "container": "1880",
      "protocol": "tcp",
      "description": "Container Port: 1880",
      "required": false,
      "mask": false
    },
    {
      "name": "Socket.IO Port",
      "host": "8284",
      "container": "8284",
      "protocol": "tcp",
      "description": "Container Port: 8284",
      "required": false,
      "mask": false
    },
    {
      "name": "WebUI Port",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "USB Devices",
      "key": "USBDEVICES",
      "value": "",
      "description": "Sets relevant permissions on mounted devices like",
      "required": false,
      "mask": false
    },
    {
      "name": "UID",
      "key": "SETUID",
      "value": "99",
      "description": "Container Variable: SETUID",
      "required": true,
      "mask": false
    },
    {
      "name": "GID",
      "key": "SETGID",
      "value": "100",
      "description": "Container Variable: SETGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
