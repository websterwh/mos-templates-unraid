{
  "name": "opencloud",
  "repo": "opencloudeu/opencloud-rolling",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/opencloudeu/opencloud-rolling",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--entrypoint /bin/sh",
  "post_parameters": "-c opencloud init || true; opencloud server",
  "web_ui_url": "https://[IP]:[PORT:9200]",
  "icon": "https://avatars.githubusercontent.com/u/188916550?s=200&v=4",
  "project": "https://opencloud.eu/",
  "description": "Welcome to OpenCloud, your self-hosted file sharing platform: Secure, simple and reliable. Documentation: https://docs.opencloud.eu/docs/admin/intro Before first run: 1. Create the directories with chmod 751 2. Set the owner to the user with UID 1000",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/opencloud/config",
      "container": "/etc/opencloud",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Data",
      "host": "/mnt/cache/opencloud/data",
      "container": "/var/lib/opencloud",
      "mode": "rw",
      "description": "Where OpenCloud stores files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "9200",
      "container": "9200",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OpenCloud URL",
      "key": "OC_URL",
      "value": "https://opencloud.mydomain.tld",
      "description": "Address where you access OpenCloud",
      "required": true,
      "mask": false
    },
    {
      "name": "Admin Password",
      "key": "IDM_ADMIN_PASSWORD",
      "value": "",
      "description": "Overrides generated administrator password in config.",
      "required": false,
      "mask": true
    },
    {
      "name": "INSECURE",
      "key": "OC_INSECURE",
      "value": "false",
      "description": "INSECURE: Needed if OpenCloud / Traefik is using self generated certificates",
      "required": false,
      "mask": false
    },
    {
      "name": "Allow Basic Auth",
      "key": "PROXY_ENABLE_BASIC_AUTH",
      "value": "false",
      "description": "Not recommended, but needed for eg. WebDav clients that do not support OpenID Connect",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Sender",
      "key": "NOTIFICATIONS_SMTP_SENDER",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Username",
      "key": "NOTIFICATIONS_SMTP_USERNAME",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Host",
      "key": "NOTIFICATIONS_SMTP_HOST",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Port",
      "key": "NOTIFICATIONS_SMTP_PORT",
      "value": "587",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP Password",
      "key": "NOTIFICATIONS_SMTP_PASSWORD",
      "value": "",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "SMTP Encryption Type",
      "key": "NOTIFICATIONS_SMTP_ENCRYPTION",
      "value": "starttls",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Collabora Domain",
      "key": "COLLABORA_DOMAIN",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OnlyOffice Domain",
      "key": "ONLYOFFICE_DOMAIN",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Additional Services",
      "key": "START_ADDITIONAL_SERVICES",
      "value": "\"notifications\"",
      "description": "Add any services to the startup list comma separated",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
