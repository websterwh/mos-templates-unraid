{
  "name": "opencloud",
  "repo": "opencloudeu/opencloud-rolling",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/opencloudeu/opencloud-rolling/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "init",
  "web_ui_url": "https://[IP]:[PORT:9200]",
  "icon": "https://raw.githubusercontent.com/mcreekmore/unraid-templates/refs/heads/main/opencloud/opencloud.png",
  "project": "https://docs.opencloud.eu/",
  "description": "https://hub.docker.com/r/opencloudeu/opencloud-rolling/ Ensure that the OpenCloud config and OpenCloud data directories are created before running and that the Unraid user 'nobody' has read/write access. This container requires a first time boot to initialize, so it will stop on first boot to establish the IDM_ADMIN_PASSWORD. Once it has stopped, remove \"init\" from the \"Post Arguments\" under the advanced view and restart the container.",
  "paths": [
    {
      "name": "OpenCloud config",
      "host": "/mnt/cache/appdata/opencloud",
      "container": "/etc/opencloud",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "OpenCloud data",
      "host": "",
      "container": "/var/lib/opencloud",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Container Port 1",
      "host": "9200",
      "container": "9200",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "IDM_ADMIN_PASSWORD",
      "key": "IDM_ADMIN_PASSWORD",
      "value": "admin",
      "description": "If not set, a password will be auto-generated",
      "required": false,
      "mask": true
    },
    {
      "name": "OC_INSECURE",
      "key": "OC_INSECURE",
      "value": "true",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PROXY_HTTP_ADDR",
      "key": "PROXY_HTTP_ADDR",
      "value": "0.0.0.0:9200",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "OC_URL",
      "key": "OC_URL",
      "value": "https://cloud.example.com",
      "description": "If you're using a reverse proxy, put your URL. (ex. https://cloud.example.com)",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
