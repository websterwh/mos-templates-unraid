{
  "name": "hyperion.ng",
  "repo": "nq00/hyperion-ng",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/nq00/hyperion-ng",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8090]/",
  "icon": "https://dashboard.snapcraft.io/site_media/appmedia/2021/05/hyperIconSmall-1024.png",
  "project": "https://github.com/hyperion-project/hyperion.ng",
  "description": "Hyperion is an opensource Bias or Ambient Lighting implementation which you might know from TV manufacturers. It supports many LED devices and video grabbers.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/hyperion.ng",
      "container": "/etc/hyperion",
      "mode": "rw",
      "description": "Container Path: /etc/hyperion",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Protobuffer",
      "host": "19445",
      "container": "19445",
      "protocol": "tcp",
      "description": "Container Port: 19445",
      "required": true,
      "mask": false
    },
    {
      "name": "Flatbuffer",
      "host": "19400",
      "container": "19400",
      "protocol": "tcp",
      "description": "Container Port: 19400",
      "required": true,
      "mask": false
    },
    {
      "name": "JSON-Server",
      "host": "19444",
      "container": "19444",
      "protocol": "tcp",
      "description": "Container Port: 19444",
      "required": true,
      "mask": false
    },
    {
      "name": "http / ws",
      "host": "8090",
      "container": "8090",
      "protocol": "tcp",
      "description": "Container Port: 8090",
      "required": true,
      "mask": false
    },
    {
      "name": "https / wss",
      "host": "8092",
      "container": "8092",
      "protocol": "tcp",
      "description": "Container Port: 8092",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
