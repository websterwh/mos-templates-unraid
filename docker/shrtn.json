{
  "name": "shrtn",
  "repo": "cordlesswool/shrtn",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/cordlesswool/shrtn/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3001]",
  "icon": "https://raw.githubusercontent.com/cordlessWool/shrtn/main/static/android-chrome-192x192.png",
  "project": "https://shrtn.io/",
  "description": "Your own private URL-Shortener. Simple setup, no extra containers.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/shrtn",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ORIGIN",
      "key": "ORIGIN",
      "value": "https://localhost:3001",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
