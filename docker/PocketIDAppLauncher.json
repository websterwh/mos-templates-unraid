{
  "name": "PocketID-App-Launcher",
  "repo": "ghcr.io/kc9wwh/app-launcher:latest",
  "category": [
    "Security"
  ],
  "registry": "https://github.com/kc9wwh/app-launcher",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
