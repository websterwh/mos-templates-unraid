{
  "name": "Dim",
  "repo": "ghcr.io/dusk-labs/dim:dev",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/Dusk-Labs/dim/pkgs/container/dim",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/Dusk-Labs/dim/master/ui/public/static/textLogoBlack512.png",
  "project": "https://github.com/Dusk-Labs/dim",
  "description": "Dim is a self-hosted media manager. With minimal setup, Dim will organize and beautify your media collections, letting you access and play them anytime from anywhere",
  "paths": [
    {
      "name": "Media Path",
      "host": "/mnt/cache/media/",
      "container": "/media",
      "mode": "rw",
      "description": "Media Path",
      "required": false
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/dim",
      "container": "/opt/dim/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Web UI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [
    {
      "name": "Graphics Card Path",
      "host": "/dev/dri",
      "container": "",
      "description": "Graphics Card Path",
      "required": false
    }
  ],
  "labels": []
}
