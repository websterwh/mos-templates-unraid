{
  "name": "unmonitarr",
  "repo": "ghcr.io/unmonitarr/unmonitarr:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/unmonitarr/unmonitarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5099]",
  "icon": "https://raw.githubusercontent.com/unmonitarr/unmonitarr/main/assets/unmonitarr-logo.png",
  "project": "https://github.com/unmonitarr/unmonitarr",
  "description": "When monitoring upcoming content, Sonarr can search for and download releases before they're actually available, leading to fake/wrong files. Unmonitarr only enables monitoring for an episode once it has aired. (This tool is not required for radarr)",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "5099",
      "container": "5099",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ENABLE_RADARR",
      "key": "ENABLE_RADARR",
      "value": "1",
      "description": "Enable Radarr",
      "required": false,
      "mask": false
    },
    {
      "name": "RADARR_URL",
      "key": "RADARR_URL",
      "value": "http://127.0.0.1:7878/",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "RADARR_API_KEY",
      "key": "RADARR_API_KEY",
      "value": "apikey",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "Radarr Preferred Release Type",
      "key": "PREFERRED_RELEASE",
      "value": "either",
      "description": "either, digital, or physical",
      "required": false,
      "mask": false
    },
    {
      "name": "Ignore in Cinema",
      "key": "IGNORE_INCINEMAS",
      "value": "1",
      "description": "Ignore cinema release dates (1=yes, 0=no)",
      "required": false,
      "mask": false
    },
    {
      "name": "Enable Sonarr",
      "key": "ENABLE_SONARR",
      "value": "1",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Sonarr URL",
      "key": "SONARR_URL",
      "value": "http://127.0.0.1:6782/",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "SONARR_API_KEY",
      "key": "SONARR_API_KEY",
      "value": "apikey",
      "description": null,
      "required": false,
      "mask": true
    },
    {
      "name": "Auto Tag Name",
      "key": "AUTO_TAG_NAME",
      "value": "auto-unmonitored",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "IGNORE_TAG_NAME",
      "key": "IGNORE_TAG_NAME",
      "value": "ignoreairdate",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Skip if already added",
      "key": "SKIP_IF_FILE",
      "value": "1",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/London",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DRY_RUN",
      "key": "DRY_RUN",
      "value": "1",
      "description": "Preview mode: 1 = log only, 0 = apply changes",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
