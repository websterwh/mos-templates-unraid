{
  "name": "vaultwarden",
  "repo": "vaultwarden/server",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/vaultwarden/server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/admin",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/vaultwarden.png",
  "project": "https://github.com/dani-garcia/vaultwarden/",
  "description": "Vaultwarden (formerly bitwarden_rs) is a Bitwarden server API implementation written in Rust compatible with upstream Bitwarden clients, perfect for self-hosted deployment where running the official resource-heavy service might not be ideal. Basically full implementation of Bitwarden API is provided including: -Basic single user functionality -Organizations support -Attachments -Vault API support -Serving the static files for Vault interface #xD; -Website icons API -Authenticator and U2F support -YubiKey OTP For more configuration see the wiki https://github.com/dani-garcia/vaultwarden/wiki",
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/vaultwarden",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI HTTP Port",
      "host": "4743",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SIGNUPS_ALLOWED",
      "key": "SIGNUPS_ALLOWED",
      "value": "true|false",
      "description": "Container Variable: Signups",
      "required": false,
      "mask": false
    },
    {
      "name": "INVITATIONS_ALLOWED",
      "key": "INVITATIONS_ALLOWED",
      "value": "true|false",
      "description": "Container Variable: Invitations",
      "required": false,
      "mask": false
    },
    {
      "name": "WEBSOCKET_ENABLED",
      "key": "WEBSOCKET_ENABLED",
      "value": "false",
      "description": "Container Variable: Websockets Enabled",
      "required": false,
      "mask": false
    },
    {
      "name": "ADMIN_TOKEN",
      "key": "ADMIN_TOKEN",
      "value": "",
      "description": "Container Variable: ADMIN_TOKEN",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
