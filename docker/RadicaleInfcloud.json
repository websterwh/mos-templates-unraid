{
  "name": "Radicale---Infcloud",
  "repo": "parrazam/radicale-with-infcloud",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/parrazam/radicale-with-infcloud",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5232]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/radicale-icon.png",
  "project": "https://github.com/parrazam/radicale-docker",
  "description": "Docker container for Radicale calendar, to-do list and contact (CalDAV/CardDAV) server + Infcloud web UI pre-installed. Add the following to the \"web\" section in the config file to enable Infcloud: [code] type = radicale_infcloud [/code]",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/radicale/config",
      "container": "/config",
      "mode": "ro",
      "description": "Parent folder storing config file",
      "required": true
    },
    {
      "name": "Data path",
      "host": "/mnt/cache/appdata/radicale/data",
      "container": "/data",
      "mode": "rw",
      "description": "Data path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5232",
      "container": "5232",
      "protocol": "tcp",
      "description": "Container Port: 5232",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
