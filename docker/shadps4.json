{
  "name": "shadps4",
  "repo": "lscr.io/linuxserver/shadps4",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/shadps4",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:3001]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/shadps4-logo.png",
  "project": "https://shadps4.net/",
  "description": "shadPS4(https://shadps4.net/) is an early PlayStation 4 emulator for Windows, Linux and macOS written in C++.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Users home directory in the container, stores all files and games.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "shadPS4 desktop gui HTTP must be proxied.",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 3001",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "shadPS4 desktop gui HTTPS.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
