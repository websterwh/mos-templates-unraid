{
  "name": "PinePods",
  "repo": "madeofpendletonwool/pinepods:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/madeofpendletonwool/pinepods",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8040]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/pinepods-icon.jpeg",
  "project": "https://www.pinepods.online",
  "description": "A Rust based podcast management system that manages podcasts with multi-user support and relies on a central database with clients to connect to it.",
  "paths": [
    {
      "name": "Downloads Path",
      "host": "/mnt/cache/appdata/pinepods/downloads",
      "container": "/opt/pinepods/downloads",
      "mode": "rw",
      "description": "Path to downloads folder",
      "required": true
    },
    {
      "name": "Backups Path",
      "host": "/mnt/cache/appdata/pinepods/backups",
      "container": "/opt/pinepods/backups",
      "mode": "rw",
      "description": "Path to backups folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8040",
      "container": "8040",
      "protocol": "tcp",
      "description": "Container Port: 8040",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Username",
      "key": "USERNAME",
      "value": "",
      "description": "Username for login",
      "required": false,
      "mask": false
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": "",
      "description": "Password for login",
      "required": false,
      "mask": true
    },
    {
      "name": "User Full Name",
      "key": "FULLNAME",
      "value": "",
      "description": "Full name of user",
      "required": false,
      "mask": false
    },
    {
      "name": "User Email",
      "key": "EMAIL",
      "value": "",
      "description": "Email of user",
      "required": false,
      "mask": false
    },
    {
      "name": "Database - Type",
      "key": "DB_TYPE",
      "value": "mariadb|postgresql",
      "description": "Type of database to use",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Host",
      "key": "DB_HOST",
      "value": "",
      "description": "Hostname of database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Port",
      "key": "DB_PORT",
      "value": "",
      "description": "Port of database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Name",
      "key": "DB_NAME",
      "value": "",
      "description": "Name of database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Username",
      "key": "DB_USER",
      "value": "",
      "description": "Username for database",
      "required": true,
      "mask": false
    },
    {
      "name": "Database - Password",
      "key": "DB_PASSWORD",
      "value": "",
      "description": "Password for database",
      "required": true,
      "mask": true
    },
    {
      "name": "Valkey - Host",
      "key": "VALKEY_HOST",
      "value": "",
      "description": "Hostname of Valkey instance",
      "required": true,
      "mask": true
    },
    {
      "name": "Valkey - Port",
      "key": "VALKEY_PORT",
      "value": "6379",
      "description": "Port of Valkey instance",
      "required": true,
      "mask": true
    },
    {
      "name": "Search API URL",
      "key": "SEARCH_API_URL",
      "value": "https://search.pinepods.online/api/search",
      "description": "URL of podcast search API",
      "required": true,
      "mask": false
    },
    {
      "name": "People API URL",
      "key": "PEOPLE_API_URL",
      "value": "https://people.pinepods.online",
      "description": "URL of people API",
      "required": true,
      "mask": false
    },
    {
      "name": "Debug Mode",
      "key": "DEBUG",
      "value": "False|True",
      "description": "Enable debug mode",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
