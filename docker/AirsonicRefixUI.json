{
  "name": "Airsonic-Refix-UI",
  "repo": "tamland/airsonic-refix:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/tamland/airsonic-refix",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/airsonic-refix-icon.png",
  "project": "https://github.com/tamland/airsonic-refix",
  "description": "Modern responsive web frontend for airsonic-advanced, navidrome, gonic and other subsonic compatible music servers.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server URL",
      "key": "SERVER_URL",
      "value": "",
      "description": "Optional, define Subsonic server URL to bypass input option on login screen.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
