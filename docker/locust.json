{
  "name": "locust",
  "repo": "locustio/locust",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/locustio/locust",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "-f /mnt/locust/locustfile.py",
  "web_ui_url": "http://[IP]:[PORT:8089]",
  "icon": "https://raw.githubusercontent.com/SCUR0/Unraid_Docker_Locust/refs/heads/main/locust_400x400.jpg",
  "project": "https://docs.locust.io/en/stable/",
  "description": "Web server stress test locustfile.py is required in /mnt/locust/ See here for examples: https://docs.locust.io/en/stable/writing-a-locustfile.html",
  "paths": [
    {
      "name": "Locust directory",
      "host": "/mnt/cache/appdata/locust/",
      "container": "/mnt/locust",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "8089",
      "container": "8089",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
