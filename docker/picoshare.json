{
  "name": "picoshare",
  "repo": "mtlynch/picoshare",
  "category": [
    "System"
  ],
  "registry": "https://registry.hub.docker.com/r/mtlynch/picoshare",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3001]",
  "icon": "https://cdn0.iconfinder.com/data/icons/communication-2-5/98/59-512.png",
  "project": "https://pico.rocks/",
  "description": "PicoShare is a minimalist service that allows you to share files easily.",
  "paths": [
    {
      "name": "data",
      "host": "/mnt/cache/appdata/picoshare",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "PORT",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "Container Port: 3001",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PORT",
      "key": "PORT",
      "value": "3001",
      "description": "Container Variable: PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "PS_SHARED_SECRET",
      "key": "PS_SHARED_SECRET",
      "value": "somesecretpass",
      "description": "Container Variable: PS_SHARED_SECRET",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
