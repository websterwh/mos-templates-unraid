{
  "name": "aMuTorrent",
  "repo": "g0t3nks/amutorrent:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/g0t3nks/amutorrent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4000]",
  "icon": "https://raw.githubusercontent.com/got3nks/amutorrent/main/static/favicon-96x96.png",
  "project": "https://github.com/got3nks/amutorrent",
  "description": "Web-based controller for aMule, rTorrent, qBittorrent, Deluge, and Transmission with real-time updates. Features a setup wizard, download history, search via Prowlarr, multi-instance support, user management, and event scripting.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/amutorrent/data",
      "container": "/usr/src/app/server/data",
      "mode": "rw",
      "description": "Application data (config, databases, GeoIP)",
      "required": true
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/amutorrent/logs",
      "container": "/usr/src/app/server/logs",
      "mode": "rw",
      "description": "Application logs",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "aMule Enabled",
      "key": "AMULE_ENABLED",
      "value": "false|true",
      "description": "Enable aMule client",
      "required": false,
      "mask": false
    },
    {
      "name": "aMule Host",
      "key": "AMULE_HOST",
      "value": "",
      "description": "aMule EC hostname or IP",
      "required": false,
      "mask": false
    },
    {
      "name": "aMule Port",
      "key": "AMULE_PORT",
      "value": "4712",
      "description": "aMule EC port",
      "required": false,
      "mask": false
    },
    {
      "name": "aMule Password",
      "key": "AMULE_PASSWORD",
      "value": "",
      "description": "aMule EC password",
      "required": false,
      "mask": true
    },
    {
      "name": "rTorrent Enabled",
      "key": "RTORRENT_ENABLED",
      "value": "false|true",
      "description": "Enable rTorrent client",
      "required": false,
      "mask": false
    },
    {
      "name": "rTorrent Host",
      "key": "RTORRENT_HOST",
      "value": "",
      "description": "rTorrent XML-RPC hostname or IP",
      "required": false,
      "mask": false
    },
    {
      "name": "rTorrent Port",
      "key": "RTORRENT_PORT",
      "value": "8000",
      "description": "rTorrent XML-RPC port",
      "required": false,
      "mask": false
    },
    {
      "name": "rTorrent SSL",
      "key": "RTORRENT_USE_SSL",
      "value": "false|true",
      "description": "Use HTTPS for rTorrent XML-RPC",
      "required": false,
      "mask": false
    },
    {
      "name": "qBittorrent Enabled",
      "key": "QBITTORRENT_ENABLED",
      "value": "false|true",
      "description": "Enable qBittorrent client",
      "required": false,
      "mask": false
    },
    {
      "name": "qBittorrent Host",
      "key": "QBITTORRENT_HOST",
      "value": "",
      "description": "qBittorrent WebUI hostname or IP",
      "required": false,
      "mask": false
    },
    {
      "name": "qBittorrent Port",
      "key": "QBITTORRENT_PORT",
      "value": "8080",
      "description": "qBittorrent WebUI port",
      "required": false,
      "mask": false
    },
    {
      "name": "qBittorrent Username",
      "key": "QBITTORRENT_USERNAME",
      "value": "admin",
      "description": "qBittorrent WebUI username",
      "required": false,
      "mask": false
    },
    {
      "name": "qBittorrent Password",
      "key": "QBITTORRENT_PASSWORD",
      "value": "",
      "description": "qBittorrent WebUI password",
      "required": false,
      "mask": true
    },
    {
      "name": "qBittorrent SSL",
      "key": "QBITTORRENT_USE_SSL",
      "value": "false|true",
      "description": "Use HTTPS for qBittorrent WebUI",
      "required": false,
      "mask": false
    },
    {
      "name": "Deluge Enabled",
      "key": "DELUGE_ENABLED",
      "value": "false|true",
      "description": "Enable Deluge client",
      "required": false,
      "mask": false
    },
    {
      "name": "Deluge Host",
      "key": "DELUGE_HOST",
      "value": "",
      "description": "Deluge WebUI hostname or IP",
      "required": false,
      "mask": false
    },
    {
      "name": "Deluge Port",
      "key": "DELUGE_PORT",
      "value": "8112",
      "description": "Deluge WebUI port",
      "required": false,
      "mask": false
    },
    {
      "name": "Deluge Password",
      "key": "DELUGE_PASSWORD",
      "value": "",
      "description": "Deluge WebUI password",
      "required": false,
      "mask": true
    },
    {
      "name": "Deluge SSL",
      "key": "DELUGE_USE_SSL",
      "value": "false|true",
      "description": "Use HTTPS for Deluge WebUI",
      "required": false,
      "mask": false
    },
    {
      "name": "Transmission Enabled",
      "key": "TRANSMISSION_ENABLED",
      "value": "false|true",
      "description": "Enable Transmission client",
      "required": false,
      "mask": false
    },
    {
      "name": "Transmission Host",
      "key": "TRANSMISSION_HOST",
      "value": "",
      "description": "Transmission RPC hostname or IP",
      "required": false,
      "mask": false
    },
    {
      "name": "Transmission Port",
      "key": "TRANSMISSION_PORT",
      "value": "9091",
      "description": "Transmission RPC port",
      "required": false,
      "mask": false
    },
    {
      "name": "Transmission Username",
      "key": "TRANSMISSION_USERNAME",
      "value": "",
      "description": "Transmission RPC username",
      "required": false,
      "mask": false
    },
    {
      "name": "Transmission Password",
      "key": "TRANSMISSION_PASSWORD",
      "value": "",
      "description": "Transmission RPC password",
      "required": false,
      "mask": true
    },
    {
      "name": "Transmission SSL",
      "key": "TRANSMISSION_USE_SSL",
      "value": "false|true",
      "description": "Use HTTPS for Transmission RPC",
      "required": false,
      "mask": false
    },
    {
      "name": "Prowlarr URL",
      "key": "PROWLARR_URL",
      "value": "",
      "description": "Prowlarr URL for torrent search (e.g. http://prowlarr:9696)",
      "required": false,
      "mask": false
    },
    {
      "name": "Prowlarr API Key",
      "key": "PROWLARR_API_KEY",
      "value": "",
      "description": "Prowlarr API key",
      "required": false,
      "mask": true
    },
    {
      "name": "Web Auth Enabled",
      "key": "WEB_AUTH_ENABLED",
      "value": "true|false",
      "description": "Enable password protection for the web interface",
      "required": false,
      "mask": false
    },
    {
      "name": "Web Auth Password",
      "key": "WEB_AUTH_PASSWORD",
      "value": "",
      "description": "Web interface password (only used on first run)",
      "required": false,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
