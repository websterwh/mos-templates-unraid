{
  "name": "limnoria",
  "repo": "lscr.io/linuxserver/limnoria",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/limnoria",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/limnoria-logo.png",
  "project": "https://github.com/ProgVal/limnoria",
  "description": "Limnoria(https://github.com/ProgVal/limnoria) A robust, full-featured, and user/programmer-friendly Python IRC bot, with many existing plugins. Successor of the well-known Supybot.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port for Limnoria's web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
