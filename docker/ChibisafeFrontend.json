{
  "name": "Chibisafe---Frontend",
  "repo": "chibisafe/chibisafe-server:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/chibisafe/chibisafe-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8001]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/chibisafe-icon.png",
  "project": "https://chibisafe.app/",
  "description": "A modern and self-hosted take on file uploading services that can handle anything you throw at it thanks to its robust and fast API, chunked uploads support and more. This is the backend server. You will need to install Chibisafe - Backend as well.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": "Container Port: 8001",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Backend URL",
      "key": "BASE_API_URL",
      "value": "http://chibisafe_server:8000",
      "description": "URL of the backend server",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
