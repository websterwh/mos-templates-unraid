{
  "name": "kapowarr",
  "repo": "mrcas/kapowarr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/mrcas/kapowarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5656]/",
  "icon": "https://raw.githubusercontent.com/JPDVM2014/icons/refs/heads/main/kapowarr.png",
  "project": "https://github.com/Casvt/Kapowarr",
  "description": "Kapowarr allows you to build a digital library of comics. You can add volumes, map them to a folder and start managing! Download issues of the volume (or TPB's), rename them and move them. The whole process is automised and is all customisable in the settings.",
  "paths": [
    {
      "name": "Downloads",
      "host": "/mnt/cache/kapowarr-downloads/",
      "container": "/app/temp_downloads",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Completed",
      "host": "/mnt/cache/data/media/comics/",
      "container": "/content",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Database",
      "host": "/mnt/cache/appdata/kapowarr-db",
      "container": "/app/db",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5656",
      "container": "5656",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
