{
  "name": "Unraid-API-RE",
  "repo": "bokker/unraidapi-re",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/repository/docker/bokker/unraidapi-re",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/BoKKeR/UnraidAPI-RE/master/static/icon.png",
  "project": null,
  "description": "Fork of the UnraidAPI, since the original project is abandoned. This is an MQTT Home Assistant Bridge with a rest endpoint as well that allows control of Unraid from this docker, homeassistant and MQTT/REST generally. Icon made by https://www.flaticon.com/authors/freepik Freepik",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/Unraid-API",
      "container": "/app/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3005",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MQTTBroker",
      "key": "MQTTBroker",
      "value": "hassio",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MQTTPort",
      "key": "MQTTPort",
      "value": "1883",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MQTTUser",
      "key": "MQTTUser",
      "value": "mqtt",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MQTTPass",
      "key": "MQTTPass",
      "value": "pass",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MQTTBaseTopic",
      "key": "MQTTBaseTopic",
      "value": "homeassistant",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "KeyStorage",
      "key": "KeyStorage",
      "value": "config",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "WRITE_HTML_OUTPUT",
      "key": "WRITE_HTML_OUTPUT",
      "value": "false",
      "description": "Forces the service to write the scraped html files to the config map for debugging",
      "required": false,
      "mask": false
    },
    {
      "name": "RetainMessages",
      "key": "RetainMessages",
      "value": "false",
      "description": "Sets all MQTT messages to retain, meaning the messages will never be removed",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
