{
  "name": "Velocity",
  "repo": "itzg/mc-proxy",
  "category": [
    "Game Server"
  ],
  "registry": "https://registry.hub.docker.com/r/itzg/mc-proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:25565]",
  "icon": "https://raw.githubusercontent.com/dkeners/unraid-templates/refs/heads/main/dkeners/images/velocity.png",
  "project": "https://papermc.io/software/velocity",
  "description": "This template is set up to use the Velocity part of itzg/mc-proxy. It is a Docker image that provides a choice of Minecraft proxies, the exposed variables configure it for Velocity. It is intended to be used in combination with itzg/minecraft-server containers.",
  "paths": [
    {
      "name": "Server Proxy Files",
      "host": "",
      "container": "/server",
      "mode": "rw",
      "description": "Leave blank for Unraid default appdata location",
      "required": false
    },
    {
      "name": "Velocity Config",
      "host": "",
      "container": "/config",
      "mode": "ro",
      "description": "Velocity configuration file location. Leave blank for unraid default",
      "required": false
    },
    {
      "name": "Forwarding Secret",
      "host": "",
      "container": "/plugins",
      "mode": "ro",
      "description": "Velocity plugin location. Leave blank for Unraid default",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "25565",
      "container": "25565",
      "protocol": "tcp",
      "description": "Port of your Minecraft proxy; How you want to access it.",
      "required": true,
      "mask": false
    },
    {
      "name": "Remote Connection Port",
      "host": "25575",
      "container": "25575",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Type",
      "key": "TYPE",
      "value": "VELOCITY",
      "description": "Sets the server proxy type",
      "required": true,
      "mask": false
    },
    {
      "name": "Enable Remote Connection",
      "key": "ENABLE_RCON",
      "value": "true",
      "description": "Enable remote connection, needed for many chat features.",
      "required": false,
      "mask": false
    },
    {
      "name": "Memory",
      "key": "MEMORY",
      "value": "512m",
      "description": "See: https://docs.papermc.io/velocity/tuning/",
      "required": false,
      "mask": false
    },
    {
      "name": "Server Icon URL",
      "key": "ICON",
      "value": "",
      "description": "URL to icon for server",
      "required": true,
      "mask": false
    },
    {
      "name": "Java Runtime Options",
      "key": "JVM_XX_OPTS",
      "value": "",
      "description": "Space seperated: Consider adding -XX:MaxRAMPercentage={n} (with {n} replaced); the JVM default is 25%.",
      "required": false,
      "mask": false
    },
    {
      "name": "Java Runtime Options",
      "key": "JVM_OPTS",
      "value": "",
      "description": "Commands after JVM_XX_OPTS",
      "required": false,
      "mask": false
    },
    {
      "name": "Plugins",
      "key": "PLUGINS",
      "value": "",
      "description": "Used to download a comma seperated list of *.jar urls to the plugins folder.",
      "required": false,
      "mask": false
    },
    {
      "name": "Enable Remote Connection",
      "key": "ENABLE_RCON",
      "value": "",
      "description": "Default is to be on",
      "required": false,
      "mask": false
    },
    {
      "name": "Remote Connection Password",
      "key": "RCON_PASSWORD",
      "value": "",
      "description": "Strong Secure Password",
      "required": true,
      "mask": true
    },
    {
      "name": "Icon Override",
      "key": "Icon Override",
      "value": "",
      "description": "Set this URL to overwrite an existing ICON",
      "required": false,
      "mask": false
    },
    {
      "name": "Initial Memory",
      "key": "INIT_MEMORY",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Max Memory",
      "key": "MAX_MEMORY",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Velocity Version",
      "key": "VELOCITY_VERSION",
      "value": "",
      "description": "Which Image to download; defaults to",
      "required": false,
      "mask": false
    },
    {
      "name": "Velocity Build ID",
      "key": "VELOCITY_BUILD_ID",
      "value": "",
      "description": "Pin to a specific build within a version",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
