{
  "name": "ComfyUI-Magic",
  "repo": "futrlabsmagic/comfyui-magic",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/futrlabsmagic/comfyui-magic/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--runtime=nvidia",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8188]/",
  "icon": "https://avatars.githubusercontent.com/u/121283862",
  "project": "https://www.minethefutr.com",
  "description": "ComfyUI-Magic: \ud83d\udd0bBatteries\ud83d\udd0b included",
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/comfy-ui",
      "container": "/storage",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web Interface",
      "host": "8188",
      "container": "8188",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NVIDIA_VISIBLE_DEVICES",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "NVIDIA_DRIVER_CAPABILITIES",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": "all",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Supplier ID",
      "key": "SUPPLIER_ID",
      "value": "",
      "description": "Sign up at: https://www.minethefutr.com",
      "required": false,
      "mask": false
    },
    {
      "name": "Auto-Accept Terms",
      "key": "AUTOACCEPT",
      "value": "yes",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
