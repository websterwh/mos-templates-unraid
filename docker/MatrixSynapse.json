{
  "name": "Matrix-Synapse",
  "repo": "matrixdotorg/synapse",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/matrixdotorg/synapse",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--no-healthcheck",
  "post_parameters": "generate",
  "web_ui_url": "http://[IP]:[PORT:8008]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/matrix.png",
  "project": "https://matrix.org/docs/projects/server/synapse",
  "description": "Matrix Chat's reference server. By default it uses a sqlite database; for production use you should connect it to a separate PostgreSQL database. The image also does not provide a TURN server. This will have some manual configuration, you will need to know what you are doing and/or read the documentation for Syanpse! READ ME: You must add the \"post argument\" of generate in the advanced UI on FIRST RUN only, and then remove it afterwards!",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/synapse",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Client Port",
      "host": "8008",
      "container": "8008",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Server Name",
      "key": "SYNAPSE_SERVER_NAME",
      "value": "matrix.domain.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Report Stats",
      "key": "SYNAPSE_REPORT_STATS",
      "value": "no",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "User ID",
      "key": "UID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Group ID",
      "key": "GID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
