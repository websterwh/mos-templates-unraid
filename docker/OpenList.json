{
  "name": "OpenList",
  "repo": "openlistteam/openlist:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/openlistteam/openlist",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5244]",
  "icon": "https://raw.githubusercontent.com/DearTanker/Unraid-OpenList-Docker-Template/refs/heads/main/OpenList-logo.png",
  "project": "https://github.com/OpenListTeam/OpenList",
  "description": "Drop-in replacement for AList with long-term governance, no hidden risks, and full transparency, built to defend open source against trust-based attacks. We sincerely thank the author Xhofe of the original project AlistGo/alist and all other contributors. This fork is not yet stable, specific migration progress can be viewed in OpenList Migration Work Summary. Important: Initial password in the log.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/openlist",
      "container": "/opt/openlist/data",
      "mode": "rw",
      "description": "Appdata Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5244",
      "container": "5244",
      "protocol": "tcp",
      "description": "Web UI Port: 5244",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
