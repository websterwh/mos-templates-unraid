{
  "name": "sonobarr",
  "repo": "ghcr.io/dodelidoo-labs/sonobarr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/Dodelidoo-Labs/sonobarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/Dodelidoo-Labs/sonobarr/refs/heads/main/src/static/favicon-192x192.png",
  "project": "https://github.com/Dodelidoo-Labs/sonobarr",
  "description": "Music discovery for Lidarr power users, blending Last.fm insights, ListenBrainz playlists, and a modern web UI.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/sonobarr",
      "container": "/sonobarr/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SECRET_KEY",
      "key": "SECRET_KEY",
      "value": "",
      "description": "Flask session signing key. Must be a long random string.",
      "required": true,
      "mask": true
    },
    {
      "name": "SONOBARR_SUPERADMIN_USERNAME",
      "key": "SONOBARR_SUPERADMIN_USERNAME",
      "value": "admin",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "SONOBARR_SUPERADMIN_PASSWORD",
      "key": "SONOBARR_SUPERADMIN_PASSWORD",
      "value": "change-me",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "SONOBARR_SUPERADMIN_DISPLAY_NAME",
      "key": "SONOBARR_SUPERADMIN_DISPLAY_NAME",
      "value": "Admin",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
