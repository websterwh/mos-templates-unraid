{
  "name": "WindowsinDocker",
  "repo": "dockurr/windows",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/dockurr/windows",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN --stop-timeout=120 --device-cgroup-rule=c *:* rwm",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8006]",
  "icon": "https://github.com/dockur/windows/raw/master/.github/logo.png",
  "project": "https://github.com/dockur/windows",
  "description": "Windows inside a Docker container. IMPORTANT: Might not work correctly (or at all) with BTRFS filesystems on Unraid. See the FAQ on the Github page for support. More Information: https://github.com/dockur/windows/issues/299 https://github.com/dockur/windows/issues/720",
  "paths": [
    {
      "name": "Custom Boot ISO",
      "host": "",
      "container": "/boot.iso",
      "mode": "rw",
      "description": "Specify a custom ISO to boot from. Version variable will be ignored",
      "required": false
    },
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/WindowsinDocker/",
      "container": "/storage",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Shared Data",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Specify a shared folder with the host (appears in file explorer as host.lan). More Information: https://github.com/dockur/windows?tab=readme-ov-file#how-do-i-share-files-with-the-host",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8006",
      "container": "8006",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "RDP Port (TCP)",
      "host": "3389",
      "container": "3389",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "RDP Port (UDP)",
      "host": "3389",
      "container": "3389",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Version",
      "key": "VERSION",
      "value": "11",
      "description": "Specify the installed Windows version. More Information: https://github.com/dockur/windows?tab=readme-ov-file#how-do-i-select-the-windows-version",
      "required": false,
      "mask": false
    },
    {
      "name": "DHCP",
      "key": "DHCP",
      "value": "N|Y",
      "description": "Enable DHCP (is required when using custom network like br0)",
      "required": false,
      "mask": false
    },
    {
      "name": "Username",
      "key": "USERNAME",
      "value": "",
      "description": "Set a custom username (default 'Docker')",
      "required": false,
      "mask": false
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": "",
      "description": "Set custom password (default 'admin')",
      "required": false,
      "mask": true
    },
    {
      "name": "Language",
      "key": "LANGUAGE",
      "value": "English",
      "description": "Set language for Windows",
      "required": false,
      "mask": false
    },
    {
      "name": "Region",
      "key": "REGION",
      "value": "en-US",
      "description": "Set region for Windows",
      "required": false,
      "mask": false
    },
    {
      "name": "Keyboard layout",
      "key": "KEYBOARD",
      "value": "en-US",
      "description": "Set keyboard layout for Windows",
      "required": false,
      "mask": false
    },
    {
      "name": "Manual Mode",
      "key": "MANUAL",
      "value": "|Y",
      "description": "Enable manual mode; Useful for custom ISO\u00b4s or when setting custom settings",
      "required": false,
      "mask": false
    },
    {
      "name": "Server Edition",
      "key": "EDITION",
      "value": "|core",
      "description": "Set Edition for Windows Server (only)",
      "required": false,
      "mask": false
    },
    {
      "name": "CPU Cores",
      "key": "CPU_CORES",
      "value": "2",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "RAM Size",
      "key": "RAM_SIZE",
      "value": "4G",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "DISK Size",
      "key": "DISK_SIZE",
      "value": "64G",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "KVM",
      "host": "/dev/kvm",
      "container": "",
      "description": null,
      "required": false
    },
    {
      "name": "TUN",
      "host": "/dev/net/tun",
      "container": "",
      "description": null,
      "required": false
    },
    {
      "name": "VHost",
      "host": "/dev/vhost-net",
      "container": "",
      "description": null,
      "required": false
    }
  ],
  "labels": []
}
