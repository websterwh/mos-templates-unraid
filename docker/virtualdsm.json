{
  "name": "virtual-dsm",
  "repo": "vdsm/virtual-dsm:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/vdsm/virtual-dsm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--stop-timeout 120 --cap-add NET_ADMIN --device-cgroup-rule=c *:* rwm",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/MountainGod2/unraid-templates/main/virtual-dsm/logo.png",
  "project": "https://github.com/vdsm/virtual-dsm",
  "description": "A docker container of Virtual DSM v7.2",
  "paths": [
    {
      "name": "Disk Location",
      "host": "",
      "container": "/storage",
      "mode": "rw",
      "description": "Optional: By default resides in docker volume. Set path to storage directory to override",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Port",
      "host": "5001",
      "container": "5001",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "VM Disk Size",
      "key": "DISK_SIZE",
      "value": "16G",
      "description": "Optional: Default is 16GB, ex. `16G`",
      "required": false,
      "mask": false
    },
    {
      "name": "RAM Size",
      "key": "RAM_SIZE",
      "value": "1G",
      "description": "Optional: Default is 1GB, ex. `1G`",
      "required": false,
      "mask": false
    },
    {
      "name": "CPU Cores",
      "key": "CPU_CORES",
      "value": "1",
      "description": "Optional: Default is 1",
      "required": false,
      "mask": false
    },
    {
      "name": "DHCP Mode",
      "key": "DHCP",
      "value": "N",
      "description": "Optional: Set to Y to enable DHCP (required for custom br0 network)",
      "required": false,
      "mask": false
    },
    {
      "name": "Preallocation",
      "key": "ALLOCATE",
      "value": "Y",
      "description": "Optional: Wether to preallocate the full disk capacity in advance.",
      "required": false,
      "mask": false
    },
    {
      "name": "Disk format",
      "key": "DISK_FMT",
      "value": "raw",
      "description": "Optional: Default is `raw`. Can be set to `qcow2` to create a growable disk.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "KVM",
      "host": "/dev/kvm",
      "container": "",
      "description": null,
      "required": false
    },
    {
      "name": "TUN",
      "host": "/dev/net/tun",
      "container": "",
      "description": null,
      "required": false
    },
    {
      "name": "VHost",
      "host": "/dev/vhost-net",
      "container": "",
      "description": null,
      "required": false
    }
  ],
  "labels": []
}
