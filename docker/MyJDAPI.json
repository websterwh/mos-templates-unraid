{
  "name": "MyJD-API",
  "repo": "rix1337/docker-myjd-api",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/rix1337/docker-myjd-api",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/rix1337/docker-templates/main/rix1337/myjd-api.png",
  "project": "https://github.com/rix1337/MyJD-API/",
  "description": "This is a standalone version of FeedCrawler's MyJDownloader API for use with projects like Organizr. --jd-device is optional if only one device is present JDownloader is expected to be running and connected to my.jdownloader.org - the script will otherwise fail to launch.",
  "paths": [
    {
      "name": "/config",
      "host": "/mnt/cache/appdata/myjd-api",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Webinterface",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MyJDownloader Username",
      "key": "USER",
      "value": "",
      "description": "Container Variable: USER",
      "required": false,
      "mask": false
    },
    {
      "name": "MyJDownloader Password",
      "key": "PASS",
      "value": "",
      "description": "Container Variable: PASS",
      "required": false,
      "mask": false
    },
    {
      "name": "MyJDownloader Device",
      "key": "DEVICE",
      "value": "",
      "description": "Container Variable: DEVICE",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
