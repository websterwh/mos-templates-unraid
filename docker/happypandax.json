{
  "name": "happypandax",
  "repo": "twiddly/happypandax:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/twiddly/happypandax/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7008]/",
  "icon": "https://github.com/GlassedSilver/unRAID-CAs/raw/master/happypandax/hpx_logo.png",
  "project": "https://github.com/happypandax/happypandax/",
  "description": "A cross-platform server and client application for managing and reading manga and doujinshi.",
  "paths": [
    {
      "name": "AppData Path",
      "host": "/mnt/cache/appdata/happypandax/",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    },
    {
      "name": "Content Path",
      "host": "",
      "container": "/content",
      "mode": "rw",
      "description": "Container Path: /content",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HPX Port",
      "host": "7007",
      "container": "7007",
      "protocol": "tcp",
      "description": "API Port for alt. Front-ends like HappyPandaX Desktop.",
      "required": true,
      "mask": false
    },
    {
      "name": "WebUI Port",
      "host": "7008",
      "container": "7008",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false
    },
    {
      "name": "Torrent Port",
      "host": "7006",
      "container": "7006",
      "protocol": "tcp",
      "description": "HPX_TORRENTPORT",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "RUN_IN_BACKGROUND",
      "key": "RUN_IN_BACKGROUND",
      "value": "true",
      "description": "Container Variable: RUN_IN_BACKGROUND",
      "required": true,
      "mask": false
    },
    {
      "name": "AUTOSTART_ON_BOOT",
      "key": "AUTOSTART_ON_BOOT",
      "value": "always",
      "description": "Container Variable: AUTOSTART_ON_BOOT",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "Container Variable: UMASK",
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "",
      "description": "Set your Time Zone here (e.g. Europe/Berlin)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
