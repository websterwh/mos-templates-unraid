{
  "name": "gPodder",
  "repo": "xthursdayx/gpodder-docker:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/xthursdayx/gpodder-docker/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/xthursdayx/docker-templates/master/xthursdayx/images/gpodder-icon.png",
  "project": "https://gpodder.github.io/",
  "description": "gPodder is a simple, open source podcast client written in Python using GTK+. In development since 2005 with a proven, mature codebase. Configuration: /config - Location of gPodder persistent config. /downloads - Location of downloads. PUID - set UserID PGID - set GroupID 3000 - WebUI access PASSWORD for setting a password for the gPodder WebUI #optional",
  "paths": [
    {
      "name": "Downloads Path",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/gPodder",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PASSWORD",
      "key": "PASSWORD",
      "value": "",
      "description": "Optional - password for Guacamole's web interface",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
