{
  "name": "selfoss",
  "repo": "hardware/selfoss",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/hardware/selfoss/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8888]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/selfoss.png",
  "project": "https://selfoss.aditu.de/",
  "description": "Selfoss, the new multipurpose rss reader, live stream, mashup, aggregation web application.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/selfoss/",
      "container": "/selfoss/data",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "CRON_PERIOD",
      "key": "CRON_PERIOD",
      "value": "15m",
      "description": "Cronjob period for updating feeds",
      "required": false,
      "mask": false
    },
    {
      "name": "UPLOAD_MAX_SIZE",
      "key": "UPLOAD_MAX_SIZE",
      "value": "25M",
      "description": "Attachment size limit",
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_TO_STDOUT",
      "key": "LOG_TO_STDOUT",
      "value": "false",
      "description": "Enable nginx and php error logs to stdout",
      "required": false,
      "mask": false
    },
    {
      "name": "MEMORY_LIMIT",
      "key": "MEMORY_LIMIT",
      "value": "128M",
      "description": "PHP memory limit",
      "required": false,
      "mask": false
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": "UID",
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": "GID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
