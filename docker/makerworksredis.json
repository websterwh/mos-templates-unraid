{
  "name": "makerworks-redis",
  "repo": "redis:7-alpine",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/_/redis",
  "network": "makerworks-net",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": "redis-server --appendonly yes",
  "web_ui_url": "http://[IP]:[PORT:6379]",
  "icon": "https://raw.githubusercontent.com/devicons/devicon/master/icons/redis/redis-original.svg",
  "project": "https://github.com/schartrand77/makerworks-unraid-templates",
  "description": "Redis 7 queue broker for MakerWorks background processing. MakerWorks-v2 and MakerWorks-v2-Worker use this container for BullMQ image and model-preview queues.",
  "paths": [
    {
      "name": "Redis Data Path",
      "host": "/mnt/cache/appdata/makerworks/redis",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent Redis append-only file storage for queue state.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Redis Port",
      "host": "6379",
      "container": "6379",
      "protocol": "tcp",
      "description": "Optional host port for Redis. Keep closed to the internet.",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": "Container timezone.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
