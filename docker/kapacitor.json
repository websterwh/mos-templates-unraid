{
  "name": "kapacitor",
  "repo": "kapacitor",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/_/kapacitor/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9092]/",
  "icon": "https://github.com/natcoso9955/unRAID-docker/raw/master/icons/influx_logo.png",
  "project": "https://www.influxdata.com/time-series-platform/kapacitor/",
  "description": "Kapacitor is a native data processing engine for InfluxDB 1.x and is an integrated component in the InfluxDB 2.0 platform. Kapacitor can process both stream and batch data from InfluxDB, acting on this data in real-time via its programming language TICKscript.",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/kapacitor",
      "container": "/var/lib/kapacitor",
      "mode": "rw",
      "description": "Container Path: /var/lib/kapacitor",
      "required": false
    },
    {
      "name": "config",
      "host": "/mnt/cache/appdata/kapacitor/kapacitor.conf",
      "container": "/etc/kapacitor/kapacitor.conf",
      "mode": "rw",
      "description": "Container Path: /etc/kapacitor/kapacitor.conf",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web GUI",
      "host": "9092",
      "container": "9092",
      "protocol": "tcp",
      "description": "Container Port: 9092",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
