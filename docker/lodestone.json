{
  "name": "lodestone",
  "repo": "ghcr.io/lodestone-team/lodestone_core:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://github.com/lodestone-team/lodestone_core/pkgs/container/lodestone_core",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:16662]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/lodestone.png",
  "project": "https://www.lodestone.cc/",
  "description": "A free, open source server hosting tool for Minecraft and other multiplayer games After first boot Unraid CLI chmod 777 -R /mnt/user/appdata/lodestone/ Then download the client from https://github.com/Lodestone-Team/lodestone/releases Copy the Secert key from the docker log and login Please note that for any Game server port add new port for it",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/lodestone/",
      "container": "/home/user/.lodestone",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Lodestone Port",
      "host": "16662",
      "container": "16662",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
