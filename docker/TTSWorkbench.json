{
  "name": "TTS-Workbench",
  "repo": "heroeswearkapes/tts-workbench:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/heroeswearkapes/tts-workbench",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7860]",
  "icon": "https://raw.githubusercontent.com/heroeswearkapes/unraid-community-apps/main/icons/tts_workbench.png",
  "project": "https://github.com/heroeswearkapes/tts-workbench",
  "description": "TTS Workbench is a self-hosted multi-engine AI text-to-speech platform with a unified Gradio interface. Supports: - Kokoro preset voice synthesis - F5-TTS voice cloning - Qwen3-TTS generation Includes dynamic engine controls, runtime diagnostics, model management, and Intel XPU acceleration support for compatible Intel Arc GPUs.",
  "paths": [
    {
      "name": "Models",
      "host": "/mnt/cache/AI/tts-workbench/models",
      "container": "/models",
      "mode": "rw",
      "description": "Persistent storage for downloaded TTS models.",
      "required": true
    },
    {
      "name": "Voices",
      "host": "/mnt/cache/AI/tts-workbench/voices",
      "container": "/voices",
      "mode": "rw",
      "description": "Persistent storage for Kokoro voices and saved voice profiles.",
      "required": true
    },
    {
      "name": "Input",
      "host": "/mnt/cache/AI/tts-workbench/input",
      "container": "/input",
      "mode": "rw",
      "description": "Input storage for reference audio and uploaded files.",
      "required": true
    },
    {
      "name": "Output",
      "host": "/mnt/cache/AI/tts-workbench/output",
      "container": "/output",
      "mode": "rw",
      "description": "Generated audio output storage.",
      "required": true
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/tts-workbench",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent application configuration storage.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "7860",
      "container": "7860",
      "protocol": "tcp",
      "description": "TTS Workbench Gradio Web Interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [
    {
      "name": "Intel GPU",
      "host": "/dev/dri/renderD128",
      "container": "/dev/dri/renderD128",
      "description": "Intel GPU render device. Change this to the renderD### device belonging to your Intel Arc GPU.",
      "required": false
    }
  ],
  "labels": []
}
