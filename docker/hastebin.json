{
  "name": "hastebin",
  "repo": "flippinturt/hastebin",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/flippinturt/hastebin",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7777]/",
  "icon": "https://raw.githubusercontent.com/nzzane/nzzane-unraid-repo/main/Icons/hastebin.png",
  "project": "https://github.com/nzzane/haste-server",
  "description": "Alpine-based Docker image for Hastebin, the node.js paste service Haste is an open-source pastebin software written in node.js, which is easily installable in any network. It can be backed by either redis or filesystem, and has a very easy adapter interface for other stores. A publicly available version can be found at hastebin.com",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/hastebin/",
      "container": "/app/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "7777",
      "container": "7777",
      "protocol": "tcp",
      "description": "Container Port: 7777",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
