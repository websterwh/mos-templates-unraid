{
  "name": "youdis",
  "repo": "eulaly/youdis",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/eulaly/youdis/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://github.com/eulaly/youdis/blob/c978a2326984efa9670678687ed1a1473478d753/yt_dlp.png?raw=1",
  "project": "https://github.com/eulaly/youdis",
  "description": "Discord bot-based wrapper for yt-dlp. Let your friends download videos to your server! Supports playlists, requires a configured Discord bot.",
  "paths": [
    {
      "name": "Downloads",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Video download location",
      "required": false
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/youdis/config",
      "container": "/config",
      "mode": "rw",
      "description": "Config location (archive.txt, users.json)",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "api_token",
      "key": "api_token",
      "value": "",
      "description": "Discord bot token",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
