{
  "name": "AdGuard-Home-11notes",
  "repo": "11notes/adguard:0.107.65-unraid",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/11notes/docker-adguard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/RobertCajun/unraid-templates/main/icons/adguard-11n-icon.png",
  "project": "https://github.com/11notes/docker-adguard",
  "description": "Custom Docker build of AdGuard Home by 11notes. Blocks ads and trackers network-wide with an easy-to-use interface. Port 3081 for Setup Port 3080 for Dashboard",
  "paths": [
    {
      "name": "Config Directory",
      "host": "/mnt/cache/appdata/adguard-11n/etc",
      "container": "/adguard/etc",
      "mode": "rw",
      "description": "Configuration files for AdGuard Home",
      "required": true
    },
    {
      "name": "Work Directory",
      "host": "/mnt/cache/appdata/adguard-11n/var",
      "container": "/adguard/var",
      "mode": "rw",
      "description": "Data and runtime files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "DNS Port (TCP)",
      "host": "53",
      "container": "53",
      "protocol": "tcp",
      "description": "DNS service TCP port",
      "required": true,
      "mask": false
    },
    {
      "name": "DNS Port (UDP)",
      "host": "53",
      "container": "53",
      "protocol": "udp",
      "description": "DNS service UDP port",
      "required": true,
      "mask": false
    },
    {
      "name": "Web UI for Setup",
      "host": "3081",
      "container": "3000",
      "protocol": "tcp",
      "description": "Setup Web UI (setup/config page)",
      "required": true,
      "mask": false
    },
    {
      "name": "Web UI for Dashbaord",
      "host": "3080",
      "container": "80",
      "protocol": "tcp",
      "description": "Dashboard Web UI (port 80 inside container)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
