{
  "name": "M.I.M.O.S.A",
  "repo": "devzwf/mimosa:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/devzwf/mimosa",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/mimosa-logo.png",
  "project": "https://github.com/FireMarshmellow/M.I.M.O.S.A",
  "description": "MIMOSA - short for \"Mellow_Labs Inventory Management and Organization System Apparatus\". Just like a refreshing mimosa, this system will make your life brighter and more organized! Check the Videos : Main Video: youtu.be/7C4i-2IqSS4 Step by step Video: https://youtu.be/QOd1apc0Lpo",
  "paths": [
    {
      "name": "Database Directory",
      "host": "/mnt/cache/appdata/mimosa/db",
      "container": "/app/db",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Logs Directory",
      "host": "/mnt/cache/appdata/mimosa/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Images directory",
      "host": "/mnt/cache/appdata/mimosa/images",
      "container": "/app/images",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
