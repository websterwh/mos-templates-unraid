{
  "name": "luanti",
  "repo": "lscr.io/linuxserver/luanti",
  "category": [
    "System"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/luanti",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:30000]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "https://www.luanti.org/",
  "description": "Luanti(https://www.luanti.org/) (formerly Minetest) is an open source voxel game-creation platform with easy modding and game creation",
  "paths": [
    {
      "name": "Path: /config/.minetest",
      "host": "",
      "container": "/config/.minetest",
      "mode": "rw",
      "description": "Where luanti stores config files and maps etc.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "30000",
      "container": "30000",
      "protocol": "udp",
      "description": "Port Luanti listens on (UDP).",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "CLI_ARGS",
      "key": "CLI_ARGS",
      "value": "--gameid devtest",
      "description": "Optionally specify any CLI variables(https://wiki.luanti.net/Command_line) you want to launch the app with",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
