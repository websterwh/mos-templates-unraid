{
  "name": "domoticz",
  "repo": "lscr.io/linuxserver/domoticz",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/domoticz",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/domoticz-logo.png",
  "project": "https://www.domoticz.com",
  "description": "Domoticz(https://www.domoticz.com) is a Home Automation System that lets you monitor and configure various devices like: Lights, Switches, various sensors/meters like Temperature, Rain, Wind, UV, Electra, Gas, Water and much more. Notifications/Alerts can be sent to any mobile device.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Where Domoticz stores config files and data.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 6144",
      "host": "6144",
      "container": "6144",
      "protocol": "tcp",
      "description": "Domoticz communication port.",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 1443",
      "host": "1443",
      "container": "1443",
      "protocol": "tcp",
      "description": "Domoticz communication port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "WEBROOT",
      "key": "WEBROOT",
      "value": "domoticz",
      "description": "Sets webroot to domoticz for usage with subfolder reverse proxy. Not needed unless reverse proxying.",
      "required": false,
      "mask": false
    },
    {
      "name": "DBASE",
      "key": "DBASE",
      "value": "path to database",
      "description": "Sets path to database. Do not set unless you know what this does.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "path to device",
      "host": "path to device",
      "container": "",
      "description": "For passing through USB devices.",
      "required": true
    }
  ],
  "labels": []
}
