{
  "name": "Matomo",
  "repo": "matomo",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/_/matomo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://i.imgur.com/mRIhLHE.png",
  "project": "https://github.com/matomo-org/matomo",
  "description": "Matomo, formerly Piwik, is a free and open-source web analytics application developed by a team of international developers, that runs on a PHP/MySQL webserver. It tracks online visits to one or more websites and displays reports on these visits for analysis.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/matomo",
      "container": "/var/www/html",
      "mode": "rw",
      "description": "Container Path: /var/www/html",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8383",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MATOMO_DATABASE_HOST",
      "key": "MATOMO_DATABASE_HOST",
      "value": "192.168.1.100",
      "description": "IP or hostname of the database server",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_PORT",
      "key": "MATOMO_DATABASE_PORT",
      "value": "3306",
      "description": "Port of the database server",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_USERNAME",
      "key": "MATOMO_DATABASE_USERNAME",
      "value": "matomo",
      "description": "Username of the database user",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_PASSWORD",
      "key": "MATOMO_DATABASE_PASSWORD",
      "value": "password",
      "description": "Password of the database user",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_DBNAME",
      "key": "MATOMO_DATABASE_DBNAME",
      "value": "matomo",
      "description": "Database name",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_SERVER_NAME",
      "key": "MATOMO_SERVER_NAME",
      "value": "192.168.1.100",
      "description": "Container Variable: MATOMO_SERVER_NAME",
      "required": true,
      "mask": false
    },
    {
      "name": "MATOMO_DATABASE_ADAPTER",
      "key": "MATOMO_DATABASE_ADAPTER",
      "value": "MYSQL",
      "description": "Container Variable: MATOMO_DATABASE_ADAPTER",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
