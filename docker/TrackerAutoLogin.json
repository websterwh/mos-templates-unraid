{
  "name": "TrackerAutoLogin",
  "repo": "mastiffmushroom/trackerautologin",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/mastiffmushroom/trackerautologin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1944]",
  "icon": "https://raw.githubusercontent.com/mastiffmushroom/TrackerAutoLogin/main/tal_icon.png",
  "project": "https://github.com/mastiffmushroom/TrackerAutoLogin",
  "description": "This project automates logging in to private trackers to keep your account active. You can personalize how often it logs in. It also adds randomization to the login times so it doesn't seem automated Github: https://github.com/mastiffmushroom/TrackerAutoLogin Dockerhub: https://hub.docker.com/repository/registry-1.docker.io/mastiffmushroom/trackerautologin/general",
  "paths": [
    {
      "name": "/appdata config",
      "host": "/mnt/cache/appdata/trackerautologin/config/",
      "container": "/app/config/",
      "mode": "rw",
      "description": "Container Path: /app/config/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port for headless chromium",
      "host": "1944",
      "container": "99",
      "protocol": "tcp",
      "description": "Container Port: 99",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
