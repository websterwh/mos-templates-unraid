{
  "name": "MatchExec",
  "repo": "ghcr.io/slamanna212/matchexec:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://github.com/slamanna212/MatchExec/pkgs/container/matchexec",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/slamanna212/MatchExec/main/public/web-app-manifest-512x512.png",
  "project": "https://matchexec.com",
  "description": "MatchExec, The complete video game tournament manager. Take the busy work out of match & tournament management. Automatic registration forms, alerts, scoring, and more. Send less time running the tournament and more time being a part of it.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/MatchExec/config",
      "container": "/app/app_data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Uploads",
      "host": "/mnt/cache/appdata/MatchExec/uploads",
      "container": "/app/public/uploads",
      "mode": "rw",
      "description": "Used for adding custom images to matches.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port for 3000",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Web UI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
