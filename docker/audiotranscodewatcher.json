{
  "name": "audio-transcode-watcher",
  "repo": "drumsergio/audio-transcoder:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/drumsergio/audio-transcoder",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/GeiserX/docker-templates/master/drumsergio/images/audio-transcode-watcher.png",
  "project": "https://github.com/GeiserX/audio-transcode-watcher",
  "description": "Watches a source folder for audio files and automatically transcodes them to multiple formats (ALAC, AAC, MP3, Opus, FLAC, WAV) in parallel using FFmpeg. Configured via a YAML config file for flexible source/output directory mapping. Ideal for music library management \u2014 keep lossless originals and automatically generate compressed versions for mobile devices or streaming. More info: https://github.com/GeiserX/audio-transcode-watcher",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/audio-transcoder/config.yaml",
      "container": "/app/config.yaml",
      "mode": "ro",
      "description": "YAML configuration file (read-only)",
      "required": true
    },
    {
      "name": "Source Audio",
      "host": "/mnt/cache/Multimedia/Music/FLAC",
      "container": "/music/flac",
      "mode": "ro",
      "description": "Source audio folder (read-only)",
      "required": true
    },
    {
      "name": "ALAC Output",
      "host": "/mnt/cache/Multimedia/Music/ALAC",
      "container": "/music/alac",
      "mode": "rw",
      "description": "ALAC output directory",
      "required": false
    },
    {
      "name": "MP3 Output",
      "host": "/mnt/cache/Multimedia/Music/MP3",
      "container": "/music/mp3",
      "mode": "rw",
      "description": "MP3 output directory",
      "required": false
    },
    {
      "name": "AAC Output",
      "host": "/mnt/cache/Multimedia/Music/AAC",
      "container": "/music/aac",
      "mode": "rw",
      "description": "AAC output directory",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Timezone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
