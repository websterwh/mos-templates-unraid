{
  "name": "stalwart",
  "repo": "stalwartlabs/stalwart:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/stalwartlabs/stalwart",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "-ti",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/tajniak81/unraid-docker-templates/refs/heads/main/stalwart/icon/stalwart.png",
  "project": "https://stalw.art/",
  "description": "Step into the future with Stalwart, the open-source powerhouse combining modern email and collaboration features with unmatched security, speed, and scalability. https://stalw.art/ https://github.com/stalwartlabs/stalwart Execute docker logs stalwart to obtain the system administrator account and password: $ docker logs stalwart",
  "paths": [
    {
      "name": "Stalwart data",
      "host": "/mnt/cache/appdata/stalwart",
      "container": "/opt/stalwart",
      "mode": "rw",
      "description": "Stalwart data",
      "required": true
    }
  ],
