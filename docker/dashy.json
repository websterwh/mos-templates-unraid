{
  "name": "dashy",
  "repo": "lissy93/dashy:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/lissy93/dashy/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/dashy.png",
  "project": "https://github.com/lissy93/dashy",
  "description": "Dashy helps you organize your self-hosted services, by making them all accessible from a single place. -Before you start CLI Unraid mkdir /mnt/user/appdata/dashy/ wget -O /mnt/user/appdata/dashy/conf.yml https://raw.githubusercontent.com/Lissy93/dashy/3.0.0/user-data/conf.yml -Edit conf.yml",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/dashy/",
      "container": "/app/user-data/",
      "mode": "rw",
      "description": "Config File https://raw.githubusercontent.com/Lissy93/dashy/3.0.0/user-data/conf.yml",
      "required": false
    },
    {
      "name": "Icons Path",
      "host": "/mnt/cache/appdata/dashy/icons/",
      "container": "/app/user-data/item-icons/",
      "mode": "rw",
      "description": "Icons Path",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "4000",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "UID",
      "key": "UID",
      "value": "500",
      "description": "UID",
      "required": false,
      "mask": false
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "500",
      "description": "GID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
