{
  "name": "AzuraRelay",
  "repo": "ghcr.io/azuracast/relay:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/azuracast/relay",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1080]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/azuracast-icon.png",
  "project": "https://github.com/AzuraCast/AzuraRelay/",
  "description": "A \"relay in a box\" containing a lightweight web application and Icecast servers that can connect to and relay an AzuraRelay parent instance.",
  "paths": [
    {
      "name": "ACME Path",
      "host": "/mnt/cache/appdata/azuracast_relay/acme",
      "container": "/var/app/acme",
      "mode": "rw",
      "description": "ACME storage",
      "required": true
    },
    {
      "name": "Temp Data Path",
      "host": "/mnt/cache/appdata/azuracast_relay/tmp",
      "container": "/var/app/www_tmp",
      "mode": "rw",
      "description": "Temporary data storage",
      "required": true
    },
    {
      "name": "Stations Data Path",
      "host": "/mnt/cache/appdata/azuracast_relay/stations",
      "container": "/var/app/stations",
      "mode": "rw",
      "description": "Stations data storage",
      "required": true
    }
  ],
