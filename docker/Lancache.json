{
  "name": "Lancache",
  "repo": "lancachenet/monolithic:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/lancachenet/monolithic",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/redvex2460/docker-templates/master/redvex2460/images/lancache.png",
  "project": "http://lancache.net",
  "description": "This docker container provides a caching proxy server for game download content. For any network with more than one PC gamer in connected this will drastically reduce internet bandwidth consumption.",
  "paths": [
    {
      "name": "Logs-Folder",
      "host": "/mnt/cache/appdata/lancache/logs",
      "container": "/data/logs",
      "mode": "rw",
      "description": "Container Path: /data/logs",
      "required": true
    },
    {
      "name": "Cache-Folder",
      "host": "/mnt/cache/appdata/lancache/cache",
      "container": "/data/cache/",
      "mode": "rw",
      "description": "Container Path: /data/cache/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP-Port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS-Port",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
