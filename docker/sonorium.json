{
  "name": "sonorium",
  "repo": "ghcr.io/synssins/sonorium:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://ghcr.io/synssins/sonorium",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8008]/",
  "icon": "https://github.com/synssins/sonorium/raw/refs/heads/main/icon.png",
  "project": "https://github.com/synssins/sonorium",
  "description": "Sonorium is an ambient soundscape mixer for Home Assistant that lets you craft immersive audio environments throughout your home. Stream richly layered sounds\u2014from distant thunder and rainfall to forest wildlife and flowing water\u2014to any media player in your space, creating the perfect atmosphere for focus, relaxation, or sleep.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/sonorium/config",
      "container": "/config",
      "mode": "rw",
      "description": "settings and channels",
      "required": true
    },
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/appdata/sonorium/media",
      "container": "/media/sonorium",
      "mode": "rw",
      "description": "themes and audio",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Etc/UTC",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
