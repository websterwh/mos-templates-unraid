{
  "name": "Pict-rs",
  "repo": "asonix/pictrs:0.5.16",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/asonix/pictrs/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/LemmyNet/lemmy-ui/main/src/assets/icons/favicon.svg",
  "project": "https://git.asonix.dog/asonix/pict-rs",
  "description": "Image hosting service for Lemmy.",
  "paths": [
    {
      "name": "Media Path",
      "host": "/mnt/cache/appdata/lemmy/pictrs",
      "container": "/mnt",
      "mode": "rw",
      "description": "Storage location for uploaded media",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "API Key",
      "key": "PICTRS__API_KEY",
      "value": "changeme",
      "description": "API key for authentication",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
