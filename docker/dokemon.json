{
  "name": "dokemon",
  "repo": "productiveops/dokemon:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/productiveops/dokemon",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9090]/",
  "icon": "https://raw.githubusercontent.com/Joly0/unraid-templates/main/icons/dokemon-server-icon.png",
  "project": "https://dokemon.dev/",
  "description": "Dok\u00e9mon is a friendly GUI for managing Docker Containers. You can manage multiple servers from a single Dokemon instance.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dokemon",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DOCKER_API_VERSION",
      "key": "DOCKER_API_VERSION",
      "value": "1.41",
      "description": "Temporary workaround to run dokemon on unraid. Is probably not reqiured when updating to unraid 6.13",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
