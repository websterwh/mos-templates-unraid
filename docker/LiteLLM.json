{
  "name": "LiteLLM",
  "repo": "ghcr.io/berriai/litellm:main-latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/BerriAI/litellm/pkgs/container/litellm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--config /app/config.yaml --detailed_debug",
  "web_ui_url": "http://[IP]:[PORT:4000]/ui",
  "icon": "https://raw.githubusercontent.com/BerriAI/litellm/refs/heads/main/ui/litellm-dashboard/src/app/favicon.ico",
  "project": "https://github.com/BerriAI/litellm",
  "description": "LiteLLM provides a proxy server to manage auth, loadbalancing, and spend tracking across 100+ LLMs. All in the OpenAI format.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/litellm/litellm_config.yaml",
      "container": "/app",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "API/WebUI",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
