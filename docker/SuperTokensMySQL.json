{
  "name": "SuperTokens---MySQL",
  "repo": "registry.supertokens.io/supertokens/supertokens-mysql:latest",
  "category": [
    "Security"
  ],
  "registry": "https://registry.hub.docker.com/r/registry.supertokens.io/supertokens/supertokens-mysql",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3567]/hello",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/supertokens-icon.png",
  "project": "https://supertokens.com/",
  "description": "Open source alternative to Auth0 / Firebase Auth / AWS Cognito. Add secure login and session management to your apps. Additional options can be added via environmental variables or a mounted config file: https://github.com/supertokens/supertokens-docker-mysql/blob/master/README.md",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "3567",
      "container": "3567",
      "protocol": "tcp",
      "description": "Container Port: 3567",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MySQL Connection URI",
      "key": "MYSQL_CONNECTION_URI",
      "value": "mysql://supertokens_user:somePassword@IP_ADDRESS:3306/supertokens",
      "description": "Connection URL for MySQL",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
