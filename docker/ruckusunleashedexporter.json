{
  "name": "ruckus-unleashed-exporter",
  "repo": "ccmpbll/ruckus-unleashed-exporter",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ccmpbll/ruckus-unleashed-exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9785]",
  "icon": "https://raw.githubusercontent.com/ccmpbll/unraid-docker-templates/main/images/ruckus-prom.png",
  "project": "https://github.com/ccmpbll/ruckus-unleashed-exporter",
  "description": "Prometheus metrics exporter for Ruckus Unleashed. Scrapes the Unleashed AJAX API and exposes per-AP, per-radio, per-client, and per-SSID metrics.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "9785",
      "container": "9785",
      "protocol": "tcp",
      "description": "Prometheus Exporter Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Ruckus Host",
      "key": "RUCKUS_HOST",
      "value": "",
      "description": "IP or hostname of the Unleashed master AP",
      "required": true,
      "mask": false
    },
    {
      "name": "Ruckus Username",
      "key": "RUCKUS_USER",
      "value": "admin",
      "description": "Unleashed admin username",
      "required": true,
      "mask": false
    },
    {
      "name": "Ruckus Password",
      "key": "RUCKUS_PASS",
      "value": "",
      "description": "Unleashed admin password",
      "required": true,
      "mask": true
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO",
      "description": "Log verbosity: DEBUG, INFO, WARNING, ERROR",
      "required": false,
      "mask": false
    },
    {
      "name": "AJAX Timeout",
      "key": "AJAX_TIMEOUT",
      "value": "10",
      "description": "Timeout in seconds for each request to the Unleashed controller during a scrape",
      "required": false,
      "mask": false
    },
    {
      "name": "Debug Bind",
      "key": "DEBUG_BIND",
      "value": "127.0.0.1",
      "description": "Address the /debug listener binds. Set to 0.0.0.0 to reach it from outside the container",
      "required": false,
      "mask": false
    },
    {
      "name": "Debug Port",
      "key": "DEBUG_PORT",
      "value": "9786",
      "description": "Port the /debug listener binds",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
