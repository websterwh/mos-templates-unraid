{
  "name": "Mailpit",
  "repo": "axllent/mailpit",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/axllent/mailpit",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8025]",
  "icon": "https://raw.githubusercontent.com/JmzTaylor/unraid_templates/master/mailpit.png",
  "project": "https://github.com/axllent/mailpit",
  "description": "Mailpit is a multi-platform email testing tool & API for developers. It acts as both an SMTP server, and provides a web interface to view all captured emails. It also contains an API for automated integration testing. Mailpit is inspired by MailHog, but modern and much, much faster.",
  "paths": [
    {
      "name": "storage",
      "host": "/mnt/cache/appdata/mailpit",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "smtp",
      "host": "1025",
      "container": "1025",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "http",
      "host": "8025",
      "container": "8025",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
