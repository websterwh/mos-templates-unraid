{
  "name": "pve-metrics-exporter",
  "repo": "ghcr.io/drumandbytes/pve-metrics-exporter:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/drumandbytes/pve-metrics-exporter/pkgs/container/pve-metrics-exporter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9221]/metrics",
  "icon": "https://raw.githubusercontent.com/drumandbytes/unraid-templates/main/icons/pve-metrics-exporter.png",
  "project": "https://github.com/drumandbytes/pve-metrics-exporter",
  "description": "Proxmox VE exporter for Prometheus and Glance: node, VM and container resource metrics plus the CPU/GPU/NVMe hardware temperatures most Proxmox exporters skip. Serves /metrics for Prometheus and /api/summary for Glance from one shared cache.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "9221",
      "container": "9221",
      "protocol": "tcp",
      "description": "Metrics port (/metrics and /api/summary).",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Proxmox URL",
      "key": "PROXMOX_URL",
      "value": "https://192.168.1.10:8006",
      "description": "Base URL of the Proxmox API.",
      "required": true,
      "mask": false
    },
    {
      "name": "Proxmox API token",
      "key": "PROXMOX_TOKEN",
      "value": "",
      "description": "Full Authorization header value: PVEAPIToken=user@pve!tokenid=uuid",
      "required": true,
      "mask": true
    },
    {
      "name": "Skip TLS verify",
      "key": "PROXMOX_INSECURE_SKIP_VERIFY",
      "value": "true",
      "description": "Proxmox ships a self-signed certificate; set false once replaced.",
      "required": false,
      "mask": false
    },
    {
      "name": "Temperature unit",
      "key": "TEMPERATURE_UNIT",
      "value": "celsius",
      "description": "celsius or fahrenheit (affects /api/summary only).",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
