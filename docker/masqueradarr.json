{
  "name": "masqueradarr",
  "repo": "iflip721/masqueradarr-aio:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/iflip721/masqueradarr-aio",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/TheBinaryNinja/masqueradarr/refs/heads/main/docs/icons/app-icon-teal-circle-512.png",
  "project": "https://thebinaryninja.github.io/masqueradarr/",
  "description": "masqueradarr is a self-hosted IPTV aggregator. It pulls channel playlists (M3U) and guide data (EPG/XMLTV) from a range of online IPTV services, normalizes them into one catalog, and serves them back as a single, unified, standards-compliant playlist + guide \u2014 behind one trusted identity that your media apps and IPTV clients can talk to. https://discord.com/channels/1519879505886576690/1519879507039748098",
  "paths": [
    {
      "name": "MONGO_DATA_PATH",
      "host": "/mnt/cache/appdata/masqueradarr/mongo",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "COMPOSE_PATH",
      "host": "/mnt/cache/appdata/masqueradarr/compose",
      "container": "/app/compose",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "BACKUPS_PATH",
      "host": "/mnt/cache/appdata/masqueradarr/backups",
      "container": "/app/backups",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "MASQUERADARR_PORT",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MONGO_HOST_PORT",
      "host": "27017",
      "container": "27017",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MASQ_EDGE",
      "key": "MASQ_EDGE",
      "value": "1",
      "description": "Optional (default off). 1 inverts the topology so the Rust proxy owns the public port",
      "required": false,
      "mask": false
    },
    {
      "name": "MONGO_ROOT_USER",
      "key": "MONGO_ROOT_USER",
      "value": "masqueradarr",
      "description": "Update MONGO_ROOT_USER to set a different username",
      "required": true,
      "mask": false
    },
    {
      "name": "MONGO_ROOT_PASS",
      "key": "MONGO_ROOT_PASS",
      "value": "changeme",
      "description": "Update MONGO_ROOT_PASS to set a different password",
      "required": true,
      "mask": true
    },
    {
      "name": "DOMAIN",
      "key": "DOMAIN",
      "value": "http://localhost:3000",
      "description": "Update DOMAIN to match your local system or public domain",
      "required": false,
      "mask": false
    },
    {
      "name": "DISPLAY_NAME",
      "key": "DISPLAY_NAME",
      "value": "masqueradarr",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/New_York",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
