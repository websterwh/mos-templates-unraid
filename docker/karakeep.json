{
  "name": "karakeep",
  "repo": "ghcr.io/karakeep-app/karakeep:release",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/karakeep-app/karakeep/pkgs/container/karakeep",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/Collectathon/unraid-templates/main/icons/karakeep.png",
  "project": "https://github.com/karakeep-app/karakeep",
  "description": "A self-hostable bookmark-everything app with a touch of AI for the data hoarders out there.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/karakeep",
      "container": "/data",
      "mode": "rw",
      "description": "AppData Location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "NextAuth Address",
      "key": "NEXTAUTH_URL",
      "value": "http://localhost:3000",
      "description": "Karakeep Address or URL",
      "required": true,
      "mask": false
    },
    {
      "name": "NextAuth Secret",
      "key": "NEXTAUTH_SECRET",
      "value": "secretkeysecretkeysecretkeysecretkey",
      "description": "Generate with openssl rand -base64 36",
      "required": true,
      "mask": true
    },
    {
      "name": "Browser Address",
      "key": "BROWSER_WEB_URL",
      "value": "http://localhost:9222",
      "description": "HTTP debugging address of the Karakeep Chrome container",
      "required": true,
      "mask": false
    },
    {
      "name": "Meili Address (Optional)",
      "key": "MEILI_ADDR",
      "value": "http://localhost:7700",
      "description": "Meilisearch Address or URL",
      "required": false,
      "mask": false
    },
    {
      "name": "Meili Master Key (Optional)",
      "key": "MEILI_MASTER_KEY",
      "value": "masterkeymasterkeymasterkeymasterkey",
      "description": "Password required to query meilisearch",
      "required": false,
      "mask": true
    },
    {
      "name": "OpenAI API Key",
      "key": "OPENAI_API_KEY",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Disable Signups",
      "key": "DISABLE_SIGNUPS",
      "value": "false",
      "description": "True = Signup Disabled",
      "required": false,
      "mask": false
    },
    {
      "name": "Internal Data Directory",
      "key": "DATA_DIR",
      "value": "/data",
      "description": "DO NOT CHANGE",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
