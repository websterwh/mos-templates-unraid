{
  "name": "Livrarr",
  "repo": "ghcr.io/kkodecs/livrarr:0.1.0-alpha6",
  "category": [
    "Downloader"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/kkodecs/livrarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8789]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/livrarr-icon.png",
  "project": "https://github.com/kkodecs/livrarr",
  "description": "Self-hosted ebook and audiobook library manager. Built for the *arr ecosystem \u2014 finds, grabs, and organizes your books",
  "paths": [
    {
      "name": "Books Storage",
      "host": "",
      "container": "/books",
      "mode": "rw",
      "description": "Path to books storage",
      "required": true
    },
    {
      "name": "Downloads Storage",
      "host": "",
      "container": "/downloads",
      "mode": "rw",
      "description": "Path to downloads storage",
      "required": true
    },
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/livrarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8789",
      "container": "8789",
      "protocol": "tcp",
      "description": "Container Port: 8789",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container User ID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Group ID",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
