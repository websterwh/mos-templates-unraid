{
  "name": "chirpstack-gateway-bridge",
  "repo": "chirpstack/chirpstack-gateway-bridge",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/chirpstack/chirpstack-gateway-bridge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:1700]",
  "icon": "https://raw.githubusercontent.com/andaks/unraid-templates/master/chirpstack/chirpstack_logo.png",
  "project": "https://www.chirpstack.io/",
  "description": "ChirpStack Gateway Bridge is a service which converts LoRa\u00ae Packet Forwarder protocols into a ChirpStack common data-format. Required: chirpstack, mqtt server example mosquitto",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/mnt/cache/appdata/chirpstack-gateway-bridge",
      "container": "/etc/chirpstack-gateway-bridge",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Application Port",
      "host": "1700",
      "container": "1700",
      "protocol": "udp",
      "description": "Port to access chirpstack",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
