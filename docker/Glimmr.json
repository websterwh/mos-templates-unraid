{
  "name": "Glimmr",
  "repo": "digitalhigh/glimmr",
  "category": [
    "Misc"
  ],
  "registry": "https://registry.hub.docker.com/r/digitalhigh/glimmr",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/d8ahazard/unraid-repository/blob/master/img/glimmr_icon.png?raw=true",
  "project": "https://github.com/d8ahazard/glimmr",
  "description": "Glimmr synchronizes your Hue Lights, nanoleaf panels, and lifx bulbs with a DreamScreen controller.",
  "paths": [
    {
      "name": "UserData Location",
      "host": "/mnt/cache/appdata/glimmr/",
      "container": "/etc/glimmr",
      "mode": "rw",
      "description": "Where to store HueData config.",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Web UI port.",
      "required": true,
      "mask": false
    },
    {
      "name": "Hue SSDP Discovery",
      "host": "1900",
      "container": "1900",
      "protocol": "udp",
      "description": "Hue Bridge discovery port.",
      "required": true,
      "mask": false
    },
    {
      "name": "Hue/Nanoleaf MDNS Discovery",
      "host": "5353",
      "container": "5353",
      "protocol": "udp",
      "description": "MDNS Discovery Port",
      "required": true,
      "mask": false
    },
    {
      "name": "Hue Streaming",
      "host": "2100",
      "container": "2100",
      "protocol": "udp",
      "description": "Hue Bridge streaming port.",
      "required": true,
      "mask": false
    },
    {
      "name": "DreamScreen Communication",
      "host": "8888",
      "container": "8888",
      "protocol": "udp",
      "description": "DreamScreen emulation port.",
      "required": true,
      "mask": false
    },
    {
      "name": "NanoLeaf Communication",
      "host": "60222",
      "container": "60222",
      "protocol": "udp",
      "description": "DreamScreen emulation port.",
      "required": true,
      "mask": false
    },
    {
      "name": "Lifx Communication",
      "host": "56700",
      "container": "56700",
      "protocol": "udp",
      "description": "Port used for Lifx communication.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
