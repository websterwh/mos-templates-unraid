{
  "name": "kibana",
  "repo": "kibana:7.12.0",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/_/kibana/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5601]",
  "icon": "https://raw.githubusercontent.com/cschanot/docker-templates/main/images/kibana.png",
  "project": "https://www.elastic.co/kibana",
  "description": "Kibana gives shape to any kind of data \u2014 structured and unstructured \u2014 indexed in Elasticsearch. Please install and run Elasticsearch docker first. Set the tag to it to match the one you are using on Kibana (currently 7.12.0) Change ELASTIC_SEARCH_HOSTS to match the address of your Elasticsearch",
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "host": "5601",
      "container": "5601",
      "protocol": "tcp",
      "description": "Container Port: 5601",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "ELASTICSEARCH_HOSTS",
      "key": "ELASTICSEARCH_HOSTS",
      "value": "http://192.168.1.20:9200",
      "description": "Container Variable: ELASTICSEARCH_HOSTS",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
