{
  "name": "ytdl-sub",
  "repo": "ghcr.io/jmbannon/ytdl-sub:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/jmbannon/ytdl-sub",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/ytdl-sub.png",
  "project": "https://github.com/jmbannon/ytdl-sub",
  "description": "Automate downloads and metadata generation with YoutubeDL. This is the headless variant. See `ytdl-sub-gui` for a web-gui version.",
  "paths": [
    {
      "name": "config",
      "host": "/mnt/cache/appdata/ytdl-sub",
      "container": "/config",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "TV Shows",
      "host": "/mnt/cache/tv_shows",
      "container": "/tv_shows",
      "mode": "rw",
      "description": "Path to store TV shows",
      "required": false
    },
    {
      "name": "Music",
      "host": "/mnt/cache/music",
      "container": "/music",
      "mode": "rw",
      "description": "Path to store music",
      "required": false
    },
    {
      "name": "Music Videos",
      "host": "/mnt/cache/music_videos",
      "container": "/music_videos",
      "mode": "rw",
      "description": "Path to store music videos",
      "required": false
    },
    {
      "name": "Movies",
      "host": "/mnt/cache/movies",
      "container": "/movies",
      "mode": "rw",
      "description": "Path to store movies",
      "required": false
    },
    {
      "name": "Media",
      "host": "/mnt/cache/media",
      "container": "/media",
      "mode": "rw",
      "description": "Top-level folder for all media, can use separate mounts instead",
      "required": false
    },
    {
      "name": "tmp",
      "host": "/mnt/cache/media/temp/",
      "container": "/tmp",
      "mode": "rw",
      "description": "Temp folder for ytdl-sub to use as a cache",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
