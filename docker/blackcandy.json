{
  "name": "blackcandy",
  "repo": "ghcr.io/blackcandy-org/blackcandy:latest",
  "category": [
    "Media"
  ],
  "registry": "https://ghcr.io/blackcandy-org/blackcandy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/tquizzle/Docker-xml/master/img/blackcandy.png",
  "project": "https://github.com/blackcandy-org/blackcandy",
  "description": "Black Candy is a self-hosted music streaming server, your personal music center. **************** You must chown the application directory as this image runs as 1000:1000 mkdir /mnt/cache/appdata/blackcandy chown 1000:1000 /mnt/cache/appdata/blackcandy -R **************** Use the initial admin user to log in (email: admin@admin.com, password: foobar). Black Candy mobile apps are available in the following app stores: https://apps.apple.com/app/blackcandy/id6444304071 https://f-droid.org/packages/org.blackcandy.android/",
  "paths": [
    {
      "name": "Music Path",
      "host": "",
      "container": "/media_data",
      "mode": "ro",
      "description": null,
      "required": false
    },
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/blackcandy",
      "container": "/app/storage",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "PORT",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MEDIA_PATH",
      "key": "MEDIA_PATH",
      "value": "/media_data",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
