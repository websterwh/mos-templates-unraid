{
  "name": "photoshow",
  "repo": "lscr.io/linuxserver/photoshow",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/photoshow",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/photoshow-logo.png",
  "project": "https://github.com/thibaud-rohmer/PhotoShow",
  "description": "Photoshow(https://github.com/thibaud-rohmer/PhotoShow) is gallery software at its easiest, it doesn't even require a database.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Stores config and logs for nginx base.",
      "required": true
    },
    {
      "name": "Path: /Pictures",
      "host": "",
      "container": "/Pictures",
      "mode": "ro",
      "description": "Your local folder of photos you wish to share.",
      "required": true
    },
    {
      "name": "Path: /Thumbs",
      "host": "",
      "container": "/Thumbs",
      "mode": "rw",
      "description": "Local folder to store thumbnails of your images.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
