{
  "name": "traccar",
  "repo": "traccar/traccar",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/traccar/traccar/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --hostname traccar",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8082]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/traccar.png",
  "project": "https://github.com/traccar/traccar",
  "description": "Traccar is an open source GPS tracking system. This repository contains Java-based back-end service. It supports more than 170 GPS protocols and more than 1500 models of GPS tracking devices. Traccar can be used with any major SQL database system. It also provides easy to use REST API. Link to traccar.xml: https://raw.githubusercontent.com/traccar/traccar/master/setup/traccar.xml Add it to your host path before starting the container.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/traccar/data",
      "container": "/opt/traccar/data",
      "mode": "rw",
      "description": "Container Path: /opt/traccar/data",
      "required": false
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/traccar/logs",
      "container": "/opt/traccar/logs",
      "mode": "rw",
      "description": "Container Path: /opt/traccar/logs",
      "required": false
    },
    {
      "name": "traccar.xml host path",
      "host": "/mnt/cache/appdata/traccar/traccar.xml",
      "container": "/opt/traccar/conf/traccar.xml",
      "mode": "rw",
      "description": "Container Path: /opt/traccar/conf/traccar.xml",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8082",
      "container": "8082",
      "protocol": "tcp",
      "description": "Container Port: 8082",
      "required": false,
      "mask": false
    },
    {
      "name": "Host port 1",
      "host": "5000-5150",
      "container": "5000-5150",
      "protocol": "tcp",
      "description": "Container Port: 5000-5150",
      "required": false,
      "mask": false
    },
    {
      "name": "Host port 2",
      "host": "5000-5150",
      "container": "5000-5150",
      "protocol": "udp",
      "description": "Container Port: 5000-5150",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
