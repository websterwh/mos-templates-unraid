{
  "name": "emulatorjs",
  "repo": "lscr.io/linuxserver/emulatorjs",
  "category": [
    "Game Server"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/emulatorjs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/emulatorjs-logo.png",
  "project": "https://github.com/linuxserver/emulatorjs",
  "description": "Emulatorjs(https://github.com/linuxserver/emulatorjs) - In browser web based emulation portable to nearly any device for many retro consoles. A mix of emulators is used between Libretro and EmulatorJS.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Path to store user profiles",
      "required": true
    },
    {
      "name": "Path: /data",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Path to store roms/artwork",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Rom/artwork management interface, used to generate/manage config files and download artwork",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 80",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Emulation frontend containing static web files used to browse and launch games",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 4001",
      "host": "4001",
      "container": "4001",
      "protocol": "tcp",
      "description": "IPFS peering port, if you want to participate in the P2P network to distribute frontend artwork please forward this to the Internet",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "SUBFOLDER",
      "key": "SUBFOLDER",
      "value": "/",
      "description": "Specify a subfolder for reverse proxies IE '/FOLDER/'",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
