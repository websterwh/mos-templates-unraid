{
  "name": "ghorg",
  "repo": "ghcr.io/gabrie30/ghorg:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://registry.hub.docker.com/r/ghcr.io/gabrie30/ghorg",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "reclone-server --port 8080",
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ghorg-icon.png",
  "project": "https://github.com/gabrie30/ghorg",
  "description": "Use to quickly clone all of an organization's or user's git repositories into a single directory. This starts a web server that allows you to trigger the cloning process for configured groups via HTTP requests: https://github.com/gabrie30/ghorg?tab=readme-ov-file#reclone-server-command",
  "paths": [
    {
      "name": "Data Path",
      "host": "",
      "container": "/data",
      "mode": "rw",
      "description": "Where to store repositories",
      "required": true
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/ghorg/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Internal Data Path",
      "key": "GHORG_ABSOLUTE_PATH_TO_CLONE_TO",
      "value": "/data",
      "description": "Internal path to repository storage. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Config Path",
      "key": "GHORG_CONFIG",
      "value": "/config/conf.yaml",
      "description": "Internal path to config file. Not recommended to change.",
      "required": true,
      "mask": false
    },
    {
      "name": "Internal Reclone Path",
      "key": "GHORG_RECLONE_PATH",
      "value": "/config/reclone.yaml",
      "description": "Internal path to reclone file. Not recommended to change.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
