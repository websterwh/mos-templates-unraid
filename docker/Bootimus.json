{
  "name": "Bootimus",
  "repo": "garybowers/bootimus:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/garybowers/bootimus",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_BIND_SERVICE --restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/bootimus.png",
  "project": "https://bootimus.com/",
  "description": "A production-ready, self-contained PXE and HTTP boot server written in Go with embedded iPXE bootloaders, SQLite/PostgreSQL support, and a full-featured web admin interface. Deploy in seconds with a single binary or Docker container. There Be Dragons! This is an early-stage work-in-progress project - there may be bugs. Please raise an issue for any unexpected behaviour you encounter.",
  "paths": [
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/bootimus/data",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Isos Directory",
      "host": "/mnt/cache/isos/",
      "container": "/data/isos",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "TFTP Server Port",
      "host": "69",
      "container": "69",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Web UI",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PXE HTTP port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "BOOTIMUS_PROXY_DHCP_ENABLED",
      "key": "BOOTIMUS_PROXY_DHCP_ENABLED",
      "value": "FALSE",
      "description": "proxyDHCP coexistence",
      "required": false,
      "mask": false
    },
    {
      "name": "BOOTIMUS_WINDOWS_SMB_ENABLED",
      "key": "BOOTIMUS_WINDOWS_SMB_ENABLED",
      "value": "FALSE",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
