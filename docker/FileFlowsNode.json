{
  "name": "FileFlows-Node",
  "repo": "revenz/fileflows:stable",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/revenz/fileflows/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": "--node",
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/revenz/FileFlowsUnraid/master/icon.png?raw=true",
  "project": "https://fileflows.com/",
  "description": "Additinal processing node for FileFlows. See http://fileflows.com for more information",
  "paths": [
    {
      "name": "Temp Directory",
      "host": "/mnt/cache/temp/fileflows-node",
      "container": "/temp",
      "mode": "rw",
      "description": "Where temporary files will be created during the file flow process Best to put this on a cache drive or a faster ssd/nvme",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TimeZone",
      "key": "TZ",
      "value": "Pacific/Auckland",
      "description": "TimeZone for the container refer to https://en.wikipedia.org/wiki/List_of_tz_database_time_zones for a list of possible timezones",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "ServerUrl",
      "key": "ServerUrl",
      "value": "http://tower:5000/",
      "description": "FileFlows Server URL",
      "required": true,
      "mask": false
    },
    {
      "name": "NodeName",
      "key": "NodeName",
      "value": "DockerNode",
      "description": "A unique name to identify this Node instance",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
