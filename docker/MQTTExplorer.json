      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "INITIAL_CONFIG",
      "host": "",
      "container": "INITIAL_CONFIG",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
