{
  "name": "MQTTExplorer",
  "repo": "smeagolworms4/mqtt-explorer",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/smeagolworms4/mqtt-explorer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
