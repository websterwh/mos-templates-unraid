{
  "name": "Invoice-Ninja",
  "repo": "invoiceninja/invoiceninja-debian",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/invoiceninja/invoiceninja-debian",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9000]/",
  "icon": "https://raw.githubusercontent.com/PlazzmiK/unraid_templates/main/images/invoiceninja.png",
  "project": "https://invoiceninja.com/",
  "description": "Leading free invoice generator for freelancers and small businesses. Invoice clients, accept payments, track expenses & time billable-tasks online. Invoice Ninja is an invoicing application which makes sending invoices and receiving payments simple and easy. Our latest version is a clean slate rewrite of our popular invoicing application which builds on the existing feature set and adds a wide range of features and enhancements the community has asked for. WARNING : If IN_USER_EMAIL and IN_PASSWORD are not set the default user email and password is \"admin@example.com\" and \"changeme!\" respectively. Website: https://www.invoiceninja.org/ Source: https://github.com/invoiceninja/invoiceninja Docker: https://github.com/invoiceninja/dockerfiles",
  "paths": [
    {
      "name": "Container Path 1",
      "host": "/mnt/cache/appdata/invoiceninja_docker/public",
      "container": "/var/invoiceninja/public",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Container Path 1",
      "host": "/mnt/cache/appdata/invoiceninja_docker/storage",
      "container": "/var/invoiceninja/storage",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
