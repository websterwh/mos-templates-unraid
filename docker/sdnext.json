{
  "name": "sdnext",
  "repo": "zeitlaeufer/sdnext:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/zeitlaeufer/sdnext",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:7860]",
  "icon": "https://raw.githubusercontent.com/vladmandic/sdnext/master/html/logo-transparent.png",
  "project": "https://github.com/vladmandic/sdnext",
  "description": "Stable Diffusion Next WebUI with GPU acceleration support.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/sdnext/data",
      "container": "/sdnext/data",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Models",
      "host": "/mnt/cache/appdata/sdnext/models",
      "container": "/sdnext/models",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Output",
      "host": "/mnt/cache/appdata/sdnext/output",
      "container": "/sdnext/output",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "7860",
      "container": "7860",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
