{
  "name": "botmem",
  "repo": "ghcr.io/botmem/botmem:app-latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/botmem/botmem/pkgs/container/botmem",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped --add-host=host.docker.internal:host-gateway",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/botmem/botmem/main/unraid/botmem-icon.png",
  "project": "https://github.com/botmem/botmem",
  "description": "Botmem frontend for the self-hosted personal memory system. Requires the Botmem companion stack to run PostgreSQL, Redis, and the Botmem API. The frontend proxies API, MCP, OAuth, and WebSocket traffic to API_UPSTREAM so users still open a single WebUI URL.",
  "paths": [],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "12412",
      "container": "8080",
      "protocol": "tcp",
      "description": "Botmem web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "API Upstream",
      "key": "API_UPSTREAM",
      "value": "http://host.docker.internal:12413",
      "description": "Internal Botmem API URL. Default matches the companion compose API port.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
