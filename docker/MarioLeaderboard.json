{
  "name": "Mario-Leaderboard",
  "repo": "ghcr.io/articwone/mario-leaderboard:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://ghcr.io/articwone/mario-leaderboard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/ArticWone/Mario-Leaderboard/main/assets/favicon-192.png",
  "project": "https://github.com/ArticWone/Mario-Leaderboard",
  "description": "Docker-only Mario leaderboard site with persistent local JSON score storage.",
  "paths": [
    {
      "name": "Score Data",
      "host": "/mnt/cache/appdata/Mario-Leaderboard",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent writable score storage. The container writes scores.json here.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Http Port",
      "host": "18673",
      "container": "80",
      "protocol": "tcp",
      "description": "HTTP port for the Mario leaderboard site.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
