{
  "name": "telethon-downloader",
  "repo": "jsavargas/telethon_downloader",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/jsavargas/telethon_downloader",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/jsavargas/telethon_downloader/master/templates/UNRAID/telegram_logo.png",
  "project": "https://github.com/jsavargas/telethon_downloader",
  "description": "This is a simple container that downloads files sent to a telegram bot up to 2000mb using the Telethon library.",
  "paths": [
    {
      "name": "Path: /download",
      "host": "",
      "container": "/download",
      "mode": "rw",
      "description": "Container Path: /download",
      "required": true
    },
    {
      "name": "Path: /watch",
      "host": "",
      "container": "/watch",
      "mode": "rw",
      "description": "Container Path: /watch",
      "required": true
    },
    {
      "name": "Path: /config",
      "host": "/mnt/cache/appdata/telethon_downloader",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TG_AUTHORIZED_USER_ID",
      "key": "TG_AUTHORIZED_USER_ID",
      "value": "",
      "description": "Container Variable: TG_AUTHORIZED_USER_ID",
      "required": true,
      "mask": false
    },
    {
      "name": "TG_API_ID",
      "key": "TG_API_ID",
      "value": "",
      "description": "Container Variable: TG_API_ID",
      "required": true,
      "mask": false
    },
    {
      "name": "TG_API_HASH",
      "key": "TG_API_HASH",
      "value": "",
      "description": "Container Variable: TG_API_HASH",
      "required": true,
      "mask": false
    },
    {
      "name": "TG_BOT_TOKEN",
      "key": "TG_BOT_TOKEN",
      "value": "",
      "description": "Container Variable: TG_BOT_TOKEN",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/London",
      "description": "Container Variable: TZ",
      "required": true,
      "mask": false
    },
    {
      "name": "TG_PROGRESS_DOWNLOAD",
      "key": "TG_PROGRESS_DOWNLOAD",
      "value": "False|True",
      "description": "Container Variable: TG_PROGRESS_DOWNLOAD",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
