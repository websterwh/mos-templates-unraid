{
  "name": "idrac6",
  "repo": "domistyle/idrac6",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/domistyle/idrac6/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5800]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/idrac6.png",
  "project": "https://github.com/DomiStyle/docker-idrac6/",
  "description": "Allows access to the iDRAC 6 console without installing Java or messing with Java Web Start. Java is only run inside of the container and access is provided via web interface or directly with VNC.",
  "paths": [
    {
      "name": "Virtual media",
      "host": "/mnt/cache/appdata/idrac/vmedia",
      "container": "/vmedia",
      "mode": "rw",
      "description": "Can be used to allow virtual media to be mounted.",
      "required": false
    },
    {
      "name": "Libraries",
      "host": "/mnt/cache/appdata/idrac/app",
      "container": "/app",
      "mode": "rw",
      "description": "Libraries downloaded from your iDRAC instance will be stored here. Add a volume to cache those files for a faster container startup.",
      "required": false
    },
    {
      "name": "Screenshots",
      "host": "/mnt/cache/appdata/idrac/screenshots",
      "container": "/screenshots",
      "mode": "rw",
      "description": "Container Path: /screenshots",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5800",
      "container": "5800",
      "protocol": "tcp",
      "description": "web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "idrac host",
      "key": "IDRAC_HOST",
      "value": "",
      "description": "Host for your iDRAC instance. Make sure your instance is reachable with https://IDRAC_HOST;. See IDRAC_PORT for using custom ports. HTTPS is always used.",
      "required": true,
      "mask": false
    },
    {
      "name": "idrac user",
      "key": "IDRAC_USER",
      "value": "root",
      "description": "Username for your iDRAC instance.",
      "required": true,
      "mask": false
    },
    {
      "name": "idrac password",
      "key": "IDRAC_PASSWORD",
      "value": "calvin",
      "description": "Password for your iDRAC instance.",
      "required": true,
      "mask": true
    },
    {
      "name": "idrac port",
      "key": "IDRAC_PORT;",
      "value": "443",
      "description": "The optional port for the web interface.",
      "required": false,
      "mask": false
    },
    {
      "name": "keyboard fix",
      "key": "IDRAC_KEYCODE_HACK",
      "value": "false",
      "description": "If you have issues with keyboard input, try setting this to true.",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "USER_ID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "GROUP_ID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
