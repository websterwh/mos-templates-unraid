      "key": "TASKCAFE_DATABASE_PASSWORD",
      "value": "",
      "description": "Container Variable: TASKCAFE_DATABASE_PASSWORD",
      "required": true,
      "mask": true
    },
    {
      "name": "TASKCAFE_DATABASE_USER",
      "key": "TASKCAFE_DATABASE_USER",
      "value": "",
      "description": "Container Variable: TASKCAFE_DATABASE_USER",
