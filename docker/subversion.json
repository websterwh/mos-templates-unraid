{
  "name": "subversion",
  "repo": "elleflorio/svn-server",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/elleflorio/svn-server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/kilrah/unraid-docker-templates/raw/main/icons/subversion.png",
  "project": "https://subversion.apache.org/",
  "description": "An SVN server instance. This container may require some manual intervention in the console and/or appdata repository files regarding authentication, follow the instructions from: https://medium.com/@elle.florio/the-svn-dockerization-84032e11d88d#.bafh3otmh",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/subversion",
      "container": "/home/svn",
      "mode": "rw",
      "description": "Data directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "SVN port",
      "host": "3690",
      "container": "3690",
      "protocol": "tcp",
      "description": "Port for SVN protocol",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP port",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Port for HTTP/WebDAV protocol",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
