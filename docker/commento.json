{
  "name": "commento",
  "repo": "registry.gitlab.com/commento/commento",
  "category": [
    "Network"
  ],
  "registry": "https://gitlab.com/commento/commento",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/commento.png",
  "project": "https://commento.io",
  "description": "An open source, privacy focused discussion platform.",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "COMMENTO_ORIGIN",
      "key": "COMMENTO_ORIGIN",
      "value": "https://commento.example.com",
      "description": "Can be https://commento.example.com or http://ip:port",
      "required": true,
      "mask": false
    },
    {
      "name": "COMMENTO_POSTGRES",
      "key": "COMMENTO_POSTGRES",
      "value": "postgres://postgres:mysupersecurepassword@dbhostnameorip:5432/commento?sslmode=disable",
      "description": "PostgreSQL Change it using your info",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP HOST",
      "key": "COMMENTO_SMTP_HOST",
      "value": "example.com",
      "description": "SMTP HOST",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP PORT",
      "key": "COMMENTO_SMTP_PORT",
      "value": "587",
      "description": "SMTP PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP USERNAME",
      "key": "COMMENTO_SMTP_USERNAME",
      "value": "user@example.com",
      "description": "SMTP USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP PASSWORD",
      "key": "COMMENTO_SMTP_PASSWORD",
      "value": "smtppassword",
      "description": "SMTP PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "SMTP FROM ADDRESS",
      "key": "COMMENTO_SMTP_FROM_ADDRESS",
      "value": "fromaddress@example.com",
      "description": "SMTP FROM ADDRESS",
      "required": false,
      "mask": false
    },
    {
      "name": "COMMENTO_PORT",
      "key": "COMMENTO_PORT",
      "value": "8080",
      "description": "COMMENTO_PORT",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
