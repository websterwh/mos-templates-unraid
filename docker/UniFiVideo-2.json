{
  "name": "UniFi-Video",
  "repo": "malvarez00/docker-unifi-video",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/malvarez00/docker-unifi-video",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--cap-add=DAC_READ_SEARCH  --cap-add=NET_BIND_SERVICE --cap-add=SETGID --cap-add=SETUID --cap-add=SYS_ADMIN --cap-add=SYS_PTRACE",
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:7443]",
  "icon": "https://raw.githubusercontent.com/malvarez00/unRAID-Docker-Templates/master/malvarez00/icons/unifi_96x96.png",
  "project": null,
  "description": "bDocker-UniFi-Video/bbr / br / Port - Type (TCP/UDP) - Purposebr / 7022 - TCP - SSH (NVR Side)br / 6666 - TCP - Inbound Camera Streams (NVR Side)br / 7004 - UDP - UVC-Micro Talkback (Camera Side)br / 7080 - TCP - HTTP Web UI & API (NVR Side)br / 7442 - TCP - Camera Management (NVR Side)br / 7443 - TCP - HTTPS Web UI & API (NVR Side)br / 7445 - TCP - Video over HTTPbr / 7446 - TCP - Video over HTTPSbr / 7447 - TCP - RTSP via the controllerbr /",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/UniFi-Video/datapath",
      "container": "/var/lib/unifi-video",
      "mode": "rw",
      "description": "Container Path: /var/lib/unifi-video",
      "required": true
    },
    {
      "name": "Log Path",
      "host": "/mnt/cache/appdata/UniFi-Video/logpath",
      "container": "/var/log/unifi-video",
      "mode": "rw",
      "description": "Container Path: /var/log/unifi-video",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "SSH",
      "host": "7022",
      "container": "22",
      "protocol": "tcp",
      "description": "Container Port: 22",
      "required": true,
      "mask": false
    },
    {
      "name": "Inbound Camera Streams (NVR Side)",
      "host": "6666",
      "container": "6666",
      "protocol": "tcp",
      "description": "Container Port: 6666",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTP Web UI &amp; API (NVR Side)",
      "host": "7080",
      "container": "7080",
      "protocol": "tcp",
      "description": "Container Port: 7080",
      "required": true,
      "mask": false
    },
    {
      "name": "Camera Management (NVR Side)",
      "host": "7442",
      "container": "7442",
      "protocol": "tcp",
      "description": "Container Port: 7442",
      "required": true,
      "mask": false
    },
    {
      "name": "UVC-Micro Talkback (Camera Side)",
      "host": "7004",
      "container": "7004",
      "protocol": "udp",
      "description": "Container Port: 7004",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Web UI &amp; API (NVR Side)",
      "host": "7443",
      "container": "7443",
      "protocol": "tcp",
      "description": "Container Port: 7443",
      "required": true,
      "mask": false
    },
    {
      "name": "Video over HTTP",
      "host": "7445",
      "container": "7445",
      "protocol": "tcp",
      "description": "Container Port: 7445",
      "required": true,
      "mask": false
    },
    {
      "name": "RTSP via the controller",
      "host": "7447",
      "container": "7447",
      "protocol": "tcp",
      "description": "Container Port: 7447",
      "required": true,
      "mask": false
    },
    {
      "name": "Video over HTTPS",
      "host": "7446",
      "container": "7446",
      "protocol": "tcp",
      "description": "Container Port: 7446",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Key 1",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
