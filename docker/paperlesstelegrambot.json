{
  "name": "paperless-telegram-bot",
  "repo": "drumsergio/paperless-telegram-bot:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/drumsergio/paperless-telegram-bot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/GeiserX/docker-templates/master/drumsergio/images/paperless-telegram-bot.png",
  "project": "https://github.com/GeiserX/paperless-telegram-bot",
  "description": "Telegram bot for managing your Paperless-NGX document archive. Upload documents by sending files or photos, search your archive, tag documents, and organize your inbox \u2014 all from Telegram without accessing the web UI. Features health check endpoint, user whitelisting, and auto-detection of inbox tags. Requires a running Paperless-NGX instance and a Telegram bot token. More info: https://github.com/GeiserX/paperless-telegram-bot",
  "paths": [],
  "ports": [
    {
      "name": "Health Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Health check endpoint port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Bot Token",
      "key": "TELEGRAM_BOT_TOKEN",
      "value": "",
      "description": "Telegram bot token from @BotFather",
      "required": true,
      "mask": true
    },
    {
      "name": "Paperless URL",
      "key": "PAPERLESS_URL",
      "value": "http://paperless:8000",
      "description": "Paperless-NGX instance URL",
      "required": true,
      "mask": false
    },
    {
      "name": "Paperless Token",
      "key": "PAPERLESS_TOKEN",
      "value": "",
      "description": "Paperless-NGX API authentication token",
      "required": true,
      "mask": true
    },
    {
      "name": "Allowed Users",
      "key": "TELEGRAM_ALLOWED_USERS",
      "value": "",
      "description": "Comma-separated Telegram user IDs (empty = open access)",
      "required": false,
      "mask": false
    },
    {
      "name": "Public URL",
      "key": "PAPERLESS_PUBLIC_URL",
      "value": "",
      "description": "User-facing Paperless URL for clickable links (defaults to PAPERLESS_URL)",
      "required": false,
      "mask": false
    },
    {
      "name": "Max Results",
      "key": "MAX_SEARCH_RESULTS",
      "value": "10",
      "description": "Maximum search results to display",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
