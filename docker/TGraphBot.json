{
  "name": "TGraph-Bot",
  "repo": "ghcr.io/engels74/tgraph-bot:nightly",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/engels74/tgraph-bot/pkgs/container/tgraph-bot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tgraph-bot-icon.png",
  "project": "https://engels74.net/containers/tgraph-bot/",
  "description": "TGraph Bot is a bot for posting Tautulli graphs to a Discord channel.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/tgraph_bot/config",
      "container": "/config",
      "mode": "rw",
      "description": "Where config file will be stored",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
