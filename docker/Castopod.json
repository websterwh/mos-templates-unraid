{
  "name": "Castopod",
  "repo": "castopod/castopod:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/castopod/castopod",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/castopod-icon.png",
  "project": "https://castopod.org/",
  "description": "Castopod is a free and open-source hosting platform made for podcasters who want to engage and interact with their audience. See documentation for all available configuration options: https://docs.castopod.org/main/en/getting-started/docker/",
  "paths": [
    {
      "name": "Media Path",
      "host": "/mnt/cache/appdata/castopod/media",
      "container": "/var/www/castopod/public/media",
      "mode": "rw",
      "description": "Path to media storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "App URL",
      "key": "CP_BASEURL",
      "value": "http://localhost:8000",
      "description": "URL of Castopod. Change to IP or domain.",
      "required": true,
      "mask": false
    },
    {
      "name": "Analytics Salt",
      "key": "CP_ANALYTICS_SALT",
      "value": "",
      "description": "Salt for analytics",
      "required": true,
      "mask": true
    },
    {
      "name": "MariaDB - Host",
      "key": "CP_DATABASE_HOSTNAME",
      "value": "",
      "description": "Hostname of MariaDB",
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB - Username",
      "key": "CP_DATABASE_USERNAME",
      "value": "",
      "description": "Username for MariaDB",
      "required": true,
      "mask": false
    },
    {
      "name": "MariaDB - Password",
      "key": "CP_DATABASE_PASSWORD",
      "value": "",
      "description": "Password for MariaDB",
      "required": true,
      "mask": true
    },
    {
      "name": "MariaDB - Database",
      "key": "CP_DATABASE_NAME",
      "value": "",
      "description": "Name of MariaDB database",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis - Host",
      "key": "CP_REDIS_HOST",
      "value": "",
      "description": "Hostname of Redis",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis - Port",
      "key": "CP_REDIS_PORT",
      "value": "6379",
      "description": "Port of Redis",
      "required": true,
      "mask": false
    },
    {
      "name": "Redis - Password",
      "key": "CP_REDIS_PASSWORD",
      "value": "",
      "description": "Password for Redis",
      "required": true,
      "mask": true
    },
    {
      "name": "Redis - Database",
      "key": "CP_REDIS_DATABASE",
      "value": "0",
      "description": "Database number for Redis",
      "required": true,
      "mask": false
    },
    {
      "name": "Cache Handler",
      "key": "CP_CACHE_HANDLER",
      "value": "redis|file",
      "description": "Cache handler to use",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
