{
  "name": "postgresql18",
  "repo": "postgres:18",
  "category": [
    "Network"
  ],
  "registry": "https://registry.hub.docker.com/_/postgres/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5432]",
  "icon": "https://github.com/juusujanar/unraid-templates/raw/master/img/PostgreSQL-logo.png",
  "project": "https://www.postgresql.org/",
  "description": "PostgreSQL 18 is a powerful, open source object-relational database system. Uses official Postgres Docker image @ https://hub.docker.com/_/postgres/ Configuration /mnt/cache/appdata/postgresql18 This is where Postgres will store it's data. For best performance, keep the files on cache drive. Port 5432 Default connection port POSTGRES_PASSWORD Superuser password. REQUIRED TO SET , otherwise connecting outside container will not be possible. POSTGRES_USER Username for the superuser. Defaults to postgres if not set. POSTGRES_DB Used to define different name for default database. Defaults to user if not set.",
  "paths": [
    {
      "name": "Database Storage Path",
      "host": "/mnt/cache/appdata/postgresql18",
      "container": "/var/lib/postgresql",
      "mode": "rw",
      "description": "PostgreSQL data storage location",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "PostgreSQL access port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "PostgreSQL TCP connection port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "",
      "description": "Initial superuser password (required)",
      "required": true,
      "mask": true
    },
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "",
      "description": "Initial superuser name (default: postgres)",
      "required": false,
      "mask": false
    },
    {
      "name": "POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "",
      "description": "Initial database name (default: postgres)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
