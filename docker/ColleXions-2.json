{
  "name": "ColleXions",
  "repo": "jl94x4/collexionsui:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jl94x4/collexionsui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/jl94x4/ColleXions-WebUI/main/assets/logo.png",
  "project": "https://github.com/jl94x4/ColleXions-WebUI",
  "description": "ColleXions is a powerful web interface designed to automate and manage your Plex collections. It can rotate pinned collections, sync with TMDB/Trakt/MdbList, and create new collections through a beautiful UI.",
  "paths": [
    {
      "name": "Appdata Config",
      "host": "/mnt/cache/appdata/collexions/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to store configuration files.",
      "required": true
    },
    {
      "name": "Appdata Logs",
      "host": "/mnt/cache/appdata/collexions/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Path to store application logs.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "The port for the ColleXions Web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "COLLEXIONS_SECRET_KEY",
      "value": "change_this_to_something_random",
      "description": "A secret key used for security and JWT tokens.",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
