{
  "name": "Huly---Rekoni",
  "repo": "hardcoreeng/rekoni-service:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/hardcoreeng/rekoni-service",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4004]",
