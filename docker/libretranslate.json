{
  "name": "libretranslate",
  "repo": "libretranslate/libretranslate",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/libretranslate/libretranslate",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://github.com/kilrah/unraid-docker-templates/raw/main/icons/libretranslate.png",
  "project": "https://github.com/LibreTranslate/LibreTranslate",
  "description": "Free and Open Source Machine Translation API, entirely self-hosted. You will need to create a \"cache\" and a \"share\" folder manually in the specified appdata folder manually before the container will run. First start takes a while as models are being downloaded.",
  "paths": [
    {
      "name": "Model storage",
      "host": "/mnt/cache/appdata/libretranslate",
      "container": "/home/libretranslate/.local",
      "mode": "rw",
      "description": "Where models are downloaded, about 10GB needed",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
