{
  "name": "stuckless-sagetv-server-java7",
  "repo": "stuckless/sagetv-server-java7",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/stuckless/sagetv-server-java7/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/OpenSageTV/sagetv-miniclient/master/playstore/ic_launcher-web.png",
  "project": null,
  "description": "SageTV is an Open Source PVR and Media Player",
  "paths": [
    {
      "name": "Path 1",
      "host": "/mnt/cache/appdata/sagetv/",
      "container": "/opt/sagetv",
      "mode": "rw",
      "description": "SageTV base directory",
      "required": true
    },
    {
      "name": "Path 2",
      "host": "/mnt/cache/sagemedia/",
      "container": "/var/media",
      "mode": "rw",
      "description": "SageTV Media Directory (for recordings, etc)",
      "required": true
    },
    {
      "name": "Path 3",
      "host": "/mnt/cache/media/videos/",
      "container": "/var/mediaext",
      "mode": "rw",
      "description": "SageTV videos directory for other imported video files",
      "required": true
    },
    {
      "name": "unRAID Share Path",
      "host": "/mnt/user",
      "container": "/unraid",
      "mode": "rw",
      "description": "Container Path: /unraid",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "SageTV WebServer Port 8080",
      "required": true,
      "mask": false
    },
    {
      "name": "Port 2",
      "host": "42024",
      "container": "42024",
      "protocol": "tcp",
      "description": "Container Port: 42024",
      "required": true,
      "mask": false
    },
    {
      "name": "Port 3",
      "host": "7818",
      "container": "7818",
      "protocol": "tcp",
      "description": "Container Port: 7818",
      "required": true,
      "mask": false
    },
    {
      "name": "Port 4",
      "host": "8270",
      "container": "8270",
      "protocol": "udp",
      "description": "Container Port: 8270",
      "required": true,
      "mask": false
    },
    {
      "name": "Port 5",
      "host": "31100",
      "container": "31100",
      "protocol": "udp",
      "description": "Container Port: 31100",
      "required": true,
      "mask": false
    },
    {
      "name": "Port 6",
      "host": "31099",
      "container": "31099",
      "protocol": "tcp",
      "description": "Container Port: 31099",
      "required": true,
      "mask": false
    },
    {
      "name": "Port 7",
      "host": "16867",
      "container": "16867",
      "protocol": "udp",
      "description": "Container Port: 16867",
      "required": true,
      "mask": false
    },
    {
      "name": "Port 8",
      "host": "16869",
      "container": "16869",
      "protocol": "udp",
      "description": "Container Port: 16869",
      "required": true,
      "mask": false
    },
    {
      "name": "Port 9",
      "host": "16881",
      "container": "16881",
      "protocol": "tcp",
      "description": "Container Port: 16881",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Variable 1",
      "key": "VERSION",
      "value": "latest",
      "description": "SageTV Version",
      "required": true,
      "mask": false
    },
    {
      "name": "Variable 2",
      "key": "JAVA_MEM_MB",
      "value": "768",
      "description": "Java Memory in MB",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable 3",
      "key": "LICENCE_DATA",
      "value": "",
      "description": "SageTV License Key",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable 4",
      "key": "OPT_GENTUNER",
      "value": "Y",
      "description": "Install Gentuner Plugin",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable 5",
      "key": "OPT_COMMANDIR",
      "value": "N",
      "description": "Install CommandIR files",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable 6",
      "key": "OPT_COMSKIP",
      "value": "Y",
      "description": "Install native comskip files",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable 7",
      "key": "OPT_SETPERMS",
      "value": "Y",
      "description": "Set permissions on startup",
      "required": false,
      "mask": false
    },
    {
      "name": "Variable 8",
      "key": "OPT_LIRC",
      "value": "N",
      "description": "Enable LIRC Daemon with Configuration from SageTV lirc.d Directory",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
