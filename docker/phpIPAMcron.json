{
  "name": "phpIPAM-cron",
  "repo": "phpipam/phpipam-cron",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/phpipam/phpipam-cron",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://phpipam.net/css/images/logo_icon.png",
  "project": "https://phpipam.net/",
  "description": "phpIPAM - Open source IP address management.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "IPAM_DATABASE_HOST",
      "key": "IPAM_DATABASE_HOST",
      "value": "127.0.0.1",
      "description": "MySQL database host (Default: 127.0.0.1)",
      "required": true,
      "mask": false
    },
    {
      "name": "IPAM_DATABASE_PORT",
      "key": "IPAM_DATABASE_PORT",
      "value": "3306",
      "description": "MySQL database port (Default: 3306)",
      "required": true,
      "mask": false
    },
    {
      "name": "IPAM_DATABASE_NAME",
      "key": "IPAM_DATABASE_NAME",
      "value": "phpipam",
      "description": "MySQL database name (Default: phpipam)",
      "required": true,
      "mask": false
    },
    {
      "name": "IPAM_DATABASE_USER",
      "key": "IPAM_DATABASE_USER",
      "value": "phpipam",
      "description": "MySQL database user (Default: phpipam)",
      "required": true,
      "mask": false
    },
    {
      "name": "IPAM_DATABASE_PASS",
      "key": "IPAM_DATABASE_PASS",
      "value": "phpipamadmin",
      "description": "MySQL database password (Default: phpipamadmin)",
      "required": true,
      "mask": true
    },
    {
      "name": "SCAN_INTERVAL",
      "key": "SCAN_INTERVAL",
      "value": "1h",
      "description": "Network discovery job interval = 5m,10m,15m,30m,1h,2h,4h,6h,12h (default: 1h) [CRON Container only]",
      "required": true,
      "mask": false
    },
    {
      "name": "IPAM_DATABASE_WEBHOST",
      "key": "IPAM_DATABASE_WEBHOST",
      "value": "localhost",
      "description": "MySQL allowed hosts (Default: localhost)",
      "required": false,
      "mask": false
    },
    {
      "name": "IPAM_GMAPS_API_KEY",
      "key": "IPAM_GMAPS_API_KEY",
      "value": "",
      "description": "Google Maps and Geocode API Key",
      "required": false,
      "mask": false
    },
    {
      "name": "PROXY_ENABLED",
      "key": "PROXY_ENABLED",
      "value": "false",
      "description": "Use proxy (Default: false)",
      "required": false,
      "mask": false
    },
    {
      "name": "PROXY_SERVER",
      "key": "PROXY_SERVER",
      "value": "myproxy.something.com",
      "description": "Proxy server (Default: myproxy.something.com)",
      "required": false,
      "mask": false
    },
    {
      "name": "PROXY_PORT",
      "key": "PROXY_PORT",
      "value": "8080",
      "description": "Proxy port (Default: 8080)",
      "required": false,
      "mask": false
    },
    {
      "name": "PROXY_USE_AUTH",
      "key": "PROXY_USE_AUTH",
      "value": "false",
      "description": "Proxy authentication (Default: false)",
      "required": false,
      "mask": false
    },
    {
      "name": "PROXY_USER",
      "key": "PROXY_USER",
      "value": "USERNAME",
      "description": "Proxy username",
      "required": false,
      "mask": false
    },
    {
      "name": "PROXY_PASS",
      "key": "PROXY_PASS",
      "value": "PASSWORD",
      "description": "Proxy password",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
