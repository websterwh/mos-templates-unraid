{
  "name": "ftpgrab",
  "repo": "crazymax/ftpgrab:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/crazymax/ftpgrab/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/ftpgrab.png",
  "project": "https://crazymax.dev/ftpgrab/",
  "description": "Grab your files periodically from a remote FTP or SFTP server easily",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/ftpgrab/db/",
      "container": "/db",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Download Path",
      "host": "",
      "container": "/download",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "FTPGRAB_SERVER_FTP_HOST",
      "key": "FTPGRAB_SERVER_FTP_HOST",
      "value": "test.rebex.net",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "FTPGRAB_SERVER_FTP_PORT",
      "key": "FTPGRAB_SERVER_FTP_PORT",
      "value": "21",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_SERVER_FTP_USERNAME",
      "key": "FTPGRAB_SERVER_FTP_USERNAME",
      "value": "anonymous",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "FTPGRAB_SERVER_FTP_PASSWORD",
      "key": "FTPGRAB_SERVER_FTP_PASSWORD",
      "value": "",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_SERVER_FTP_SOURCES",
      "key": "FTPGRAB_SERVER_FTP_SOURCES",
      "value": "/",
      "description": "can be /sub1,/sub2",
      "required": false,
      "mask": false
    },
    {
      "name": "SCHEDULE",
      "key": "SCHEDULE",
      "value": "*/30 * * * *",
      "description": "Cron https://crontab.guru/",
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_DOWNLOAD_INCLUDE",
      "key": "FTPGRAB_DOWNLOAD_INCLUDE",
      "value": "",
      "description": "For example ^Mr\\.Robot\\.S04.+(VOSTFR|SUBFRENCH).+(720p).+(HDTV|WEB-DL|WEBRip).+",
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_DOWNLOAD_EXCLUDE",
      "key": "FTPGRAB_DOWNLOAD_EXCLUDE",
      "value": "",
      "description": "For example \\.nfo\\$",
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_DOWNLOAD_SINCE",
      "key": "FTPGRAB_DOWNLOAD_SINCE",
      "value": "",
      "description": "For example 2019-02-01T18:50:05Z",
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_DOWNLOAD_RETRY",
      "key": "FTPGRAB_DOWNLOAD_RETRY",
      "value": "5",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_NOTIF_MAIL_HOST",
      "key": "FTPGRAB_NOTIF_MAIL_HOST",
      "value": "smtp.example.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_NOTIF_MAIL_PORT",
      "key": "FTPGRAB_NOTIF_MAIL_PORT",
      "value": "25",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_NOTIF_MAIL_FROM",
      "key": "FTPGRAB_NOTIF_MAIL_FROM",
      "value": "ftpgrab@example.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_NOTIF_MAIL_TO",
      "key": "FTPGRAB_NOTIF_MAIL_TO",
      "value": "webmaster@example.com",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_DOWNLOAD_UID",
      "key": "FTPGRAB_DOWNLOAD_UID",
      "value": "99",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "FTPGRAB_DOWNLOAD_GID",
      "key": "FTPGRAB_DOWNLOAD_GID",
      "value": "100",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_LEVEL",
      "key": "LOG_LEVEL",
      "value": "info",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "LOG_JSON",
      "key": "LOG_JSON",
      "value": "false",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
