{
  "name": "dockhand",
  "repo": "fnsys/dockhand:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/Finsys/dockhand",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/tajniak81/unraid-docker-templates/refs/heads/main/dockhand/icon/dockhand.png",
  "project": "https://github.com/Finsys/dockhand",
  "description": "Modern Docker management for everyone. A powerful, intuitive Docker platform. Free for homelabs, ready for enterprise. SQLite by default, zero telemetry, free forever. Self-host everything without the complexity. https://dockhand.pro/ https://dockhand.pro/manual/#introduction https://github.com/Finsys/dockhand",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/dockhand",
      "container": "/app/data",
      "mode": "rw",
      "description": "Persistent data folder",
      "required": true
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker socket (required)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Dockhand WebUI",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
