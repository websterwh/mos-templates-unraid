{
  "name": "OpenEats",
  "repo": "bramblegb/openeats",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/bramblegb/openeats/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/openeats.png",
  "project": "https://github.com/open-eats/OpenEats",
  "description": "OpenEats is a recipe management site that allows users to create, share, and store their personal collection of recipes. Requires MariaDB container (I recommend LinuxServer's container) FIRST RUN: Please wait while the container creats all the necessary tables in the SQL database. This can take 5-10 minutes or so and the container will have NO log output when it does this. Please be patient, if you interrupt this by stopping the container it will leave you with a broken database! Please use support link for more information about this container.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/openeats/",
      "container": "/code/site-media/",
      "mode": "rw",
      "description": "Container Path: /code/site-media/",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "8760",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "OPENEATS_VERSION",
      "key": "OPENEATS_VERSION",
      "value": "master",
      "description": "Version of OpenEats to pull",
      "required": true,
      "mask": false
    },
    {
      "name": "ALLOWED_HOST",
      "key": "ALLOWED_HOST",
      "value": "*",
      "description": "Either * (all) or local IP, openeatas.domain.com",
      "required": true,
      "mask": false
    },
    {
      "name": "SUPERUSER_NAME",
      "key": "SUPERUSER_NAME",
      "value": "openeats",
      "description": "Initial superuser account name",
      "required": true,
      "mask": false
    },
    {
      "name": "SUPERUSER_PASSWORD",
      "key": "SUPERUSER_PASSWORD",
      "value": "password",
      "description": "Initial superuser account password",
      "required": true,
      "mask": true
    },
    {
      "name": "MYSQL_HOST",
      "key": "MYSQL_HOST",
      "value": "",
      "description": "SQL server host address",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_PORT",
      "key": "MYSQL_PORT",
      "value": "3306",
      "description": "SQL server port number",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_DATABASE",
      "key": "MYSQL_DATABASE",
      "value": "openeats",
      "description": "SQL server database to connect to",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_USER",
      "key": "MYSQL_USER",
      "value": "",
      "description": "SQL server user",
      "required": true,
      "mask": false
    },
    {
      "name": "MYSQL_ROOT_PASSWORD",
      "key": "MYSQL_ROOT_PASSWORD",
      "value": "",
      "description": "SQL server password",
      "required": true,
      "mask": true
    },
    {
      "name": "DJANGO_SECRET_KEY",
      "key": "DJANGO_SECRET_KEY",
      "value": "",
      "description": "Enter a randomized set of 32 characters here",
      "required": true,
      "mask": true
    },
    {
      "name": "DJANGO_DEBUG",
      "key": "DJANGO_DEBUG",
      "value": "False",
      "description": "Set debug mode",
      "required": true,
      "mask": false
    },
    {
      "name": "NODE_LOCALE",
      "key": "NODE_LOCALE",
      "value": "en",
      "description": "English: en German: de Spanish: es French: fr",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
