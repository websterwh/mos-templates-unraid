{
  "name": "Drone-Runner",
  "repo": "drone/drone-runner-docker",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/drone/drone-runner-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--volume=/var/run/docker.sock:/var/run/docker.sock --restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/drone.png",
  "project": "https://github.com/drone-runners/drone-runner-docker",
  "description": "Drone is a Continuous Integration platform built on Docker",
  "paths": [],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Host",
      "key": "DRONE_RPC_HOST",
      "value": "drone.example.com",
      "description": "Container Variable: DRONE_RPC_HOST",
      "required": true,
      "mask": false
    },
    {
      "name": "Protocol",
      "key": "DRONE_RPC_PROTO",
      "value": "https",
      "description": "Container Variable: DRONE_RPC_PROTO",
      "required": true,
      "mask": false
    },
    {
      "name": "Shared Secret",
      "key": "DRONE_RPC_SECRET",
      "value": "",
      "description": "Container Variable: DRONE_RPC_SECRET",
      "required": true,
      "mask": true
    }
  ],
  "devices": [],
  "labels": []
}
