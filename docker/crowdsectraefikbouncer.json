{
  "name": "crowdsec-traefik-bouncer",
  "repo": "fbonalair/traefik-crowdsec-bouncer",
  "category": [
    "Security"
  ],
  "registry": "https://registry.hub.docker.com/r/fbonalair/traefik-crowdsec-bouncer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/ibracorp/app-logos/main/crowdsec/crowdsec.png",
  "project": "https://github.com/fbonalair/traefik-crowdsec-bouncer",
  "description": "CrowdSec bouncer for Traefik to block malicious IPs from accessing your services. This utilizes Traefik v2 ForwardAuth Middleware and queries CrowdSec with the client IP. If the client IP is on the ban list, Traefik will issue a HTTP code 403 response. Otherwise, the request will continue as usual. Be sure to install CrowdSec first. See our instructions on CrowdSec here: https://docs.ibracorp.io",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "CROWDSEC_BOUNCER_API_KEY",
      "key": "CROWDSEC_BOUNCER_API_KEY",
      "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "description": "Container Variable: CROWDSEC_BOUNCER_API_KEY",
      "required": false,
      "mask": false
    },
    {
      "name": "GIN_MODE",
      "key": "GIN_MODE",
      "value": "release",
      "description": "Container Variable: GIN_MODE",
      "required": false,
      "mask": false
    },
    {
      "name": "CROWDSEC_AGENT_HOST",
      "key": "CROWDSEC_AGENT_HOST",
      "value": "192.168.0.10:8081",
      "description": "Container Variable: CROWDSEC_AGENT_HOST",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
