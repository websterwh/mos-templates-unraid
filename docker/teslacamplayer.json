{
  "name": "teslacamplayer",
  "repo": "ghcr.io/imagegenius/teslacamplayer",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/imagegenius/packages/container/package/teslacamplayer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/imagegenius/templates/main/unraid/img/default.png",
  "project": "https://github.com/hydazz/TeslaCamPlayer",
  "description": "A Blazor WASM application for easily viewing locally stored Tesla sentry and dashcam videos.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Appdata Path",
      "required": true
    },
    {
      "name": "Path: /media",
      "host": "",
      "container": "/media",
      "mode": "rw",
      "description": "Path to your 'TeslaCAM' folder",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "UID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "GID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "UMASK for newly created files. Do not change unless you know what you're doing.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
