{
  "name": "IPTVnator---Frontend",
  "repo": "4gray/iptvnator:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/4gray/iptvnator",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/4gray/iptvnator/electron/src/assets/icons/favicon.256x256.png",
  "project": "https://iptvnator.vercel.app/",
  "description": "A video player application that provides support for IPTV playlist playback (m3u, m3u8). This is the frontend component.",
  "paths": [],
  "ports": [
    {
      "name": "Communication Port",
      "host": "4333",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Backend URL",
      "key": "BACKEND_URL",
      "value": "http://localhost:7333",
      "description": "URL of the backend component",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
