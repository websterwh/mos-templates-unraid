{
  "name": "Budibase",
  "repo": "budibase/budibase",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/budibase/budibase/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/PlazzmiK/unraid_templates/main/images/budibase.png",
  "project": "https://budibase.com/",
  "description": "Budibase AIO Docker, for use as a single image which provides all necessary services.",
  "paths": [
    {
      "name": "Data - Main",
      "host": "/mnt/cache/appdata/budibase/data/",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "Data - CouchDB",
      "host": "/mnt/cache/appdata/budibase/couchdb_data/",
      "container": "/opt/couchdb/data",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "HTTPS",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MINIO_ACCESS_KEY",
      "key": "MINIO_ACCESS_KEY",
      "value": "CHANGE_ME_PLEASE",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "MINIO_SECRET_KEY",
      "key": "MINIO_SECRET_KEY",
      "value": "CHANGE_ME_PLEASE",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "REDIS_PASSWORD",
      "key": "REDIS_PASSWORD",
      "value": "CHANGE_ME_PLEASE",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "INTERNAL_API_KEY",
      "key": "INTERNAL_API_KEY",
      "value": "CHANGE_ME_PLEASE",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "JWT_SECRET",
      "key": "JWT_SECRET",
      "value": "CHANGE_ME_PLEASE",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "CUSTOM_DOMAIN",
      "key": "CUSTOM_DOMAIN",
      "value": "",
      "description": "Fill in your domain name to use a personal domain. https://www.example.com/",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
