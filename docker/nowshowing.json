{
  "name": "nowshowing",
  "repo": "ninthwalker/nowshowing",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/ninthwalker/nowshowing/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6878]",
  "icon": "https://raw.githubusercontent.com/ninthwalker/NowShowing/master/images/nowshowing-icon.png",
  "project": "https://github.com/ninthwalker/NowShowing",
  "description": "Please use the new NowShowing v2 app (also found here in Community Apps). This version is no longer being updated or supported. Thanks!",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/cache/appdata/NowShowing",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Host Port",
      "host": "6878",
      "container": "6878",
      "protocol": "tcp",
      "description": "Container Port: 6878",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PLEX SERVER IP",
      "key": "PLEX_SERVER_IP",
      "value": "",
      "description": "PLEX_SERVER_IP",
      "required": true,
      "mask": false
    },
    {
      "name": "PLEX USERNAME",
      "key": "PLEX_USERNAME",
      "value": "",
      "description": "PLEX_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "PLEX PASSWORD",
      "key": "PLEX_PASSWORD",
      "value": "",
      "description": "PLEX_PASSWORD",
      "required": false,
      "mask": true
    },
    {
      "name": "SMTP SERVER",
      "key": "SMTP_SERVER",
      "value": "",
      "description": "SMTP_SERVER",
      "required": true,
      "mask": false
    },
    {
      "name": "SMTP PORT",
      "key": "SMTP_PORT",
      "value": "",
      "description": "SMTP_PORT (Use 587 for Gmail)",
      "required": true,
      "mask": false
    },
    {
      "name": "EMAIL USERNAME",
      "key": "EMAIL_USERNAME",
      "value": "",
      "description": "EMAIL_USERNAME",
      "required": true,
      "mask": false
    },
    {
      "name": "EMAIL PASSWORD",
      "key": "EMAIL_PASSWORD",
      "value": "",
      "description": "EMAIL_PASSWORD",
      "required": true,
      "mask": true
    },
    {
      "name": "PLEX TOKEN",
      "key": "PLEX_TOKEN",
      "value": "",
      "description": "PLEX_TOKEN (Optional - use if you don't want to enter Plex username/password)",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Optional PUID - Usually do not change this. See instructions",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Optional PGID - Usually do not change this. See instructions",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
