{
  "name": "focalboard",
  "repo": "mattermost/focalboard",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/mattermost/focalboard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/focalboard.png",
  "project": "https://github.com/mattermost/focalboard",
  "description": "Focalboard is an open source, self-hosted alternative to Trello, Notion, and Asana.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/opt/focalboard/data",
      "mode": "rw",
      "description": "Container Path: /opt/focalboard/data",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
