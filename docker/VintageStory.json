{
  "name": "Vintage-Story",
  "repo": "gitea.fithwum.tech/fithwum/vintage-story:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/fithwum/vintage-story/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://gitea.fithwum.tech/fithwum/files-for-dockers/raw/branch/master/icons/vintage-story.png",
  "project": "https://www.vintagestory.at",
  "description": "This docker will run a Vintage-Story server.",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/Games/Servers/vintage-story-server",
      "container": "/VSserver/server",
      "mode": "rw",
      "description": "Appdata path",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Vintage Story Release Channel",
      "key": "VS_CHANNEL",
      "value": "stable|unstable",
      "description": "Select which release channel you want to use.",
      "required": true,
      "mask": false
    },
    {
      "name": "vintage-story Version",
      "key": "VS_VERSION",
      "value": "1.21.5",
      "description": "Pick your vintage-story version.",
      "required": true,
      "mask": false
    },
    {
      "name": "Dotnet Version",
      "key": "DOTNET_VERSION",
      "value": "8.0|9.0|10.0",
      "description": "Select Dotnet version.",
      "required": true,
      "mask": false
    },
    {
      "name": "Key 2",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Key 3",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
