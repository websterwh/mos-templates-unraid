{
  "name": "Minecraft",
  "repo": "gitea.fithwum.tech/fithwum/minecraft:minecraft",
  "category": [
    "Game Server"
  ],
  "registry": "https://gitea.fithwum.tech/fithwum/minecraft/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://gitea.fithwum.tech/fithwum/files-for-dockers/raw/branch/master/icons/minecraft.png",
  "project": "https://www.minecraft.net/",
  "description": "This docker can run a Minecraft vanilla/bukkit/forge/neoforged/fabric/quilt(your choice) server on openjdk21 or 25(your choice). UPDATE: This container can now auto update vanilla on restart if you leave the version blank.",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/minecraft-server",
      "container": "/mcserver",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Minecraft Type",
      "key": "MC_TYPE",
      "value": "vanilla|bukkit|fabric|quilt|forge|neoforged",
      "description": "Select your Minecraft type",
      "required": true,
      "mask": false
    },
    {
      "name": "Minecraft Version",
      "key": "MC_VERSION",
      "value": "",
      "description": "Pick your Minecraft version (if vanilla selected this can be left blank for auto update on restart).",
      "required": true,
      "mask": false
    },
    {
      "name": "forge version",
      "key": "FORGE_VERSION",
      "value": "",
      "description": "Set you forge version. (remove if not using)",
      "required": false,
      "mask": false
    },
    {
      "name": "neoforged version",
      "key": "NEOFORGED_VERSION",
      "value": "",
      "description": "Set you neoforged version. (remove if not using)",
      "required": false,
      "mask": false
    },
    {
      "name": "fabric version",
      "key": "FABRIC_VERSION",
      "value": "",
      "description": "Set you fabric version. (remove if not using)",
      "required": false,
      "mask": false
    },
    {
      "name": "installer version",
      "key": "FABRIC_INSTALLER_VERSION",
      "value": "",
      "description": "Set you fabric installer version. (remove if not using)",
      "required": false,
      "mask": false
    },
    {
      "name": "quilt version",
      "key": "QUILT_VERSION",
      "value": "",
      "description": "Set you Quilt version. (remove if not using)",
      "required": false,
      "mask": false
    },
    {
      "name": "Minecraft Port",
      "key": "GAME_PORT",
      "value": "25565",
      "description": "Set game port (default: 25565).",
      "required": true,
      "mask": false
    },
    {
      "name": "Accept EULA",
      "key": "ACCEPT_EULA",
      "value": "false|true",
      "description": "Head over to: https://account.mojang.com/documents/minecraft_eula to read the EULA. (If you accept the EULA change the value to 'true' without quotes).",
      "required": true,
      "mask": false
    },
    {
      "name": "Java Version",
      "key": "JAVA_VERSION",
      "value": "openjdk-21-jre|openjdk-25-jre",
      "description": "Select your Java version.",
      "required": true,
      "mask": false
    },
    {
      "name": "Java Xmx size",
      "key": "XMX_SIZE",
      "value": "4G",
      "description": "Set java MAX memory.",
      "required": true,
      "mask": false
    },
    {
      "name": "Java Xms size",
      "key": "XMS_SIZE",
      "value": "2G",
      "description": "Set java memory.",
      "required": true,
      "mask": false
    },
    {
      "name": "Java Xmn size",
      "key": "XMN_SIZE",
      "value": "1G",
      "description": "Set java MIN memory.",
      "required": true,
      "mask": false
    },
    {
      "name": "RCON Enable",
      "key": "ENABLE_RCON",
      "value": "true|false",
      "description": "enable RCON?",
      "required": false,
      "mask": false
    },
    {
      "name": "RCON Port",
      "key": "RCON_PORT",
      "value": "25575",
      "description": "Set RCON port.",
      "required": false,
      "mask": false
    },
    {
      "name": "RCON Password",
      "key": "RCON_PASSWORD",
      "value": "dockerAdmin",
      "description": "Set RCON password",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
