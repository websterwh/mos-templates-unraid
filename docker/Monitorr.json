{
  "name": "Monitorr",
  "repo": "monitorr/monitorr",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/monitorr/monitorr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/monitorr.png",
  "project": "https://github.com/Monitorr/Monitorr/",
  "description": "Monitorr is a webfront to live display the status of any webapp or service See full configuration instructions in the WiKi: https://github.com/Monitorr/Monitorr/wiki Configuration 8700 Port for Monitorr's webui /app Location for storing configuration files",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/Monitorr",
      "container": "/app",
      "mode": "rw",
      "description": "Container Path: /app",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
