      "name": "HTTP",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Webserver - Http",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "Webserver - Https",
      "required": true,
