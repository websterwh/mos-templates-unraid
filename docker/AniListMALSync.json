{
  "name": "AniList-MAL-Sync",
  "repo": "ghcr.io/tareku99/anilist-mal-sync:latest",
  "category": [
    "System"
  ],
  "registry": "https://github.com/Tareku99/anilist-mal-sync/pkgs/container/anilist-mal-sync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:23080]",
  "icon": "https://raw.githubusercontent.com/Tareku99/anilist-mal-sync/main/src/anilist_mal_sync/assets/icon.png",
  "project": "https://github.com/Tareku99/anilist-mal-sync",
  "description": "Bidirectional sync service between AniList and MyAnimeList with OAuth authentication, conflict resolution, and Docker deployment.",
  "paths": [
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/anilist-mal-sync",
      "container": "/app/data",
      "mode": "rw",
      "description": "Contains config.yaml and tokens.json",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "OAuth Port",
      "host": "18080",
      "container": "18080",
      "protocol": "tcp",
      "description": "OAuth callback port for authentication",
      "required": true,
      "mask": false
    },
    {
      "name": "Web UI Port",
      "host": "23080",
      "container": "23080",
      "protocol": "tcp",
      "description": "Web UI dashboard port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Boise",
      "description": "Container timezone (e.g., America/New_York, Europe/London, Asia/Tokyo)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
