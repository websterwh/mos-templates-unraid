{
  "name": "unifi-controller",
  "repo": "lscr.io/linuxserver/unifi-controller",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/unifi-controller",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "https://[IP]:[PORT:8443]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/unifi-controller-logo.png",
  "project": "https://www.ubnt.com/enterprise/#unifi",
  "description": "The Unifi-controller(https://www.ubnt.com/enterprise/#unifi) software is a powerful, enterprise wireless software engine ideal for high-density client deployments requiring low latency and high uptime performance.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "All Unifi data stored here",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "Unifi web admin port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 3478",
      "host": "3478",
      "container": "3478",
      "protocol": "udp",
      "description": "Unifi STUN port",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 10001",
      "host": "10001",
      "container": "10001",
      "protocol": "udp",
      "description": "Required for AP discovery",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 8080",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Required for device communication",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 1900",
      "host": "1900",
      "container": "1900",
      "protocol": "udp",
      "description": "Required for `Make controller discoverable on L2 network` option",
      "required": false,
      "mask": false
    },
    {
      "name": "Port: 8843",
      "host": "8843",
      "container": "8843",
      "protocol": "tcp",
      "description": "Unifi guest portal HTTPS redirect port",
      "required": false,
      "mask": false
    },
    {
      "name": "Port: 8880",
      "host": "8880",
      "container": "8880",
      "protocol": "tcp",
      "description": "Unifi guest portal HTTP redirect port",
      "required": false,
      "mask": false
    },
    {
      "name": "Port: 6789",
      "host": "6789",
      "container": "6789",
      "protocol": "tcp",
      "description": "For mobile throughput test",
      "required": false,
      "mask": false
    },
    {
      "name": "Port: 5514",
      "host": "5514",
      "container": "5514",
      "protocol": "udp",
      "description": "Remote syslog port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "MEM_LIMIT",
      "key": "MEM_LIMIT",
      "value": "1024",
      "description": "Optionally change the Java memory limit (in Megabytes). Set to `default` to reset to default",
      "required": false,
      "mask": false
    },
    {
      "name": "MEM_STARTUP",
      "key": "MEM_STARTUP",
      "value": "1024",
      "description": "Optionally change the Java initial/minimum memory (in Megabytes). Set to `default` to reset to default",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
