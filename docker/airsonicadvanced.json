{
  "name": "airsonic-advanced",
  "repo": "airsonicadvanced/airsonic-advanced:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/airsonicadvanced/airsonic-advanced/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:4040]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/airsonic-advanced.png",
  "project": "https://github.com/airsonic-advanced/airsonic-advanced",
  "description": "Airsonic-Advanced is a more modern implementation of the Airsonic fork with several key performance and feature enhancements. It adds and supersedes several features in Airsonic.",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/airsonic-advanced/",
      "container": "/var/airsonic",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    },
    {
      "name": "Music Path",
      "host": "",
      "container": "/var/music",
      "mode": "rw",
      "description": "Music Path",
      "required": true
    },
    {
      "name": "Podcast Path",
      "host": "",
      "container": "/var/podcasts",
      "mode": "rw",
      "description": "Podcast Path",
      "required": true
    },
    {
      "name": "Playlist Path",
      "host": "",
      "container": "/var/playlists",
      "mode": "rw",
      "description": "Playlist Path",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "4040",
      "container": "4040",
      "protocol": "tcp",
      "description": "HTTP",
      "required": true,
      "mask": false
    },
    {
      "name": "UPNP_PORT",
      "host": "4041",
      "container": "4041",
      "protocol": "tcp",
      "description": "UPNP_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "Default DLNA/UPnP ports",
      "host": "1900",
      "container": "1900",
      "protocol": "udp",
      "description": "Default DLNA/UPnP ports",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "CONTEXT_PATH",
      "key": "CONTEXT_PATH",
      "value": "/",
      "description": "CONTEXT_PATH",
      "required": true,
      "mask": false
    },
    {
      "name": "JAVA_OPTS",
      "key": "JAVA_OPTS",
      "value": "-Xms256m -Xmx512m",
      "description": "JAVA_OPTS",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
