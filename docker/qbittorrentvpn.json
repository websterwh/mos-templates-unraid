{
  "name": "qbittorrentvpn",
  "repo": "markusmcnugen/qbittorrentvpn",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/markusmcnugen/qbittorrentvpn/",
  "network": "br0",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/MarkusMcNugen/docker-templates/master/qbittorrentvpn/qbittorrentvpn-icon.png",
  "project": null,
  "description": "Docker container which runs the latest headless qBittorrent client with WebUI wth optional OpenVPN connection including iptables killswitch to prevent IP leakage when tunnel does down. This is an automated build linked with Ubuntu. NOTE: Dont use WebUI from the Unraid menu, it throws a header redirect error in qBittorrent. Instead type the IP:PORT directly into a browser address bar. NOTE2: If you want to change the ports, change the environmental variables as well as the exposed ports for the container instead of forwarding a host port to 8080 inside the container. qBittorrent will throw a DNS rebinding error.",
  "paths": [
    {
      "name": "Downloads Path",
      "host": "/mnt/cache/Downloads/",
      "container": "/downloads",
      "mode": "rw",
      "description": "Container Path: /downloads",
      "required": true
    },
    {
      "name": "config",
      "host": "/mnt/cache/appdata/qbittorrentvpn/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WEBUI_PORT",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false
    },
    {
      "name": "INCOMING_PORT_TCP",
      "host": "8999",
      "container": "8999",
      "protocol": "tcp",
      "description": "Container Port: 8999",
      "required": true,
      "mask": false
    },
    {
      "name": "INCOMING_PORT_UDP",
      "host": "8999",
      "container": "8999",
      "protocol": "udp",
      "description": "Container Port: 8999",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "WEBUI_PORT_ENV",
      "key": "WEBUI_PORT",
      "value": "8080",
      "description": "Container Variable: WEBUI_PORT - Sets Web UI port in qBittorrent config. You must change the exposed WebUI Port to the same value if you change this.",
      "required": false,
      "mask": false
    },
    {
      "name": "INCOMING_PORT_ENV",
      "key": "INCOMING_PORT",
      "value": "8999",
      "description": "Container Variable: INCOMING_PORT - Sets incoming connections port in qBittorrent config. You must change the exposed Incoming Ports to the same value if you change this.",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_ENABLED",
      "key": "VPN_ENABLED",
      "value": "yes",
      "description": "Container Variable: VPN_ENABLED",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_USERNAME",
      "key": "VPN_USERNAME",
      "value": "",
      "description": "Container Variable: VPN_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "VPN_PASSWORD",
      "key": "VPN_PASSWORD",
      "value": "",
      "description": "Container Variable: VPN_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "LAN_NETWORK",
      "key": "LAN_NETWORK",
      "value": "192.168.2.0/24",
      "description": "Container Variable: LAN_NETWORK",
      "required": true,
      "mask": false
    },
    {
      "name": "NAME_SERVERS",
      "key": "NAME_SERVERS",
      "value": "8.8.8.8,8.8.4.4",
      "description": "Container Variable: NAME_SERVERS",
      "required": true,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
