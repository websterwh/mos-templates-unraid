{
  "name": "lemon-manuals",
  "repo": "hellreaver/lemon-manuals",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/hellreaver/lemon-manuals",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": null,
  "project": null,
  "description": "Serves Lemon and Charm manuals from local index.json files.",
  "paths": [
    {
      "name": "Lemon data",
      "host": "",
      "container": "/data/lemon",
      "mode": "ro",
      "description": "Host path to lemon folder (must contain index.json)",
      "required": true
    },
    {
      "name": "Charm data",
      "host": "",
      "container": "/data/charm",
      "mode": "ro",
      "description": "Host path to charm folder (must contain index.json)",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "16080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web UI port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
