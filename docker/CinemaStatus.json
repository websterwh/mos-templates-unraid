{
  "name": "CinemaStatus",
  "repo": "keenaanee/cinemastatus:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/keenaanee/cinemastatus",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/keenaanee/CinemaStatus/1.3/icon.png",
  "project": "https://github.com/keenaanee/CinemaStatus",
  "description": "Discord bot that polls Plex for the currently playing item, sets its own Discord Rich Presence, and renames a cinema voice channel based on that media. Configuration is via environment variables: - DISCORD_TOKEN: your bot token - PLEX_URL: Plex server URL (e.g. http://192.168.1.10:32400) - PLEX_TOKEN: Plex API token - TARGET_USER: Plex username to track (optional, leave blank to use first active session) - CINEMA_CHANNEL_ID: voice channel ID to rename - BASE_CHANNEL_NAME: base name of the channel - RENAME_COOLDOWN: seconds between renames - POLL_INTERVAL: seconds between Plex polls (default 30)",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Key 1",
      "key": "DISCORD_TOKEN",
      "value": "YOUR_BOT_TOKEN_HERE",
      "description": "Discord bot token",
      "required": false,
      "mask": true
    },
    {
      "name": "Key 2",
      "key": "PLEX_URL",
      "value": "http://127.0.0.1:32400",
      "description": "Plex server URL",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 3",
      "key": "PLEX_TOKEN",
      "value": "YOUR_PLEX_TOKEN_HERE",
      "description": "Plex API token",
      "required": false,
      "mask": true
    },
    {
      "name": "Key 4",
      "key": "TARGET_USER",
      "value": "",
      "description": "Plex username to track (optional; blank = first active session)",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 5",
      "key": "CINEMA_CHANNEL_ID",
      "value": "YOUR_VOICE_CHANNEL_ID_HERE",
      "description": "Discord voice channel ID to rename",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 6",
      "key": "BASE_CHANNEL_NAME",
      "value": "\ud83c\udfac Cinema",
      "description": "Base channel name",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 7",
      "key": "RENAME_COOLDOWN",
      "value": "300",
      "description": "Seconds between channel renames",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 8",
      "key": "POLL_INTERVAL",
      "value": "30",
      "description": "Seconds between Plex polls",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
