{
  "name": "Drop-OSS",
  "repo": "ghcr.io/drop-oss/drop:0.4.0-rc-5",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/Drop-OSS/drop/pkgs/container/drop",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/Saetron/unRAID-CA-templates/refs/heads/main/templates/drop-oss/drop.png",
  "project": "https://github.com/Drop-OSS/drop",
  "description": "Drop is an open-source game distribution platform, similar to GameVault or Steam. It's designed to distribute and share DRM-free games quickly, all while being incredibly flexible, beautiful, and fast.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/drop",
      "container": "/data",
      "mode": "rw",
      "description": "Core application data.",
      "required": true
    },
    {
      "name": "Games",
      "host": "/mnt/cache/games",
      "container": "/library",
      "mode": "rw",
      "description": "Games directory.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "postgres://drop:drop@postgres:5432/drop",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "EXTERNAL_URL",
      "key": "EXTERNAL_URL",
      "value": "http://localhost:3000",
      "description": "Customise if accessing from another computer or behind a reverse proxy",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
