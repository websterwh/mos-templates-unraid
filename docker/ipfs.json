{
  "name": "ipfs",
  "repo": "lscr.io/linuxserver/ipfs",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/ipfs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/ipfs-logo.png",
  "project": "https://ipfs.io/",
  "description": "Ipfs(https://ipfs.io/) - A peer-to-peer hypermedia protocol designed to make the web faster, safer, and more open.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "IPFS storage and config files/logs",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "The port for the IPFS web UI",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 4001",
      "host": "4001",
      "container": "4001",
      "protocol": "tcp",
      "description": "Peering port, this is the only port you should expose to the internet",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 5001",
      "host": "5001",
      "container": "5001",
      "protocol": "tcp",
      "description": "API port, the clientside webUI needs to be able to talk to this from whatever machine your web browser is on",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 8080",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Gateway Port, actually serves IPFS content",
      "required": true,
      "mask": false
    },
    {
      "name": "Port: 443",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS port for web UI",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
