{
  "name": "wallabag",
  "repo": "wallabag/wallabag:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/wallabag/wallabag/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/wallabag.png",
  "project": "https://www.wallabag.org",
  "description": "Wallabag is a self hostable application for saving web pages. Unlike other services, wallabag is free (as in freedom) and open source. Default user/password User: wallabag Password: wallabag",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/wallabag/",
      "container": "/var/www/wallabag/data",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    },
    {
      "name": "Images",
      "host": "/mnt/cache/appdata/wallabag/images/",
      "container": "/var/www/wallabag/web/assets/images",
      "mode": "rw",
      "description": "Images",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "6500",
      "container": "80",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Domain",
      "key": "SYMFONY__ENV__DOMAIN_NAME",
      "value": "http://&lt;IP&gt;:6500",
      "description": "Domain",
      "required": true,
      "mask": false
    },
    {
      "name": "Secret",
      "key": "SYMFONY__ENV__SECRET",
      "value": "LongRandomSecretHere",
      "description": "Randomly generated secret here",
      "required": false,
      "mask": false
    },
    {
      "name": "Public User Registration",
      "key": "SYMFONY__ENV__FOSUSER_REGISTRATION",
      "value": "false",
      "description": "Public User Registration",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
