{
  "name": "postgres-mcp",
  "repo": "crystaldba/postgres-mcp:latest",
  "category": [
    "System"
  ],
  "registry": "https://hub.docker.com/r/crystaldba/postgres-mcp",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--access-mode=restricted --transport=sse",
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://avatars.githubusercontent.com/u/156604495?s=60&v=4",
  "project": "https://github.com/crystaldba/postgres-mcp",
  "description": "Postgres MCP Pro is an open source Model Context Protocol (MCP) server built to support you and your AI agents throughout the entire development process\u2014from initial coding, through testing and deployment, and to production tuning and maintenance. I am using it to connect github copilot agent with my postgresql database.",
  "paths": [],
  "ports": [
    {
      "name": "Application Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Access Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PostgreSQL Connection",
      "key": "DATABASE_URI",
      "value": "postgresql://user_db:user_pass@postgresql:5432/database_name",
      "description": "Database connection string",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
