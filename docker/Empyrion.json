{
  "name": "Empyrion",
  "repo": "bitr/empyrion-server",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/bitr/empyrion-server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:30000]",
  "icon": "https://cdn2.steamgriddb.com/file/sgdb-cdn/icon/157792e4abb490f99dbd738483e0d2d4/32/256x256.png",
  "project": "https://hub.docker.com/r/bitr/empyrion-server/",
  "description": "Empyrion dedicated server using WINE BETA Warning: Since this Docker runs with WINE it's marked as BETA, i can not guarantee if the server is running always as expected! ATTENTION: First Startup can take very long since it downloads the gameserver files! https://hub.docker.com/r/bitr/empyrion-server/ Credits to bitr, creator of the container.",
  "paths": [
    {
      "name": "Game_DIR",
      "host": "/mnt/cache/appdata/Empyrion - Dedicated Server/",
      "container": "/home/user/Empyrion - Dedicated Server/",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "SteamCMD",
      "host": "/mnt/cache/appdata/Empyrion - Dedicated Server",
      "container": "/home/user/Steam",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Container Port 1",
      "host": "30000",
      "container": "30000",
      "protocol": "udp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
