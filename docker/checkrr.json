{
  "name": "checkrr",
  "repo": "aetaric/checkrr:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/aetaric/checkrr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8585]",
  "icon": "https://raw.githubusercontent.com/MountainGod2/unraid-templates/main/checkrr/magnify-scan.png",
  "project": "https://github.com/aetaric/checkrr",
  "description": "Scan your library files for corrupt media and replace the files via sonarr and radarr. Join the Checkrr discord here: `https://discord.gg/dkTfNKbEhJ`",
  "paths": [
    {
      "name": "Config Directory",
      "host": "/mnt/cache/appdata/checkrr/config/",
      "container": "/etc/checkrr/",
      "mode": "rw",
      "description": null,
      "required": true
    },
    {
      "name": "Media Location",
      "host": "/mnt/cache/data/media/",
      "container": "/media/",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8585",
      "container": "8585",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
