{
  "name": "plik",
  "repo": "rootgg/plik:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/rootgg/plik/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/plik.png",
  "project": "https://github.com/root-gg/plik",
  "description": "Plik is a scalable file uploading system with multiple backends.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/plik/data/",
      "container": "/data",
      "mode": "rw",
      "description": null,
      "required": false
    },
    {
      "name": "plikd.cfg Path",
      "host": "/mnt/cache/appdata/plik/plikd.cfg",
      "container": "/home/plik/server/plikd.cfg",
      "mode": "rw",
      "description": null,
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port 1",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
