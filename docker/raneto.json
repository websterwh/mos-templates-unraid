{
  "name": "raneto",
  "repo": "lscr.io/linuxserver/raneto",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/raneto",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/raneto-logo.png",
  "project": "http://raneto.com/",
  "description": "Raneto(http://raneto.com/) - is an open source Knowledgebase platform that uses static Markdown files to power your Knowledgebase.",
  "paths": [
    {
      "name": "Appdata",
      "host": "",
      "container": "/config",
      "mode": "rw",
      "description": "Raneto config and Markdown files",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port for the Raneto web interface",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
