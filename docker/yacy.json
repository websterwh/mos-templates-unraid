{
  "name": "yacy",
  "repo": "yacy/yacy_search_server:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/yacy/yacy_search_server/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--log-opt max-size=200m --log-opt max-file=2",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8090]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/yacy.png",
  "project": "https://yacy.net/",
  "description": "YaCy decentralized search engine (https://yacy.net) Default user/password User: admin Password: yacy Set an admin account immediately after the first start-up. Open: http://ServerIP:8090/ConfigAccounts_p.html Command: chmod -R 777 /mnt/user/appdata/yacy",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/yacy/",
      "container": "/opt/yacy_search_server/DATA",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8090",
      "container": "8090",
      "protocol": "tcp",
      "description": "HTTP",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPs",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "HTTPs (Not Required if you using reverse proxy)",
      "required": false,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
