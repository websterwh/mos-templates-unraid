{
  "name": "serveo",
  "repo": "taichunmin/serveo-server:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/taichunmin/serveo-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "serveo -port=22 -http_port=80 -https_port=443 -private_key_path=/root/.ssh/id_ed25519 -cert_dir=/certs -domain $DOMAIN",
  "web_ui_url": "http://[IP]:[PORT:1080]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/serveo-server-icon.png",
  "project": "https://serveo.net/",
  "description": "Expose local servers to the internet via SSH tunneling.",
  "paths": [
    {
      "name": "LetsEncrypt Certificate",
      "host": "",
      "container": "/certs/letsencrypt.crt",
      "mode": "rw",
      "description": "Path to LetsEncrypt 'fullchain.pem' file",
      "required": true
    },
    {
      "name": "LetsEncrypt Private Key",
      "host": "",
      "container": "/certs/letsencrypt.key",
      "mode": "rw",
      "description": "Path to LetsEncrypt 'privkey.pem' file",
      "required": true
    },
    {
      "name": "SSH Config",
      "host": "",
      "container": "/root/.ssh",
      "mode": "rw",
      "description": "Path to SSH config directory",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "HTTP Traffic Port",
      "host": "1080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false
    },
    {
      "name": "HTTPS Traffic Port",
      "host": "10443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false
    },
    {
      "name": "SSH Port",
      "host": "2222",
      "container": "22",
      "protocol": "tcp",
      "description": "Container Port: 22",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
