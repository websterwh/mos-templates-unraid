{
  "name": "PasswordCheckerWeb",
  "repo": "hardly007/password-checker-web:v1.1.3",
  "category": [
    "Security"
  ],
  "registry": "https://hub.docker.com/r/hardly007/password-checker-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/JPetovello/unraid-templates/main/icon.png",
  "project": "https://github.com/JPetovello/password-checker-web",
  "description": "A lightweight Flask web application that evaluates password strength using zxcvbn, checks for compromised passwords against Have I Been Pwned (HIBP) using k-Anonymity for privacy, and generates high-entropy passphrases based on the official 7,776-word EFF Large Wordlist.",
  "paths": [],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Toronto",
      "description": "Container timezone",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
