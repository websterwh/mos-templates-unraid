{
  "name": "psitransfer",
  "repo": "psitrax/psitransfer:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/psitrax/psitransfer/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/psitransfer.png",
  "project": "https://github.com/psi-4ward/psitransfer",
  "description": "Simple open source self-hosted file sharing solution. To access Admin Page add /admin at the end of the URL Run chown -R 1000 /mnt/user/appdata/psitransfer/ After install in Unraid CLI",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/psitransfer/",
      "container": "/data",
      "mode": "rw",
      "description": "Data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Port",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Admin Password",
      "key": "PSITRANSFER_ADMIN_PASS",
      "value": "secret",
      "description": "Admin Password",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
