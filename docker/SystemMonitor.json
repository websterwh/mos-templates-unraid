{
  "name": "System-Monitor",
  "repo": "shaneee/system-monitor",
  "category": [
    "Monitoring"
  ],
  "registry": "https://hub.docker.com/r/shaneee/system-monitor",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn-icons-png.flaticon.com/512/148/148824.png",
  "project": "https://github.com/shaneee/system-monitor",
  "description": "A real-time system monitoring dashboard for Unraid with NVIDIA GPU support, temperature monitoring, and performance metrics. Monitors CPU, memory, storage pools, network, temperatures, and GPU usage.",
  "paths": [
    {
      "name": "Host Path: /proc",
      "host": "/proc",
      "container": "/host/proc",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Host Path: /sys",
      "host": "/sys",
      "container": "/host/sys",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Host Path: /mnt",
      "host": "/mnt",
      "container": "/host/mnt",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Host Path: /var",
      "host": "/var",
      "container": "/host/var",
      "mode": "ro",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
