{
  "name": "icloud",
  "repo": "mandarons/icloud-drive",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/mandarons/icloud-drive",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://help.apple.com/assets/60AD31069883FC55AC222539/60AD310B9883FC55AC22254A/de_DE/712e44cf3701cf5bc9580c9367fa5526.png",
  "project": "https://github.com/mandarons/icloud-drive-docker",
  "description": "Dockerized iCloud Client - make a local copy of your iCloud documents and photos, and keep it automatically up-to-date.",
  "paths": [
    {
      "name": "Configuration Files",
      "host": "/mnt/cache/appdata/icloud/config",
      "container": "/config",
      "mode": "rw",
      "description": "Storage for all the configuration files (e.g. config.yaml, session_data directory etc.)",
      "required": true
    },
    {
      "name": "iCloud data storage directory",
      "host": "&lt;provide location to icloud backup&gt;",
      "container": "/icloud",
      "mode": "rw",
      "description": "Target location to store your icloud data",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": false,
      "mask": false
    },
    {
      "name": "Your iCloud Password",
      "key": "ENV_ICLOUD_PASSWORD",
      "value": "&lt;your icloud.com password&gt;",
      "description": "Your icloud.com password",
      "required": false,
      "mask": true
    },
    {
      "name": "Path to configuration file in container",
      "key": "ENV_CONFIG_FILE_PATH",
      "value": "/config/config.yaml",
      "description": "Path to configuration file in container - DO NOT CHANGE UNLESS YOU KNOW WHAT YOU'RE DOING!",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
