{
  "name": "TV-Rename",
  "repo": "jasongdove/tvrename:develop",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jasongdove/tvrename",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tv-rename-icon.png",
  "project": "https://github.com/jasongdove/tvrename",
  "description": "Identify and rename television episode files.",
  "paths": [
    {
      "name": "Temp Path",
      "host": "/mnt/cache/appdata/tv_rename/tmp",
      "container": "/tmp/tv",
      "mode": "rw",
      "description": "Path to temp files",
      "required": true
    },
    {
      "name": "Cache Path",
      "host": "/mnt/cache/appdata/tv_rename/cache",
      "container": "/cache",
      "mode": "rw",
      "description": "Path to cache files",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
