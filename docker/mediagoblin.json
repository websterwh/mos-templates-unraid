{
  "name": "mediagoblin",
  "repo": "mtlynch/mediagoblin:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/mtlynch/mediagoblin/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--tty --detach",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6543]/",
  "icon": "https://raw.githubusercontent.com/A75G/docker-templates/master/templates/icons/mediagoblin.png",
  "project": "https://mediagoblin.org/",
  "description": "MediaGoblin is a free software media publishing platform that anyone can run. You can think of it as a decentralized alternative to Flickr, YouTube, SoundCloud, etc. Default user/password User: admin Password: admin",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/mediagoblin/",
      "container": "/var/lib/mediagoblin",
      "mode": "rw",
      "description": "Appdata",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "6543",
      "container": "6543",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}
