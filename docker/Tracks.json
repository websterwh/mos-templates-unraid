{
  "name": "Tracks",
  "repo": "tracksapp/tracks",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/tracksapp/tracks",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/CorneliousJD/Docker-Templates/master/icons/tracks.png",
  "project": "http://www.getontracks.org/",
  "description": "Tracks is a web-based todo application to help you implement the GTD methodology. NOTE: After installing, you must console into the container and run the following command to initialize the database first! rake db:reset After running that command, you should see the database has tables in it and the app should be usable at that point.",
  "paths": [],
  "ports": [
    {
      "name": "Web Interface",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": false,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "DATABASE_NAME",
      "key": "DATABASE_NAME",
      "value": "tracks",
      "description": "Container Variable: DATABASE_NAME",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_HOST",
      "key": "DATABASE_HOST",
      "value": "10.0.0.10",
      "description": "Container Variable: DATABASE_HOST",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_PORT",
      "key": "DATABASE_PORT",
      "value": "3306",
      "description": "Container Variable: DATABASE_PORT",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_USERNAME",
      "key": "DATABASE_USERNAME",
      "value": "tracks",
      "description": "Container Variable: DATABASE_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_PASSWORD",
      "key": "DATABASE_PASSWORD",
      "value": "password",
      "description": "Container Variable: DATABASE_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_TYPE",
      "key": "DATABASE_TYPE",
      "value": "mysql2",
      "description": "mysql2 or postgresql",
      "required": false,
      "mask": false
    },
    {
      "name": "DATABASE_ENCODING",
      "key": "DATABASE_ENCODING",
      "value": "utf8",
      "description": "use utf8 for mysql or unicode for postgresql",
      "required": false,
      "mask": false
    },
    {
      "name": "RAILS_ENV",
      "key": "RAILS_ENV",
      "value": "production",
      "description": "Container Variable: RAILS_ENV",
      "required": false,
      "mask": false
    },
    {
      "name": "BUNDLE_WITHOUT",
      "key": "BUNDLE_WITHOUT",
      "value": "",
      "description": "Gem classes to omit (leave blank unless you know what this is for)",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
