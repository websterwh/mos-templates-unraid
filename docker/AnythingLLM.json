{
  "name": "AnythingLLM",
  "repo": "mintplexlabs/anythingllm:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/mintplexlabs/anythingllm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add SYS_ADMIN",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:3001]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/anythingllm-icon.png",
  "project": "https://useanything.com",
  "description": "The all-in-one AI app for any LLM with full RAG and AI Agent capabilities.",
  "paths": [
    {
      "name": "Environment File Path",
      "host": "/mnt/cache/appdata/anythingllm/.env",
      "container": "/app/server/.env",
      "mode": "rw",
      "description": "Path to the environmental variable file. File must exist before running!",
      "required": true
    },
    {
      "name": "Storage Path",
      "host": "/mnt/cache/appdata/anythingllm",
      "container": "/app/server/storage",
      "mode": "rw",
      "description": "Storage for databases and file storage",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "Container Port: 3001",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "In-container storage path",
      "key": "STORAGE_DIR",
      "value": "/app/server/storage",
      "description": "In-container storage location. Do not change!",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
