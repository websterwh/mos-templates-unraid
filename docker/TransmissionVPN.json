{
  "name": "Transmission_VPN",
  "repo": "haugene/transmission-openvpn:dev",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/haugene/transmission-openvpn/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--cap-add=NET_ADMIN --restart=unless-stopped --log-opt max-size=50m --log-driver json-file --dns 8.8.8.8 --dns 1.1.1.1",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9091]/",
  "icon": "https://raw.githubusercontent.com/activ/docker-templates/master/activ/images/transmission-icon.png",
  "project": "https://github.com/haugene/docker-transmission-openvpn",
  "description": "Transmission is a full-featured \u200bBitTorrent client for Linux, OS X, Unix and Windows. This Docker includes OpenVPN to ensure a secure and private connection to the Internet, including use of iptables to prevent IP leakage when the tunnel is down. It also includes Privoxy to allow unfiltered access to index sites, to use Privoxy please point your application at \"host ip:8118\" Configuration /config This is where Transmission will store it's configuration file, database and logs. /data This is where Transmision will store data downloaded, watched folder, and archived torrents. Notes For help on configuration for PIA, AirVPN and custom VPN providers please go here http://lime-technology.com/forum/index.php?topic=45812.msg437678#msg437678 IMPORTANT - To allow access to the Transmission webui, Privoxy and Transmission deamon you need to specify you LAN network, using CIDR notation for the mask, a subnet mask of 255.255.255.0 would equate to CIDR /24, 255.255.0.0 would equate to CIDR /16.",
  "paths": [
    {
      "name": "Host Path 2",
      "host": "/mnt/cache/T_Media/Torrent/",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true
    },
    {
      "name": "Download",
      "host": "/mnt/cache/T_Media/Torrent/",
      "container": "/downloads",
      "mode": "rw",
      "description": "Container Path: /downloads",
      "required": false
    },
    {
      "name": "Watch Folder",
      "host": "/mnt/cache/T_Media/Torrent/watch/",
      "container": "/watch",
      "mode": "rw",
      "description": "Container Path: /watch",
      "required": false
    },
    {
      "name": "Download",
      "host": "/mnt/cache/T_Media/Torrent/",
      "container": "/mnt/user/T_Media/Torrent/",
      "mode": "rw",
      "description": "Container Path: /mnt/user/T_Media/Torrent/",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "9091",
      "container": "9091",
      "protocol": "tcp",
      "description": "Container Port: 9091",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Key 2",
      "key": "OPENVPN_USERNAME",
      "value": "VPN_USER",
      "description": "Container Variable: OPENVPN_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "Key 3",
      "key": "OPENVPN_PASSWORD",
      "value": "VPN_PASSWORD",
      "description": "Container Variable: VPN_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "OPENVPN_CONFIG",
      "key": "OPENVPN_CONFIG",
      "value": "switzerland",
      "description": "OPENVPN_CONFIG",
      "required": false,
      "mask": false
    },
    {
      "name": "OPENVPN_PROVIDER",
      "key": "OPENVPN_PROVIDER",
      "value": "PIA",
      "description": "Container Variable: OPENVPN_PROVIDER",
      "required": false,
      "mask": false
    },
    {
      "name": "LOCAL_NETWORK",
      "key": "LOCAL_NETWORK",
      "value": "192.168.0.0/24",
      "description": "Container Variable: LOCAL_NETWORK",
      "required": false,
      "mask": false
    },
    {
      "name": "Transmission_Username",
      "key": "TRANSMISSION_RPC_USERNAME",
      "value": "TRANS_USER",
      "description": "Container Variable: RPC_USERNAME",
      "required": false,
      "mask": false
    },
    {
      "name": "Transmission_Password",
      "key": "TRANSMISSION_RPC_PASSWORD",
      "value": "TRANS_PASSWORD",
      "description": "Container Variable: RPC_PASSWORD",
      "required": false,
      "mask": false
    },
    {
      "name": "OpenVPN_OPTIONS",
      "key": "OPENVPN_OPTS",
      "value": "--inactive 3600 --ping 10 --ping-exit 60 --mute-replay-warnings",
      "description": "--inactive 3600 --ping 10 --ping-exit 60 --restart=always",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false
    },
    {
      "name": "Trans_Option_Download Dir",
      "key": "TRANSMISSION_DOWNLOAD_DIR",
      "value": "/downloads",
      "description": "Container Variable: TRANSMISSION_DOWNLOAD_DIR",
      "required": false,
      "mask": false
    },
    {
      "name": "TRANSMISSION_RPC_AUTHENTICATION_REQUIRED",
      "key": "TRANSMISSION_RPC_AUTHENTICATION_REQUIRED",
      "value": "true",
      "description": "Container Variable: TRANSMISSION_RPC_AUTHENTICATION_REQUIRED",
      "required": false,
      "mask": false
    },
    {
      "name": "RATIO_LIMIT_ENABLED",
      "key": "TRANSMISSION_RATIO_LIMIT_ENABLED",
      "value": "true",
      "description": "Enable Ratio Limits",
      "required": false,
      "mask": false
    },
    {
      "name": "TRANSMISSION_DOWNLOAD_QUEUE_SIZE",
      "key": "TRANSMISSION_DOWNLOAD_QUEUE_SIZE",
      "value": "15",
      "description": "Container Variable: TRANSMISSION_DOWNLOAD_QUEUE_SIZE",
      "required": false,
      "mask": false
    },
    {
      "name": "TRANSMISSION_CACHE_SIZE_MB",
      "key": "TRANSMISSION_CACHE_SIZE_MB",
      "value": "10",
      "description": "Container Variable: TRANSMISSION_CACHE_SIZE_MB",
      "required": false,
      "mask": false
    },
    {
      "name": "TRANSMISSION_INCOMPLETE_DIR",
      "key": "TRANSMISSION_INCOMPLETE_DIR",
      "value": "/downloads/incomplete",
      "description": "Container Variable: TRANSMISSION_INCOMPLETE_DIR",
      "required": false,
      "mask": false
    },
    {
      "name": "WEB_GUI",
      "key": "TRANSMISSION_WEB_UI",
      "value": "transmission-web-control",
      "description": "Web UI Options",
      "required": false,
      "mask": false
    },
    {
      "name": "GLOBAL_APPLY_PERMISSIONS",
      "key": "GLOBAL_APPLY_PERMISSIONS",
      "value": "false",
      "description": "Apply permsissions Globally on Transmissions files / Folders",
      "required": true,
      "mask": false
    },
    {
      "name": "WebProxy",
      "key": "WEBPROXY_ENABLED",
      "value": "false",
      "description": "Container Path: WEBPROXY_ENABLED",
      "required": true,
      "mask": false
    },
    {
      "name": "PIA_OPENVPN_CONFIG_BUNDLE=openvpn-tcp-nextgen",
      "key": "PIA_OPENVPN_CONFIG_BUNDLE",
      "value": "openvpn-tcp",
      "description": "testing openvpn-tcp-nextgen",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
