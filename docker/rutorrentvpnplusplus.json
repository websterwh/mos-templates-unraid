{
  "name": "rutorrentvpn-plus-plus",
  "repo": "testdasi/rutorrentvpn-plus-plus:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://registry.hub.docker.com/r/testdasi/rutorrentvpn-plus-plus/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:9080]/",
  "icon": "https://raw.githubusercontent.com/testdasi/rutorrentvpn-plus-plus/master/rtorrent.png",
  "project": "https://github.com/binhex/arch-rtorrentvpn",
  "description": "Based on binhex/arch-rtorrentvpn. ruTorrent with OpenVPN client, http proxy, dns-over-tls and a random ovpn picker (useful to cycle to another server if current one stops working). High-level instructions: 1. Run docker - first run will stop itself due to missing ovpn file 2. Copy / extract your ovpn files in the host path that is mapped to /config/ovpn_files (at least 1 file is required, must have .ovpn extension) 3. If there are separate cert files (crt + pem), place them in host location path that is mapped to /config/ovpn. Skip this step if using PIA ovpn files as certs are included in the files. 4. Start docker again",
  "paths": [
    {
      "name": "Docker appdata",
      "host": "/mnt/cache/appdata/rutorrentvpn-plus-plus/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false
    },
    {
      "name": "Download",
      "host": "/mnt/cache/downloads/rutorrentvpn-plus-plus/",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": false
    }
  ],
  "ports": [
    {
      "name": "rtorrent 5000",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": false,
      "mask": false
    },
    {
      "name": "ruTorrent Web",
      "host": "9080",
      "container": "9080",
      "protocol": "tcp",
      "description": "Container Port: 9080",
      "required": false,
      "mask": false
    },
    {
