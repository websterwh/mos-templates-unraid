{
  "name": "borgmatic",
  "repo": "ghcr.io/borgmatic-collective/borgmatic",
  "category": [
    "Backup"
  ],
  "registry": "http://ghcr.io/borgmatic-collective/borgmatic",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--cap-add SYS_ADMIN",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Sdub76/unraid_docker_templates/main/images/borgmatic.png",
  "project": "http://ghcr.io/borgmatic-collective/borgmatic",
  "description": "borgmatic is simple, configuration-driven backup software for servers and workstations. Protect your files with client-side encryption. Backup your databases too. Monitor it all with integrated third-party services.",
  "paths": [
    {
      "name": "User Shares (Read-only Backup Source)",
      "host": "/mnt/user",
      "container": "/mnt/user",
      "mode": "ro",
      "description": "Container Path: /mnt/user",
      "required": true
    },
    {
      "name": "Flash Drive (Read-only Backup Source)",
      "host": "/boot",
      "container": "/boot",
      "mode": "ro",
      "description": "Container Path: /boot",
      "required": false
    },
    {
      "name": "Borg Repo (Backup Destination)",
      "host": "/mnt/disks/borg_backup/repo",
      "container": "/mnt/borg-repository",
      "mode": "rw,slave",
      "description": "Container Path: /mnt/borg-repository",
      "required": true
    },
    {
      "name": "Borg Cache",
      "host": "/mnt/disks/borg_backup/cache",
      "container": "/root/.cache/borg",
      "mode": "rw,slave",
      "description": "Container Path: /root/.cache/borg",
      "required": true
    },
    {
      "name": "Borgmatic Config",
      "host": "/mnt/cache/appdata/borgmatic/config",
      "container": "/etc/borgmatic.d",
      "mode": "rw",
      "description": "Container Path: /etc/borgmatic.d",
      "required": true
    },
    {
      "name": "Borg Keys",
      "host": "/mnt/cache/appdata/borgmatic/borg_keys",
      "container": "/root/.config/borg",
      "mode": "rw",
      "description": "Container Path: /root/.config/borg",
      "required": true
    },
    {
      "name": "Borg Statefile",
      "host": "/mnt/cache/appdata/borgmatic/state",
      "container": "/root/.local/state/borgmatic",
      "mode": "rw",
      "description": "Container Path: /root/.local/state/borgmatic",
      "required": true
    },
    {
      "name": "SSH Keys",
      "host": "/mnt/cache/appdata/borgmatic/ssh_keys",
      "container": "/root/.ssh",
      "mode": "rw",
      "description": "Container Path: /root/.ssh",
      "required": false
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Container Variable: TZ",
      "required": false,
      "mask": false
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "UID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "GID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [
    {
      "name": "/dev/fuse",
      "host": "/dev/fuse",
      "container": "",
      "description": "Container Device:",
      "required": false
    }
  ],
  "labels": []
}
